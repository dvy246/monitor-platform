---
/**
 * AcousticSpectrumCanvas.astro
 * Web Audio Mechanical Switch Acoustic Spectrum Analyzer
 * Premium, dark-glassmorphic, responsive HTML5/Canvas/Web API component.
 */
---

<div class="w-full max-w-6xl mx-auto space-y-6 font-sans select-none min-w-0">
  <div class="relative bg-[#0c0d12]/90 border border-zinc-800/90 rounded-2xl p-4 sm:p-6 backdrop-blur-2xl shadow-[0_25px_60px_rgba(0,0,0,0.8)] space-y-6 overflow-hidden">
    <!-- Ambient Glow Effects -->
    <div class="absolute -top-24 -right-24 w-96 h-96 bg-cyan-500/10 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-24 -left-24 w-96 h-96 bg-purple-500/10 rounded-full blur-3xl pointer-events-none"></div>

    <div class="relative z-10 flex flex-col lg:flex-row lg:items-center justify-between gap-4 border-b border-zinc-800/70 pb-5">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/30 text-[11px] font-mono text-cyan-400 font-bold uppercase tracking-wider mb-2">
          <span class="w-2 h-2 rounded-full bg-cyan-400 shadow-[0_0_8px_rgba(34,211,238,0.9)] animate-pulse"></span>
          <span>WEB AUDIO API SPECTROGRAM</span>
        </div>
        <h2 class="text-xl sm:text-2xl font-bold font-mono text-white tracking-tight flex items-center gap-2">
          Mechanical Switch Acoustic Spectrum Analyzer
        </h2>
        <p class="text-xs text-zinc-400 mt-1 max-w-2xl leading-relaxed">
          Visualize the acoustic signature (frequency domain) of your mechanical switches. Detect high-frequency ping, switch scratchiness, and bottom-out resonance in real-time.
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-2.5">
        <button id="btn-start-audio" class="px-4 py-2 text-xs font-mono font-bold rounded-xl bg-cyan-500/20 border border-cyan-500/40 text-cyan-400 hover:bg-cyan-500/30 cursor-pointer transition-all flex items-center gap-1.5 shadow-sm">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z" />
          </svg>
          <span>Enable Microphone</span>
        </button>
        <button id="btn-stop-audio" class="hidden px-4 py-2 text-xs font-mono font-bold rounded-xl bg-rose-500/20 border border-rose-500/40 text-rose-400 hover:bg-rose-500/30 cursor-pointer transition-all items-center gap-1.5 shadow-sm">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 10a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1h-4a1 1 0 01-1-1v-4z" />
          </svg>
          <span>Stop Analysis</span>
        </button>
      </div>
    </div>

    <!-- Canvas Container -->
    <div class="relative z-10 w-full bg-zinc-950 border border-zinc-800/80 rounded-2xl overflow-hidden shadow-inner flex items-center justify-center p-1">
      <canvas id="spectrum-canvas" class="w-full h-[350px] rounded-xl bg-[#08080a] block"></canvas>
      
      <!-- Overlay when inactive -->
      <div id="audio-overlay" class="absolute inset-0 flex flex-col items-center justify-center bg-zinc-950/80 backdrop-blur-sm z-20">
        <svg class="w-12 h-12 text-zinc-500 mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 18.75a6 6 0 006-6v-1.5m-6 7.5a6 6 0 01-6-6v-1.5m6 7.5v3.75m-3.75 0h7.5M12 15.75a3 3 0 01-3-3V4.5a3 3 0 116 0v8.25a3 3 0 01-3 3z" />
        </svg>
        <p class="text-sm font-mono text-zinc-400">Microphone access required to analyze switch acoustics.</p>
        <p class="text-xs font-mono text-zinc-500 mt-1">Click "Enable Microphone" to begin.</p>
      </div>
    </div>

    <!-- Telemetry Readouts -->
    <div class="relative z-10 grid grid-cols-2 sm:grid-cols-4 gap-3">
      <div class="bg-zinc-950/80 p-3.5 rounded-xl border border-zinc-800/80 text-center space-y-0.5">
        <div class="text-[10px] font-mono text-zinc-400 uppercase tracking-wider font-bold">Peak Frequency</div>
        <div id="metric-peak-freq" class="text-base sm:text-lg font-mono font-extrabold text-cyan-400">0 Hz</div>
      </div>
      <div class="bg-zinc-950/80 p-3.5 rounded-xl border border-zinc-800/80 text-center space-y-0.5">
        <div class="text-[10px] font-mono text-zinc-400 uppercase tracking-wider font-bold">Max Amplitude</div>
        <div id="metric-amplitude" class="text-base sm:text-lg font-mono font-extrabold text-emerald-400">-∞ dB</div>
      </div>
      <div class="bg-zinc-950/80 p-3.5 rounded-xl border border-zinc-800/80 text-center space-y-0.5">
        <div class="text-[10px] font-mono text-zinc-400 uppercase tracking-wider font-bold">Switch Profile</div>
        <div id="metric-profile" class="text-base sm:text-lg font-mono font-extrabold text-amber-400">N/A</div>
      </div>
      <div class="bg-zinc-950/80 p-3.5 rounded-xl border border-zinc-800/80 text-center space-y-0.5">
        <div class="text-[10px] font-mono text-zinc-400 uppercase tracking-wider font-bold">Audio Sample Rate</div>
        <div id="metric-samplerate" class="text-base sm:text-lg font-mono font-extrabold text-white">0 kHz</div>
      </div>
    </div>

  </div>
</div>

<script>
  let audioContext: AudioContext | null = null;
  let analyser: AnalyserNode | null = null;
  let microphone: MediaStreamAudioSourceNode | null = null;
  let mediaStream: MediaStream | null = null;
  let animationId: number;

  const btnStart = document.getElementById('btn-start-audio');
  const btnStop = document.getElementById('btn-stop-audio');
  const overlay = document.getElementById('audio-overlay');
  const canvas = document.getElementById('spectrum-canvas') as HTMLCanvasElement;
  
  const metricPeakFreq = document.getElementById('metric-peak-freq');
  const metricAmplitude = document.getElementById('metric-amplitude');
  const metricProfile = document.getElementById('metric-profile');
  const metricSampleRate = document.getElementById('metric-samplerate');

  function resizeCanvas() {
    if (!canvas) return;
    const rect = canvas.parentElement!.getBoundingClientRect();
    // Use device pixel ratio for sharp rendering
    const dpr = window.devicePixelRatio || 1;
    canvas.width = rect.width * dpr;
    canvas.height = 350 * dpr;
  }
  
  window.addEventListener('resize', resizeCanvas);
  // Initial size setup
  if (canvas) {
    resizeCanvas();
  }

  async function startAudio() {
    try {
      mediaStream = await navigator.mediaDevices.getUserMedia({ audio: true, video: false });
      
      const AudioContextClass = window.AudioContext || (window as unknown as { webkitAudioContext: typeof AudioContext }).webkitAudioContext;
      audioContext = new AudioContextClass();
      
      analyser = audioContext.createAnalyser();
      analyser.fftSize = 2048; // High resolution
      analyser.smoothingTimeConstant = 0.5; // Fast response for mechanical clicks
      
      microphone = audioContext.createMediaStreamSource(mediaStream);
      microphone.connect(analyser);

      if (metricSampleRate) {
        metricSampleRate.textContent = `${(audioContext.sampleRate / 1000).toFixed(1)} kHz`;
      }

      if (btnStart) btnStart.classList.add('hidden');
      if (btnStop) {
        btnStop.classList.remove('hidden');
        btnStop.classList.add('flex');
      }
      if (overlay) overlay.classList.add('hidden');

      drawSpectrum();
    } catch (err) {
      console.error('Error accessing microphone:', err);
      alert('Microphone access denied or unavailable. Please check permissions.');
    }
  }

  function stopAudio() {
    if (animationId) cancelAnimationFrame(animationId);
    
    if (microphone) microphone.disconnect();
    if (analyser) analyser.disconnect();
    if (audioContext) audioContext.close();
    
    if (mediaStream) {
      mediaStream.getTracks().forEach(track => track.stop());
    }

    audioContext = null;
    analyser = null;
    microphone = null;
    mediaStream = null;

    if (btnStart) btnStart.classList.remove('hidden');
    if (btnStop) {
      btnStop.classList.add('hidden');
      btnStop.classList.remove('flex');
    }
    if (overlay) overlay.classList.remove('hidden');
    
    // Clear canvas
    const ctx = canvas.getContext('2d');
    if (ctx) {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
    }
    
    if (metricPeakFreq) metricPeakFreq.textContent = '0 Hz';
    if (metricAmplitude) metricAmplitude.textContent = '-∞ dB';
    if (metricProfile) metricProfile.textContent = 'N/A';
    if (metricSampleRate) metricSampleRate.textContent = '0 kHz';
  }

  function drawSpectrum() {
    if (!analyser || !canvas) return;
    
    animationId = requestAnimationFrame(drawSpectrum);
    
    const bufferLength = analyser.frequencyBinCount;
    const dataArray = new Uint8Array(bufferLength);
    analyser.getByteFrequencyData(dataArray);

    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const width = canvas.width;
    const height = canvas.height;

    ctx.clearRect(0, 0, width, height);

    // Draw background grid
    ctx.strokeStyle = 'rgba(255, 255, 255, 0.05)';
    ctx.lineWidth = 1;
    ctx.beginPath();
    for (let i = 0; i < height; i += 50) {
      ctx.moveTo(0, i);
      ctx.lineTo(width, i);
    }
    for (let i = 0; i < width; i += 100) {
      ctx.moveTo(i, 0);
      ctx.lineTo(i, height);
    }
    ctx.stroke();

    const barWidth = (width / bufferLength) * 2.5;
    let barHeight;
    let x = 0;
    
    let maxVal = 0;
    let maxIdx = 0;

    for (let i = 0; i < bufferLength; i++) {
      barHeight = (dataArray[i] / 255) * height;

      if (dataArray[i] > maxVal) {
        maxVal = dataArray[i];
        maxIdx = i;
      }

      // Color gradient based on frequency
      const hue = i / bufferLength * 360;
      ctx.fillStyle = `hsl(${180 + hue/2}, 100%, 50%)`;
      
      ctx.fillRect(x, height - barHeight, barWidth, barHeight);
      
      // Top cap for aesthetics
      ctx.fillStyle = 'rgba(255, 255, 255, 0.8)';
      ctx.fillRect(x, height - barHeight - 2, barWidth, 2);

      x += barWidth + 1;
    }

    // Update telemetry if sound detected
    if (maxVal > 20 && audioContext) { // Threshold to ignore background noise
      const nyquist = audioContext.sampleRate / 2;
      const freq = (maxIdx / bufferLength) * nyquist;
      
      if (metricPeakFreq) metricPeakFreq.textContent = `${Math.round(freq)} Hz`;
      
      // Rough dB calculation
      const db = 20 * Math.log10(maxVal / 255);
      if (metricAmplitude) metricAmplitude.textContent = `${db.toFixed(1)} dB`;
      
      // Switch profiling logic (naive heuristic)
      if (metricProfile) {
        if (freq > 3000) {
          metricProfile.textContent = 'Clicky (High Pitch)';
          metricProfile.className = 'text-base sm:text-lg font-mono font-extrabold text-cyan-400';
        } else if (freq > 1500) {
          metricProfile.textContent = 'Tactile (Mid)';
          metricProfile.className = 'text-base sm:text-lg font-mono font-extrabold text-amber-400';
        } else if (freq > 0) {
          metricProfile.textContent = 'Linear (Thock)';
          metricProfile.className = 'text-base sm:text-lg font-mono font-extrabold text-rose-400';
        }
      }
    } else {
      if (metricAmplitude) metricAmplitude.textContent = '-∞ dB';
    }
  }

  btnStart?.addEventListener('click', startAudio);
  btnStop?.addEventListener('click', stopAudio);
</script>
