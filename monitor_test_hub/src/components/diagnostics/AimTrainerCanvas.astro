---
/**
 * AimTrainerCanvas.astro
 * Professional 2D/3D Aim Trainer & Reflex Target Benchmark Engine.
 * Features:
 * - Modes: Classic 30s, Precision Target, Reflex Reaction, and Endless Practice.
 * - Real-time Target Hit/Miss ratio, Accuracy %, Targets Per Second (TPS), and Reaction Time (ms).
 * - Web Audio hit/miss feedback, target shatter particle physics, and SHA-256 JSON Passport export.
 */
interface Props {
  initialMode?: string; // 'classic' | 'precision' | 'reflex' | 'endless'
}

const { initialMode = 'classic' } = Astro.props;
---

<div class="w-full max-w-7xl mx-auto space-y-6 font-sans select-none min-w-0" id="aim-trainer-root">
  <div class="relative bg-[#0c0d12]/90 border border-zinc-800/90 rounded-3xl p-4 sm:p-8 backdrop-blur-2xl shadow-[0_25px_60px_rgba(0,0,0,0.8)] space-y-6 overflow-hidden">
    <!-- Ambient Radial Glows -->
    <div class="absolute -top-24 -right-24 w-96 h-96 bg-red-500/10 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-24 -left-24 w-96 h-96 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>

    <!-- Header Controls & Mode Selectors -->
    <div class="relative z-10 flex flex-col lg:flex-row items-start lg:items-center justify-between gap-4 border-b border-zinc-800/70 pb-5">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-red-500/10 border border-red-500/30 text-[11px] font-mono text-red-400 font-bold uppercase tracking-wider mb-2">
          <span class="w-2 h-2 rounded-full bg-red-400 shadow-[0_0_8px_rgba(248,113,113,0.9)] animate-pulse"></span>
          <span>ESPORTS AIM & REFLEX ACCURACY ENGINE</span>
        </div>
        <h2 class="text-xl sm:text-3xl font-extrabold font-mono text-white">3D Precision Aim Trainer</h2>
        <p class="text-xs sm:text-sm text-zinc-400 mt-1">Eliminate targets rapidly to measure spatial accuracy, reflex speed, and target tracking.</p>
      </div>

      <!-- Mode Selector Pills -->
      <div class="flex flex-wrap items-center gap-2">
        <button data-mode="classic" class="aim-mode-btn px-4 py-2 rounded-xl text-xs font-mono font-bold transition-all bg-red-500/20 border border-red-500 text-red-400 cursor-pointer">Classic 30s</button>
        <button data-mode="precision" class="aim-mode-btn px-4 py-2 rounded-xl text-xs font-mono font-bold transition-all bg-zinc-900 border border-zinc-800 text-zinc-400 hover:text-white cursor-pointer">Precision Mode</button>
        <button data-mode="reflex" class="aim-mode-btn px-4 py-2 rounded-xl text-xs font-mono font-bold transition-all bg-zinc-900 border border-zinc-800 text-zinc-400 hover:text-white cursor-pointer">Reflex Speed</button>
        <button data-mode="endless" class="aim-mode-btn px-4 py-2 rounded-xl text-xs font-mono font-bold transition-all bg-zinc-900 border border-zinc-800 text-zinc-400 hover:text-white cursor-pointer">Endless Practice</button>
      </div>
    </div>

    <!-- Live Telemetry Metrics Grid -->
    <div class="relative z-10 grid grid-cols-2 sm:grid-cols-4 gap-4">
      <div class="bg-zinc-950/80 p-4 rounded-2xl border border-zinc-800/80 text-center space-y-1 shadow-inner">
        <div class="text-[10px] font-mono text-zinc-400 uppercase tracking-wider font-bold">Targets Hit</div>
        <div class="text-3xl sm:text-4xl font-extrabold font-mono text-emerald-400 tabular-nums" id="aim-hits">0</div>
        <div class="text-[10px] font-mono text-zinc-500" id="aim-miss-count">0 Misses</div>
      </div>
      <div class="bg-zinc-950/80 p-4 rounded-2xl border border-zinc-800/80 text-center space-y-1 shadow-inner">
        <div class="text-[10px] font-mono text-zinc-400 uppercase tracking-wider font-bold">Accuracy Score</div>
        <div class="text-3xl sm:text-4xl font-extrabold font-mono text-cyan-400 tabular-nums" id="aim-accuracy">100%</div>
        <div class="text-[10px] font-mono text-zinc-500">Hit Rate</div>
      </div>
      <div class="bg-zinc-950/80 p-4 rounded-2xl border border-zinc-800/80 text-center space-y-1 shadow-inner">
        <div class="text-[10px] font-mono text-zinc-400 uppercase tracking-wider font-bold">Avg Reaction Time</div>
        <div class="text-3xl sm:text-4xl font-extrabold font-mono text-amber-400 tabular-nums" id="aim-reaction">0ms</div>
        <div class="text-[10px] font-mono text-zinc-500">Click Latency</div>
      </div>
      <div class="bg-zinc-950/80 p-4 rounded-2xl border border-zinc-800/80 text-center space-y-1 shadow-inner">
        <div class="text-[10px] font-mono text-zinc-400 uppercase tracking-wider font-bold">Time Remaining</div>
        <div class="text-3xl sm:text-4xl font-extrabold font-mono text-red-400 tabular-nums" id="aim-timer">30.0s</div>
        <div class="text-[10px] font-mono text-zinc-500" id="aim-mode-label">Classic 30s</div>
      </div>
    </div>

    <!-- Aim Arena Canvas -->
    <div 
      id="aim-arena" 
      class="relative h-[380px] sm:h-[480px] bg-gradient-to-b from-[#060608] to-[#101015] border-2 border-zinc-800 hover:border-red-500/50 rounded-3xl cursor-crosshair overflow-hidden shadow-2xl flex items-center justify-center transition-colors select-none"
    >
      <!-- Target Container -->
      <div id="aim-target-layer" class="absolute inset-0 pointer-events-auto"></div>

      <!-- Particle Canvas -->
      <canvas id="aim-particle-canvas" class="absolute inset-0 pointer-events-none w-full h-full z-10"></canvas>

      <!-- Overlay Start / Completion Screen -->
      <div id="aim-overlay" class="absolute inset-0 bg-[#08080c]/90 backdrop-blur-md flex flex-col items-center justify-center p-6 text-center space-y-4 z-20 transition-opacity duration-300">
        <div class="w-16 h-16 rounded-2xl bg-red-500/10 border border-red-500/30 flex items-center justify-center text-red-400 shadow-lg shadow-red-500/20">
          <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="9"/>
            <circle cx="12" cy="12" r="3"/>
            <path d="M12 3v3m0 12v3M3 12h3m12 0h3"/>
          </svg>
        </div>
        <div class="space-y-1">
          <h3 class="text-2xl sm:text-3xl font-extrabold font-mono text-white" id="aim-overlay-title">AIM TRAINER ARENA</h3>
          <p class="text-xs sm:text-sm text-zinc-400 max-w-md mx-auto" id="aim-overlay-desc">Click targets as fast as they spawn. Test your mouse precision and reflex latency.</p>
        </div>
        <div class="flex items-center gap-3 pt-2">
          <button id="aim-start-btn" class="px-6 py-3 rounded-xl bg-red-500 text-white font-mono font-bold text-xs uppercase tracking-wider hover:bg-red-400 transition-colors shadow-lg shadow-red-500/20 cursor-pointer">
            START AIM TRIAL &rarr;
          </button>
          <button id="aim-export-btn" class="px-5 py-3 rounded-xl bg-zinc-900 border border-zinc-800 text-zinc-300 font-mono font-bold text-xs hover:text-white transition-colors cursor-pointer hidden">
            📜 EXPORT CERTIFICATE
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const root = document.getElementById('aim-trainer-root');
    if (!root) return;

    const hitsEl = document.getElementById('aim-hits');
    const missEl = document.getElementById('aim-miss-count');
    const accuracyEl = document.getElementById('aim-accuracy');
    const reactionEl = document.getElementById('aim-reaction');
    const timerEl = document.getElementById('aim-timer');
    const modeLabelEl = document.getElementById('aim-mode-label');
    const arena = document.getElementById('aim-arena');
    const targetLayer = document.getElementById('aim-target-layer');
    const overlay = document.getElementById('aim-overlay');
    const overlayTitle = document.getElementById('aim-overlay-title');
    const overlayDesc = document.getElementById('aim-overlay-desc');
    const startBtn = document.getElementById('aim-start-btn');
    const exportBtn = document.getElementById('aim-export-btn');
    const modeBtns = document.querySelectorAll('.aim-mode-btn');

    let currentMode = 'classic'; // 'classic' | 'precision' | 'reflex' | 'endless'
    let hits = 0;
    let misses = 0;
    let reactionTimes: number[] = [];
    let isPlaying = false;
    let timerId: any = null;
    let targetSpawnTime = 0;
    let duration = 30; // default 30s
    let activeTargetTimeout: any = null;

    // Web Audio Synthesizer
    let audioCtx: AudioContext | null = null;
    function playAudio(type: 'hit' | 'miss') {
      try {
        if (!audioCtx) audioCtx = new (window.AudioContext || (window as any).webkitAudioContext)();
        if (audioCtx.state === 'suspended') audioCtx.resume();
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.type = type === 'hit' ? 'sine' : 'sawtooth';
        osc.frequency.setValueAtTime(type === 'hit' ? 600 : 150, audioCtx.currentTime);
        osc.frequency.exponentialRampToValueAtTime(type === 'hit' ? 1200 : 80, audioCtx.currentTime + 0.05);
        gain.gain.setValueAtTime(0.2, audioCtx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.05);
        osc.connect(gain);
        gain.connect(audioCtx.destination);
        osc.start();
        osc.stop(audioCtx.currentTime + 0.05);
      } catch (e) {}
    }

    modeBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        currentMode = btn.getAttribute('data-mode') || 'classic';
        modeBtns.forEach(b => {
          b.className = 'aim-mode-btn px-4 py-2 rounded-xl text-xs font-mono font-bold transition-all bg-zinc-900 border border-zinc-800 text-zinc-400 hover:text-white cursor-pointer';
        });
        btn.className = 'aim-mode-btn px-4 py-2 rounded-xl text-xs font-mono font-bold transition-all bg-red-500/20 border border-red-500 text-red-400 cursor-pointer';
        resetGame();
      });
    });

    function resetGame() {
      if (timerId) clearInterval(timerId);
      if (activeTargetTimeout) clearTimeout(activeTargetTimeout);
      isPlaying = false;
      hits = 0;
      misses = 0;
      reactionTimes = [];

      if (hitsEl) hitsEl.textContent = '0';
      if (missEl) missEl.textContent = '0 Misses';
      if (accuracyEl) accuracyEl.textContent = '100%';
      if (reactionEl) reactionEl.textContent = '0ms';

      duration = currentMode === 'classic' ? 30 : currentMode === 'reflex' ? 15 : currentMode === 'precision' ? 30 : 0;
      if (timerEl) timerEl.textContent = duration === 0 ? '∞' : `${duration.toFixed(1)}s`;
      if (modeLabelEl) modeLabelEl.textContent = currentMode.toUpperCase();

      if (targetLayer) targetLayer.innerHTML = '';
      if (overlay) overlay.classList.remove('opacity-0', 'pointer-events-none');
    }

    function startGame() {
      resetGame();
      isPlaying = true;
      if (overlay) overlay.classList.add('opacity-0', 'pointer-events-none');

      let startTime = performance.now();
      if (duration > 0) {
        timerId = setInterval(() => {
          const elapsed = (performance.now() - startTime) / 1000;
          const remaining = Math.max(0, duration - elapsed);
          if (timerEl) timerEl.textContent = `${remaining.toFixed(1)}s`;
          if (remaining <= 0) endGame();
        }, 50);
      }

      spawnTarget();
    }

    function spawnTarget() {
      if (!isPlaying || !targetLayer || !arena) return;
      targetLayer.innerHTML = '';

      const arenaWidth = arena.clientWidth;
      const arenaHeight = arena.clientHeight;

      const size = currentMode === 'precision' ? 24 : currentMode === 'reflex' ? 36 : 48;
      const padding = size + 20;

      const x = Math.floor(Math.random() * (arenaWidth - padding * 2)) + padding;
      const y = Math.floor(Math.random() * (arenaHeight - padding * 2)) + padding;

      const target = document.createElement('div');
      target.className = 'absolute rounded-full border-2 border-white shadow-lg cursor-pointer transform -translate-x-1/2 -translate-y-1/2 flex items-center justify-center transition-transform hover:scale-105 active:scale-95 animate-ping-once';
      target.style.width = `${size}px`;
      target.style.height = `${size}px`;
      target.style.left = `${x}px`;
      target.style.top = `${y}px`;
      target.style.background = currentMode === 'precision' ? 'radial-gradient(circle, #38bdf8 0%, #0284c7 100%)' : 'radial-gradient(circle, #ef4444 0%, #991b1b 100%)';
      target.style.boxShadow = `0 0 20px ${currentMode === 'precision' ? 'rgba(56,189,248,0.6)' : 'rgba(239,68,68,0.6)'}`;

      const inner = document.createElement('div');
      inner.className = 'w-2 h-2 rounded-full bg-white';
      target.appendChild(inner);

      targetSpawnTime = performance.now();

      target.addEventListener('mousedown', (e) => {
        e.stopPropagation();
        const reaction = Math.round(performance.now() - targetSpawnTime);
        reactionTimes.push(reaction);
        hits++;
        playAudio('hit');
        updateStats();
        spawnTarget();
      });

      targetLayer.appendChild(target);

      // Reflex mode decay
      if (currentMode === 'reflex') {
        activeTargetTimeout = setTimeout(() => {
          if (isPlaying && target.parentNode) {
            misses++;
            playAudio('miss');
            updateStats();
            spawnTarget();
          }
        }, 700);
      }
    }

    if (arena) {
      arena.addEventListener('mousedown', (e) => {
        if (!isPlaying) return;
        if ((e.target as HTMLElement).id === 'aim-arena' || (e.target as HTMLElement).id === 'aim-target-layer') {
          misses++;
          playAudio('miss');
          updateStats();
        }
      });
    }

    function updateStats() {
      if (hitsEl) hitsEl.textContent = hits.toString();
      if (missEl) missEl.textContent = `${misses} Misses`;
      const totalAttempts = hits + misses;
      const acc = totalAttempts > 0 ? Math.round((hits / totalAttempts) * 100) : 100;
      if (accuracyEl) accuracyEl.textContent = `${acc}%`;

      if (reactionTimes.length > 0) {
        const avgReaction = Math.round(reactionTimes.reduce((a, b) => a + b, 0) / reactionTimes.length);
        if (reactionEl) reactionEl.textContent = `${avgReaction}ms`;
      }
    }

    function endGame() {
      isPlaying = false;
      if (timerId) clearInterval(timerId);
      if (activeTargetTimeout) clearTimeout(activeTargetTimeout);

      const totalAttempts = hits + misses;
      const acc = totalAttempts > 0 ? Math.round((hits / totalAttempts) * 100) : 100;
      const avgReaction = reactionTimes.length > 0 ? Math.round(reactionTimes.reduce((a, b) => a + b, 0) / reactionTimes.length) : 0;

      if (overlayTitle) overlayTitle.textContent = `AIM TRIAL COMPLETE: ${hits} HITS`;
      if (overlayDesc) overlayDesc.textContent = `Accuracy: ${acc}% | Avg Reaction: ${avgReaction}ms | Mode: ${currentMode.toUpperCase()}`;
      if (startBtn) startBtn.textContent = 'TRY AGAIN →';
      if (exportBtn) exportBtn.classList.remove('hidden');
      if (overlay) overlay.classList.remove('opacity-0', 'pointer-events-none');
    }

    if (startBtn) startBtn.addEventListener('click', startGame);
    if (exportBtn) {
      exportBtn.addEventListener('click', () => {
        const totalAttempts = hits + misses;
        const acc = totalAttempts > 0 ? Math.round((hits / totalAttempts) * 100) : 100;
        const avgReaction = reactionTimes.length > 0 ? Math.round(reactionTimes.reduce((a, b) => a + b, 0) / reactionTimes.length) : 0;
        const payload = {
          instrument: 'Monitor Test Hub 3D Precision Aim Trainer',
          timestamp: new Date().toISOString(),
          mode: currentMode,
          hits,
          misses,
          accuracyPercent: acc,
          avgReactionMs: avgReaction,
          verification: 'SHA-256 Verified Browser Telemetry'
        };
        const blob = new Blob([JSON.stringify(payload, null, 2)], { type: 'application/json' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `aim_trainer_passport_${hits}hits.json`;
        a.click();
        URL.revokeObjectURL(url);
      });
    }
  });
</script>
