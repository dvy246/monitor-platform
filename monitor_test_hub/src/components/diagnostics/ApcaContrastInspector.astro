---
import ErgonomicsNotice from '../disclaimers/ErgonomicsNotice.astro';
import HardwareLimitationNotice from '../disclaimers/HardwareLimitationNotice.astro';
---

<div class="bg-bg-surface border border-border-hairline rounded-2xl p-6 sm:p-8 space-y-8 shadow-2xl font-mono">
  <!-- Header Deck -->
  <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 border-b border-border-hairline pb-5">
    <div>
      <div class="text-xs font-bold text-status-pass uppercase tracking-widest flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-status-pass led-glow-pass animate-pulse"></span>
        <span>W3C APCA 0.98G &amp; WCAG 2.1 ERGONOMICS EVALUATOR</span>
      </div>
      <h3 class="text-xl font-extrabold text-text-primary mt-1">APCA Perceptual &amp; Ambient Contrast Inspector</h3>
    </div>
    <div id="apca-rating-badge" class="px-3 py-1 rounded-full bg-status-pass/10 border border-status-pass/30 text-status-pass text-xs font-bold uppercase">
      PREFERRED READABILITY (Lc &ge; 75)
    </div>
  </div>

  <!-- Main 12-col Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
    <!-- Controls (5 cols) -->
    <div class="lg:col-span-5 bg-bg-canvas p-5 rounded-xl border border-border-hairline space-y-5 text-xs">
      <h4 class="text-sm font-bold text-text-primary border-b border-border-hairline pb-2 flex items-center gap-2">
        <span>🎨 COLOR, FONT &amp; AMBIENT CONTROLS</span>
      </h4>

      <!-- Color Pickers / Hex Inputs -->
      <div class="grid grid-cols-2 gap-4">
        <!-- Text Color -->
        <div class="space-y-1.5">
          <label for="apca-text-color-picker" class="text-text-secondary font-bold block uppercase">Text Color</label>
          <div class="flex items-center gap-2">
            <input type="color" id="apca-text-color-picker" value="#F8FAFC" class="w-9 h-9 rounded cursor-pointer bg-transparent border border-border-hairline p-0.5">
            <input type="text" id="apca-text-hex" value="#F8FAFC" maxlength="7" class="w-full bg-bg-surface border border-border-hairline rounded-lg p-2 text-text-primary uppercase font-mono text-xs focus:ring-2 focus:ring-status-pass outline-none">
          </div>
        </div>

        <!-- Background Color -->
        <div class="space-y-1.5">
          <label for="apca-bg-color-picker" class="text-text-secondary font-bold block uppercase">Background</label>
          <div class="flex items-center gap-2">
            <input type="color" id="apca-bg-color-picker" value="#08080A" class="w-9 h-9 rounded cursor-pointer bg-transparent border border-border-hairline p-0.5">
            <input type="text" id="apca-bg-hex" value="#08080A" maxlength="7" class="w-full bg-bg-surface border border-border-hairline rounded-lg p-2 text-text-primary uppercase font-mono text-xs focus:ring-2 focus:ring-status-pass outline-none">
          </div>
        </div>
      </div>

      <!-- Quick Preset Palette Buttons -->
      <div>
        <span class="text-text-muted font-bold block mb-1.5 uppercase text-[10px]">Quick Presets</span>
        <div class="grid grid-cols-3 gap-2">
          <button type="button" data-preset-txt="#ffffff" data-preset-bg="#08080a" class="btn-preset py-1 px-2 rounded bg-bg-surface border border-border-hairline text-text-primary text-[10px] hover:bg-bg-elevated cursor-pointer">
            White on Dark
          </button>
          <button type="button" data-preset-txt="#e2e8f0" data-preset-bg="#121215" class="btn-preset py-1 px-2 rounded bg-bg-surface border border-border-hairline text-text-primary text-[10px] hover:bg-bg-elevated cursor-pointer">
            Off-White/Charcoal
          </button>
          <button type="button" data-preset-txt="#000000" data-preset-bg="#ffffff" class="btn-preset py-1 px-2 rounded bg-bg-surface border border-border-hairline text-text-primary text-[10px] hover:bg-bg-elevated cursor-pointer">
            Black on White
          </button>
        </div>
      </div>

      <!-- Font Weight & Font Size -->
      <div class="grid grid-cols-2 gap-3">
        <div>
          <label for="apca-font-weight" class="text-text-secondary font-bold block mb-1.5 uppercase">Font Weight</label>
          <select id="apca-font-weight" class="w-full bg-bg-surface border border-border-hairline rounded-lg p-2.5 text-text-primary font-mono cursor-pointer focus:ring-2 focus:ring-status-pass outline-none">
            <option value="100">100 (Thin)</option>
            <option value="300">300 (Light)</option>
            <option value="400" selected>400 (Regular)</option>
            <option value="600">600 (SemiBold)</option>
            <option value="700">700 (Bold)</option>
            <option value="900">900 (Black)</option>
          </select>
        </div>
        <div>
          <label for="apca-font-size" class="text-text-secondary font-bold block mb-1.5 uppercase">Font Size</label>
          <select id="apca-font-size" class="w-full bg-bg-surface border border-border-hairline rounded-lg p-2.5 text-text-primary font-mono cursor-pointer focus:ring-2 focus:ring-status-pass outline-none">
            <option value="12">12 px (Caption)</option>
            <option value="14">14 px (Body Small)</option>
            <option value="16" selected>16 px (Body Standard)</option>
            <option value="18">18 px (Body Large)</option>
            <option value="24">24 px (Heading H3)</option>
            <option value="36">36 px (Display H1)</option>
            <option value="48">48 px (Hero Banner)</option>
          </select>
        </div>
      </div>

      <!-- Panel Type / Native Contrast & Reflectance Presets -->
      <div class="grid grid-cols-2 gap-3">
        <div>
          <label for="apca-panel-preset" class="text-text-secondary font-bold block mb-1.5 uppercase">Panel Technology</label>
          <select id="apca-panel-preset" class="w-full bg-bg-surface border border-border-hairline rounded-lg p-2.5 text-text-primary font-mono cursor-pointer focus:ring-2 focus:ring-status-pass outline-none">
            <option value="1000000">OLED / QD-OLED (&infin;:1)</option>
            <option value="4000">VA Panel (4,000:1)</option>
            <option value="2000" selected>IPS Black (2,000:1)</option>
            <option value="1000">Standard IPS (1,000:1)</option>
          </select>
        </div>
        <div>
          <label for="apca-reflectance-preset" class="text-text-secondary font-bold block mb-1.5 uppercase">Screen Reflectance</label>
          <select id="apca-reflectance-preset" class="w-full bg-bg-surface border border-border-hairline rounded-lg p-2.5 text-text-primary font-mono cursor-pointer focus:ring-2 focus:ring-status-pass outline-none">
            <option value="0.015">Glossy AR Coating (1.5%)</option>
            <option value="0.025" selected>Semi-Gloss Anti-Glare (2.5%)</option>
            <option value="0.035">Matte Display (3.5%)</option>
            <option value="0.050">Heavy Anti-Glare Matte (5.0%)</option>
          </select>
        </div>
      </div>

      <!-- Ambient Room Lux & Peak Nits Sliders -->
      <div class="space-y-3 pt-2 border-t border-border-hairline">
        <div>
          <div class="flex justify-between text-text-secondary mb-1">
            <span class="font-bold uppercase">Ambient Room Illuminance:</span>
            <span id="lbl-room-lux" class="text-status-pass font-bold">300 Lux (Office)</span>
          </div>
          <input type="range" id="apca-room-lux" min="10" max="2000" step="10" value="300" class="w-full accent-status-pass cursor-pointer">
          <div class="flex justify-between text-[10px] text-text-muted mt-0.5">
            <span>10 Lux (Dark Room)</span>
            <span>300 Lux (Office)</span>
            <span>2000 Lux (Direct Sun)</span>
          </div>
        </div>

        <div>
          <div class="flex justify-between text-text-secondary mb-1">
            <span class="font-bold uppercase">Display Peak Luminance:</span>
            <span id="lbl-peak-nits" class="text-amber-400 font-bold">350 Nits</span>
          </div>
          <input type="range" id="apca-peak-nits" min="80" max="1000" step="10" value="350" class="w-full accent-amber-400 cursor-pointer">
          <div class="flex justify-between text-[10px] text-text-muted mt-0.5">
            <span>80 Nits (Dim)</span>
            <span>350 Nits (Standard)</span>
            <span>1000 Nits (HDR Peak)</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Output Telemetry (7 cols) -->
    <div class="lg:col-span-7 bg-bg-canvas p-5 rounded-xl border border-border-hairline space-y-6">
      <h4 class="text-sm font-bold text-text-primary border-b border-border-hairline pb-2 flex items-center justify-between">
        <span>📊 CONTRAST &amp; ERGONOMICS RESULTS</span>
        <span id="astigmatism-badge" class="text-xs font-mono font-bold text-status-pass uppercase">ASTIGMATISM RISK: LOW</span>
      </h4>

      <!-- Key Metrics Cards -->
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-4">
        <!-- APCA Score -->
        <div class="bg-bg-surface p-4 rounded-xl border border-border-hairline space-y-1">
          <div class="text-[11px] text-text-muted font-bold uppercase">APCA Lightness Contrast</div>
          <div id="stat-apca-lc" class="text-2xl sm:text-3xl font-black text-status-pass">Lc -82.4</div>
          <div id="stat-apca-polarity" class="text-[10px] text-text-secondary font-sans">Light on Dark</div>
        </div>

        <!-- WCAG Ratio -->
        <div class="bg-bg-surface p-4 rounded-xl border border-border-hairline space-y-1">
          <div class="text-[11px] text-text-muted font-bold uppercase">WCAG 2.1 Ratio</div>
          <div id="stat-wcag-ratio" class="text-2xl sm:text-3xl font-black text-amber-400">14.85:1</div>
          <div id="stat-wcag-badge" class="text-[10px] text-status-pass font-bold uppercase">AAA Pass (Normal)</div>
        </div>

        <!-- Effective ACR -->
        <div class="bg-bg-surface p-4 rounded-xl border border-border-hairline space-y-1 col-span-2 sm:col-span-1">
          <div class="text-[11px] text-text-muted font-bold uppercase">Ambient Contrast (ACR)</div>
          <div id="stat-effective-acr" class="text-2xl sm:text-3xl font-black text-cyan-400">145.2:1</div>
          <div id="stat-acr-loss" class="text-[10px] text-rose-400 font-bold font-sans">92.7% Glare Loss</div>
        </div>
      </div>

      <!-- Live Interactive Typography Preview Card -->
      <div class="space-y-2">
        <div class="text-xs font-bold text-text-secondary uppercase tracking-wider">Live Typography Preview Canvas</div>
        <div id="preview-canvas" class="w-full p-6 rounded-xl border border-border-hairline transition-colors flex flex-col justify-center gap-2 min-h-[140px]">
          <div id="preview-heading" class="font-extrabold tracking-tight">
            Perceptual Display Contrast Calibration
          </div>
          <div id="preview-body" class="leading-relaxed">
            The quick brown fox jumps over the lazy dog. APCA 0.98G evaluates lightness contrast ($L_c$) based on human spatial frequency sensitivity, font weight, and ambient display glare.
          </div>
        </div>
      </div>

      <!-- APCA Font Size & Weight Recommendation -->
      <div class="bg-bg-surface p-4 rounded-xl border border-border-hairline space-y-3">
        <div class="text-xs font-bold text-text-primary uppercase tracking-wider flex justify-between">
          <span>📏 APCA Font Size Recommendation:</span>
          <span id="rec-font-metrics" class="text-status-pass font-bold">Min 14px @ Weight 400</span>
        </div>
        
        <div class="grid grid-cols-2 gap-4 text-xs">
          <div class="space-y-1 bg-bg-canvas p-3 rounded-lg border border-border-hairline">
            <span class="text-text-muted font-bold block uppercase text-[10px]">WCAG 2.1 Conformance</span>
            <div id="wcag-checks-list" class="space-y-1 text-[11px]">
              <div class="flex justify-between"><span>Normal Text AA:</span><span class="text-status-pass font-bold">PASS</span></div>
              <div class="flex justify-between"><span>Normal Text AAA:</span><span class="text-status-pass font-bold">PASS</span></div>
            </div>
          </div>

          <div class="space-y-1 bg-bg-canvas p-3 rounded-lg border border-border-hairline">
            <span class="text-text-muted font-bold block uppercase text-[10px]">Ambient Glare &amp; Reflectance</span>
            <div class="space-y-1 text-[11px]">
              <div class="flex justify-between"><span>Perceived Black:</span><span id="stat-black-nits" class="text-text-primary font-bold">2.39 Nits</span></div>
              <div class="flex justify-between"><span>Glare Severity:</span><span id="stat-glare-severity" class="text-amber-400 font-bold uppercase">MODERATE</span></div>
            </div>
          </div>
        </div>

        <div class="space-y-1 text-xs text-text-secondary pt-1 border-t border-border-hairline">
          <div class="font-bold text-text-primary">Ergonomic &amp; Optometric Advice:</div>
          <ul id="ergo-advice-list" class="list-disc list-inside space-y-1 text-[11px] text-text-secondary">
            <li>Text contrast and display ambient contrast are well within ergonomic recommendations.</li>
          </ul>
        </div>
      </div>
    </div>
  </div>

  <HardwareLimitationNotice />
  <ErgonomicsNotice />
</div>

<script>
  import { evaluateFontErgonomics, hexToRgb } from '../../engine/ApcaAmbientContrastEngine';

  function initApcaInspector() {
    const textPicker = document.getElementById('apca-text-color-picker') as HTMLInputElement;
    const textHexInput = document.getElementById('apca-text-hex') as HTMLInputElement;
    const bgPicker = document.getElementById('apca-bg-color-picker') as HTMLInputElement;
    const bgHexInput = document.getElementById('apca-bg-hex') as HTMLInputElement;

    const fontWeightSelect = document.getElementById('apca-font-weight') as HTMLSelectElement;
    const fontSizeSelect = document.getElementById('apca-font-size') as HTMLSelectElement;

    const panelPresetSelect = document.getElementById('apca-panel-preset') as HTMLSelectElement;
    const reflectancePresetSelect = document.getElementById('apca-reflectance-preset') as HTMLSelectElement;

    const roomLuxSlider = document.getElementById('apca-room-lux') as HTMLInputElement;
    const lblRoomLux = document.getElementById('lbl-room-lux');

    const peakNitsSlider = document.getElementById('apca-peak-nits') as HTMLInputElement;
    const lblPeakNits = document.getElementById('lbl-peak-nits');

    const apcaBadge = document.getElementById('apca-rating-badge');
    const astigmatismBadge = document.getElementById('astigmatism-badge');

    const statApcaLc = document.getElementById('stat-apca-lc');
    const statApcaPolarity = document.getElementById('stat-apca-polarity');
    const statWcagRatio = document.getElementById('stat-wcag-ratio');
    const statWcagBadge = document.getElementById('stat-wcag-badge');
    const statEffectiveAcr = document.getElementById('stat-effective-acr');
    const statAcrLoss = document.getElementById('stat-acr-loss');

    const previewCanvas = document.getElementById('preview-canvas');
    const previewHeading = document.getElementById('preview-heading');
    const previewBody = document.getElementById('preview-body');

    const recFontMetrics = document.getElementById('rec-font-metrics');
    const wcagChecksList = document.getElementById('wcag-checks-list');
    const statBlackNits = document.getElementById('stat-black-nits');
    const statGlareSeverity = document.getElementById('stat-glare-severity');
    const ergoAdviceList = document.getElementById('ergo-advice-list');

    function update() {
      const txtHex = textHexInput.value.startsWith('#') ? textHexInput.value : `#${textHexInput.value}`;
      const bgHex = bgHexInput.value.startsWith('#') ? bgHexInput.value : `#${bgHexInput.value}`;

      const txtRgb = hexToRgb(txtHex);
      const bgRgb = hexToRgb(bgHex);

      const fontWeight = parseInt(fontWeightSelect.value, 10);
      const fontSize = parseInt(fontSizeSelect.value, 10);

      const roomLux = parseInt(roomLuxSlider.value, 10);
      const peakNits = parseInt(peakNitsSlider.value, 10);
      const nativeCR = parseFloat(panelPresetSelect.value);
      const reflectance = parseFloat(reflectancePresetSelect.value);

      if (lblRoomLux) lblRoomLux.textContent = `${roomLux} Lux`;
      if (lblPeakNits) lblPeakNits.textContent = `${peakNits} Nits`;

      const report = evaluateFontErgonomics(txtRgb, bgRgb, fontWeight, {
        nativeContrastRatio: nativeCR,
        peakLuminanceNits: peakNits,
        roomIlluminanceLux: roomLux,
        screenReflectanceFactor: reflectance,
      });

      // Update APCA stats
      if (statApcaLc) statApcaLc.textContent = `Lc ${report.apca.lightnessContrast}`;
      if (statApcaPolarity) statApcaPolarity.textContent = report.apca.polarity === 'lightOnDark' ? 'Light text on Dark bg' : 'Dark text on Light bg';

      if (apcaBadge) {
        apcaBadge.textContent = `${report.apca.readabilityRating.replace('_', ' ')} (Lc ${report.apca.lightnessContrast})`;
        if (report.apca.readabilityRating === 'PREFERRED') {
          apcaBadge.className = 'px-3 py-1 rounded-full bg-status-pass/10 border border-status-pass/30 text-status-pass text-xs font-bold uppercase';
        } else if (report.apca.readabilityRating === 'FLUENT_BODY') {
          apcaBadge.className = 'px-3 py-1 rounded-full bg-cyan-400/10 border border-cyan-400/30 text-cyan-400 text-xs font-bold uppercase';
        } else if (report.apca.readabilityRating === 'LARGE_TEXT_ONLY') {
          apcaBadge.className = 'px-3 py-1 rounded-full bg-amber-400/10 border border-amber-400/30 text-amber-400 text-xs font-bold uppercase';
        } else {
          apcaBadge.className = 'px-3 py-1 rounded-full bg-rose-400/10 border border-rose-400/30 text-rose-400 text-xs font-bold uppercase';
        }
      }

      // Update WCAG stats
      if (statWcagRatio) statWcagRatio.textContent = `${report.wcag.contrastRatio}:1`;
      if (statWcagBadge) {
        if (report.wcag.normalTextAAA) {
          statWcagBadge.textContent = 'AAA PASS (Normal Text)';
          statWcagBadge.className = 'text-[10px] text-status-pass font-bold uppercase';
        } else if (report.wcag.normalTextAA) {
          statWcagBadge.textContent = 'AA PASS (Normal Text)';
          statWcagBadge.className = 'text-[10px] text-cyan-400 font-bold uppercase';
        } else if (report.wcag.largeTextAA) {
          statWcagBadge.textContent = 'AA PASS (Large Text Only)';
          statWcagBadge.className = 'text-[10px] text-amber-400 font-bold uppercase';
        } else {
          statWcagBadge.textContent = 'WCAG FAIL (<3:1)';
          statWcagBadge.className = 'text-[10px] text-rose-400 font-bold uppercase';
        }
      }

      // Update Ambient Contrast Stats
      if (report.ambient) {
        if (statEffectiveAcr) statEffectiveAcr.textContent = `${report.ambient.effectiveAmbientContrastRatio}:1`;
        if (statAcrLoss) statAcrLoss.textContent = `${report.ambient.contrastLossPercent}% Glare Loss`;
        if (statBlackNits) statBlackNits.textContent = `${report.ambient.perceivedBlackLevelNits} Nits`;
        if (statGlareSeverity) statGlareSeverity.textContent = report.ambient.glareSeverity;
      }

      // Astigmatism Badge
      if (astigmatismBadge) {
        astigmatismBadge.textContent = `ASTIGMATISM RISK: ${report.astigmatismHalationRisk}`;
        if (report.astigmatismHalationRisk === 'HIGH') {
          astigmatismBadge.className = 'text-xs font-mono font-bold text-rose-400 uppercase';
        } else if (report.astigmatismHalationRisk === 'MODERATE') {
          astigmatismBadge.className = 'text-xs font-mono font-bold text-amber-400 uppercase';
        } else {
          astigmatismBadge.className = 'text-xs font-mono font-bold text-status-pass uppercase';
        }
      }

      // Live Preview Styling
      if (previewCanvas) {
        previewCanvas.style.backgroundColor = bgHex;
        previewCanvas.style.color = txtHex;
      }
      if (previewHeading) {
        previewHeading.style.fontWeight = fontWeight.toString();
        previewHeading.style.fontSize = `${Math.round(fontSize * 1.3)}px`;
      }
      if (previewBody) {
        previewBody.style.fontWeight = fontWeight.toString();
        previewBody.style.fontSize = `${fontSize}px`;
      }

      // Font recommendation
      if (recFontMetrics) {
        recFontMetrics.textContent = `Min ${report.apca.minimumFontSizePx}px @ Weight ${report.apca.recommendedFontWeight}`;
      }

      // WCAG detailed check list
      if (wcagChecksList) {
        wcagChecksList.innerHTML = `
          <div class="flex justify-between"><span>Normal Text AA (&ge;4.5):</span><span class="${report.wcag.normalTextAA ? 'text-status-pass' : 'text-rose-400'} font-bold">${report.wcag.normalTextAA ? 'PASS' : 'FAIL'}</span></div>
          <div class="flex justify-between"><span>Normal Text AAA (&ge;7.0):</span><span class="${report.wcag.normalTextAAA ? 'text-status-pass' : 'text-rose-400'} font-bold">${report.wcag.normalTextAAA ? 'PASS' : 'FAIL'}</span></div>
          <div class="flex justify-between"><span>Large Text AA (&ge;3.0):</span><span class="${report.wcag.largeTextAA ? 'text-status-pass' : 'text-rose-400'} font-bold">${report.wcag.largeTextAA ? 'PASS' : 'FAIL'}</span></div>
        `;
      }

      // Advice list
      if (ergoAdviceList) {
        ergoAdviceList.innerHTML = '';
        report.ergonomicAdvice.forEach((adv) => {
          const li = document.createElement('li');
          li.textContent = adv;
          ergoAdviceList.appendChild(li);
        });
      }
    }

    textPicker?.addEventListener('input', (e) => {
      textHexInput.value = (e.target as HTMLInputElement).value;
      update();
    });
    textHexInput?.addEventListener('input', () => {
      if (textHexInput.value.length === 7) {
        textPicker.value = textHexInput.value;
      }
      update();
    });

    bgPicker?.addEventListener('input', (e) => {
      bgHexInput.value = (e.target as HTMLInputElement).value;
      update();
    });
    bgHexInput?.addEventListener('input', () => {
      if (bgHexInput.value.length === 7) {
        bgPicker.value = bgHexInput.value;
      }
      update();
    });

    document.querySelectorAll('.btn-preset').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLButtonElement;
        const txt = target.dataset.presetTxt;
        const bg = target.dataset.presetBg;
        if (txt && bg) {
          textPicker.value = txt;
          textHexInput.value = txt;
          bgPicker.value = bg;
          bgHexInput.value = bg;
          update();
        }
      });
    });

    [fontWeightSelect, fontSizeSelect, panelPresetSelect, reflectancePresetSelect, roomLuxSlider, peakNitsSlider].forEach((el) => {
      el?.addEventListener('change', update);
      el?.addEventListener('input', update);
    });

    update();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initApcaInspector);
  } else {
    initApcaInspector();
  }
</script>
