---
import ErgonomicsNotice from '../disclaimers/ErgonomicsNotice.astro';
import HardwareLimitationNotice from '../disclaimers/HardwareLimitationNotice.astro';
---

<div class="w-full max-w-7xl mx-auto space-y-6 font-sans select-none min-w-0" id="apca-contrast-root">
  <div class="relative bg-[#0c0d12]/95 border border-zinc-800/90 rounded-3xl p-4 sm:p-8 backdrop-blur-2xl shadow-[0_25px_60px_rgba(0,0,0,0.8)] space-y-6 overflow-hidden min-w-0 text-zinc-100 font-mono">
    <!-- Ambient Glows -->
    <div class="absolute -top-24 -right-24 w-96 h-96 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-24 -left-24 w-96 h-96 bg-cyan-500/10 rounded-full blur-3xl pointer-events-none"></div>

    <!-- Header Deck -->
    <div class="relative z-10 flex flex-col md:flex-row items-start md:items-center justify-between gap-4 border-b border-zinc-800/70 pb-5">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-[11px] font-mono text-emerald-400 font-bold uppercase tracking-wider mb-2">
          <span class="w-2 h-2 rounded-full bg-emerald-400 shadow-[0_0_8px_rgba(52,211,153,0.9)] animate-pulse"></span>
          <span>W3C APCA 0.98G &amp; WCAG 2.1 ERGONOMICS EVALUATOR</span>
        </div>
        <h2 class="text-xl sm:text-3xl font-extrabold font-mono text-white tracking-tight">APCA Perceptual &amp; Ambient Contrast Inspector</h2>
        <p class="text-xs sm:text-sm text-zinc-400 mt-1 font-sans font-normal">Lightness contrast ($L_c$), ambient room glare loss, and astigmatism halation risk solver.</p>
      </div>
      <div id="apca-rating-badge" class="px-3.5 py-2 rounded-xl bg-emerald-500/20 border border-emerald-500/40 text-emerald-400 text-xs font-mono font-bold shadow-lg">
        PREFERRED READABILITY (Lc &ge; 75)
      </div>
    </div>

    <!-- Main 12-col Grid -->
    <div class="relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-6 min-w-0">
      <!-- Controls Column (5 cols) -->
      <div class="lg:col-span-5 bg-zinc-950/80 p-5 sm:p-6 rounded-2xl border border-zinc-800/80 space-y-5 text-xs shadow-inner min-w-0">
        <h3 class="text-xs font-mono font-bold text-zinc-300 uppercase tracking-wider border-b border-zinc-800/80 pb-2.5 flex items-center gap-2">
          <span>🎨 COLOR, FONT &amp; AMBIENT CONTROLS</span>
        </h3>

        <!-- Color Pickers / Hex Inputs -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <!-- Text Color -->
          <div class="space-y-1.5 min-w-0">
            <label for="apca-text-color-picker" class="text-zinc-400 font-bold block uppercase">Text Color</label>
            <div class="flex items-center gap-2 min-w-0">
              <input type="color" id="apca-text-color-picker" value="#F8FAFC" class="w-10 h-10 rounded-xl cursor-pointer bg-transparent border border-zinc-700/80 p-1 shrink-0">
              <input type="text" id="apca-text-hex" value="#F8FAFC" maxlength="7" class="w-full bg-zinc-900 border border-zinc-700/80 rounded-xl p-2.5 text-white uppercase font-mono text-xs focus:border-emerald-500 focus:outline-none">
            </div>
          </div>

          <!-- Background Color -->
          <div class="space-y-1.5 min-w-0">
            <label for="apca-bg-color-picker" class="text-zinc-400 font-bold block uppercase">Background</label>
            <div class="flex items-center gap-2 min-w-0">
              <input type="color" id="apca-bg-color-picker" value="#08080A" class="w-10 h-10 rounded-xl cursor-pointer bg-transparent border border-zinc-700/80 p-1 shrink-0">
              <input type="text" id="apca-bg-hex" value="#08080A" maxlength="7" class="w-full bg-zinc-900 border border-zinc-700/80 rounded-xl p-2.5 text-white uppercase font-mono text-xs focus:border-emerald-500 focus:outline-none">
            </div>
          </div>
        </div>

        <!-- Quick Preset Palette Buttons -->
        <div class="space-y-2">
          <label class="text-zinc-400 font-bold block uppercase text-[11px]">Quick Presets</label>
          <div class="grid grid-cols-3 gap-2 font-mono text-[11px]">
            <button type="button" class="btn-preset px-2.5 py-2 min-h-[44px] sm:min-h-0 rounded-xl bg-zinc-900 border border-zinc-800 text-zinc-300 hover:text-white hover:border-emerald-500/50 transition cursor-pointer text-center font-semibold truncate" data-preset-txt="#FFFFFF" data-preset-bg="#0c0d12">White / Dark</button>
            <button type="button" class="btn-preset px-2.5 py-2 min-h-[44px] sm:min-h-0 rounded-xl bg-zinc-900 border border-zinc-800 text-zinc-300 hover:text-white hover:border-emerald-500/50 transition cursor-pointer text-center font-semibold truncate" data-preset-txt="#E2E8F0" data-preset-bg="#18181B">Off-White</button>
            <button type="button" class="btn-preset px-2.5 py-2 min-h-[44px] sm:min-h-0 rounded-xl bg-zinc-900 border border-zinc-800 text-zinc-300 hover:text-white hover:border-emerald-500/50 transition cursor-pointer text-center font-semibold truncate" data-preset-txt="#000000" data-preset-bg="#FFFFFF">Black / White</button>
          </div>
        </div>

        <!-- Font Weight & Size -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 min-w-0">
          <div class="min-w-0">
            <label for="apca-font-weight" class="text-zinc-400 font-bold block mb-1.5 uppercase">Font Weight</label>
            <select id="apca-font-weight" class="w-full bg-zinc-900 border border-zinc-700/80 rounded-xl p-2.5 text-white font-mono text-xs focus:border-emerald-500 focus:outline-none cursor-pointer">
              <option value="100">100 Thin</option>
              <option value="300">300 Light</option>
              <option value="400" selected>400 Regular</option>
              <option value="600">600 SemiBold</option>
              <option value="700">700 Bold</option>
              <option value="900">900 Black</option>
            </select>
          </div>

          <div class="min-w-0">
            <label for="apca-font-size" class="text-zinc-400 font-bold block mb-1.5 uppercase">Font Size</label>
            <select id="apca-font-size" class="w-full bg-zinc-900 border border-zinc-700/80 rounded-xl p-2.5 text-white font-mono text-xs focus:border-emerald-500 focus:outline-none cursor-pointer">
              <option value="12">12px Caption</option>
              <option value="14">14px Body S</option>
              <option value="16" selected>16px Body M</option>
              <option value="18">18px Body L</option>
              <option value="24">24px Heading H3</option>
              <option value="36">36px Display H1</option>
              <option value="48">48px Hero</option>
            </select>
          </div>
        </div>

        <!-- Panel Type / Native Contrast & Reflectance Presets -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 min-w-0">
          <div class="min-w-0">
            <label for="apca-panel-preset" class="text-zinc-400 font-bold block mb-1.5 uppercase">Panel Technology</label>
            <select id="apca-panel-preset" class="w-full bg-zinc-900 border border-zinc-700/80 rounded-xl p-2.5 text-white font-mono text-xs focus:border-emerald-500 focus:outline-none cursor-pointer">
              <option value="1000000">OLED (∞:1)</option>
              <option value="4000">VA (4000:1)</option>
              <option value="2000" selected>IPS Black (2000:1)</option>
              <option value="1000">IPS (1000:1)</option>
            </select>
          </div>
          <div class="min-w-0">
            <label for="apca-reflectance-preset" class="text-zinc-400 font-bold block mb-1.5 uppercase">Screen Reflectance</label>
            <select id="apca-reflectance-preset" class="w-full bg-zinc-900 border border-zinc-700/80 rounded-xl p-2.5 text-white font-mono text-xs focus:border-emerald-500 focus:outline-none cursor-pointer">
              <option value="0.015">Glossy AR (1.5%)</option>
              <option value="0.025" selected>Semi-Gloss (2.5%)</option>
              <option value="0.035">Matte (3.5%)</option>
              <option value="0.050">Heavy Matte (5.0%)</option>
            </select>
          </div>
        </div>

        <!-- Ambient Room Lux & Peak Nits Sliders -->
        <div class="space-y-4 pt-3 border-t border-zinc-800">
          <div>
            <div class="flex justify-between text-zinc-400 mb-1.5 font-bold">
              <span class="uppercase">Ambient Room Illuminance:</span>
              <span id="lbl-room-lux" class="text-emerald-400 font-bold">300 Lux (Office)</span>
            </div>
            <input type="range" id="apca-room-lux" min="10" max="2000" step="10" value="300" class="w-full accent-emerald-400 cursor-pointer h-2 bg-zinc-800 rounded-lg">
            <div class="flex justify-between text-[11px] text-zinc-500 mt-1 font-mono">
              <span>10 Lux (Dark)</span>
              <span>300 Lux (Office)</span>
              <span>2000 Lux (Sun)</span>
            </div>
          </div>

          <div>
            <div class="flex justify-between text-zinc-400 mb-1.5 font-bold">
              <span class="uppercase">Display Peak Luminance:</span>
              <span id="lbl-peak-nits" class="text-amber-400 font-bold">350 Nits</span>
            </div>
            <input type="range" id="apca-peak-nits" min="80" max="1000" step="10" value="350" class="w-full accent-amber-400 cursor-pointer h-2 bg-zinc-800 rounded-lg">
            <div class="flex justify-between text-[11px] text-zinc-500 mt-1 font-mono">
              <span>80 Nits (Dim)</span>
              <span>350 Nits (Std)</span>
              <span>1000 Nits (HDR)</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Output Telemetry (7 cols) -->
      <div class="lg:col-span-7 bg-zinc-950/80 p-5 sm:p-6 rounded-2xl border border-zinc-800/80 space-y-6 shadow-inner min-w-0">
        <h3 class="text-xs font-mono font-bold text-zinc-300 uppercase tracking-wider border-b border-zinc-800/80 pb-2.5 flex flex-wrap items-center justify-between gap-2">
          <span>📊 CONTRAST &amp; ERGONOMICS RESULTS</span>
          <span id="astigmatism-badge" class="text-xs font-mono font-bold text-emerald-400 uppercase">ASTIGMATISM RISK: LOW</span>
        </h3>

        <!-- Key Metrics Cards Deck -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <!-- APCA Score -->
          <div class="bg-zinc-900/90 p-4 rounded-xl border border-zinc-800 space-y-1 min-w-0 overflow-hidden">
            <div class="text-[11px] text-zinc-400 font-bold uppercase truncate">APCA Contrast</div>
            <div id="stat-apca-lc" class="text-xl sm:text-2xl font-extrabold text-emerald-400 tracking-tight tabular-nums truncate">Lc -82.4</div>
            <div id="stat-apca-polarity" class="text-[10px] text-zinc-400 font-sans truncate">Light text on Dark bg</div>
          </div>

          <!-- WCAG Ratio -->
          <div class="bg-zinc-900/90 p-4 rounded-xl border border-zinc-800 space-y-1 min-w-0 overflow-hidden">
            <div class="text-[11px] text-zinc-400 font-bold uppercase truncate">WCAG 2.1 Ratio</div>
            <div id="stat-wcag-ratio" class="text-xl sm:text-2xl font-extrabold text-amber-400 tracking-tight tabular-nums truncate">14.85:1</div>
            <div id="stat-wcag-badge" class="text-[10px] text-emerald-400 font-bold uppercase truncate">AAA Pass (Normal)</div>
          </div>

          <!-- Effective ACR -->
          <div class="bg-zinc-900/90 p-4 rounded-xl border border-zinc-800 space-y-1 min-w-0 overflow-hidden">
            <div class="text-[11px] text-zinc-400 font-bold uppercase truncate">Ambient ACR</div>
            <div id="stat-effective-acr" class="text-xl sm:text-2xl font-extrabold text-cyan-400 tracking-tight tabular-nums truncate">145.2:1</div>
            <div id="stat-acr-loss" class="text-[10px] text-rose-400 font-bold font-sans truncate">92.7% Glare Loss</div>
          </div>
        </div>

        <!-- Live Interactive Typography Preview Card -->
        <div class="space-y-2 min-w-0">
          <div class="text-xs font-bold text-zinc-400 uppercase tracking-wider">Live Typography Preview Canvas</div>
          <div id="preview-canvas" class="w-full p-5 sm:p-6 rounded-2xl border border-zinc-800 transition-colors flex flex-col justify-center gap-2 min-h-[140px] shadow-inner overflow-hidden">
            <div id="preview-heading" class="font-extrabold tracking-tight break-words">
              Perceptual Display Contrast Calibration
            </div>
            <div id="preview-body" class="leading-relaxed font-sans break-words">
              The quick brown fox jumps over the lazy dog. APCA 0.98G evaluates lightness contrast ($L_c$) based on human spatial frequency sensitivity, font weight, and ambient display glare.
            </div>
          </div>
        </div>

        <!-- APCA Font Size & Weight Recommendation -->
        <div class="bg-zinc-900/90 p-4 sm:p-5 rounded-xl border border-zinc-800 space-y-3 min-w-0">
          <div class="text-xs font-bold text-zinc-300 uppercase tracking-wider flex justify-between items-center flex-wrap gap-1">
            <span>📏 APCA Font Recommendation:</span>
            <span id="rec-font-metrics" class="text-emerald-400 font-bold">Min 14px @ Weight 400</span>
          </div>
          
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs font-mono">
            <div class="space-y-1.5 bg-zinc-950 p-3.5 rounded-xl border border-zinc-800">
              <span class="text-zinc-400 font-bold block uppercase text-[10px]">WCAG 2.1 Conformance</span>
              <div id="wcag-checks-list" class="space-y-1 text-[11px]">
                <div class="flex justify-between"><span>Normal Text AA (&ge;4.5):</span><span class="text-emerald-400 font-bold">PASS</span></div>
                <div class="flex justify-between"><span>Normal Text AAA (&ge;7.0):</span><span class="text-emerald-400 font-bold">PASS</span></div>
                <div class="flex justify-between"><span>Large Text AA (&ge;3.0):</span><span class="text-emerald-400 font-bold">PASS</span></div>
              </div>
            </div>

            <div class="space-y-1.5 bg-zinc-950 p-3.5 rounded-xl border border-zinc-800">
              <span class="text-zinc-400 font-bold block uppercase text-[10px]">Glare &amp; Black Level</span>
              <div class="space-y-1 text-[11px]">
                <div class="flex justify-between"><span>Perceived Black:</span><span id="stat-black-nits" class="text-white font-bold">0.05 Nits</span></div>
                <div class="flex justify-between"><span>Glare Severity:</span><span id="stat-glare-severity" class="text-amber-400 font-bold">Moderate</span></div>
              </div>
            </div>
          </div>

          <div class="pt-2 border-t border-zinc-800">
            <div class="text-[11px] font-bold text-zinc-400 uppercase mb-1">Ergonomic Recommendations:</div>
            <ul id="ergo-advice-list" class="list-disc list-inside text-[11px] text-zinc-300 font-sans space-y-0.5 leading-relaxed">
              <li>Current contrast meets APCA preferred threshold ($L_c \ge 75$) for body text.</li>
            </ul>
          </div>
        </div>
      </div>
    </div>

    <HardwareLimitationNotice />
    <ErgonomicsNotice />
  </div>
</div>

<script>
  import { evaluateFontErgonomics, hexToRgb } from '../../engine/ApcaAmbientContrastEngine';

  function initApcaInspector() {
    const textPicker = document.getElementById('apca-text-color-picker') as HTMLInputElement;
    const textHexInput = document.getElementById('apca-text-hex') as HTMLInputElement;
    const bgPicker = document.getElementById('apca-bg-color-picker') as HTMLInputElement;
    const bgHexInput = document.getElementById('apca-bg-hex') as HTMLInputElement;

    const fontWeightSelect = document.getElementById('apca-font-weight') as HTMLSelectElement;
    const fontSizeSelect = document.getElementById('apca-font-size') as HTMLSelectElement;

    const panelPresetSelect = document.getElementById('apca-panel-preset') as HTMLSelectElement;
    const reflectancePresetSelect = document.getElementById('apca-reflectance-preset') as HTMLSelectElement;

    const roomLuxSlider = document.getElementById('apca-room-lux') as HTMLInputElement;
    const lblRoomLux = document.getElementById('lbl-room-lux');

    const peakNitsSlider = document.getElementById('apca-peak-nits') as HTMLInputElement;
    const lblPeakNits = document.getElementById('lbl-peak-nits');

    const apcaBadge = document.getElementById('apca-rating-badge');
    const astigmatismBadge = document.getElementById('astigmatism-badge');

    const statApcaLc = document.getElementById('stat-apca-lc');
    const statApcaPolarity = document.getElementById('stat-apca-polarity');
    const statWcagRatio = document.getElementById('stat-wcag-ratio');
    const statWcagBadge = document.getElementById('stat-wcag-badge');
    const statEffectiveAcr = document.getElementById('stat-effective-acr');
    const statAcrLoss = document.getElementById('stat-acr-loss');

    const previewCanvas = document.getElementById('preview-canvas');
    const previewHeading = document.getElementById('preview-heading');
    const previewBody = document.getElementById('preview-body');

    const recFontMetrics = document.getElementById('rec-font-metrics');
    const wcagChecksList = document.getElementById('wcag-checks-list');
    const statBlackNits = document.getElementById('stat-black-nits');
    const statGlareSeverity = document.getElementById('stat-glare-severity');
    const ergoAdviceList = document.getElementById('ergo-advice-list');

    if (!textHexInput || !bgHexInput || !fontWeightSelect || !fontSizeSelect || !panelPresetSelect || !reflectancePresetSelect || !roomLuxSlider || !peakNitsSlider) {
      return;
    }

    function update() {
      const txtHex = textHexInput.value.startsWith('#') ? textHexInput.value : `#${textHexInput.value}`;
      const bgHex = bgHexInput.value.startsWith('#') ? bgHexInput.value : `#${bgHexInput.value}`;

      const txtRgb = hexToRgb(txtHex);
      const bgRgb = hexToRgb(bgHex);

      const fontWeight = parseInt(fontWeightSelect.value, 10);
      const fontSize = parseInt(fontSizeSelect.value, 10);

      const roomLux = parseInt(roomLuxSlider.value, 10);
      const peakNits = parseInt(peakNitsSlider.value, 10);
      const nativeCR = parseFloat(panelPresetSelect.value);
      const reflectance = parseFloat(reflectancePresetSelect.value);

      if (lblRoomLux) lblRoomLux.textContent = `${roomLux} Lux`;
      if (lblPeakNits) lblPeakNits.textContent = `${peakNits} Nits`;

      const report = evaluateFontErgonomics(txtRgb, bgRgb, fontWeight, {
        nativeContrastRatio: nativeCR,
        peakLuminanceNits: peakNits,
        roomIlluminanceLux: roomLux,
        screenReflectanceFactor: reflectance,
      });

      // Update APCA stats
      if (statApcaLc) statApcaLc.textContent = `Lc ${report.apca.lightnessContrast}`;
      if (statApcaPolarity) statApcaPolarity.textContent = report.apca.polarity === 'lightOnDark' ? 'Light text on Dark bg' : 'Dark text on Light bg';

      if (apcaBadge) {
        apcaBadge.textContent = `${report.apca.readabilityRating.replace('_', ' ')} (Lc ${report.apca.lightnessContrast})`;
        if (report.apca.readabilityRating === 'PREFERRED') {
          apcaBadge.className = 'px-3.5 py-2 rounded-xl bg-emerald-500/20 border border-emerald-500/40 text-emerald-400 text-xs font-mono font-bold shadow-lg';
        } else if (report.apca.readabilityRating === 'FLUENT_BODY') {
          apcaBadge.className = 'px-3.5 py-2 rounded-xl bg-cyan-500/20 border border-cyan-500/40 text-cyan-400 text-xs font-mono font-bold shadow-lg';
        } else if (report.apca.readabilityRating === 'LARGE_TEXT_ONLY') {
          apcaBadge.className = 'px-3.5 py-2 rounded-xl bg-amber-500/20 border border-amber-500/40 text-amber-400 text-xs font-mono font-bold shadow-lg';
        } else {
          apcaBadge.className = 'px-3.5 py-2 rounded-xl bg-rose-500/20 border border-rose-500/40 text-rose-400 text-xs font-mono font-bold shadow-lg';
        }
      }

      // Update WCAG stats
      if (statWcagRatio) statWcagRatio.textContent = `${report.wcag.contrastRatio}:1`;
      if (statWcagBadge) {
        if (report.wcag.normalTextAAA) {
          statWcagBadge.textContent = 'AAA PASS (Normal Text)';
          statWcagBadge.className = 'text-[10px] text-emerald-400 font-bold uppercase truncate';
        } else if (report.wcag.normalTextAA) {
          statWcagBadge.textContent = 'AA PASS (Normal Text)';
          statWcagBadge.className = 'text-[10px] text-cyan-400 font-bold uppercase truncate';
        } else if (report.wcag.largeTextAA) {
          statWcagBadge.textContent = 'AA PASS (Large Text Only)';
          statWcagBadge.className = 'text-[10px] text-amber-400 font-bold uppercase truncate';
        } else {
          statWcagBadge.textContent = 'WCAG FAIL (<3:1)';
          statWcagBadge.className = 'text-[10px] text-rose-400 font-bold uppercase truncate';
        }
      }

      // Update Ambient Contrast Stats
      if (report.ambient) {
        if (statEffectiveAcr) statEffectiveAcr.textContent = `${report.ambient.effectiveAmbientContrastRatio}:1`;
        if (statAcrLoss) statAcrLoss.textContent = `${report.ambient.contrastLossPercent}% Glare Loss`;
        if (statBlackNits) statBlackNits.textContent = `${report.ambient.perceivedBlackLevelNits} Nits`;
        if (statGlareSeverity) statGlareSeverity.textContent = report.ambient.glareSeverity;
      }

      // Astigmatism Badge
      if (astigmatismBadge) {
        astigmatismBadge.textContent = `ASTIGMATISM RISK: ${report.astigmatismHalationRisk}`;
        if (report.astigmatismHalationRisk === 'HIGH') {
          astigmatismBadge.className = 'text-xs font-mono font-bold text-rose-400 uppercase';
        } else if (report.astigmatismHalationRisk === 'MODERATE') {
          astigmatismBadge.className = 'text-xs font-mono font-bold text-amber-400 uppercase';
        } else {
          astigmatismBadge.className = 'text-xs font-mono font-bold text-emerald-400 uppercase';
        }
      }

      // Live Preview Styling
      if (previewCanvas) {
        previewCanvas.style.backgroundColor = bgHex;
        previewCanvas.style.color = txtHex;
      }
      if (previewHeading) {
        previewHeading.style.fontWeight = fontWeight.toString();
        previewHeading.style.fontSize = `${Math.round(fontSize * 1.3)}px`;
      }
      if (previewBody) {
        previewBody.style.fontWeight = fontWeight.toString();
        previewBody.style.fontSize = `${fontSize}px`;
      }

      // Font recommendation
      if (recFontMetrics) {
        recFontMetrics.textContent = `Min ${report.apca.minimumFontSizePx}px @ Weight ${report.apca.recommendedFontWeight}`;
      }

      // WCAG detailed check list
      if (wcagChecksList) {
        wcagChecksList.innerHTML = `
          <div class="flex justify-between"><span>Normal Text AA (&ge;4.5):</span><span class="${report.wcag.normalTextAA ? 'text-emerald-400' : 'text-rose-400'} font-bold">${report.wcag.normalTextAA ? 'PASS' : 'FAIL'}</span></div>
          <div class="flex justify-between"><span>Normal Text AAA (&ge;7.0):</span><span class="${report.wcag.normalTextAAA ? 'text-emerald-400' : 'text-rose-400'} font-bold">${report.wcag.normalTextAAA ? 'PASS' : 'FAIL'}</span></div>
          <div class="flex justify-between"><span>Large Text AA (&ge;3.0):</span><span class="${report.wcag.largeTextAA ? 'text-emerald-400' : 'text-rose-400'} font-bold">${report.wcag.largeTextAA ? 'PASS' : 'FAIL'}</span></div>
        `;
      }

      // Advice list
      if (ergoAdviceList) {
        ergoAdviceList.innerHTML = '';
        report.ergonomicAdvice.forEach((adv) => {
          const li = document.createElement('li');
          li.textContent = adv;
          ergoAdviceList.appendChild(li);
        });
      }
    }

    textPicker?.addEventListener('input', (e) => {
      textHexInput.value = (e.target as HTMLInputElement).value;
      update();
    });
    textHexInput?.addEventListener('input', () => {
      if (textHexInput.value.length === 7) {
        textPicker.value = textHexInput.value;
      }
      update();
    });

    bgPicker?.addEventListener('input', (e) => {
      bgHexInput.value = (e.target as HTMLInputElement).value;
      update();
    });
    bgHexInput?.addEventListener('input', () => {
      if (bgHexInput.value.length === 7) {
        bgPicker.value = bgHexInput.value;
      }
      update();
    });

    document.querySelectorAll('.btn-preset').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLButtonElement;
        const txt = target.dataset.presetTxt;
        const bg = target.dataset.presetBg;
        if (txt && bg) {
          textPicker.value = txt;
          textHexInput.value = txt;
          bgPicker.value = bg;
          bgHexInput.value = bg;
          update();
        }
      });
    });

    [fontWeightSelect, fontSizeSelect, panelPresetSelect, reflectancePresetSelect, roomLuxSlider, peakNitsSlider].forEach((el) => {
      el?.addEventListener('change', update);
      el?.addEventListener('input', update);
    });

    update();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initApcaInspector);
  } else {
    initApcaInspector();
  }
</script>
