---
import { ApplianceEnergyEngine } from '../../engine/ApplianceEnergyEngine';

interface Props {
  initialStateCode?: string;
  initialApplianceId?: string;
}

const { initialStateCode = 'US', initialApplianceId = 'space-heater' } = Astro.props;

const states = ApplianceEnergyEngine.US_STATES;
const appliances = ApplianceEnergyEngine.APPLIANCES;
const initialResult = ApplianceEnergyEngine.calculateCost(initialStateCode, initialApplianceId);
---

<div class="w-full max-w-7xl mx-auto space-y-6 font-sans select-none min-w-0" id="appliance-energy-root">
  <div class="relative bg-[#0c0d12]/95 border border-zinc-800/90 rounded-3xl p-4 sm:p-8 backdrop-blur-2xl shadow-[0_25px_60px_rgba(0,0,0,0.8)] space-y-6 overflow-hidden min-w-0 text-zinc-100 font-mono">
    <!-- Ambient Glows -->
    <div class="absolute -top-24 -right-24 w-96 h-96 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-24 -left-24 w-96 h-96 bg-cyan-500/10 rounded-full blur-3xl pointer-events-none"></div>

    <!-- Header Controls -->
    <div class="relative z-10 flex flex-col md:flex-row items-start md:items-center justify-between gap-4 border-b border-zinc-800/70 pb-5">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-500/10 border border-amber-500/30 text-[11px] font-mono text-amber-400 font-bold uppercase tracking-wider mb-2">
          <span class="w-2 h-2 rounded-full bg-amber-400 shadow-[0_0_8px_rgba(251,191,36,0.9)] animate-pulse"></span>
          <span>EIA RESIDENTIAL ENERGY COST ENGINE</span>
        </div>
        <h2 class="text-xl sm:text-3xl font-extrabold font-mono text-white tracking-tight">Appliance Electricity Cost Calculator</h2>
        <p class="text-xs sm:text-sm text-zinc-400 mt-1 font-sans font-normal">State-by-state 50-US electricity rate auto-population with wattage controls.</p>
      </div>
    </div>

    <div class="relative z-10 grid grid-cols-1 lg:grid-cols-3 gap-6">
      <!-- Input Controls Deck -->
      <div class="space-y-5 bg-zinc-950/80 p-5 sm:p-6 rounded-2xl border border-zinc-800/80 text-xs shadow-inner">
        <div>
          <label for="state-select" class="flex items-center gap-1.5 font-bold uppercase text-zinc-400 mb-2">
            <svg class="w-4 h-4 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span>Select US State</span>
          </label>
          <select id="state-select" class="w-full bg-zinc-900 border border-zinc-700/80 rounded-xl p-3 text-xs text-white font-mono focus:border-amber-500 focus:outline-none cursor-pointer">
            {states.map(st => (
              <option value={st.code} selected={st.code === initialStateCode}>
                {st.name} ({st.rateCentsPerKwh}¢/kWh)
              </option>
            ))}
          </select>
        </div>

        <div>
          <label for="appliance-select" class="flex items-center gap-1.5 font-bold uppercase text-zinc-400 mb-2">
            <svg class="w-4 h-4 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
            <span>Select Appliance Preset</span>
          </label>
          <select id="appliance-select" class="w-full bg-zinc-900 border border-zinc-700/80 rounded-xl p-3 text-xs text-white font-mono focus:border-amber-500 focus:outline-none cursor-pointer">
            {appliances.map(app => (
              <option value={app.id} selected={app.id === initialApplianceId}>
                {app.name} ({app.defaultWattage}W, {app.defaultHoursPerDay}h/day)
              </option>
            ))}
          </select>
        </div>

        <div>
          <div class="flex justify-between text-zinc-400 font-bold mb-2">
            <span>Power Consumption (Watts):</span>
            <span id="watt-disp" class="text-amber-400 text-sm">1500W</span>
          </div>
          <input id="watt-slider" type="range" min="10" max="5000" step="10" value={initialResult.wattage} class="w-full accent-amber-400 cursor-pointer h-2 bg-zinc-800 rounded-lg" />
        </div>

        <div>
          <div class="flex justify-between text-zinc-400 font-bold mb-2">
            <span>Daily Usage (Hours):</span>
            <span id="hours-disp" class="text-amber-400 text-sm">8.0 hrs/day</span>
          </div>
          <input id="hours-slider" type="range" min="0.5" max="24" step="0.5" value={initialResult.hoursPerDay} class="w-full accent-amber-400 cursor-pointer h-2 bg-zinc-800 rounded-lg" />
        </div>
      </div>

      <!-- Cost & Telemetry Deck -->
      <div class="lg:col-span-2 space-y-5">
        <div class="bg-zinc-950/80 p-5 sm:p-6 rounded-2xl border border-zinc-800/80 grid grid-cols-1 sm:grid-cols-3 gap-4 text-center shadow-inner">
          <div class="bg-zinc-900/90 p-4 rounded-xl border border-zinc-800 space-y-1">
            <div class="text-[11px] text-zinc-400 font-bold uppercase">Daily Cost</div>
            <div id="cost-daily" class="text-2xl sm:text-3xl font-extrabold text-amber-400 mt-1 tabular-nums">${initialResult.dailyCostUsd}</div>
          </div>

          <div class="bg-zinc-900/90 p-4 rounded-xl border border-zinc-800 space-y-1">
            <div class="text-[11px] text-zinc-400 font-bold uppercase">Monthly Cost</div>
            <div id="cost-monthly" class="text-2xl sm:text-3xl font-extrabold text-cyan-400 mt-1 tabular-nums">${initialResult.monthlyCostUsd}</div>
          </div>

          <div class="bg-zinc-900/90 p-4 rounded-xl border border-zinc-800 space-y-1">
            <div class="text-[11px] text-zinc-400 font-bold uppercase">Annual Cost</div>
            <div id="cost-annual" class="text-2xl sm:text-3xl font-extrabold text-emerald-400 mt-1 tabular-nums">${initialResult.annualCostUsd}</div>
          </div>
        </div>

        <div class="bg-zinc-950/80 p-5 sm:p-6 rounded-2xl border border-zinc-800/80 space-y-3 shadow-inner text-xs">
          <div class="text-zinc-400 uppercase font-bold">Electricity Tariff Summary:</div>
          <p id="energy-desc" class="text-zinc-300 font-sans leading-relaxed">
            {initialResult.explanation}
          </p>
        </div>
      </div>
    </div>
  </div>
</div>
