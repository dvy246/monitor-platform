---
import { ApplianceEnergyEngine } from '../../engine/ApplianceEnergyEngine';

interface Props {
  initialStateCode?: string;
  initialApplianceId?: string;
}

const { initialStateCode = 'US', initialApplianceId = 'space-heater' } = Astro.props;

const states = ApplianceEnergyEngine.US_STATES;
const appliances = ApplianceEnergyEngine.APPLIANCES;
const initialResult = ApplianceEnergyEngine.calculateCost(initialStateCode, initialApplianceId);
---

<div class="w-full max-w-5xl mx-auto p-4 md:p-6 bg-[#121215] border border-white/10 rounded-2xl shadow-2xl text-slate-100 font-sans">
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-6 border-b border-white/10">
    <div>
      <div class="flex items-center gap-2 text-amber-400 text-xs font-mono uppercase tracking-widest mb-1">
        <svg class="w-4 h-4 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
        </svg>
        <span>EIA Residential Energy Calculator</span>
      </div>
      <h2 class="text-2xl md:text-3xl font-black text-white tracking-tight">Appliance Electricity Cost Calculator</h2>
      <p class="text-sm text-slate-400 mt-1">State-by-state 50-US electricity rate auto-population with custom wattage controls.</p>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mt-6">
    <div class="space-y-4 bg-black/30 p-5 rounded-xl border border-white/5">
      <div>
        <label class="flex items-center gap-1.5 text-xs font-mono uppercase text-slate-400 mb-2">
          <svg class="w-4 h-4 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          <span>Select US State</span>
        </label>
        <select id="state-select" class="w-full bg-[#18181b] border border-white/10 rounded-lg p-2.5 text-sm text-white focus:border-amber-500 focus:outline-none cursor-pointer">
          {states.map(st => (
            <option value={st.code} selected={st.code === initialStateCode}>
              {st.name} ({st.rateCentsPerKwh}¢/kWh)
            </option>
          ))}
        </select>
      </div>

      <div>
        <label class="flex items-center gap-1.5 text-xs font-mono uppercase text-slate-400 mb-2">
          <svg class="w-4 h-4 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
          </svg>
          <span>Select Appliance</span>
        </label>
        <select id="appliance-select" class="w-full bg-[#18181b] border border-white/10 rounded-lg p-2.5 text-sm text-white focus:border-amber-500 focus:outline-none cursor-pointer">
          {appliances.map(app => (
            <option value={app.id} selected={app.id === initialApplianceId}>
              {app.icon} {app.name} ({app.typicalWatts}W)
            </option>
          ))}
        </select>
      </div>
    </div>

    <div class="lg:col-span-2 space-y-6">
      <div class="bg-black/40 p-6 rounded-xl border border-white/5 grid grid-cols-1 sm:grid-cols-2 gap-4 text-center">
        <div class="bg-[#18181b] p-5 rounded-xl border border-white/5">
          <div class="text-xs text-slate-400 font-mono uppercase flex items-center justify-center gap-1.5">
            <svg class="w-4 h-4 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span>Estimated Monthly Cost</span>
          </div>
          <div class="text-3xl font-black text-amber-400 mt-2">{initialResult.formattedMonthlyCost}</div>
          <div class="text-xs text-slate-500 mt-1">{initialResult.monthlyKwh} kWh / month</div>
        </div>

        <div class="bg-[#18181b] p-5 rounded-xl border border-white/5">
          <div class="text-xs text-slate-400 font-mono uppercase flex items-center justify-center gap-1.5">
            <svg class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
            </svg>
            <span>Estimated Annual Cost</span>
          </div>
          <div class="text-3xl font-black text-emerald-400 mt-2">{initialResult.formattedAnnualCost}</div>
          <div class="text-xs text-slate-500 mt-1">{initialResult.annualKwh} kWh / year</div>
        </div>
      </div>

      <p class="text-xs text-slate-300 leading-relaxed bg-black/20 p-4 rounded-lg border border-white/5">
        {initialResult.explanation}
      </p>
    </div>
  </div>
</div>
