---
---

<div class="w-full max-w-5xl mx-auto p-4 md:p-6 bg-[#121215] border border-white/10 rounded-2xl shadow-2xl text-slate-100 font-sans space-y-6">
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-6 border-b border-white/10">
    <div>
      <div class="flex items-center gap-2 text-amber-400 text-xs font-mono uppercase tracking-widest mb-1">
        <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
        <span>Display Geometry &amp; Aspect Optics</span>
      </div>
      <h2 class="text-2xl md:text-3xl font-black text-white tracking-tight">Aspect Ratio &amp; Screen Dimension Calculator</h2>
      <p class="text-sm text-slate-400 mt-1">Calculate physical width, height, surface area (in² / cm²), and Ultrawide aspect ratio scaling.</p>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <div class="space-y-4 bg-bg-surface p-5 rounded-xl border border-border-hairline font-mono text-xs">
      <div>
        <label class="text-text-muted uppercase tracking-wider block mb-2">Preset Aspect Ratio</label>
        <select id="ar-ratio-select" class="w-full bg-bg-canvas border border-border-hairline rounded-lg p-2.5 text-text-primary focus:border-amber-400 focus:outline-none cursor-pointer">
          <option value="16:9">16:9 Standard Widescreen (1080p, 1440p, 4K)</option>
          <option value="16:10">16:10 Productivity (MacBook, Steam Deck)</option>
          <option value="21:9">21:9 Ultrawide Cinema (3440×1440)</option>
          <option value="32:9">32:9 Super Ultrawide (5120×1440 Dual-QHD)</option>
          <option value="4:3">4:3 Legacy Standard / iPad</option>
          <option value="3:2">3:2 Microsoft Surface</option>
        </select>
      </div>

      <div>
        <label class="text-text-muted uppercase tracking-wider block mb-2">Diagonal Screen Size (Inches)</label>
        <input id="ar-diag-input" type="number" value="27" min="10" max="200" class="w-full bg-bg-canvas border border-border-hairline rounded-lg p-2.5 text-text-primary focus:border-amber-400 focus:outline-none" />
      </div>
    </div>

    <!-- Output Dimension Cards -->
    <div class="lg:col-span-2 space-y-6">
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-center font-mono">
        <div class="bg-bg-surface p-4 rounded-xl border border-border-hairline">
          <div class="text-xs text-text-muted uppercase">Physical Width</div>
          <div id="ar-width-val" class="text-2xl font-black text-amber-400 mt-1">23.53 in</div>
          <div id="ar-width-cm" class="text-xs text-text-muted mt-1">59.77 cm</div>
        </div>

        <div class="bg-bg-surface p-4 rounded-xl border border-border-hairline">
          <div class="text-xs text-text-muted uppercase">Physical Height</div>
          <div id="ar-height-val" class="text-2xl font-black text-emerald-400 mt-1">13.24 in</div>
          <div id="ar-height-cm" class="text-xs text-text-muted mt-1">33.62 cm</div>
        </div>

        <div class="bg-bg-surface p-4 rounded-xl border border-border-hairline">
          <div class="text-xs text-text-muted uppercase">Screen Surface Area</div>
          <div id="ar-area-val" class="text-2xl font-black text-cyan-400 mt-1">311.5 in²</div>
          <div id="ar-area-cm" class="text-xs text-text-muted mt-1">2,009.7 cm²</div>
        </div>
      </div>

      <!-- Canvas Visual Aspect Ratio Frame -->
      <div class="relative w-full aspect-video bg-black/60 rounded-xl border border-border-hairline p-4 flex items-center justify-center overflow-hidden">
        <div id="ar-visual-box" class="border-2 border-amber-400 bg-amber-400/10 flex items-center justify-center font-mono font-bold text-amber-400 text-sm transition-all duration-300">
          <span id="ar-visual-text">16:9 (27")</span>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  let ratioSelect = document.getElementById('ar-ratio-select') as HTMLSelectElement;
  let diagInput = document.getElementById('ar-diag-input') as HTMLInputElement;
  let widthVal = document.getElementById('ar-width-val');
  let widthCm = document.getElementById('ar-width-cm');
  let heightVal = document.getElementById('ar-height-val');
  let heightCm = document.getElementById('ar-height-cm');
  let areaVal = document.getElementById('ar-area-val');
  let areaCm = document.getElementById('ar-area-cm');
  let visualBox = document.getElementById('ar-visual-box');
  let visualText = document.getElementById('ar-visual-text');

  function calculate() {
    let ratioStr = ratioSelect ? ratioSelect.value : '16:9';
    let diag = parseFloat(diagInput ? diagInput.value : '27') || 27;

    let parts = ratioStr.split(':').map(Number);
    let rw = parts[0];
    let rh = parts[1];

    let angle = Math.atan(rh / rw);
    let widthIn = diag * Math.cos(angle);
    let heightIn = diag * Math.sin(angle);
    let areaIn = widthIn * heightIn;

    if (widthVal) widthVal.textContent = `${widthIn.toFixed(2)} in`;
    if (widthCm) widthCm.textContent = `${(widthIn * 2.54).toFixed(2)} cm`;
    if (heightVal) heightVal.textContent = `${heightIn.toFixed(2)} in`;
    if (heightCm) heightCm.textContent = `${(heightIn * 2.54).toFixed(2)} cm`;
    if (areaVal) areaVal.textContent = `${areaIn.toFixed(1)} in²`;
    if (areaCm) areaCm.textContent = `${(areaIn * 6.4516).toLocaleString('en-US', { maximumFractionDigits: 1 })} cm²`;

    if (visualBox && visualText) {
      visualText.textContent = `${ratioStr} (${diag}")`;
      let scaleFactor = Math.min(220 / heightIn, 400 / widthIn);
      visualBox.style.width = `${Math.min(480, widthIn * scaleFactor)}px`;
      visualBox.style.height = `${Math.min(240, heightIn * scaleFactor)}px`;
    }
  }

  if (ratioSelect) ratioSelect.addEventListener('change', calculate);
  if (diagInput) diagInput.addEventListener('input', calculate);
  calculate();
</script>
