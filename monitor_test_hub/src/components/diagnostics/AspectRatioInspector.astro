---
---

<div class="w-full max-w-7xl mx-auto space-y-6 font-sans select-none min-w-0" id="aspect-ratio-root">
  <div class="relative bg-[#0c0d12]/95 border border-zinc-800/90 rounded-3xl p-4 sm:p-8 backdrop-blur-2xl shadow-[0_25px_60px_rgba(0,0,0,0.8)] space-y-6 overflow-hidden min-w-0 text-zinc-100 font-mono">
    <!-- Ambient Glows -->
    <div class="absolute -top-24 -right-24 w-96 h-96 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-24 -left-24 w-96 h-96 bg-cyan-500/10 rounded-full blur-3xl pointer-events-none"></div>

    <!-- Header Controls -->
    <div class="relative z-10 flex flex-col md:flex-row items-start md:items-center justify-between gap-4 border-b border-zinc-800/70 pb-5">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-500/10 border border-amber-500/30 text-[11px] font-mono text-amber-400 font-bold uppercase tracking-wider mb-2">
          <span class="w-2 h-2 rounded-full bg-amber-400 shadow-[0_0_8px_rgba(251,191,36,0.9)] animate-pulse"></span>
          <span>DISPLAY GEOMETRY &amp; ASPECT OPTICS</span>
        </div>
        <h1 class="text-xl sm:text-3xl font-extrabold font-mono text-white tracking-tight">Aspect Ratio &amp; Screen Dimension Calculator</h1>
        <p class="text-xs sm:text-sm text-zinc-400 mt-1 font-sans font-normal">Calculate physical width, height, surface area (in² / cm²), and Ultrawide aspect ratio scaling.</p>
      </div>
    </div>

    <div class="relative z-10 grid grid-cols-1 lg:grid-cols-3 gap-6">
      <!-- Input Controls Deck -->
      <div class="space-y-5 bg-zinc-950/80 p-5 sm:p-6 rounded-2xl border border-zinc-800/80 text-xs shadow-inner">
        <div>
          <label class="text-zinc-400 font-bold uppercase block mb-2">Preset Aspect Ratio</label>
          <select id="ar-ratio-select" class="w-full bg-zinc-900 border border-zinc-700/80 rounded-xl p-3 text-xs text-white font-mono focus:border-amber-500 focus:outline-none cursor-pointer">
            <option value="16:9">16:9 Standard Widescreen (1080p, 1440p, 4K)</option>
            <option value="16:10">16:10 Productivity (MacBook, Steam Deck)</option>
            <option value="21:9">21:9 Ultrawide Cinema (3440×1440)</option>
            <option value="32:9">32:9 Super Ultrawide (5120×1440 Dual-QHD)</option>
            <option value="4:3">4:3 Legacy Standard / iPad</option>
            <option value="3:2">3:2 Microsoft Surface</option>
          </select>
        </div>

        <div>
          <label class="text-zinc-400 font-bold uppercase block mb-2">Diagonal Screen Size (Inches)</label>
          <input id="ar-diag-input" type="number" value="27" min="10" max="200" class="w-full bg-zinc-900 border border-zinc-700/80 rounded-xl p-3 text-sm text-white focus:border-amber-500 focus:outline-none" />
        </div>
      </div>

      <!-- Output Dimension Deck -->
      <div class="lg:col-span-2 space-y-5">
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-center">
          <div class="bg-zinc-950/80 p-5 rounded-2xl border border-zinc-800/80 space-y-1 shadow-inner">
            <div class="text-[11px] text-zinc-400 font-bold uppercase">Physical Width</div>
            <div id="ar-width-val" class="text-2xl sm:text-3xl font-extrabold text-amber-400 mt-1 tabular-nums">23.53 in</div>
            <div id="ar-width-cm" class="text-[11px] text-zinc-500 mt-1">59.77 cm</div>
          </div>

          <div class="bg-zinc-950/80 p-5 rounded-2xl border border-zinc-800/80 space-y-1 shadow-inner">
            <div class="text-[11px] text-zinc-400 font-bold uppercase">Physical Height</div>
            <div id="ar-height-val" class="text-2xl sm:text-3xl font-extrabold text-emerald-400 mt-1 tabular-nums">13.24 in</div>
            <div id="ar-height-cm" class="text-[11px] text-zinc-500 mt-1">33.62 cm</div>
          </div>

          <div class="bg-zinc-950/80 p-5 rounded-2xl border border-zinc-800/80 space-y-1 shadow-inner">
            <div class="text-[11px] text-zinc-400 font-bold uppercase">Total Display Area</div>
            <div id="ar-area-val" class="text-2xl sm:text-3xl font-extrabold text-cyan-400 mt-1 tabular-nums">311.5 in²</div>
            <div id="ar-area-cm" class="text-[11px] text-zinc-500 mt-1">2,010 cm²</div>
          </div>
        </div>

        <div class="bg-zinc-950/80 p-5 sm:p-6 rounded-2xl border border-zinc-800/80 space-y-2 text-xs shadow-inner">
          <div class="text-zinc-400 uppercase font-bold">Ultrawide Screen Geometry Analysis:</div>
          <p id="ar-desc" class="text-zinc-300 font-sans leading-relaxed">
            A 27-inch 16:9 display provides 311.5 square inches of active screen surface area with a physical width of 23.53 inches and height of 13.24 inches.
          </p>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const root = document.getElementById('aspect-ratio-root');
    if (!root) return;

    const ratioSelect = document.getElementById('ar-ratio-select') as HTMLSelectElement | null;
    const diagInput = document.getElementById('ar-diag-input') as HTMLInputElement | null;

    const widthVal = document.getElementById('ar-width-val');
    const widthCm = document.getElementById('ar-width-cm');
    const heightVal = document.getElementById('ar-height-val');
    const heightCm = document.getElementById('ar-height-cm');
    const areaVal = document.getElementById('ar-area-val');
    const areaCm = document.getElementById('ar-area-cm');
    const desc = document.getElementById('ar-desc');

    function updateCalculations() {
      const diag = parseFloat(diagInput?.value || '27');
      const ratioStr = ratioSelect?.value || '16:9';

      const [rw, rh] = ratioStr.split(':').map(Number);
      const ratioVal = rw / rh;

      // d = sqrt(w^2 + h^2) = sqrt((r*h)^2 + h^2) = h * sqrt(r^2 + 1)
      const heightInches = diag / Math.sqrt(ratioVal * ratioVal + 1);
      const widthInches = heightInches * ratioVal;
      const areaSqIn = widthInches * heightInches;

      const widthCmVal = widthInches * 2.54;
      const heightCmVal = heightInches * 2.54;
      const areaSqCmVal = areaSqIn * 6.4516;

      if (widthVal) widthVal.textContent = `${widthInches.toFixed(2)} in`;
      if (widthCm) widthCm.textContent = `${widthCmVal.toFixed(2)} cm`;

      if (heightVal) heightVal.textContent = `${heightInches.toFixed(2)} in`;
      if (heightCm) heightCm.textContent = `${heightCmVal.toFixed(2)} cm`;

      if (areaVal) areaVal.textContent = `${areaSqIn.toFixed(1)} in²`;
      if (areaCm) areaCm.textContent = `${Math.round(areaSqCmVal).toLocaleString()} cm²`;

      if (desc) {
        desc.textContent = `A ${diag}-inch ${ratioStr} display provides ${areaSqIn.toFixed(1)} square inches (${Math.round(areaSqCmVal).toLocaleString()} cm²) of active screen surface area with a physical width of ${widthInches.toFixed(2)} inches (${widthCmVal.toFixed(2)} cm) and height of ${heightInches.toFixed(2)} inches (${heightCmVal.toFixed(2)} cm).`;
      }
    }

    ratioSelect?.addEventListener('change', updateCalculations);
    diagInput?.addEventListener('input', updateCalculations);
    updateCalculations();
  });
</script>
