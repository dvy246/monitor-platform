---
/**
 * BacklightBleed.astro
 * Dark-room Backlight Bleed & IPS Glow Inspector component.
 */
---

<div class="w-full max-w-7xl mx-auto space-y-6 font-sans select-none min-w-0" id="backlight-bleed-root">
  <!-- Interactive Diagnostic Canvas / Controls Card -->
  <div class="relative bg-[#0c0d12]/95 border border-zinc-800/90 rounded-3xl p-4 sm:p-8 backdrop-blur-2xl shadow-[0_25px_60px_rgba(0,0,0,0.8)] space-y-6 overflow-hidden min-w-0 text-zinc-100">
    <!-- Ambient Glows -->
    <div class="absolute -top-24 -right-24 w-96 h-96 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-24 -left-24 w-96 h-96 bg-cyan-500/10 rounded-full blur-3xl pointer-events-none"></div>

    <div class="relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-zinc-800/70 pb-5">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-[11px] font-mono text-emerald-400 font-bold uppercase tracking-wider mb-2">
          <span class="w-2 h-2 rounded-full bg-emerald-400 shadow-[0_0_8px_rgba(52,211,153,0.9)] animate-pulse"></span>
          <span>IEC 62341-6-2 LUMINANCE UNIFORMITY SPEC</span>
        </div>
        <h2 class="text-xl sm:text-3xl font-extrabold font-mono text-white tracking-tight">Backlight Bleed &amp; IPS Glow Inspector</h2>
        <p class="text-xs sm:text-sm text-zinc-400 mt-1 font-sans font-normal">Dark-room luminance uniformity and light-leakage scoring under IEC 62341-6-2 standards.</p>
      </div>

      <div class="flex items-center gap-3">
        <button id="toggle-fullscreen-btn" class="px-4 py-2 min-h-[44px] sm:min-h-0 text-xs font-mono font-bold rounded-xl bg-emerald-500/20 text-emerald-400 border border-emerald-500/40 hover:bg-emerald-500/30 transition-all cursor-pointer flex items-center gap-2 shadow-lg">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8V5a2 2 0 012-2h3m11 0h3a2 2 0 012 2v3m0 11v3a2 2 0 01-2 2h-3m-11 0H5a2 2 0 01-2-2v-3"/></svg>
          <span>Fullscreen Darkroom (F)</span>
        </button>
      </div>
    </div>

    <!-- Fullscreen Black Canvas Box -->
    <div id="bleed-canvas-container" class="relative z-10 w-full h-80 sm:h-96 rounded-2xl bg-black border border-zinc-800 overflow-hidden flex items-center justify-center cursor-pointer group shadow-inner">
      <!-- Corner Indicators -->
      <div data-fullscreen-hide="true" class="absolute top-4 left-4 text-[11px] font-mono text-zinc-600 group-hover:text-emerald-400 transition-colors font-bold">TOP-LEFT CORNER</div>
      <div data-fullscreen-hide="true" class="absolute top-4 right-4 text-[11px] font-mono text-zinc-600 group-hover:text-emerald-400 transition-colors font-bold">TOP-RIGHT CORNER</div>
      <div data-fullscreen-hide="true" class="absolute bottom-4 left-4 text-[11px] font-mono text-zinc-600 group-hover:text-emerald-400 transition-colors font-bold">BOTTOM-LEFT CORNER</div>
      <div data-fullscreen-hide="true" class="absolute bottom-4 right-4 text-[11px] font-mono text-zinc-600 group-hover:text-emerald-400 transition-colors font-bold">BOTTOM-RIGHT CORNER</div>

      <div data-fullscreen-hide="true" class="text-center space-y-3 p-6 bg-zinc-950/90 backdrop-blur-md rounded-2xl border border-zinc-800/90 max-w-md shadow-2xl">
        <div class="w-10 h-10 mx-auto rounded-xl bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center text-emerald-400 mb-1">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8V5a2 2 0 012-2h3m11 0h3a2 2 0 012 2v3m0 11v3a2 2 0 01-2 2h-3m-11 0H5a2 2 0 01-2-2v-3"/></svg>
        </div>
        <div class="text-sm font-mono text-white font-extrabold tracking-wider">DARK ROOM INSPECTION MODE</div>
        <p class="text-xs text-zinc-400 font-sans leading-relaxed">Turn off room lights, click Fullscreen, and inspect screen corners for light leakage or glow shifts.</p>
      </div>
    </div>

    <!-- Dynamic Metric Telemetry Deck -->
    <div class="relative z-10 grid grid-cols-2 md:grid-cols-4 gap-4 pt-2 font-mono">
      <div class="bg-zinc-950/80 p-4 rounded-2xl border border-zinc-800/80 text-center space-y-1 shadow-inner">
        <div class="text-[10px] sm:text-xs text-zinc-400 uppercase font-bold">Center Baseline</div>
        <div id="metric-center" class="text-lg sm:text-2xl font-extrabold text-white mt-1 tabular-nums">10.0 L*</div>
      </div>
      <div class="bg-zinc-950/80 p-4 rounded-2xl border border-zinc-800/80 text-center space-y-1 shadow-inner">
        <div class="text-[10px] sm:text-xs text-zinc-400 uppercase font-bold">Max Corner Delta</div>
        <div id="metric-delta" class="text-lg sm:text-2xl font-extrabold text-emerald-400 mt-1 tabular-nums">1.2 L*</div>
      </div>
      <div class="bg-zinc-950/80 p-4 rounded-2xl border border-zinc-800/80 text-center space-y-1 shadow-inner">
        <div class="text-[10px] sm:text-xs text-zinc-400 uppercase font-bold">Variance Percent</div>
        <div id="metric-variance" class="text-lg sm:text-2xl font-extrabold text-white mt-1 tabular-nums">12.0%</div>
      </div>
      <div class="bg-zinc-950/80 p-4 rounded-2xl border border-zinc-800/80 text-center space-y-1 shadow-inner">
        <div class="text-[10px] sm:text-xs text-zinc-400 uppercase font-bold">Uniformity Status</div>
        <div id="metric-status" class="text-xs sm:text-sm font-extrabold text-emerald-400 mt-1">PASSED (IEC 62341)</div>
      </div>
    </div>
  </div>
</div>

<script>
  const container = document.getElementById('bleed-canvas-container');
  const fullscreenBtn = document.getElementById('toggle-fullscreen-btn');

  function toggleFullscreen() {
    if (!document.fullscreenElement) {
      container?.requestFullscreen().catch(() => {});
    } else {
      document.exitFullscreen().catch(() => {});
    }
  }

  fullscreenBtn?.addEventListener('click', toggleFullscreen);
  container?.addEventListener('click', toggleFullscreen);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'f' || e.key === 'F') toggleFullscreen();
  });
</script>
