---
---

<div class="w-full max-w-5xl mx-auto p-4 md:p-6 bg-[#121215] border border-white/10 rounded-2xl shadow-2xl text-slate-100 font-sans space-y-6">
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-6 border-b border-white/10">
    <div>
      <div class="flex items-center gap-2 text-status-pass text-xs font-mono uppercase tracking-widest mb-1">
        <span class="w-2 h-2 rounded-full bg-status-pass animate-pulse"></span>
        <span>Mini-LED / FALD Halo Diagnostic Engine</span>
      </div>
      <h2 class="text-2xl md:text-3xl font-black text-white tracking-tight">Blooming &amp; Local Dimming Halo Test</h2>
      <p class="text-sm text-slate-400 mt-1">Evaluate Full-Array Local Dimming (FALD) zone response, blooming light bleed, and HDR subtitle halo artifacts.</p>
    </div>
    
    <div class="flex items-center gap-2">
      <button id="blooming-fs-btn" class="px-4 py-2 bg-status-pass hover:bg-emerald-600 text-bg-canvas font-mono font-bold text-xs rounded-xl transition-all shadow-lg flex items-center gap-2">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8V5a2 2 0 012-2h3m11 0h3a2 2 0 012 2v3m0 11v3a2 2 0 01-2 2h-3m-11 0H5a2 2 0 01-2-2v-3"/></svg>
        <span>ENTER FULLSCREEN TEST</span>
      </button>
    </div>
  </div>

  <!-- Interactive Control Deck -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-4 font-mono text-xs">
    <div class="bg-bg-surface p-4 rounded-xl border border-border-hairline space-y-2">
      <label class="text-text-muted uppercase tracking-wider block">Target Shape</label>
      <select id="blooming-target-shape" class="w-full bg-bg-canvas border border-border-hairline rounded-lg p-2 text-text-primary focus:border-status-pass focus:outline-none cursor-pointer">
        <option value="square">Moving Bright Square</option>
        <option value="circle">Moving High-Nit Circle</option>
        <option value="starfield">Dynamic Starfield</option>
        <option value="subtitles">HDR Movie Subtitle Simulation</option>
      </select>
    </div>

    <div class="bg-bg-surface p-4 rounded-xl border border-border-hairline space-y-2">
      <label class="text-text-muted uppercase tracking-wider block">Peak Target Brightness</label>
      <select id="blooming-target-nit" class="w-full bg-bg-canvas border border-border-hairline rounded-lg p-2 text-text-primary focus:border-status-pass focus:outline-none cursor-pointer">
        <option value="1.0">100% (Pure White 1000+ Nits)</option>
        <option value="0.75">75% (750 Nits Peak)</option>
        <option value="0.5">50% (500 Nits SDR)</option>
        <option value="0.25">25% (250 Nits Low-Gray)</option>
      </select>
    </div>

    <div class="bg-bg-surface p-4 rounded-xl border border-border-hairline space-y-2">
      <label class="text-text-muted uppercase tracking-wider block">Animation Speed</label>
      <input id="blooming-speed-slider" type="range" min="1" max="10" value="4" class="w-full accent-status-pass cursor-pointer" />
    </div>
  </div>

  <!-- Interactive Canvas Canvas -->
  <div class="relative w-full aspect-video bg-black rounded-xl overflow-hidden border border-border-hairline shadow-2xl flex items-center justify-center" id="blooming-canvas-container">
    <canvas id="blooming-canvas" class="w-full h-full block bg-black cursor-crosshair"></canvas>
    
    <div id="blooming-overlay-hint" data-fullscreen-hide="true" class="absolute bottom-4 left-4 right-4 p-3 bg-bg-surface/80 backdrop-blur-md border border-border-hairline rounded-lg text-xs font-mono text-text-secondary flex justify-between items-center pointer-events-none">
      <span>Move cursor over canvas to drag high-luminance halo target manually</span>
      <span class="text-status-pass font-bold">[ Press F for Fullscreen ]</span>
    </div>
  </div>

  <!-- Technical Standard Guidance -->
  <div class="p-5 rounded-xl bg-bg-surface border border-border-hairline space-y-3 font-sans text-xs text-text-secondary leading-relaxed">
    <h3 class="font-mono font-bold text-text-primary uppercase text-sm">VESA DisplayHDR Local Dimming Benchmark Evaluation</h3>
    <p>
      Mini-LED displays utilize localized Full-Array Local Dimming (FALD) backlight zones (typically 512 to 5,000+ zones). When a high-luminance white element (like movie subtitles or star fields) moves across a dark pitch-black background, zone dimming algorithms must balance contrast against <strong class="text-text-primary">Blooming Light Bleed</strong>.
    </p>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 font-mono text-[11px] pt-1">
      <div class="p-3 rounded-lg bg-bg-canvas border border-border-hairline">
        <span class="font-bold text-status-pass block mb-1">OLED / QD-OLED Panels</span>
        <span class="text-text-muted">Per-pixel self-emissive dimming (8.29M zones on 4K). Zero blooming halo artifacts.</span>
      </div>
      <div class="p-3 rounded-lg bg-bg-canvas border border-border-hairline">
        <span class="font-bold text-amber-400 block mb-1">Mini-LED / FALD LCD Panels</span>
        <span class="text-text-muted">Dependent on zone density &amp; algorithm response latency. Halo visibility increases at off-axis viewing angles.</span>
      </div>
    </div>
  </div>
</div>

<script>
  let canvas = document.getElementById('blooming-canvas') as HTMLCanvasElement;
  let ctx = canvas?.getContext('2d');
  let shapeSelect = document.getElementById('blooming-target-shape') as HTMLSelectElement;
  let nitSelect = document.getElementById('blooming-target-nit') as HTMLSelectElement;
  let speedSlider = document.getElementById('blooming-speed-slider') as HTMLInputElement;
  let fsBtn = document.getElementById('blooming-fs-btn');
  let container = document.getElementById('blooming-canvas-container');

  let posX = 100;
  let posY = 100;
  let dirX = 3;
  let dirY = 2;
  let isManualMode = false;

  function resizeCanvas() {
    if (!canvas || !container) return;
    canvas.width = container.clientWidth;
    canvas.height = container.clientHeight;
  }

  window.addEventListener('resize', resizeCanvas);
  resizeCanvas();

  if (container) {
    container.addEventListener('mousemove', (e) => {
      let rect = canvas.getBoundingClientRect();
      posX = e.clientX - rect.left;
      posY = e.clientY - rect.top;
      isManualMode = true;
    });

    container.addEventListener('mouseleave', () => {
      isManualMode = false;
    });
  }

  function render() {
    if (!ctx || !canvas) return;
    ctx.fillStyle = '#000000';
    ctx.fillRect(0, 0, canvas.width, canvas.height);

    let speed = parseFloat(speedSlider ? speedSlider.value : '4');
    let alpha = parseFloat(nitSelect ? nitSelect.value : '1.0');
    let shape = shapeSelect ? shapeSelect.value : 'square';

    if (!isManualMode) {
      posX += dirX * (speed / 2);
      posY += dirY * (speed / 2);

      if (posX < 50 || posX > canvas.width - 50) dirX *= -1;
      if (posY < 50 || posY > canvas.height - 50) dirY *= -1;
    }

    ctx.save();
    ctx.fillStyle = `rgba(255, 255, 255, ${alpha})`;
    ctx.shadowColor = `rgba(255, 255, 255, ${alpha * 0.8})`;
    ctx.shadowBlur = 0;

    if (shape === 'square') {
      ctx.fillRect(posX - 40, posY - 40, 80, 80);
    } else if (shape === 'circle') {
      ctx.beginPath();
      ctx.arc(posX, posY, 45, 0, Math.PI * 2);
      ctx.fill();
    } else if (shape === 'starfield') {
      // Multiple high-intensity dots
      ctx.fillRect(posX - 80, posY - 50, 4, 4);
      ctx.fillRect(posX + 60, posY + 40, 6, 6);
      ctx.fillRect(posX, posY, 12, 12);
      ctx.fillRect(posX - 30, posY + 70, 5, 5);
    } else if (shape === 'subtitles') {
      ctx.font = 'bold 22px monospace';
      ctx.textAlign = 'center';
      ctx.fillText('[ Subtitle Blooming Test Line: 1000 Nits ]', canvas.width / 2, canvas.height - 60);
    }

    ctx.restore();
    requestAnimationFrame(render);
  }

  requestAnimationFrame(render);

  if (fsBtn && container) {
    fsBtn.addEventListener('click', () => {
      if (document.fullscreenElement) {
        document.exitFullscreen();
      } else {
        container?.requestFullscreen();
      }
    });
  }

  document.addEventListener('fullscreenchange', () => {
    setTimeout(resizeCanvas, 50);
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'f' || e.key === 'F') {
      if (document.fullscreenElement) {
        document.exitFullscreen();
      } else {
        container?.requestFullscreen();
      }
    }
  });
</script>
