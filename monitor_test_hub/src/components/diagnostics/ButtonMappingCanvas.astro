---
/**
 * ButtonMappingCanvas.astro
 * Gamepad W3C Button Mapping & Remap Inspector.
 * Features:
 * - Logical Index vs Physical Button Map.
 * - Live Input Capture & Remap Verification.
 */
---

<div class="w-full max-w-5xl mx-auto space-y-6 font-sans select-none min-w-0" id="remap-test-root">
  <div class="relative bg-[#0c0d12]/90 border border-zinc-800/90 rounded-2xl p-4 sm:p-6 backdrop-blur-2xl shadow-[0_25px_60px_rgba(0,0,0,0.8)] space-y-6 overflow-hidden">
    <div class="relative z-10 flex items-center justify-between border-b border-zinc-800/70 pb-5">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/30 text-[11px] font-mono text-cyan-400 font-bold uppercase tracking-wider mb-2">
          <span>W3C GAMEPAD STANDARD MAPPING</span>
        </div>
        <h2 class="text-xl sm:text-2xl font-bold font-mono text-white">Button Mapping &amp; Remap Test</h2>
      </div>
    </div>

    <!-- Mapping Table -->
    <div class="relative z-10 bg-zinc-950 rounded-2xl border border-zinc-800 p-4 font-mono text-xs overflow-x-auto">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="border-b border-zinc-800 text-zinc-400">
            <th class="p-2">Logical Index</th>
            <th class="p-2">Standard Name</th>
            <th class="p-2">Xbox Mapping</th>
            <th class="p-2">PlayStation Mapping</th>
            <th class="p-2">State</th>
          </tr>
        </thead>
        <tbody id="remap-table-body" class="divide-y divide-zinc-900 text-zinc-300">
          <!-- Rows generated by JS script -->
        </tbody>
      </table>
    </div>
  </div>
</div>

<script>
  const STANDARD_MAP = [
    { index: 0, name: 'Button 0', xbox: 'A', ps: 'Cross (✕)' },
    { index: 1, name: 'Button 1', xbox: 'B', ps: 'Circle (◯)' },
    { index: 2, name: 'Button 2', xbox: 'X', ps: 'Square (☐)' },
    { index: 3, name: 'Button 3', xbox: 'Y', ps: 'Triangle (△)' },
    { index: 4, name: 'Button 4', xbox: 'LB', ps: 'L1' },
    { index: 5, name: 'Button 5', xbox: 'RB', ps: 'R1' },
    { index: 6, name: 'Button 6', xbox: 'LT (Analog)', ps: 'L2 (Analog)' },
    { index: 7, name: 'Button 7', xbox: 'RT (Analog)', ps: 'R2 (Analog)' },
    { index: 8, name: 'Button 8', xbox: 'View / Back', ps: 'Share / Create' },
    { index: 9, name: 'Button 9', xbox: 'Menu / Start', ps: 'Options' },
    { index: 10, name: 'Button 10', xbox: 'L3 (Left Stick)', ps: 'L3' },
    { index: 11, name: 'Button 11', xbox: 'R3 (Right Stick)', ps: 'R3' },
    { index: 12, name: 'Button 12', xbox: 'D-Pad Up', ps: 'D-Pad Up' },
    { index: 13, name: 'Button 13', xbox: 'D-Pad Down', ps: 'D-Pad Down' },
    { index: 14, name: 'Button 14', xbox: 'D-Pad Left', ps: 'D-Pad Left' },
    { index: 15, name: 'Button 15', xbox: 'D-Pad Right', ps: 'D-Pad Right' },
    { index: 16, name: 'Button 16', xbox: 'Xbox Guide', ps: 'PS Button' }
  ];

  const tbody = document.getElementById('remap-table-body');

  function renderTable() {
    if (!tbody) return;
    tbody.innerHTML = STANDARD_MAP.map(item => `
      <tr id="remap-row-${item.index}" class="hover:bg-zinc-900/50">
        <td class="p-2 font-bold text-cyan-400">Index ${item.index}</td>
        <td class="p-2">${item.name}</td>
        <td class="p-2 text-emerald-400 font-bold">${item.xbox}</td>
        <td class="p-2 text-purple-400 font-bold">${item.ps}</td>
        <td id="remap-state-${item.index}" class="p-2 text-zinc-500">Released</td>
      </tr>
    `).join('');
  }

  function loop() {
    const gamepads = navigator.getGamepads ? navigator.getGamepads() : [];
    let gp: Gamepad | null = null;
    for (let i = 0; i < gamepads.length; i++) {
      if (gamepads[i]) { gp = gamepads[i]; break; }
    }

    STANDARD_MAP.forEach(item => {
      const stateEl = document.getElementById(`remap-state-${item.index}`);
      const rowEl = document.getElementById(`remap-row-${item.index}`);
      if (gp && gp.buttons[item.index]) {
        const btn = gp.buttons[item.index];
        if (btn.pressed) {
          if (stateEl) stateEl.textContent = `Pressed (${Math.round(btn.value * 100)}%)`;
          if (rowEl) rowEl.className = 'bg-cyan-500/20 text-white font-bold';
        } else {
          if (stateEl) stateEl.textContent = 'Released';
          if (rowEl) rowEl.className = 'hover:bg-zinc-900/50 text-zinc-300';
        }
      }
    });

    requestAnimationFrame(loop);
  }

  renderTable();
  requestAnimationFrame(loop);
</script>
