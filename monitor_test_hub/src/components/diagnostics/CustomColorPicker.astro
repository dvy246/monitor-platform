---
/**
 * CustomColorPicker.astro
 * Native HTML color input, Hex text field, RGB readout, copy button,
 * reset button, and Fullscreen CTA.
 */
interface Props {
  initialColor?: string;
  class?: string;
}

const { 
  initialColor = '#FF6B00',
  class: className = '' 
} = Astro.props;
---

<div class:list={["bg-[#0d0d12]/90 border border-white/10 rounded-3xl p-5 sm:p-6 space-y-4 shadow-[0_20px_50px_rgba(0,0,0,0.5)] backdrop-blur-2xl font-sans select-none hover:border-white/20 transition-all duration-300 relative overflow-hidden group", className]}>
  <!-- Ambient Rose Glow -->
  <div class="absolute -top-12 -left-12 w-32 h-32 bg-rose-500/10 rounded-full blur-2xl pointer-events-none group-hover:bg-rose-500/20 transition-all duration-500"></div>

  <!-- Header -->
  <div class="flex items-center justify-between border-b border-white/10 pb-3.5 relative z-10">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 rounded-2xl bg-rose-500/15 border border-rose-500/30 flex items-center justify-center text-rose-400 shadow-[inset_0_1px_1px_rgba(255,255,255,0.2)] shrink-0">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="12" cy="12" r="10"/>
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v8m-4-4h8"/>
        </svg>
      </div>
      <div>
        <h3 class="text-base font-bold text-white tracking-tight">Custom Color</h3>
        <p class="text-[11px] text-zinc-400 font-mono">HEX / RGB Engine</p>
      </div>
    </div>
    <span class="text-[11px] font-mono text-zinc-400 bg-white/[0.05] px-2.5 py-1 rounded-full border border-white/10">Real-Time Sync</span>
  </div>

  <div class="space-y-4 relative z-10">
    <!-- Hex & Native Color Picker Row -->
    <div class="flex items-center gap-3">
      <div 
        id="custom-picker-swatch-box"
        class="w-12 h-12 rounded-2xl border border-white/30 shadow-lg shrink-0 transition-colors duration-200 relative overflow-hidden group/swatch cursor-pointer"
        style={`background-color: ${initialColor};`}
        title="Click to trigger color selection"
      >
        <div class="absolute inset-0 flex items-center justify-center bg-black/20 opacity-0 group-hover/swatch:opacity-100 transition-opacity">
          <svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/>
          </svg>
        </div>
      </div>

      <div class="relative flex-1">
        <input 
          id="custom-hex-field"
          type="text" 
          value={initialColor}
          placeholder="#FFFFFF"
          maxlength="7"
          class="w-full bg-[#17171f] border border-white/15 rounded-2xl pl-4 pr-12 py-3 font-mono text-sm text-white focus:border-rose-500 focus:ring-2 focus:ring-rose-500/20 focus:outline-none uppercase tracking-widest transition-all"
        />
        <input 
          id="custom-native-picker-input"
          type="color" 
          value={initialColor}
          class="absolute right-3 top-1/2 -translate-y-1/2 w-7 h-7 rounded-xl border-0 bg-transparent cursor-pointer opacity-90 hover:opacity-100 transition-opacity duration-200"
          title="Open Native System Color Picker"
        />
      </div>
    </div>

    <!-- RGB Readout & Action Buttons -->
    <div class="flex items-center justify-between text-xs font-mono text-zinc-300 bg-[#14141a] p-3 rounded-2xl border border-white/[0.08]">
      <div class="flex items-center gap-2">
        <svg class="w-4 h-4 text-rose-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
        </svg>
        <span id="custom-rgb-readout" class="font-bold text-white tracking-wide">RGB(255, 107, 0)</span>
      </div>
      <div class="flex items-center gap-2">
        <button
          id="custom-copy-btn"
          type="button"
          class="px-3 py-1.5 rounded-xl bg-white/10 hover:bg-white/20 text-white font-bold transition-all active:scale-95 cursor-pointer flex items-center gap-1.5"
        >
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
          </svg>
          <span id="custom-copy-label">Copy</span>
        </button>
        <button
          id="custom-reset-btn"
          type="button"
          class="px-3 py-1.5 rounded-xl bg-white/5 hover:bg-white/10 text-zinc-400 hover:text-white font-bold transition-all active:scale-95 cursor-pointer"
        >
          Reset
        </button>
      </div>
    </div>

    <!-- Dynamic Color Bar Preview -->
    <div 
      id="custom-color-bar"
      class="w-full h-8 rounded-2xl shadow-inner transition-colors duration-200 border border-white/10 flex items-center justify-center text-[11px] font-mono font-bold"
      style={`background-color: ${initialColor};`}
    >
    </div>

    <!-- Fullscreen CTA Button -->
    <button
      id="custom-btn-fullscreen"
      type="button"
      class="w-full py-3.5 px-4 rounded-2xl bg-white text-black font-extrabold text-xs sm:text-sm font-sans hover:bg-zinc-200 active:scale-[0.98] transition-all shadow-[0_10px_25px_rgba(255,255,255,0.15)] flex items-center justify-center gap-2.5 cursor-pointer"
    >
      <svg class="w-4 h-4 text-black" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3 8V5a2 2 0 012-2h3m11 0h3a2 2 0 012 2v3m0 11v3a2 2 0 01-2 2h-3m-11 0H5a2 2 0 01-2-2v-3"/>
      </svg>
      <span>Fullscreen Test This Color</span>
    </button>
  </div>
</div>

<script>
  function initCustomColorPicker() {
    const swatchBox = document.getElementById('custom-picker-swatch-box') as HTMLDivElement;
    const hexInput = document.getElementById('custom-hex-field') as HTMLInputElement;
    const nativePicker = document.getElementById('custom-native-picker-input') as HTMLInputElement;
    const rgbReadout = document.getElementById('custom-rgb-readout') as HTMLSpanElement;
    const colorBar = document.getElementById('custom-color-bar') as HTMLDivElement;
    const copyBtn = document.getElementById('custom-copy-btn') as HTMLButtonElement;
    const copyLabel = document.getElementById('custom-copy-label') as HTMLSpanElement;
    const resetBtn = document.getElementById('custom-reset-btn') as HTMLButtonElement;
    const btnFS = document.getElementById('custom-btn-fullscreen') as HTMLButtonElement;

    function hexToRgb(hex: string) {
      let c = hex.replace('#', '');
      if (c.length === 3) c = c.split('').map(x => x + x).join('');
      const num = parseInt(c, 16);
      return { r: (num >> 16) & 255, g: (num >> 8) & 255, b: num & 255 };
    }

    function updateColor(hex: string, source: 'picker' | 'input' | 'external' = 'external') {
      const cleanHex = hex.toUpperCase();
      if (swatchBox) swatchBox.style.backgroundColor = cleanHex;
      if (colorBar) colorBar.style.backgroundColor = cleanHex;
      if (hexInput && source !== 'input') hexInput.value = cleanHex;
      if (nativePicker && source !== 'picker') nativePicker.value = cleanHex;

      try {
        const rgb = hexToRgb(cleanHex);
        if (rgbReadout) rgbReadout.textContent = `RGB(${rgb.r}, ${rgb.g}, ${rgb.b})`;
      } catch (e) {}

      if (source !== 'external') {
        window.dispatchEvent(new CustomEvent('dt-color-change', { detail: { hex: cleanHex, name: 'Custom Color' } }));
      }
    }

    // Initialize RGB readout
    if (hexInput?.value) {
      try {
        const rgb = hexToRgb(hexInput.value);
        if (rgbReadout) rgbReadout.textContent = `RGB(${rgb.r}, ${rgb.g}, ${rgb.b})`;
      } catch (e) {}
    }

    swatchBox?.addEventListener('click', () => {
      nativePicker?.click();
    });

    nativePicker?.addEventListener('input', (e) => {
      updateColor((e.target as HTMLInputElement).value, 'picker');
    });

    hexInput?.addEventListener('input', (e) => {
      let val = (e.target as HTMLInputElement).value.trim();
      if (!val.startsWith('#')) val = '#' + val;
      if (/^#[0-9A-FA-F]{6}$/.test(val)) {
        updateColor(val, 'input');
      }
    });

    copyBtn?.addEventListener('click', () => {
      const hex = hexInput?.value || '#FFFFFF';
      navigator.clipboard.writeText(hex).then(() => {
        if (copyLabel) copyLabel.textContent = 'Copied!';
        setTimeout(() => { if (copyLabel) copyLabel.textContent = 'Copy'; }, 1500);
      });
    });

    resetBtn?.addEventListener('click', () => {
      updateColor('#FFFFFF', 'picker');
    });

    btnFS?.addEventListener('click', () => {
      const target = document.querySelector('[data-fullscreen-target="true"]') || document.documentElement;
      if (!document.fullscreenElement) {
        target.requestFullscreen().catch(() => {});
      }
    });

    window.addEventListener('dt-color-change', (e: Event) => {
      const detail = (e as CustomEvent).detail;
      if (detail && detail.hex) {
        updateColor(detail.hex, 'external');
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCustomColorPicker);
  } else {
    initCustomColorPicker();
  }
</script>
