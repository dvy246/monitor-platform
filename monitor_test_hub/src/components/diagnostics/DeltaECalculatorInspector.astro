---
import ErgonomicsNotice from '../disclaimers/ErgonomicsNotice.astro';
import HardwareLimitationNotice from '../disclaimers/HardwareLimitationNotice.astro';
import { MACBETH_COLORCHECKER_24 } from '../../engine/DeltaE2000Engine';
---

<div class="w-full max-w-7xl mx-auto space-y-6 font-sans select-none min-w-0" id="delta-e-calculator-root">
  <div class="relative bg-[#0c0d12]/95 border border-zinc-800/90 rounded-3xl p-4 sm:p-8 backdrop-blur-2xl shadow-[0_25px_60px_rgba(0,0,0,0.8)] space-y-6 overflow-hidden min-w-0 text-zinc-100 font-mono">
    <!-- Ambient Glows -->
    <div class="absolute -top-24 -right-24 w-96 h-96 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-24 -left-24 w-96 h-96 bg-cyan-500/10 rounded-full blur-3xl pointer-events-none"></div>

    <!-- Header Deck -->
    <div class="relative z-10 flex flex-col md:flex-row items-start md:items-center justify-between gap-4 border-b border-zinc-800/70 pb-5">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-[11px] font-mono text-emerald-400 font-bold uppercase tracking-wider mb-2">
          <span class="w-2 h-2 rounded-full bg-emerald-400 shadow-[0_0_8px_rgba(52,211,153,0.9)] animate-pulse"></span>
          <span>ISO 9241-307 &amp; CIEDE2000 COLORIMETRY ENGINE</span>
        </div>
        <h2 class="text-xl sm:text-3xl font-extrabold font-mono text-white tracking-tight">CIEDE2000 Display Calibration Color Accuracy Tool</h2>
        <p class="text-xs sm:text-sm text-zinc-400 mt-1 font-sans font-normal">Perceptual color difference calculator with 24-patch Macbeth reference target presets.</p>
      </div>
      <div id="de-grade-badge" class="px-3.5 py-2 rounded-xl bg-emerald-500/20 border border-emerald-500/40 text-emerald-400 text-xs font-mono font-bold shadow-lg">
        MASTERING REFERENCE (&Delta;E00 &lt; 1.0)
      </div>
    </div>

    <!-- Main 12-col Grid -->
    <div class="relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-6 min-w-0">
      <!-- Controls (5 cols) -->
      <div class="lg:col-span-5 bg-zinc-950/80 p-5 sm:p-6 rounded-2xl border border-zinc-800/80 space-y-5 text-xs shadow-inner min-w-0">
        <h3 class="text-xs font-mono font-bold text-zinc-300 uppercase tracking-wider border-b border-zinc-800/80 pb-2.5 flex items-center gap-2">
          <span>🎨 TARGET vs MEASURED COLOR INPUTS</span>
        </h3>

        <!-- Target Color Input -->
        <div class="space-y-2 bg-zinc-900/90 p-4 rounded-xl border border-zinc-800 min-w-0">
          <div class="flex justify-between items-center text-zinc-400 font-bold uppercase text-[11px]">
            <span>Target Reference Color:</span>
            <span id="target-hex-display" class="text-emerald-400 font-mono">#735244</span>
          </div>
          <div class="flex items-center gap-3 min-w-0">
            <input type="color" id="target-color-picker" value="#735244" class="w-10 h-10 rounded-xl cursor-pointer bg-transparent border border-zinc-700/80 p-1 shrink-0">
            <input type="text" id="target-hex-input" value="#735244" maxlength="7" class="w-full bg-zinc-950 border border-zinc-700/80 rounded-xl p-2.5 text-white uppercase font-mono text-xs focus:border-emerald-500 focus:outline-none">
          </div>
        </div>

        <!-- Measured Color Input -->
        <div class="space-y-2 bg-zinc-900/90 p-4 rounded-xl border border-zinc-800 min-w-0">
          <div class="flex justify-between items-center text-zinc-400 font-bold uppercase text-[11px]">
            <span>Measured Colorimeter Output:</span>
            <span id="measured-hex-display" class="text-amber-400 font-mono">#7A584A</span>
          </div>
          <div class="flex items-center gap-3 min-w-0">
            <input type="color" id="measured-color-picker" value="#7A584A" class="w-10 h-10 rounded-xl cursor-pointer bg-transparent border border-zinc-700/80 p-1 shrink-0">
            <input type="text" id="measured-hex-input" value="#7A584A" maxlength="7" class="w-full bg-zinc-950 border border-zinc-700/80 rounded-xl p-2.5 text-white uppercase font-mono text-xs focus:border-amber-400 focus:outline-none">
          </div>
        </div>

        <!-- Macbeth ColorChecker 24 Grid -->
        <div class="space-y-2.5 pt-2 border-t border-zinc-800">
          <div class="flex justify-between items-center">
            <span class="text-zinc-400 font-bold uppercase text-[11px]">24-Patch Macbeth ColorChecker Reference Presets</span>
          </div>
          <div class="grid grid-cols-6 gap-2 bg-zinc-900/90 p-3 rounded-xl border border-zinc-800">
            {MACBETH_COLORCHECKER_24.map((patch) => (
              <button
                type="button"
                data-hex={patch.hex}
                data-name={patch.name}
                class="btn-macbeth-patch w-full h-11 rounded-lg border border-white/20 transition-all hover:scale-105 hover:border-emerald-400 focus:outline-none focus:ring-2 focus:ring-emerald-500/50 min-h-[44px] cursor-pointer relative"
                style={`background-color: ${patch.hex};`}
              >
                <span class="sr-only">{patch.name}</span>
              </button>
            ))}
          </div>
          <p class="text-[11px] text-zinc-500 font-sans text-center">
            Click any Macbeth patch to set Target reference color.
          </p>
        </div>
      </div>

      <!-- Telemetry Output (7 cols) -->
      <div class="lg:col-span-7 bg-zinc-950/80 p-5 sm:p-6 rounded-2xl border border-zinc-800/80 space-y-6 shadow-inner min-w-0">
        <h3 class="text-xs font-mono font-bold text-zinc-300 uppercase tracking-wider border-b border-zinc-800/80 pb-2.5 flex flex-wrap items-center justify-between gap-2">
          <span>📊 PERCEPTUAL DELTA E TELEMETRY</span>
          <span id="iso-pass-badge" class="text-xs font-mono font-bold text-emerald-400 uppercase">ISO 9241-307: PASS</span>
        </h3>

        <!-- Key Stat Cards -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <!-- CIEDE2000 -->
          <div class="bg-zinc-900/90 p-4 rounded-xl border border-zinc-800 space-y-1 min-w-0 overflow-hidden">
            <div class="text-[11px] text-zinc-400 font-bold uppercase truncate">CIEDE2000 (&Delta;E00)</div>
            <div id="stat-delta-e00" class="text-xl sm:text-2xl font-extrabold text-emerald-400 tracking-tight tabular-nums truncate">0.82</div>
            <div class="text-[10px] text-zinc-400 font-sans truncate">Primary W3C Metric</div>
          </div>

          <!-- CIE94 -->
          <div class="bg-zinc-900/90 p-4 rounded-xl border border-zinc-800 space-y-1 min-w-0 overflow-hidden">
            <div class="text-[11px] text-zinc-400 font-bold uppercase truncate">CIE94 (&Delta;E94)</div>
            <div id="stat-delta-e94" class="text-xl sm:text-2xl font-extrabold text-cyan-400 tracking-tight tabular-nums truncate">0.91</div>
            <div class="text-[10px] text-zinc-400 font-sans truncate">Graphic Arts Std</div>
          </div>

          <!-- CIE76 -->
          <div class="bg-zinc-900/90 p-4 rounded-xl border border-zinc-800 space-y-1 min-w-0 overflow-hidden">
            <div class="text-[11px] text-zinc-400 font-bold uppercase truncate">CIE76 (&Delta;E76)</div>
            <div id="stat-delta-e76" class="text-xl sm:text-2xl font-extrabold text-amber-400 tracking-tight tabular-nums truncate">1.45</div>
            <div class="text-[10px] text-zinc-400 font-sans truncate">Euclidean L*a*b*</div>
          </div>
        </div>

        <!-- Side-by-side Split Patch Renderer Canvas -->
        <div class="space-y-2 min-w-0">
          <div class="text-xs font-bold text-zinc-400 uppercase tracking-wider flex justify-between items-center">
            <span>Side-by-Side Visual Split Patch Renderer</span>
            <span class="text-zinc-500 font-normal text-[11px] hidden sm:inline">Direct Visual Comparison</span>
          </div>
          <div class="w-full h-32 rounded-2xl border border-zinc-800 overflow-hidden grid grid-cols-2 shadow-inner">
            <div id="split-patch-target" class="h-full flex items-end p-3 bg-[#735244] transition-colors">
              <span class="bg-black/70 backdrop-blur-md px-2.5 py-1 rounded-lg text-[10px] font-bold text-white uppercase border border-white/10 shadow">Target Reference</span>
            </div>
            <div id="split-patch-measured" class="h-full flex items-end p-3 bg-[#7a584a] transition-colors">
              <span class="bg-black/70 backdrop-blur-md px-2.5 py-1 rounded-lg text-[10px] font-bold text-white uppercase border border-white/10 shadow">Measured Output</span>
            </div>
          </div>
        </div>

        <!-- Detailed Error Component Breakdown (dL, dC, dH) -->
        <div class="bg-zinc-900/90 p-4 sm:p-5 rounded-xl border border-zinc-800 space-y-4 min-w-0">
          <div class="text-xs font-bold text-zinc-300 uppercase tracking-wider border-b border-zinc-800 pb-2">
            Color Error Vector Breakdown (&Delta;L, &Delta;C, &Delta;H)
          </div>
          
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs font-mono">
            <!-- Lightness Error -->
            <div class="bg-zinc-950 p-3 rounded-xl border border-zinc-800 space-y-1 min-w-0 overflow-hidden">
              <div class="text-[10px] text-zinc-400 font-bold uppercase truncate">&Delta;L (Lightness)</div>
              <div id="val-delta-l" class="text-base font-extrabold text-white tabular-nums truncate">+0.35</div>
              <div id="desc-delta-l" class="text-[10px] text-zinc-400 font-sans truncate">Slightly Brighter</div>
            </div>

            <!-- Chroma Error -->
            <div class="bg-zinc-950 p-3 rounded-xl border border-zinc-800 space-y-1 min-w-0 overflow-hidden">
              <div class="text-[10px] text-zinc-400 font-bold uppercase truncate">&Delta;C (Chroma)</div>
              <div id="val-delta-c" class="text-base font-extrabold text-white tabular-nums truncate">+0.42</div>
              <div id="desc-delta-c" class="text-[10px] text-zinc-400 font-sans truncate">More Saturated</div>
            </div>

            <!-- Hue Error -->
            <div class="bg-zinc-950 p-3 rounded-xl border border-zinc-800 space-y-1 min-w-0 overflow-hidden">
              <div class="text-[10px] text-zinc-400 font-bold uppercase truncate">&Delta;H (Hue Shift)</div>
              <div id="val-delta-h" class="text-base font-extrabold text-white tabular-nums truncate">-0.12</div>
              <div id="desc-delta-h" class="text-[10px] text-zinc-400 font-sans truncate">Negligible Shift</div>
            </div>
          </div>

          <div class="p-3.5 bg-zinc-950 rounded-xl border border-zinc-800 text-xs space-y-1 font-mono">
            <div class="font-bold text-amber-400 uppercase text-[10px]">ISO 9241-307 Rating Description:</div>
            <p id="de-rating-desc" class="text-zinc-300 font-sans text-[11px] leading-relaxed">
              Mastering Reference Grade (Delta E &lt; 1.0). Imperceptible error to trained colorists.
            </p>
          </div>
        </div>
      </div>
    </div>

    <HardwareLimitationNotice />
    <ErgonomicsNotice />
  </div>
</div>

<script>
  import { calculateDeltaE2000, hexToRgb, rgbToLab } from '../../engine/DeltaE2000Engine';

  function initDeltaEInspector() {
    const targetPicker = document.getElementById('target-color-picker') as HTMLInputElement;
    const targetHexInput = document.getElementById('target-hex-input') as HTMLInputElement;
    const targetHexDisplay = document.getElementById('target-hex-display');

    const measuredPicker = document.getElementById('measured-color-picker') as HTMLInputElement;
    const measuredHexInput = document.getElementById('measured-hex-input') as HTMLInputElement;
    const measuredHexDisplay = document.getElementById('measured-hex-display');

    const statE00 = document.getElementById('stat-delta-e00');
    const statE94 = document.getElementById('stat-delta-e94');
    const statE76 = document.getElementById('stat-delta-e76');

    const valL = document.getElementById('val-delta-l');
    const descL = document.getElementById('desc-delta-l');
    const valC = document.getElementById('val-delta-c');
    const descC = document.getElementById('desc-delta-c');
    const valH = document.getElementById('val-delta-h');
    const descH = document.getElementById('desc-delta-h');

    const deGradeBadge = document.getElementById('de-grade-badge');
    const isoPassBadge = document.getElementById('iso-pass-badge');
    const deRatingDesc = document.getElementById('de-rating-desc');

    const splitTarget = document.getElementById('split-patch-target');
    const splitMeasured = document.getElementById('split-patch-measured');

    if (!targetHexInput || !measuredHexInput) return;

    function update() {
      const targetHex = targetHexInput.value.startsWith('#') ? targetHexInput.value : `#${targetHexInput.value}`;
      const measuredHex = measuredHexInput.value.startsWith('#') ? measuredHexInput.value : `#${measuredHexInput.value}`;

      if (targetHexDisplay) targetHexDisplay.textContent = targetHex.toUpperCase();
      if (measuredHexDisplay) measuredHexDisplay.textContent = measuredHex.toUpperCase();

      if (splitTarget) splitTarget.style.backgroundColor = targetHex;
      if (splitMeasured) splitMeasured.style.backgroundColor = measuredHex;

      const targetRgb = hexToRgb(targetHex);
      const measuredRgb = hexToRgb(measuredHex);

      const targetLab = rgbToLab(targetRgb.r, targetRgb.g, targetRgb.b);
      const measuredLab = rgbToLab(measuredRgb.r, measuredRgb.g, measuredRgb.b);

      const report = calculateDeltaE2000(targetLab, measuredLab);

      if (statE00) statE00.textContent = report.deltaE2000.toFixed(2);
      if (statE94) statE94.textContent = report.deltaE94.toFixed(2);
      if (statE76) statE76.textContent = report.deltaE76.toFixed(2);

      const dL = measuredLab.L - targetLab.L;
      const targetC = Math.sqrt(targetLab.a * targetLab.a + targetLab.b * targetLab.b);
      const measuredC = Math.sqrt(measuredLab.a * measuredLab.a + measuredLab.b * measuredLab.b);
      const dC = measuredC - targetC;
      const dH = Math.sqrt(Math.max(0, report.deltaE76 * report.deltaE76 - dL * dL - dC * dC));

      if (valL) valL.textContent = `${dL >= 0 ? '+' : ''}${dL.toFixed(2)}`;
      if (descL) descL.textContent = Math.abs(dL) < 0.5 ? 'Matched Lightness' : dL > 0 ? 'Brighter Output' : 'Darker Output';

      if (valC) valC.textContent = `${dC >= 0 ? '+' : ''}${dC.toFixed(2)}`;
      if (descC) descC.textContent = Math.abs(dC) < 0.5 ? 'Matched Saturation' : dC > 0 ? 'More Saturated' : 'Less Saturated';

      if (valH) valH.textContent = `${dH.toFixed(2)}`;
      if (descH) descH.textContent = dH < 0.5 ? 'Matched Hue' : 'Noticeable Hue Shift';

      if (deGradeBadge) {
        if (report.deltaE2000 < 1.0) {
          deGradeBadge.textContent = 'MASTERING REFERENCE (ΔE00 < 1.0)';
          deGradeBadge.className = 'px-3.5 py-2 rounded-xl bg-emerald-500/20 border border-emerald-500/40 text-emerald-400 text-xs font-mono font-bold shadow-lg';
        } else if (report.deltaE2000 < 2.0) {
          deGradeBadge.textContent = 'PROFESSIONAL GRADE (ΔE00 < 2.0)';
          deGradeBadge.className = 'px-3.5 py-2 rounded-xl bg-cyan-500/20 border border-cyan-500/40 text-cyan-400 text-xs font-mono font-bold shadow-lg';
        } else if (report.deltaE2000 < 4.0) {
          deGradeBadge.textContent = 'CONSUMER GRADE (ΔE00 < 4.0)';
          deGradeBadge.className = 'px-3.5 py-2 rounded-xl bg-amber-500/20 border border-amber-500/40 text-amber-400 text-xs font-mono font-bold shadow-lg';
        } else {
          deGradeBadge.textContent = 'UNCALIBRATED (ΔE00 ≥ 4.0)';
          deGradeBadge.className = 'px-3.5 py-2 rounded-xl bg-rose-500/20 border border-rose-500/40 text-rose-400 text-xs font-mono font-bold shadow-lg';
        }
      }

      if (isoPassBadge) {
        isoPassBadge.textContent = `ISO 9241-307: ${report.isImperceptible ? 'PASS' : 'FAIL'}`;
        isoPassBadge.className = `text-xs font-mono font-bold uppercase ${report.isImperceptible ? 'text-emerald-400' : 'text-amber-400'}`;
      }

      if (deRatingDesc) {
        deRatingDesc.textContent = report.perceptualInterpretation;
      }
    }

    targetPicker?.addEventListener('input', (e) => {
      targetHexInput.value = (e.target as HTMLInputElement).value;
      update();
    });
    targetHexInput?.addEventListener('input', () => {
      if (targetHexInput.value.length === 7) {
        targetPicker.value = targetHexInput.value;
      }
      update();
    });

    measuredPicker?.addEventListener('input', (e) => {
      measuredHexInput.value = (e.target as HTMLInputElement).value;
      update();
    });
    measuredHexInput?.addEventListener('input', () => {
      if (measuredHexInput.value.length === 7) {
        measuredPicker.value = measuredHexInput.value;
      }
      update();
    });

    document.querySelectorAll('.btn-macbeth-patch').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const hex = (e.currentTarget as HTMLButtonElement).dataset.hex;
        if (hex) {
          targetPicker.value = hex;
          targetHexInput.value = hex;
          update();
        }
      });
    });

    update();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initDeltaEInspector);
  } else {
    initDeltaEInspector();
  }
</script>
