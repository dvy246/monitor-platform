---
import ErgonomicsNotice from '../disclaimers/ErgonomicsNotice.astro';
import HardwareLimitationNotice from '../disclaimers/HardwareLimitationNotice.astro';
import { MACBETH_COLORCHECKER_24 } from '../../engine/DeltaE2000Engine';
---

<div class="bg-bg-surface border border-border-hairline rounded-2xl p-6 sm:p-8 space-y-8 shadow-2xl font-mono">
  <!-- Header Deck -->
  <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 border-b border-border-hairline pb-5">
    <div>
      <div class="text-xs font-bold text-status-pass uppercase tracking-widest flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-status-pass led-glow-pass animate-pulse"></span>
        <span>ISO 9241-307 &amp; CIEDE2000 COLORIMETRY ENGINE</span>
      </div>
      <h3 class="text-xl font-extrabold text-text-primary mt-1">CIEDE2000 Display Calibration Color Accuracy Tool</h3>
    </div>
    <div id="de-grade-badge" class="px-3 py-1 rounded-full bg-status-pass/10 border border-status-pass/30 text-status-pass text-xs font-bold uppercase">
      MASTERING REFERENCE (&Delta;E00 &lt; 1.0)
    </div>
  </div>

  <!-- Main 12-col Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
    <!-- Controls (5 cols) -->
    <div class="lg:col-span-5 bg-bg-canvas p-5 rounded-xl border border-border-hairline space-y-5 text-xs">
      <h4 class="text-sm font-bold text-text-primary border-b border-border-hairline pb-2 flex items-center gap-2">
        <span>🎨 TARGET vs MEASURED COLOR INPUTS</span>
      </h4>

      <!-- Target Color Input -->
      <div class="space-y-2 bg-bg-surface p-3.5 rounded-lg border border-border-hairline">
        <div class="flex justify-between items-center text-text-secondary font-bold uppercase">
          <span>Target Reference Color:</span>
          <span id="target-hex-display" class="text-status-pass font-mono">#735244</span>
        </div>
        <div class="flex items-center gap-3">
          <input type="color" id="target-color-picker" value="#735244" class="w-10 h-10 rounded cursor-pointer bg-transparent border border-border-hairline p-0.5">
          <input type="text" id="target-hex-input" value="#735244" maxlength="7" class="w-full bg-bg-canvas border border-border-hairline rounded-lg p-2 text-text-primary uppercase font-mono text-xs focus:ring-2 focus:ring-status-pass outline-none">
        </div>
      </div>

      <!-- Measured Color Input -->
      <div class="space-y-2 bg-bg-surface p-3.5 rounded-lg border border-border-hairline">
        <div class="flex justify-between items-center text-text-secondary font-bold uppercase">
          <span>Measured Colorimeter Output:</span>
          <span id="measured-hex-display" class="text-amber-400 font-mono">#7A584A</span>
        </div>
        <div class="flex items-center gap-3">
          <input type="color" id="measured-color-picker" value="#7A584A" class="w-10 h-10 rounded cursor-pointer bg-transparent border border-border-hairline p-0.5">
          <input type="text" id="measured-hex-input" value="#7A584A" maxlength="7" class="w-full bg-bg-canvas border border-border-hairline rounded-lg p-2 text-text-primary uppercase font-mono text-xs focus:ring-2 focus:ring-amber-400 outline-none">
        </div>
      </div>

      <!-- Macbeth ColorChecker 24 Grid -->
      <div class="space-y-2 pt-2 border-t border-border-hairline">
        <div class="flex justify-between items-center">
          <span class="text-text-muted font-bold uppercase text-[10px]">24-Patch Macbeth ColorChecker Reference Presets</span>
        </div>
        <div class="grid grid-cols-6 gap-1.5 bg-bg-surface p-2 rounded-lg border border-border-hairline">
          {MACBETH_COLORCHECKER_24.map((patch) => (
            <button
              type="button"
              data-patch-hex={patch.hex}
              title={`${patch.id}. ${patch.name} (${patch.hex})`}
              class="btn-macbeth-patch w-full h-8 rounded border border-white/20 transition-transform hover:scale-105 cursor-pointer relative"
              style={`background-color: ${patch.hex};`}
            >
              <span class="sr-only">{patch.name}</span>
            </button>
          ))}
        </div>
        <p class="text-[10px] text-text-muted text-center">
          Click any Macbeth patch to quickly set Target color.
        </p>
      </div>
    </div>

    <!-- Telemetry Output (7 cols) -->
    <div class="lg:col-span-7 bg-bg-canvas p-5 rounded-xl border border-border-hairline space-y-6">
      <h4 class="text-sm font-bold text-text-primary border-b border-border-hairline pb-2 flex flex-col sm:flex-row sm:items-center justify-between gap-1 sm:gap-2">
        <span>📊 PERCEPTUAL DELTA E TELEMETRY</span>
        <span id="iso-pass-badge" class="text-xs font-mono font-bold text-status-pass uppercase">ISO 9241-307: PASS</span>
      </h4>

      <!-- Key Stat Cards -->
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-4">
        <!-- CIEDE2000 -->
        <div class="bg-bg-surface p-4 rounded-xl border border-border-hairline space-y-1">
          <div class="text-[11px] text-text-muted font-bold uppercase">CIEDE2000 (&Delta;E00)</div>
          <div id="stat-delta-e00" class="text-2xl sm:text-3xl font-black text-status-pass">0.82</div>
          <div class="text-[10px] text-text-secondary font-sans">Primary W3C Metric</div>
        </div>

        <!-- CIE94 -->
        <div class="bg-bg-surface p-4 rounded-xl border border-border-hairline space-y-1">
          <div class="text-[11px] text-text-muted font-bold uppercase">CIE94 (&Delta;E94)</div>
          <div id="stat-delta-e94" class="text-2xl sm:text-3xl font-black text-cyan-400">0.91</div>
          <div class="text-[10px] text-text-secondary font-sans">Graphic Arts standard</div>
        </div>

        <!-- CIE76 -->
        <div class="bg-bg-surface p-4 rounded-xl border border-border-hairline space-y-1 col-span-2 sm:col-span-1">
          <div class="text-[11px] text-text-muted font-bold uppercase">CIE76 (&Delta;E76)</div>
          <div id="stat-delta-e76" class="text-2xl sm:text-3xl font-black text-amber-400">1.45</div>
          <div class="text-[10px] text-text-secondary font-sans">Euclidean L*a*b*</div>
        </div>
      </div>

      <!-- Side-by-side Split Patch Renderer Canvas -->
      <div class="space-y-2">
        <div class="text-xs font-bold text-text-secondary uppercase tracking-wider flex justify-between">
          <span>Side-by-Side Visual Split Patch Renderer</span>
          <span class="text-text-muted font-normal text-[10px]">Direct Visual Comparison</span>
        </div>
        <div class="w-full h-32 rounded-xl border border-border-hairline overflow-hidden grid grid-cols-2 shadow-inner">
          <div id="split-patch-target" class="h-full flex items-end p-3 bg-[#735244] transition-colors">
            <span class="bg-black/60 backdrop-blur-md px-2 py-1 rounded text-[10px] font-bold text-white uppercase border border-white/10">Target Reference</span>
          </div>
          <div id="split-patch-measured" class="h-full flex items-end p-3 bg-[#7a584a] transition-colors">
            <span class="bg-black/60 backdrop-blur-md px-2 py-1 rounded text-[10px] font-bold text-white uppercase border border-white/10">Measured Output</span>
          </div>
        </div>
      </div>

      <!-- Detailed Error Component Breakdown (dL, dC, dH) -->
      <div class="bg-bg-surface p-4 rounded-xl border border-border-hairline space-y-4">
        <div class="text-xs font-bold text-text-primary uppercase tracking-wider border-b border-border-hairline pb-2">
          Color Error Vector Breakdown (&Delta;L, &Delta;C, &Delta;H)
        </div>
        
        <div class="grid grid-cols-3 gap-3 text-xs">
          <!-- Lightness Error -->
          <div class="bg-bg-canvas p-3 rounded-lg border border-border-hairline space-y-1">
            <div class="text-[10px] text-text-muted font-bold uppercase">&Delta;L (Lightness)</div>
            <div id="val-delta-l" class="text-lg font-bold text-text-primary">+0.35</div>
            <div id="desc-delta-l" class="text-[10px] text-text-secondary">Slightly Brighter</div>
          </div>

          <!-- Chroma Error -->
          <div class="bg-bg-canvas p-3 rounded-lg border border-border-hairline space-y-1">
            <div class="text-[10px] text-text-muted font-bold uppercase">&Delta;C (Chroma)</div>
            <div id="val-delta-c" class="text-lg font-bold text-text-primary">+0.42</div>
            <div id="desc-delta-c" class="text-[10px] text-text-secondary">More Saturated</div>
          </div>

          <!-- Hue Error -->
          <div class="bg-bg-canvas p-3 rounded-lg border border-border-hairline space-y-1">
            <div class="text-[10px] text-text-muted font-bold uppercase">&Delta;H (Hue Shift)</div>
            <div id="val-delta-h" class="text-lg font-bold text-text-primary">-0.12</div>
            <div id="desc-delta-h" class="text-[10px] text-text-secondary">Negligible Shift</div>
          </div>
        </div>

        <div class="p-3 bg-bg-canvas rounded-lg border border-border-hairline text-xs space-y-1">
          <div class="font-bold text-amber-400 uppercase text-[10px]">ISO 9241-307 Rating Description:</div>
          <p id="de-rating-desc" class="text-text-secondary text-[11px] leading-relaxed">
            Mastering Reference Grade (Delta E &lt; 1.0). Imperceptible error to trained colorists.
          </p>
        </div>
      </div>
    </div>
  </div>

  <HardwareLimitationNotice />
  <ErgonomicsNotice />
</div>

<script>
  import { calculateDeltaE2000, hexToRgb, rgbToLab } from '../../engine/DeltaE2000Engine';

  function initDeltaEInspector() {
    const targetPicker = document.getElementById('target-color-picker') as HTMLInputElement;
    const targetHexInput = document.getElementById('target-hex-input') as HTMLInputElement;
    const targetHexDisplay = document.getElementById('target-hex-display');

    const measuredPicker = document.getElementById('measured-color-picker') as HTMLInputElement;
    const measuredHexInput = document.getElementById('measured-hex-input') as HTMLInputElement;
    const measuredHexDisplay = document.getElementById('measured-hex-display');

    const deGradeBadge = document.getElementById('de-grade-badge');
    const isoPassBadge = document.getElementById('iso-pass-badge');

    const statDeltaE00 = document.getElementById('stat-delta-e00');
    const statDeltaE94 = document.getElementById('stat-delta-e94');
    const statDeltaE76 = document.getElementById('stat-delta-e76');

    const splitTarget = document.getElementById('split-patch-target');
    const splitMeasured = document.getElementById('split-patch-measured');

    const valDeltaL = document.getElementById('val-delta-l');
    const descDeltaL = document.getElementById('desc-delta-l');
    const valDeltaC = document.getElementById('val-delta-c');
    const descDeltaC = document.getElementById('desc-delta-c');
    const valDeltaH = document.getElementById('val-delta-h');
    const descDeltaH = document.getElementById('desc-delta-h');
    const deRatingDesc = document.getElementById('de-rating-desc');

    function update() {
      const targetHex = targetHexInput.value.startsWith('#') ? targetHexInput.value : `#${targetHexInput.value}`;
      const measuredHex = measuredHexInput.value.startsWith('#') ? measuredHexInput.value : `#${measuredHexInput.value}`;

      if (targetHexDisplay) targetHexDisplay.textContent = targetHex.toUpperCase();
      if (measuredHexDisplay) measuredHexDisplay.textContent = measuredHex.toUpperCase();

      if (splitTarget) splitTarget.style.backgroundColor = targetHex;
      if (splitMeasured) splitMeasured.style.backgroundColor = measuredHex;

      const targetRgb = hexToRgb(targetHex);
      const measuredRgb = hexToRgb(measuredHex);

      const targetLab = rgbToLab(targetRgb);
      const measuredLab = rgbToLab(measuredRgb);

      const result = calculateDeltaE2000(targetLab, measuredLab);

      if (statDeltaE00) statDeltaE00.textContent = result.deltaE00.toFixed(2);
      if (statDeltaE94) statDeltaE94.textContent = result.deltaE94.toFixed(2);
      if (statDeltaE76) statDeltaE76.textContent = result.deltaE76.toFixed(2);

      if (deGradeBadge) {
        deGradeBadge.textContent = `${result.rating.replace('_', ' ')} (\u0394E00: ${result.deltaE00.toFixed(2)})`;
        if (result.deltaE00 < 1.0) {
          deGradeBadge.className = 'px-3 py-1 rounded-full bg-status-pass/10 border border-status-pass/30 text-status-pass text-xs font-bold uppercase';
        } else if (result.deltaE00 < 2.0) {
          deGradeBadge.className = 'px-3 py-1 rounded-full bg-cyan-400/10 border border-cyan-400/30 text-cyan-400 text-xs font-bold uppercase';
        } else if (result.deltaE00 < 3.0) {
          deGradeBadge.className = 'px-3 py-1 rounded-full bg-amber-400/10 border border-amber-400/30 text-amber-400 text-xs font-bold uppercase';
        } else {
          deGradeBadge.className = 'px-3 py-1 rounded-full bg-rose-400/10 border border-rose-400/30 text-rose-400 text-xs font-bold uppercase';
        }
      }

      if (isoPassBadge) {
        isoPassBadge.textContent = result.isPassedIso9241 ? 'ISO 9241-307: PASS' : 'ISO 9241-307: FAIL (\u22653.0)';
        isoPassBadge.className = result.isPassedIso9241 ? 'text-xs font-mono font-bold text-status-pass uppercase' : 'text-xs font-mono font-bold text-rose-400 uppercase';
      }

      if (valDeltaL) valDeltaL.textContent = `${result.deltaL >= 0 ? '+' : ''}${result.deltaL.toFixed(2)}`;
      if (descDeltaL) descDeltaL.textContent = result.deltaL > 0.1 ? 'Brighter than target' : result.deltaL < -0.1 ? 'Darker than target' : 'Accurate lightness';

      if (valDeltaC) valDeltaC.textContent = `${result.deltaC >= 0 ? '+' : ''}${result.deltaC.toFixed(2)}`;
      if (descDeltaC) descDeltaC.textContent = result.deltaC > 0.1 ? 'More saturated' : result.deltaC < -0.1 ? 'Less saturated' : 'Accurate chroma';

      if (valDeltaH) valDeltaH.textContent = `${result.deltaH >= 0 ? '+' : ''}${result.deltaH.toFixed(2)}`;
      if (descDeltaH) descDeltaH.textContent = Math.abs(result.deltaH) > 0.5 ? 'Noticeable hue shift' : 'Negligible hue shift';

      if (deRatingDesc) deRatingDesc.textContent = result.ratingDescription;
    }

    targetPicker?.addEventListener('input', (e) => {
      targetHexInput.value = (e.target as HTMLInputElement).value;
      update();
    });
    targetHexInput?.addEventListener('input', () => {
      if (targetHexInput.value.length === 7) {
        targetPicker.value = targetHexInput.value;
      }
      update();
    });

    measuredPicker?.addEventListener('input', (e) => {
      measuredHexInput.value = (e.target as HTMLInputElement).value;
      update();
    });
    measuredHexInput?.addEventListener('input', () => {
      if (measuredHexInput.value.length === 7) {
        measuredPicker.value = measuredHexInput.value;
      }
      update();
    });

    document.querySelectorAll('.btn-macbeth-patch').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLButtonElement;
        const hex = target.dataset.patchHex;
        if (hex) {
          targetPicker.value = hex;
          targetHexInput.value = hex;
          update();
        }
      });
    });

    update();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initDeltaEInspector);
  } else {
    initDeltaEInspector();
  }
</script>
