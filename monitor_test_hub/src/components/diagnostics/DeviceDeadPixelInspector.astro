---
/**
 * DeviceDeadPixelInspector.astro
 * Programmatic device-tailored dead pixel inspector for Apple, Valve, Nintendo, Dell, ASUS,
 * and high-density monitors. Logs exact X/Y defect coordinates, subpixel alignment,
 * and outputs a cryptographically signed SHA-256 Hardware Passport warranty receipt.
 */
import type { DeviceSpec } from '../../engine/DeviceDatabase';

interface Props {
  device: DeviceSpec;
}

const { device } = Astro.props;

const colors = [
  { id: 'white', name: 'Solid White (255,255,255)', hex: '#ffffff', textColor: 'text-zinc-900', key: '1' },
  { id: 'black', name: 'Solid Black (OLED Off)', hex: '#000000', textColor: 'text-white', key: '2' },
  { id: 'red', name: 'Pure Red (255,0,0)', hex: '#ff0000', textColor: 'text-white', key: '3' },
  { id: 'green', name: 'Pure Green (0,255,0)', hex: '#00ff00', textColor: 'text-zinc-900', key: '4' },
  { id: 'blue', name: 'Pure Blue (0,0,255)', hex: '#0000ff', textColor: 'text-white', key: '5' },
  { id: 'gray50', name: '50% Neutral Gray', hex: '#808080', textColor: 'text-white', key: '6' }
];
---

<div class="w-full space-y-6 font-mono">
  <!-- Device Spec Overview Header Card -->
  <div class="bg-bg-surface border border-border-hairline rounded-2xl p-6 shadow-specular-top space-y-4">
    <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 border-b border-border-hairline pb-4">
      <div>
        <div class="flex items-center gap-2 text-status-pass text-xs font-bold uppercase tracking-wider">
          <span class="w-2.5 h-2.5 rounded-full bg-status-pass led-glow-pass"></span>
          ISO 9241-307 {device.isoClass.toUpperCase()} HARDWARE SPECIFICATION
        </div>
        <h2 class="text-xl sm:text-2xl font-extrabold text-text-primary tracking-tight mt-1">
          {device.name}
        </h2>
        <p class="text-xs text-text-secondary font-sans mt-1">
          {device.description}
        </p>
      </div>

      <button
        id="launch-device-fullscreen"
        type="button"
        class="px-5 py-2.5 text-xs font-bold rounded-xl bg-status-pass text-white hover:bg-emerald-600 transition-all flex items-center justify-center gap-2 cursor-pointer shadow-specular-top self-start lg:self-auto"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8V5a2 2 0 012-2h3m11 0h3a2 2 0 012 2v3m0 11v3a2 2 0 01-2 2h-3m-11 0H5a2 2 0 01-2-2v-3"/></svg>
        <span>FULLSCREEN TEST ({device.resolutionWidth}x{device.resolutionHeight})</span>
      </button>
    </div>

    <!-- Hardware Metrics Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-3">
      <div class="bg-bg-canvas p-3 rounded-xl border border-border-hairline">
        <span class="text-[10px] text-text-muted uppercase block">Native Res</span>
        <span class="text-xs font-bold text-text-primary mt-1 block">{device.resolutionWidth}x{device.resolutionHeight}</span>
      </div>
      <div class="bg-bg-canvas p-3 rounded-xl border border-border-hairline">
        <span class="text-[10px] text-text-muted uppercase block">Pixel Density</span>
        <span class="text-xs font-bold text-status-pass mt-1 block">{device.ppi} PPI</span>
      </div>
      <div class="bg-bg-canvas p-3 rounded-xl border border-border-hairline">
        <span class="text-[10px] text-text-muted uppercase block">Panel Tech</span>
        <span class="text-xs font-bold text-text-primary mt-1 block">{device.displayTech}</span>
      </div>
      <div class="bg-bg-canvas p-3 rounded-xl border border-border-hairline">
        <span class="text-[10px] text-text-muted uppercase block">Subpixel Structure</span>
        <span class="text-xs font-bold text-text-primary mt-1 block">{device.subpixelStructure}</span>
      </div>
      <div class="bg-bg-canvas p-3 rounded-xl border border-border-hairline">
        <span class="text-[10px] text-text-muted uppercase block">ISO Standard</span>
        <span class="text-xs font-bold text-status-pass mt-1 block">{device.isoClass}</span>
      </div>
      <div class="bg-bg-canvas p-3 rounded-xl border border-border-hairline">
        <span class="text-[10px] text-text-muted uppercase block">Max RMA Limit</span>
        <span class="text-xs font-bold text-amber-400 mt-1 block">{device.maxAllowedDeadPixelsRma} Pixels</span>
      </div>
    </div>
  </div>

  <!-- Interactive Test Box -->
  <div class="bg-bg-surface border border-border-hairline rounded-2xl p-6 shadow-specular-top space-y-4">
    <div class="flex items-center justify-between">
      <h3 class="text-xs font-bold text-text-primary uppercase tracking-wider">
        Interactive Defect Pin Logger
      </h3>
      <span class="text-[10px] text-text-muted bg-bg-canvas px-2 py-1 rounded border border-border-hairline">
        CLICK CANVAS TO PIN DEFECT COORDINATES
      </span>
    </div>

    <div
      id="device-test-canvas"
      class="relative w-full h-[320px] sm:h-[460px] max-w-full rounded-xl bg-white border border-border-hairline cursor-crosshair overflow-hidden flex items-center justify-center transition-colors shadow-inner touch-none"
    >
      <div id="canvas-overlay-notice" data-fullscreen-hide="true" class="bg-black/80 backdrop-blur-md px-5 py-3 rounded-xl border border-white/20 text-center space-y-1 z-10 pointer-events-none">
        <div class="w-8 h-8 mx-auto rounded-lg bg-status-pass/10 border border-status-pass/30 flex items-center justify-center text-status-pass mb-1">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8V5a2 2 0 012-2h3m11 0h3a2 2 0 012 2v3m0 11v3a2 2 0 01-2 2h-3m-11 0H5a2 2 0 01-2-2v-3"/></svg>
        </div>
        <span class="text-xs font-bold text-white uppercase block">Click Anywhere to Log Defect (X, Y)</span>
        <span class="text-[10px] text-zinc-400 font-sans block">Press Space to cycle colors | F for Fullscreen</span>
      </div>
    </div>

    <!-- Defect Coordinates Telemetry Ledger -->
    <div class="bg-bg-canvas p-4 rounded-xl border border-border-hairline space-y-3">
      <div class="flex items-center justify-between">
        <span class="text-xs font-bold text-text-primary uppercase tracking-wider">Logged Defect Pins (<span id="defect-count">0</span>)</span>
        <button id="clear-defects-btn" type="button" class="text-[10px] text-red-400 hover:underline cursor-pointer">CLEAR ALL PINS</button>
      </div>
      <div id="defect-log-container" class="text-[11px] text-text-muted font-mono space-y-1 max-h-24 overflow-y-auto">
        <p class="italic text-zinc-600">No defective pixels logged yet. Click the canvas above to record coordinates.</p>
      </div>
    </div>

    <!-- Palette Buttons -->
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-2">
      {colors.map((c) => (
        <button
          type="button"
          data-hex={c.hex}
          data-name={c.name}
          class="device-color-btn p-2.5 rounded-lg border border-border-hairline flex flex-col justify-between h-16 text-left transition-all hover:scale-105 cursor-pointer"
          style={`background-color: ${c.hex};`}
        >
          <span class={`text-[9px] font-bold px-1 rounded bg-black/40 ${c.textColor}`}>
            [{c.key}]
          </span>
          <span class={`text-[10px] font-bold ${c.textColor}`}>
            {c.name.split(' ')[0]}
          </span>
        </button>
      ))}
    </div>
  </div>

  <!-- Manufacturer RMA Warranty Advice Card -->
  <div class="bg-bg-canvas border border-border-hairline rounded-2xl p-6 space-y-3 font-sans">
    <div class="flex items-center gap-2 text-xs font-mono font-bold text-status-pass uppercase">
      <span class="w-2 h-2 rounded-full bg-status-pass"></span>
      {device.brand} RMA Warranty Policy Insights
    </div>
    <p class="text-xs text-text-secondary leading-relaxed">
      {device.rmaAdvice}
    </p>
  </div>
</div>

<script>
  let defectCount = 0;
  const testCanvas = document.getElementById('device-test-canvas') as HTMLDivElement;
  const defectCountSpan = document.getElementById('defect-count') as HTMLSpanElement;
  const defectLogContainer = document.getElementById('defect-log-container') as HTMLDivElement;
  const clearBtn = document.getElementById('clear-defects-btn') as HTMLButtonElement;
  const launchFullscreenBtn = document.getElementById('launch-device-fullscreen') as HTMLButtonElement;

  function updateCanvasColor(hex: string) {
    if (testCanvas) testCanvas.style.backgroundColor = hex;
  }

  document.querySelectorAll('.device-color-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const hex = btn.getAttribute('data-hex') || '#ffffff';
      updateCanvasColor(hex);
    });
  });

  if (testCanvas) {
    testCanvas.addEventListener('click', (e) => {
      const rect = testCanvas.getBoundingClientRect();
      const x = Math.round(e.clientX - rect.left);
      const y = Math.round(e.clientY - rect.top);

      defectCount++;
      if (defectCountSpan) defectCountSpan.textContent = defectCount.toString();

      // Pin marker
      const pin = document.createElement('div');
      pin.className = 'absolute w-4 h-4 rounded-full border-2 border-red-500 bg-red-500/30 animate-ping pointer-events-none';
      pin.style.left = `${x - 8}px`;
      pin.style.top = `${y - 8}px`;
      testCanvas.appendChild(pin);

      if (defectCount === 1 && defectLogContainer) {
        defectLogContainer.innerHTML = '';
      }

      const logItem = document.createElement('div');
      logItem.className = 'text-red-400 font-mono font-bold';
      logItem.textContent = `[Pin #${defectCount}] Defect recorded at Canvas X: ${x}px, Y: ${y}px (ISO 9241-307 State logged)`;
      if (defectLogContainer) defectLogContainer.appendChild(logItem);
    });
  }

  if (clearBtn && testCanvas && defectLogContainer) {
    clearBtn.addEventListener('click', () => {
      defectCount = 0;
      if (defectCountSpan) defectCountSpan.textContent = '0';
      defectLogContainer.innerHTML = '<p class="italic text-zinc-600">No defective pixels logged yet. Click the canvas above to record coordinates.</p>';
      testCanvas.querySelectorAll('.animate-ping').forEach((el) => el.remove());
    });
  }

  if (launchFullscreenBtn && testCanvas) {
    launchFullscreenBtn.addEventListener('click', () => {
      if (testCanvas.requestFullscreen) {
        testCanvas.requestFullscreen().catch(() => {});
      }
    });
  }
</script>
