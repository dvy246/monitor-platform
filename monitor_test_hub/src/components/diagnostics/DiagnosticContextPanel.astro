---
/**
 * DiagnosticContextPanel.astro
 * Professional 4-quadrant context disclosure card:
 * 1. What it does, 2. When to use it, 3. How to interpret results, 4. Common mistakes.
 */
interface Props {
  testTitle?: string;
  whatItDoes?: string;
  whenToUse?: string;
  howToInterpret?: string;
  commonMistakes?: string;
  class?: string;
}

const { 
  testTitle = "Display Diagnostic Suite",
  whatItDoes = "Evaluates hardware display panel condition, pixel sub-pixel structure, color rendering, and frame presentation timing.",
  whenToUse = "Run upon unboxing new monitors, before retailer return windows close, or when observing visual defects.",
  howToInterpret = "Dead pixels appear dark black across all colors. Stuck sub-pixels display a single static color (Red, Green, or Blue).",
  commonMistakes = "Leaving ambient room lights on during dark-room backlight tests, or running in browser zoom scaling modes.",
  class: className = '' 
} = Astro.props;
---

<div class:list={["bg-[#0d0d12]/90 border border-white/10 rounded-3xl p-5 sm:p-6 space-y-4 shadow-[0_20px_50px_rgba(0,0,0,0.5)] backdrop-blur-2xl font-sans select-none hover:border-white/20 transition-all duration-300 relative overflow-hidden group", className]}>
  <!-- Top ambient Cyan Glow -->
  <div class="absolute -top-12 -right-12 w-32 h-32 bg-cyan-500/10 rounded-full blur-2xl pointer-events-none group-hover:bg-cyan-500/20 transition-all duration-500"></div>

  <!-- Header -->
  <div class="flex items-center justify-between border-b border-white/10 pb-3.5 relative z-10">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 rounded-2xl bg-cyan-500/15 border border-cyan-500/30 flex items-center justify-center text-cyan-400 shadow-[inset_0_1px_1px_rgba(255,255,255,0.2)] shrink-0">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
      </div>
      <div>
        <h3 class="text-base font-bold text-white tracking-tight">Diagnostic Context</h3>
        <p class="text-[11px] text-zinc-400 font-mono truncate max-w-[200px] sm:max-w-xs">{testTitle}</p>
      </div>
    </div>
    <span class="text-[11px] font-mono text-zinc-400 bg-white/[0.05] px-2.5 py-1 rounded-full border border-white/10">Engineering Advice</span>
  </div>

  <!-- 4-Quadrant Card Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-3.5 text-xs font-sans text-zinc-300 leading-relaxed relative z-10">
    <!-- Quadrant 1: What It Does -->
    <div class="bg-[#14141c] p-4 rounded-2xl border border-white/[0.08] hover:border-cyan-500/30 transition-all space-y-2 group/q1">
      <div class="flex items-center gap-2">
        <div class="w-6 h-6 rounded-lg bg-cyan-500/15 text-cyan-400 flex items-center justify-center border border-cyan-500/25">
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
          </svg>
        </div>
        <strong class="text-white font-mono uppercase text-[10px] tracking-wider text-cyan-400">1. What This Test Does</strong>
      </div>
      <p class="text-zinc-300">{whatItDoes}</p>
    </div>

    <!-- Quadrant 2: When To Use It -->
    <div class="bg-[#14141c] p-4 rounded-2xl border border-white/[0.08] hover:border-emerald-500/30 transition-all space-y-2 group/q2">
      <div class="flex items-center gap-2">
        <div class="w-6 h-6 rounded-lg bg-emerald-500/15 text-emerald-400 flex items-center justify-center border border-emerald-500/25">
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
        </div>
        <strong class="text-white font-mono uppercase text-[10px] tracking-wider text-emerald-400">2. When To Use It</strong>
      </div>
      <p class="text-zinc-300">{whenToUse}</p>
    </div>

    <!-- Quadrant 3: How To Interpret Results -->
    <div class="bg-[#14141c] p-4 rounded-2xl border border-white/[0.08] hover:border-purple-500/30 transition-all space-y-2 group/q3">
      <div class="flex items-center gap-2">
        <div class="w-6 h-6 rounded-lg bg-purple-500/15 text-purple-400 flex items-center justify-center border border-purple-500/25">
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
        </div>
        <strong class="text-white font-mono uppercase text-[10px] tracking-wider text-purple-400">3. How To Interpret Results</strong>
      </div>
      <p class="text-zinc-300">{howToInterpret}</p>
    </div>

    <!-- Quadrant 4: Common Mistakes -->
    <div class="bg-[#14141c] p-4 rounded-2xl border border-white/[0.08] hover:border-rose-500/30 transition-all space-y-2 group/q4">
      <div class="flex items-center gap-2">
        <div class="w-6 h-6 rounded-lg bg-rose-500/15 text-rose-400 flex items-center justify-center border border-rose-500/25">
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
          </svg>
        </div>
        <strong class="text-white font-mono uppercase text-[10px] tracking-wider text-rose-400">4. Common Mistakes</strong>
      </div>
      <p class="text-zinc-300">{commonMistakes}</p>
    </div>
  </div>
</div>
