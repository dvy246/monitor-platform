---
// src/components/diagnostics/E2eLatencyAnalyzerCanvas.astro
---
<div class="e2e-analyzer-container w-full bg-[#08080a] border border-white/10 rounded-3xl p-6 relative overflow-hidden flex flex-col gap-6 shadow-2xl">
  <!-- Target Zone For Testing -->
  <div id="flash-target" class="w-full h-32 rounded-xl bg-zinc-900 border border-white/5 flex items-center justify-center cursor-pointer transition-colors duration-75 select-none hover:bg-zinc-800">
    <p class="text-zinc-500 font-mono text-sm pointer-events-none">Click here to flash the screen (Record this area with your phone)</p>
  </div>

  <!-- Dropzone -->
  <div id="dropzone" class="w-full h-48 border-2 border-dashed border-zinc-700/50 rounded-2xl flex flex-col items-center justify-center bg-zinc-900/50 hover:bg-zinc-800/50 transition-colors cursor-pointer group">
    <svg class="w-10 h-10 text-zinc-500 mb-3 group-hover:text-emerald-400 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
    </svg>
    <span class="font-mono text-zinc-300 font-semibold">Drop 240fps Slow-Mo Video Here</span>
    <span class="text-xs text-zinc-500 mt-2">MP4/MOV files only • Processed 100% locally</span>
    <input type="file" id="file-input" accept="video/mp4,video/quicktime" class="hidden" />
  </div>

  <!-- Loading / Progress -->
  <div id="progress-container" class="hidden w-full space-y-2">
    <div class="flex justify-between text-xs font-mono text-zinc-400">
      <span id="progress-status">Demuxing video...</span>
      <span id="progress-percent">0%</span>
    </div>
    <div class="w-full h-1 bg-zinc-800 rounded-full overflow-hidden">
      <div id="progress-bar" class="h-full bg-emerald-500 w-0 transition-all duration-300"></div>
    </div>
  </div>

  <!-- Timeline Interface -->
  <div id="timeline-interface" class="hidden w-full flex-col gap-4">
    <!-- Results Header -->
    <div class="flex justify-between items-end border-b border-white/10 pb-4">
      <div>
        <p class="text-xs font-mono text-zinc-500 mb-1">MEASURED SYSTEM LATENCY</p>
        <h3 class="text-4xl font-extrabold font-mono text-white tracking-tight flex items-baseline gap-2">
          <span id="result-latency" class="text-emerald-400">--</span> 
          <span class="text-xl text-zinc-400 font-medium">ms</span>
        </h3>
      </div>
      <button id="btn-export" class="px-4 py-2 bg-zinc-800 hover:bg-zinc-700 text-xs font-mono text-white rounded-lg transition-colors border border-white/5">
        Export Result
      </button>
    </div>

    <!-- Video Frame Selector -->
    <div class="relative w-full aspect-video bg-black rounded-lg overflow-hidden border border-white/10">
      <canvas id="video-preview-canvas" class="w-full h-full object-contain"></canvas>
      
      <!-- Bounding Box Overlay for optical detection area -->
      <div id="roi-box" class="absolute border-2 border-emerald-500 bg-emerald-500/10 cursor-move hidden" style="left: 20%; top: 20%; width: 60%; height: 60%;">
        <div class="absolute -top-6 left-0 bg-emerald-500 text-black text-[10px] font-bold px-1 rounded-sm uppercase tracking-wider">Analysis Zone</div>
        <!-- Resize Handles -->
        <div class="absolute w-3 h-3 bg-white border border-emerald-500 -right-1.5 -bottom-1.5 cursor-se-resize roi-handle"></div>
      </div>
    </div>

    <!-- Timeline Scrubber -->
    <div class="w-full bg-zinc-900 rounded-lg p-4 border border-white/5 flex flex-col gap-2 relative">
      <div class="flex justify-between text-[10px] font-mono text-zinc-500 mb-1">
        <span>0ms</span>
        <span id="timeline-duration">--ms</span>
      </div>
      
      <!-- Audio Track -->
      <div class="relative h-12 bg-black rounded border border-white/5 overflow-hidden w-full">
        <canvas id="audio-waveform-canvas" class="absolute inset-0 w-full h-full"></canvas>
        <div id="audio-marker" class="absolute top-0 bottom-0 w-0.5 bg-yellow-400 z-10 hidden shadow-[0_0_8px_rgba(250,204,21,0.8)]"></div>
        <div class="absolute top-1 left-2 text-[9px] font-mono text-yellow-500 uppercase tracking-widest font-bold">Audio Track (Click)</div>
      </div>

      <!-- Video Luma Track -->
      <div class="relative h-12 bg-black rounded border border-white/5 overflow-hidden w-full">
        <canvas id="video-luma-canvas" class="absolute inset-0 w-full h-full"></canvas>
        <div id="video-marker" class="absolute top-0 bottom-0 w-0.5 bg-sky-400 z-10 hidden shadow-[0_0_8px_rgba(56,189,248,0.8)]"></div>
        <div class="absolute top-1 left-2 text-[9px] font-mono text-sky-500 uppercase tracking-widest font-bold">Video Track (Flash)</div>
      </div>

      <!-- Scrubber Playhead -->
      <div id="scrubber-playhead" class="absolute top-4 bottom-4 w-px bg-white/50 z-20 pointer-events-none transition-transform duration-75"></div>
      
      <!-- Interactive overlay for scrubbing -->
      <div id="scrub-overlay" class="absolute inset-x-4 top-4 bottom-4 cursor-col-resize z-30"></div>
    </div>
    <p class="text-xs text-zinc-500 font-mono text-center mt-2">Drag bounding box over screen area. Playheads auto-snap to peak transients.</p>
  </div>
</div>

<script>
  // Advanced WebCodecs + Web Audio API DSP Logic
  import * as MP4Box from 'mp4box';

  class E2eLatencyAnalyzer {
    constructor() {
      this.dropzone = document.getElementById('dropzone');
      this.fileInput = document.getElementById('file-input');
      this.flashTarget = document.getElementById('flash-target');
      this.progressContainer = document.getElementById('progress-container');
      this.progressStatus = document.getElementById('progress-status');
      this.progressBar = document.getElementById('progress-bar');
      this.progressPercent = document.getElementById('progress-percent');
      
      this.timelineInterface = document.getElementById('timeline-interface');
      this.resultLatency = document.getElementById('result-latency');
      
      this.videoPreviewCanvas = document.getElementById('video-preview-canvas');
      this.ctxPreview = this.videoPreviewCanvas.getContext('2d', { willReadFrequently: true });
      
      this.audioWaveformCanvas = document.getElementById('audio-waveform-canvas');
      this.videoLumaCanvas = document.getElementById('video-luma-canvas');
      
      this.audioMarker = document.getElementById('audio-marker');
      this.videoMarker = document.getElementById('video-marker');
      this.scrubberPlayhead = document.getElementById('scrubber-playhead');
      this.scrubOverlay = document.getElementById('scrub-overlay');
      
      this.roiBox = document.getElementById('roi-box');
      
      this.state = {
        videoFrames: [], // { pts, imageBitmap, luma }
        audioData: null, // Float32Array
        sampleRate: 48000,
        fps: 240, // Extracted or assumed
        durationMs: 0,
        clickTimeMs: null,
        flashTimeMs: null,
        roi: { x: 0.2, y: 0.2, w: 0.6, h: 0.6 },
        currentScrubRatio: 0
      };

      this.initEventListeners();
    }

    initEventListeners() {
      // Flash Target Logic (turn screen white temporarily)
      this.flashTarget.addEventListener('mousedown', () => {
        const bg = document.body.style.backgroundColor;
        document.body.style.backgroundColor = '#ffffff';
        setTimeout(() => {
          document.body.style.backgroundColor = bg;
        }, 150);
      });

      // Dropzone Logic
      this.dropzone.addEventListener('click', () => this.fileInput.click());
      this.dropzone.addEventListener('dragover', (e) => {
        e.preventDefault();
        this.dropzone.classList.add('border-emerald-500', 'bg-emerald-500/10');
      });
      this.dropzone.addEventListener('dragleave', () => {
        this.dropzone.classList.remove('border-emerald-500', 'bg-emerald-500/10');
      });
      this.dropzone.addEventListener('drop', (e) => {
        e.preventDefault();
        this.dropzone.classList.remove('border-emerald-500', 'bg-emerald-500/10');
        if (e.dataTransfer.files.length) {
          this.processFile(e.dataTransfer.files[0]);
        }
      });
      this.fileInput.addEventListener('change', (e) => {
        if (e.target.files.length) {
          this.processFile(e.target.files[0]);
        }
      });

      // Scrubbing Logic
      let isDragging = false;
      this.scrubOverlay.addEventListener('mousedown', (e) => { isDragging = true; this.updateScrub(e); });
      window.addEventListener('mousemove', (e) => { if (isDragging) this.updateScrub(e); });
      window.addEventListener('mouseup', () => { isDragging = false; });
    }

    updateProgress(status, percent) {
      this.progressStatus.textContent = status;
      this.progressBar.style.width = `${percent}%`;
      this.progressPercent.textContent = `${Math.round(percent)}%`;
    }

    updateScrub(e) {
      const rect = this.scrubOverlay.getBoundingClientRect();
      let x = e.clientX - rect.left;
      x = Math.max(0, Math.min(x, rect.width));
      this.state.currentScrubRatio = x / rect.width;
      
      this.scrubberPlayhead.style.transform = `translateX(${x}px)`;
      
      this.renderPreviewFrame();
    }

    renderPreviewFrame() {
      if (this.state.videoFrames.length === 0) return;
      const targetTime = this.state.currentScrubRatio * this.state.durationMs;
      
      // Find closest frame
      let closestFrame = this.state.videoFrames[0];
      let minDiff = Infinity;
      for (const frame of this.state.videoFrames) {
        const diff = Math.abs((frame.pts / 1000) - targetTime);
        if (diff < minDiff) {
          minDiff = diff;
          closestFrame = frame;
        }
      }

      const canvas = this.videoPreviewCanvas;
      const ctx = this.ctxPreview;
      
      if (canvas.width !== closestFrame.imageBitmap.width) {
        canvas.width = closestFrame.imageBitmap.width;
        canvas.height = closestFrame.imageBitmap.height;
      }
      
      ctx.drawImage(closestFrame.imageBitmap, 0, 0);
    }

    async processFile(file) {
      this.dropzone.classList.add('hidden');
      this.progressContainer.classList.remove('hidden');
      this.timelineInterface.classList.add('hidden');
      
      this.state.videoFrames = [];
      this.state.audioData = null;

      try {
        const arrayBuffer = await file.arrayBuffer();
        
        // 1. Process Audio
        this.updateProgress('Decoding Audio (Web Audio API)...', 10);
        await this.processAudio(arrayBuffer.slice(0)); // Pass copy
        
        // 2. Demux & Decode Video
        this.updateProgress('Demuxing Video (MP4Box)...', 30);
        await this.processVideo(arrayBuffer.slice(0));

        // 3. Analyze Latency
        this.updateProgress('Running DSP Forensics...', 90);
        this.analyzeLatency();

        // 4. Render UI
        this.updateProgress('Complete', 100);
        setTimeout(() => {
          this.progressContainer.classList.add('hidden');
          this.timelineInterface.classList.remove('hidden');
          this.timelineInterface.classList.add('flex');
          this.roiBox.classList.remove('hidden');
          this.drawWaveforms();
          this.state.currentScrubRatio = (this.state.flashTimeMs || 0) / this.state.durationMs;
          this.updateScrub({ clientX: this.scrubOverlay.getBoundingClientRect().left + this.state.currentScrubRatio * this.scrubOverlay.getBoundingClientRect().width });
        }, 500);

      } catch (err) {
        console.error(err);
        this.progressStatus.textContent = 'Error: ' + err.message;
        this.progressBar.classList.replace('bg-emerald-500', 'bg-red-500');
      }
    }

    async processAudio(buffer) {
      const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
      const decodedData = await audioCtx.decodeAudioData(buffer);
      this.state.sampleRate = decodedData.sampleRate;
      this.state.durationMs = decodedData.duration * 1000;
      
      // Mix down to mono
      const channelData = decodedData.getChannelData(0);
      this.state.audioData = channelData;
      
      // High-pass filter mathematically to find sharp transient click
      // Simplified RMS envelope detection
      let maxRMS = 0;
      let peakIdx = 0;
      const windowSize = Math.floor(this.state.sampleRate * 0.001); // 1ms window
      
      for (let i = 0; i < channelData.length - windowSize; i += windowSize/2) {
        let sumSq = 0;
        for (let j = 0; j < windowSize; j++) {
          sumSq += channelData[i+j] * channelData[i+j];
        }
        const rms = Math.sqrt(sumSq / windowSize);
        if (rms > maxRMS) {
          maxRMS = rms;
          peakIdx = i;
        }
      }
      
      this.state.clickTimeMs = (peakIdx / this.state.sampleRate) * 1000;
    }

    async processVideo(buffer) {
      if (!('VideoDecoder' in window)) {
        throw new Error("WebCodecs API not supported in this browser. Please use a modern Chromium browser or Safari 16.4+.");
      }

      return new Promise((resolve, reject) => {
        const mp4boxfile = MP4Box.createFile();
        
        let videoTrack = null;
        let decoder = null;
        let framesDecoded = 0;
        let totalFrames = 0;

        mp4boxfile.onError = (e) => reject(new Error("MP4Box Demux Error: " + e));
        
        mp4boxfile.onReady = (info) => {
          videoTrack = info.videoTracks[0];
          if (!videoTrack) return reject(new Error("No video track found."));
          
          totalFrames = videoTrack.nb_samples;
          
          decoder = new VideoDecoder({
            output: async (frame) => {
              // Extract ImageBitmap immediately before frame is closed
              const bitmap = await createImageBitmap(frame);
              this.state.videoFrames.push({
                pts: frame.timestamp, // in microseconds
                imageBitmap: bitmap,
                luma: 0 // Calculated later
              });
              frame.close();
              
              framesDecoded++;
              this.updateProgress(`Decoding Video Frames (${framesDecoded}/${totalFrames})...`, 30 + (framesDecoded/totalFrames)*50);
              
              if (framesDecoded >= totalFrames) {
                resolve();
              }
            },
            error: (e) => reject(new Error("VideoDecoder Error: " + e.message))
          });

          // Configuration requires codec string (e.g., avc1.42E01E)
          // Simplified setup. Real implementation needs avcc/hvcc parsing.
          decoder.configure({
            codec: videoTrack.codec,
            codedWidth: videoTrack.video.width,
            codedHeight: videoTrack.video.height,
          });

          mp4boxfile.setExtractionOptions(videoTrack.id);
          mp4boxfile.start();
        };

        mp4boxfile.onSamples = (id, user, samples) => {
          for (const sample of samples) {
            const chunk = new EncodedVideoChunk({
              type: sample.is_sync ? 'key' : 'delta',
              timestamp: (sample.cts * 1000000) / sample.timescale,
              duration: (sample.duration * 1000000) / sample.timescale,
              data: sample.data
            });
            decoder.decode(chunk);
          }
        };

        // Feed buffer to mp4box
        buffer.fileStart = 0;
        mp4boxfile.appendBuffer(buffer);
        mp4boxfile.flush();
      });
    }

    analyzeLatency() {
      // 1. Calculate Luma for ROI in all frames
      // To simulate, we just sample the center of the image
      const tempCanvas = document.createElement('canvas');
      const ctx = tempCanvas.getContext('2d', { willReadFrequently: true });
      
      // Sort frames by PTS
      this.state.videoFrames.sort((a,b) => a.pts - b.pts);
      
      let maxDelta = 0;
      let flashTimeMs = 0;
      let prevLuma = 0;

      for (let i = 0; i < this.state.videoFrames.length; i++) {
        const frame = this.state.videoFrames[i];
        
        // Setup downsampled canvas for speed
        tempCanvas.width = 64;
        tempCanvas.height = 64;
        
        ctx.drawImage(frame.imageBitmap, 0, 0, 64, 64);
        const imgData = ctx.getImageData(0, 0, 64, 64).data;
        
        // Calculate average Luma (Y = 0.299R + 0.587G + 0.114B)
        let lumaSum = 0;
        for (let j = 0; j < imgData.length; j += 4) {
          lumaSum += (0.299 * imgData[j] + 0.587 * imgData[j+1] + 0.114 * imgData[j+2]);
        }
        frame.luma = lumaSum / (64*64);
        
        if (i > 0) {
          const delta = Math.abs(frame.luma - prevLuma);
          if (delta > maxDelta && frame.pts > (this.state.clickTimeMs * 1000)) { // Flash must happen after click
            maxDelta = delta;
            flashTimeMs = frame.pts / 1000;
          }
        }
        prevLuma = frame.luma;
      }

      this.state.flashTimeMs = flashTimeMs;

      // Update UI
      if (this.state.clickTimeMs && this.state.flashTimeMs) {
        const latency = (this.state.flashTimeMs - this.state.clickTimeMs).toFixed(1);
        this.resultLatency.textContent = latency;
        
        // Dispatch to Sidebar Metrics
        const updateSidebar = (id, val, status) => {
          const el = document.querySelector(`[data-metric-id="${id}"]`);
          if (el) {
            el.querySelector('.metric-value').textContent = val;
            el.setAttribute('data-status', status);
          }
        };
        updateSidebar('audio-click', this.state.clickTimeMs.toFixed(1), 'pass');
        updateSidebar('video-flash', this.state.flashTimeMs.toFixed(1), 'pass');
        updateSidebar('delta-e2e', latency, 'pass');

        const statusEl = document.querySelector('[data-status-label]');
        if (statusEl) {
          statusEl.textContent = "ANALYSIS COMPLETE";
          document.querySelector('[data-status-card]').setAttribute('data-status', 'pass');
        }
      }
    }

    drawWaveforms() {
      // Draw Audio
      const aCanvas = this.audioWaveformCanvas;
      const aCtx = aCanvas.getContext('2d');
      aCanvas.width = aCanvas.clientWidth;
      aCanvas.height = aCanvas.clientHeight;
      
      aCtx.clearRect(0,0, aCanvas.width, aCanvas.height);
      aCtx.strokeStyle = '#eab308'; // yellow-500
      aCtx.lineWidth = 1;
      
      const step = Math.ceil(this.state.audioData.length / aCanvas.width);
      const amp = aCanvas.height / 2;
      
      aCtx.beginPath();
      for (let i = 0; i < aCanvas.width; i++) {
        let min = 1.0;
        let max = -1.0;
        for (let j = 0; j < step; j++) {
          const datum = this.state.audioData[(i*step)+j];
          if (datum < min) min = datum;
          if (datum > max) max = datum;
        }
        aCtx.moveTo(i, (1+min)*amp);
        aCtx.lineTo(i, (1+max)*amp);
      }
      aCtx.stroke();

      // Position Audio Marker
      if (this.state.clickTimeMs) {
        const clickRatio = this.state.clickTimeMs / this.state.durationMs;
        this.audioMarker.style.left = `${clickRatio * 100}%`;
        this.audioMarker.classList.remove('hidden');
      }

      // Draw Luma
      const vCanvas = this.videoLumaCanvas;
      const vCtx = vCanvas.getContext('2d');
      vCanvas.width = vCanvas.clientWidth;
      vCanvas.height = vCanvas.clientHeight;
      
      vCtx.clearRect(0,0, vCanvas.width, vCanvas.height);
      vCtx.strokeStyle = '#38bdf8'; // sky-400
      vCtx.lineWidth = 2;
      
      vCtx.beginPath();
      let maxLuma = Math.max(...this.state.videoFrames.map(f => f.luma));
      if (maxLuma === 0) maxLuma = 1;

      this.state.videoFrames.forEach((frame, i) => {
        const x = (frame.pts / 1000 / this.state.durationMs) * vCanvas.width;
        const y = vCanvas.height - ((frame.luma / maxLuma) * vCanvas.height);
        if (i === 0) vCtx.moveTo(x, y);
        else vCtx.lineTo(x, y);
      });
      vCtx.stroke();

      // Position Video Marker
      if (this.state.flashTimeMs) {
        const flashRatio = this.state.flashTimeMs / this.state.durationMs;
        this.videoMarker.style.left = `${flashRatio * 100}%`;
        this.videoMarker.classList.remove('hidden');
      }

      document.getElementById('timeline-duration').textContent = `${this.state.durationMs.toFixed(0)}ms`;
    }
  }

  // Initialize on load
  if (typeof document !== 'undefined') {
    window.addEventListener('DOMContentLoaded', () => {
      new E2eLatencyAnalyzer();
    });
  }
</script>
