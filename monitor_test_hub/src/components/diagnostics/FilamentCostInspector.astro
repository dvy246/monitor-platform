---
import { FilamentCostEngine } from '../../engine/FilamentCostEngine';

interface Props {
  initialMaterialId?: string;
  initialWeightGrams?: number;
  initialTimeHours?: number;
}

const { initialMaterialId = 'pla', initialWeightGrams = 150, initialTimeHours = 6 } = Astro.props;

const materials = FilamentCostEngine.MATERIALS;
const initialResult = FilamentCostEngine.calculateCost(initialMaterialId, initialWeightGrams, initialTimeHours);
---

<div class="w-full max-w-5xl mx-auto p-4 md:p-6 bg-[#121215] border border-white/10 rounded-2xl shadow-2xl text-slate-100 font-sans">
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-6 border-b border-white/10">
    <div>
      <div class="flex items-center gap-2 text-purple-400 text-xs font-mono uppercase tracking-widest mb-1">
        <svg class="w-4 h-4 text-purple-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
        </svg>
        <span>Additive Manufacturing Estimator</span>
      </div>
      <h2 class="text-2xl md:text-3xl font-black text-white tracking-tight">3D Print Cost &amp; Material Estimator</h2>
      <p class="text-sm text-slate-400 mt-1">Material density, power consumption, failure cushion &amp; Etsy commercial pricing.</p>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mt-6">
    <div class="space-y-4 bg-black/30 p-5 rounded-xl border border-white/5">
      <div>
        <label class="flex items-center gap-1.5 text-xs font-mono uppercase text-slate-400 mb-2">
          <svg class="w-4 h-4 text-purple-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
          </svg>
          <span>Filament Material</span>
        </label>
        <select id="material-select" class="w-full bg-[#18181b] border border-white/10 rounded-lg p-2.5 text-sm text-white focus:border-purple-500 focus:outline-none cursor-pointer">
          {materials.map(mat => (
            <option value={mat.id} selected={mat.id === initialMaterialId}>
              {mat.name} (${mat.typicalSpoolPriceUsd}/1kg)
            </option>
          ))}
        </select>
      </div>

      <div>
        <label class="flex items-center gap-1.5 text-xs font-mono uppercase text-slate-400 mb-2">
          <svg class="w-4 h-4 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3" />
          </svg>
          <span>Print Weight (Grams)</span>
        </label>
        <input id="weight-input" type="number" value={initialWeightGrams} min="1" max="5000" class="w-full bg-[#18181b] border border-white/10 rounded-lg p-2.5 text-sm text-white focus:border-purple-500 focus:outline-none" />
      </div>

      <div>
        <label class="flex items-center gap-1.5 text-xs font-mono uppercase text-slate-400 mb-2">
          <svg class="w-4 h-4 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span>Print Time (Hours)</span>
        </label>
        <input id="time-input" type="number" value={initialTimeHours} min="0.5" max="100" step="0.5" class="w-full bg-[#18181b] border border-white/10 rounded-lg p-2.5 text-sm text-white focus:border-purple-500 focus:outline-none" />
      </div>
    </div>

    <div class="lg:col-span-2 space-y-6">
      <div class="bg-black/40 p-6 rounded-xl border border-white/5 grid grid-cols-1 sm:grid-cols-2 gap-4 text-center">
        <div class="bg-[#18181b] p-5 rounded-xl border border-white/5">
          <div class="text-xs text-slate-400 font-mono uppercase flex items-center justify-center gap-1.5">
            <svg class="w-4 h-4 text-purple-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
            </svg>
            <span>Direct Production Cost</span>
          </div>
          <div class="text-3xl font-black text-purple-400 mt-2">{initialResult.formattedDirectCost}</div>
          <div class="text-xs text-slate-500 mt-1">Filament (${initialResult.filamentCostUsd}) + Power (${initialResult.electricityCostUsd})</div>
        </div>

        <div class="bg-[#18181b] p-5 rounded-xl border border-white/5">
          <div class="text-xs text-slate-400 font-mono uppercase flex items-center justify-center gap-1.5">
            <svg class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
            </svg>
            <span>Suggested Retail Price (Etsy)</span>
          </div>
          <div class="text-3xl font-black text-emerald-400 mt-2">{initialResult.formattedRetailPrice}</div>
          <div class="text-xs text-slate-500 mt-1">Profit Margin: ${initialResult.profitMarginUsd}</div>
        </div>
      </div>

      <p class="text-xs text-slate-300 leading-relaxed bg-black/20 p-4 rounded-lg border border-white/5">
        {initialResult.explanation}
      </p>
    </div>
  </div>
</div>
