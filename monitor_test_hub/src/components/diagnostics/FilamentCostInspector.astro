---
import { FilamentCostEngine } from '../../engine/FilamentCostEngine';

interface Props {
  initialMaterialId?: string;
  initialWeightGrams?: number;
  initialTimeHours?: number;
}

const { initialMaterialId = 'pla', initialWeightGrams = 150, initialTimeHours = 6 } = Astro.props;

const materials = FilamentCostEngine.MATERIALS;
const initialResult = FilamentCostEngine.calculateCost(initialMaterialId, initialWeightGrams, initialTimeHours);
---

<div class="w-full max-w-7xl mx-auto space-y-6 font-sans select-none min-w-0" id="filament-cost-root">
  <div class="relative bg-[#0c0d12]/95 border border-zinc-800/90 rounded-3xl p-4 sm:p-8 backdrop-blur-2xl shadow-[0_25px_60px_rgba(0,0,0,0.8)] space-y-6 overflow-hidden min-w-0 text-zinc-100">
    <!-- Ambient Glows -->
    <div class="absolute -top-24 -right-24 w-96 h-96 bg-purple-500/10 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-24 -left-24 w-96 h-96 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none"></div>

    <!-- Header Controls -->
    <div class="relative z-10 flex flex-col md:flex-row items-start md:items-center justify-between gap-4 border-b border-zinc-800/70 pb-5">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-purple-500/10 border border-purple-500/30 text-[11px] font-mono text-purple-400 font-bold uppercase tracking-wider mb-2">
          <span class="w-2 h-2 rounded-full bg-purple-400 shadow-[0_0_8px_rgba(192,132,252,0.9)] animate-pulse"></span>
          <span>ADDITIVE MANUFACTURING PRICING ENGINE</span>
        </div>
        <h2 class="text-xl sm:text-3xl font-extrabold font-mono text-white tracking-tight">3D Print Cost &amp; Material Estimator</h2>
        <p class="text-xs sm:text-sm text-zinc-400 mt-1">Material density, power consumption, failure cushion &amp; Etsy commercial pricing.</p>
      </div>
    </div>

    <div class="relative z-10 grid grid-cols-1 lg:grid-cols-3 gap-6">
      <!-- Input Controls Deck -->
      <div class="space-y-5 bg-zinc-950/80 p-5 sm:p-6 rounded-2xl border border-zinc-800/80 shadow-inner font-mono text-xs">
        <div>
          <label class="flex items-center gap-1.5 font-bold uppercase text-zinc-400 mb-2">
            <svg class="w-4 h-4 text-purple-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
            </svg>
            <span>Filament Material</span>
          </label>
          <select id="material-select" class="w-full bg-zinc-900 border border-zinc-700/80 rounded-xl p-3 text-sm text-white focus:border-purple-500 focus:outline-none cursor-pointer">
            {materials.map(mat => (
              <option value={mat.id} selected={mat.id === initialMaterialId}>
                {mat.name} (${mat.typicalSpoolPriceUsd}/1kg)
              </option>
            ))}
          </select>
        </div>

        <div>
          <label class="flex items-center gap-1.5 font-bold uppercase text-zinc-400 mb-2">
            <svg class="w-4 h-4 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3" />
            </svg>
            <span>Print Weight (Grams)</span>
          </label>
          <input id="weight-input" type="number" value={initialWeightGrams} min="1" max="5000" class="w-full bg-zinc-900 border border-zinc-700/80 rounded-xl p-3 text-sm text-white focus:border-purple-500 focus:outline-none" />
        </div>

        <div>
          <label class="flex items-center gap-1.5 font-bold uppercase text-zinc-400 mb-2">
            <svg class="w-4 h-4 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span>Print Duration (Hours)</span>
          </label>
          <input id="time-input" type="number" value={initialTimeHours} min="0.5" max="100" step="0.5" class="w-full bg-zinc-900 border border-zinc-700/80 rounded-xl p-3 text-sm text-white focus:border-purple-500 focus:outline-none" />
        </div>
      </div>

      <!-- Cost & Pricing Metrics -->
      <div class="lg:col-span-2 space-y-5">
        <div class="bg-zinc-950/80 p-5 sm:p-6 rounded-2xl border border-zinc-800/80 grid grid-cols-1 sm:grid-cols-2 gap-4 text-center font-mono shadow-inner">
          <div class="bg-zinc-900/90 p-5 rounded-xl border border-zinc-800 space-y-1">
            <div class="text-xs text-zinc-400 uppercase font-bold flex items-center justify-center gap-1.5">
              <svg class="w-4 h-4 text-purple-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
              </svg>
              <span>Direct Production Cost</span>
            </div>
            <div class="text-3xl sm:text-4xl font-extrabold text-purple-400 mt-2 tabular-nums">{initialResult.formattedDirectCost}</div>
            <div class="text-[11px] text-zinc-500 mt-1">Filament (${initialResult.filamentCostUsd}) + Power (${initialResult.electricityCostUsd})</div>
          </div>

          <div class="bg-zinc-900/90 p-5 rounded-xl border border-zinc-800 space-y-1">
            <div class="text-xs text-zinc-400 uppercase font-bold flex items-center justify-center gap-1.5">
              <svg class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
              </svg>
              <span>Suggested Retail Price (Etsy)</span>
            </div>
            <div class="text-3xl sm:text-4xl font-extrabold text-emerald-400 mt-2 tabular-nums">{initialResult.formattedRetailPrice}</div>
            <div class="text-[11px] text-zinc-500 mt-1">Net Profit Margin: ${initialResult.profitMarginUsd}</div>
          </div>
        </div>

        <p id="cost-desc" class="text-xs text-zinc-300 leading-relaxed bg-zinc-950/80 p-5 rounded-2xl border border-zinc-800/80 font-sans shadow-inner">
          {initialResult.explanation}
        </p>
      </div>
    </div>
  </div>
</div>
