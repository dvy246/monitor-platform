---
// FrequencyGeneratorCanvas.astro — World-Class Frequency Generator & Oscilloscope
export interface Props {
  initialFreq?: number;
}

const { initialFreq = 440 } = Astro.props;
---

<div class="frequency-generator-container w-full max-w-4xl mx-auto space-y-6 font-sans select-none">
  
  <!-- Interactive Frequency Finder Wizard Banner -->
  <div class="p-4 sm:p-5 rounded-3xl border flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 shadow-specular-top" style="background:linear-gradient(135deg,rgba(0,229,160,0.06) 0%,rgba(77,159,255,0.06) 50%,rgba(0,229,160,0.04) 100%);border-color:rgba(0,229,160,0.25)">
    <div class="space-y-1">
      <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-[rgba(0,229,160,0.08)] border border-[rgba(0,229,160,0.25)] text-status-pass font-mono text-[10px] font-bold uppercase tracking-wider">
        <span class="w-1.5 h-1.5 rounded-full bg-status-pass led-glow-pass animate-pulse"></span>
        AI Frequency Recommendation Wizard
      </div>
      <h3 class="text-base sm:text-lg font-extrabold text-text-primary font-mono tracking-tight">Need help picking the best frequency?</h3>
      <p class="text-xs text-text-secondary leading-relaxed">Answer 3 quick questions about your goal and environment to automatically configure the perfect frequency and waveform.</p>
    </div>
    <button
      id="fg-open-wizard-btn"
      type="button"
      class="btn-primary shrink-0 cursor-pointer"
    >
      <span>✨ Find My Frequency</span>
      <span class="font-sans">&rarr;</span>
    </button>
  </div>

  <!-- Main Display Card -->
  <div class="relative overflow-hidden rounded-3xl bg-bg-surface border border-border-hairline p-6 sm:p-8 shadow-specular-top space-y-6">
    
    <!-- Top Header & LED Status -->
    <div class="flex items-center justify-between border-b border-border-hairline/60 pb-4">
      <div class="flex items-center gap-2.5">
        <span id="fg-led" class="w-3 h-3 rounded-full bg-zinc-600 shadow-[0_0_10px_rgba(255,255,255,0.2)] transition-all"></span>
        <h2 class="text-base sm:text-lg font-extrabold text-text-primary font-mono tracking-tight">Frequency Generator</h2>
      </div>
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-bg-canvas border border-border-hairline font-mono text-xs text-text-muted">
        <span id="fg-engine-status">WEB AUDIO API • 64-BIT SYNTH</span>
      </div>
    </div>

    <!-- Oscilloscope Real-Time Waveform Canvas -->
    <div class="relative w-full h-44 sm:h-52 rounded-2xl bg-[#08080a] border border-border-hairline overflow-hidden shadow-inner flex items-center justify-center group">
      <canvas id="fg-oscilloscope-canvas" class="w-full h-full block opacity-90"></canvas>
      
      <!-- Overlay Reticle & Grid Lines -->
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,transparent_0%,rgba(8,8,10,0.6)_100%)] pointer-events-none"></div>
      <div class="absolute inset-0 border border-white/5 pointer-events-none"></div>

      <!-- Scope HUD Telemetry -->
      <div class="absolute top-3 left-3 flex items-center gap-2 text-[11px] font-mono bg-bg-surface/80 backdrop-blur-md border border-border-hairline px-3 py-1 rounded-lg text-text-primary shadow-xs pointer-events-none">
        <span id="hud-waveform-label" class="text-status-pass font-bold">SINE WAVE</span>
        <span>•</span>
        <span id="hud-thd-label" class="text-text-muted">&lt; 0.001% THD</span>
      </div>

      <div class="absolute top-3 right-3 text-[10px] font-mono bg-bg-surface/80 backdrop-blur-md border border-border-hairline px-2.5 py-1 rounded-lg text-text-muted pointer-events-none">
        48,000 Hz REAL-TIME SCOPE
      </div>
    </div>

    <!-- Readout Deck: Giant Frequency Value & Musical Note Heuristic -->
    <div class="text-center space-y-1 py-2">
      <div class="flex items-baseline justify-center gap-2">
        <span id="fg-big-readout" class="text-5xl sm:text-7xl font-extrabold text-status-pass font-mono tracking-tight" style="text-shadow:0 0 25px rgba(0,229,160,0.4)">
          {initialFreq}
        </span>
        <span class="text-xl sm:text-2xl font-bold text-text-secondary font-mono">Hz</span>
      </div>
      <div id="fg-note-label" class="text-xs sm:text-sm font-mono font-medium text-text-muted tracking-wider">
        A4 - Concert Pitch Standard
      </div>
    </div>

    <!-- Waveform Type Selector Cards -->
    <div class="space-y-2">
      <label class="block text-xs font-mono font-bold uppercase tracking-wider text-text-muted">Select Waveform</label>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3" id="fg-waveform-group">
        
        <!-- Sine Card -->
        <button type="button" data-waveform="sine" class="fg-wf-btn active p-3 rounded-2xl border-2 text-status-pass flex flex-col items-center gap-1.5 transition-all cursor-pointer hover:scale-[1.02] shadow-sm" style="background:rgba(0,229,160,0.08);border-color:#00e5a0">
          <svg class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 12c3-8 6-8 9 0s6 8 9 0" stroke-linecap="round"/></svg>
          <span class="font-bold font-mono text-xs">Sine</span>
        </button>

        <!-- Square Card -->
        <button type="button" data-waveform="square" class="fg-wf-btn p-3 rounded-2xl bg-bg-canvas border-2 border-border-hairline text-text-secondary flex flex-col items-center gap-1.5 transition-all cursor-pointer hover:scale-[1.02] hover:border-white/20">
          <svg class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 17V7h6v10h6V7h6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span class="font-bold font-mono text-xs">Square</span>
        </button>

        <!-- Triangle Card -->
        <button type="button" data-waveform="triangle" class="fg-wf-btn p-3 rounded-2xl bg-bg-canvas border-2 border-border-hairline text-text-secondary flex flex-col items-center gap-1.5 transition-all cursor-pointer hover:scale-[1.02] hover:border-white/20">
          <svg class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 17l6-10 6 10 6-10" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span class="font-bold font-mono text-xs">Triangle</span>
        </button>

        <!-- Sawtooth Card -->
        <button type="button" data-waveform="sawtooth" class="fg-wf-btn p-3 rounded-2xl bg-bg-canvas border-2 border-border-hairline text-text-secondary flex flex-col items-center gap-1.5 transition-all cursor-pointer hover:scale-[1.02] hover:border-white/20">
          <svg class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 17l9-10v10l9-10v10" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span class="font-bold font-mono text-xs">Sawtooth</span>
        </button>

      </div>
    </div>

    <!-- Master Frequency Slider & Precision Number Input -->
    <div class="space-y-3 p-4 rounded-2xl bg-bg-canvas border border-border-hairline">
      <div class="flex items-center justify-between">
        <label for="fg-num-input" class="text-xs font-mono font-bold uppercase tracking-wider text-text-muted">Target Frequency</label>
        <div class="flex items-center gap-2">
          <!-- Octave Adjusters -->
          <button id="btn-octave-down" title="Half Frequency (Octave Down)" class="px-2 py-1 rounded-lg bg-bg-surface border border-border-hairline text-text-secondary font-mono text-xs font-bold hover:text-white transition-colors">÷2</button>
          <button id="btn-octave-up" title="Double Frequency (Octave Up)" class="px-2 py-1 rounded-lg bg-bg-surface border border-border-hairline text-text-secondary font-mono text-xs font-bold hover:text-white transition-colors">×2</button>
          
          <div class="relative flex items-center">
            <input
              id="fg-num-input"
              type="number"
              min="1"
              max="20000"
              value={initialFreq}
              class="w-24 px-3 py-1.5 rounded-xl bg-bg-surface border border-border-hairline text-right font-mono font-bold text-status-pass text-sm focus:outline-none focus:border-status-pass"
            />
            <span class="ml-1 text-xs font-mono text-text-muted">Hz</span>
          </div>
        </div>
      </div>

      <!-- Frequency Range Slider -->
      <div class="space-y-1">
        <input
          id="fg-slider"
          type="range"
          min="1"
          max="20000"
          step="1"
          value={initialFreq}
          class="w-full h-2 rounded-lg bg-bg-surface cursor-pointer accent-[#00e5a0]"
        />
        <div class="flex justify-between text-[10px] font-mono text-text-muted">
          <span>1 Hz (Infrasound)</span>
          <span>1,000 Hz</span>
          <span>20,000 Hz (Ultrasound)</span>
        </div>
      </div>

      <!-- Fine-Tuning Micro Step Buttons -->
      <div class="flex items-center justify-center gap-2 pt-1">
        <button data-step="-10" class="fg-step-btn px-2.5 py-1 rounded-lg bg-bg-surface border border-border-hairline text-text-secondary font-mono text-xs hover:text-white transition-colors">-10 Hz</button>
        <button data-step="-1" class="fg-step-btn px-2.5 py-1 rounded-lg bg-bg-surface border border-border-hairline text-text-secondary font-mono text-xs hover:text-white transition-colors">-1 Hz</button>
        <button data-step="+1" class="fg-step-btn px-2.5 py-1 rounded-lg bg-bg-surface border border-border-hairline text-text-secondary font-mono text-xs hover:text-white transition-colors">+1 Hz</button>
        <button data-step="+10" class="fg-step-btn px-2.5 py-1 rounded-lg bg-bg-surface border border-border-hairline text-text-secondary font-mono text-xs hover:text-white transition-colors">+10 Hz</button>
      </div>
    </div>

    <!-- Master Play Tone Button -->
    <button
      id="fg-btn-play"
      type="button"
      class="w-full py-4 rounded-2xl font-extrabold font-mono text-lg transition-all transform active:scale-[0.99] flex items-center justify-center gap-3 cursor-pointer btn-primary"
    >
      <svg id="fg-play-icon" class="w-6 h-6 fill-current" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
      <svg id="fg-pause-icon" class="w-6 h-6 fill-current hidden" viewBox="0 0 24 24"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>
      <span id="fg-play-label">Play Tone</span>
    </button>

    <!-- Volume & Balance Controls Deck -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
      <!-- Volume Slider -->
      <div class="p-3.5 rounded-2xl bg-bg-canvas border border-border-hairline space-y-2">
        <div class="flex items-center justify-between text-xs font-mono font-bold">
          <span class="text-text-muted">MASTER VOLUME</span>
          <span id="fg-vol-val" class="text-status-pass font-bold">50%</span>
        </div>
        <div class="flex items-center gap-3">
          <button id="fg-btn-mute" type="button" class="text-text-muted hover:text-white transition-colors">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z"/></svg>
          </button>
          <input
            id="fg-vol-slider"
            type="range"
            min="0"
            max="100"
            value="50"
            class="w-full h-2 rounded-lg bg-bg-surface cursor-pointer accent-[#00e5a0]"
          />
        </div>
      </div>

      <!-- Stereo Channel Balance -->
      <div class="p-3.5 rounded-2xl bg-bg-canvas border border-border-hairline space-y-2">
        <div class="flex items-center justify-between text-xs font-mono font-bold">
          <span class="text-text-muted">STEREO BALANCE</span>
          <span id="fg-pan-val" class="text-indigo-400">CENTER</span>
        </div>
        <input
          id="fg-pan-slider"
          type="range"
          min="-1"
          max="1"
          step="0.05"
          value="0"
          class="w-full h-2 rounded-lg bg-bg-surface cursor-pointer accent-indigo-400"
        />
      </div>
    </div>

    <!-- Brainwave Focus Frequencies Deck -->
    <div class="p-4 sm:p-5 rounded-2xl bg-indigo-500/10 border border-indigo-500/30 space-y-3">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-2">
          <span class="text-base">🧠</span>
          <h3 class="font-bold font-mono text-sm text-indigo-300">Brainwave Focus Frequencies (Study &amp; Deep Work)</h3>
        </div>
        <span class="text-[10px] font-mono font-bold bg-indigo-500/20 text-indigo-300 px-2 py-0.5 rounded-full border border-indigo-500/30">Headphones Recommended</span>
      </div>

      <!-- Brainwave Wave Cards -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
        
        <!-- Beta Waves -->
        <button type="button" data-freq="20" data-note="Beta Wave (20 Hz) - Deep Work & Studying" class="fg-preset-btn p-3 rounded-xl bg-bg-surface border border-border-hairline hover:border-indigo-500/50 text-left transition-all group">
          <div class="flex items-center justify-between mb-1">
            <span class="font-bold font-mono text-xs text-indigo-400 group-hover:text-indigo-300">Beta Waves</span>
            <span class="text-[11px] font-mono font-bold text-text-muted">14–30 Hz</span>
          </div>
          <p class="text-[11px] text-text-secondary leading-snug">Ideal for active studying, deep work, and analytical thinking. Keeps your brain in "traffic controller" mode.</p>
        </button>

        <!-- Gamma Waves -->
        <button type="button" data-freq="40" data-note="Gamma Wave (40 Hz) - Rapid Learning & Cognition" class="fg-preset-btn p-3 rounded-xl bg-bg-surface border border-border-hairline hover:border-cyan-500/50 text-left transition-all group">
          <div class="flex items-center justify-between mb-1">
            <span class="font-bold font-mono text-xs text-cyan-400 group-hover:text-cyan-300">Gamma Waves</span>
            <span class="text-[11px] font-mono font-bold text-text-muted">40 Hz</span>
          </div>
          <p class="text-[11px] text-text-secondary leading-snug">Excellent for advanced cognition, rapid learning, and memory consolidation. Best for intense focus.</p>
        </button>

        <!-- Alpha Waves -->
        <button type="button" data-freq="10" data-note="Alpha Wave (10 Hz) - Relaxed Creative Alertness" class="fg-preset-btn p-3 rounded-xl bg-bg-surface border border-border-hairline hover:border-emerald-500/50 text-left transition-all group">
          <div class="flex items-center justify-between mb-1">
            <span class="font-bold font-mono text-xs text-emerald-400 group-hover:text-emerald-300">Alpha Waves</span>
            <span class="text-[11px] font-mono font-bold text-text-muted">8–13 Hz</span>
          </div>
          <p class="text-[11px] text-text-secondary leading-snug">Best for creative problem-solving and relaxed alertness rather than purely analytical tasks.</p>
        </button>

      </div>

      <!-- How To Use Binaural Beats Banner -->
      <div class="p-3 rounded-xl bg-bg-canvas border border-border-hairline/80 text-[11px] text-text-secondary leading-relaxed flex items-start gap-2.5">
        <span class="text-indigo-400 text-sm shrink-0 font-bold mt-0.5">🎧</span>
        <div>
          <strong class="text-text-primary font-mono font-bold block mb-0.5">How Binaural Focus Beats Work:</strong>
          To hear binaural beats properly, listen with stereo headphones. The generator plays a slightly different carrier tone in each ear (e.g. 200 Hz Left vs 220 Hz Right), and your brain perceives the difference as a 20 Hz focus-inducing frequency.
        </div>
      </div>
    </div>

    <!-- Quick Presets Deck -->
    <div class="space-y-2 pt-2">
      <label class="block text-xs font-mono font-bold uppercase tracking-wider text-text-muted">Popular Audio Presets</label>
      <div class="flex flex-wrap gap-2" id="fg-presets-group">
        <button data-freq="165" data-note="Water Eject Tone" class="fg-preset-btn px-3 py-1.5 rounded-xl bg-bg-canvas border border-border-hairline text-text-secondary font-mono text-xs hover:border-cyan-500/50 hover:text-cyan-300 transition-all">
          💧 165 Hz <span class="text-[10px] text-text-muted">Water Eject</span>
        </button>
        <button data-freq="432" data-note="Verdi Solfeggio Pitch" class="fg-preset-btn px-3 py-1.5 rounded-xl bg-bg-canvas border border-border-hairline text-text-secondary font-mono text-xs hover:border-cyan-500/50 hover:text-cyan-300 transition-all">
          ✨ 432 Hz
        </button>
        <button data-freq="440" data-note="A4 - Concert Pitch" class="fg-preset-btn active px-3 py-1.5 rounded-xl bg-cyan-500/20 border border-cyan-500 text-cyan-300 font-bold font-mono text-xs transition-all">
          🎵 440 Hz <span class="text-[10px] text-cyan-400">A4</span>
        </button>
        <button data-freq="528" data-note="Transformation Solfeggio" class="fg-preset-btn px-3 py-1.5 rounded-xl bg-bg-canvas border border-border-hairline text-text-secondary font-mono text-xs hover:border-cyan-500/50 hover:text-cyan-300 transition-all">
          🌿 528 Hz
        </button>
        <button data-freq="1000" data-note="Reference Audio Standard" class="fg-preset-btn px-3 py-1.5 rounded-xl bg-bg-canvas border border-border-hairline text-text-secondary font-mono text-xs hover:border-cyan-500/50 hover:text-cyan-300 transition-all">
          🔊 1 kHz
        </button>
        <button data-freq="60" data-note="Sub-Bass Test" class="fg-preset-btn px-3 py-1.5 rounded-xl bg-bg-canvas border border-border-hairline text-text-secondary font-mono text-xs hover:border-cyan-500/50 hover:text-cyan-300 transition-all">
          🎧 60 Hz <span class="text-[10px] text-text-muted">Sub-Bass</span>
        </button>
        <button data-freq="15000" data-note="High Frequency Hearing" class="fg-preset-btn px-3 py-1.5 rounded-xl bg-bg-canvas border border-border-hairline text-text-secondary font-mono text-xs hover:border-cyan-500/50 hover:text-cyan-300 transition-all">
          👂 15 kHz <span class="text-[10px] text-text-muted">High Pitch</span>
        </button>
      </div>
    </div>

  </div>

  <!-- Interactive 3-Step Frequency Finder Modal -->
  <div id="fg-wizard-modal" class="fixed inset-0 z-50 bg-black/80 backdrop-blur-xl flex items-center justify-center p-4 hidden opacity-0 transition-opacity duration-300">
    <div class="relative w-full max-w-xl bg-bg-surface border border-border-hairline rounded-3xl p-6 sm:p-8 shadow-2xl space-y-6 overflow-hidden">
      
      <!-- Modal Close Button -->
      <button id="fg-wizard-close" type="button" class="absolute top-5 right-5 text-text-muted hover:text-text-primary p-2 rounded-full hover:bg-bg-elevated transition-colors">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>

      <!-- Step Progress Header -->
      <div class="space-y-2 border-b border-border-hairline/60 pb-4">
        <div class="flex items-center justify-between text-xs font-mono font-bold text-cyan-400">
          <span id="fg-wiz-step-badge">STEP 1 OF 3</span>
          <span class="text-text-muted">15-SECOND GUIDE</span>
        </div>
        <h3 id="fg-wiz-title" class="text-xl font-extrabold text-text-primary font-mono">What is your primary goal today?</h3>
        <p id="fg-wiz-subtitle" class="text-xs text-text-secondary">We will calculate the optimal frequency and waveform tailored to your needs.</p>
      </div>

      <!-- Step 1 Options: Primary Goal -->
      <div id="fg-wiz-step-1" class="wiz-step-panel space-y-3">
        <button type="button" data-goal="beta" class="wiz-opt-btn w-full p-3.5 rounded-2xl bg-bg-canvas border border-border-hairline hover:border-cyan-500/50 text-left transition-all flex items-center justify-between group">
          <div class="flex items-center gap-3">
            <span class="text-xl text-indigo-400"><svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/></svg></span>
            <div>
              <strong class="font-bold text-sm text-text-primary group-hover:text-cyan-300 block">Deep Work &amp; Studying</strong>
              <span class="text-xs text-text-muted">Beta Waves (20 Hz) • Reduce Distractions</span>
            </div>
          </div>
          <span class="text-cyan-400 text-xs font-mono font-bold">&rarr;</span>
        </button>

        <button type="button" data-goal="gamma" class="wiz-opt-btn w-full p-3.5 rounded-2xl bg-bg-canvas border border-border-hairline hover:border-cyan-500/50 text-left transition-all flex items-center justify-between group">
          <div class="flex items-center gap-3">
            <span class="text-xl text-cyan-400"><svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg></span>
            <div>
              <strong class="font-bold text-sm text-text-primary group-hover:text-cyan-300 block">Intense Memory &amp; Rapid Learning</strong>
              <span class="text-xs text-text-muted">Gamma Waves (40 Hz) • High Cognition</span>
            </div>
          </div>
          <span class="text-cyan-400 text-xs font-mono font-bold">&rarr;</span>
        </button>

        <button type="button" data-goal="alpha" class="wiz-opt-btn w-full p-3.5 rounded-2xl bg-bg-canvas border border-border-hairline hover:border-cyan-500/50 text-left transition-all flex items-center justify-between group">
          <div class="flex items-center gap-3">
            <span class="text-xl text-emerald-400"><svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"/></svg></span>
            <div>
              <strong class="font-bold text-sm text-text-primary group-hover:text-cyan-300 block">Creative Problem Solving</strong>
              <span class="text-xs text-text-muted">Alpha Waves (10 Hz) • Relaxed Alertness</span>
            </div>
          </div>
          <span class="text-cyan-400 text-xs font-mono font-bold">&rarr;</span>
        </button>

        <button type="button" data-goal="water" class="wiz-opt-btn w-full p-3.5 rounded-2xl bg-bg-canvas border border-border-hairline hover:border-cyan-500/50 text-left transition-all flex items-center justify-between group">
          <div class="flex items-center gap-3">
