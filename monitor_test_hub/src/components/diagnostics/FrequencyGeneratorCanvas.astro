          </div>

          <div class="space-y-1">
            <h4 id="wiz-res-freq-name" class="text-2xl font-extrabold text-white font-mono">20 Hz (Beta Wave Focus)</h4>
            <p id="wiz-res-reason" class="text-xs text-zinc-300 leading-relaxed">
              Beta waves (14-30 Hz) stimulate analytical focus and eliminate background distractions during deep work sessions.
            </p>
          </div>

          <div class="grid grid-cols-3 gap-2 pt-2 text-center font-mono text-xs">
            <div class="bg-bg-surface p-2 rounded-xl border border-border-hairline">
              <span class="text-[10px] text-text-muted block">WAVEFORM</span>
              <strong id="wiz-res-wf" class="text-cyan-400 font-bold">Sine</strong>
            </div>
            <div class="bg-bg-surface p-2 rounded-xl border border-border-hairline">
              <span class="text-[10px] text-text-muted block">VOLUME</span>
              <strong id="wiz-res-vol" class="text-emerald-400 font-bold">50%</strong>
            </div>
            <div class="bg-bg-surface p-2 rounded-xl border border-border-hairline">
              <span class="text-[10px] text-text-muted block">STEREO PAN</span>
              <strong id="wiz-res-pan" class="text-indigo-400 font-bold font-sans">Center</strong>
            </div>
          </div>
        </div>

        <button
          id="fg-wiz-apply-btn"
          type="button"
          class="w-full py-3.5 rounded-2xl bg-cyan-500 hover:bg-cyan-400 text-black font-extrabold font-mono text-sm transition-all shadow-[0_0_25px_rgba(6,182,212,0.4)] cursor-pointer flex items-center justify-center gap-2"
        >
          <span>Apply Configuration &amp; Start Tone →</span>
        </button>
      </div>

    </div>
  </div>
</div>

<script>
  // Web Audio & Oscilloscope Logic
  let audioCtx: AudioContext | null = null;
  let osc: OscillatorNode | null = null;
  let gainNode: GainNode | null = null;
  let pannerNode: StereoPannerNode | null = null;
  let analyserNode: AnalyserNode | null = null;
  let animFrameId: number | null = null;

  let isPlaying = false;
  let currentFreq = 440;
  let currentWaveform: OscillatorType = 'sine';
  let currentVolume = 0.5;
  let currentPan = 0;

  // DOM Elements
  const canvas = document.getElementById('fg-oscilloscope-canvas') as HTMLCanvasElement;
  const ctx = canvas?.getContext('2d');
  const bigReadout = document.getElementById('fg-big-readout');
  const noteLabel = document.getElementById('fg-note-label');
  const numInput = document.getElementById('fg-num-input') as HTMLInputElement;
  const slider = document.getElementById('fg-slider') as HTMLInputElement;
  const volSlider = document.getElementById('fg-vol-slider') as HTMLInputElement;
  const volVal = document.getElementById('fg-vol-val');
  const panSlider = document.getElementById('fg-pan-slider') as HTMLInputElement;
  const panVal = document.getElementById('fg-pan-val');
  const btnPlay = document.getElementById('fg-btn-play');
  const playLabel = document.getElementById('fg-play-label');
  const playIcon = document.getElementById('fg-play-icon');
  const pauseIcon = document.getElementById('fg-pause-icon');
  const led = document.getElementById('fg-led');
  const hudWaveform = document.getElementById('hud-waveform-label');

  // Pitch Note Lookup Table (A4 = 440Hz)
  const NOTE_NAMES = ['C', 'C#', 'D', 'D#', 'E', 'F', 'F#', 'G', 'G#', 'A', 'A#', 'B'];

  function getNoteInfo(freq: number): string {
    if (freq === 10) return '10 Hz - Alpha Wave (Relaxed Creative Alertness)';
    if (freq === 20) return '20 Hz - Beta Wave (Deep Work, Studying & Focus)';
    if (freq === 40) return '40 Hz - Gamma Wave (Advanced Cognition & Rapid Learning)';
    if (freq === 165) return '165 Hz - Phone Speaker Water Eject Tone';
    if (freq === 432) return '432 Hz - Verdi Solfeggio Tuning';
    if (freq === 440) return 'A4 - Concert Pitch Standard';
    if (freq === 528) return '528 Hz - Transformation Solfeggio Pitch';
    if (freq === 1000) return '1 kHz - Audio Interface Calibration Standard';
    
    // Calculate nearest musical note
    const noteNum = 12 * (Math.log2(freq / 440)) + 57; // 57 is A4 in MIDI
    const roundedMIDI = Math.round(noteNum);
    const octave = Math.floor(roundedMIDI / 12) - 1;
    const noteIndex = (roundedMIDI % 12 + 12) % 12;
    const noteName = NOTE_NAMES[noteIndex];
    
    const exactFreq = 440 * Math.pow(2, (roundedMIDI - 57) / 12);
    const centsOff = Math.round(1200 * Math.log2(freq / exactFreq));
    const centsStr = centsOff === 0 ? '' : centsOff > 0 ? ` (+${centsOff} cents)` : ` (${centsOff} cents)`;

    return `${noteName}${octave} - ${freq} Hz${centsStr}`;
  }

  function updateUI() {
    if (bigReadout) bigReadout.textContent = Math.round(currentFreq).toString();
    if (noteLabel) noteLabel.textContent = getNoteInfo(currentFreq);
    if (numInput && document.activeElement !== numInput) numInput.value = Math.round(currentFreq).toString();
    if (slider && document.activeElement !== slider) slider.value = Math.round(currentFreq).toString();
    if (volVal) volVal.textContent = `${Math.round(currentVolume * 100)}%`;
    
    if (hudWaveform) hudWaveform.textContent = `${currentWaveform.toUpperCase()} WAVE`;

    // Highlight active preset button
    document.querySelectorAll('.fg-preset-btn').forEach(btn => {
      const f = parseFloat(btn.getAttribute('data-freq') || '0');
      if (Math.abs(f - currentFreq) < 0.5) {
        btn.className = 'fg-preset-btn active px-3 py-1.5 rounded-xl bg-cyan-500/20 border border-cyan-500 text-cyan-300 font-bold font-mono text-xs transition-all';
      } else {
        btn.className = 'fg-preset-btn px-3 py-1.5 rounded-xl bg-bg-canvas border border-border-hairline text-text-secondary font-mono text-xs hover:border-cyan-500/50 hover:text-cyan-300 transition-all';
      }
    });
  }

  function setFrequency(freq: number) {
    currentFreq = Math.max(1, Math.min(20000, freq));
    if (osc) {
      osc.frequency.setTargetAtTime(currentFreq, audioCtx?.currentTime || 0, 0.01);
    }
    updateUI();
  }

  function setupWebAudio() {
    if (audioCtx) return;
    const AudioCtxClass = window.AudioContext || (window as any).webkitAudioContext;
    audioCtx = new AudioCtxClass();

    analyserNode = audioCtx.createAnalyser();
    analyserNode.fftSize = 1024;

    gainNode = audioCtx.createGain();
    gainNode.gain.value = currentVolume;

    pannerNode = audioCtx.createStereoPanner ? audioCtx.createStereoPanner() : null;
    if (pannerNode) pannerNode.pan.value = currentPan;

    // Connect chain
    if (pannerNode) {
      gainNode.connect(pannerNode);
      pannerNode.connect(analyserNode);
    } else {
      gainNode.connect(analyserNode);
    }
    analyserNode.connect(audioCtx.destination);

    resizeCanvas();
    window.addEventListener('resize', resizeCanvas);
    drawOscilloscope();
  }

  let animPhase = 0;

  function resizeCanvas() {
    if (!canvas) return;
    canvas.width = canvas.offsetWidth;
    canvas.height = canvas.offsetHeight;
  }

  function drawOscilloscope() {
    if (!ctx || !canvas) return;
    animFrameId = requestAnimationFrame(drawOscilloscope);

    const width = canvas.width;
    const height = canvas.height;
    const centerY = height / 2;

    ctx.clearRect(0, 0, width, height);

    // 1. Draw Scope Grid Lines (10x6 reticle matrix)
    ctx.beginPath();
    ctx.strokeStyle = 'rgba(255, 255, 255, 0.04)';
    ctx.lineWidth = 1;
    const cols = 10;
    const rows = 6;
    for (let c = 1; c < cols; c++) {
      const gx = (width / cols) * c;
      ctx.moveTo(gx, 0);
      ctx.lineTo(gx, height);
    }
    for (let r = 1; r < rows; r++) {
      const gy = (height / rows) * r;
      ctx.moveTo(0, gy);
      ctx.lineTo(width, gy);
    }
    ctx.stroke();

    // Center Crosshair Axis
    ctx.beginPath();
    ctx.strokeStyle = 'rgba(255, 255, 255, 0.08)';
    ctx.moveTo(0, centerY);
    ctx.lineTo(width, centerY);
    ctx.moveTo(width / 2, 0);
    ctx.lineTo(width / 2, height);
    ctx.stroke();

    // 2. Color Theme per Waveform Type — Phosphor-Mint Design System
    let strokeColor = '#00e5a0'; // Phosphor Mint (Sine)
    let glowColor = 'rgba(0, 229, 160, 0.9)';
    let barColor = 'rgba(0, 229, 160, 0.12)';
    
    if (currentWaveform === 'square') {
      strokeColor = '#4d9fff'; // Electric Cerulean (Square)
      glowColor = 'rgba(77, 159, 255, 0.9)';
      barColor = 'rgba(77, 159, 255, 0.12)';
    } else if (currentWaveform === 'triangle') {
      strokeColor = '#a78bfa'; // Violet (Triangle)
      glowColor = 'rgba(167, 139, 250, 0.9)';
      barColor = 'rgba(167, 139, 250, 0.12)';
    } else if (currentWaveform === 'sawtooth') {
      strokeColor = '#ffb340'; // Signal Amber (Sawtooth)
      glowColor = 'rgba(255, 179, 64, 0.9)';
      barColor = 'rgba(255, 179, 64, 0.12)';
    }

    // 3. Draw Background FFT Spectrum Analyzer Bars (when active)
    if (isPlaying && analyserNode) {
      const fftBins = 64;
      const freqData = new Uint8Array(fftBins);
      analyserNode.getByteFrequencyData(freqData);

      const barWidth = width / fftBins;
      ctx.fillStyle = barColor;
      for (let b = 0; b < fftBins; b++) {
        const barH = (freqData[b] / 255) * (height * 0.7);
        ctx.fillRect(b * barWidth, height - barH, barWidth - 1, barH);
      }
    }

    // 4. Oscilloscope Waveform Trajectory Calculation
    const targetAmp = (height * 0.38) * Math.max(0.1, currentVolume);

    // Calculate timebase scaling ($t_{\text{div}}$) so 3-6 cycles are always visible regardless of 20Hz vs 15kHz
    const cyclesToShow = Math.min(6, Math.max(2, Math.log10(currentFreq) * 1.5));

    // Phase progression speed proportional to current frequency
    const speed = isPlaying ? Math.min(0.25, 0.003 + (currentFreq / 20000) * 0.15) : 0.015;
    animPhase += speed;

    const points: Array<{ x: number; y: number }> = [];

    if (isPlaying && analyserNode) {
      // Live Web Audio Oscilloscope with Hardware Zero-Crossing Rising Edge Trigger
      const bufferLength = analyserNode.frequencyBinCount;
      const timeData = new Float32Array(bufferLength);
      analyserNode.getFloatTimeDomainData(timeData);

      // Search for Zero-Crossing Rising Edge trigger point (sample[i] <= 0 && sample[i+1] > 0)
      let triggerIndex = 0;
      for (let i = 0; i < bufferLength - 1; i++) {
        if (timeData[i] <= 0 && timeData[i + 1] > 0) {
          triggerIndex = i;
          break;
        }
      }

      // Sample window based on target frequency cycles
      const samplesPerCycle = (audioCtx?.sampleRate || 48000) / currentFreq;
      const windowSamples = Math.min(bufferLength - triggerIndex, Math.round(samplesPerCycle * cyclesToShow));
      const step = Math.max(1, windowSamples / width);

      for (let x = 0; x < width; x++) {
        const idx = Math.min(bufferLength - 1, triggerIndex + Math.floor(x * step));
        const val = timeData[idx] || 0;
        const y = centerY - (val * targetAmp * 1.3);
        points.push({ x, y });
      }
    } else {
      // Real-Time Synthetic Oscilloscope Preview matching current frequency & waveform selection
      for (let x = 0; x < width; x++) {
        const theta = (x / width) * cyclesToShow * Math.PI * 2 + animPhase;
        let normY = 0;

        if (currentWaveform === 'sine') {
          normY = Math.sin(theta);
        } else if (currentWaveform === 'square') {
          const s = Math.sin(theta);
          // Realistic square wave with soft micro-edge transition and subtle ringing
          normY = Math.tanh(s * 8);
        } else if (currentWaveform === 'triangle') {
          normY = (2 / Math.PI) * Math.asin(Math.sin(theta));
        } else if (currentWaveform === 'sawtooth') {
          const modT = ((theta / (Math.PI * 2)) % 1 + 1) % 1;
          normY = modT * 2 - 1;
        }

        // Apply channel pan amplitude offset if configured
        const panFactor = 1 - Math.abs(currentPan) * 0.15;
        const y = centerY - (normY * targetAmp * panFactor);
        points.push({ x, y });
      }
    }

    if (points.length === 0) return;

    // 5. Dual-Pass CRT Phosphor Glow Line Rendering
    // Pass 1: Wide Phosphor Ambient Halo
    ctx.beginPath();
    ctx.lineWidth = 7;
    ctx.strokeStyle = strokeColor;
    ctx.globalAlpha = 0.25;
    ctx.shadowColor = glowColor;
    ctx.shadowBlur = 18;

    ctx.moveTo(points[0].x, points[0].y);
    for (let i = 1; i < points.length; i++) {
      ctx.lineTo(points[i].x, points[i].y);
    }
    ctx.stroke();

    // Pass 2: High-Intensity Sharp Beam Core
    ctx.beginPath();
    ctx.lineWidth = 2.5;
    ctx.strokeStyle = '#ffffff'; // Sharp beam center line
    ctx.globalAlpha = 0.95;
    ctx.shadowColor = strokeColor;
    ctx.shadowBlur = 8;

    ctx.moveTo(points[0].x, points[0].y);
    for (let i = 1; i < points.length; i++) {
      ctx.lineTo(points[i].x, points[i].y);
    }
    ctx.stroke();

    // Reset Canvas State
    ctx.globalAlpha = 1.0;
    ctx.shadowBlur = 0;
  }

  async function startTone() {
    setupWebAudio();
    if (audioCtx?.state === 'suspended') {
      await audioCtx.resume();
    }

    if (osc) {
      osc.stop();
      osc.disconnect();
    }

    osc = audioCtx!.createOscillator();
    osc.type = currentWaveform;
    osc.frequency.setValueAtTime(currentFreq, audioCtx!.currentTime);
    osc.connect(gainNode!);
    osc.start();

    isPlaying = true;
    if (led) led.className = 'w-3 h-3 rounded-full bg-cyan-400 shadow-[0_0_12px_rgba(6,182,212,0.9)] animate-pulse';
    if (playIcon) playIcon.classList.add('hidden');
    if (pauseIcon) pauseIcon.classList.remove('hidden');
    if (playLabel) playLabel.textContent = 'Stop Tone';
    if (btnPlay) btnPlay.className = 'w-full py-4 rounded-2xl bg-rose-500 hover:bg-rose-400 text-white font-extrabold font-mono text-lg transition-all transform active:scale-[0.99] shadow-[0_0_30px_rgba(244,63,94,0.4)] flex items-center justify-center gap-3 cursor-pointer';
  }

  function stopTone() {
    if (osc) {
      osc.stop();
      osc.disconnect();
      osc = null;
    }
    isPlaying = false;
    if (led) led.className = 'w-3 h-3 rounded-full bg-zinc-600 shadow-[0_0_10px_rgba(255,255,255,0.2)]';
    if (playIcon) playIcon.classList.remove('hidden');
    if (pauseIcon) pauseIcon.classList.add('hidden');
    if (playLabel) playLabel.textContent = 'Play Tone';
    if (btnPlay) btnPlay.className = 'w-full py-4 rounded-2xl bg-cyan-500 hover:bg-cyan-400 text-black font-extrabold font-mono text-lg transition-all transform active:scale-[0.99] shadow-[0_0_30px_rgba(6,182,212,0.4)] flex items-center justify-center gap-3 cursor-pointer';
  }

  // Event Listeners
  btnPlay?.addEventListener('click', () => {
    if (isPlaying) stopTone();
    else startTone();
  });

  // Waveform selector
  const waveformGroup = document.getElementById('fg-waveform-group');
  if (waveformGroup) {
    waveformGroup.querySelectorAll('button').forEach(btn => {
      btn.addEventListener('click', () => {
        const wf = btn.getAttribute('data-waveform') as OscillatorType;
        if (!wf) return;

        currentWaveform = wf;
        if (osc) osc.type = currentWaveform;

        waveformGroup.querySelectorAll('button').forEach(b => {
          b.className = 'fg-wf-btn p-3 rounded-2xl bg-bg-canvas border-2 border-border-hairline text-text-secondary flex flex-col items-center gap-1.5 transition-all cursor-pointer hover:scale-[1.02] hover:border-white/20';
        });
        btn.className = 'fg-wf-btn active p-3 rounded-2xl bg-cyan-500/10 border-2 border-cyan-500 text-cyan-300 flex flex-col items-center gap-1.5 transition-all cursor-pointer hover:scale-[1.02] shadow-sm';
        
        updateUI();
      });
    });
  }

  // Inputs
  numInput?.addEventListener('input', () => {
    const val = parseFloat(numInput.value);
    if (!isNaN(val)) setFrequency(val);
  });

  slider?.addEventListener('input', () => {
    const val = parseFloat(slider.value);
    setFrequency(val);
  });

  volSlider?.addEventListener('input', () => {
    currentVolume = parseFloat(volSlider.value) / 100;
    if (gainNode) gainNode.gain.value = currentVolume;
    updateUI();
  });

  panSlider?.addEventListener('input', () => {
    currentPan = parseFloat(panSlider.value);
    if (pannerNode) pannerNode.pan.value = currentPan;
    if (panVal) {
      if (currentPan === 0) panVal.textContent = 'CENTER';
      else if (currentPan < 0) panVal.textContent = `${Math.round(Math.abs(currentPan)*100)}% LEFT`;
      else panVal.textContent = `${Math.round(currentPan*100)}% RIGHT`;
    }
  });

  // Micro-step adjustment
  document.querySelectorAll('.fg-step-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const step = parseFloat(btn.getAttribute('data-step') || '0');
      setFrequency(currentFreq + step);
    });
  });

  // Octaves
  document.getElementById('btn-octave-down')?.addEventListener('click', () => setFrequency(currentFreq / 2));
  document.getElementById('btn-octave-up')?.addEventListener('click', () => setFrequency(currentFreq * 2));

  // Presets
  document.querySelectorAll('.fg-preset-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const freq = parseFloat(btn.getAttribute('data-freq') || '440');
      setFrequency(freq);
    });
  });

  // Mute button
  document.getElementById('fg-btn-mute')?.addEventListener('click', () => {
    if (currentVolume > 0) {
      currentVolume = 0;
      if (volSlider) volSlider.value = '0';
    } else {
      currentVolume = 0.5;
      if (volSlider) volSlider.value = '50';
    }
    if (gainNode) gainNode.gain.value = currentVolume;
    updateUI();
  });

  // Frequency Finder Wizard Modal Logic
  const wizModal = document.getElementById('fg-wizard-modal');
  const openWizBtn = document.getElementById('fg-open-wizard-btn');
  const closeWizBtn = document.getElementById('fg-wizard-close');
  const wizApplyBtn = document.getElementById('fg-wiz-apply-btn');

  const wizTitle = document.getElementById('fg-wiz-title');
  const wizSubtitle = document.getElementById('fg-wiz-subtitle');
  const wizBadge = document.getElementById('fg-wiz-step-badge');

  const step1 = document.getElementById('fg-wiz-step-1');
  const step2 = document.getElementById('fg-wiz-step-2');
  const step3 = document.getElementById('fg-wiz-step-3');
  const stepResult = document.getElementById('fg-wiz-step-result');

  let wizState = {
    goal: 'beta',
    device: 'headphones',
    intensity: 'balanced',
    recFreq: 20,
    recWaveform: 'sine' as OscillatorType,
    recVol: 0.5,
    recPan: 0,
    title: '20 Hz (Beta Wave Focus)',
    reason: 'Beta waves (14-30 Hz) stimulate analytical focus and eliminate background distractions during deep work sessions.'
  };

  function openWizard() {
    if (!wizModal) return;
    wizModal.classList.remove('hidden');
    setTimeout(() => wizModal.classList.remove('opacity-0'), 10);
    showWizStep(1);
  }

  function closeWizard() {
    if (!wizModal) return;
    wizModal.classList.add('opacity-0');
    setTimeout(() => wizModal.classList.add('hidden'), 300);
  }

  function showWizStep(stepNum: number) {
    step1?.classList.add('hidden');
    step2?.classList.add('hidden');
    step3?.classList.add('hidden');
    stepResult?.classList.add('hidden');

    if (stepNum === 1) {
      if (wizBadge) wizBadge.textContent = 'STEP 1 OF 3';
      if (wizTitle) wizTitle.textContent = 'What is your primary goal today?';
      if (wizSubtitle) wizSubtitle.textContent = 'Select your main activity or target outcome.';
      step1?.classList.remove('hidden');
    } else if (stepNum === 2) {
      if (wizBadge) wizBadge.textContent = 'STEP 2 OF 3';
      if (wizTitle) wizTitle.textContent = 'What listening device are you using?';
      if (wizSubtitle) wizSubtitle.textContent = 'This ensures proper channel balance and binaural beats optimization.';
      step2?.classList.remove('hidden');
    } else if (stepNum === 3) {
      if (wizBadge) wizBadge.textContent = 'STEP 3 OF 3';
      if (wizTitle) wizTitle.textContent = 'What intensity level do you prefer?';
      if (wizSubtitle) wizSubtitle.textContent = 'Choose your preferred listening volume and harmonic richness.';
      step3?.classList.remove('hidden');
    } else if (stepNum === 4) {
      calculateRecommendation();
      if (wizBadge) wizBadge.textContent = 'RECOMMENDATION READY';
      if (wizTitle) wizTitle.textContent = 'Your Ideal Frequency Configuration';
      if (wizSubtitle) wizSubtitle.textContent = 'Based on your selections, we configured the optimal settings below.';
      stepResult?.classList.remove('hidden');
    }
  }

  function calculateRecommendation() {
    if (wizState.goal === 'beta') {
      wizState.recFreq = 20;
      wizState.recWaveform = 'sine';
      wizState.title = '20 Hz (Beta Wave Focus)';
      wizState.reason = 'Beta waves (14–30 Hz) stimulate analytical focus, keep your brain in "traffic controller" mode, and reduce study distractions.';
    } else if (wizState.goal === 'gamma') {
      wizState.recFreq = 40;
      wizState.recWaveform = 'sine';
      wizState.title = '40 Hz (Gamma Wave Cognition)';
      wizState.reason = 'Gamma waves (40 Hz) promote advanced cognition, rapid information processing, and memory consolidation during intense sprints.';
    } else if (wizState.goal === 'alpha') {
      wizState.recFreq = 10;
      wizState.recWaveform = 'sine';
      wizState.title = '10 Hz (Alpha Wave Alertness)';
      wizState.reason = 'Alpha waves (8–13 Hz) trigger relaxed alertness and creative problem solving rather than rigid analytical processing.';
    } else if (wizState.goal === 'water') {
      wizState.recFreq = 165;
      wizState.recWaveform = 'sawtooth';
      wizState.title = '165 Hz (Speaker Water Eject)';
      wizState.reason = 'Low-frequency sawtooth transients generate kinetic pressure waves that physically expel water droplets from phone speaker grilles.';
    } else if (wizState.goal === 'tune') {
      wizState.recFreq = 440;
      wizState.recWaveform = 'sine';
      wizState.title = '440 Hz (A4 Concert Pitch)';
      wizState.reason = '440 Hz is the universal acoustic tuning standard for guitar, piano, and orchestral instrument calibration.';
    }

    if (wizState.intensity === 'gentle') wizState.recVol = 0.35;
    else if (wizState.intensity === 'balanced') wizState.recVol = 0.50;
    else if (wizState.intensity === 'intense') wizState.recVol = 0.80;

    // Update Result UI Card
    const nameEl = document.getElementById('wiz-res-freq-name');
    const reasonEl = document.getElementById('wiz-res-reason');
    const wfEl = document.getElementById('wiz-res-wf');
    const volEl = document.getElementById('wiz-res-vol');
    const panEl = document.getElementById('wiz-res-pan');

    if (nameEl) nameEl.textContent = wizState.title;
    if (reasonEl) reasonEl.textContent = wizState.reason;
    if (wfEl) wfEl.textContent = wizState.recWaveform.toUpperCase();
    if (volEl) volEl.textContent = `${Math.round(wizState.recVol * 100)}%`;
    if (panEl) panEl.textContent = wizState.device === 'headphones' ? 'Binaural Stereo' : 'Center';
  }

  // Wizard Option Click Handlers
  step1?.querySelectorAll('.wiz-opt-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      wizState.goal = btn.getAttribute('data-goal') || 'beta';
      showWizStep(2);
    });
  });

  step2?.querySelectorAll('.wiz-opt-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      wizState.device = btn.getAttribute('data-device') || 'headphones';
      showWizStep(3);
    });
  });

  step3?.querySelectorAll('.wiz-opt-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      wizState.intensity = btn.getAttribute('data-intensity') || 'balanced';
      showWizStep(4);
    });
  });

  openWizBtn?.addEventListener('click', openWizard);
  closeWizBtn?.addEventListener('click', closeWizard);

  wizApplyBtn?.addEventListener('click', () => {
    setFrequency(wizState.recFreq);
    currentWaveform = wizState.recWaveform;
    currentVolume = wizState.recVol;
    if (volSlider) volSlider.value = Math.round(wizState.recVol * 100).toString();
    if (gainNode) gainNode.gain.value = currentVolume;
    
    // Select active waveform card
    const wfGroup = document.getElementById('fg-waveform-group');
    wfGroup?.querySelectorAll('button').forEach(b => {
      if (b.getAttribute('data-waveform') === currentWaveform) {
        b.className = 'fg-wf-btn active p-3 rounded-2xl bg-cyan-500/10 border-2 border-cyan-500 text-cyan-300 flex flex-col items-center gap-1.5 transition-all cursor-pointer hover:scale-[1.02] shadow-sm';
      } else {
        b.className = 'fg-wf-btn p-3 rounded-2xl bg-bg-canvas border-2 border-border-hairline text-text-secondary flex flex-col items-center gap-1.5 transition-all cursor-pointer hover:scale-[1.02] hover:border-white/20';
      }
    });

    closeWizard();
    startTone();
  });

  // Initial draw & start animation loop
  resizeCanvas();
  window.addEventListener('resize', resizeCanvas);
  updateUI();
  drawOscilloscope();
</script>
