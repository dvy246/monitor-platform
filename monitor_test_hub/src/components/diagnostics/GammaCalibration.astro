---
/**
 * GammaCalibration.astro
 * Gamma 2.2 EOTF Response Evaluator UI component.
 */
---

<div class="w-full max-w-7xl mx-auto space-y-6 font-sans select-none min-w-0" id="gamma-calibration-root">
  <div class="relative bg-[#0c0d12]/95 border border-zinc-800/90 rounded-3xl p-4 sm:p-8 backdrop-blur-2xl shadow-[0_25px_60px_rgba(0,0,0,0.8)] space-y-6 overflow-hidden min-w-0 text-zinc-100 font-mono">
    <!-- Ambient Glows -->
    <div class="absolute -top-24 -right-24 w-96 h-96 bg-purple-500/10 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-24 -left-24 w-96 h-96 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none"></div>

    <div class="relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-zinc-800/70 pb-5">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-purple-500/10 border border-purple-500/30 text-[11px] font-mono text-purple-400 font-bold uppercase tracking-wider mb-2">
          <span class="w-2 h-2 rounded-full bg-purple-400 shadow-[0_0_8px_rgba(192,132,252,0.9)] animate-pulse"></span>
          <span>ITU-R BT.709 &amp; IEC 61966-2-1 GAMMA SPEC</span>
        </div>
        <h2 class="text-xl sm:text-3xl font-extrabold font-mono text-white tracking-tight">Gamma 2.2 EOTF Calibration Evaluator</h2>
        <p class="text-xs sm:text-sm text-zinc-400 mt-1 font-sans font-normal">High-frequency visual dither pattern matching for 1.8, 2.2, and 2.4 gamma curves.</p>
      </div>

      <div class="flex items-center gap-3 text-xs">
        <label class="text-zinc-400 font-bold">Target Gamma:</label>
        <select id="gamma-target-select" class="bg-zinc-900 border border-zinc-700/80 text-white text-xs font-mono rounded-xl px-3.5 py-2 focus:border-purple-500 focus:outline-none cursor-pointer">
          <option value="1.8">Gamma 1.8</option>
          <option value="2.2" selected>Gamma 2.2</option>
          <option value="2.4">Gamma 2.4</option>
        </select>
      </div>
    </div>

    <!-- Dither Pattern Visual Box -->
    <div class="relative z-10 w-full h-64 sm:h-80 rounded-2xl bg-zinc-950 border border-zinc-800 overflow-hidden flex items-center justify-center p-4 shadow-inner">
      <div id="gamma-box" class="w-48 h-48 rounded-xl border border-zinc-700 flex items-center justify-center shadow-2xl transition-all" style="background-color: rgb(186, 186, 186);">
        <span class="text-xs font-mono font-bold text-black bg-white/90 backdrop-blur-md px-3 py-1.5 rounded-lg shadow">50% Blend Pattern</span>
      </div>
    </div>

    <!-- Slider & Metric Controls -->
    <div class="relative z-10 space-y-4 pt-2">
      <div class="flex items-center justify-between text-xs font-mono">
        <span class="text-zinc-400 font-bold uppercase">Adjust Visual Blend Offset:</span>
        <span id="offset-val" class="font-extrabold text-emerald-400 text-sm">0.00</span>
      </div>
      <input id="gamma-slider" type="range" min="-0.5" max="0.5" step="0.01" value="0" class="w-full text-emerald-400 accent-emerald-400 cursor-pointer h-2 bg-zinc-800 rounded-lg" />
    </div>

    <div class="relative z-10 grid grid-cols-2 md:grid-cols-4 gap-4 pt-2">
      <div class="bg-zinc-950/80 p-4 rounded-2xl border border-zinc-800/80 text-center space-y-1 shadow-inner">
        <div class="text-[10px] sm:text-xs text-zinc-400 uppercase font-bold">Target Gamma</div>
        <div id="metric-target-g" class="text-base sm:text-2xl font-extrabold text-white mt-1 tabular-nums">2.20</div>
      </div>
      <div class="bg-zinc-950/80 p-4 rounded-2xl border border-zinc-800/80 text-center space-y-1 shadow-inner">
        <div class="text-[10px] sm:text-xs text-zinc-400 uppercase font-bold">Calculated Gamma</div>
        <div id="metric-calc-g" class="text-base sm:text-2xl font-extrabold text-emerald-400 mt-1 tabular-nums">2.20</div>
      </div>
      <div class="bg-zinc-950/80 p-4 rounded-2xl border border-zinc-800/80 text-center space-y-1 shadow-inner">
        <div class="text-[10px] sm:text-xs text-zinc-400 uppercase font-bold">Target Luminance</div>
        <div id="metric-lum" class="text-base sm:text-2xl font-extrabold text-white mt-1 tabular-nums">0.2176 L*</div>
      </div>
      <div class="bg-zinc-950/80 p-4 rounded-2xl border border-zinc-800/80 text-center space-y-1 shadow-inner">
        <div class="text-[10px] sm:text-xs text-zinc-400 uppercase font-bold">Accuracy Rating</div>
        <div id="metric-rating" class="text-xs sm:text-sm font-extrabold text-emerald-400 mt-1">EXCELLENT</div>
      </div>
    </div>
  </div>
</div>

<script>
  import { evaluateGammaMatch } from '../../engine/GammaCalibrationEngine';

  const slider = document.getElementById('gamma-slider') as HTMLInputElement | null;
  const targetSelect = document.getElementById('gamma-target-select') as HTMLSelectElement | null;
  const offsetVal = document.getElementById('offset-val');
  const metricTarget = document.getElementById('metric-target-g');
  const metricCalc = document.getElementById('metric-calc-g');
  const metricLum = document.getElementById('metric-lum');
  const metricRating = document.getElementById('metric-rating');

  function update() {
    if (!slider || !targetSelect) return;
    const targetG = parseFloat(targetSelect.value);
    const offset = parseFloat(slider.value);
    
    if (offsetVal) offsetVal.textContent = offset.toFixed(2);
    const res = evaluateGammaMatch(targetG, offset);

    if (metricTarget) metricTarget.textContent = res.targetGamma.toFixed(2);
    if (metricCalc) metricCalc.textContent = res.calculatedGamma.toFixed(2);
    if (metricLum) metricLum.textContent = `${res.perceivedLuminance} L*`;
    if (metricRating) metricRating.textContent = res.accuracyRating;
  }

  slider?.addEventListener('input', update);
  targetSelect?.addEventListener('change', update);
  update();
</script>
