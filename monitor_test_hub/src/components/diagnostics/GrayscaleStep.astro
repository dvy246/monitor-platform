---
/**
 * GrayscaleStep.astro
 * Grayscale Dynamic Range Step Test UI component.
 */
---

<div class="w-full max-w-5xl mx-auto space-y-6">
  <div class="bg-bg-surface/90 border border-border-hairline rounded-2xl p-6 backdrop-blur-xl shadow-2xl space-y-6">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-border-hairline/60 pb-4">
      <div>
        <div class="flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-status-pass shadow-[0_0_8px_rgba(5,150,105,0.8)]"></span>
          <h2 class="text-lg font-bold font-mono text-text-primary tracking-wide">Grayscale &amp; Contrast Step Ramp Inspector</h2>
        </div>
        <p class="text-xs text-text-muted mt-1">16-step calibrated luminance ramp for black crush &amp; white clipping detection (DICOM GSDF).</p>
      </div>

      <div class="flex items-center gap-3">
        <label class="text-xs font-mono text-text-muted">Visible Steps:</label>
        <input id="visible-steps-slider" type="range" min="1" max="16" value="16" class="w-32 accent-status-pass cursor-pointer" />
      </div>
    </div>

    <!-- 16-Step Grayscale Grid -->
    <div class="grid grid-cols-16 h-28 rounded-xl border border-border-subtle overflow-hidden shadow-inner">
      {Array.from({ length: 16 }).map((_, i) => {
        const rgb = Math.round((i / 15) * 255);
        return (
          <div 
            class="h-full flex flex-col justify-end p-1 font-mono text-[9px] text-center border-r border-border-hairline/30"
            style={`background-color: rgb(${rgb}, ${rgb}, ${rgb}); color: ${rgb > 128 ? '#000' : '#fff'};`}
          >
            <span>{i + 1}</span>
          </div>
        );
      })}
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 pt-2">
      <div class="bg-bg-elevated p-3.5 rounded-xl border border-border-hairline">
        <div class="text-[10px] font-mono text-text-muted uppercase">Visible Step Count</div>
        <div id="metric-visible-count" class="text-sm font-mono font-bold text-status-pass mt-1">16 / 16 Steps</div>
      </div>
      <div class="bg-bg-elevated p-3.5 rounded-xl border border-border-hairline">
        <div class="text-[10px] font-mono text-text-muted uppercase">Black Crush Status</div>
        <div id="metric-crush-status" class="text-sm font-mono font-bold text-status-pass mt-1">NO CRUSH</div>
      </div>
      <div class="bg-bg-elevated p-3.5 rounded-xl border border-border-hairline">
        <div class="text-[10px] font-mono text-text-muted uppercase">White Clipping</div>
        <div id="metric-clipping-status" class="text-sm font-mono font-bold text-status-pass mt-1">NO CLIPPING</div>
      </div>
      <div class="bg-bg-elevated p-3.5 rounded-xl border border-border-hairline">
        <div class="text-[10px] font-mono text-text-muted uppercase">Ramp Linearity</div>
        <div id="metric-linearity-score" class="text-sm font-mono font-bold text-status-pass mt-1">100.0%</div>
      </div>
    </div>
  </div>
</div>

<script>
  import { evaluateGrayscaleRamp } from '../../engine/GrayscaleStepEngine';

  const slider = document.getElementById('visible-steps-slider') as HTMLInputElement | null;
  const metricVisible = document.getElementById('metric-visible-count');
  const metricCrush = document.getElementById('metric-crush-status');
  const metricClip = document.getElementById('metric-clipping-status');
  const metricLin = document.getElementById('metric-linearity-score');

  function update() {
    if (!slider) return;
    const vis = parseInt(slider.value, 10);
    const report = evaluateGrayscaleRamp(vis, 2.2);

    if (metricVisible) metricVisible.textContent = `${vis} / 16 Steps`;
    if (metricCrush) {
      metricCrush.textContent = report.hasBlackCrush ? 'BLACK CRUSH' : 'NO CRUSH';
      metricCrush.className = `text-sm font-mono font-bold mt-1 ${report.hasBlackCrush ? 'text-status-fail' : 'text-status-pass'}`;
    }
    if (metricClip) {
      metricClip.textContent = report.hasWhiteClipping ? 'WHITE CLIPPING' : 'NO CLIPPING';
      metricClip.className = `text-sm font-mono font-bold mt-1 ${report.hasWhiteClipping ? 'text-status-fail' : 'text-status-pass'}`;
    }
    if (metricLin) metricLin.textContent = `${report.rampLinearityScore}%`;
  }

  slider?.addEventListener('input', update);
  update();
</script>
