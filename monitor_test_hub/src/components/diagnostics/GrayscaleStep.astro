---
/**
 * GrayscaleStep.astro
 * Grayscale Dynamic Range Step Test UI component.
 */
---

<div class="w-full max-w-7xl mx-auto space-y-6 font-sans select-none min-w-0" id="grayscale-step-root">
  <div class="relative bg-[#0c0d12]/95 border border-zinc-800/90 rounded-3xl p-4 sm:p-8 backdrop-blur-2xl shadow-[0_25px_60px_rgba(0,0,0,0.8)] space-y-6 overflow-hidden min-w-0 text-zinc-100 font-mono">
    <!-- Ambient Glows -->
    <div class="absolute -top-24 -right-24 w-96 h-96 bg-cyan-500/10 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-24 -left-24 w-96 h-96 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none"></div>

    <div class="relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-zinc-800/70 pb-5">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/30 text-[11px] font-mono text-cyan-400 font-bold uppercase tracking-wider mb-2">
          <span class="w-2 h-2 rounded-full bg-cyan-400 shadow-[0_0_8px_rgba(34,211,238,0.9)] animate-pulse"></span>
          <span>DICOM GSDF &amp; DYNAMIC RANGE SPEC</span>
        </div>
        <h2 class="text-xl sm:text-3xl font-extrabold font-mono text-white tracking-tight">Grayscale &amp; Contrast Step Ramp Inspector</h2>
        <p class="text-xs sm:text-sm text-zinc-400 mt-1 font-sans font-normal">16-step calibrated luminance ramp for black crush &amp; white clipping detection (DICOM GSDF).</p>
      </div>

      <div class="flex items-center gap-3 text-xs">
        <label class="text-zinc-400 font-bold">Visible Steps:</label>
        <input id="visible-steps-slider" type="range" min="1" max="16" value="16" class="w-32 accent-emerald-400 cursor-pointer h-2 bg-zinc-800 rounded-lg" />
      </div>
    </div>

    <!-- 16-Step Grayscale Grid -->
    <div class="relative z-10 grid grid-cols-16 h-28 sm:h-36 rounded-2xl border border-zinc-800 overflow-hidden shadow-inner">
      {Array.from({ length: 16 }).map((_, i) => {
        const rgb = Math.round((i / 15) * 255);
        return (
          <div 
            class="h-full flex flex-col justify-end p-1 font-mono text-[10px] sm:text-xs text-center border-r border-zinc-800/40 font-bold"
            style={`background-color: rgb(${rgb}, ${rgb}, ${rgb}); color: ${rgb > 128 ? '#000' : '#fff'};`}
          >
            <span>{i + 1}</span>
          </div>
        );
      })}
    </div>

    <div class="relative z-10 grid grid-cols-2 md:grid-cols-4 gap-4 pt-2">
      <div class="bg-zinc-950/80 p-4 rounded-2xl border border-zinc-800/80 text-center space-y-1 shadow-inner">
        <div class="text-[10px] sm:text-xs text-zinc-400 uppercase font-bold">Visible Step Count</div>
        <div id="metric-visible-count" class="text-base sm:text-2xl font-extrabold text-emerald-400 mt-1 tabular-nums">16 / 16 Steps</div>
      </div>
      <div class="bg-zinc-950/80 p-4 rounded-2xl border border-zinc-800/80 text-center space-y-1 shadow-inner">
        <div class="text-[10px] sm:text-xs text-zinc-400 uppercase font-bold">Black Crush Status</div>
        <div id="metric-crush-status" class="text-xs sm:text-sm font-extrabold text-emerald-400 mt-1">NO CRUSH</div>
      </div>
      <div class="bg-zinc-950/80 p-4 rounded-2xl border border-zinc-800/80 text-center space-y-1 shadow-inner">
        <div class="text-[10px] sm:text-xs text-zinc-400 uppercase font-bold">White Clipping</div>
        <div id="metric-clipping-status" class="text-xs sm:text-sm font-extrabold text-emerald-400 mt-1">NO CLIPPING</div>
      </div>
      <div class="bg-zinc-950/80 p-4 rounded-2xl border border-zinc-800/80 text-center space-y-1 shadow-inner">
        <div class="text-[10px] sm:text-xs text-zinc-400 uppercase font-bold">Ramp Linearity</div>
        <div id="metric-linearity-score" class="text-base sm:text-2xl font-extrabold text-emerald-400 mt-1 tabular-nums">100.0%</div>
      </div>
    </div>
  </div>
</div>

<script>
  import { evaluateGrayscaleRamp } from '../../engine/GrayscaleStepEngine';

  const slider = document.getElementById('visible-steps-slider') as HTMLInputElement | null;
  const metricVisible = document.getElementById('metric-visible-count');
  const metricCrush = document.getElementById('metric-crush-status');
  const metricClip = document.getElementById('metric-clipping-status');
  const metricLin = document.getElementById('metric-linearity-score');

  function update() {
    if (!slider) return;
    const vis = parseInt(slider.value, 10);
    const report = evaluateGrayscaleRamp(vis, 2.2);

    if (metricVisible) metricVisible.textContent = `${vis} / 16 Steps`;
    if (metricCrush) {
      metricCrush.textContent = report.hasBlackCrush ? 'BLACK CRUSH' : 'NO CRUSH';
      metricCrush.className = `text-xs sm:text-sm font-mono font-extrabold mt-1 ${report.hasBlackCrush ? 'text-rose-400' : 'text-emerald-400'}`;
    }
    if (metricClip) {
      metricClip.textContent = report.hasWhiteClipping ? 'WHITE CLIPPING' : 'NO CLIPPING';
      metricClip.className = `text-xs sm:text-sm font-mono font-extrabold mt-1 ${report.hasWhiteClipping ? 'text-rose-400' : 'text-emerald-400'}`;
    }
    if (metricLin) metricLin.textContent = `${report.rampLinearityScore}%`;
  }

  slider?.addEventListener('input', update);
  update();
</script>
