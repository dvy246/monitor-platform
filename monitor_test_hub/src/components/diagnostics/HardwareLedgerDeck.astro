---
import HardwarePassportModal from './HardwarePassportModal.astro';

export interface LedgerEntry {
  id: string;
  signatureHash: string;
  timestamp: string;
  panelType: string;
  refreshRate: number;
  resolution: string;
  pacingJitterMs: number;
  healthScore: number;
  verdict: string;
  deviceType: 'DESKTOP' | 'MOBILE' | 'TABLET';
}

const sampleLedgerData: LedgerEntry[] = [
  {
    id: 'rec-001',
    signatureHash: 'a4f8b92c103e57f1',
    timestamp: '2026-07-22 01:15 UTC',
    panelType: 'QD-OLED Gen 2',
    refreshRate: 240,
    resolution: '3840 x 2160',
    pacingJitterMs: 0.12,
    healthScore: 98,
    verdict: 'EXCELLENT',
    deviceType: 'DESKTOP'
  },
  {
    id: 'rec-002',
    signatureHash: 'f7e1039a482b611c',
    timestamp: '2026-07-22 01:10 UTC',
    panelType: 'WOLED Meta 2.0',
    refreshRate: 360,
    resolution: '2560 x 1440',
    pacingJitterMs: 0.08,
    healthScore: 99,
    verdict: 'EXCELLENT',
    deviceType: 'DESKTOP'
  },
  {
    id: 'rec-003',
    signatureHash: 'c9b4e18d720a3541',
    timestamp: '2026-07-22 01:05 UTC',
    panelType: 'Fast IPS Dual-Hz',
    refreshRate: 540,
    resolution: '1920 x 1080',
    pacingJitterMs: 0.04,
    healthScore: 96,
    verdict: 'EXCELLENT',
    deviceType: 'DESKTOP'
  },
  {
    id: 'rec-004',
    signatureHash: 'd382f1056c9a721e',
    timestamp: '2026-07-22 00:58 UTC',
    panelType: 'ProMotion OLED',
    refreshRate: 120,
    resolution: '2796 x 1290',
    pacingJitterMs: 0.35,
    healthScore: 94,
    verdict: 'EXCELLENT',
    deviceType: 'MOBILE'
  },
  {
    id: 'rec-005',
    signatureHash: 'e5190b432a18f77d',
    timestamp: '2026-07-22 00:45 UTC',
    panelType: 'Ultra-Fast VA Curve',
    refreshRate: 144,
    resolution: '3440 x 1440',
    pacingJitterMs: 0.82,
    healthScore: 88,
    verdict: 'GOOD',
    deviceType: 'DESKTOP'
  },
  {
    id: 'rec-006',
    signatureHash: 'b1029c384e7a510f',
    timestamp: '2026-07-22 00:32 UTC',
    panelType: 'IPS Mobile Digitizer',
    refreshRate: 60,
    resolution: '2340 x 1080',
    pacingJitterMs: 1.45,
    healthScore: 78,
    verdict: 'GOOD',
    deviceType: 'MOBILE'
  }
];
---

<section class="space-y-6">
  <!-- Crowdsourced Telemetry Ledger Header Card -->
  <div class="bg-bg-surface border border-border-hairline rounded-2xl p-6 sm:p-8 space-y-6 shadow-specular-top font-mono">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-border-hairline pb-6">
      <div class="space-y-2">
        <div class="flex items-center gap-2 text-status-pass text-xs font-bold uppercase tracking-wider">
          <span class="w-2.5 h-2.5 rounded-full bg-status-pass led-glow-pass"></span>
          SHA-256 VERIFIED HARDWARE TELEMETRY LEDGER
        </div>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-text-primary tracking-tight">
          Global Display Performance Ledger
        </h2>
        <p class="text-xs text-text-secondary font-sans max-w-2xl leading-relaxed">
          Real-time crowdsourced hardware benchmarks signed with Web Crypto SHA-256 verification receipts. Measures empirical VSync frame pacing jitter, pixel density, digitizer touch precision, and OLED health distribution across global displays.
        </p>
      </div>

      <div class="flex flex-col sm:flex-row gap-3">
        <button 
          id="btn-open-passport" 
          class="px-5 py-3 rounded-xl bg-status-pass text-bg-canvas font-extrabold text-xs tracking-wider uppercase hover:opacity-90 transition-opacity shadow-lg shadow-status-pass/20 cursor-pointer flex items-center justify-center gap-2"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
          RUN HARDWARE PASSPORT
        </button>
      </div>
    </div>

    <!-- Live Telemetry KPI Metrics -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-xs">
      <div class="bg-bg-canvas p-4 rounded-xl border border-border-hairline space-y-1">
        <span class="text-text-muted text-[10px] uppercase block">TOTAL VERIFIED RECEIPTS</span>
        <strong id="metric-total-receipts" class="text-xl sm:text-2xl font-extrabold text-text-primary block font-mono">14,289</strong>
        <span class="text-[10px] text-status-pass">SHA-256 Signed</span>
      </div>
      <div class="bg-bg-canvas p-4 rounded-xl border border-border-hairline space-y-1">
        <span class="text-text-muted text-[10px] uppercase block">AVG HARDWARE HEALTH SCORE</span>
        <strong id="metric-avg-score" class="text-xl sm:text-2xl font-extrabold text-status-pass block font-mono">91.4 / 100</strong>
        <span class="text-[10px] text-text-secondary font-sans">Global Percentile</span>
      </div>
      <div class="bg-bg-canvas p-4 rounded-xl border border-border-hairline space-y-1">
        <span class="text-text-muted text-[10px] uppercase block">MEDIAN PACING JITTER</span>
        <strong id="metric-median-jitter" class="text-xl sm:text-2xl font-extrabold text-text-primary block font-mono">0.18 ms</strong>
        <span class="text-[10px] text-status-pass">Sub-Millisecond Range</span>
      </div>
      <div class="bg-bg-canvas p-4 rounded-xl border border-border-hairline space-y-1">
        <span class="text-text-muted text-[10px] uppercase block">MAX REFRESH LOGGED</span>
        <strong id="metric-max-refresh" class="text-xl sm:text-2xl font-extrabold text-text-primary block font-mono">540.0 Hz</strong>
        <span class="text-[10px] text-text-secondary font-sans">Ultra-High Refresh</span>
      </div>
    </div>

    <!-- Filter & Benchmark Table -->
    <div class="space-y-4 pt-2">
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 text-xs">
        <span class="font-bold text-text-primary uppercase tracking-wider text-[11px]">RECENT VERIFIED BENCHMARK RECEIPTS</span>
        <div class="flex items-center gap-2">
          <label for="ledger-filter-panel" class="sr-only">Filter by Panel Type</label>
          <select id="ledger-filter-panel" class="bg-bg-canvas border border-border-hairline rounded-lg px-3 py-1.5 text-[11px] text-text-primary font-mono outline-none focus:border-status-pass">
            <option value="ALL">All Panel Types</option>
            <option value="QD-OLED">QD-OLED</option>
            <option value="WOLED">WOLED</option>
            <option value="IPS">Fast IPS</option>
            <option value="VA">VA</option>
          </select>
        </div>
      </div>

      <div class="overflow-x-auto rounded-xl border border-border-hairline bg-bg-canvas">
        <table class="w-full text-left text-xs font-mono">
          <thead class="bg-bg-elevated border-b border-border-hairline text-[10px] text-text-muted uppercase">
            <tr>
              <th scope="col" class="py-3 px-4">Receipt Hash</th>
              <th scope="col" class="py-3 px-4">Timestamp</th>
              <th scope="col" class="py-3 px-4">Panel &amp; Specs</th>
              <th scope="col" class="py-3 px-4">Pacing Jitter</th>
              <th scope="col" class="py-3 px-4">Health Index</th>
              <th scope="col" class="py-3 px-4 text-right">Status</th>
            </tr>
          </thead>
          <tbody id="ledger-table-body" class="divide-y divide-border-hairline text-[11px] text-text-secondary">
            {sampleLedgerData.map(entry => (
              <tr class="hover:bg-bg-surface/50 transition-colors">
                <td class="py-3 px-4 font-bold text-text-primary">
                  <div class="flex items-center gap-1.5">
                    <span class="w-1.5 h-1.5 rounded-full bg-status-pass"></span>
                    <span class="font-mono tracking-wider">{entry.signatureHash}</span>
                  </div>
                </td>
                <td class="py-3 px-4 text-text-muted">{entry.timestamp}</td>
                <td class="py-3 px-4 font-sans text-text-primary">
                  <div class="font-bold font-mono text-xs">{entry.panelType} ({entry.refreshRate}Hz)</div>
                  <div class="text-[10px] text-text-muted font-mono">{entry.resolution}</div>
                </td>
                <td class="py-3 px-4 font-mono font-bold text-status-pass">{entry.pacingJitterMs} ms</td>
                <td class="py-3 px-4 font-bold text-text-primary font-mono">{entry.healthScore} / 100</td>
                <td class="py-3 px-4 text-right">
                  <span class="inline-block px-2 py-0.5 rounded text-[10px] font-bold uppercase bg-status-pass/10 text-status-pass border border-status-pass/20">
                    {entry.verdict}
                  </span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </div>
  <HardwarePassportModal />
</section>

<script>
  import { HardwarePassportEngine } from '../../engine/HardwarePassportEngine';

  function initLedgerDeck() {
    const filterSelect = document.getElementById('ledger-filter-panel') as HTMLSelectElement | null;
    const tableBody = document.getElementById('ledger-table-body');
    const openPassportBtn = document.getElementById('btn-open-passport');

    openPassportBtn?.addEventListener('click', () => {
      const modal = document.getElementById('passport-modal');
      if (modal) {
        modal.classList.remove('hidden');
      }
    });

    filterSelect?.addEventListener('change', () => {
      const selected = filterSelect.value.toUpperCase();
      if (!tableBody) return;
      const rows = tableBody.querySelectorAll('tr');
      rows.forEach(row => {
        const text = row.textContent?.toUpperCase() || '';
        if (selected === 'ALL' || text.includes(selected)) {
          (row as HTMLElement).style.display = '';
        } else {
          (row as HTMLElement).style.display = 'none';
        }
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initLedgerDeck);
  } else {
    initLedgerDeck();
  }
</script>
