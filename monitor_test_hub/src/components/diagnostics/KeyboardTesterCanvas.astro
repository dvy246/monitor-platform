---
/**
 * KeyboardTesterCanvas.astro
 * State-of-the-art interactive 3D mechanical keyboard diagnostic suite.
 * Features: High-Performance Targeted DOM State Engine (0.1ms latency, zero layout thrashing),
 * Perfect CapsLock OS Toggle Handling (Keycap Press Dip + OS getModifierState LED Diode),
 * 100% High-Legibility Windows & Mac Key Labels, CNC Machined Anodized Aluminum 3D Chassis,
 * Double-Shot PBT Keycaps (Cherry Profile), Switch Chatter Microsecond Analysis,
 * Esports Gaming Combos, Web Audio Switch Acoustics & Hardware Passport Certificates.
 */
---

<div class="w-full max-w-7xl mx-auto space-y-6 font-sans select-none min-w-0">
  <!-- Top Glassmorphic Control Deck -->
  <div class="relative bg-[#0c0d12]/90 border border-zinc-800/90 rounded-2xl p-4 sm:p-6 backdrop-blur-2xl shadow-[0_25px_60px_rgba(0,0,0,0.8)] space-y-6 overflow-hidden">
    <!-- Ambient Glow Effects -->
    <div class="absolute -top-24 -right-24 w-96 h-96 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-24 -left-24 w-96 h-96 bg-purple-500/10 rounded-full blur-3xl pointer-events-none"></div>

    <div class="relative z-10 flex flex-col lg:flex-row lg:items-center justify-between gap-4 border-b border-zinc-800/70 pb-5">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-[11px] font-mono text-emerald-400 font-bold uppercase tracking-wider mb-2">
          <span class="w-2 h-2 rounded-full bg-emerald-400 shadow-[0_0_8px_rgba(52,211,153,0.9)] animate-pulse"></span>
          <span>HIGH-PRECISION 1000HZ KEYBOARD DIAGNOSTIC</span>
        </div>
        <h2 class="text-xl sm:text-2xl font-bold font-mono text-white tracking-tight flex items-center gap-2">
          Pro Custom Mechanical Keyboard Suite
        </h2>
        <p class="text-xs text-zinc-400 mt-1 max-w-2xl leading-relaxed">
          Switch between <strong>Windows ANSI 104</strong> and <strong>Apple Mac</strong> 3D keycaps. Zero-latency microsecond bounce profiler, NKRO gaming combo matrix & APM speedometer.
        </p>
      </div>

      <!-- Mode & OS Layout Selectors Deck -->
      <div class="flex flex-wrap items-center gap-2.5">
        <!-- OS Layout Selector: Windows vs Mac -->
        <div class="bg-zinc-950/90 p-1 rounded-xl border border-zinc-800 flex items-center gap-1 text-xs font-mono shadow-inner">
          <button id="layout-win" class="layout-btn px-3 py-1.5 rounded-lg font-bold bg-emerald-500/20 text-emerald-400 border border-emerald-500/40 cursor-pointer transition-all flex items-center gap-1.5 shadow-sm">
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor"><path d="M0 3.449L9.75 2.1v9.451H0m10.95-9.6L24 0v11.4H10.95M0 12.6h9.75v9.451L0 20.699M10.95 12.6H24V24l-13.05-1.8"/></svg>
            <span>Windows (ANSI)</span>
          </button>
          <button id="layout-mac" class="layout-btn px-3 py-1.5 rounded-lg font-semibold text-zinc-400 hover:text-white cursor-pointer transition-all flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 6.33c.66-.8 1.11-1.92.99-3.04-.96.04-2.12.64-2.8 1.44-.6.7-1.13 1.84-.99 2.95 1.07.08 2.15-.55 2.8-1.35z"/></svg>
            <span>Apple Mac</span>
          </button>
        </div>

        <!-- Mode Control Deck -->
        <div class="bg-zinc-950/90 p-1 rounded-xl border border-zinc-800 flex items-center gap-1 text-xs font-mono overflow-x-auto max-w-full shadow-inner">
          <button id="mode-standard" class="mode-btn px-3 py-1.5 rounded-lg font-bold bg-emerald-500/20 text-emerald-400 border border-emerald-500/40 cursor-pointer transition-all flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><rect x="2" y="6" width="20" height="12" rx="2"/><path d="M6 10h.01M10 10h.01M14 10h.01M18 10h.01M8 14h8"/></svg>
            <span>Matrix</span>
          </button>
          <button id="mode-chatter" class="mode-btn px-3 py-1.5 rounded-lg font-semibold text-zinc-400 hover:text-white cursor-pointer transition-all flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
            <span>Chatter</span>
          </button>
          <button id="mode-combos" class="mode-btn px-3 py-1.5 rounded-lg font-semibold text-zinc-400 hover:text-white cursor-pointer transition-all flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z"/></svg>
            <span>NKRO</span>
          </button>
          <button id="mode-heatmap" class="mode-btn px-3 py-1.5 rounded-lg font-semibold text-zinc-400 hover:text-white cursor-pointer transition-all flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 18.657A8 8 0 016.343 7.343S7 9 9 10c0-2 .5-5 2.986-7C14 5 16.09 5.777 17.656 7.343A7.975 7.975 0 0120 13a7.975 7.975 0 01-2.343 5.657z"/></svg>
            <span>Heatmap</span>
          </button>
        </div>

        <!-- Web Audio Acoustics Selector -->
        <div class="relative inline-flex items-center">
          <select id="sound-selector" class="bg-zinc-950 border border-zinc-800 text-zinc-300 hover:text-white text-xs font-mono rounded-xl px-3 py-2 focus-visible:ring-2 focus-visible:ring-emerald-500 focus-visible:outline-none cursor-pointer transition-all appearance-none pr-8">
            <option value="none">🔇 Mute Acoustics</option>
            <option value="blue" selected>🔊 Clicky Blue Switch</option>
            <option value="brown">🔊 Tactile Brown Switch</option>
            <option value="red">🔊 Linear Red Switch</option>
          </select>
          <svg class="w-3.5 h-3.5 text-zinc-500 absolute right-2.5 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
        </div>

        <!-- Action Buttons -->
        <button id="reset-suite-btn" class="px-3.5 py-2 text-xs font-mono font-semibold rounded-xl bg-zinc-950 border border-zinc-800 hover:bg-zinc-800 text-zinc-300 hover:text-white cursor-pointer transition-all flex items-center gap-1.5 shadow-sm">
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
          <span>Reset</span>
        </button>

        <button id="export-cert-btn" class="px-3.5 py-2 text-xs font-mono font-bold rounded-xl bg-emerald-500/10 border border-emerald-500/40 text-emerald-400 hover:bg-emerald-500/20 cursor-pointer transition-all flex items-center gap-1.5 shadow-sm">
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
          <span>Certificate</span>
        </button>
      </div>
    </div>

    <!-- Active Event Readout & Live Keys Deck -->
    <div class="relative z-10 w-full p-4 rounded-xl bg-zinc-950/90 border border-zinc-800/80 space-y-3 shadow-inner">
      <div class="flex flex-col sm:flex-row items-center justify-between gap-2 border-b border-zinc-800/50 pb-2.5">
        <div class="flex items-center gap-2">
          <span class="text-xs font-mono font-bold text-zinc-400 uppercase tracking-wider">Active Input Telemetry:</span>
          <span id="active-event-code" class="text-xs font-mono font-extrabold text-emerald-400 bg-emerald-500/10 px-2.5 py-1 rounded-md border border-emerald-500/30 tracking-wide">
            Awaiting physical keypress...
          </span>
        </div>
        <div id="chatter-warning-badge" class="hidden items-center gap-1.5 px-3 py-1 rounded-md bg-rose-500/20 border border-rose-500/50 text-rose-300 font-mono text-[11px] font-bold animate-bounce shadow-[0_0_12px_rgba(244,63,94,0.4)]">
          <span>⚠️ SWITCH CHATTER DETECTED!</span>
        </div>
      </div>

      <!-- Gaming Combo Tracker Deck (Visible in Combos Mode) -->
      <div id="combos-deck" class="hidden space-y-2">
        <div class="text-xs font-mono font-bold text-zinc-400 uppercase tracking-wider">Esports Gaming Combo Anti-Ghosting Tests:</div>
        <div id="combos-list-container" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-2">
          <!-- Dynamically populated -->
        </div>
      </div>

      <!-- Live Pressed Keys Visual Pills Ribbon -->
      <div id="live-keys-container" class="flex flex-wrap items-center gap-2 min-h-[38px]">
        <span class="text-xs font-mono text-zinc-500 italic">Press any keys simultaneously on your physical keyboard to audit matrix signals...</span>
      </div>
    </div>

    <!-- 3D REALISTIC CNC ALUMINUM MECHANICAL KEYBOARD CHASSIS -->
    <div class="relative z-10 w-full min-w-0">
      <!-- CNC Machined Metal Case Frame with Beveled Edges & Corner Screws -->
      <div class="w-full p-4 sm:p-5 bg-gradient-to-b from-zinc-800 via-zinc-900 to-[#090a0f] rounded-3xl border-4 border-zinc-700/80 shadow-[0_30px_90px_rgba(0,0,0,0.95),inset_0_2px_4px_rgba(255,255,255,0.2)] relative overflow-hidden">
        
        <!-- Corner Screw Accents -->
        <div class="absolute top-3 left-3 w-2.5 h-2.5 rounded-full bg-gradient-to-br from-amber-200 to-amber-700 border border-amber-900/60 shadow-[0_1px_2px_rgba(0,0,0,0.8)] flex items-center justify-center text-[7px] text-black font-bold">+</div>
        <div class="absolute top-3 right-3 w-2.5 h-2.5 rounded-full bg-gradient-to-br from-amber-200 to-amber-700 border border-amber-900/60 shadow-[0_1px_2px_rgba(0,0,0,0.8)] flex items-center justify-center text-[7px] text-black font-bold">+</div>
        <div class="absolute bottom-3 left-3 w-2.5 h-2.5 rounded-full bg-gradient-to-br from-amber-200 to-amber-700 border border-amber-900/60 shadow-[0_1px_2px_rgba(0,0,0,0.8)] flex items-center justify-center text-[7px] text-black font-bold">+</div>
        <div class="absolute bottom-3 right-3 w-2.5 h-2.5 rounded-full bg-gradient-to-br from-amber-200 to-amber-700 border border-amber-900/60 shadow-[0_1px_2px_rgba(0,0,0,0.8)] flex items-center justify-center text-[7px] text-black font-bold">+</div>

        <!-- Chassis Header Bar with Engraved Brand & Status LEDs -->
        <div class="flex flex-col sm:flex-row items-center justify-between gap-2 pb-2.5 px-2 mb-2.5 border-b border-zinc-700/60">
          <div class="flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 shadow-[0_0_10px_rgba(52,211,153,0.9)] animate-pulse"></span>
            <span id="chassis-layout-label" class="font-mono font-extrabold text-[11px] sm:text-xs text-zinc-200 tracking-wider uppercase">
              DISPLAY TEST ONLINE // CNC PRO 3D CHASSIS [WINDOWS ANSI]
            </span>
          </div>

          <!-- LED Lock Status Indicator Bar -->
          <div class="flex items-center gap-4 text-[10px] font-mono font-bold text-zinc-400">
            <div class="flex items-center gap-1.5">
              <span id="led-caps" class="w-2 h-2 rounded-full bg-zinc-700 transition-all duration-150"></span>
              <span>CAPS</span>
            </div>
            <div class="flex items-center gap-1.5">
              <span id="led-num" class="w-2 h-2 rounded-full bg-zinc-700 transition-all duration-150"></span>
              <span>NUM</span>
            </div>
            <div class="flex items-center gap-1.5">
              <span id="led-scroll" class="w-2 h-2 rounded-full bg-zinc-700 transition-all duration-150"></span>
              <span>SCRL</span>
            </div>
          </div>
        </div>

        <!-- Inner Recessed Switch Plate Cavity (Fitted 100% Perfectly) -->
        <div id="keyboard-visual-grid" class="w-full space-y-1.5 sm:space-y-2 p-2.5 sm:p-4 rounded-2xl bg-zinc-950 border border-zinc-800/90 select-none shadow-[inset_0_4px_16px_rgba(0,0,0,0.95)] overflow-hidden">
          <!-- Rendered ONCE via JS into permanent DOM nodes for 0.1ms instant key reaction -->
        </div>

        <!-- Chassis Bottom Edge Dynamic RGB Glow Strip -->
        <div class="w-full h-1 bg-gradient-to-r from-emerald-500 via-cyan-500 to-purple-500 rounded-full blur-[2px] opacity-80 animate-pulse mt-2.5"></div>
      </div>
    </div>

    <!-- Dynamic Metrics Telemetry Grid -->
    <div class="relative z-10 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">
      <div class="bg-zinc-950/80 p-3.5 rounded-xl border border-zinc-800/80 text-center space-y-0.5">
        <div class="text-[10px] font-mono text-zinc-400 uppercase tracking-wider font-bold">Tested Matrix</div>
        <div id="metric-tested-keys" class="text-base sm:text-lg font-mono font-extrabold text-white">0 / 84 (0%)</div>
      </div>
      <div class="bg-zinc-950/80 p-3.5 rounded-xl border border-zinc-800/80 text-center space-y-0.5">
        <div class="text-[10px] font-mono text-zinc-400 uppercase tracking-wider font-bold">Active Held</div>
        <div id="metric-active-keys" class="text-base sm:text-lg font-mono font-extrabold text-cyan-400">0 Held</div>
      </div>
      <div class="bg-zinc-950/80 p-3.5 rounded-xl border border-zinc-800/80 text-center space-y-0.5">
        <div class="text-[10px] font-mono text-zinc-400 uppercase tracking-wider font-bold">Peak NKRO</div>
        <div id="metric-peak-nkro" class="text-base sm:text-lg font-mono font-extrabold text-emerald-400">0 Keys</div>
      </div>
      <div class="bg-zinc-950/80 p-3.5 rounded-xl border border-zinc-800/80 text-center space-y-0.5">
        <div class="text-[10px] font-mono text-zinc-400 uppercase tracking-wider font-bold">Chatter Defects</div>
        <div id="metric-chatter-alerts" class="text-base sm:text-lg font-mono font-extrabold text-emerald-400">0 Defects</div>
      </div>
      <div class="bg-zinc-950/80 p-3.5 rounded-xl border border-zinc-800/80 text-center space-y-0.5">
        <div class="text-[10px] font-mono text-zinc-400 uppercase tracking-wider font-bold">Typing Speed</div>
        <div id="metric-apm-speed" class="text-base sm:text-lg font-mono font-extrabold text-amber-400">0 APM</div>
      </div>
      <div class="bg-zinc-950/80 p-3.5 rounded-xl border border-zinc-800/80 text-center space-y-0.5">
        <div class="text-[10px] font-mono text-zinc-400 uppercase tracking-wider font-bold">NKRO Protocol</div>
        <div id="metric-nkro-status" class="text-base sm:text-lg font-mono font-extrabold text-emerald-400">READY</div>
      </div>
    </div>
  </div>
</div>

<script>
  import { KeyboardTesterState, ANSI_104_KEYS, MAC_KEYBOARD_KEYS, GAMING_COMBOS } from '../../engine/KeyboardTesterEngine';

  const state = new KeyboardTesterState();
  let currentLayout: 'win' | 'mac' = 'win';
  let currentMode: 'standard' | 'chatter' | 'combos' | 'heatmap' = 'standard';
  let soundType: 'none' | 'blue' | 'brown' | 'red' = 'blue';
  let audioCtx: AudioContext | null = null;
  let lockKeyTimers = new Map<string, number>();

  // Lock toggles state
  let capsLockToggled = false;
  let numLockToggled = false;
  let scrollLockToggled = false;

  // DOM node references map for ZERO DOM re-creation
  const keyDomMap = new Map<string, HTMLElement>();

  // DOM references
  const visualGrid = document.getElementById('keyboard-visual-grid');
  const liveKeysContainer = document.getElementById('live-keys-container');
  const activeEventCode = document.getElementById('active-event-code');
  const chatterWarningBadge = document.getElementById('chatter-warning-badge');
  const combosDeck = document.getElementById('combos-deck');
  const combosListContainer = document.getElementById('combos-list-container');
  const soundSelector = document.getElementById('sound-selector') as HTMLSelectElement;
  const resetBtn = document.getElementById('reset-suite-btn');
  const exportBtn = document.getElementById('export-cert-btn');
  const chassisLabel = document.getElementById('chassis-layout-label');

  // LEDs
  const ledCaps = document.getElementById('led-caps');
  const ledNum = document.getElementById('led-num');
  const ledScroll = document.getElementById('led-scroll');

  // Metrics DOM
  const metricTested = document.getElementById('metric-tested-keys');
  const metricActive = document.getElementById('metric-active-keys');
  const metricPeak = document.getElementById('metric-peak-nkro');
  const metricChatter = document.getElementById('metric-chatter-alerts');
  const metricApm = document.getElementById('metric-apm-speed');
  const metricNkro = document.getElementById('metric-nkro-status');

  // Buttons
  const layoutWin = document.getElementById('layout-win');
  const layoutMac = document.getElementById('layout-mac');
  const modeStandard = document.getElementById('mode-standard');
  const modeChatter = document.getElementById('mode-chatter');
  const modeCombos = document.getElementById('mode-combos');
  const modeHeatmap = document.getElementById('mode-heatmap');

  function initAudio() {
    if (!audioCtx && typeof window !== 'undefined') {
      const AudioContextClass = window.AudioContext || (window as unknown as { webkitAudioContext: typeof AudioContext }).webkitAudioContext;
      if (AudioContextClass) {
        audioCtx = new AudioContextClass();
      }
    }
    if (audioCtx && audioCtx.state === 'suspended') {
      audioCtx.resume();
    }
  }

  function playSwitchSound(type: string) {
    if (type === 'none') return;
    initAudio();
    if (!audioCtx) return;

    try {
      const osc = audioCtx.createOscillator();
      const gain = audioCtx.createGain();
      osc.connect(gain);
      gain.connect(audioCtx.destination);

      const now = audioCtx.currentTime;

      if (type === 'blue') {
        osc.type = 'triangle';
        osc.frequency.setValueAtTime(1400, now);
        osc.frequency.exponentialRampToValueAtTime(300, now + 0.03);
        gain.gain.setValueAtTime(0.3, now);
        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.03);
        osc.start(now);
        osc.stop(now + 0.03);
      } else if (type === 'brown') {
        osc.type = 'sine';
        osc.frequency.setValueAtTime(600, now);
        osc.frequency.exponentialRampToValueAtTime(120, now + 0.04);
        gain.gain.setValueAtTime(0.4, now);
        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.04);
        osc.start(now);
        osc.stop(now + 0.04);
      } else if (type === 'red') {
        osc.type = 'sine';
        osc.frequency.setValueAtTime(350, now);
        osc.frequency.exponentialRampToValueAtTime(80, now + 0.05);
        gain.gain.setValueAtTime(0.35, now);
        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.05);
        osc.start(now);
        osc.stop(now + 0.05);
      }
    } catch {
      // Ignore audio synthesis errors
    }
  }

  function getActiveLayout() {
    return currentLayout === 'mac' ? MAC_KEYBOARD_KEYS : ANSI_104_KEYS;
  }

  // Double-Shot PBT Keycap Base Classes (OEM 3D Profile)
  const BASE_KEYCAP_CLASS = 'relative flex flex-col justify-between p-1 sm:p-1.5 rounded-lg border text-xs font-mono transition-all duration-75 select-none overflow-hidden cursor-pointer bg-gradient-to-b from-zinc-700 via-zinc-800 to-zinc-900 border-zinc-600/80 text-zinc-100 shadow-[0_4px_0_0_#18181b,0_6px_12px_rgba(0,0,0,0.7)] hover:border-zinc-400 hover:text-white';
  const PRESSED_KEYCAP_CLASS = 'relative flex flex-col justify-between p-1 sm:p-1.5 rounded-lg border text-xs font-mono transition-all duration-75 select-none overflow-hidden cursor-pointer bg-gradient-to-b from-emerald-400 via-emerald-500 to-emerald-600 border-emerald-300 text-black font-extrabold translate-y-1 shadow-[0_1px_0_0_#047857,0_0_30px_rgba(52,211,153,0.95),inset_0_0_10px_rgba(255,255,255,0.6)]';
  const TESTED_KEYCAP_CLASS = 'relative flex flex-col justify-between p-1 sm:p-1.5 rounded-lg border text-xs font-mono transition-all duration-75 select-none overflow-hidden cursor-pointer bg-gradient-to-b from-zinc-800 via-zinc-850 to-zinc-900 border-emerald-500/50 text-zinc-100 font-bold shadow-[0_4px_0_0_#18181b]';
  const CHATTER_KEYCAP_CLASS = 'relative flex flex-col justify-between p-1 sm:p-1.5 rounded-lg border text-xs font-mono transition-all duration-75 select-none overflow-hidden cursor-pointer bg-gradient-to-b from-rose-600/50 to-rose-900/80 border-rose-500 text-rose-300 font-extrabold shadow-[0_4px_0_0_#4c0519,0_0_15px_rgba(244,63,94,0.7)]';

  // Build keycaps ONCE into permanent DOM nodes
  function initVisualGrid() {
    if (!visualGrid) return;
    visualGrid.innerHTML = '';
    keyDomMap.clear();

    const activeLayout = getActiveLayout();

    // Group keys by row
    const rowsMap = new Map<number, typeof activeLayout>();
    activeLayout.forEach(key => {
      const r = key.row;
      if (!rowsMap.has(r)) rowsMap.set(r, []);
      rowsMap.get(r)!.push(key);
    });

    rowsMap.forEach((rowKeys) => {
      const rowDiv = document.createElement('div');
      rowDiv.className = 'flex items-center gap-1 sm:gap-1.5 w-full flex-nowrap';

      rowKeys.forEach(k => {
        const w = k.width || 1.0;
        const keyEl = document.createElement('div');
        keyEl.id = `key-cap-${k.code}`;
        keyEl.dataset.code = k.code;
        keyEl.style.cssText = `flex: ${w} 1 0%; min-width: 0; height: 46px;`;
        keyEl.className = BASE_KEYCAP_CLASS;

        keyEl.innerHTML = `
          <div class="absolute inset-0 rounded-md bg-white/5 pointer-events-none shadow-[inset_0_1px_2px_rgba(255,255,255,0.2)]"></div>
          <div class="w-full flex items-start justify-between relative z-10 leading-none min-w-0">
            <span class="font-extrabold text-[10px] sm:text-xs tracking-tight text-zinc-100 truncate">${k.label}</span>
            <span id="tested-dot-${k.code}" class="hidden w-1.5 h-1.5 shrink-0 rounded-full bg-emerald-400 shadow-[0_0_4px_rgba(52,211,153,0.9)]"></span>
          </div>
          <div class="w-full flex items-end justify-end relative z-10 leading-none min-w-0">
            ${k.subLabel ? `<span class="text-[8px] sm:text-[9px] opacity-90 font-bold text-zinc-300 truncate">${k.subLabel}</span>` : ''}
          </div>
          <span id="chatter-ping-${k.code}" class="hidden absolute -top-1 -right-1 w-3 h-3 rounded-full bg-rose-500 animate-ping z-20"></span>
        `;

        rowDiv.appendChild(keyEl);
        keyDomMap.set(k.code, keyEl);
      });

      visualGrid.appendChild(rowDiv);
    });
  }

  // Fast targeted keycap styling update (0.1ms)
  function updateSingleKeycap(code: string) {
    const keyEl = keyDomMap.get(code);
    if (!keyEl) return;

    const isDirectlyActive = state.activeKeys.has(code);
    // CapsLock lock shine toggle: shines if directly pressed or toggled ON
    const isCapsShine = (code === 'CapsLock' && (isDirectlyActive || capsLockToggled));
    const isActive = isDirectlyActive || isCapsShine;

    const isTested = state.testedKeys.has(code);
    const tele = state.telemetryMap.get(code);
    const isChattered = tele && tele.chatterCount > 0;
    const chatterPing = document.getElementById(`chatter-ping-${code}`);
    const testedDot = document.getElementById(`tested-dot-${code}`);

    if (currentMode === 'heatmap') {
      const intensity = state.getHeatmapIntensity(code);
      if (intensity > 0) {
        if (intensity > 0.75) keyEl.className = 'relative flex flex-col justify-between p-1 sm:p-1.5 rounded-lg border text-xs font-mono transition-all duration-75 select-none overflow-hidden cursor-pointer bg-gradient-to-b from-rose-500 to-rose-700 border-rose-400 text-white font-extrabold shadow-[0_4px_0_0_#9f1239,0_0_20px_rgba(244,63,94,0.9)]';
        else if (intensity > 0.4) keyEl.className = 'relative flex flex-col justify-between p-1 sm:p-1.5 rounded-lg border text-xs font-mono transition-all duration-75 select-none overflow-hidden cursor-pointer bg-gradient-to-b from-amber-400 to-amber-600 border-amber-300 text-black font-extrabold shadow-[0_4px_0_0_#b45309,0_0_15px_rgba(245,158,11,0.8)]';
        else keyEl.className = 'relative flex flex-col justify-between p-1 sm:p-1.5 rounded-lg border text-xs font-mono transition-all duration-75 select-none overflow-hidden cursor-pointer bg-gradient-to-b from-emerald-400 to-emerald-600 border-emerald-300 text-black font-extrabold shadow-[0_4px_0_0_#047857,0_0_12px_rgba(16,185,129,0.7)]';
      }
    } else {
      if (isActive) {
        keyEl.className = PRESSED_KEYCAP_CLASS;
      } else if (isChattered) {
        keyEl.className = CHATTER_KEYCAP_CLASS;
      } else if (isTested) {
        keyEl.className = TESTED_KEYCAP_CLASS;
      } else {
        keyEl.className = BASE_KEYCAP_CLASS;
      }
    }

    if (testedDot) {
      if (isTested && !isActive) testedDot.classList.remove('hidden');
      else testedDot.classList.add('hidden');
    }

    if (chatterPing) {
      if (isChattered) chatterPing.classList.remove('hidden');
      else chatterPing.classList.add('hidden');
    }
  }

  function updateAllKeycaps() {
    keyDomMap.forEach((_, code) => updateSingleKeycap(code));
  }

  function renderCombos() {
    if (!combosListContainer) return;
    let html = '';
    GAMING_COMBOS.forEach(combo => {
      const activeKeysSet = state.activeKeys;
      const isComplete = combo.keys.every(k => activeKeysSet.has(k));

      const statusBadge = isComplete
        ? `<span class="px-2 py-0.5 rounded bg-emerald-500/20 border border-emerald-500/50 text-emerald-400 font-bold text-[10px] shadow-[0_0_8px_rgba(5,150,105,0.4)]">PASSED</span>`
        : `<span class="px-2 py-0.5 rounded bg-zinc-900 border border-zinc-800 text-zinc-500 text-[10px]">WAITING</span>`;

      html += `
        <div class="p-2.5 rounded-lg bg-zinc-950/80 border border-zinc-800 flex items-center justify-between text-xs font-mono">
          <div>
            <div class="font-bold text-white text-[11px]">${combo.name}</div>
            <div class="text-[9px] text-zinc-400 mt-0.5">${combo.keys.join(' + ')}</div>
          </div>
          ${statusBadge}
        </div>
      `;
    });
    combosListContainer.innerHTML = html;
  }

  function updateTelemetry(lastCode?: string, event?: KeyboardEvent) {
    const activeLayout = getActiveLayout();
    const report = state.generateReport(activeLayout, Date.now());

    if (metricTested) metricTested.textContent = `${report.testedKeysCount} / ${report.totalLayoutKeysCount} (${report.coveragePercent}%)`;
    if (metricActive) metricActive.textContent = `${report.activeKeysCount} Held`;
    if (metricPeak) metricPeak.textContent = `${report.peakSimultaneousKeys} Keys`;
    if (metricChatter) {
      if (report.chatterAlertCount > 0) {
        metricChatter.textContent = `${report.chatterAlertCount} Defects!`;
        metricChatter.className = 'text-base sm:text-lg font-mono font-extrabold text-rose-400 animate-pulse';
      } else {
        metricChatter.textContent = '0 Defects';
        metricChatter.className = 'text-base sm:text-lg font-mono font-extrabold text-emerald-400';
      }
    }
    if (metricApm) metricApm.textContent = `${report.apm} APM`;
    if (metricNkro) metricNkro.textContent = report.isNkroCompliant ? 'NKRO VERIFIED' : '6KRO / TESTING';

    // Update LED Lock Indicators using OS getModifierState or internal toggle state
    if (event && event.getModifierState) {
      capsLockToggled = event.getModifierState('CapsLock');
      numLockToggled = event.getModifierState('NumLock');
      scrollLockToggled = event.getModifierState('ScrollLock');
    }

    if (ledCaps) {
      ledCaps.className = capsLockToggled
        ? 'w-2 h-2 rounded-full bg-emerald-400 shadow-[0_0_8px_rgba(52,211,153,0.9)] animate-pulse'
        : 'w-2 h-2 rounded-full bg-zinc-700';
    }
    if (ledNum) {
      ledNum.className = numLockToggled
        ? 'w-2 h-2 rounded-full bg-emerald-400 shadow-[0_0_8px_rgba(52,211,153,0.9)] animate-pulse'
        : 'w-2 h-2 rounded-full bg-zinc-700';
    }
    if (ledScroll) {
      ledScroll.className = scrollLockToggled
        ? 'w-2 h-2 rounded-full bg-emerald-400 shadow-[0_0_8px_rgba(52,211,153,0.9)] animate-pulse'
        : 'w-2 h-2 rounded-full bg-zinc-700';
    }

    // Update live keys display pills
    if (liveKeysContainer) {
      if (state.activeKeys.size === 0) {
        liveKeysContainer.innerHTML = `<span class="text-xs font-mono text-zinc-500 italic">Press any keys simultaneously on your physical keyboard to audit matrix signals...</span>`;
      } else {
        liveKeysContainer.innerHTML = Array.from(state.activeKeys)
          .map(c => `<span class="px-2.5 py-1 rounded-md bg-emerald-500/20 border border-emerald-500/50 text-emerald-300 font-mono font-bold text-xs shadow-[0_0_10px_rgba(5,150,105,0.4)] animate-pulse">${c}</span>`)
          .join('');
      }
    }

    if (lastCode) {
      updateSingleKeycap(lastCode);
    } else {
      updateAllKeycaps();
    }

    if (currentMode === 'combos') renderCombos();
  }

  // Microsecond-accurate Event Listeners with Perfect CapsLock Toggle Light Fix
  window.addEventListener('keydown', (e) => {
    const isNavKey = e.key === 'F5' || e.key === 'F12' || ((e.metaKey || e.ctrlKey) && ['r', 'R', 'w', 'W', 'i', 'I'].includes(e.key));
    if (!isNavKey) {
      e.preventDefault();
    }
    initAudio();

    // Toggle Lock Key logic: CapsLock shines on 1st press, goes normal on 2nd press
    if (e.code === 'CapsLock') {
      if (!e.repeat) {
        capsLockToggled = !capsLockToggled;
      }
    }

    const { isChatter, deltaMs } = state.processKeyDown(e.code, performance.now());

    playSwitchSound(soundType);

    if (activeEventCode) {
      activeEventCode.textContent = `${e.code} (${e.key === ' ' ? 'Space' : e.key})`;
    }

    if (isChatter && chatterWarningBadge) {
      chatterWarningBadge.classList.remove('hidden');
      chatterWarningBadge.classList.add('flex');
      chatterWarningBadge.textContent = `⚠️ SWITCH CHATTER DETECTED: ${e.code} (${Math.round(deltaMs)}ms)!`;
    }

    updateTelemetry(e.code, e);
  });

  window.addEventListener('keyup', (e) => {
    const isNavKey = e.key === 'F5' || e.key === 'F12' || ((e.metaKey || e.ctrlKey) && ['r', 'R', 'w', 'W', 'i', 'I'].includes(e.key));
    if (!isNavKey) {
      e.preventDefault();
    }
    state.processKeyUp(e.code, performance.now());
    updateTelemetry(e.code, e);
  });

  soundSelector?.addEventListener('change', (e) => {
    soundType = (e.target as HTMLSelectElement).value as 'none' | 'blue' | 'brown' | 'red';
  });

  resetBtn?.addEventListener('click', () => {
    state.reset();
    capsLockToggled = false;
    numLockToggled = false;
    scrollLockToggled = false;
    if (chatterWarningBadge) {
      chatterWarningBadge.classList.add('hidden');
      chatterWarningBadge.classList.remove('flex');
    }
    if (activeEventCode) activeEventCode.textContent = 'Awaiting physical keypress...';
    updateTelemetry();
  });

  exportBtn?.addEventListener('click', () => {
    const activeLayout = getActiveLayout();
    const report = state.generateReport(activeLayout, Date.now());
    const certificate = {
      title: `Display Test Online — Keyboard Health Certificate [${currentLayout.toUpperCase()}]`,
      timestamp: new Date().toISOString(),
      userAgent: navigator.userAgent,
      layout: currentLayout,
      telemetry: report,
      keyDetails: Array.from(state.telemetryMap.values())
    };

    const blob = new Blob([JSON.stringify(certificate, null, 2)], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `keyboard-health-passport-${currentLayout}-${Date.now()}.json`;
    a.click();
    URL.revokeObjectURL(url);
  });

  // OS Layout Switchers
  layoutWin?.addEventListener('click', () => {
    currentLayout = 'win';
    if (layoutWin) layoutWin.className = 'layout-btn px-3 py-1.5 rounded-lg font-bold bg-emerald-500/20 text-emerald-400 border border-emerald-500/40 cursor-pointer transition-all flex items-center gap-1.5 shadow-sm';
    if (layoutMac) layoutMac.className = 'layout-btn px-3 py-1.5 rounded-lg font-semibold text-zinc-400 hover:text-white cursor-pointer transition-all flex items-center gap-1.5';
    if (chassisLabel) chassisLabel.textContent = 'DISPLAY TEST ONLINE // CNC PRO 3D CHASSIS [WINDOWS ANSI]';
    initVisualGrid();
    updateTelemetry();
  });

  layoutMac?.addEventListener('click', () => {
    currentLayout = 'mac';
    if (layoutMac) layoutMac.className = 'layout-btn px-3 py-1.5 rounded-lg font-bold bg-emerald-500/20 text-emerald-400 border border-emerald-500/40 cursor-pointer transition-all flex items-center gap-1.5 shadow-sm';
    if (layoutWin) layoutWin.className = 'layout-btn px-3 py-1.5 rounded-lg font-semibold text-zinc-400 hover:text-white cursor-pointer transition-all flex items-center gap-1.5';
    if (chassisLabel) chassisLabel.textContent = 'DISPLAY TEST ONLINE // CNC PRO 3D CHASSIS [MACOS LAYOUT]';
    initVisualGrid();
    updateTelemetry();
  });

  // Mode button handlers
  const setMode = (mode: 'standard' | 'chatter' | 'combos' | 'heatmap') => {
    currentMode = mode;
    [modeStandard, modeChatter, modeCombos, modeHeatmap].forEach(btn => {
      if (btn) btn.className = 'mode-btn px-3 py-1.5 rounded-lg font-semibold text-zinc-400 hover:text-white cursor-pointer transition-all flex items-center gap-1.5';
    });

    if (mode === 'standard' && modeStandard) modeStandard.className = 'mode-btn px-3 py-1.5 rounded-lg font-bold bg-emerald-500/20 text-emerald-400 border border-emerald-500/40 cursor-pointer transition-all flex items-center gap-1.5 shadow-sm';
    if (mode === 'chatter' && modeChatter) modeChatter.className = 'mode-btn px-3 py-1.5 rounded-lg font-bold bg-rose-500/20 text-rose-400 border border-rose-500/40 cursor-pointer transition-all flex items-center gap-1.5 shadow-sm';
    if (mode === 'combos' && modeCombos) modeCombos.className = 'mode-btn px-3 py-1.5 rounded-lg font-bold bg-blue-500/20 text-blue-400 border border-blue-500/40 cursor-pointer transition-all flex items-center gap-1.5 shadow-sm';
    if (mode === 'heatmap' && modeHeatmap) modeHeatmap.className = 'mode-btn px-3 py-1.5 rounded-lg font-bold bg-amber-500/20 text-amber-400 border border-amber-500/40 cursor-pointer transition-all flex items-center gap-1.5 shadow-sm';

    if (combosDeck) {
      if (mode === 'combos') {
        combosDeck.classList.remove('hidden');
        renderCombos();
      } else {
        combosDeck.classList.add('hidden');
      }
    }

    updateAllKeycaps();
  };

  modeStandard?.addEventListener('click', () => setMode('standard'));
  modeChatter?.addEventListener('click', () => setMode('chatter'));
  modeCombos?.addEventListener('click', () => setMode('combos'));
  modeHeatmap?.addEventListener('click', () => setMode('heatmap'));

  // Initial render
  initVisualGrid();
  updateTelemetry();
</script>
