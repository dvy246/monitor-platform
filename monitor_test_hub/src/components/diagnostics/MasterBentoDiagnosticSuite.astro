---
/**
 * MasterBentoDiagnosticSuite.astro
 * Master 8-part bento diagnostic experience bringing together:
 * 1. Primary Fullscreen Stage Box (ZERO text in fullscreen mode)
 * 2. Screen Information Card
 * 3. Quick Color Palette Grid
 * 4. Custom Color Picker
 * 5. Keyboard Shortcuts Card
 * 6. Tool Controls Tuning Panel
 * 7. Diagnostic Context Disclosure Panel
 * 8. Diagnostic Result Status Panel
 */
import ScreenInfoCard from './ScreenInfoCard.astro';
import QuickColorPalette from './QuickColorPalette.astro';
import CustomColorPicker from './CustomColorPicker.astro';
import KeyboardShortcutsCard from './KeyboardShortcutsCard.astro';
import ToolControlsCard from './ToolControlsCard.astro';
import DiagnosticContextPanel from './DiagnosticContextPanel.astro';
import DiagnosticResultPanel from './DiagnosticResultPanel.astro';

interface Props {
  initialColor?: string;
  testTitle?: string;
  class?: string;
}

const { 
  initialColor = '#FFFFFF',
  testTitle = 'Display & Pixel Diagnostics',
  class: className = '' 
} = Astro.props;

const colorSpectrum = [
  { name: 'White', hex: '#FFFFFF' },
  { name: 'Black', hex: '#000000' },
  { name: 'Red', hex: '#EF4444' },
  { name: 'Green', hex: '#22C55E' },
  { name: 'Blue', hex: '#3B82F6' },
  { name: 'Cyan', hex: '#06B6D4' },
  { name: 'Magenta', hex: '#D946EF' },
  { name: 'Yellow', hex: '#EAB308' },
  { name: 'Orange', hex: '#F97316' },
  { name: 'Purple', hex: '#8B5CF6' },
  { name: 'Dark Gray', hex: '#1F2937' },
  { name: 'Light Gray', hex: '#D1D5DB' }
];
---

<div class:list={["master-bento-suite w-full max-w-6xl mx-auto space-y-6 font-sans select-none p-2 sm:p-4", className]} data-fullscreen-target="true">
  
  <!-- 1. Primary Fullscreen Canvas Stage (ZERO TEXT in Fullscreen Mode) -->
  <div 
    id="master-canvas-box"
    class="relative w-full h-[320px] sm:h-[480px] rounded-3xl border border-white/20 shadow-[0_25px_60px_rgba(0,0,0,0.8)] flex flex-col items-center justify-center transition-colors duration-300 cursor-pointer overflow-hidden group select-none"
    style={`background-color: ${initialColor};`}
    title="Click to Enter Fullscreen Diagnostic Mode (ZERO Text in Fullscreen)"
    data-color-index="0"
  >
    <!-- Ambient Radial Glow Overlay (Hidden in Fullscreen) -->
    <div data-fullscreen-hide="true" class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-black/30 pointer-events-none transition-opacity duration-300 group-hover:opacity-80"></div>

    <!-- Center Notice Badge (Hidden 100% in Fullscreen) -->
    <div 
      id="master-center-notice"
      data-fullscreen-hide="true"
      class="z-10 bg-[#0d0d12]/90 backdrop-blur-2xl px-7 py-6 sm:px-9 sm:py-8 rounded-3xl border border-white/20 text-center space-y-3 max-w-md pointer-events-none group-hover:border-emerald-500/50 transition-colors duration-300 shadow-[0_20px_50px_rgba(0,0,0,0.9)]"
    >
      <div class="w-12 h-12 sm:w-14 sm:h-14 mx-auto rounded-2xl bg-white/10 border border-white/20 flex items-center justify-center text-white mb-1 shadow-[inset_0_1px_1px_rgba(255,255,255,0.3)]">
        <svg class="w-6 h-6 sm:w-7 sm:h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 8V5a2 2 0 012-2h3m11 0h3a2 2 0 012 2v3m0 11v3a2 2 0 01-2 2h-3m-11 0H5a2 2 0 01-2-2v-3"/>
        </svg>
      </div>
      <h2 class="text-lg sm:text-xl font-black text-white tracking-tight">Click to Enter Fullscreen Test</h2>
      <p class="text-xs text-zinc-300 font-sans leading-relaxed">
        Inspect panel for dead pixels, stuck subpixels, uniform brightness, and backlight bleed
      </p>
      <div class="pt-1.5 text-[11px] font-mono text-emerald-400 font-bold uppercase tracking-wider flex items-center justify-center gap-2 bg-emerald-500/10 px-3 py-1.5 rounded-full border border-emerald-500/20">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span>Active: <span id="master-active-color-name">White</span> (<span id="master-active-hex">#FFFFFF</span>)</span>
      </div>
    </div>

    <!-- Bottom Left Active Color Readout (Hidden in Fullscreen) -->
    <div data-fullscreen-hide="true" class="absolute bottom-4 left-4 z-10 text-xs font-mono text-zinc-300 bg-[#0d0d12]/80 px-4 py-2 rounded-2xl backdrop-blur-xl border border-white/15 flex items-center gap-2.5 pointer-events-none shadow-lg">
      <span id="master-bottom-dot" class="w-3 h-3 rounded-full border border-white/30" style={`background-color: ${initialColor};`}></span>
      <span><span id="master-bottom-name" class="font-bold text-white">White</span> · <span id="master-bottom-hex" class="text-zinc-400">#FFFFFF</span></span>
    </div>

    <!-- Bottom Right Fullscreen Hint (Hidden in Fullscreen) -->
    <div data-fullscreen-hide="true" class="absolute bottom-4 right-4 z-10 text-xs font-mono text-zinc-300 bg-[#0d0d12]/80 px-4 py-2 rounded-2xl backdrop-blur-xl border border-white/15 pointer-events-none shadow-lg flex items-center gap-2">
      <kbd class="px-2 py-0.5 rounded-lg bg-white/10 text-white font-bold text-[10px] border border-white/20">F</kbd>
      <span>Fullscreen</span>
    </div>
  </div>

  <!-- Bento Deck Grid Layout -->
  <!-- Row 1: Screen Info + Quick Color Palette -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
    <ScreenInfoCard />
    <QuickColorPalette activeHex={initialColor} activeName="White" />
  </div>

  <!-- Row 2: Keyboard Shortcuts + Custom Color Picker -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
    <KeyboardShortcutsCard />
    <CustomColorPicker initialColor={initialColor} />
  </div>

  <!-- Row 3: Tool Controls Panel -->
  <ToolControlsCard />

  <!-- Row 4: Diagnostic Context + Diagnostic Result -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
    <DiagnosticContextPanel testTitle={testTitle} />
    <DiagnosticResultPanel />
  </div>
</div>

<style>
  /* STRICT ZERO-TEXT FULLSCREEN RULE */
  :fullscreen [data-fullscreen-hide="true"],
  :-webkit-full-screen [data-fullscreen-hide="true"],
  :-moz-full-screen [data-fullscreen-hide="true"] {
    display: none !important;
    opacity: 0 !important;
    visibility: hidden !important;
  }
</style>

<script>
  function initMasterBentoSuite() {
    const canvasBox = document.getElementById('master-canvas-box') as HTMLDivElement;
    const activeName = document.getElementById('master-active-color-name') as HTMLSpanElement;
    const activeHex = document.getElementById('master-active-hex') as HTMLSpanElement;
    const bottomName = document.getElementById('master-bottom-name') as HTMLSpanElement;
    const bottomHex = document.getElementById('master-bottom-hex') as HTMLSpanElement;
    const bottomDot = document.getElementById('master-bottom-dot') as HTMLSpanElement;

    const colors = [
      { name: 'White', hex: '#FFFFFF' },
      { name: 'Black', hex: '#000000' },
      { name: 'Red', hex: '#EF4444' },
      { name: 'Green', hex: '#22C55E' },
      { name: 'Blue', hex: '#3B82F6' },
      { name: 'Cyan', hex: '#06B6D4' },
      { name: 'Magenta', hex: '#D946EF' },
      { name: 'Yellow', hex: '#EAB308' },
      { name: 'Orange', hex: '#F97316' },
      { name: 'Purple', hex: '#8B5CF6' },
      { name: 'Dark Gray', hex: '#1F2937' },
      { name: 'Light Gray', hex: '#D1D5DB' }
    ];

    let currentIndex = 0;
    let autoCycleTimer: ReturnType<typeof setInterval> | null = null;

    function applyColor(hex: string, name: string) {
      const cleanHex = hex.toUpperCase();
      if (canvasBox) {
        canvasBox.style.backgroundColor = cleanHex;
      }
      if (activeName) activeName.textContent = name;
      if (activeHex) activeHex.textContent = cleanHex;
      if (bottomName) bottomName.textContent = name;
      if (bottomHex) bottomHex.textContent = cleanHex;
      if (bottomDot) bottomDot.style.backgroundColor = cleanHex;

      // Find index in spectrum if present
      const foundIdx = colors.findIndex(c => c.hex.toUpperCase() === cleanHex);
      if (foundIdx !== -1) currentIndex = foundIdx;
    }

    function cycleColor(dir: number = 1) {
      currentIndex = (currentIndex + dir + colors.length) % colors.length;
      const target = colors[currentIndex];
      applyColor(target.hex, target.name);
      window.dispatchEvent(new CustomEvent('dt-color-change', { detail: target }));
    }

    // Custom event sync
    window.addEventListener('dt-color-change', (e: Event) => {
      const detail = (e as CustomEvent).detail;
      if (detail && detail.hex) {
        applyColor(detail.hex, detail.name || 'Custom Color');
      }
    });

    window.addEventListener('dt-reset', () => {
      currentIndex = 0;
      applyColor(colors[0].hex, colors[0].name);
      window.dispatchEvent(new CustomEvent('dt-color-change', { detail: colors[0] }));
    });

    // Tool Controls adjustment reaction
    window.addEventListener('dt-control-change', (e: Event) => {
      const detail = (e as CustomEvent).detail;
      if (detail && canvasBox) {
        if (detail.controlId === 'opacity') {
          canvasBox.style.opacity = String(detail.value / 100);
        } else if (detail.controlId === 'brightness') {
          canvasBox.style.filter = `brightness(${detail.value}%)`;
        } else if (detail.controlId === 'contrast') {
          canvasBox.style.filter = `contrast(${detail.value}%)`;
        }
      }
    });

    // Toggle Fullscreen
    function toggleFullscreen() {
      if (!canvasBox) return;
      if (!document.fullscreenElement) {
        canvasBox.requestFullscreen().catch(() => {});
      } else {
        document.exitFullscreen().catch(() => {});
      }
    }

    canvasBox?.addEventListener('click', () => {
      if (document.fullscreenElement) {
        cycleColor(1);
      } else {
        toggleFullscreen();
      }
    });

    // Global hotkey support
    document.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.target instanceof HTMLInputElement || e.target instanceof HTMLTextAreaElement) return;

      if (e.key === 'ArrowRight' || e.key === 'ArrowUp') {
        cycleColor(1);
      } else if (e.key === 'ArrowLeft' || e.key === 'ArrowDown') {
        cycleColor(-1);
      } else if (e.key === 'f' || e.key === 'F') {
        e.preventDefault();
        toggleFullscreen();
      } else if (e.key === 'r' || e.key === 'R') {
        currentIndex = 0;
        applyColor(colors[0].hex, colors[0].name);
        window.dispatchEvent(new CustomEvent('dt-color-change', { detail: colors[0] }));
      } else if (e.key === 'Home') {
        currentIndex = 0;
        applyColor(colors[0].hex, colors[0].name);
        window.dispatchEvent(new CustomEvent('dt-color-change', { detail: colors[0] }));
      } else if (e.key === ' ') {
        e.preventDefault();
        if (autoCycleTimer) {
          clearInterval(autoCycleTimer);
          autoCycleTimer = null;
        } else {
          autoCycleTimer = setInterval(() => cycleColor(1), 2000);
        }
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMasterBentoSuite);
  } else {
    initMasterBentoSuite();
  }
</script>
