---
/**
 * MidiTesterCanvas.astro
 * Engineering-Grade Web MIDI API Instrument & Keyboard Diagnostic Suite.
 * Features:
 * - W3C Web MIDI API (`navigator.requestMIDIAccess`) integration.
 * - 88-Key Virtual & Hardware Piano Keyboard Visualizer.
 * - Real-Time Note On, Note Off, Velocity (0-127), Control Change (CC), Pitch Bend & Channel Telemetry.
 * - Local In-Browser Execution.
 */
---

<div class="w-full max-w-5xl mx-auto space-y-6 font-sans select-none min-w-0" id="midi-test-root">
  <div class="relative bg-[#0c0d12]/90 border border-zinc-800/90 rounded-2xl p-4 sm:p-6 backdrop-blur-2xl shadow-[0_25px_60px_rgba(0,0,0,0.8)] space-y-6 overflow-hidden">
    <!-- Ambient Radial Glows -->
    <div class="absolute -top-24 -right-24 w-96 h-96 bg-purple-500/10 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-24 -left-24 w-96 h-96 bg-cyan-500/10 rounded-full blur-3xl pointer-events-none"></div>

    <div class="relative z-10 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 border-b border-zinc-800/70 pb-5">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-purple-500/10 border border-purple-500/30 text-[11px] font-mono text-purple-400 font-bold uppercase tracking-wider mb-2">
          <span class="w-2 h-2 rounded-full bg-purple-400 shadow-[0_0_8px_rgba(192,132,252,0.9)] animate-pulse"></span>
          <span>W3C WEB MIDI API DIAGNOSTIC ENGINE</span>
        </div>
        <h2 class="text-xl sm:text-2xl font-bold font-mono text-white tracking-tight">Web MIDI Keyboard &amp; Controller Inspector</h2>
      </div>

      <button id="midi-connect-btn" class="px-4 py-2 rounded-xl bg-purple-500/20 text-purple-400 border border-purple-500/40 text-xs font-mono font-bold hover:bg-purple-500/30 cursor-pointer transition-all">
        Connect MIDI Device
      </button>
    </div>

    <!-- MIDI Status & Telemetry Grid -->
    <div class="relative z-10 grid grid-cols-2 sm:grid-cols-4 gap-4 font-mono">
      <div class="bg-zinc-950 p-4 rounded-xl border border-zinc-800 text-center space-y-1">
        <div class="text-xs text-zinc-400 font-bold uppercase">Note Name</div>
        <div id="midi-note-name" class="text-4xl font-extrabold text-purple-400 tabular-nums">--</div>
        <div class="text-[10px] text-zinc-400">Active Key</div>
      </div>

      <div class="bg-zinc-950 p-4 rounded-xl border border-zinc-800 text-center space-y-1">
        <div class="text-xs text-zinc-400 font-bold uppercase">Velocity</div>
        <div id="midi-velocity-val" class="text-4xl font-extrabold text-emerald-400 tabular-nums">0</div>
        <div class="text-[10px] text-zinc-400">Key Pressure (0-127)</div>
      </div>

      <div class="bg-zinc-950 p-4 rounded-xl border border-zinc-800 text-center space-y-1">
        <div class="text-xs text-zinc-400 font-bold uppercase">Pitch Bend</div>
        <div id="midi-pitch-val" class="text-4xl font-extrabold text-cyan-400 tabular-nums">8192</div>
        <div class="text-[10px] text-zinc-400">14-bit Wheel Position</div>
      </div>

      <div class="bg-zinc-950 p-4 rounded-xl border border-zinc-800 text-center space-y-1">
        <div class="text-xs text-zinc-400 font-bold uppercase">MIDI Channel</div>
        <div id="midi-channel-val" class="text-4xl font-extrabold text-amber-400 tabular-nums">Ch 1</div>
        <div class="text-[10px] text-zinc-400">Input Port</div>
      </div>
    </div>

    <!-- Interactive 88-Key Piano Keyboard Display -->
    <div class="relative z-10 bg-zinc-950 rounded-2xl border border-zinc-800/90 p-4 overflow-x-auto shadow-[inset_0_4px_16px_rgba(0,0,0,0.95)]">
      <div id="piano-keyboard" class="flex justify-center min-w-[700px] h-32 relative select-none">
        <!-- Piano keys generated by JS script -->
      </div>
    </div>
  </div>
</div>

<script>
  let midiAccess: WebMidi.MIDIAccess | null = null;
  const noteNameEl = document.getElementById('midi-note-name');
  const velocityEl = document.getElementById('midi-velocity-val');
  const pitchEl = document.getElementById('midi-pitch-val');
  const channelEl = document.getElementById('midi-channel-val');
  const connectBtn = document.getElementById('midi-connect-btn');
  const pianoContainer = document.getElementById('piano-keyboard');

  const NOTE_NAMES = ['C', 'C#', 'D', 'D#', 'E', 'F', 'F#', 'G', 'G#', 'A', 'A#', 'B'];

  // Render 24 Piano Keys (2 Octaves) for visual UI
  function renderPianoKeys() {
    if (!pianoContainer) return;
    let html = '';
    for (let i = 48; i <= 72; i++) {
      const noteInOctave = i % 12;
      const isBlack = [1, 3, 6, 8, 10].includes(noteInOctave);
      if (isBlack) {
        html += `<div data-note="${i}" class="piano-key key-black w-6 h-20 bg-zinc-900 border border-zinc-700 rounded-b absolute z-10 hover:bg-purple-500 cursor-pointer shadow-md" style="left: ${(i - 48) * 24}px"></div>`;
      } else {
        html += `<div data-note="${i}" class="piano-key key-white w-8 h-32 bg-zinc-200 border border-zinc-400 rounded-b flex flex-col justify-end p-1 text-[10px] font-mono text-zinc-700 hover:bg-purple-200 cursor-pointer shadow-sm">${NOTE_NAMES[noteInOctave]}</div>`;
      }
    }
    pianoContainer.innerHTML = html;
  }

  function handleMIDIMessage(event: WebMidi.MIDIMessageEvent) {
    const data = event.data;
    if (!data || data.length < 3) return;

    const command = data[0] >> 4;
    const channel = (data[0] & 0xf) + 1;
    const note = data[1];
    const velocity = data[2];

    if (channelEl) channelEl.textContent = `Ch ${channel}`;

    if (command === 9 && velocity > 0) {
      // Note On
      const noteName = `${NOTE_NAMES[note % 12]}${Math.floor(note / 12) - 1}`;
      if (noteNameEl) noteNameEl.textContent = noteName;
      if (velocityEl) velocityEl.textContent = velocity.toString();

      const keyEl = document.querySelector(`[data-note="${note}"]`);
      if (keyEl) keyEl.classList.add('bg-purple-500', 'text-white');
    } else if (command === 8 || (command === 9 && velocity === 0)) {
      // Note Off
      const keyEl = document.querySelector(`[data-note="${note}"]`);
      if (keyEl) keyEl.classList.remove('bg-purple-500', 'text-white');
    } else if (command === 14) {
      // Pitch Bend (14-bit)
      const bend = data[1] | (data[2] << 7);
      if (pitchEl) pitchEl.textContent = bend.toString();
    }
  }

  async function initMIDI() {
    if (navigator.requestMIDIAccess) {
      try {
        midiAccess = await navigator.requestMIDIAccess();
        for (const input of midiAccess.inputs.values()) {
          input.onmidimessage = handleMIDIMessage;
        }
        if (connectBtn) {
          connectBtn.textContent = 'MIDI Connected ✓';
          connectBtn.className = 'px-4 py-2 rounded-xl bg-emerald-500/20 text-emerald-400 border border-emerald-500/40 text-xs font-mono font-bold';
        }
      } catch {
        alert('Web MIDI API access denied or unsupported by browser.');
      }
    } else {
      alert('Web MIDI API is not supported in this browser. Please use Chrome, Edge, or Opera.');
    }
  }

  connectBtn?.addEventListener('click', initMIDI);
  renderPianoKeys();
</script>
