---
export interface TelemetryReceiptEntry {
  signatureHash: string;
  timestampIso: string;
  resolution: string;
  vsyncFps: number;
  colorDepthBits: number;
  deadPixels: number;
  stuckPixels: number;
  healthScore: number;
  displayTech: string;
  userAgentOs: string;
  verificationVerified: boolean;
}

interface Props {
  receipts: TelemetryReceiptEntry[];
  modelSlug: string;
  totalEntries: number;
}

const { receipts, modelSlug, totalEntries } = Astro.props;
---

<div class="w-full bg-bg-surface border border-border-hairline rounded-2xl shadow-2xl overflow-hidden font-mono text-xs">
  
  <!-- Table Header Bar -->
  <div class="px-6 py-4 border-b border-border-hairline bg-bg-elevated flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
    <div class="flex items-center gap-2.5">
      <span class="w-2.5 h-2.5 rounded-full bg-status-pass led-glow-pass"></span>
      <div>
        <h2 class="text-sm font-bold text-text-primary uppercase tracking-wider font-sans">VERIFIED TELEMETRY RECEIPTS</h2>
        <p class="text-[10px] text-text-muted">REAL-TIME SHA-256 SIGNED COMMUNITY HARDWARE LOGS</p>
      </div>
    </div>

    <!-- Filter / Live Stats Pill -->
    <div class="flex items-center gap-2 text-[10px]">
      <span class="px-2.5 py-1 rounded-md bg-bg-canvas border border-border-hairline text-text-secondary">
        Showing <strong class="text-text-primary">{receipts.length}</strong> of <strong class="text-text-primary">{totalEntries}</strong> entries
      </span>
    </div>
  </div>

  <!-- Desktop Table View (Hidden on mobile) -->
  <div class="hidden md:block overflow-x-auto">
    <table class="w-full text-left border-collapse">
      <thead>
        <tr class="border-b border-border-hairline bg-bg-canvas text-[10px] text-text-muted uppercase tracking-wider">
          <th class="py-3 px-6">Receipt SHA-256 Hash</th>
          <th class="py-3 px-4">Timestamp (UTC)</th>
          <th class="py-3 px-4">Resolution &amp; VSync</th>
          <th class="py-3 px-4">Defect Status</th>
          <th class="py-3 px-4 text-center">Health Index</th>
          <th class="py-3 px-6 text-right">Action</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-border-hairline">
        {receipts.map((entry) => {
          const isPass = entry.deadPixels === 0 && entry.stuckPixels === 0;
          const scoreColor = entry.healthScore >= 90 ? 'text-status-pass bg-status-pass/10 border-status-pass/30' : 'text-status-warn bg-status-warn/10 border-status-warn/30';

          return (
            <tr class="hover:bg-bg-elevated/60 transition-colors group">
              <!-- Hash & Verification -->
              <td class="py-3.5 px-6">
                <div class="flex items-center gap-2">
                  <svg class="w-3.5 h-3.5 text-status-pass shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  <a 
                    href={`/passport/${entry.signatureHash}`}
                    class="font-bold text-text-primary group-hover:text-status-pass hover:underline tracking-wider"
                  >
                    #{entry.signatureHash.slice(0, 10)}...
                  </a>
                </div>
              </td>

              <!-- Timestamp -->
              <td class="py-3.5 px-4 text-text-secondary text-[11px]">
                {entry.timestampIso.replace('T', ' ').slice(0, 16)}
              </td>

              <!-- Resolution & VSync -->
              <td class="py-3.5 px-4">
                <span class="px-2 py-0.5 rounded bg-bg-canvas border border-border-hairline text-text-primary text-[11px]">
                  {entry.resolution} @ <strong class="text-status-pass">{entry.vsyncFps}Hz</strong>
                </span>
              </td>

              <!-- Defect Status -->
              <td class="py-3.5 px-4">
                {isPass ? (
                  <span class="inline-flex items-center gap-1 text-[10px] font-bold text-status-pass">
                    <span class="w-1.5 h-1.5 rounded-full bg-status-pass"></span>
                    0 Defect (ISO Class I Pass)
                  </span>
                ) : (
                  <span class="inline-flex items-center gap-1 text-[10px] font-bold text-status-warn">
                    <span class="w-1.5 h-1.5 rounded-full bg-status-warn"></span>
                    {entry.deadPixels} Dead / {entry.stuckPixels} Stuck
                  </span>
                )}
              </td>

              <!-- Health Index Score -->
              <td class="py-3.5 px-4 text-center">
                <span class={`inline-block px-2.5 py-0.5 rounded text-xs font-extrabold border ${scoreColor}`}>
                  {entry.healthScore} / 100
                </span>
              </td>

              <!-- Action Link -->
              <td class="py-3.5 px-6 text-right">
                <a 
                  href={`/passport/${entry.signatureHash}`}
                  class="px-3 py-1 rounded bg-bg-canvas hover:bg-bg-surface border border-border-hairline text-text-secondary hover:text-text-primary transition-colors text-[11px] font-bold inline-flex items-center gap-1"
                >
                  VERIFY RECEIPT &rarr;
                </a>
              </td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>

  <!-- Mobile Stacked Card View -->
  <div class="block md:hidden divide-y divide-border-hairline">
    {receipts.map((entry) => (
      <div class="p-4 space-y-2.5 bg-bg-canvas/40">
        <div class="flex justify-between items-center">
          <a href={`/passport/${entry.signatureHash}`} class="font-bold text-status-pass text-xs break-all truncate max-w-[180px]">
            #{entry.signatureHash.slice(0, 16)}...
          </a>
          <span class="px-2 py-0.5 rounded bg-status-pass/10 text-status-pass border border-status-pass/30 text-[10px] font-bold">
            {entry.healthScore}/100 Score
          </span>
        </div>
        <div class="text-[11px] text-text-secondary flex justify-between">
          <span>{entry.resolution} @ {entry.vsyncFps}Hz</span>
          <span>{entry.timestampIso.slice(0, 10)}</span>
        </div>
        <div class="pt-1 flex justify-between items-center">
          <span class="text-[10px] text-text-muted">ISO 9241-307: 0 Defects</span>
          <a href={`/passport/${entry.signatureHash}`} class="text-[10px] font-bold text-text-primary hover:underline">
            View Passport &rarr;
          </a>
        </div>
      </div>
    ))}
  </div>

  <!-- Table Footer Pagination -->
  <div class="px-4 sm:px-6 py-3 border-t border-border-hairline bg-bg-elevated flex flex-col sm:flex-row sm:items-center justify-between gap-2 text-[11px] text-text-muted">
    <span>Showing recent verified submissions</span>
    <a href="/display-tests/dead-pixel" class="text-status-pass hover:underline font-bold">
      + Run Diagnostic &amp; Submit Receipt
    </a>
  </div>
</div>
