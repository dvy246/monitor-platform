---
/**
 * MotionBlur.astro
 * Motion Blur & Overdrive Ghosting Analyzer UI component.
 */
---

<div class="w-full max-w-5xl mx-auto space-y-6">
  <div class="bg-bg-surface/90 border border-border-hairline rounded-2xl p-6 backdrop-blur-xl shadow-2xl space-y-6">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-border-hairline/60 pb-4">
      <div>
        <div class="flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-status-pass shadow-[0_0_8px_rgba(5,150,105,0.8)]"></span>
          <h2 class="text-lg font-bold font-mono text-text-primary tracking-wide">Motion Blur &amp; Overdrive Ghosting Analyzer</h2>
        </div>
        <p class="text-xs text-text-muted mt-1">Pursuit velocity tracking and MPRT sample-and-hold response metrics (ISO 9241-305).</p>
      </div>

      <div class="flex items-center gap-3">
        <label class="text-xs font-mono text-text-muted">Speed:</label>
        <select id="speed-select" class="bg-bg-canvas border border-border-subtle text-text-primary text-xs font-mono rounded-lg px-3 py-1.5 focus:border-status-pass">
          <option value="480">480 px/sec</option>
          <option value="960" selected>960 px/sec</option>
          <option value="1920">1920 px/sec</option>
        </select>
      </div>
    </div>

    <!-- Moving Pursuit Pattern Canvas -->
    <div class="relative w-full h-64 rounded-xl bg-bg-canvas border border-border-subtle overflow-hidden">
      <canvas id="motion-canvas" class="w-full h-full block"></canvas>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 pt-2">
      <div class="bg-bg-elevated p-3.5 rounded-xl border border-border-hairline">
        <div class="text-[10px] font-mono text-text-muted uppercase">Pursuit Velocity</div>
        <div id="metric-speed" class="text-sm font-mono font-bold text-text-primary mt-1">960 px/s</div>
      </div>
      <div class="bg-bg-elevated p-3.5 rounded-xl border border-border-hairline">
        <div class="text-[10px] font-mono text-text-muted uppercase">Pixels / Frame</div>
        <div id="metric-ppf" class="text-sm font-mono font-bold text-status-pass mt-1">6.67 px</div>
      </div>
      <div class="bg-bg-elevated p-3.5 rounded-xl border border-border-hairline">
        <div class="text-[10px] font-mono text-text-muted uppercase">Estimated MPRT</div>
        <div id="metric-mprt" class="text-sm font-mono font-bold text-text-primary mt-1">6.94 ms</div>
      </div>
      <div class="bg-bg-elevated p-3.5 rounded-xl border border-border-hairline">
        <div class="text-[10px] font-mono text-text-muted uppercase">Overshoot Status</div>
        <div id="metric-overshoot" class="text-sm font-mono font-bold text-status-pass mt-1">NO CORONA</div>
      </div>
    </div>
  </div>
</div>

<script>
  import { calculateMotionMetrics, calculatePursuitPosition } from '../../engine/MotionBlurEngine';

  const canvas = document.getElementById('motion-canvas') as HTMLCanvasElement | null;
  const speedSelect = document.getElementById('speed-select') as HTMLSelectElement | null;

  if (canvas) {
    const ctx = canvas.getContext('2d');
    let speedPx = 960;
    let startTime = performance.now();

    function resize() {
      if (!canvas) return;
      canvas.width = canvas.clientWidth;
      canvas.height = canvas.clientHeight;
    }
    window.addEventListener('resize', resize);
    resize();

    speedSelect?.addEventListener('change', (e) => {
      speedPx = parseInt((e.target as HTMLSelectElement).value, 10);
      document.getElementById('metric-speed')!.textContent = `${speedPx} px/s`;
    });

    function render(now: number) {
      if (!ctx || !canvas) return;
      const elapsed = now - startTime;
      ctx.clearRect(0, 0, canvas.width, canvas.height);

      const posX = calculatePursuitPosition(elapsed, speedPx, canvas.width, 80);

      // Render pursuit block
      ctx.fillStyle = '#059669';
      ctx.fillRect(posX, canvas.height / 2 - 30, 80, 60);

      requestAnimationFrame(render);
    }
    requestAnimationFrame(render);
  }
</script>
