---
<div class="relative w-full aspect-video sm:aspect-[21/9] bg-[#08080a] rounded-3xl border border-white/10 overflow-hidden shadow-2xl group">
  <div class="absolute inset-0 pointer-events-none bg-[url('/data/noise.png')] opacity-[0.03] mix-blend-overlay"></div>
  <canvas id="polling-canvas" class="w-full h-full block relative z-10"></canvas>
  <div class="absolute inset-x-0 top-0 p-4 flex justify-between z-20 bg-gradient-to-b from-[#08080a] to-transparent">
    <div class="flex items-center gap-3">
      <div class="h-8 w-8 rounded-full bg-indigo-500/20 border border-indigo-500/40 flex items-center justify-center">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-indigo-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
      </div>
      <div>
        <h3 class="text-white font-mono font-bold text-sm">HID Polling Engine</h3>
        <p class="text-[10px] text-zinc-500 font-mono">Frame Pacing Variance</p>
      </div>
    </div>
    <div class="text-right">
      <div class="text-3xl font-black font-mono text-white" id="hz-display">0 <span class="text-sm text-zinc-500">Hz</span></div>
    </div>
  </div>
</div>

<script>
  class PollingEngine {
    private canvas: HTMLCanvasElement;
    private ctx: CanvasRenderingContext2D;
    private lastTime = 0;
    private points: number[] = [];
    private display: HTMLElement;
    private count = 0;
    private secTime = 0;

    constructor() {
      this.canvas = document.getElementById('polling-canvas') as HTMLCanvasElement;
      this.display = document.getElementById('hz-display')!;
      this.ctx = this.canvas.getContext('2d')!;
      this.resize();
      window.addEventListener('resize', () => this.resize());
      window.addEventListener('mousemove', this.onMove);
      requestAnimationFrame(this.render);
    }
    
    private resize() {
      const rect = this.canvas.parentElement!.getBoundingClientRect();
      this.canvas.width = rect.width * window.devicePixelRatio;
      this.canvas.height = rect.height * window.devicePixelRatio;
      this.ctx.scale(window.devicePixelRatio, window.devicePixelRatio);
    }

    private onMove = () => {
      const now = performance.now();
      if (this.lastTime === 0) { this.lastTime = now; return; }
      
      const delta = now - this.lastTime;
      this.lastTime = now;
      this.count++;

      if (now - this.secTime > 1000) {
        this.display.innerHTML = `${this.count} <span class="text-sm text-zinc-500">Hz</span>`;
        this.count = 0;
        this.secTime = now;
      }

      const h = this.canvas.height / window.devicePixelRatio;
      this.points.push(delta * (h / 4)); 
      
      const w = this.canvas.width / window.devicePixelRatio;
      if (this.points.length > w) this.points.shift();
    };

    private render = () => {
      const width = this.canvas.width / window.devicePixelRatio;
      const height = this.canvas.height / window.devicePixelRatio;
      
      this.ctx.clearRect(0, 0, width, height);
      this.ctx.strokeStyle = '#818cf8';
      this.ctx.lineWidth = 2;
      
      this.ctx.beginPath();
      for (let i = 0; i < this.points.length; i++) {
        const x = i;
        const y = height - this.points[i];
        if (i === 0) this.ctx.moveTo(x, y);
        else this.ctx.lineTo(x, y);
      }
      this.ctx.stroke();
      
      requestAnimationFrame(this.render);
    };
  }
  new PollingEngine();
</script>
