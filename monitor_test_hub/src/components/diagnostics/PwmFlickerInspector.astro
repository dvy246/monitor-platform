---
---

<div class="w-full max-w-5xl mx-auto p-4 md:p-6 bg-[#121215] border border-white/10 rounded-2xl shadow-2xl text-slate-100 font-sans space-y-6">
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-6 border-b border-white/10">
    <div>
      <div class="flex items-center gap-2 text-cyan-400 text-xs font-mono uppercase tracking-widest mb-1">
        <span class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse"></span>
        <span>Pulse-Width Modulation &amp; Health Engine</span>
      </div>
      <h2 class="text-2xl md:text-3xl font-black text-white tracking-tight">PWM Flicker &amp; DC Dimming Inspector</h2>
      <p class="text-sm text-slate-400 mt-1">Detect display backlight pulse-width modulation (PWM) frequency, duty cycle, and optical camera strobe patterns.</p>
    </div>
    
    <div class="flex items-center gap-2">
      <button id="flicker-fs-btn" class="px-4 py-2 bg-cyan-500 hover:bg-cyan-600 text-bg-canvas font-mono font-bold text-xs rounded-xl transition-all shadow-lg flex items-center gap-2">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8V5a2 2 0 012-2h3m11 0h3a2 2 0 012 2v3m0 11v3a2 2 0 01-2 2h-3m-11 0H5a2 2 0 01-2-2v-3"/></svg>
        <span>ENTER FULLSCREEN TEST</span>
      </button>
    </div>
  </div>

  <!-- Interactive Control Deck -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-4 font-mono text-xs">
    <div class="bg-bg-surface p-4 rounded-xl border border-border-hairline space-y-2">
      <label class="text-text-muted uppercase tracking-wider block">Flicker Test Pattern</label>
      <select id="flicker-mode" class="w-full bg-bg-canvas border border-border-hairline rounded-lg p-2 text-text-primary focus:border-cyan-400 focus:outline-none cursor-pointer">
        <option value="zebra">Zebra Camera Strobe Pattern (High-Frequency)</option>
        <option value="pulse">Waveform Pulse Simulator</option>
        <option value="gray-gradient">Gray Luminance Slider Scan</option>
      </select>
    </div>

    <div class="bg-bg-surface p-4 rounded-xl border border-border-hairline space-y-2">
      <label class="text-text-muted uppercase tracking-wider block">Pulse Frequency (Hz)</label>
      <input id="flicker-freq" type="range" min="30" max="480" value="240" class="w-full accent-cyan-400 cursor-pointer" />
    </div>

    <div class="bg-bg-surface p-4 rounded-xl border border-border-hairline space-y-2">
      <label class="text-text-muted uppercase tracking-wider block">Luminance Brightness Level</label>
      <input id="flicker-bright" type="range" min="5" max="100" value="50" class="w-full accent-cyan-400 cursor-pointer" />
    </div>
  </div>

  <!-- Canvas Stage -->
  <div class="relative w-full aspect-video bg-black rounded-xl overflow-hidden border border-border-hairline shadow-2xl flex items-center justify-center" id="flicker-canvas-container">
    <canvas id="flicker-canvas" class="w-full h-full block bg-black"></canvas>
    
    <div data-fullscreen-hide="true" class="absolute top-4 left-4 p-3 bg-bg-surface/90 backdrop-blur-md border border-border-hairline rounded-lg text-xs font-mono text-text-primary space-y-1">
      <div>IEEE 1789 Safety Standard: <span id="flicker-safety" class="text-status-pass font-bold">Low Risk (&gt;1920Hz Target)</span></div>
      <div class="text-[10px] text-text-muted">Point your mobile phone camera at the screen in 240fps slow-mo mode</div>
    </div>
  </div>

  <div class="p-5 rounded-xl bg-bg-surface border border-border-hairline space-y-3 font-sans text-xs text-text-secondary leading-relaxed">
    <h3 class="font-mono font-bold text-text-primary uppercase text-sm">IEEE 1789-2015 LED PWM Dimming Safety Standards</h3>
    <p>
      Display manufacturers control brightness via either <strong class="text-text-primary">DC Dimming</strong> (lowering voltage continuously) or <strong class="text-cyan-400">PWM (Pulse-Width Modulation)</strong> (flashing the backlight ON/OFF thousands of times per second). Low PWM frequencies (&lt;240Hz) cause micro-strobe flicker leading to eye strain and migraines.
    </p>
  </div>
</div>

<script>
  let canvas = document.getElementById('flicker-canvas') as HTMLCanvasElement;
  let ctx = canvas?.getContext('2d');
  let modeSelect = document.getElementById('flicker-mode') as HTMLSelectElement;
  let freqSlider = document.getElementById('flicker-freq') as HTMLInputElement;
  let brightSlider = document.getElementById('flicker-bright') as HTMLInputElement;
  let fsBtn = document.getElementById('flicker-fs-btn');
  let container = document.getElementById('flicker-canvas-container');

  let offset = 0;

  function resize() {
    if (!canvas || !container) return;
    canvas.width = container.clientWidth;
    canvas.height = container.clientHeight;
  }
  window.addEventListener('resize', resize);
  resize();

  function draw() {
    if (!ctx || !canvas) return;
    ctx.fillStyle = '#000000';
    ctx.fillRect(0, 0, canvas.width, canvas.height);

    let mode = modeSelect ? modeSelect.value : 'zebra';
    let freq = parseInt(freqSlider ? freqSlider.value : '24');
    let bright = parseInt(brightSlider ? brightSlider.value : '50') / 100;

    offset += 2;

    if (mode === 'zebra') {
      let stripeWidth = Math.max(2, Math.floor(canvas.width / (freq * 4)));
      for (let x = 0; x < canvas.width; x += stripeWidth * 2) {
        ctx.fillStyle = `rgba(255, 255, 255, ${bright})`;
        ctx.fillRect(x + (offset % (stripeWidth * 2)), 0, stripeWidth, canvas.height);
      }
    } else if (mode === 'shutter-lines') {
      let barHeight = 20;
      for (let y = 0; y < canvas.height; y += barHeight * 2) {
        ctx.fillStyle = `rgba(255, 255, 255, ${bright})`;
        ctx.fillRect(0, (y + offset) % canvas.height, canvas.width, barHeight);
      }
    } else {
      let val = Math.floor(bright * 255);
      ctx.fillStyle = `rgb(${val}, ${val}, ${val})`;
      ctx.fillRect(0, 0, canvas.width, canvas.height);
    }

    requestAnimationFrame(draw);
  }
  requestAnimationFrame(draw);

  document.addEventListener('fullscreenchange', () => {
    setTimeout(resize, 50);
  });

  if (fsBtn && container) {
    fsBtn.addEventListener('click', () => {
      if (document.fullscreenElement) {
        document.exitFullscreen();
      } else {
        container?.requestFullscreen();
      }
    });
  }

  document.addEventListener('keydown', (e) => {
    if (e.key === 'f' || e.key === 'F') {
      if (document.fullscreenElement) {
        document.exitFullscreen();
      } else {
        container?.requestFullscreen();
      }
    }
  });
</script>
