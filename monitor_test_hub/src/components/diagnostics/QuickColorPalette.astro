---
/**
 * QuickColorPalette.astro
 * Reusable 12-preset color swatch card for instant diagnostic color switching.
 * Features active swatch ring indicators, glowing selection states, specular highlights, and active scale snaps.
 */
interface Props {
  activeHex?: string;
  activeName?: string;
  class?: string;
}

const { 
  activeHex = '#FFFFFF', 
  activeName = 'White',
  class: className = '' 
} = Astro.props;

const presetColors = [
  { id: 'white', name: 'White', hex: '#FFFFFF', isLight: true },
  { id: 'black', name: 'Black', hex: '#000000', isLight: false },
  { id: 'red', name: 'Red', hex: '#EF4444', isLight: false },
  { id: 'green', name: 'Green', hex: '#22C55E', isLight: false },
  { id: 'blue', name: 'Blue', hex: '#3B82F6', isLight: false },
  { id: 'cyan', name: 'Cyan', hex: '#06B6D4', isLight: false },
  { id: 'magenta', name: 'Magenta', hex: '#D946EF', isLight: false },
  { id: 'yellow', name: 'Yellow', hex: '#EAB308', isLight: true },
  { id: 'orange', name: 'Orange', hex: '#F97316', isLight: false },
  { id: 'purple', name: 'Purple', hex: '#8B5CF6', isLight: false },
  { id: 'darkgray', name: 'Dark Gray', hex: '#1F2937', isLight: false },
  { id: 'lightgray', name: 'Light Gray', hex: '#D1D5DB', isLight: true }
];
---

<div class:list={["bg-[#0d0d12]/90 border border-white/10 rounded-3xl p-5 sm:p-6 space-y-4 shadow-[0_20px_50px_rgba(0,0,0,0.5),inset_0_1px_0_rgba(255,255,255,0.12)] backdrop-blur-2xl font-sans select-none hover:border-white/25 hover:shadow-[0_25px_60px_rgba(168,85,247,0.15)] transition-all duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] relative overflow-hidden group", className]}>
  <!-- Top ambient purple glow -->
  <div class="absolute -top-12 -right-12 w-36 h-36 bg-purple-500/15 rounded-full blur-3xl pointer-events-none group-hover:bg-purple-500/25 transition-all duration-500"></div>

  <!-- Header -->
  <div class="flex items-center justify-between border-b border-white/10 pb-3.5 relative z-10">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 rounded-2xl bg-purple-500/15 border border-purple-500/30 flex items-center justify-center text-purple-400 shadow-[inset_0_1px_1px_rgba(255,255,255,0.3),0_0_15px_rgba(168,85,247,0.2)] shrink-0 transition-transform duration-300 group-hover:scale-105">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"/>
        </svg>
      </div>
      <div>
        <h3 class="text-base font-bold text-white tracking-tight group-hover:text-purple-200 transition-colors">Quick Palette</h3>
        <p class="text-[11px] text-zinc-400 font-mono">12 Swatches</p>
      </div>
    </div>
    <span class="text-[11px] font-mono text-zinc-400 bg-white/[0.05] px-2.5 py-1 rounded-full border border-white/10 shadow-[inset_0_1px_0_rgba(255,255,255,0.1)]">Instant Switch</span>
  </div>

  <!-- Swatch Grid (12 Colors) -->
  <div id="quick-palette-swatch-grid" class="grid grid-cols-4 sm:grid-cols-6 gap-2.5 relative z-10">
    {presetColors.map(c => {
      const isActive = c.hex.toUpperCase() === activeHex.toUpperCase();
      return (
        <button
          type="button"
          data-palette-hex={c.hex}
          data-palette-name={c.name}
          class:list={[
            "quick-palette-swatch w-full h-11 rounded-2xl border transition-all duration-200 ease-[cubic-bezier(0.16,1,0.3,1)] transform hover:scale-105 active:scale-95 cursor-pointer flex items-center justify-center relative group/swatch focus:outline-none focus:ring-2 focus:ring-purple-400/50 shadow-[inset_0_1px_1px_rgba(255,255,255,0.3)]",
            isActive 
              ? "border-white scale-105 ring-2 ring-purple-500/60 shadow-[0_0_20px_rgba(168,85,247,0.4)]" 
              : "border-white/20 hover:border-white/60 hover:shadow-[0_4px_12px_rgba(0,0,0,0.4)]"
          ]}
          style={`background-color: ${c.hex};`}
          title={`${c.name} (${c.hex})`}
          aria-label={`Switch color to ${c.name}`}
        >
          <!-- Active Check Icon -->
          <svg 
            class:list={[
              "w-4 h-4 transition-all duration-200 ease-[cubic-bezier(0.16,1,0.3,1)]",
              c.isLight ? "text-black drop-shadow-xs" : "text-white drop-shadow-md",
              isActive ? "scale-100 opacity-100" : "scale-50 opacity-0 group-hover/swatch:opacity-50 group-hover/swatch:scale-75"
            ]} 
            fill="none" 
            viewBox="0 0 24 24" 
            stroke="currentColor" 
            stroke-width="3"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
          </svg>
        </button>
      );
    })}
  </div>

  <!-- Active Color Indicator Row -->
  <div class="flex items-center justify-between font-mono text-xs pt-2 border-t border-white/10 relative z-10">
    <div class="flex items-center gap-2.5 text-white">
      <span id="palette-active-dot" class="w-3.5 h-3.5 rounded-full border border-white/40 shadow-[0_0_10px_rgba(255,255,255,0.3),inset_0_1px_0_rgba(255,255,255,0.4)] transition-all duration-300" style={`background-color: ${activeHex};`}></span>
      <span id="palette-active-name" class="font-bold tracking-wide">{activeName}</span>
    </div>
    <span id="palette-active-hex" class="text-zinc-400 uppercase tracking-widest bg-white/[0.04] px-2.5 py-0.5 rounded-lg border border-white/10 shadow-[inset_0_1px_0_rgba(255,255,255,0.1)]">{activeHex}</span>
  </div>
</div>

<script>
  function initQuickColorPalette() {
    const swatches = document.querySelectorAll('.quick-palette-swatch');
    const activeDot = document.getElementById('palette-active-dot');
    const activeNameEl = document.getElementById('palette-active-name');
    const activeHexEl = document.getElementById('palette-active-hex');

    function setActiveSwatchUI(hex: string, name: string) {
      const cleanHex = hex.toUpperCase();
      if (activeDot) {
        activeDot.style.backgroundColor = cleanHex;
        activeDot.style.boxShadow = `0 0 12px ${cleanHex}80, inset 0 1px 0 rgba(255,255,255,0.4)`;
      }
      if (activeNameEl) activeNameEl.textContent = name;
      if (activeHexEl) activeHexEl.textContent = cleanHex;

      swatches.forEach(swatch => {
        const swatchHex = (swatch.getAttribute('data-palette-hex') || '').toUpperCase();
        const icon = swatch.querySelector('svg');
        if (swatchHex === cleanHex) {
          swatch.classList.add('border-white', 'scale-105', 'ring-2', 'ring-purple-500/60', 'shadow-[0_0_20px_rgba(168,85,247,0.4)]');
          swatch.classList.remove('border-white/20');
          if (icon) {
            icon.classList.remove('scale-50', 'opacity-0');
            icon.classList.add('scale-100', 'opacity-100');
          }
        } else {
          swatch.classList.remove('border-white', 'scale-105', 'ring-2', 'ring-purple-500/60', 'shadow-[0_0_20px_rgba(168,85,247,0.4)]');
          swatch.classList.add('border-white/20');
          if (icon) {
            icon.classList.remove('scale-100', 'opacity-100');
            icon.classList.add('scale-50', 'opacity-0');
          }
        }
      });
    }

    swatches.forEach(swatch => {
      swatch.addEventListener('click', () => {
        const hex = swatch.getAttribute('data-palette-hex') || '#FFFFFF';
        const name = swatch.getAttribute('data-palette-name') || 'Color';
        setActiveSwatchUI(hex, name);
        window.dispatchEvent(new CustomEvent('dt-color-change', { detail: { hex, name } }));
      });
    });

    window.addEventListener('dt-color-change', (e: Event) => {
      const detail = (e as CustomEvent).detail;
      if (detail && detail.hex) {
        setActiveSwatchUI(detail.hex, detail.name || 'Custom Color');
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initQuickColorPalette);
  } else {
    initQuickColorPalette();
  }
</script>
