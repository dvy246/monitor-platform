---
---

<div class="bg-[#121215] border border-white/10 rounded-2xl p-6 sm:p-8 space-y-6 shadow-2xl font-mono">
  <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 border-b border-white/10 pb-4">
    <div>
      <div class="text-xs font-bold text-purple-400 uppercase tracking-widest flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-purple-400 animate-pulse"></span>
        <span>ACOUSTIC WAVE SPECTROMETRY</span>
      </div>
      <h3 class="text-xl font-bold text-white mt-1">Acoustic Room Mode &amp; Standing Wave Calculator</h3>
    </div>
    <div id="room-mode-badge" class="px-3 py-1 rounded-full bg-purple-400/10 border border-purple-400/30 text-purple-400 text-xs font-bold">
      BONNEVILLE RATIO: OPTIMAL
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
    <!-- Dimension Controls -->
    <div class="lg:col-span-5 space-y-4 bg-[#08080a] p-4 rounded-xl border border-white/10 text-xs">
      <div>
        <div class="flex justify-between text-slate-400 font-bold mb-1">
          <span>Room Length (Feet):</span>
          <span id="len-disp" class="text-purple-400">18.0 ft (5.49m)</span>
        </div>
        <input id="room-len-slider" type="range" min="8" max="40" step="0.5" value="18" class="w-full accent-purple-400 cursor-pointer" />
      </div>

      <div>
        <div class="flex justify-between text-slate-400 font-bold mb-1">
          <span>Room Width (Feet):</span>
          <span id="width-disp" class="text-purple-400">14.0 ft (4.27m)</span>
        </div>
        <input id="room-width-slider" type="range" min="6" max="30" step="0.5" value="14" class="w-full accent-purple-400 cursor-pointer" />
      </div>

      <div>
        <div class="flex justify-between text-slate-400 font-bold mb-1">
          <span>Room Height (Feet):</span>
          <span id="height-disp" class="text-purple-400">9.0 ft (2.74m)</span>
        </div>
        <input id="room-height-slider" type="range" min="7" max="16" step="0.5" value="9" class="w-full accent-purple-400 cursor-pointer" />
      </div>

      <div class="p-3 bg-[#18181b] rounded-lg border border-white/5 space-y-1">
        <div class="text-[10px] text-slate-400 font-bold">Schroeder Cutoff Frequency ($f_s$):</div>
        <div id="schroeder-freq" class="text-base font-bold text-white">184.2 Hz</div>
        <div class="text-[10px] text-slate-500">
          Frequencies below $f_s$ are dominated by discrete room standing waves.
        </div>
      </div>
    </div>

    <!-- Mode Frequency Table Column -->
    <div class="lg:col-span-7 space-y-4">
      <div class="bg-[#08080a] p-4 rounded-xl border border-white/10 space-y-3">
        <div class="text-xs font-bold text-slate-300 uppercase tracking-wider flex justify-between">
          <span>Primary Axial Room Modes (20Hz - 300Hz)</span>
          <span class="text-purple-400 font-mono text-[11px]">Speed of Sound: 1130 ft/s</span>
        </div>
        
        <div class="max-h-60 overflow-y-auto space-y-1 text-xs pr-1" id="modes-list-container">
          <!-- Populated dynamically -->
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import { AcousticRoomModeEngine } from '../../engine/AcousticRoomModeEngine';

  function initRoomModeInspector() {
    const lenSlider = document.getElementById('room-len-slider') as HTMLInputElement;
    const widthSlider = document.getElementById('room-width-slider') as HTMLInputElement;
    const heightSlider = document.getElementById('room-height-slider') as HTMLInputElement;

    const lenDisp = document.getElementById('len-disp');
    const widthDisp = document.getElementById('width-disp');
    const heightDisp = document.getElementById('height-disp');
    const schroederDisp = document.getElementById('schroeder-freq');
    const container = document.getElementById('modes-list-container');

    if (!lenSlider || !widthSlider || !heightSlider) return;

    function update() {
      const L_ft = parseFloat(lenSlider.value);
      const W_ft = parseFloat(widthSlider.value);
      const H_ft = parseFloat(heightSlider.value);

      const L_m = L_ft * 0.3048;
      const W_m = W_ft * 0.3048;
      const H_m = H_ft * 0.3048;

      if (lenDisp) lenDisp.textContent = `${L_ft.toFixed(1)} ft (${L_m.toFixed(2)}m)`;
      if (widthDisp) widthDisp.textContent = `${W_ft.toFixed(1)} ft (${W_m.toFixed(2)}m)`;
      if (heightDisp) heightDisp.textContent = `${H_ft.toFixed(1)} ft (${H_m.toFixed(2)}m)`;

      const schroeder = AcousticRoomModeEngine.calculateSchroederCutoff(L_m, W_m, H_m);
      if (schroederDisp) schroederDisp.textContent = `${schroeder.toFixed(1)} Hz`;

      const modes = AcousticRoomModeEngine.calculateAxialModes(L_m, W_m, H_m);

      if (container) {
        container.innerHTML = '';
        modes.slice(0, 10).forEach(m => {
          const div = document.createElement('div');
          div.className = 'p-2 rounded bg-[#18181b] border border-white/5 flex justify-between items-center text-xs';
          div.innerHTML = `
            <div class="flex items-center gap-2">
              <span class="px-1.5 py-0.5 rounded bg-purple-400/10 text-purple-400 font-bold text-[10px]">${m.axis.toUpperCase()}</span>
              <span class="text-slate-300 font-bold">${m.frequency.toFixed(1)} Hz</span>
            </div>
            <span class="text-slate-500 text-[10px]">Order: ${m.order}</span>
          `;
          container.appendChild(div);
        });
      }
    }

    lenSlider?.addEventListener('input', update);
    widthSlider?.addEventListener('input', update);
    heightSlider?.addEventListener('input', update);

    update();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initRoomModeInspector);
  } else {
    initRoomModeInspector();
  }
</script>
