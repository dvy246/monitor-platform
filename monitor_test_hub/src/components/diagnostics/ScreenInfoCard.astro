---
/**
 * ScreenInfoCard.astro
 * Premium Apple/Linear-style card auto-detecting hardware display parameters:
 * Resolution, Refresh Rate, Pixel Ratio DPR, Color Depth, Browser Engine, Fullscreen Status, and Orientation.
 */
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div class:list={["bg-[#0d0d12]/90 border border-white/10 rounded-3xl p-5 sm:p-6 space-y-4 shadow-[0_20px_50px_rgba(0,0,0,0.5),inset_0_1px_0_rgba(255,255,255,0.12)] backdrop-blur-2xl font-sans select-none hover:border-white/25 hover:shadow-[0_25px_60px_rgba(59,130,246,0.15)] transition-all duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] relative overflow-hidden group", className]}>
  <!-- Top ambient light gradient -->
  <div class="absolute -top-12 -left-12 w-36 h-36 bg-blue-500/15 rounded-full blur-3xl pointer-events-none group-hover:bg-blue-500/25 transition-all duration-500"></div>

  <!-- Card Header -->
  <div class="flex items-center justify-between border-b border-white/10 pb-3.5 relative z-10">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 rounded-2xl bg-blue-500/15 border border-blue-500/30 flex items-center justify-center text-blue-400 shadow-[inset_0_1px_1px_rgba(255,255,255,0.3),0_0_15px_rgba(59,130,246,0.2)] shrink-0 transition-colors duration-300 group-hover:border-blue-400">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <rect x="2" y="4" width="20" height="12" rx="2.5"/>
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 16v4m-4 0h8"/>
        </svg>
      </div>
      <div>
        <h3 class="text-base font-bold text-white tracking-tight group-hover:text-blue-200 transition-colors">Screen Info</h3>
        <p class="text-[11px] text-zinc-400 font-mono">Hardware Readouts</p>
      </div>
    </div>
    <span id="screen-info-device-badge" class="px-3 py-1 rounded-full bg-blue-500/10 border border-blue-500/30 text-blue-400 font-mono text-[11px] font-semibold flex items-center gap-1.5 shadow-[0_0_12px_rgba(59,130,246,0.2)]">
      <span class="w-1.5 h-1.5 rounded-full bg-blue-400 animate-pulse"></span>
      <span>Detecting...</span>
    </span>
  </div>

  <!-- Telemetry Parameter Grid -->
  <div class="space-y-2.5 font-mono text-xs text-zinc-300 relative z-10">
    <!-- 1. Resolution -->
    <div class="flex items-center justify-between py-2 border-b border-white/[0.06] hover:bg-white/[0.03] px-2.5 rounded-xl transition-all duration-200 hover:translate-x-0.5">
      <div class="flex items-center gap-2.5 text-zinc-400">
        <svg class="w-4 h-4 text-blue-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 8V6a2 2 0 012-2h2m8 0h2a2 2 0 012 2v2m0 8v2a2 2 0 01-2 2h-2m-8 0H6a2 2 0 01-2-2v-2"/>
        </svg>
        <span>Resolution</span>
      </div>
      <div class="text-right">
        <span id="screen-info-res" class="font-bold text-white tabular-nums block tracking-tight">--- × ---</span>
        <span id="screen-info-logical-res" class="text-[10px] text-zinc-500 tabular-nums block">--- × --- Viewport</span>
      </div>
    </div>

    <!-- 2. Refresh Rate -->
    <div class="flex items-center justify-between py-2 border-b border-white/[0.06] hover:bg-white/[0.03] px-2.5 rounded-xl transition-all duration-200 hover:translate-x-0.5">
      <div class="flex items-center gap-2.5 text-zinc-400">
        <svg class="w-4 h-4 text-emerald-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/>
        </svg>
        <span>Refresh Rate</span>
      </div>
      <span id="screen-info-hz" class="font-bold text-emerald-400 tabular-nums bg-emerald-500/10 px-2.5 py-0.5 rounded-lg border border-emerald-500/30 shadow-[0_0_10px_rgba(52,211,153,0.2)]">Measuring...</span>
    </div>

    <!-- 3. Pixel Ratio DPR -->
    <div class="flex items-center justify-between py-2 border-b border-white/[0.06] hover:bg-white/[0.03] px-2.5 rounded-xl transition-all duration-200 hover:translate-x-0.5">
      <div class="flex items-center gap-2.5 text-zinc-400">
        <svg class="w-4 h-4 text-purple-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6a2 2 0 012-2h12a2 2 0 012 2v12a2 2 0 01-2 2H6a2 2 0 01-2-2V6zm4 8h8M8 10h8"/>
        </svg>
        <span>Pixel Ratio DPR</span>
      </div>
      <span id="screen-info-dpr" class="font-bold text-white tabular-nums">1.0x</span>
    </div>

    <!-- 4. Color Depth -->
    <div class="flex items-center justify-between py-2 border-b border-white/[0.06] hover:bg-white/[0.03] px-2.5 rounded-xl transition-all duration-200 hover:translate-x-0.5">
      <div class="flex items-center gap-2.5 text-zinc-400">
        <svg class="w-4 h-4 text-rose-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"/>
        </svg>
        <span>Color Depth</span>
      </div>
      <span id="screen-info-depth" class="font-bold text-white tabular-nums">24-bit</span>
    </div>

    <!-- 5. Browser & Engine -->
    <div class="flex items-center justify-between py-2 border-b border-white/[0.06] hover:bg-white/[0.03] px-2.5 rounded-xl transition-all duration-200 hover:translate-x-0.5">
      <div class="flex items-center gap-2.5 text-zinc-400">
        <svg class="w-4 h-4 text-cyan-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"/>
          <path stroke-linecap="round" stroke-linejoin="round" d="M2 12h20M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"/>
        </svg>
        <span>Browser Engine</span>
      </div>
      <span id="screen-info-browser" class="font-bold text-white">Browser</span>
    </div>

    <!-- 6. Fullscreen & Orientation -->
    <div class="flex items-center justify-between py-2 hover:bg-white/[0.03] px-2.5 rounded-xl transition-all duration-200 hover:translate-x-0.5">
      <div class="flex items-center gap-2.5 text-zinc-400">
        <svg class="w-4 h-4 text-amber-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <rect x="4" y="4" width="16" height="16" rx="2"/>
        </svg>
        <span>Mode / Orientation</span>
      </div>
      <span id="screen-info-orient" class="font-bold text-zinc-300">Windowed · Landscape</span>
    </div>
  </div>
</div>

<script>
  import { VsyncSyncEngine } from '../../engine/VsyncSyncEngine';

  function initScreenInfoCard() {
    const resEl = document.getElementById('screen-info-res');
    const logicalResEl = document.getElementById('screen-info-logical-res');
    const hzEl = document.getElementById('screen-info-hz');
    const dprEl = document.getElementById('screen-info-dpr');
    const depthEl = document.getElementById('screen-info-depth');
    const browserEl = document.getElementById('screen-info-browser');
    const orientEl = document.getElementById('screen-info-orient');
    const deviceBadge = document.getElementById('screen-info-device-badge');

    if (resEl) {
      const dpr = window.devicePixelRatio || 1;
      const w = Math.round(window.screen.width * dpr);
      const h = Math.round(window.screen.height * dpr);
      resEl.textContent = `${w} × ${h}`;
    }
    if (logicalResEl) {
      logicalResEl.textContent = `${window.innerWidth} × ${window.innerHeight} Viewport`;
    }

    if (dprEl) {
      dprEl.textContent = `${(window.devicePixelRatio || 1).toFixed(1)}x`;
    }

    if (depthEl) {
      const depth = (window.screen as any).colorDepth || 24;
      const bpc = depth >= 30 ? '10 bpc' : '8 bpc';
      depthEl.textContent = `${depth}-bit (${bpc})`;
    }

    if (browserEl) {
      const ua = navigator.userAgent;
      let name = 'Web Browser';
      if (ua.includes('Firefox')) name = 'Firefox (Gecko)';
      else if (ua.includes('Edg')) name = 'Edge (Chromium)';
      else if (ua.includes('Chrome')) name = 'Chrome (Blink)';
      else if (ua.includes('Safari')) name = 'Safari (WebKit)';
      browserEl.textContent = name;
    }

    function updateModeOrient() {
      const isMobile = 'ontouchstart' in window || navigator.maxTouchPoints > 0;
      if (deviceBadge) {
        const textSpan = deviceBadge.querySelector('span:last-child');
        if (textSpan) {
          textSpan.textContent = isMobile ? 'Mobile Display' : 'Desktop Monitor';
        }
      }
      const isFS = !!(document.fullscreenElement || (document as any).webkitFullscreenElement);
      const orient = window.innerWidth > window.innerHeight ? 'Landscape' : 'Portrait';
      if (orientEl) {
        orientEl.textContent = `${isFS ? 'Fullscreen' : 'Windowed'} · ${orient}`;
      }
      if (logicalResEl) {
        logicalResEl.textContent = `${window.innerWidth} × ${window.innerHeight} Viewport`;
      }
    }

    updateModeOrient();
    window.addEventListener('resize', updateModeOrient);
    document.addEventListener('fullscreenchange', updateModeOrient);

    if (hzEl) {
      const engine = new VsyncSyncEngine((stats) => {
        hzEl.textContent = `~${Math.round(stats.currentFps)} Hz`;
      });
      engine.start();
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initScreenInfoCard);
  } else {
    initScreenInfoCard();
  }
</script>
