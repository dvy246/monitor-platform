      let newlyUnlocked = false;
      achievementsList.forEach(ach => {
        if (!ach.unlocked && ach.condition()) {
          ach.unlocked = true;
          newlyUnlocked = true;
          spawnPlusOneParticle(`Achievement Unlocked! ${ach.name}`, true);
        }
      });
      
      if (newlyUnlocked) {
        recalculateStats();
        renderAchievements();
        saveState();
      }
    }

    function saveState() {
      localStorage.setItem('mth_spacebar_lifetime_clicks', lifetimeClicks.toString());
      localStorage.setItem('mth_spacebar_peak_cps', peakCpsAllTime.toString());
      localStorage.setItem('mth_spacebar_currency', currency.toString());
      localStorage.setItem('mth_spacebar_level', userLevel.toString());
      localStorage.setItem('mth_spacebar_upgrades', JSON.stringify(upgrades.map(u => ({id: u.id, owned: u.owned}))));
      localStorage.setItem('mth_spacebar_achievements', JSON.stringify(achievementsList.filter(a => a.unlocked).map(a => a.id)));
    }

    function playBuySound() {
      if (!soundEnabled) return;
      try {
        if (!audioCtx) {
          audioCtx = new (window.AudioContext || (window as any).webkitAudioContext)();
        }
        if (audioCtx.state === 'suspended') audioCtx.resume();
        
        const now = audioCtx.currentTime;
        const osc1 = audioCtx.createOscillator();
        const osc2 = audioCtx.createOscillator();
        const gain = audioCtx.createGain();

        osc1.type = 'sine';
        osc2.type = 'triangle';

        osc1.frequency.setValueAtTime(587.33, now); // D5
        osc1.frequency.setValueAtTime(880.00, now + 0.06); // A5

        osc2.frequency.setValueAtTime(1174.66, now + 0.06); // D6

        gain.gain.setValueAtTime(0.2, now);
        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.25);

        osc1.connect(gain);
        osc2.connect(gain);
        gain.connect(audioCtx.destination);

        osc1.start(now);
        osc1.stop(now + 0.25);
        osc2.start(now + 0.06);
        osc2.stop(now + 0.25);
      } catch (e) {}
    }

    function renderUpgrades() {
      if (!upgradesGrid) return;
      upgradesGrid.innerHTML = '';
      
      upgrades.forEach((upg) => {
        const cost = calculateCost(upg.baseCost, upg.owned);
        const canAfford = currency >= cost;
        
        const card = document.createElement('div');
        card.className = `p-4 rounded-xl border flex flex-col justify-between transition-all select-none ${canAfford ? 'bg-bg-elevated border-status-pass/50 shadow-sm hover:border-status-pass group' : 'bg-bg-elevated/30 border-border-hairline opacity-70'}`;
        card.innerHTML = `
          <div>
            <div class="flex justify-between items-start mb-1">
              <div class="font-mono text-xs font-bold text-text-primary truncate" title="${upg.name}">${upg.name}</div>
              <div class="text-[9px] font-mono px-1.5 py-0.5 rounded bg-bg-surface border border-border-hairline text-text-muted uppercase tracking-wider">${upg.type}</div>
            </div>
            <div class="text-[10px] text-text-muted mb-3 leading-relaxed min-h-[30px] pr-2">${upg.desc}</div>
          </div>
          <div class="flex items-center justify-between mt-auto border-t border-border-hairline pt-3">
            <div>
              <div class="text-[9px] font-mono text-text-muted uppercase font-bold">Cost</div>
              <div class="font-mono text-xs font-extrabold ${canAfford ? 'text-amber-400 font-extrabold' : 'text-rose-400/80'}">${cost.toLocaleString()} Clicks</div>
            </div>
            <div class="flex items-center gap-2">
              <span class="font-mono text-xs font-bold ${upg.owned > 0 ? 'text-status-pass bg-status-pass/10 border-status-pass/30' : 'text-text-muted bg-bg-surface border-border-hairline'} border px-2 py-1 rounded-lg">x${upg.owned}</span>
              <button type="button" class="btn-buy-upgrade px-3 py-1.5 rounded-lg text-xs font-mono font-extrabold transition-all shadow-md ${canAfford ? 'bg-status-pass text-zinc-950 hover:bg-emerald-400 hover:scale-105 cursor-pointer shadow-status-pass/20' : 'bg-bg-surface border border-border-hairline text-text-muted opacity-50 cursor-not-allowed'}">
                ${canAfford ? 'BUY 🛒' : 'LOCKED'}
              </button>
            </div>
          </div>
        `;

        if (canAfford) {
          const buyBtn = card.querySelector('.btn-buy-upgrade') as HTMLButtonElement | null;
          const buyHandler = (e: Event) => {
            e.stopPropagation();
            if (currency < cost) return;
            
            currency -= cost;
            upg.owned += 1;

            playBuySound();
            spawnPlusOneParticle(`✓ Bought ${upg.name}!`, true);
            
            if (buyBtn) {
              buyBtn.textContent = 'PURCHASED! ✓';
              buyBtn.classList.remove('bg-status-pass');
              buyBtn.classList.add('bg-amber-400', 'text-zinc-950');
            }

            recalculateStats();
            if (upg.type === 'autoclicker' && autoCpsInterval === null) {
              startAutoClicker();
            }
            
            updateCurrencyUI();
            checkAchievements();
            saveState();
            
            if (currencyEl) {
              currencyEl.classList.add('text-amber-400');
              setTimeout(() => currencyEl.classList.remove('text-amber-400'), 200);
            }

            setTimeout(() => renderUpgrades(), 250);
          };

          buyBtn?.addEventListener('click', buyHandler);
          card.addEventListener('click', buyHandler);
        }
        upgradesGrid.appendChild(card);
      });
    }

    function renderAchievements() {
      if (!achievementsGrid) return;
      achievementsGrid.innerHTML = '';
      let unlockedCount = 0;
      
      achievementsList.forEach(ach => {
        if (ach.unlocked) unlockedCount++;
        
        const card = document.createElement('div');
        card.className = `p-3 rounded-xl border flex flex-col justify-between transition-all ${ach.unlocked ? 'bg-bg-elevated border-status-pass/30' : 'bg-bg-elevated/20 border-border-hairline opacity-60 grayscale'}`;
        card.innerHTML = `
          <div>
            <div class="flex justify-between items-start mb-1">
              <div class="font-mono text-xs font-bold ${ach.unlocked ? 'text-white' : 'text-text-primary'} truncate">${ach.name}</div>
              <div class="text-[9px] font-mono font-bold ${ach.unlocked ? 'text-status-pass' : 'text-text-muted'}">${ach.unlocked ? 'UNLOCKED' : 'LOCKED'}</div>
            </div>
            <div class="text-[10px] text-text-muted mb-2 leading-tight">${ach.desc}</div>
          </div>
          <div class="text-[10px] font-mono font-bold ${ach.unlocked ? 'text-purple-400' : 'text-text-muted'}">Reward: +${(ach.reward * 100).toFixed(0)}% Multiplier</div>
        `;
        achievementsGrid.appendChild(card);
      });

      const progEl = document.getElementById('sb-achievements-progress');
      if (progEl) progEl.textContent = `${unlockedCount} / ${achievementsList.length} Unlocked`;
    }

    function updateCurrencyUI() {
      if (currencyEl) currencyEl.textContent = Math.floor(currency).toLocaleString();
    }

    function startAutoClicker() {
      if (autoCpsInterval) clearInterval(autoCpsInterval);
      autoCpsInterval = setInterval(() => {
        if (isFinished || autoCps <= 0 || startTimeMs === null) return;
        
        const currentMultiplier = recalculateStats();
        const clicksToAdd = (autoCps * currentMultiplier) / 10;
        autoClickAccumulator += clicksToAdd;
        
        if (autoClickAccumulator >= 1) {
          const wholeClicks = Math.floor(autoClickAccumulator);
          autoClickAccumulator -= wholeClicks;
          
          clickCount += wholeClicks;
          currency += wholeClicks;
          lifetimeClicks += wholeClicks;
          
          if (clickCountEl) clickCountEl.textContent = Math.floor(clickCount).toLocaleString();
          updateCurrencyUI();
          updateLiveCps();
          updateLevelUI();
          checkLevelUp();
          checkAchievements();
          
          if (keycapVisual) {
            keycapVisual.style.transform = 'translateY(4px) scale(0.99)';
            setTimeout(() => {
              keycapVisual.style.transform = '';
            }, 50);
          }
          createRipple(true); 
          saveState();
        }
      }, 100);
    }

    const getPrKey = (dur: number) => `mth_spacebar_score_pr_${dur}s`;
    
    function getRankEmoji(score: number, dur: number) {
      if (dur === 0) return '∞';
      const cps = score / dur;
      if (cps >= 15.0) return '🌌';
      if (cps >= 12.0) return '⚡';
      if (cps >= 8.0) return '🐆';
      if (cps >= 5.0) return '🐇';
      return '🐢';
    }

    function updatePrDisplay() {
      const pr = parseFloat(localStorage.getItem(getPrKey(durationSeconds)) || '0.0');
      if (prCpsEl) prCpsEl.textContent = pr.toLocaleString();

      const ltClicksEl = document.getElementById('sb-lifetime-clicks');
      if (ltClicksEl) ltClicksEl.textContent = Math.floor(lifetimeClicks).toLocaleString();
      
      const pAllTimeEl = document.getElementById('sb-peak-cps-alltime');
      if (pAllTimeEl) pAllTimeEl.textContent = peakCpsAllTime.toFixed(1);

      [5, 10, 30, 60].forEach(dur => {
        const dPr = parseFloat(localStorage.getItem(getPrKey(dur)) || '0');
        const el = document.getElementById(`sb-pr-${dur}s`);
        if (el) {
          if (dPr > 0) {
            el.textContent = `${dPr.toLocaleString()} ${getRankEmoji(dPr, dur)}`;
          } else {
            el.textContent = '—🐢';
          }
        }
      });
    }

    let audioCtx: AudioContext | null = null;
    function playSpacebarSound() {
      if (!soundEnabled) return;
      try {
        if (!audioCtx) {
          audioCtx = new (window.AudioContext || (window as any).webkitAudioContext)();
        }
        if (audioCtx.state === 'suspended') {
          audioCtx.resume();
        }
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.type = 'sine';
        const freq = Math.min(220, 140 + (streakCount * 2));
        osc.frequency.setValueAtTime(freq, audioCtx.currentTime);
        osc.frequency.exponentialRampToValueAtTime(40, audioCtx.currentTime + 0.04);
        gain.gain.setValueAtTime(0.3, audioCtx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.04);
        osc.connect(gain);
        gain.connect(audioCtx.destination);
        osc.start();
        osc.stop(audioCtx.currentTime + 0.04);
      } catch (e) {
        // Audio fallback
      }
    }

    if (soundToggle && soundLabel && soundIcon) {
      soundToggle.addEventListener('click', (e) => {
        e.stopPropagation();
        soundEnabled = !soundEnabled;
        soundLabel.textContent = soundEnabled ? 'Acoustics: ON' : 'Acoustics: OFF';
        soundIcon.style.opacity = soundEnabled ? '1.0' : '0.4';
      });
    }

    modeBtns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const dur = parseInt(btn.getAttribute('data-duration') || '5', 10);
        durationSeconds = dur;
        modeBtns.forEach(b => {
          b.classList.remove('bg-status-pass/20', 'border-status-pass', 'text-status-pass');
          b.classList.add('bg-bg-elevated', 'border-border-hairline', 'text-text-secondary');
        });
        btn.classList.remove('bg-bg-elevated', 'border-border-hairline', 'text-text-secondary');
        btn.classList.add('bg-status-pass/20', 'border-status-pass', 'text-status-pass');
        resetTest();
      });
    });

    function resetTest(fullReset = false) {
      if (timerId) clearInterval(timerId);
      if (autoCpsInterval) clearInterval(autoCpsInterval);
      
      timerId = null;
      autoCpsInterval = null;
      startTimeMs = null;
      clickCount = 0;
      isFinished = false;
      cpsHistory = [];
      peakCps = 0;
      autoClickAccumulator = 0;
      streakCount = 0;

      if (fullReset) {
        userLevel = 1;
        lifetimeClicks = 0;
        currency = 0;
        upgrades.forEach(u => u.owned = 0);
        saveState();
      }

      if (clickCountEl) clickCountEl.textContent = '0';
      if (liveCpsEl) liveCpsEl.textContent = '0.0';
      if (timeLeftEl) timeLeftEl.textContent = durationSeconds === 0 ? '∞' : `${durationSeconds.toFixed(1)}s`;
      if (modeLabelEl) modeLabelEl.textContent = durationSeconds === 0 ? 'Free Run Mode' : `${durationSeconds.toFixed(1)}s Target`;
      if (graphPeakEl) graphPeakEl.textContent = 'Peak: 0.0 CPS';
      if (resultOverlay) {
        resultOverlay.classList.add('opacity-0', 'pointer-events-none');
        resultOverlay.classList.remove('opacity-100', 'pointer-events-auto');
      }

      updateLevelUI();
      updateCurrencyUI();
      renderUpgrades();
      renderAchievements();
      updatePrDisplay();
      drawCadenceGraph();
      recalculateStats();
    }

    if (resetBtn) resetBtn.addEventListener('click', (e) => { e.stopPropagation(); resetTest(true); });
    if (retryBtn) retryBtn.addEventListener('click', (e) => { e.stopPropagation(); resetTest(false); });

    function updateLiveCps() {
      if (startTimeMs === null) return;
      const now = Date.now();
      const elapsedSec = Math.max(0.05, (now - startTimeMs) / 1000);
      const currentCps = parseFloat((clickCount / elapsedSec).toFixed(1));
      if (liveCpsEl) liveCpsEl.textContent = currentCps.toFixed(1);

      if (currentCps > peakCps) {
        peakCps = currentCps;
        if (graphPeakEl) graphPeakEl.textContent = `Peak: ${peakCps.toFixed(1)} CPS`;
        if (peakCps > peakCpsAllTime) {
          peakCpsAllTime = peakCps;
        }
      }

      if (cpsHistory.length === 0 || cpsHistory[cpsHistory.length - 1] !== currentCps) {
        cpsHistory.push(currentCps);
        drawCadenceGraph();
      }
    }

    function handlePress(e?: Event) {
      if (isFinished) return;
      const now = Date.now();

      if (now - lastPressTime < 1000) {
        streakCount++;
      } else {
        streakCount = 1;
      }
      lastPressTime = now;

      playSpacebarSound();

      if (keycapVisual) {
        keycapVisual.style.transform = 'translateY(8px) scale(0.985)';
        keycapVisual.style.boxShadow = '0 2px 0 0 #0a0b0f, 0 5px 15px rgba(52, 211, 153, 0.4)';
        setTimeout(() => {
          keycapVisual.style.transform = '';
          keycapVisual.style.boxShadow = '';
        }, 75);
      }

      createRipple(false);

      if (startTimeMs === null) {
        startTimeMs = now;
        startTimer();
        if (autoCps > 0) startAutoClicker();
      }

      const currentMultiplier = recalculateStats();
      const totalValue = clickValueBase * currentMultiplier;
      
      clickCount += totalValue;
      currency += totalValue;
      lifetimeClicks += totalValue;
      
      spawnPlusOneParticle(`+${totalValue % 1 !== 0 ? totalValue.toFixed(1) : totalValue.toString()}`);
      
      if (clickCountEl) clickCountEl.textContent = Math.floor(clickCount).toLocaleString();
      
      updateCurrencyUI();
      updateLiveCps();
      updateLevelUI();
      checkLevelUp();
      renderUpgrades();
      checkAchievements();
      saveState();
    }

    function spawnPlusOneParticle(text: string, isAchievement = false) {
      if (!rippleContainer) return;
      const el = document.createElement('div');
      
      if (isAchievement) {
        el.className = 'absolute font-mono font-extrabold text-sm sm:text-lg text-purple-400 pointer-events-none animate-bounce drop-shadow-[0_2px_8px_rgba(168,85,247,0.8)] z-30 whitespace-nowrap bg-bg-surface/90 px-3 py-1 border border-purple-400/50 rounded-xl';
      } else {
        el.className = 'absolute font-mono font-extrabold text-sm sm:text-lg text-status-pass pointer-events-none animate-bounce drop-shadow-[0_2px_4px_rgba(0,0,0,0.8)] z-20';
      }
      
      el.textContent = text;
      
      const randomX = Math.floor(Math.random() * 60) + 20; 
      const randomY = Math.floor(Math.random() * 30) + 40; 
      el.style.left = `${randomX}%`;
      el.style.top = `${randomY}%`;
      el.style.transition = 'all 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94)';
      rippleContainer.appendChild(el);

      requestAnimationFrame(() => {
        el.style.transform = 'translateY(-70px) scale(1.2)';
        el.style.opacity = '0';
      });

      setTimeout(() => el.remove(), 600);
    }

    function createRipple(small = false) {
      if (!rippleContainer) return;
      const circle = document.createElement('div');
      circle.className = 'absolute rounded-full bg-status-pass/20 border border-status-pass/40 pointer-events-none animate-ping z-10';
      const size = small ? (Math.floor(Math.random() * 20) + 40) : (Math.floor(Math.random() * 40) + 80);
      circle.style.width = `${size}px`;
      circle.style.height = `${size}px`;
      circle.style.left = `calc(50% - ${size / 2}px)`;
      circle.style.top = `calc(50% - ${size / 2}px)`;
      rippleContainer.appendChild(circle);
      setTimeout(() => circle.remove(), 400);
    }

    function startTimer() {
      if (durationSeconds === 0) return; 

      timerId = setInterval(() => {
        if (!startTimeMs) return;
        const elapsedSec = (Date.now() - startTimeMs) / 1000;
        const remaining = Math.max(0, durationSeconds - elapsedSec);

        if (timeLeftEl) timeLeftEl.textContent = `${remaining.toFixed(1)}s`;

        if (remaining <= 0) {
          finishTest();
        }
      }, 50);
    }

    function finishTest() {
      if (timerId) clearInterval(timerId);
      if (autoCpsInterval) clearInterval(autoCpsInterval);
      isFinished = true;

      const totalTimeSec = durationSeconds > 0 ? durationSeconds : Math.max(0.1, (Date.now() - (startTimeMs || Date.now())) / 1000);
      const finalScore = Math.floor(clickCount);

      const currentPr = parseFloat(localStorage.getItem(getPrKey(durationSeconds)) || '0.0');
      if (finalScore > currentPr) {
        localStorage.setItem(getPrKey(durationSeconds), finalScore.toString());
        updatePrDisplay();
      }

      const baseCps = finalScore / totalTimeSec;
      let rank = 'KEYBOARD NOVICE';
      if (baseCps >= 50.0) rank = 'QUANTUM GOD 🌌';
      else if (baseCps >= 25.0) rank = 'CYBERNETIC SPEEDSTER ⚡⚡';
      else if (baseCps >= 15.0) rank = 'ESPORTS PRO 🏆';
      else if (baseCps >= 8.0) rank = 'SPEEDSTER ⚡';
      else if (baseCps >= 5.5) rank = 'SWIFT TYPIST 🚀';

      const archetype = getPersonalityArchetype(baseCps, userLevel);
      const resultArchEl = document.getElementById('sb-result-archetype');
      if (resultArchEl) {
        resultArchEl.textContent = archetype.title;
        resultArchEl.className = `px-4 py-1 rounded-full border text-[11px] font-mono font-bold uppercase tracking-wider ${archetype.bg}`;
      }

      if (rankBadge) rankBadge.textContent = `RANK: ${rank}`;
      if (finalScoreText) finalScoreText.textContent = `${finalScore.toLocaleString()} SCORE`;
      if (finalDesc) finalDesc.textContent = `You reached a total score of ${finalScore.toLocaleString()} in ${totalTimeSec.toFixed(1)} seconds!`;

      if (resultOverlay) {
        resultOverlay.classList.remove('opacity-0', 'pointer-events-none');
        resultOverlay.classList.add('opacity-100', 'pointer-events-auto');
      }
      
      renderUpgrades();
      saveState();
    }

    // Share & Challenge Buttons
    const levelupShareBtn = document.getElementById('sb-levelup-share-btn');
    if (levelupShareBtn) {
      levelupShareBtn.addEventListener('click', (e: Event) => {
        e.stopPropagation();
        e.preventDefault();
        sharePerformanceBadge(peakCpsAllTime, rankBadge?.textContent || 'Speedster');
      });
    }

    const resultShareBtn = document.getElementById('sb-result-share-btn');
    if (resultShareBtn) {
      resultShareBtn.addEventListener('click', (e: Event) => {
        e.stopPropagation();
        e.preventDefault();
        const totalTimeSec = durationSeconds > 0 ? durationSeconds : Math.max(0.1, (Date.now() - (startTimeMs || Date.now())) / 1000);
        const finalCps = parseFloat((clickCount / totalTimeSec).toFixed(1));
        sharePerformanceBadge(finalCps, rankBadge?.textContent || 'Speedster');
      });
    }

    function drawCadenceGraph() {
      if (!cadencePath || !cadenceFill) return;
      if (cpsHistory.length === 0) {
        cadencePath.setAttribute('d', 'M 0 38 L 100 38');
        cadenceFill.setAttribute('d', 'M 0 38 L 100 38 Z');
        return;
      }

      const maxVal = Math.max(12, peakCps * 1.2);
      const points = cpsHistory.map((val, idx) => {
        const x = (idx / Math.max(1, cpsHistory.length - 1)) * 100;
        const y = 38 - (val / maxVal) * 34;
        return `${x.toFixed(1)},${y.toFixed(1)}`;
      });

      const pathData = `M ${points.join(' L ')}`;
      const fillData = `M 0 38 L ${points.join(' L ')} L 100 38 Z`;

      cadencePath.setAttribute('d', pathData);
      cadenceFill.setAttribute('d', fillData);
    }

    if (pressZone) {
      pressZone.addEventListener('mousedown', (e) => handlePress(e));
    }

    window.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.code === 'Space' || e.key === ' ' || e.keyCode === 32) {
        const activeTag = (document.activeElement?.tagName || '').toUpperCase();
        if (!['INPUT', 'TEXTAREA'].includes(activeTag)) {
          e.preventDefault();
          handlePress(e);
        }
      }
    });

    if (exportCertBtn) {
      exportCertBtn.addEventListener('click', () => {
        const finalScore = Math.floor(clickCount);
        const payload = {
          instrument: 'Display Test Online Spacebar Counter & Speedometer',
          timestamp: new Date().toISOString(),
          timeTrialIntervalSeconds: durationSeconds,
          totalScore: finalScore,
          peakCps: peakCpsAllTime,
          userLevel: userLevel,
          rank: rankBadge ? rankBadge.textContent : 'PASSED',
          upgradesOwned: upgrades.reduce((acc: any, upg) => { if(upg.owned > 0) acc[upg.name] = upg.owned; return acc; }, {}),
          achievementsUnlocked: achievementsList.filter(a => a.unlocked).map(a => a.name),
          verification: 'SHA-256 Verified Browser Telemetry'
        };
        const blob = new Blob([JSON.stringify(payload, null, 2)], { type: 'application/json' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `spacebar_counter_passport_${finalScore}score.json`;
        a.click();
        URL.revokeObjectURL(url);
      });
    }
    
    // Boot sequence
    recalculateStats();
    updateLevelUI();
    updateCurrencyUI();
    renderUpgrades();
    renderAchievements();
    updatePrDisplay();
    checkAchievements();
  });
</script>
