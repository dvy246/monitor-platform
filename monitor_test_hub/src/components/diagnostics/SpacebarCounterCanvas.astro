---
/**
 * SpacebarCounterCanvas.astro
 * Premium, high-precision 3D Spacebar Counter & Speedometer Diagnostic Suite.
 * Features:
 * - 6.25u Mechanical Spacebar 3D Keycap visualizer with switch stem plunge, stabilizer wires & RGB LED aura.
 * - Zero-scroll Spacebar keydown handling (preventDefault on all Spacebar events).
 * - 5s, 10s, 30s, 60s, and Free Run (∞) time trials.
 * - Real-time CPS gauge, live cadence graph, Web Audio acoustics, personal record tracking (localStorage).
 * - Rank medal badges, and SHA-256 signed Spacebar Hardware Passport receipt export.
 * - Leveling system with Congratulations Popup, Bonus Points & Upgrade Shop integration.
 * - Upgrades & Powerups (Idle Game Mechanics).
 * - Achievements, PRs, and Lifetime State Tracking.
 */
interface Props {
  initialMode?: number;
}

const { initialMode = 5 } = Astro.props;
---

<div class="space-y-8 font-sans max-w-7xl mx-auto select-none min-w-0 relative" id="spacebar-counter-root">
  <!-- Dynamic Level Up Congratulations Modal Overlay -->
  <div id="sb-levelup-overlay" class="fixed inset-0 bg-[#0c0d12]/90 backdrop-blur-2xl flex flex-col items-center justify-center p-6 text-center space-y-5 opacity-0 pointer-events-none transition-all duration-300 z-50">
    <!-- Glowing Confetti Badge -->
    <div class="relative">
      <div class="w-20 h-20 sm:w-24 sm:h-24 rounded-3xl bg-gradient-to-tr from-amber-400 via-yellow-300 to-amber-500 text-zinc-950 font-mono font-black text-4xl flex items-center justify-center shadow-[0_0_50px_rgba(251,191,36,0.6)] animate-bounce">
        🎉
      </div>
      <div class="absolute -top-2 -right-2 px-3 py-1 rounded-full bg-status-pass text-zinc-950 font-mono font-black text-xs uppercase tracking-wider shadow-lg">
        LEVEL UP!
      </div>
    </div>

    <div class="space-y-2">
      <h3 class="text-2xl sm:text-4xl font-extrabold font-mono text-white tracking-tight">
        CONGRATULATIONS!
      </h3>
      <p class="text-sm sm:text-base font-mono text-amber-400 font-bold" id="sb-levelup-title">
        You Cleared Level 1 &amp; Reached Level 2!
      </p>
      <!-- Personality Archetype Badge -->
      <div id="sb-levelup-archetype" class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full border text-xs font-mono font-bold uppercase tracking-wider bg-amber-500/20 text-amber-400 border-amber-500/50 shadow-md">
        ⚡ Cybernetic Reflex Titan
      </div>
      <p class="text-xs sm:text-sm text-cyan-400 font-mono font-bold animate-pulse pt-1" id="sb-levelup-next-target">
        🎯 NEXT TARGET: Level 3! Tap faster or buy Auto-Tappers to reach Level 3!
      </p>
    </div>

    <div class="bg-bg-surface/90 px-6 py-4 rounded-2xl border border-amber-400/40 shadow-inner flex items-center gap-4">
      <div class="text-left">
        <div class="text-[10px] font-mono text-text-muted uppercase tracking-wider">Level Clear Bonus</div>
        <div id="sb-levelup-bonus-text" class="text-2xl font-extrabold font-mono text-status-pass tabular-nums">+150 CLICKS</div>
      </div>
    </div>

    <div class="flex flex-wrap items-center justify-center gap-3 pt-2">
      <button id="sb-levelup-claim-btn" class="px-6 py-3.5 rounded-xl bg-gradient-to-r from-amber-400 to-yellow-500 hover:from-amber-300 hover:to-yellow-400 text-zinc-950 font-mono font-black text-xs sm:text-sm uppercase tracking-wider transition-all shadow-[0_10px_30px_rgba(251,191,36,0.4)] cursor-pointer">
        BUY UPGRADES 🛒 &rarr;
      </button>
      <button id="sb-levelup-share-btn" class="px-5 py-3.5 rounded-xl bg-bg-elevated hover:bg-bg-subtle border border-border-hairline text-white font-mono font-bold text-xs sm:text-sm transition-colors cursor-pointer flex items-center gap-2">
        <span>🚀 SHARE BADGE &amp; CHALLENGE</span>
      </button>
    </div>
  </div>

  <!-- Controls & Mode Selector Deck -->
  <div class="bg-bg-surface border border-border-hairline rounded-3xl p-4 sm:p-8 shadow-2xl space-y-6 relative overflow-hidden">
    <!-- Ambient Glow Layer -->
    <div class="absolute -top-24 -right-24 w-96 h-96 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-24 -left-24 w-96 h-96 bg-cyan-500/10 rounded-full blur-3xl pointer-events-none"></div>

    <div class="relative z-10 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 border-b border-border-hairline pb-5">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-status-pass/10 border border-status-pass/30 text-xs font-mono text-status-pass font-bold uppercase tracking-wider mb-2">
          <span class="w-2 h-2 rounded-full bg-status-pass animate-pulse shadow-[0_0_8px_rgba(52,211,153,0.8)]"></span>
          <span>HIGH-PRECISION SPACEBAR SPEEDOMETER</span>
        </div>
        <h2 class="text-xl sm:text-3xl font-extrabold font-mono text-text-primary">Spacebar Counter &amp; CPS Test</h2>
        <p class="text-xs sm:text-sm text-text-muted mt-1">Press <kbd class="px-2 py-0.5 bg-bg-elevated border border-border-hairline rounded text-status-pass font-mono font-bold">SPACEBAR</kbd> or click the keycap below to start your time trial.</p>
      </div>

      <!-- Quick Actions -->
      <div class="flex items-center gap-3 self-end sm:self-auto">
        <button id="sb-sound-toggle" class="px-3.5 py-2 rounded-xl bg-bg-elevated hover:bg-bg-subtle border border-border-hairline text-xs font-mono text-text-secondary hover:text-text-primary transition-colors flex items-center gap-2 cursor-pointer shadow-sm">
          <svg id="sb-sound-icon" class="w-4 h-4 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z"/></svg>
          <span id="sb-sound-label">Acoustics: ON</span>
        </button>
        <button id="sb-reset-btn" class="px-3.5 py-2 rounded-xl bg-bg-elevated hover:bg-rose-500/20 border border-border-hairline hover:border-rose-500/40 text-xs font-mono text-text-secondary hover:text-rose-400 transition-colors flex items-center gap-2 cursor-pointer shadow-sm">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
          <span>Reset</span>
        </button>
      </div>
    </div>

    <!-- 🌟 Level Progress Header Bar -->
    <div class="relative z-10 flex flex-col md:flex-row items-start md:items-center justify-between gap-4 bg-bg-canvas/90 p-4 rounded-2xl border border-border-hairline shadow-inner">
      <div class="flex items-center gap-3">
        <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-amber-400 to-yellow-600 text-zinc-950 flex items-center justify-center font-mono font-black text-xl shadow-lg shadow-amber-500/20" id="sb-user-level-badge">
          L1
        </div>
        <div>
          <div class="text-xs font-mono font-bold text-text-primary uppercase flex items-center gap-2">
            <span>Level <span id="sb-user-level-num">1</span> Spacebar Master</span>
            <span class="text-[10px] text-amber-400 font-normal" id="sb-level-title">Beginner Tapper</span>
          </div>
          <div class="w-48 sm:w-64 h-2 rounded-full bg-zinc-800 overflow-hidden mt-1.5 border border-border-hairline">
            <div id="sb-level-bar" class="h-full bg-gradient-to-r from-amber-400 to-yellow-500 transition-all duration-300 w-0"></div>
          </div>
          <div class="text-[10px] font-mono text-cyan-400 font-bold mt-1 tracking-wide" id="sb-next-level-guide">
            ⚡ Tap faster to boost CPS! Target: Level 2 (100 Clicks)
          </div>
        </div>
      </div>
      <div class="text-xs font-mono text-text-muted">
        Next Level Threshold: <span id="sb-level-xp-text" class="text-status-pass font-extrabold">0 / 50</span> Clicks
      </div>
    </div>

    <!-- Time Duration Mode Selector -->
    <div class="relative z-10 flex flex-wrap items-center gap-2">
      <span class="text-xs font-mono text-text-muted mr-2 uppercase tracking-wider font-bold">Time Interval:</span>
      <button data-duration="5" class="sb-mode-btn px-4 py-2 rounded-xl text-xs font-mono font-bold transition-all bg-status-pass/20 border border-status-pass text-status-pass cursor-pointer shadow-sm">5 Seconds</button>
      <button data-duration="10" class="sb-mode-btn px-4 py-2 rounded-xl text-xs font-mono font-bold transition-all bg-bg-elevated border border-border-hairline text-text-secondary hover:text-text-primary cursor-pointer">10 Seconds</button>
      <button data-duration="30" class="sb-mode-btn px-4 py-2 rounded-xl text-xs font-mono font-bold transition-all bg-bg-elevated border border-border-hairline text-text-secondary hover:text-text-primary cursor-pointer">30 Seconds</button>
      <button data-duration="60" class="sb-mode-btn px-4 py-2 rounded-xl text-xs font-mono font-bold transition-all bg-bg-elevated border border-border-hairline text-text-secondary hover:text-text-primary cursor-pointer">60 Seconds</button>
      <button data-duration="0" class="sb-mode-btn px-4 py-2 rounded-xl text-xs font-mono font-bold transition-all bg-bg-elevated border border-border-hairline text-text-secondary hover:text-text-primary cursor-pointer">Free Run (∞)</button>
    </div>

    <!-- Main Telemetry Metrics Grid -->
    <div class="relative z-10 grid grid-cols-2 md:grid-cols-4 gap-4">
      <div class="bg-bg-canvas/90 p-4 sm:p-5 rounded-2xl border border-border-hairline text-center space-y-1 shadow-inner overflow-hidden min-w-0">
        <div class="text-[10px] font-mono text-text-muted uppercase tracking-wider font-bold truncate">Total Spacebar Score</div>
        <div class="text-3xl sm:text-5xl font-extrabold font-mono text-status-pass tabular-nums truncate" id="sb-click-count">0</div>
        <div class="text-[10px] font-mono text-text-muted truncate">Session Score</div>
      </div>
      <div class="bg-bg-canvas/90 p-4 sm:p-5 rounded-2xl border border-border-hairline text-center space-y-1 shadow-inner overflow-hidden min-w-0">
        <div class="text-[10px] font-mono text-text-muted uppercase tracking-wider font-bold truncate">Live Speed (CPS)</div>
        <div class="text-3xl sm:text-5xl font-extrabold font-mono text-cyan-400 tabular-nums truncate" id="sb-live-cps">0.0</div>
        <div class="text-[10px] font-mono text-text-muted truncate">Clicks / Second</div>
      </div>
      <div class="bg-bg-canvas/90 p-4 sm:p-5 rounded-2xl border border-border-hairline text-center space-y-1 shadow-inner overflow-hidden min-w-0">
        <div class="text-[10px] font-mono text-text-muted uppercase tracking-wider font-bold truncate">Time Remaining</div>
        <div class="text-3xl sm:text-5xl font-extrabold font-mono text-amber-400 tabular-nums truncate" id="sb-time-left">5.0s</div>
        <div class="text-[10px] font-mono text-text-muted truncate" id="sb-time-mode-label">5.0s Target</div>
      </div>
      <div class="bg-bg-canvas/90 p-4 sm:p-5 rounded-2xl border border-border-hairline text-center space-y-1 shadow-inner overflow-hidden min-w-0">
        <div class="text-[10px] font-mono text-text-muted uppercase tracking-wider font-bold truncate">Total Multiplier</div>
        <div class="text-3xl sm:text-5xl font-extrabold font-mono text-purple-400 tabular-nums truncate" id="sb-multiplier-display">x1.0</div>
        <div class="text-[10px] font-mono text-text-muted truncate">Click Power Scale</div>
      </div>
    </div>

    <!-- 3D Mechanical Spacebar Interactive Press Zone -->
    <div 
      id="sb-press-zone" 
      tabindex="0"
      aria-label="Interactive 3D Mechanical Spacebar Press Zone. Press spacebar or click."
      class="relative h-64 sm:h-72 bg-gradient-to-b from-[#08080c] to-[#121218] border-2 border-border-hairline hover:border-status-pass rounded-3xl flex flex-col items-center justify-center cursor-pointer select-none transition-all duration-200 group overflow-hidden shadow-[0_20px_50px_rgba(0,0,0,0.9)] focus:outline-none focus:border-status-pass focus:ring-2 focus:ring-status-pass/40 mt-4"
    >
      <!-- Dynamic RGB LED Underglow Layer -->
      <div id="sb-led-glow" class="absolute inset-0 bg-radial from-status-pass/20 via-cyan-500/10 to-transparent opacity-40 group-hover:opacity-80 transition-opacity duration-300 pointer-events-none"></div>

      <!-- Particle & Floating +1 Click Layer -->
      <div id="sb-ripple-container" class="absolute inset-0 pointer-events-none overflow-hidden z-10"></div>

      <!-- Realistic 3D 6.25u Mechanical Spacebar Keycap Illustration -->
      <div class="relative z-20 w-11/12 max-w-2xl flex flex-col items-center">
        <!-- Switch Top Plate & Stabilizer Guide Rail -->
        <div class="w-full h-3 bg-zinc-900 border border-zinc-800 rounded-t-md flex items-center justify-between px-6 mb-1 opacity-80">
          <span class="text-[9px] font-mono text-zinc-600 font-bold tracking-widest">(+) LEFT STAB</span>
          <span class="text-[9px] font-mono text-rose-500/80 font-bold tracking-widest">[MX RED SWITCH]</span>
          <span class="text-[9px] font-mono text-zinc-600 font-bold tracking-widest">RIGHT STAB (+)</span>
        </div>

        <!-- 3D Spacebar Keycap Body with Spring Compression -->
        <div 
          id="sb-keycap-visual" 
          class="relative w-full h-20 sm:h-24 bg-gradient-to-b from-[#22242e] via-[#1a1b24] to-[#12131a] border-2 border-zinc-700/80 rounded-2xl flex items-center justify-between px-6 sm:px-10 shadow-[0_12px_0_0_#0a0b0f,0_20px_30px_rgba(0,0,0,0.8)] transition-all duration-75 group-hover:border-status-pass/80"
        >
          <!-- Left Stabilizer Cross Stem (+) -->
          <div class="w-7 h-7 rounded-lg bg-zinc-800 border border-zinc-700 flex items-center justify-center text-zinc-500 font-mono text-xs font-extrabold shadow-inner">
            +
          </div>

          <!-- Spacebar Legend & Stem Diffuser -->
          <div class="flex flex-col items-center space-y-1">
            <span id="sb-keycap-text" class="font-mono font-extrabold text-lg sm:text-2xl text-white tracking-[0.25em] uppercase group-hover:text-status-pass transition-colors drop-shadow-[0_2px_10px_rgba(52,211,153,0.5)]">
              SPACEBAR
            </span>
            <span class="text-[10px] font-mono text-zinc-500 uppercase tracking-widest">6.25u CHERRY PROFILE</span>
          </div>

          <!-- Right Stabilizer Cross Stem (+) -->
          <div class="w-7 h-7 rounded-lg bg-zinc-800 border border-zinc-700 flex items-center justify-center text-zinc-500 font-mono text-xs font-extrabold shadow-inner">
            +
          </div>
        </div>
      </div>

      <p class="relative z-20 text-xs sm:text-sm font-mono text-text-muted mt-6 group-hover:text-text-secondary transition-colors flex items-center gap-2">
        <span>PRESS</span>
        <kbd class="px-3 py-1 bg-bg-elevated border border-border-hairline rounded-lg text-status-pass font-extrabold shadow-md">SPACEBAR</kbd>
        <span>OR TAP CANVAS TO START</span>
      </p>

      <!-- Dynamic Medal Rank Badge Overlay upon completion -->
      <div id="sb-result-overlay" class="absolute inset-0 bg-[#0c0d12]/95 backdrop-blur-xl flex flex-col items-center justify-center p-6 text-center space-y-3 opacity-0 pointer-events-none transition-opacity duration-300 z-30">
        <div id="sb-rank-badge" class="px-4 py-1.5 rounded-full bg-status-pass/20 border border-status-pass text-status-pass font-mono font-extrabold text-xs tracking-wider uppercase shadow-lg shadow-status-pass/20">
          RANK: SPEEDSTER ⚡
        </div>
        <div id="sb-result-archetype" class="px-4 py-1 rounded-full border text-[11px] font-mono font-bold uppercase tracking-wider bg-purple-500/20 text-purple-400 border-purple-500/50">
          🌌 Quantum Reflex Sovereign
        </div>
        <div class="space-y-1">
          <div class="text-3xl sm:text-5xl font-extrabold font-mono text-white tracking-tight" id="sb-final-score-text">
            7.8 CPS
          </div>
          <p class="text-xs sm:text-sm text-text-muted max-w-md mx-auto leading-relaxed" id="sb-final-desc">
            You registered 39 spacebar score in 5.0 seconds!
          </p>
        </div>
        <div class="flex flex-wrap items-center justify-center gap-2.5 pt-1">
          <button id="sb-retry-btn" class="px-5 py-2.5 rounded-xl bg-status-pass text-bg-canvas font-mono font-extrabold text-xs uppercase tracking-wider hover:bg-emerald-400 transition-colors shadow-lg shadow-status-pass/20 cursor-pointer">
            TRY AGAIN &rarr;
          </button>
          <button id="sb-result-share-btn" class="px-4 py-2.5 rounded-xl bg-gradient-to-r from-amber-400 to-yellow-500 hover:from-amber-300 hover:to-yellow-400 text-zinc-950 font-mono font-black text-xs uppercase tracking-wider transition-all cursor-pointer shadow-md">
            🚀 SHARE &amp; CHALLENGE
          </button>
          <button id="sb-export-cert" class="px-4 py-2.5 rounded-xl bg-bg-elevated hover:bg-bg-subtle border border-border-hairline text-white font-mono font-bold text-xs transition-colors cursor-pointer">
            📜 EXPORT CERT
          </button>
        </div>
      </div>
    </div>

    <!-- Live Cadence Speed Graph (CPS over time) -->
    <div class="relative z-10 bg-bg-canvas/90 p-5 rounded-2xl border border-border-hairline space-y-3 shadow-inner mt-4">
      <div class="flex flex-wrap items-center justify-between text-xs font-mono gap-2">
        <span class="text-text-muted uppercase tracking-wider font-bold">Live CPS Speed Cadence Graph</span>
        <span class="text-cyan-400 font-bold" id="sb-graph-peak">Peak: 0.0 CPS</span>
      </div>
      <div class="h-24 w-full relative">
        <svg id="sb-cadence-svg" class="w-full h-full text-cyan-400" preserveAspectRatio="none" viewBox="0 0 100 40">
          <path id="sb-cadence-path" d="M 0 38 L 100 38" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
          <path id="sb-cadence-fill" d="M 0 38 L 100 38 Z" fill="currentColor" fill-opacity="0.15"/>
        </svg>
      </div>
    </div>

    <!-- ⚡ Upgrades & Powerups Section -->
    <div class="relative z-10 bg-bg-canvas/90 p-5 sm:p-6 rounded-2xl border border-border-hairline shadow-inner mt-4" id="sb-upgrades-section">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-5 border-b border-border-hairline pb-4">
        <div>
          <h3 class="text-sm font-mono font-bold text-text-primary uppercase tracking-wider flex items-center gap-2">
            <span class="text-amber-400">⚡</span> UPGRADES & POWERUPS SHOP
          </h3>
          <p class="text-xs text-text-muted mt-1 max-w-lg">Boost your click power, unlock mechanical switches, and automate your CPS using points from clearing levels.</p>
        </div>
        <div class="text-xs font-mono bg-bg-elevated px-4 py-2.5 rounded-xl border border-border-hairline shadow-sm min-w-[140px] text-center">
          <div class="text-[10px] text-text-muted uppercase tracking-wider mb-0.5">Available Currency</div>
          <span id="sb-available-currency" class="text-lg text-status-pass font-extrabold tabular-nums">0</span> <span class="text-text-muted text-[10px]">CLICKS</span>
        </div>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3" id="sb-upgrades-grid">
        <!-- Upgrades generated via JS -->
      </div>
    </div>

    <!-- 🥇 Personal Best Records -->
    <div class="relative z-10 bg-bg-canvas/90 p-5 sm:p-6 rounded-2xl border border-border-hairline shadow-inner mt-4">
      <div class="flex items-center gap-2 mb-4 border-b border-border-hairline pb-2">
        <h3 class="text-sm font-mono font-bold text-text-primary uppercase tracking-wider flex items-center gap-2">
          <span class="text-amber-400">🥇</span> Personal Best Records
        </h3>
      </div>
      <p class="text-xs text-text-muted mb-4">Your highest recorded CPS across all spacebar test modes, saved locally.</p>
      
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-3">
        <!-- Lifetime Clicks -->
        <div class="p-3 rounded-xl bg-bg-elevated border border-border-hairline col-span-2">
          <div class="text-[10px] text-text-muted uppercase tracking-wider font-bold mb-1">Total Lifetime Clicks</div>
          <div class="text-xl sm:text-2xl font-extrabold font-mono text-status-pass" id="sb-lifetime-clicks">0</div>
        </div>
        <!-- Peak All Time -->
        <div class="p-3 rounded-xl bg-bg-elevated border border-border-hairline col-span-2">
          <div class="text-[10px] text-text-muted uppercase tracking-wider font-bold mb-1">Peak CPS (All-Time)</div>
          <div class="text-xl sm:text-2xl font-extrabold font-mono text-cyan-400" id="sb-peak-cps-alltime">0.0</div>
        </div>
        <!-- 5s, 10s -->
        <div class="p-3 rounded-xl bg-bg-elevated border border-border-hairline text-center">
          <div class="text-[10px] text-text-muted uppercase tracking-wider font-bold mb-1">5 Sec</div>
          <div class="text-lg font-extrabold font-mono text-purple-400" id="sb-pr-5s">—🐢</div>
        </div>
        <div class="p-3 rounded-xl bg-bg-elevated border border-border-hairline text-center">
          <div class="text-[10px] text-text-muted uppercase tracking-wider font-bold mb-1">10 Sec</div>
          <div class="text-lg font-extrabold font-mono text-purple-400" id="sb-pr-10s">—🐢</div>
        </div>
        <!-- 30s, 60s -->
        <div class="p-3 rounded-xl bg-bg-elevated border border-border-hairline text-center">
          <div class="text-[10px] text-text-muted uppercase tracking-wider font-bold mb-1">30 Sec</div>
          <div class="text-lg font-extrabold font-mono text-purple-400" id="sb-pr-30s">—🐢</div>
        </div>
        <div class="p-3 rounded-xl bg-bg-elevated border border-border-hairline text-center">
          <div class="text-[10px] text-text-muted uppercase tracking-wider font-bold mb-1">60 Sec</div>
          <div class="text-lg font-extrabold font-mono text-purple-400" id="sb-pr-60s">—🐢</div>
        </div>
      </div>
    </div>

    <!-- 🏆 Achievements & Rewards -->
    <div class="relative z-10 bg-bg-canvas/90 p-5 sm:p-6 rounded-2xl border border-border-hairline shadow-inner mt-4">
      <div class="flex justify-between items-center mb-4 border-b border-border-hairline pb-4">
        <div>
          <h3 class="text-sm font-mono font-bold text-text-primary uppercase tracking-wider flex items-center gap-2">
            <span class="text-amber-400">🏆</span> Achievements & Rewards
          </h3>
          <p class="text-xs text-text-muted mt-1">Unlock milestones to gain permanent score multiplier bonuses.</p>
        </div>
