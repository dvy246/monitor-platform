---
import ErgonomicsNotice from '../disclaimers/ErgonomicsNotice.astro';
import HardwareLimitationNotice from '../disclaimers/HardwareLimitationNotice.astro';
---

<div class="bg-bg-surface border border-border-hairline rounded-2xl p-6 sm:p-8 space-y-8 shadow-2xl font-mono">
  <!-- Header Deck -->
  <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 border-b border-border-hairline pb-5">
    <div>
      <div class="text-xs font-bold text-status-pass uppercase tracking-widest flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-status-pass led-glow-pass animate-pulse"></span>
        <span>W3C POINTER EVENTS LEVEL 3 — HARDWARE DIGITIZER TELEMETRY</span>
      </div>
      <h3 class="text-xl font-extrabold text-text-primary mt-1">Touch Sampling Rate &amp; Coalesced Event Inspector</h3>
    </div>
    <div id="touch-rating-badge" class="px-3 py-1 rounded-full bg-status-pass/10 border border-status-pass/30 text-status-pass text-xs font-bold uppercase">
      SWIPE CANVAS TO MEASURE HZ
    </div>
  </div>

  <!-- Main 12-col Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
    <!-- Touch Canvas Column (6 cols) -->
    <div class="lg:col-span-6 bg-bg-canvas p-5 rounded-xl border border-border-hairline space-y-4">
      <div class="flex items-center justify-between">
        <span class="text-xs font-bold text-text-primary uppercase tracking-wider">Interactive Touch Swipe Canvas</span>
        <button id="btn-clear-canvas" class="px-3 py-1 bg-bg-surface border border-border-hairline rounded text-[11px] font-bold text-text-secondary hover:text-text-primary hover:bg-bg-elevated transition-colors cursor-pointer">
          Clear Canvas
        </button>
      </div>

      <!-- Canvas Box -->
      <div class="relative w-full h-[320px] rounded-xl border border-border-hairline bg-[#08080a] overflow-hidden touch-none cursor-crosshair">
        <canvas id="touch-canvas" class="w-full h-full block"></canvas>
        <div id="canvas-overlay-text" class="absolute inset-0 flex items-center justify-center pointer-events-none text-text-muted text-xs font-sans text-center p-6">
          <span>Swipe or drag rapidly across this canvas to record hardware touch sampling rate &amp; coalesced points.</span>
        </div>
      </div>

      <!-- Controls below canvas -->
      <div class="grid grid-cols-2 gap-3 text-xs pt-1">
        <div>
          <label for="ts-display-fps" class="text-text-secondary font-bold block mb-1 uppercase">Display Refresh Rate</label>
          <select id="ts-display-fps" class="w-full bg-bg-surface border border-border-hairline rounded-lg p-2 text-text-primary font-mono cursor-pointer focus:ring-2 focus:ring-status-pass outline-none">
            <option value="60">60 Hz Standard</option>
            <option value="90">90 Hz Smooth</option>
            <option value="120" selected>120 Hz ProMotion / Mobile</option>
            <option value="144">144 Hz Gaming</option>
            <option value="240">240 Hz Esports</option>
            <option value="360">360 Hz Ultra-High</option>
            <option value="540">540 Hz Maximum</option>
          </select>
        </div>

        <div class="flex flex-col justify-end">
          <div id="coalesced-support-badge" class="p-2 rounded-lg bg-bg-surface border border-border-hairline text-[11px] text-center font-bold text-cyan-400">
            Coalesced Events: Checking...
          </div>
        </div>
      </div>
    </div>

    <!-- Telemetry Column (6 cols) -->
    <div class="lg:col-span-6 bg-bg-canvas p-5 rounded-xl border border-border-hairline space-y-6">
      <h4 class="text-sm font-bold text-text-primary border-b border-border-hairline pb-2 flex items-center justify-between">
        <span>📊 HARDWARE DIGITIZER TELEMETRY</span>
        <span id="sync-ratio-label" class="text-xs font-mono font-bold text-status-pass">SYNC RATIO: —</span>
      </h4>

      <!-- Key Stat Grid -->
      <div class="grid grid-cols-2 gap-4">
        <!-- Measured Hz Speedometer -->
        <div class="bg-bg-surface p-4 rounded-xl border border-border-hairline space-y-1">
          <div class="text-[11px] text-text-muted font-bold uppercase">Measured Hardware Rate</div>
          <div id="stat-measured-hz" class="text-3xl font-black text-status-pass">0 Hz</div>
          <div id="stat-peak-hz" class="text-[10px] text-text-secondary font-sans">Peak: 0 Hz</div>
        </div>

        <!-- Jitter Variance -->
        <div class="bg-bg-surface p-4 rounded-xl border border-border-hairline space-y-1">
          <div class="text-[11px] text-text-muted font-bold uppercase">Inter-Sample Jitter</div>
          <div id="stat-jitter-sd" class="text-3xl font-black text-cyan-400">&plusmn;0.00 ms</div>
          <div id="stat-avg-delta" class="text-[10px] text-text-secondary font-sans">Avg Delta: 0.00 ms</div>
        </div>

        <!-- Coalesced Ratio -->
        <div class="bg-bg-surface p-4 rounded-xl border border-border-hairline space-y-1">
          <div class="text-[11px] text-text-muted font-bold uppercase">Coalesced Buffer Depth</div>
          <div id="stat-coalesced-ratio" class="text-2xl font-black text-amber-400">1.00x</div>
          <div id="stat-sample-count" class="text-[10px] text-text-secondary font-sans">0 Points Captured</div>
        </div>

        <!-- Beat Frequency Stutter -->
        <div class="bg-bg-surface p-4 rounded-xl border border-border-hairline space-y-1">
          <div class="text-[11px] text-text-muted font-bold uppercase">VSync Beat Frequency</div>
          <div id="stat-beat-freq" class="text-2xl font-black text-purple-400">0.0 Hz</div>
          <div class="text-[10px] text-text-secondary font-sans">Phase beat stutter</div>
        </div>
      </div>

      <!-- Sampling Interval Histogram Buckets -->
      <div class="space-y-3 bg-bg-surface p-4 rounded-xl border border-border-hairline">
        <div class="text-xs font-bold text-text-primary uppercase tracking-wider">Inter-Sample Delta Interval Histogram</div>
        
        <div id="histogram-container" class="space-y-2 text-xs">
          <!-- Dyn buckets inserted via JS -->
          <div class="text-[11px] text-text-muted text-center py-2">Swipe canvas to generate interval distribution histogram.</div>
        </div>
      </div>

      <!-- Rating Description Box -->
      <div class="p-4 bg-bg-surface rounded-xl border border-border-hairline space-y-2">
        <div class="text-xs font-bold text-amber-400 uppercase tracking-wider">Digitizer Hardware Rating:</div>
        <p id="rating-description-text" class="text-text-secondary text-xs leading-relaxed">
          Insufficient touch event data. Swipe rapidly across the canvas to record hardware touch sampling rate metrics.
        </p>
      </div>
    </div>
  </div>

  <HardwareLimitationNotice />
  <ErgonomicsNotice />
</div>

<script>
  import {
    extractHardwarePoints,
    calculateTouchSamplingMetrics,
    generateSamplingHistogram,
    type HardwareTouchPoint
  } from '../../engine/TouchSamplingRateEngine';

  function initTouchInspector() {
    const canvas = document.getElementById('touch-canvas') as HTMLCanvasElement;
    const overlayText = document.getElementById('canvas-overlay-text');
    const clearBtn = document.getElementById('btn-clear-canvas');
    const displayFpsSelect = document.getElementById('ts-display-fps') as HTMLSelectElement;

    const coalescedSupportBadge = document.getElementById('coalesced-support-badge');
    const touchRatingBadge = document.getElementById('touch-rating-badge');
    const syncRatioLabel = document.getElementById('sync-ratio-label');

    const statMeasuredHz = document.getElementById('stat-measured-hz');
    const statPeakHz = document.getElementById('stat-peak-hz');
    const statJitterSd = document.getElementById('stat-jitter-sd');
    const statAvgDelta = document.getElementById('stat-avg-delta');
    const statCoalescedRatio = document.getElementById('stat-coalesced-ratio');
    const statSampleCount = document.getElementById('stat-sample-count');
    const statBeatFreq = document.getElementById('stat-beat-freq');

    const histogramContainer = document.getElementById('histogram-container');
    const ratingDescText = document.getElementById('rating-description-text');

    if (!canvas) return;
    const ctx = canvas.getContext('2d');

    let recordedPoints: HardwareTouchPoint[] = [];
    let isPointerDown = false;

    function resizeCanvas() {
      if (!canvas) return;
      const rect = canvas.getBoundingClientRect();
      canvas.width = Math.round(rect.width * window.devicePixelRatio);
      canvas.height = Math.round(rect.height * window.devicePixelRatio);
      if (ctx) ctx.scale(window.devicePixelRatio, window.devicePixelRatio);
      redrawCanvas();
    }

    if (typeof ResizeObserver !== 'undefined' && canvas.parentElement) {
      const ro = new ResizeObserver(() => resizeCanvas());
      ro.observe(canvas.parentElement);
    }

    window.addEventListener('resize', resizeCanvas);
    resizeCanvas();

    function redrawCanvas() {
      if (!canvas || !ctx) return;
      const rect = canvas.getBoundingClientRect();
      ctx.clearRect(0, 0, rect.width, rect.height);

      if (recordedPoints.length < 2) return;

      // Draw trajectory path
      ctx.beginPath();
      ctx.strokeStyle = '#059669';
      ctx.lineWidth = 3;
      ctx.lineCap = 'round';
      ctx.lineJoin = 'round';

      recordedPoints.forEach((p, idx) => {
        if (idx === 0) ctx.moveTo(p.x, p.y);
        else ctx.lineTo(p.x, p.y);
      });
      ctx.stroke();

      // Draw sample markers
      recordedPoints.forEach((p) => {
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.isCoalesced ? 2 : 4, 0, Math.PI * 2);
        ctx.fillStyle = p.isCoalesced ? '#38bdf8' : '#f59e0b';
        ctx.fill();
      });
    }

    function processPoints() {
      const displayFps = parseInt(displayFpsSelect.value, 10);
      const metrics = calculateTouchSamplingMetrics(recordedPoints, displayFps);
      const histogram = generateSamplingHistogram(recordedPoints);

      if (statMeasuredHz) statMeasuredHz.textContent = `${metrics.measuredHardwareHz} Hz`;
      if (statPeakHz) statPeakHz.textContent = `Peak: ${metrics.peakHardwareHz} Hz`;
      if (statJitterSd) statJitterSd.textContent = `\u00B1${metrics.jitterStdDevMs.toFixed(2)} ms`;
      if (statAvgDelta) statAvgDelta.textContent = `Avg Delta: ${metrics.averageDeltaMs.toFixed(2)} ms`;
      if (statCoalescedRatio) statCoalescedRatio.textContent = `${metrics.coalescedRatio.toFixed(2)}x`;
      if (statSampleCount) statSampleCount.textContent = `${metrics.sampleCount} Points (${metrics.coalescedEventCount} Coalesced)`;
      if (statBeatFreq) statBeatFreq.textContent = `${metrics.beatFrequencyHz.toFixed(1)} Hz`;

      if (syncRatioLabel) syncRatioLabel.textContent = `SYNC RATIO: ${metrics.syncRatio.toFixed(2)}x`;

      if (coalescedSupportBadge) {
        if (metrics.supportsCoalescedEvents) {
          coalescedSupportBadge.textContent = 'Coalesced Events: W3C ACTIVE (\u2713)';
          coalescedSupportBadge.className = 'p-2 rounded-lg bg-status-pass/10 border border-status-pass/30 text-[11px] text-center font-bold text-status-pass';
        } else {
          coalescedSupportBadge.textContent = 'Coalesced Events: STANDARD DISPATCH';
          coalescedSupportBadge.className = 'p-2 rounded-lg bg-bg-surface border border-border-hairline text-[11px] text-center font-bold text-text-secondary';
        }
      }

      if (touchRatingBadge) {
        touchRatingBadge.textContent = `${metrics.rating.replace('_', ' ')} (${metrics.measuredHardwareHz} Hz)`;
        if (metrics.rating === 'ULTRA_HIGH') {
          touchRatingBadge.className = 'px-3 py-1 rounded-full bg-status-pass/10 border border-status-pass/30 text-status-pass text-xs font-bold uppercase';
        } else if (metrics.rating === 'HIGH') {
          touchRatingBadge.className = 'px-3 py-1 rounded-full bg-cyan-400/10 border border-cyan-400/30 text-cyan-400 text-xs font-bold uppercase';
        } else if (metrics.rating === 'STANDARD') {
          touchRatingBadge.className = 'px-3 py-1 rounded-full bg-amber-400/10 border border-amber-400/30 text-amber-400 text-xs font-bold uppercase';
        } else {
          touchRatingBadge.className = 'px-3 py-1 rounded-full bg-rose-400/10 border border-rose-400/30 text-rose-400 text-xs font-bold uppercase';
        }
      }

      if (ratingDescText) ratingDescText.textContent = metrics.ratingDescription;

      // Render histogram
      if (histogramContainer && recordedPoints.length >= 2) {
        histogramContainer.innerHTML = '';
        const maxCount = Math.max(...histogram.map((h) => h.count), 1);
        histogram.forEach((bucket) => {
          const pct = Math.round((bucket.count / maxCount) * 100);
          const row = document.createElement('div');
          row.className = 'space-y-1';
          row.innerHTML = `
            <div class="flex justify-between text-[11px]">
              <span class="text-text-secondary">${bucket.binLabel}:</span>
              <span class="text-text-primary font-bold">${bucket.count} samples</span>
            </div>
            <div class="bg-bg-elevated rounded-full h-1.5 overflow-hidden">
              <div class="h-1.5 bg-status-pass rounded-full transition-all duration-300" style="width: ${pct}%"></div>
            </div>
          `;
          histogramContainer.appendChild(row);
        });
      }

      redrawCanvas();
    }

    function handlePointer(e: PointerEvent) {
      if (!isPointerDown && e.type !== 'pointermove') return;
      if (e.type === 'pointerdown') {
        isPointerDown = true;
        if (overlayText) overlayText.style.display = 'none';
      }

      const rect = canvas.getBoundingClientRect();
      const hwPoints = extractHardwarePoints(e);

      hwPoints.forEach((pt) => {
        recordedPoints.push({
          x: pt.x - rect.left,
          y: pt.y - rect.top,
          timestamp: pt.timestamp,
          isCoalesced: pt.isCoalesced,
          pointerId: pt.pointerId,
        });
      });

      // Keep last 500 points
      if (recordedPoints.length > 500) {
        recordedPoints = recordedPoints.slice(-500);
      }

      processPoints();
    }

    canvas.addEventListener('pointerdown', (e) => {
      canvas.setPointerCapture(e.pointerId);
      handlePointer(e);
    });

    canvas.addEventListener('pointermove', handlePointer);

    const endPointer = (e: PointerEvent) => {
      isPointerDown = false;
      try {
        if (canvas.hasPointerCapture(e.pointerId)) {
          canvas.releasePointerCapture(e.pointerId);
        }
      } catch {
        // Ignore
      }
    };

    canvas.addEventListener('pointerup', endPointer);
    canvas.addEventListener('pointercancel', endPointer);
    canvas.addEventListener('pointerleave', endPointer);

    clearBtn?.addEventListener('click', () => {
      recordedPoints = [];
      if (overlayText) overlayText.style.display = 'flex';
      processPoints();
    });

    displayFpsSelect?.addEventListener('change', processPoints);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initTouchInspector);
  } else {
    initTouchInspector();
  }
</script>
