---
import { TvViewingDistanceEngine, type ScreenResolution, type AspectRatio } from '../../engine/TvViewingDistanceEngine';

interface Props {
  initialDiagonal?: number;
  initialResolution?: ScreenResolution;
  initialAspectRatio?: AspectRatio;
}

const { initialDiagonal = 65, initialResolution = '4K', initialAspectRatio = '16:9' } = Astro.props;

const initialResult = TvViewingDistanceEngine.calculateViewingDistance(initialDiagonal, initialResolution, initialAspectRatio);
---

<div class="w-full max-w-7xl mx-auto space-y-6 font-sans select-none min-w-0" id="tv-distance-root">
  <div class="relative bg-[#0c0d12]/95 border border-zinc-800/90 rounded-3xl p-4 sm:p-8 backdrop-blur-2xl shadow-[0_25px_60px_rgba(0,0,0,0.8)] space-y-6 overflow-hidden min-w-0 text-zinc-100 font-mono">
    <!-- Ambient Glows -->
    <div class="absolute -top-24 -right-24 w-96 h-96 bg-cyan-500/10 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-24 -left-24 w-96 h-96 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none"></div>

    <!-- Header Controls -->
    <div class="relative z-10 flex flex-col md:flex-row items-start md:items-center justify-between gap-4 border-b border-zinc-800/70 pb-5">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/30 text-[11px] font-mono text-cyan-400 font-bold uppercase tracking-wider mb-2">
          <span class="w-2 h-2 rounded-full bg-cyan-400 shadow-[0_0_8px_rgba(34,211,238,0.9)] animate-pulse"></span>
          <span>SMPTE &amp; THX OPTICAL VISUAL ACUITY ENGINE</span>
        </div>
        <h2 class="text-xl sm:text-3xl font-extrabold font-mono text-white tracking-tight">TV &amp; Projector Screen Distance Calculator</h2>
        <p class="text-xs sm:text-sm text-zinc-400 mt-1 font-sans font-normal">SMPTE (30°/40° FOV) &amp; THX cinema angular resolution distance solver.</p>
      </div>
    </div>

    <div class="relative z-10 grid grid-cols-1 lg:grid-cols-3 gap-6">
      <!-- Input Deck -->
      <div class="space-y-5 bg-zinc-950/80 p-5 sm:p-6 rounded-2xl border border-zinc-800/80 text-xs shadow-inner">
        <div>
          <label class="flex items-center gap-1.5 font-bold uppercase text-zinc-400 mb-2">
            <svg class="w-4 h-4 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <span>Screen Size (Diagonal Inches)</span>
          </label>
          <input id="diagonal-input" type="number" value={initialDiagonal} min="24" max="200" class="w-full bg-zinc-900 border border-zinc-700/80 rounded-xl p-3 text-sm text-white focus:border-cyan-500 focus:outline-none" />
        </div>

        <div>
          <label class="flex items-center gap-1.5 font-bold uppercase text-zinc-400 mb-2">
            <svg class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 10h16M4 14h16M4 18h16" />
            </svg>
            <span>Resolution</span>
          </label>
          <select id="res-select" class="w-full bg-zinc-900 border border-zinc-700/80 rounded-xl p-3 text-sm text-white focus:border-cyan-500 focus:outline-none cursor-pointer">
            <option value="1080p" selected={initialResolution === '1080p'}>Full HD (1080p)</option>
            <option value="4K" selected={initialResolution === '4K'}>4K Ultra HD (2160p)</option>
            <option value="8K" selected={initialResolution === '8K'}>8K Ultra HD (4320p)</option>
          </select>
        </div>
      </div>

      <!-- Distance Metrics Deck -->
      <div class="lg:col-span-2 space-y-5">
        <div class="bg-zinc-950/80 p-5 sm:p-6 rounded-2xl border border-zinc-800/80 grid grid-cols-1 sm:grid-cols-3 gap-4 text-center shadow-inner">
          <div class="bg-zinc-900/90 p-4 rounded-xl border border-zinc-800 space-y-1">
            <div class="text-[11px] text-zinc-400 font-bold uppercase">Optimal Viewing Distance</div>
            <div id="dist-optimal" class="text-2xl sm:text-3xl font-extrabold text-cyan-400 mt-1 tabular-nums">{initialResult.formattedOptimalFeet}</div>
          </div>

          <div class="bg-zinc-900/90 p-4 rounded-xl border border-zinc-800 space-y-1">
            <div class="text-[11px] text-zinc-400 font-bold uppercase">THX Cinema (36° FOV)</div>
            <div id="dist-thx" class="text-2xl sm:text-3xl font-extrabold text-amber-400 mt-1 tabular-nums">{initialResult.formattedThxFeet}</div>
          </div>

          <div class="bg-zinc-900/90 p-4 rounded-xl border border-zinc-800 space-y-1">
            <div class="text-[11px] text-zinc-400 font-bold uppercase">Max Acuity Distance</div>
            <div id="dist-acuity" class="text-2xl sm:text-3xl font-extrabold text-emerald-400 mt-1 tabular-nums">{initialResult.formattedMaxAcuityFeet}</div>
          </div>
        </div>

        <div class="bg-zinc-950/80 p-5 sm:p-6 rounded-2xl border border-zinc-800/80 space-y-3 text-xs shadow-inner">
          <div class="text-zinc-400 uppercase font-bold">SMPTE &amp; THX Standard Guidance:</div>
          <p id="tv-desc" class="text-zinc-300 font-sans leading-relaxed">
            {initialResult.explanation}
          </p>
        </div>
      </div>
    </div>
  </div>
</div>
