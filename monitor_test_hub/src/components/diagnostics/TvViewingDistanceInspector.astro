---
import { TvViewingDistanceEngine, type ScreenResolution, type AspectRatio } from '../../engine/TvViewingDistanceEngine';

interface Props {
  initialDiagonal?: number;
  initialResolution?: ScreenResolution;
  initialAspectRatio?: AspectRatio;
}

const { initialDiagonal = 65, initialResolution = '4K', initialAspectRatio = '16:9' } = Astro.props;

const initialResult = TvViewingDistanceEngine.calculateViewingDistance(initialDiagonal, initialResolution, initialAspectRatio);
---

<div class="w-full max-w-5xl mx-auto p-4 md:p-6 bg-[#121215] border border-white/10 rounded-2xl shadow-2xl text-slate-100 font-sans">
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-6 border-b border-white/10">
    <div>
      <div class="flex items-center gap-2 text-cyan-400 text-xs font-mono uppercase tracking-widest mb-1">
        <svg class="w-4 h-4 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
        </svg>
        <span>Optical Optics Engine</span>
      </div>
      <h2 class="text-2xl md:text-3xl font-black text-white tracking-tight">TV &amp; Projector Screen Calculator</h2>
      <p class="text-sm text-slate-400 mt-1">SMPTE (30°/40° FOV) &amp; THX (36° FOV) angular resolution distance standards.</p>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mt-6">
    <div class="space-y-4 bg-black/30 p-5 rounded-xl border border-white/5">
      <div>
        <label class="flex items-center gap-1.5 text-xs font-mono uppercase text-slate-400 mb-2">
          <svg class="w-4 h-4 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          <span>Screen Size (Diagonal Inches)</span>
        </label>
        <input id="diagonal-input" type="number" value={initialDiagonal} min="24" max="200" class="w-full bg-[#18181b] border border-white/10 rounded-lg p-2.5 text-sm text-white focus:border-cyan-500 focus:outline-none" />
      </div>

      <div>
        <label class="flex items-center gap-1.5 text-xs font-mono uppercase text-slate-400 mb-2">
          <svg class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 10h16M4 14h16M4 18h16" />
          </svg>
          <span>Resolution</span>
        </label>
        <select id="res-select" class="w-full bg-[#18181b] border border-white/10 rounded-lg p-2.5 text-sm text-white focus:border-cyan-500 focus:outline-none cursor-pointer">
          <option value="1080p" selected={initialResolution === '1080p'}>Full HD (1080p)</option>
          <option value="4K" selected={initialResolution === '4K'}>4K UHD</option>
          <option value="8K" selected={initialResolution === '8K'}>8K UHD</option>
        </select>
      </div>
    </div>

    <div class="lg:col-span-2 space-y-6">
      <div class="bg-black/40 p-6 rounded-xl border border-white/5 grid grid-cols-1 sm:grid-cols-3 gap-4 text-center">
        <div class="bg-[#18181b] p-4 rounded-xl border border-white/5">
          <div class="text-xs text-slate-400 font-mono uppercase">Cinema Minimum</div>
          <div class="text-2xl font-black text-cyan-400 mt-1">{initialResult.minDistanceFeet} ft</div>
          <div class="text-xs text-slate-500 mt-1">40° FOV Immersive</div>
        </div>

        <div class="bg-[#18181b] p-4 rounded-xl border border-white/5">
          <div class="text-xs text-slate-400 font-mono uppercase">THX Ideal</div>
          <div class="text-2xl font-black text-emerald-400 mt-1">{initialResult.idealThxDistanceFeet} ft</div>
          <div class="text-xs text-slate-500 mt-1">36° FOV Standard</div>
        </div>

        <div class="bg-[#18181b] p-4 rounded-xl border border-white/5">
          <div class="text-xs text-slate-400 font-mono uppercase">SMPTE Limit</div>
          <div class="text-2xl font-black text-amber-400 mt-1">{initialResult.maxDistanceFeet} ft</div>
          <div class="text-xs text-slate-500 mt-1">30° FOV General</div>
        </div>
      </div>

      <div class="bg-black/30 p-5 rounded-xl border border-white/5 space-y-2">
        <div class="flex items-center justify-between text-xs text-slate-400 font-mono uppercase">
          <span>Physical Dimensions</span>
          <span class="text-white font-bold">{initialResult.dimensions.widthInches}" W × {initialResult.dimensions.heightInches}" H</span>
        </div>
        <div class="flex items-center justify-between text-xs text-slate-400 font-mono uppercase">
          <span>4K Benefit Distance Limit</span>
          <span class="text-emerald-400 font-bold">&lt; {initialResult.fourKBenefitDistanceFeet} ft</span>
        </div>
      </div>
    </div>
  </div>
</div>
