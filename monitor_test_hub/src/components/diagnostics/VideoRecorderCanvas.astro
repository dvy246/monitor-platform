---
/**
 * VideoRecorderCanvas.astro
 * High-fidelity in-browser HD Camera Video & Audio Recorder.
 * Features:
 * - W3C MediaRecorder API (VP9/VP8/H264 + Opus Audio Sync).
 * - 100% Local In-Browser Processing (0% server upload, 100% privacy).
 * - Real-time recording timer, audio VU level meter, pause/resume.
 * - 1-Click WEBM/MP4 Video File Download.
 */
---

<div class="w-full max-w-6xl mx-auto space-y-6 font-sans select-none min-w-0" id="video-recorder-root">
  <!-- Header Control Deck -->
  <div class="relative bg-[#0c0d12]/90 border border-zinc-800/90 rounded-2xl p-4 sm:p-6 backdrop-blur-2xl shadow-[0_25px_60px_rgba(0,0,0,0.8)] space-y-6 overflow-hidden">
    <!-- Ambient Radial Glows -->
    <div class="absolute -top-24 -right-24 w-96 h-96 bg-rose-500/10 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-24 -left-24 w-96 h-96 bg-cyan-500/10 rounded-full blur-3xl pointer-events-none"></div>

    <div class="relative z-10 flex flex-col lg:flex-row lg:items-center justify-between gap-4 border-b border-zinc-800/70 pb-5">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-rose-500/10 border border-rose-500/30 text-[11px] font-mono text-rose-400 font-bold uppercase tracking-wider mb-2">
          <span class="w-2 h-2 rounded-full bg-rose-500 shadow-[0_0_8px_rgba(244,63,94,0.9)] animate-pulse"></span>
          <span>MEDIARECORDER HD CAMERA &amp; AUDIO RECORDER</span>
        </div>
        <h2 class="text-xl sm:text-2xl font-bold font-mono text-white tracking-tight flex items-center gap-2">
          Browser Video &amp; Audio Recorder
        </h2>
        <p class="text-xs text-zinc-400 mt-1 max-w-2xl leading-relaxed">
          Record HD camera video with microphone audio sync. All recordings are encoded locally in browser memory and can be exported with 1-click download.
        </p>
      </div>

      <!-- Action Button Controls -->
      <div class="flex flex-wrap items-center gap-2.5">
        <select id="rec-device-select" class="px-3 py-2 rounded-xl bg-zinc-950 border border-zinc-800 text-xs font-mono text-zinc-300 focus:outline-none focus:border-rose-500 transition-colors">
          <option value="">Default Camera</option>
        </select>

        <button id="rec-start-btn" class="px-4 py-2 rounded-xl bg-rose-500/20 border border-rose-500/40 text-xs font-mono text-rose-400 font-bold hover:bg-rose-500/30 cursor-pointer transition-all flex items-center gap-1.5 shadow-sm">
          <span class="w-2.5 h-2.5 rounded-full bg-rose-500 animate-ping"></span>
          <span>START RECORDING</span>
        </button>

        <button id="rec-pause-btn" disabled class="px-3.5 py-2 rounded-xl bg-zinc-900 border border-zinc-800 text-xs font-mono text-zinc-500 font-semibold cursor-not-allowed transition-all flex items-center gap-1.5">
          <span>PAUSE</span>
        </button>

        <button id="rec-stop-btn" disabled class="px-3.5 py-2 rounded-xl bg-zinc-900 border border-zinc-800 text-xs font-mono text-zinc-500 font-semibold cursor-not-allowed transition-all flex items-center gap-1.5">
          <span>STOP &amp; SAVE</span>
        </button>
      </div>
    </div>

    <!-- Video Feed Preview Container -->
    <div class="relative z-10 w-full h-80 sm:h-[420px] bg-zinc-950 rounded-2xl border border-zinc-800/90 overflow-hidden shadow-[inset_0_4px_16px_rgba(0,0,0,0.95)] flex items-center justify-center">
      <video id="rec-video-preview" autoplay playsinline muted class="w-full h-full object-cover block"></video>
      <video id="rec-video-playback" controls class="w-full h-full object-contain hidden"></video>

      <!-- Recording Active Badge Overlay -->
      <div id="rec-live-badge" class="hidden absolute top-4 left-4 z-20 items-center gap-2 px-3 py-1.5 rounded-xl bg-rose-500/90 text-white font-mono text-xs font-bold shadow-lg backdrop-blur-md animate-pulse">
        <span class="w-2.5 h-2.5 rounded-full bg-white"></span>
        <span>REC</span>
        <span id="rec-timer-display" class="ml-1 tabular-nums">00:00</span>
      </div>

      <!-- Start Prompt Overlay -->
      <div id="rec-prompt-overlay" class="absolute inset-0 z-10 flex flex-col items-center justify-center p-6 bg-zinc-950/80 backdrop-blur-sm text-center space-y-3">
        <div class="w-14 h-14 rounded-2xl bg-rose-500/10 border border-rose-500/30 flex items-center justify-center text-rose-400">
          <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
        </div>
        <h3 class="text-lg font-bold text-white font-mono">Camera &amp; Audio Ready</h3>
        <p class="text-xs text-zinc-400 max-w-sm">Click "Start Recording" to capture your HD camera video and microphone audio locally.</p>
      </div>
    </div>

    <!-- Recording Telemetry & Download Section -->
    <div class="relative z-10 grid grid-cols-2 sm:grid-cols-4 gap-3 font-mono">
      <div class="bg-zinc-950/80 p-3.5 rounded-xl border border-zinc-800/80 text-center space-y-0.5">
        <div class="text-[10px] text-zinc-400 font-bold uppercase">Duration</div>
        <div id="tele-rec-duration" class="text-xl sm:text-2xl font-extrabold text-rose-400 tabular-nums">00:00</div>
        <div class="text-[9px] text-zinc-400">Recorded Time</div>
      </div>

      <div class="bg-zinc-950/80 p-3.5 rounded-xl border border-zinc-800/80 text-center space-y-0.5">
        <div class="text-[10px] text-zinc-400 font-bold uppercase">File Size</div>
        <div id="tele-rec-size" class="text-xl sm:text-2xl font-extrabold text-cyan-400 tabular-nums">0.0 MB</div>
        <div class="text-[9px] text-zinc-400">Buffer Size</div>
      </div>

      <div class="bg-zinc-950/80 p-3.5 rounded-xl border border-zinc-800/80 text-center space-y-0.5">
        <div class="text-[10px] text-zinc-400 font-bold uppercase">Codec</div>
        <div id="tele-rec-codec" class="text-xl sm:text-2xl font-extrabold text-emerald-400 tabular-nums">VP9 / Opus</div>
        <div class="text-[9px] text-zinc-400">WebM Container</div>
      </div>

      <div class="bg-zinc-950/80 p-3.5 rounded-xl border border-zinc-800/80 text-center space-y-0.5 flex flex-col justify-center items-center">
        <a id="rec-download-link" download="recorded-video.webm" href="#" class="w-full h-full py-2.5 px-3 rounded-lg bg-emerald-500/20 border border-emerald-500/40 text-emerald-400 font-bold text-xs hover:bg-emerald-500/30 transition-all flex items-center justify-center gap-1.5 opacity-50 pointer-events-none">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
          <span>DOWNLOAD VIDEO</span>
        </a>
      </div>
    </div>
  </div>
</div>

<script>
  let mediaStream: MediaStream | null = null;
  let mediaRecorder: MediaRecorder | null = null;
  let recordedChunks: Blob[] = [];

  let isRecording = false;
  let isPaused = false;
  let startTime = 0;
  let timerInterval: number | null = null;

  const videoPreview = document.getElementById('rec-video-preview') as HTMLVideoElement | null;
  const videoPlayback = document.getElementById('rec-video-playback') as HTMLVideoElement | null;

  const startBtn = document.getElementById('rec-start-btn');
  const pauseBtn = document.getElementById('rec-pause-btn') as HTMLButtonElement | null;
  const stopBtn = document.getElementById('rec-stop-btn') as HTMLButtonElement | null;

  const promptOverlay = document.getElementById('rec-prompt-overlay');
  const liveBadge = document.getElementById('rec-live-badge');

  const timerDisplay = document.getElementById('rec-timer-display');
  const teleDuration = document.getElementById('tele-rec-duration');
  const teleSize = document.getElementById('tele-rec-size');
  const teleCodec = document.getElementById('tele-rec-codec');

  const downloadLink = document.getElementById('rec-download-link') as HTMLAnchorElement | null;
  const deviceSelect = document.getElementById('rec-device-select') as HTMLSelectElement | null;

  async function populateDevices() {
    if (!navigator.mediaDevices || !deviceSelect) return;
    try {
      const devices = await navigator.mediaDevices.enumerateDevices();
      const videoInputs = devices.filter(d => d.kind === 'videoinput');
      deviceSelect.innerHTML = videoInputs.map((d, i) => 
        `<option value="${d.deviceId}">${d.label || `Camera ${i + 1}`}</option>`
      ).join('');
    } catch {}
  }

  async function initStream(deviceId?: string) {
    if (mediaStream) {
      mediaStream.getTracks().forEach(t => t.stop());
    }

    try {
      const constraints: MediaStreamConstraints = {
        video: deviceId ? { deviceId: { exact: deviceId }, width: { ideal: 1920 }, height: { ideal: 1080 } } : { width: { ideal: 1920 }, height: { ideal: 1080 } },
        audio: true
      };
      mediaStream = await navigator.mediaDevices.getUserMedia(constraints);
      if (videoPreview) {
        videoPreview.srcObject = mediaStream;
        videoPreview.play();
      }
      populateDevices();
    } catch {
      alert('Camera and microphone permission required for video recording.');
    }
  }

  function formatTime(ms: number): string {
    const totalSec = Math.floor(ms / 1000);
    const mins = Math.floor(totalSec / 60).toString().padStart(2, '0');
    const secs = (totalSec % 60).toString().padStart(2, '0');
    return `${mins}:${secs}`;
  }

  function startRecording() {
    if (!mediaStream) return;
    recordedChunks = [];

    let mimeType = 'video/webm;codecs=vp9,opus';
    if (!MediaRecorder.isTypeSupported(mimeType)) {
      mimeType = 'video/webm';
    }
    if (teleCodec) teleCodec.textContent = mimeType.includes('vp9') ? 'VP9 / Opus' : 'WebM Container';

    try {
      mediaRecorder = new MediaRecorder(mediaStream, { mimeType });

      mediaRecorder.ondataavailable = (e) => {
        if (e.data && e.data.size > 0) {
          recordedChunks.push(e.data);
          const totalBytes = recordedChunks.reduce((acc, c) => acc + c.size, 0);
          if (teleSize) teleSize.textContent = `${(totalBytes / (1024 * 1024)).toFixed(1)} MB`;
        }
      };

      mediaRecorder.onstop = () => {
        const blob = new Blob(recordedChunks, { type: mimeType });
        const videoUrl = URL.createObjectURL(blob);

        if (videoPlayback) {
          videoPlayback.src = videoUrl;
          videoPlayback.classList.remove('hidden');
        }
        if (videoPreview) videoPreview.classList.add('hidden');

        if (downloadLink) {
          downloadLink.href = videoUrl;
          downloadLink.classList.remove('opacity-50', 'pointer-events-none');
        }
      };

      mediaRecorder.start(500); // 500ms chunk interval
      isRecording = true;
      isPaused = false;
      startTime = Date.now();

      if (promptOverlay) promptOverlay.classList.add('hidden');
      if (liveBadge) liveBadge.classList.remove('hidden');

      if (startBtn) startBtn.classList.add('hidden');
      if (pauseBtn) {
        pauseBtn.disabled = false;
        pauseBtn.className = 'px-3.5 py-2 rounded-xl bg-amber-500/20 border border-amber-500/40 text-xs font-mono text-amber-400 font-bold hover:bg-amber-500/30 cursor-pointer transition-all flex items-center gap-1.5';
      }
      if (stopBtn) {
        stopBtn.disabled = false;
        stopBtn.className = 'px-3.5 py-2 rounded-xl bg-rose-500/20 border border-rose-500/40 text-xs font-mono text-rose-400 font-bold hover:bg-rose-500/30 cursor-pointer transition-all flex items-center gap-1.5';
      }

      timerInterval = window.setInterval(() => {
        const elapsed = Date.now() - startTime;
        const timeStr = formatTime(elapsed);
        if (timerDisplay) timerDisplay.textContent = timeStr;
        if (teleDuration) teleDuration.textContent = timeStr;
      }, 500);

    } catch (err) {
      alert('Failed to start MediaRecorder: ' + (err as Error).message);
    }
  }

  function stopRecording() {
    if (mediaRecorder && isRecording) {
      mediaRecorder.stop();
    }
    isRecording = false;
    isPaused = false;

    if (timerInterval) clearInterval(timerInterval);
    if (liveBadge) liveBadge.classList.add('hidden');

    if (startBtn) startBtn.classList.remove('hidden');
    if (pauseBtn) {
      pauseBtn.disabled = true;
      pauseBtn.className = 'px-3.5 py-2 rounded-xl bg-zinc-900 border border-zinc-800 text-xs font-mono text-zinc-500 font-semibold cursor-not-allowed transition-all flex items-center gap-1.5';
    }
    if (stopBtn) {
      stopBtn.disabled = true;
      stopBtn.className = 'px-3.5 py-2 rounded-xl bg-zinc-900 border border-zinc-800 text-xs font-mono text-zinc-500 font-semibold cursor-not-allowed transition-all flex items-center gap-1.5';
    }
  }

  startBtn?.addEventListener('click', () => {
    if (!mediaStream) {
      initStream().then(() => startRecording());
    } else {
      startRecording();
    }
  });

  pauseBtn?.addEventListener('click', () => {
    if (!mediaRecorder) return;
    if (isPaused) {
      mediaRecorder.resume();
      isPaused = false;
      if (pauseBtn) pauseBtn.textContent = 'PAUSE';
    } else {
      mediaRecorder.pause();
      isPaused = true;
      if (pauseBtn) pauseBtn.textContent = 'RESUME';
    }
  });

  stopBtn?.addEventListener('click', stopRecording);

  deviceSelect?.addEventListener('change', (e) => {
    const deviceId = (e.target as HTMLSelectElement).value;
    initStream(deviceId);
  });

  // Initial Camera setup
  initStream();
</script>
