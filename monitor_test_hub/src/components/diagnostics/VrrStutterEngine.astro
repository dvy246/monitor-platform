---
// VrrStutterEngine.astro component
---
<div class="max-w-4xl mx-auto px-4 py-8 font-mono">
  <div class="bg-bg-surface border border-border-hairline rounded-xl p-6 shadow-specular-top">
    <h3 class="text-xl font-bold heading-brand text-status-pass mb-2 font-mono">VRR (G-Sync / FreeSync) Stutter &amp; Tearing Engine</h3>
    <p class="text-text-secondary text-sm mb-6 font-sans leading-relaxed">
      Check your display's Variable Refresh Rate synchronization. The vertical sweep bars oscillate speed dynamically across frame intervals. Any stuttering, tearing, or overdrive overshoot reveals synchronization failures.
    </p>

    <!-- Controls -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
      <div class="bg-bg-elevated p-4 rounded-lg border border-border-hairline">
        <span class="text-text-muted text-xs block mb-1">FPS Telemetry</span>
        <span id="vrr-fps" class="text-xl font-bold text-text-primary font-mono">0.0 Hz</span>
      </div>
      <div class="bg-bg-elevated p-4 rounded-lg border border-border-hairline">
        <span class="text-text-muted text-xs block mb-1">Frame Interval</span>
        <span id="vrr-delta" class="text-xl font-bold text-text-primary font-mono">0.00 ms</span>
      </div>
      <div class="bg-bg-elevated p-4 rounded-lg border border-border-hairline">
        <span class="text-text-muted text-xs block mb-1">Sync Loss Counts</span>
        <span id="vrr-syncloss" class="text-xl font-bold text-status-fail font-mono">0</span>
      </div>
      <div class="bg-bg-elevated p-4 rounded-lg border border-border-hairline flex items-center justify-between">
        <button id="vrr-toggle" class="bg-status-pass hover:opacity-90 text-text-on-accent px-4 py-2.5 rounded-lg w-full font-extrabold text-sm transition-all shadow-[0_0_15px_rgba(16,185,129,0.3)] cursor-pointer">
          Start Engine
        </button>
      </div>
    </div>

    <!-- Active Canvas -->
    <div class="relative w-full aspect-video md:aspect-[2/1] rounded-lg overflow-hidden bg-black border border-border-hairline">
      <canvas id="vrr-canvas" class="w-full h-full block"></canvas>
    </div>
  </div>
</div>

<script>
  import { VsyncSyncEngine } from '../../engine/VsyncSyncEngine';

  const canvas = document.getElementById('vrr-canvas') as HTMLCanvasElement;
  const btnToggle = document.getElementById('vrr-toggle');
  const fpsText = document.getElementById('vrr-fps');
  const deltaText = document.getElementById('vrr-delta');
  const syncLossText = document.getElementById('vrr-syncloss');

  let engine: VsyncSyncEngine | null = null;
  let isRunning = false;
  let ctx: CanvasRenderingContext2D | null = null;
  
  let barX = 0;
  let barDirection = 1;
  const baseSpeed = 480; // px/sec

  function initVrrEngine() {
    if (!canvas || !btnToggle) return;
    ctx = canvas.getContext('2d', { desynchronized: true });

    // Handle resizing
    const resizeCanvas = () => {
      const rect = canvas.parentElement?.getBoundingClientRect();
      canvas.width = (rect?.width || 800) * (window.devicePixelRatio || 1);
      canvas.height = (rect?.height || 400) * (window.devicePixelRatio || 1);
    };
    window.addEventListener('resize', resizeCanvas);
    resizeCanvas();

    btnToggle.addEventListener('click', () => {
      if (isRunning) {
        stopVrr();
      } else {
        startVrr();
      }
    });
  }

  function startVrr() {
    if (!canvas || !ctx || !fpsText || !deltaText || !syncLossText || !btnToggle) return;
    isRunning = true;
    btnToggle.textContent = 'Stop Engine';
    btnToggle.classList.replace('bg-diagnostic-matrixGreen', 'bg-diagnostic-deadRed');
    btnToggle.classList.replace('text-black', 'text-white');

    engine = new VsyncSyncEngine((stats) => {
      fpsText.textContent = `${stats.currentFps} Hz`;
      deltaText.textContent = `${stats.frameDeltaMs} ms`;
      syncLossText.textContent = `${stats.syncLossCount}`;

      // Perform drawing updates synced with display refresh rate
      drawFrame(stats.frameDeltaMs / 1000);
    });

    engine.start();
  }

  function stopVrr() {
    if (!btnToggle) return;
    isRunning = false;
    btnToggle.textContent = 'Start Engine';
    btnToggle.classList.replace('bg-diagnostic-deadRed', 'bg-diagnostic-matrixGreen');
    btnToggle.classList.replace('text-white', 'text-black');

    engine?.stop();
    engine = null;

    // Clear canvas
    if (ctx && canvas) {
      ctx.fillStyle = '#000000';
      ctx.fillRect(0, 0, canvas.width, canvas.height);
    }
  }

  function drawFrame(deltaTime: number) {
    if (!ctx || !canvas) return;
    const w = canvas.width;
    const h = canvas.height;

    // Redraw background
    ctx.fillStyle = '#050608';
    ctx.fillRect(0, 0, w, h);

    // Oscillation mathematics: dynamically modulate bar displacement speed
    const currentSpeed = baseSpeed * (1 + Math.sin(performance.now() / 2000) * 0.5); // modulate speed between 0.5x and 1.5x
    const step = currentSpeed * deltaTime * (window.devicePixelRatio || 1);

    barX += step * barDirection;

    if (barX >= w - 40) {
      barX = w - 40;
      barDirection = -1;
    } else if (barX <= 0) {
      barX = 0;
      barDirection = 1;
    }

    // Draw sweep bar (Green with slight trailing glow)
    ctx.fillStyle = '#00ff88';
    ctx.fillRect(barX, 0, 15, h);

    // Draw horizontal reference lines to test for screen tearing
    ctx.fillStyle = '#1a1d24';
    for (let i = 1; i < 4; i++) {
      ctx.fillRect(0, (h / 4) * i - 1, w, 2);
    }
  }

  initVrrEngine();
</script>
