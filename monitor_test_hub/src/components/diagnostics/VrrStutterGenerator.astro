---
import {
  getAllGpuVendors,
  getAllRefreshRates,
  getGpuVendorLabel,
  getRefreshRateLabel,
  type GpuVendor,
  type RefreshRate,
  type SweepMode
} from '../../engine/VrrSweepEngine';

export interface Props {
  initialVendor?: GpuVendor;
  initialRate?: RefreshRate;
}

const { initialVendor = 'nvidia-geforce', initialRate = '144hz' } = Astro.props;

const allVendors = getAllGpuVendors();
const allRates = getAllRefreshRates();
---

<div class="w-full max-w-5xl mx-auto space-y-6 font-mono select-none" role="region" aria-label="VRR Stutter and Tear Generator Diagnostic Engine">
  <!-- Interactive Control & Configuration Deck -->
  <div class="bg-bg-surface border border-border-hairline rounded-xl p-4 sm:p-6 shadow-specular-top space-y-4">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-border-hairline pb-4">
      <div>
        <h2 class="text-lg font-bold text-text-primary uppercase tracking-wider flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-status-pass led-glow-pass"></span>
          VRR / G-Sync / FreeSync Pacing Generator
        </h2>
        <p class="text-xs text-text-secondary font-sans mt-1">
          Simulate VESA VRR frame pacing, Low Frame Rate Compensation (LFC), tear lines, and micro-stutter variance across 48Hz-540Hz displays.
        </p>
      </div>

      <!-- Main Engine Action Buttons -->
      <div class="flex items-center gap-2 shrink-0">
        <button
          id="vrr-btn-start"
          type="button"
          class="px-4 py-2 rounded-lg bg-status-pass text-text-on-accent font-bold text-xs hover:opacity-90 transition-opacity focus:outline-none focus:ring-2 focus:ring-status-pass cursor-pointer shadow-specular-top"
          aria-label="Start or pause VRR simulation engine"
        >
          START ENGINE
        </button>
        <button
          id="vrr-btn-reset"
          type="button"
          class="px-3 py-2 rounded-lg bg-bg-canvas border border-border-hairline text-text-secondary font-bold text-xs hover:text-text-primary hover:border-border-subtle transition-colors focus:outline-none focus:ring-2 focus:ring-status-pass cursor-pointer"
          aria-label="Reset telemetry and frame drop counter"
        >
          RESET
        </button>
      </div>
    </div>

    <!-- Parameter Selectors Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      <!-- GPU Vendor Selector -->
      <div class="space-y-1.5">
        <label for="vrr-select-vendor" class="text-[11px] font-bold text-text-muted uppercase tracking-wider block">
          GPU Vendor Preset
        </label>
        <select
          id="vrr-select-vendor"
          class="w-full bg-bg-canvas border border-border-hairline rounded-lg px-3 py-2 text-xs font-mono text-text-primary focus:outline-none focus:ring-2 focus:ring-status-pass cursor-pointer"
          aria-label="Select GPU Vendor Preset"
        >
          {allVendors.map((vendor) => (
            <option value={vendor} selected={vendor === initialVendor}>
              {getGpuVendorLabel(vendor)}
            </option>
          ))}
        </select>
      </div>

      <!-- Max Refresh Rate Selector -->
      <div class="space-y-1.5">
        <label for="vrr-select-rate" class="text-[11px] font-bold text-text-muted uppercase tracking-wider block">
          Target Max Refresh Rate
        </label>
        <select
          id="vrr-select-rate"
          class="w-full bg-bg-canvas border border-border-hairline rounded-lg px-3 py-2 text-xs font-mono text-text-primary focus:outline-none focus:ring-2 focus:ring-status-pass cursor-pointer"
          aria-label="Select Max Target Refresh Rate"
        >
          {allRates.map((rate) => (
            <option value={rate} selected={rate === initialRate}>
              {getRefreshRateLabel(rate)} Target
            </option>
          ))}
        </select>
      </div>

      <!-- Sweep Pattern Selector -->
      <div class="space-y-1.5">
        <label for="vrr-select-mode" class="text-[11px] font-bold text-text-muted uppercase tracking-wider block">
          FPS Sweep Pattern Mode
        </label>
        <select
          id="vrr-select-mode"
          class="w-full bg-bg-canvas border border-border-hairline rounded-lg px-3 py-2 text-xs font-mono text-text-primary focus:outline-none focus:ring-2 focus:ring-status-pass cursor-pointer"
          aria-label="Select FPS Sweep Pattern Mode"
        >
          <option value="sine">Sine Wave Oscillation (Smooth VRR)</option>
          <option value="ramp">Linear Ramp (Low-to-High Sweep)</option>
          <option value="stress">Stress Jitter & LFC Drop Test</option>
        </select>
      </div>
    </div>
  </div>

  <!-- Telemetry & Status Badges Deck (Fixed Min Height for Zero CLS) -->
  <div class="min-h-[108px] bg-bg-surface border border-border-hairline rounded-xl p-4 shadow-specular-top space-y-3">
    <div class="flex flex-wrap items-center justify-between gap-3 border-b border-border-hairline pb-2">
      <!-- Sync Status & LFC Alert Badge -->
      <div class="flex items-center gap-2">
        <span class="text-[10px] text-text-muted font-bold uppercase tracking-wider">SYNC STATE:</span>
        <div id="vrr-status-badge" role="status" aria-live="polite" class="px-2.5 py-1 rounded text-[11px] font-bold uppercase tracking-wider bg-status-pass/20 border border-status-pass text-status-pass">
          NATIVE VRR RANGE
        </div>
      </div>

      <!-- Hardware Window Info -->
      <div class="text-[11px] text-text-secondary flex items-center gap-3">
        <span>Hardware Window: <strong id="vrr-hw-window" class="text-text-primary">48 Hz – 144 Hz</strong></span>
      </div>
    </div>

    <!-- Live Telemetry Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs">
      <div class="bg-bg-canvas border border-border-hairline rounded-lg p-2.5">
        <span class="text-[10px] text-text-muted block uppercase font-bold">Simulated FPS</span>
        <span id="vrr-telemetry-fps" class="text-base font-extrabold text-status-pass font-mono block">120.0 FPS</span>
      </div>

      <div class="bg-bg-canvas border border-border-hairline rounded-lg p-2.5">
        <span class="text-[10px] text-text-muted block uppercase font-bold">Display Refresh</span>
        <span id="vrr-telemetry-hz" class="text-base font-extrabold text-text-primary font-mono block">120.0 Hz</span>
      </div>

      <div class="bg-bg-canvas border border-border-hairline rounded-lg p-2.5">
        <span class="text-[10px] text-text-muted block uppercase font-bold">Frame Drops</span>
        <span id="vrr-telemetry-drops" class="text-base font-extrabold text-status-fail font-mono block">0</span>
      </div>

      <div class="bg-bg-canvas border border-border-hairline rounded-lg p-2.5">
        <span class="text-[10px] text-text-muted block uppercase font-bold">Stutter Variance</span>
        <span id="vrr-telemetry-stutter" class="text-base font-extrabold text-status-warn font-mono block">0.00 ms²</span>
      </div>
    </div>
  </div>

  <!-- Diagnostic Canvas Container (Fixed Min Height 400px to guarantee CLS = 0.000) -->
  <div class="min-h-[400px] w-full rounded-xl border border-border-hairline bg-[#08080a] relative overflow-hidden shadow-2xl flex flex-col items-center justify-center">
    <canvas id="vrr-generator-canvas" class="w-full h-[400px] block" aria-label="VRR vertical sweep visual pattern display canvas"></canvas>
    
    <!-- Visual Overlay Guidance Text -->
    <div class="absolute bottom-3 left-4 right-4 flex items-center justify-between text-[11px] font-mono text-text-muted bg-bg-canvas/80 backdrop-blur-xs px-3 py-1.5 rounded border border-border-hairline pointer-events-none">
      <span>SWEEP VELOCITY: Dynamic Modulated</span>
      <span id="vrr-overlay-lfc-info">LFC INACTIVE (1x presentation)</span>
      <span>TEAR INDICATOR: <strong id="vrr-overlay-tear-info" class="text-status-pass">SYNCHRONIZED</strong></span>
    </div>
  </div>
</div>

<script>
  import {
    calculateVrrMetrics,
    calculateStutterVariance,
    getSweepFps,
    getRefreshRateHz,
    getGpuVendorLabel,
    getRefreshRateLabel,
    sanitizeGpuVendor,
    sanitizeRefreshRate,
    type GpuVendor,
    type RefreshRate,
    type SweepMode
  } from '../../engine/VrrSweepEngine';

  const canvas = document.getElementById('vrr-generator-canvas') as HTMLCanvasElement | null;
  const btnStart = document.getElementById('vrr-btn-start');
  const btnReset = document.getElementById('vrr-btn-reset');
  const selectVendor = document.getElementById('vrr-select-vendor') as HTMLSelectElement | null;
  const selectRate = document.getElementById('vrr-select-rate') as HTMLSelectElement | null;
  const selectMode = document.getElementById('vrr-select-mode') as HTMLSelectElement | null;

  const badgeStatus = document.getElementById('vrr-status-badge');
  const textHwWindow = document.getElementById('vrr-hw-window');
  const textFps = document.getElementById('vrr-telemetry-fps');
  const textHz = document.getElementById('vrr-telemetry-hz');
  const textDrops = document.getElementById('vrr-telemetry-drops');
  const textStutter = document.getElementById('vrr-telemetry-stutter');
  const overlayLfc = document.getElementById('vrr-overlay-lfc-info');
  const overlayTear = document.getElementById('vrr-overlay-tear-info');

  let animationFrameId: number | null = null;
  let isRunning = false;
  let startTime = 0;
  let lastTimestamp = 0;

  let currentVendor: GpuVendor = sanitizeGpuVendor(selectVendor?.value || 'nvidia-geforce');
  let currentRateKey: RefreshRate = sanitizeRefreshRate(selectRate?.value || '144hz');
  let currentMaxHz = getRefreshRateHz(currentRateKey);
  let currentMode: SweepMode = (selectMode?.value as SweepMode) || 'sine';

  const minVrrHz = 48;
  let barX = 0;
  let barDirection = 1;

  let frameTimesBuffer: number[] = [];
  let cumulativeDrops = 0;

  function updateHwWindowUI() {
    if (textHwWindow) {
      textHwWindow.textContent = `${minVrrHz} Hz – ${currentMaxHz} Hz (${currentVendor.toUpperCase()})`;
    }
  }

  function resizeCanvas() {
    if (!canvas) return;
    const rect = canvas.parentElement?.getBoundingClientRect();
    const width = rect?.width || 800;
    const height = 400;
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    
    canvas.width = Math.floor(width * dpr);
    canvas.height = Math.floor(height * dpr);
    canvas.style.width = `${width}px`;
    canvas.style.height = `${height}px`;
  }

  function resetTelemetry() {
    frameTimesBuffer = [];
    cumulativeDrops = 0;
    if (textDrops) textDrops.textContent = '0';
    if (textStutter) textStutter.textContent = '0.00 ms²';
  }

  function startEngine() {
    if (isRunning) return;
    isRunning = true;
    if (btnStart) {
      btnStart.textContent = 'PAUSE ENGINE';
      btnStart.classList.replace('bg-status-pass', 'bg-status-warn');
    }
    lastTimestamp = performance.now();
    if (startTime === 0) startTime = lastTimestamp;
    animationFrameId = requestAnimationFrame(loop);
  }

  function pauseEngine() {
    isRunning = false;
    if (btnStart) {
      btnStart.textContent = 'START ENGINE';
      btnStart.classList.replace('bg-status-warn', 'bg-status-pass');
    }
    if (animationFrameId !== null) {
      cancelAnimationFrame(animationFrameId);
      animationFrameId = null;
    }
  }

  function loop(timestamp: number) {
    if (!isRunning || !canvas) return;

    const deltaMs = timestamp - lastTimestamp;
    lastTimestamp = timestamp;

    const elapsedTimeSec = (timestamp - startTime) / 1000;

    // 1. Calculate target FPS from pure math engine
    const targetFps = getSweepFps(currentMode, elapsedTimeSec, currentMaxHz, 20);

    // 2. Calculate full VRR metrics snapshot
    const metrics = calculateVrrMetrics(targetFps, currentMaxHz, minVrrHz, currentVendor);

    // 3. Track frame time buffer and calculate micro-stutter variance
    if (deltaMs > 0 && deltaMs < 200) {
      frameTimesBuffer.push(deltaMs);
      if (frameTimesBuffer.length > 60) {
        frameTimesBuffer.shift();
      }
    }
    const expectedFrameTimeMs = 1000 / Math.max(targetFps, 1);
    const stutterMetrics = calculateStutterVariance(frameTimesBuffer, expectedFrameTimeMs);
    cumulativeDrops += stutterMetrics.frameDropCount > 0 ? 1 : 0;

    // 4. Update UI Telemetry
    if (textFps) textFps.textContent = `${metrics.targetFps.toFixed(1)} FPS`;
    if (textHz) textHz.textContent = `${metrics.displayRefreshHz.toFixed(1)} Hz`;
    if (textDrops) textDrops.textContent = `${cumulativeDrops}`;
    if (textStutter) textStutter.textContent = `${stutterMetrics.variance.toFixed(2)} ms²`;

    // 5. Update Status Badges & Alerts
    if (badgeStatus) {
      if (metrics.syncMode === 'TEARING_DESYNC') {
        badgeStatus.textContent = 'TEARING DESYNC — FPS > MAX HZ';
        badgeStatus.className = 'px-2.5 py-1 rounded text-[11px] font-bold uppercase tracking-wider bg-status-fail/20 border border-status-fail text-status-fail';
      } else if (metrics.syncMode === 'LFC_ACTIVE') {
        badgeStatus.textContent = `LFC ACTIVE — Frame Doubled (${metrics.lfc.multiplier}x)`;
        badgeStatus.className = 'px-2.5 py-1 rounded text-[11px] font-bold uppercase tracking-wider bg-status-warn/20 border border-status-warn text-status-warn';
      } else {
        badgeStatus.textContent = 'NATIVE VRR RANGE';
        badgeStatus.className = 'px-2.5 py-1 rounded text-[11px] font-bold uppercase tracking-wider bg-status-pass/20 border border-status-pass text-status-pass';
      }
    }

    if (overlayLfc) {
      overlayLfc.textContent = metrics.lfc.isLfcActive
        ? `LFC ACTIVE (${metrics.lfc.multiplier}x multiplier -> ${metrics.effectiveFps.toFixed(1)} Hz output)`
        : `LFC INACTIVE (Native presentation)`;
    }

    if (overlayTear) {
      if (metrics.isTearing) {
        overlayTear.textContent = 'DESYNC TEAR LINE ACTIVE';
        overlayTear.className = 'text-status-fail font-bold animate-pulse';
      } else {
        overlayTear.textContent = 'SYNCHRONIZED';
        overlayTear.className = 'text-status-pass font-bold';
      }
    }

    // 6. Draw Canvas Frame
    renderCanvasFrame(canvas, metrics, deltaMs / 1000);

    animationFrameId = requestAnimationFrame(loop);
  }

  function renderCanvasFrame(cvs: HTMLCanvasElement, metrics: ReturnType<typeof calculateVrrMetrics>, deltaSec: number) {
    const ctx = cvs.getContext('2d');
    if (!ctx) return;

    const w = cvs.width;
    const h = cvs.height;

    // Check dark vs light theme mode
    const isLightMode = document.documentElement.classList.contains('light');
    ctx.fillStyle = isLightMode ? '#f8fafc' : '#08080a';
    ctx.fillRect(0, 0, w, h);

    // Draw reference grid lines
    ctx.strokeStyle = isLightMode ? '#e2e8f0' : '#1e293b';
    ctx.lineWidth = 1;
    for (let y = 50; y < h; y += 50) {
      ctx.beginPath();
      ctx.moveTo(0, y);
      ctx.lineTo(w, y);
      ctx.stroke();
    }

    // Advance sweep bar displacement based on effective FPS
    const baseSpeed = w * 0.4; // 40% canvas width per sec
    const speedFactor = metrics.effectiveFps / currentMaxHz;
    const step = baseSpeed * Math.max(speedFactor, 0.2) * deltaSec;

    barX += step * barDirection;
    if (barX >= w - 24) {
      barX = w - 24;
      barDirection = -1;
    } else if (barX <= 0) {
      barX = 0;
      barDirection = 1;
    }

    // Draw main moving vertical sweep line
    const barWidth = Math.max(16, Math.floor(w * 0.02));
    const mainColor = metrics.isTearing ? '#ef4444' : metrics.lfc.isLfcActive ? '#f59e0b' : '#10b981';
    
    ctx.fillStyle = mainColor;

    if (metrics.isTearing) {
      // Draw torn sweep line with horizontal offset shifts simulating tearing desync
      const tearHeight = h / 3;
      ctx.fillRect(barX, 0, barWidth, tearHeight);
      ctx.fillRect(barX + 28, tearHeight, barWidth, tearHeight); // tear offset
      ctx.fillRect(barX - 14, tearHeight * 2, barWidth, tearHeight); // second tear offset

      // Draw red tear line indicators across canvas
      ctx.fillStyle = '#ef4444';
      ctx.fillRect(0, tearHeight - 2, w, 4);
      ctx.fillRect(0, tearHeight * 2 - 2, w, 4);
    } else {
      ctx.fillRect(barX, 0, barWidth, h);

      // If LFC is active, draw secondary ghost sweep bar representing frame doubled presentation
      if (metrics.lfc.isLfcActive) {
        ctx.fillStyle = 'rgba(245, 158, 11, 0.35)'; // semi-transparent amber
        const ghostOffset = Math.floor(w * 0.15);
        const ghostX = (barX + ghostOffset) % w;
        ctx.fillRect(ghostX, 0, barWidth, h);
      }
    }
  }

  // Event Listeners Initialization
  if (btnStart) {
    btnStart.addEventListener('click', () => {
      if (isRunning) {
        pauseEngine();
      } else {
        startEngine();
      }
    });
  }

  if (btnReset) {
    btnReset.addEventListener('click', () => {
      resetTelemetry();
    });
  }

  if (selectVendor) {
    selectVendor.addEventListener('change', () => {
      currentVendor = sanitizeGpuVendor(selectVendor.value);
      updateHwWindowUI();
    });
  }

  if (selectRate) {
    selectRate.addEventListener('change', () => {
      currentRateKey = sanitizeRefreshRate(selectRate.value);
      currentMaxHz = getRefreshRateHz(currentRateKey);
      updateHwWindowUI();
    });
  }

  if (selectMode) {
    selectMode.addEventListener('change', () => {
      currentMode = (selectMode.value as SweepMode) || 'sine';
    });
  }

  window.addEventListener('resize', resizeCanvas);
  window.addEventListener('themechange', () => {
    if (!isRunning && canvas) {
      const cvs = canvas;
      const ctx = cvs.getContext('2d');
      if (ctx) {
        const isLight = document.documentElement.classList.contains('light');
        ctx.fillStyle = isLight ? '#f8fafc' : '#08080a';
        ctx.fillRect(0, 0, cvs.width, cvs.height);
      }
    }
  });

  // Initial setup
  resizeCanvas();
  updateHwWindowUI();
  startEngine(); // Autostart diagnostic for instant visual feedback
</script>
