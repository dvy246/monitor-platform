---
import { useTranslations } from '../../utils/i18n';
const { t } = useTranslations(Astro.url.pathname);
---

<div class="w-full max-w-4xl mx-auto space-y-6 font-sans">
  <!-- Hardware Control Deck Container -->
  <div class="relative overflow-hidden rounded-2xl bg-bg-surface border border-border-hairline p-6 sm:p-8 shadow-specular-top">
    <!-- Glowing background accent -->
    <div class="absolute -top-32 -right-32 w-80 h-80 bg-status-pass/10 blur-3xl rounded-full pointer-events-none z-0"></div>
    <div class="absolute -bottom-32 -left-32 w-80 h-80 bg-status-info/10 blur-3xl rounded-full pointer-events-none z-0"></div>

    <div class="relative z-10 space-y-8">
      
      <!-- Top Diagnostic Mode & Preset Selector Header -->
      <div class="flex flex-wrap items-center justify-between gap-4 border-b border-border-hairline/80 pb-5">
        <div>
          <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-md bg-status-pass/10 border border-status-pass/30 font-mono text-[10px] text-status-pass font-bold uppercase tracking-widest mb-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-status-pass animate-pulse"></span>
            Acoustic Ejection Engine v2.4
          </div>
          <h2 class="text-xl sm:text-2xl font-bold font-mono text-text-primary tracking-tight">
            Speaker Water &amp; Dust Ejector
          </h2>
        </div>

        <div class="flex items-center gap-2 font-mono text-xs">
          <span class="text-text-muted text-[11px]">Channel:</span>
          <div class="inline-flex p-1 bg-bg-canvas border border-border-hairline rounded-lg" id="channel-target-group">
            <button data-target="all" class="px-3 py-1.5 rounded-md text-text-primary bg-bg-elevated font-bold transition-all shadow-sm">All</button>
            <button data-target="left" class="px-3 py-1.5 rounded-md text-text-secondary hover:text-text-primary transition-all">Left</button>
            <button data-target="right" class="px-3 py-1.5 rounded-md text-text-secondary hover:text-text-primary transition-all">Right</button>
          </div>
        </div>
      </div>

      <!-- Real-Time Waveform & Particle Canvas -->
      <div class="relative h-44 sm:h-56 bg-bg-canvas border border-border-hairline rounded-xl overflow-hidden flex flex-col justify-between p-4 shadow-inner">
        <canvas id="ejector-visualizer" class="absolute inset-0 w-full h-full z-0 opacity-80 pointer-events-none"></canvas>

        <div class="relative z-10 flex items-center justify-between font-mono text-xs">
          <div class="flex items-center gap-2 text-text-secondary">
            <span class="w-2 h-2 rounded-full bg-border-interactive" id="status-led"></span>
            <span id="status-text" class="text-[11px] uppercase tracking-wider font-semibold">Ready for Ejection</span>
          </div>
          <div class="text-right">
            <span class="text-[10px] text-text-muted block">Output Frequency</span>
            <span id="freq-readout" class="text-xl font-bold font-mono-tech text-status-pass tabular-nums">165 Hz</span>
          </div>
        </div>

        <div class="relative z-10 flex items-center justify-between font-mono text-[11px] text-text-muted">
          <span id="mode-badge" class="px-2 py-0.5 rounded bg-bg-surface/80 border border-border-hairline">Mode: Water Eject Sweep</span>
          <span class="hidden sm:inline">Vibration Haptics: <strong id="haptic-status" class="text-status-pass">Active</strong></span>
        </div>
      </div>

      <!-- Main Action Hub: EJECT & Mode Controls -->
      <div class="grid grid-cols-1 md:grid-cols-12 gap-6 items-center">
        <!-- Big Eject Button -->
        <div class="md:col-span-6 flex flex-col items-center justify-center space-y-3 text-center">
          <button 
            id="btn-eject-toggle"
            class="w-full sm:w-72 h-16 sm:h-20 rounded-2xl bg-status-pass hover:bg-emerald-400 text-bg-canvas font-mono font-extrabold text-lg sm:text-xl tracking-wider uppercase transition-all duration-200 shadow-[0_0_30px_rgba(5,150,105,0.4)] active:scale-95 flex items-center justify-center gap-3 group cursor-pointer"
          >
            <svg class="w-7 h-7 transition-transform group-hover:scale-110" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 13.5L12 21m0 0l-7.5-7.5M12 21V3" />
            </svg>
            <span id="btn-label">START WATER EJECT</span>
          </button>
          <p class="text-xs text-text-muted max-w-xs leading-normal">
            Turn device volume up to <strong>100%</strong> and face screen downward for maximum momentum.
          </p>
        </div>

        <!-- Mode Presets Grid -->
        <div class="md:col-span-6 space-y-2 font-mono text-xs">
          <div class="text-[10px] text-text-muted uppercase tracking-wider font-bold mb-1">Select Diagnostic Sound Mode</div>

          <button data-mode="water-sweep" class="mode-btn w-full p-3 rounded-xl border border-status-pass/50 bg-status-pass/10 text-text-primary text-left flex items-center justify-between hover:border-status-pass transition-all">
            <div>
              <div class="font-bold text-xs">1. Water Removal Sweep</div>
              <div class="text-[10px] text-text-muted font-sans">150Hz – 175Hz continuous acoustic wave</div>
            </div>
            <span class="text-[10px] font-bold text-status-pass bg-status-pass/20 px-2 py-0.5 rounded">Standard</span>
          </button>

          <button data-mode="dust-blower" class="mode-btn w-full p-3 rounded-xl border border-border-hairline bg-bg-canvas text-text-secondary text-left flex items-center justify-between hover:border-border-interactive transition-all">
            <div>
              <div class="font-bold text-xs">2. Dust Blower Wave</div>
              <div class="text-[10px] text-text-muted font-sans">High-energy sawtooth harmonic air impulse</div>
            </div>
            <span class="text-[10px] text-text-muted bg-bg-elevated px-2 py-0.5 rounded">Dust</span>
          </button>

          <button data-mode="crackle-test" class="mode-btn w-full p-3 rounded-xl border border-border-hairline bg-bg-canvas text-text-secondary text-left flex items-center justify-between hover:border-border-interactive transition-all">
            <div>
              <div class="font-bold text-xs">3. Crackling &amp; Distortion Check</div>
              <div class="text-[10px] text-text-muted font-sans">Triangle tone sweep to isolate mechanical buzz</div>
            </div>
            <span class="text-[10px] text-text-muted bg-bg-elevated px-2 py-0.5 rounded">Check</span>
          </button>
        </div>
      </div>

    </div>
  </div>

  <!-- Phone Speaker Doctor: Guided 4-Step Verification Matrix -->
  <div class="border border-border-hairline rounded-2xl bg-bg-surface p-6 sm:p-8 space-y-5 shadow-specular-top">
    <div class="flex items-center justify-between border-b border-border-hairline pb-4">
      <div>
        <h3 class="text-base sm:text-lg font-bold font-mono text-text-primary">
          Phone Speaker Doctor: Guided Repair Flow
        </h3>
        <p class="text-xs text-text-muted">Follow this 4-step diagnostic protocol to verify speaker health.</p>
      </div>
      <span class="hidden sm:inline-block px-3 py-1 rounded-full text-[10px] font-mono font-bold bg-bg-canvas border border-border-hairline text-text-secondary">
        Step-by-Step Diagnostic
      </span>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 text-xs font-sans">
      <div class="p-4 rounded-xl bg-bg-canvas border border-border-hairline space-y-2">
        <div class="flex items-center justify-between">
          <span class="font-mono text-status-pass font-bold text-sm">Step 01</span>
          <span class="w-2 h-2 rounded-full bg-status-pass"></span>
        </div>
        <div class="font-bold text-text-primary">Run Water Ejection</div>
        <p class="text-[11px] text-text-muted leading-relaxed">
          Play the 150-175Hz sweep for 60 seconds with device volume set to 100%.
        </p>
      </div>

      <div class="p-4 rounded-xl bg-bg-canvas border border-border-hairline space-y-2">
        <div class="flex items-center justify-between">
          <span class="font-mono text-cyan-400 font-bold text-sm">Step 02</span>
          <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
        </div>
        <div class="font-bold text-text-primary">Left &amp; Right Balance</div>
        <p class="text-[11px] text-text-muted leading-relaxed">
          Switch channel target to "Left" and "Right" to confirm both top &amp; bottom speakers fire.
        </p>
      </div>

      <div class="p-4 rounded-xl bg-bg-canvas border border-border-hairline space-y-2">
        <div class="flex items-center justify-between">
          <span class="font-mono text-amber-400 font-bold text-sm">Step 03</span>
          <span class="w-2 h-2 rounded-full bg-amber-400"></span>
        </div>
        <div class="font-bold text-text-primary">Crackle &amp; Buzz Check</div>
        <p class="text-[11px] text-text-muted leading-relaxed">
          Run Mode 3 to verify if speaker cone has physical mechanical distortion.
        </p>
      </div>

      <div class="p-4 rounded-xl bg-bg-canvas border border-border-hairline space-y-2">
        <div class="flex items-center justify-between">
          <span class="font-mono text-purple-400 font-bold text-sm">Step 04</span>
          <span class="w-2 h-2 rounded-full bg-purple-400"></span>
        </div>
        <div class="font-bold text-text-primary">Microphone Audit</div>
        <p class="text-[11px] text-text-muted leading-relaxed">
          Visit our <a href="/sound-test/microphone-test" class="text-purple-400 underline font-semibold">Mic Test</a> to confirm water didn't enter microphone port.
        </p>
      </div>
    </div>
  </div>
</div>

<script>
  import { AudioDiagnosticEngine, DiagnosticMode, EjectTarget } from '../../engine/AudioDiagnosticEngine';

  function initWaterEjector() {
    const btnToggle = document.getElementById('btn-eject-toggle');
    const btnLabel = document.getElementById('btn-label');
    const freqReadout = document.getElementById('freq-readout');
    const statusText = document.getElementById('status-text');
    const statusLed = document.getElementById('status-led');
    const modeBadge = document.getElementById('mode-badge');
    const canvas = document.getElementById('ejector-visualizer') as HTMLCanvasElement;
    const ctx = canvas ? canvas.getContext('2d') : null;

    if (!btnToggle || !btnLabel || !freqReadout) return;

    let currentMode: DiagnosticMode = 'water-sweep';
    let currentTarget: EjectTarget = 'all';

    const engine = new AudioDiagnosticEngine(
      (freq) => {
        if (freqReadout) freqReadout.textContent = `${freq} Hz`;
      },
      (data) => {
        if (ctx && canvas) {
          ctx.clearRect(0, 0, canvas.width, canvas.height);
          const barW = canvas.width / data.length;
          for (let i = 0; i < data.length; i++) {
            const h = (data[i] / 255) * canvas.height;
            ctx.fillStyle = i % 2 === 0 ? 'rgba(5, 150, 105, 0.4)' : 'rgba(6, 182, 212, 0.4)';
            ctx.fillRect(i * barW, canvas.height - h, barW - 2, h);
          }
        }
      }
    );

    // Resize canvas correctly
    function resizeCanvas() {
      if (canvas) {
        canvas.width = canvas.offsetWidth;
        canvas.height = canvas.offsetHeight;
      }
    }
    resizeCanvas();
    window.addEventListener('resize', resizeCanvas);

    // Mode Selector Buttons
    document.querySelectorAll('.mode-btn').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const targetBtn = e.currentTarget as HTMLElement;
        const mode = targetBtn.getAttribute('data-mode') as DiagnosticMode;
        if (!mode) return;

        currentMode = mode;
        document.querySelectorAll('.mode-btn').forEach((b) => {
          b.classList.remove('border-status-pass/50', 'bg-status-pass/10', 'text-text-primary');
          b.classList.add('border-border-hairline', 'bg-bg-canvas', 'text-text-secondary');
        });
        targetBtn.classList.remove('border-border-hairline', 'bg-bg-canvas', 'text-text-secondary');
        targetBtn.classList.add('border-status-pass/50', 'bg-status-pass/10', 'text-text-primary');

        if (modeBadge) {
          if (mode === 'water-sweep') modeBadge.textContent = 'Mode: Water Eject Sweep';
          if (mode === 'dust-blower') modeBadge.textContent = 'Mode: Dust Blower Wave';
          if (mode === 'crackle-test') modeBadge.textContent = 'Mode: Crackle & Distortion Check';
        }

        if (engine.active) {
          startEject();
        }
      });
    });

    // Channel Target Buttons
    const channelGroup = document.getElementById('channel-target-group');
    if (channelGroup) {
      channelGroup.querySelectorAll('button').forEach((b) => {
        b.addEventListener('click', () => {
          const target = b.getAttribute('data-target') as EjectTarget;
          if (!target) return;
          currentTarget = target;

          channelGroup.querySelectorAll('button').forEach((btn) => {
            btn.classList.remove('text-text-primary', 'bg-bg-elevated', 'font-bold');
            btn.classList.add('text-text-secondary');
          });
          b.classList.remove('text-text-secondary');
          b.classList.add('text-text-primary', 'bg-bg-elevated', 'font-bold');

          if (engine.active) {
            startEject();
          }
        });
      });
    }

    function startEject() {
      engine.start({
        mode: currentMode,
        target: currentTarget,
        baseFreq: currentMode === 'dust-blower' ? 220 : 165,
        endFreq: currentMode === 'dust-blower' ? 260 : 175,
        intensity: 1.0,
        volume: 1.0
      });

      if (btnLabel) btnLabel.textContent = 'STOP EJECTION';
      if (btnToggle) {
        btnToggle.classList.remove('bg-status-pass', 'hover:bg-emerald-400');
        btnToggle.classList.add('bg-status-fail', 'hover:bg-rose-500');
      }
      if (statusText) statusText.textContent = 'EJECTING SOUND ACTIVE';
      if (statusLed) {
        statusLed.classList.remove('bg-border-interactive');
        statusLed.classList.add('bg-status-pass', 'animate-pulse');
      }
    }

    function stopEject() {
      engine.stop();
      if (btnLabel) btnLabel.textContent = 'START WATER EJECT';
      if (btnToggle) {
        btnToggle.classList.remove('bg-status-fail', 'hover:bg-rose-500');
        btnToggle.classList.add('bg-status-pass', 'hover:bg-emerald-400');
      }
      if (statusText) statusText.textContent = 'Ready for Ejection';
      if (statusLed) {
        statusLed.classList.remove('bg-status-pass', 'animate-pulse');
        statusLed.classList.add('bg-border-interactive');
      }
    }

    btnToggle.addEventListener('click', async () => {
      await engine.initAudio();
      if (engine.active) {
        stopEject();
      } else {
        startEject();
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initWaterEjector);
  } else {
    initWaterEjector();
  }
</script>
