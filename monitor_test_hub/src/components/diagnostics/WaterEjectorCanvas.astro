---
import { useTranslations } from '../../utils/i18n';
const { t } = useTranslations(Astro.url.pathname);

export interface Props {
  defaultMode?: 'water-sweep' | 'dust-blower' | 'crackle-test';
}

const { defaultMode = 'water-sweep' } = Astro.props;
---

<div class="w-full max-w-5xl mx-auto space-y-8 font-sans" id="water-ejector-wrapper" data-default-mode={defaultMode}>

  <!-- Section 1: Choose Your Device Selection Grid -->
  <div class="space-y-4">
    <div class="flex items-center justify-between">
      <div>
        <h2 class="text-xl sm:text-2xl font-bold font-mono text-text-primary uppercase tracking-tight">
          Choose Your Device
        </h2>
        <p class="text-xs text-text-muted">
          Select your device type for optimized water eject sound frequencies and device-specific instructions.
        </p>
      </div>
      <span class="hidden sm:inline-flex px-2.5 py-1 rounded bg-status-pass/10 border border-status-pass/30 font-mono text-[10px] text-status-pass font-bold">
        Hardware Tuned
      </span>
    </div>

    <!-- 6 Device Cards Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4" id="device-preset-grid">
      
      <!-- Card 1: Universal Mobile -->
      <button data-preset="mobile" class="device-card active p-4 rounded-xl border border-status-pass bg-status-pass/10 text-left transition-all space-y-2 group cursor-pointer shadow-specular-top">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2">
            <svg class="w-5 h-5 text-status-pass" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" />
            </svg>
            <span class="font-bold font-mono text-sm text-text-primary group-hover:text-status-pass transition-colors">Mobile Water Eject</span>
          </div>
          <span class="text-[9px] font-mono font-bold px-2 py-0.5 rounded bg-status-pass/20 text-status-pass border border-status-pass/30">165Hz–300Hz</span>
        </div>
        <p class="text-xs text-text-muted leading-relaxed">
          Universal water eject sound tool for all mobile phone speakers. Works with any smartphone brand.
        </p>
        <div class="flex items-center gap-2 text-[10px] font-mono text-text-secondary pt-1">
          <span>✓ All Brands</span>
          <span>•</span>
          <span>✓ 30s Cycles</span>
        </div>
      </button>

      <!-- Card 2: iPhone Water Eject -->
      <button data-preset="iphone" class="device-card p-4 rounded-xl border border-border-hairline bg-bg-surface hover:border-border-interactive text-left transition-all space-y-2 group cursor-pointer shadow-specular-top">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2">
            <svg class="w-5 h-5 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" />
            </svg>
            <span class="font-bold font-mono text-sm text-text-primary group-hover:text-cyan-400 transition-colors">iPhone Water Eject</span>
          </div>
          <span class="text-[9px] font-mono font-bold px-2 py-0.5 rounded bg-cyan-400/10 text-cyan-400 border border-cyan-400/30">Apple Opt.</span>
        </div>
        <p class="text-xs text-text-muted leading-relaxed">
          Optimized water removal sound specifically tuned for iPhone speaker systems and Apple devices.
        </p>
        <div class="flex items-center gap-2 text-[10px] font-mono text-text-secondary pt-1">
          <span>✓ All iPhones</span>
          <span>•</span>
          <span>✓ Siri Shortcut info</span>
        </div>
      </button>

      <!-- Card 3: Android Water Eject -->
      <button data-preset="android" class="device-card p-4 rounded-xl border border-border-hairline bg-bg-surface hover:border-border-interactive text-left transition-all space-y-2 group cursor-pointer shadow-specular-top">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2">
            <svg class="w-5 h-5 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 1.5H8.25A2.25 2.25 0 006 3.75v16.5a2.25 2.25 0 002.25 2.25h7.5A2.25 2.25 0 0018 20.25V3.75a2.25 2.25 0 00-2.25-2.25H13.5m-3 0V3h3V1.5m-3 0h3" />
            </svg>
            <span class="font-bold font-mono text-sm text-text-primary group-hover:text-emerald-400 transition-colors">Android Water Eject</span>
          </div>
          <span class="text-[9px] font-mono font-bold px-2 py-0.5 rounded bg-emerald-400/10 text-emerald-400 border border-emerald-400/30">Android Opt.</span>
        </div>
        <p class="text-xs text-text-muted leading-relaxed">
          Designed for Samsung Galaxy, Google Pixel, OnePlus, Xiaomi, and all Android devices.
        </p>
        <div class="flex items-center gap-2 text-[10px] font-mono text-text-secondary pt-1">
          <span>✓ Samsung / Pixel</span>
          <span>•</span>
          <span>✓ All Brands</span>
        </div>
      </button>

      <!-- Card 4: Tablet Water Eject -->
      <button data-preset="tablet" class="device-card p-4 rounded-xl border border-border-hairline bg-bg-surface hover:border-border-interactive text-left transition-all space-y-2 group cursor-pointer shadow-specular-top">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2">
            <svg class="w-5 h-5 text-purple-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 18h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
            </svg>
            <span class="font-bold font-mono text-sm text-text-primary group-hover:text-purple-400 transition-colors">Tablet Water Eject</span>
          </div>
          <span class="text-[9px] font-mono font-bold px-2 py-0.5 rounded bg-purple-400/10 text-purple-400 border border-purple-400/30">Larger Drivers</span>
        </div>
        <p class="text-xs text-text-muted leading-relaxed">
          Powerful water removal sound for iPad, Samsung Galaxy Tab, and all tablet speakers.
        </p>
        <div class="flex items-center gap-2 text-[10px] font-mono text-text-secondary pt-1">
          <span>✓ iPad / Tab</span>
          <span>•</span>
          <span>✓ Extended Cycles</span>
        </div>
      </button>

      <!-- Card 5: Laptop Water Eject -->
      <button data-preset="laptop" class="device-card p-4 rounded-xl border border-border-hairline bg-bg-surface hover:border-border-interactive text-left transition-all space-y-2 group cursor-pointer shadow-specular-top">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2">
            <svg class="w-5 h-5 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <span class="font-bold font-mono text-sm text-text-primary group-hover:text-amber-400 transition-colors">Laptop Water Eject</span>
          </div>
          <span class="text-[9px] font-mono font-bold px-2 py-0.5 rounded bg-amber-400/10 text-amber-400 border border-amber-400/30">Multi-Speaker</span>
        </div>
        <p class="text-xs text-text-muted leading-relaxed">
          Safe water eject sound tool for MacBook, Windows laptops, and Chromebook speakers.
        </p>
        <div class="flex items-center gap-2 text-[10px] font-mono text-text-secondary pt-1">
          <span>✓ MacBook Safe</span>
          <span>•</span>
          <span>✓ Windows / Chrome</span>
        </div>
      </button>

      <!-- Card 6: Call Speaker / Earpiece -->
      <button data-preset="earpiece" class="device-card p-4 rounded-xl border border-border-hairline bg-bg-surface hover:border-border-interactive text-left transition-all space-y-2 group cursor-pointer shadow-specular-top">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2">
            <svg class="w-5 h-5 text-rose-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-2.826-1.47-5.114-3.758-6.584-6.584l1.293-.97c.362-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
            </svg>
            <span class="font-bold font-mono text-sm text-text-primary group-hover:text-rose-400 transition-colors">Call Speaker Eject</span>
          </div>
          <span class="text-[9px] font-mono font-bold px-2 py-0.5 rounded bg-rose-400/10 text-rose-400 border border-rose-400/30">Higher Freq</span>
        </div>
        <p class="text-xs text-text-muted leading-relaxed">
          Specialized tool for earpiece and call speaker water removal on any smartphone.
        </p>
        <div class="flex items-center gap-2 text-[10px] font-mono text-text-secondary pt-1">
          <span>✓ Earpiece Focused</span>
          <span>•</span>
          <span>✓ Voice Clarity</span>
        </div>
      </button>

    </div>
  </div>

  <!-- Hardware Control Deck Container -->
  <div class="relative overflow-hidden rounded-2xl bg-bg-surface border border-border-hairline p-6 sm:p-8 shadow-specular-top">
    <div class="absolute -top-32 -right-32 w-80 h-80 bg-status-pass/10 blur-3xl rounded-full pointer-events-none z-0"></div>
    <div class="absolute -bottom-32 -left-32 w-80 h-80 bg-status-info/10 blur-3xl rounded-full pointer-events-none z-0"></div>

    <div class="relative z-10 space-y-8">
      
      <!-- Top Diagnostic Mode & Preset Selector Header -->
      <div class="flex flex-wrap items-center justify-between gap-4 border-b border-border-hairline/80 pb-5">
        <div>
          <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-md bg-status-pass/10 border border-status-pass/30 font-mono text-[10px] text-status-pass font-bold uppercase tracking-widest mb-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-status-pass animate-pulse"></span>
            <span id="active-preset-name">Universal Mobile Mode</span>
          </div>
          <h2 class="text-xl sm:text-2xl font-bold font-mono text-text-primary tracking-tight" id="active-preset-title">
            Mobile Water Eject Sound
          </h2>
        </div>

        <div class="flex items-center gap-2 font-mono text-xs">
          <span class="text-text-muted text-[11px]">Channel:</span>
          <div class="inline-flex p-1 bg-bg-canvas border border-border-hairline rounded-lg" id="channel-target-group">
            <button data-target="all" class="px-3 py-1.5 rounded-md text-text-primary bg-bg-elevated font-bold transition-all shadow-sm">All</button>
            <button data-target="left" class="px-3 py-1.5 rounded-md text-text-secondary hover:text-text-primary transition-all">Left</button>
            <button data-target="right" class="px-3 py-1.5 rounded-md text-text-secondary hover:text-text-primary transition-all">Right</button>
          </div>
        </div>
      </div>

      <!-- Real-Time Waveform & Particle Canvas -->
      <div class="relative h-44 sm:h-56 bg-bg-canvas border border-border-hairline rounded-xl overflow-hidden flex flex-col justify-between p-4 shadow-inner">
        <canvas id="ejector-visualizer" class="absolute inset-0 w-full h-full z-0 opacity-80 pointer-events-none"></canvas>

        <div class="relative z-10 flex items-center justify-between font-mono text-xs">
          <div class="flex items-center gap-2 text-text-secondary">
            <span class="w-2 h-2 rounded-full bg-border-interactive" id="status-led"></span>
            <span id="status-text" class="text-[11px] uppercase tracking-wider font-semibold">Ready for Ejection</span>
          </div>
          <div class="text-right">
            <span class="text-[10px] text-text-muted block">Output Frequency</span>
            <span id="freq-readout" class="text-xl font-bold font-mono-tech text-status-pass tabular-nums">165 Hz</span>
          </div>
        </div>

        <div class="relative z-10 flex items-center justify-between font-mono text-[11px] text-text-muted">
          <span id="mode-badge" class="px-2 py-0.5 rounded bg-bg-surface/80 border border-border-hairline">Target: 165Hz–300Hz Resonant Sweep</span>
          <span class="hidden sm:inline">Vibration Haptics: <strong id="haptic-status" class="text-status-pass">Active</strong></span>
        </div>
      </div>

      <!-- Main Action Hub: EJECT & Mode Controls -->
      <div class="grid grid-cols-1 md:grid-cols-12 gap-6 items-center">
        <div class="md:col-span-6 flex flex-col items-center justify-center space-y-3 text-center">
          <button 
            id="btn-eject-toggle"
            class="w-full sm:w-72 h-16 sm:h-20 rounded-2xl bg-status-pass hover:bg-emerald-400 text-bg-canvas font-mono font-extrabold text-lg sm:text-xl tracking-wider uppercase transition-all duration-200 shadow-[0_0_30px_rgba(5,150,105,0.4)] active:scale-95 flex items-center justify-center gap-3 group cursor-pointer"
          >
            <svg class="w-7 h-7 transition-transform group-hover:scale-110" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 13.5L12 21m0 0l-7.5-7.5M12 21V3" />
            </svg>
            <span id="btn-label">START WATER EJECT</span>
          </button>
          <p class="text-xs text-text-muted max-w-xs leading-normal">
            Turn device volume up to <strong>100%</strong> and face screen downward for maximum momentum.
          </p>
        </div>

        <!-- Mode Presets Grid -->
        <div class="md:col-span-6 space-y-2 font-mono text-xs">
          <div class="text-[10px] text-text-muted uppercase tracking-wider font-bold mb-1">Select Diagnostic Mode</div>

          <button data-mode="water-sweep" class="mode-btn w-full p-3 rounded-xl border border-status-pass/50 bg-status-pass/10 text-text-primary text-left flex items-center justify-between hover:border-status-pass transition-all">
            <div>
              <div class="font-bold text-xs">1. Water Removal Sweep</div>
              <div class="text-[10px] text-text-muted font-sans">Acoustic resonant sweep tailored to device profile</div>
            </div>
            <span class="text-[10px] font-bold text-status-pass bg-status-pass/20 px-2 py-0.5 rounded">Standard</span>
          </button>

          <button data-mode="dust-blower" class="mode-btn w-full p-3 rounded-xl border border-border-hairline bg-bg-canvas text-text-secondary text-left flex items-center justify-between hover:border-border-interactive transition-all">
            <div>
              <div class="font-bold text-xs">2. Dust Blower Wave</div>
              <div class="text-[10px] text-text-muted font-sans">High-energy sawtooth harmonic air impulse</div>
            </div>
            <span class="text-[10px] text-text-muted bg-bg-elevated px-2 py-0.5 rounded">Dust</span>
          </button>

          <button data-mode="crackle-test" class="mode-btn w-full p-3 rounded-xl border border-border-hairline bg-bg-canvas text-text-secondary text-left flex items-center justify-between hover:border-border-interactive transition-all">
            <div>
              <div class="font-bold text-xs">3. Crackling &amp; Distortion Check</div>
              <div class="text-[10px] text-text-muted font-sans">Triangle tone sweep to isolate mechanical buzz</div>
            </div>
            <span class="text-[10px] text-text-muted bg-bg-elevated px-2 py-0.5 rounded">Check</span>
          </button>
        </div>
      </div>

    </div>
  </div>

  <!-- Section 3: How Water Eject Sound Works (3-Step Workflow) -->
  <div class="border border-border-hairline rounded-2xl bg-bg-surface p-6 sm:p-8 space-y-6 shadow-specular-top">
    <div class="text-center space-y-1">
      <div class="font-mono text-xs text-status-pass font-bold uppercase tracking-wider">Simple 3-Step Process</div>
      <h3 class="text-2xl font-bold font-mono text-text-primary tracking-tight">
        How Water Eject Sound Works
      </h3>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 font-sans">
      <!-- Step 1 -->
      <div class="p-5 rounded-xl bg-bg-canvas border border-border-hairline relative space-y-3 shadow-specular-top">
        <div class="w-9 h-9 rounded-xl bg-status-pass/10 border border-status-pass/30 flex items-center justify-center font-mono font-bold text-status-pass text-base">
          1
        </div>
        <h4 class="font-bold text-text-primary text-base">Select Device</h4>
        <p class="text-xs text-text-muted leading-relaxed">
          Choose your specific device type above to load optimized acoustic frequencies (165Hz–300Hz) and driver parameters.
        </p>
      </div>

      <!-- Step 2 -->
      <div class="p-5 rounded-xl bg-bg-canvas border border-border-hairline relative space-y-3 shadow-specular-top">
        <div class="w-9 h-9 rounded-xl bg-cyan-500/10 border border-cyan-500/30 flex items-center justify-center font-mono font-bold text-cyan-400 text-base">
          2
        </div>
        <h4 class="font-bold text-text-primary text-base">Play Sound</h4>
        <p class="text-xs text-text-muted leading-relaxed">
          Turn your device volume up to 100%, point your speaker grill downward, and press "Start Water Eject".
        </p>
      </div>

      <!-- Step 3 -->
      <div class="p-5 rounded-xl bg-bg-canvas border border-border-hairline relative space-y-3 shadow-specular-top">
        <div class="w-9 h-9 rounded-xl bg-purple-500/10 border border-purple-500/30 flex items-center justify-center font-mono font-bold text-purple-400 text-base">
          3
        </div>
        <h4 class="font-bold text-text-primary text-base">Water Ejects</h4>
        <p class="text-xs text-text-muted leading-relaxed">
          High-intensity sound wave vibrations and synchronized haptic pulses physically push trapped water droplets out of your speaker.
        </p>
      </div>
    </div>
  </div>

</div>

<script>
  import { AudioDiagnosticEngine, DiagnosticMode, EjectTarget, DevicePreset, DEVICE_PRESETS } from '../../engine/AudioDiagnosticEngine';

  function initWaterEjector() {
    const btnToggle = document.getElementById('btn-eject-toggle');
    const btnLabel = document.getElementById('btn-label');
    const freqReadout = document.getElementById('freq-readout');
    const statusText = document.getElementById('status-text');
    const statusLed = document.getElementById('status-led');
    const modeBadge = document.getElementById('mode-badge');
    const activePresetName = document.getElementById('active-preset-name');
    const activePresetTitle = document.getElementById('active-preset-title');
    const canvas = document.getElementById('ejector-visualizer') as HTMLCanvasElement;
    const ctx = canvas ? canvas.getContext('2d') : null;

    if (!btnToggle || !btnLabel || !freqReadout) return;

    const wrapper = document.getElementById('water-ejector-wrapper');
    const defaultModeStr = wrapper?.getAttribute('data-default-mode');

    let currentPreset: DevicePreset = 'mobile';
    let currentMode: DiagnosticMode = (defaultModeStr as DiagnosticMode) || 'water-sweep';
    let currentTarget: EjectTarget = 'all';

    const engine = new AudioDiagnosticEngine(
      (freq) => {
        if (freqReadout) freqReadout.textContent = `${freq} Hz`;
      },
      (data) => {
        if (ctx && canvas) {
          ctx.clearRect(0, 0, canvas.width, canvas.height);
          const barW = canvas.width / data.length;
          for (let i = 0; i < data.length; i++) {
            const h = (data[i] / 255) * canvas.height;
            ctx.fillStyle = i % 2 === 0 ? 'rgba(5, 150, 105, 0.4)' : 'rgba(6, 182, 212, 0.4)';
            ctx.fillRect(i * barW, canvas.height - h, barW - 2, h);
          }
        }
      }
    );

    function resizeCanvas() {
      if (canvas) {
        canvas.width = canvas.offsetWidth;
        canvas.height = canvas.offsetHeight;
      }
    }
    resizeCanvas();
    window.addEventListener('resize', resizeCanvas);

    // Device Preset Selection
    const deviceCards = document.querySelectorAll('.device-card');
    deviceCards.forEach((card) => {
      card.addEventListener('click', (e) => {
        const targetCard = e.currentTarget as HTMLElement;
        const preset = targetCard.getAttribute('data-preset') as DevicePreset;
        if (!preset || !DEVICE_PRESETS[preset]) return;

        currentPreset = preset;
        const pConfig = DEVICE_PRESETS[preset];

        deviceCards.forEach((c) => {
          c.classList.remove('border-status-pass', 'bg-status-pass/10');
          c.classList.add('border-border-hairline', 'bg-bg-surface');
        });
        targetCard.classList.remove('border-border-hairline', 'bg-bg-surface');
        targetCard.classList.add('border-status-pass', 'bg-status-pass/10');

        if (activePresetName) activePresetName.textContent = pConfig.name;
        if (activePresetTitle) activePresetTitle.textContent = `${pConfig.name} Water Eject`;
        if (modeBadge) modeBadge.textContent = `Target: ${pConfig.baseFreq}Hz–${pConfig.endFreq}Hz Resonant Sweep`;
        if (freqReadout) freqReadout.textContent = `${pConfig.baseFreq} Hz`;

        if (engine.active) {
          startEject();
        }
      });
    });

    // Diagnostic Mode Selector Buttons
    function updateModeUI(mode: DiagnosticMode) {
      document.querySelectorAll('.mode-btn').forEach((b) => {
        b.classList.remove('border-status-pass/50', 'bg-status-pass/10', 'text-text-primary');
        b.classList.add('border-border-hairline', 'bg-bg-canvas', 'text-text-secondary');
      });
      const targetBtn = document.querySelector(`.mode-btn[data-mode="${mode}"]`);
      if (targetBtn) {
        targetBtn.classList.remove('border-border-hairline', 'bg-bg-canvas', 'text-text-secondary');
        targetBtn.classList.add('border-status-pass/50', 'bg-status-pass/10', 'text-text-primary');
      }
    }

    document.querySelectorAll('.mode-btn').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const targetBtn = e.currentTarget as HTMLElement;
        const mode = targetBtn.getAttribute('data-mode') as DiagnosticMode;
        if (!mode) return;

        currentMode = mode;
        updateModeUI(mode);

        if (engine.active) {
          startEject();
        }
      });
    });

    // Initialize mode UI
    updateModeUI(currentMode);

    // Channel Target Buttons
    const channelGroup = document.getElementById('channel-target-group');
    if (channelGroup) {
      channelGroup.querySelectorAll('button').forEach((b) => {
        b.addEventListener('click', () => {
          const target = b.getAttribute('data-target') as EjectTarget;
          if (!target) return;
          currentTarget = target;

          channelGroup.querySelectorAll('button').forEach((btn) => {
            btn.classList.remove('text-text-primary', 'bg-bg-elevated', 'font-bold');
            btn.classList.add('text-text-secondary');
          });
          b.classList.remove('text-text-secondary');
          b.classList.add('text-text-primary', 'bg-bg-elevated', 'font-bold');

          if (engine.active) {
            startEject();
          }
        });
      });
    }

    function startEject() {
      const pConfig = DEVICE_PRESETS[currentPreset] || DEVICE_PRESETS.mobile;
      engine.start({
        mode: currentMode,
        target: currentTarget,
        preset: currentPreset,
        baseFreq: currentMode === 'dust-blower' ? 220 : pConfig.baseFreq,
        endFreq: currentMode === 'dust-blower' ? 320 : pConfig.endFreq,
        intensity: 1.0,
        volume: 1.0
      });

      if (btnLabel) btnLabel.textContent = 'STOP EJECTION';
      if (btnToggle) {
        btnToggle.classList.remove('bg-status-pass', 'hover:bg-emerald-400');
        btnToggle.classList.add('bg-status-fail', 'hover:bg-rose-500');
      }
      if (statusText) statusText.textContent = 'EJECTING SOUND ACTIVE';
      if (statusLed) {
        statusLed.classList.remove('bg-border-interactive');
        statusLed.classList.add('bg-status-pass', 'animate-pulse');
      }
    }

    function stopEject() {
      engine.stop();
      if (btnLabel) btnLabel.textContent = 'START WATER EJECT';
      if (btnToggle) {
        btnToggle.classList.remove('bg-status-fail', 'hover:bg-rose-500');
        btnToggle.classList.add('bg-status-pass', 'hover:bg-emerald-400');
      }
      if (statusText) statusText.textContent = 'Ready for Ejection';
      if (statusLed) {
        statusLed.classList.remove('bg-status-pass', 'animate-pulse');
        statusLed.classList.add('bg-border-interactive');
      }
    }

    btnToggle.addEventListener('click', async () => {
      await engine.initAudio();
      if (engine.active) {
        stopEject();
      } else {
        startEject();
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initWaterEjector);
  } else {
    initWaterEjector();
  }
</script>
