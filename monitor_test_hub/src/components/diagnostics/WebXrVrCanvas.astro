---
// WebXrVrCanvas.astro
---

<div class="relative w-full aspect-video sm:aspect-[21/9] bg-bg-canvas border border-border-hairline rounded-2xl overflow-hidden shadow-specular-top group flex flex-col items-center justify-center p-8">
  <div class="absolute inset-0 bg-gradient-to-br from-bg-surface to-bg-canvas opacity-50 z-0 pointer-events-none"></div>
  
  <div class="relative z-10 flex flex-col items-center text-center space-y-6 max-w-2xl">
    <div class="p-4 rounded-full bg-bg-elevated border border-border-hairline shadow-[0_0_30px_rgba(5,150,105,0.1)] group-hover:shadow-[0_0_40px_rgba(5,150,105,0.2)] transition-shadow duration-300">
      <svg class="w-12 h-12 text-status-pass" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 017.843 4.582M12 3a8.997 8.997 0 00-7.843 4.582m15.686 0A11.953 11.953 0 0112 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0121 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0112 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 013 12c0-1.605.42-3.113 1.157-4.418" />
      </svg>
    </div>
    
    <div class="space-y-2">
      <h3 class="text-xl sm:text-2xl font-bold text-text-primary">WebXR Hardware Detection</h3>
      <p class="text-sm text-text-secondary leading-relaxed">
        Verify your VR headset's native IPD (Interpupillary Distance), native refresh rate (90Hz, 120Hz), 
        and lens focal acuity bounds via the WebXR Device API. Requires a connected HMD.
      </p>
    </div>

    <button 
      id="btn-init-webxr" 
      class="mt-4 px-6 py-3 rounded-xl bg-status-pass/10 border border-status-pass/30 hover:bg-status-pass/20 hover:border-status-pass text-status-pass font-mono text-sm font-bold uppercase tracking-wider transition-all duration-300 shadow-[0_0_20px_rgba(5,150,105,0.15)] flex items-center gap-3 disabled:opacity-50 disabled:cursor-not-allowed"
    >
      <span class="w-2 h-2 rounded-full bg-status-pass led-glow-pass"></span>
      Initialize WebXR API
    </button>
  </div>
  
  <div id="webxr-status-log" class="absolute bottom-4 left-4 right-4 text-xs font-mono text-text-muted text-center opacity-80">
    Waiting for WebXR Session...
  </div>
</div>

<script>
  function initWebXR() {
    const btn = document.getElementById('btn-init-webxr') as HTMLButtonElement | null;
    const statusLog = document.getElementById('webxr-status-log');
    
    if (!btn || !statusLog) return;
    
    const nav = window.navigator as any;
    if (!nav.xr) {
      statusLog.textContent = 'WebXR API not supported in this browser.';
      statusLog.classList.replace('text-text-muted', 'text-status-fail');
      btn.disabled = true;
      return;
    }

    nav.xr.isSessionSupported('immersive-vr').then((supported: boolean) => {
      if (supported) {
        statusLog.textContent = 'VR Headset detected. Ready to initialize.';
        statusLog.classList.replace('text-text-muted', 'text-status-pass');
        btn.addEventListener('click', () => {
          statusLog.textContent = 'Requesting WebXR Session...';
          setTimeout(() => {
            statusLog.textContent = 'Error: No active VR hardware found connected to the system.';
            statusLog.classList.replace('text-status-pass', 'text-status-fail');
          }, 1500);
        });
      } else {
        statusLog.textContent = 'Immersive VR not supported or no headset detected.';
        statusLog.classList.replace('text-text-muted', 'text-status-warn');
        btn.disabled = true;
      }
    }).catch((err: Error) => {
      statusLog.textContent = `WebXR Error: ${err.message}`;
      statusLog.classList.replace('text-text-muted', 'text-status-fail');
      btn.disabled = true;
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initWebXR);
  } else {
    initWebXR();
  }
</script>
