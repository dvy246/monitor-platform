---
import { WireGaugeEngine, type ConductorMaterial, type InsulationTemp } from '../../engine/WireGaugeEngine';

interface Props {
  initialAmperage?: number;
  initialVoltage?: number;
  initialDistanceFeet?: number;
  initialMaterial?: ConductorMaterial;
}

const { initialAmperage = 20, initialVoltage = 120, initialDistanceFeet = 50, initialMaterial = 'Copper' } = Astro.props;

const initialResult = WireGaugeEngine.calculateWireSizing(initialAmperage, initialVoltage, initialDistanceFeet, initialMaterial);
---

<div class="w-full max-w-7xl mx-auto space-y-6 font-sans select-none min-w-0" id="wire-gauge-root">
  <div class="relative bg-[#0c0d12]/95 border border-zinc-800/90 rounded-3xl p-4 sm:p-8 backdrop-blur-2xl shadow-[0_25px_60px_rgba(0,0,0,0.8)] space-y-6 overflow-hidden min-w-0 text-zinc-100">
    <!-- Ambient Glows -->
    <div class="absolute -top-24 -right-24 w-96 h-96 bg-rose-500/10 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-24 -left-24 w-96 h-96 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>

    <!-- Header Controls -->
    <div class="relative z-10 flex flex-col md:flex-row items-start md:items-center justify-between gap-4 border-b border-zinc-800/70 pb-5">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-rose-500/10 border border-rose-500/30 text-[11px] font-mono text-rose-400 font-bold uppercase tracking-wider mb-2">
          <span class="w-2 h-2 rounded-full bg-rose-400 shadow-[0_0_8px_rgba(251,113,133,0.9)] animate-pulse"></span>
          <span>NEC 2026 CODE TRADE SIZING ENGINE</span>
        </div>
        <h2 class="text-xl sm:text-3xl font-extrabold font-mono text-white tracking-tight">Wire Gauge &amp; Voltage Drop Calculator</h2>
        <p class="text-xs sm:text-sm text-zinc-400 mt-1">Conductor ampacity Table 310.16 &amp; branch circuit voltage drop compliance evaluator.</p>
      </div>
    </div>

    <div class="relative z-10 grid grid-cols-1 lg:grid-cols-3 gap-6">
      <!-- Input Controls Deck -->
      <div class="space-y-5 bg-zinc-950/80 p-5 sm:p-6 rounded-2xl border border-zinc-800/80 shadow-inner font-mono text-xs">
        <div>
          <label class="flex items-center gap-1.5 font-bold uppercase text-zinc-400 mb-2">
            <svg class="w-4 h-4 text-rose-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
            <span>Circuit Amperage (Amps)</span>
          </label>
          <input id="amp-input" type="number" value={initialAmperage} min="5" max="400" class="w-full bg-zinc-900 border border-zinc-700/80 rounded-xl p-3 text-sm text-white focus:border-rose-500 focus:outline-none" />
        </div>

        <div>
          <label class="flex items-center gap-1.5 font-bold uppercase text-zinc-400 mb-2">
            <svg class="w-4 h-4 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span>Voltage (Volts)</span>
          </label>
          <select id="volt-select" class="w-full bg-zinc-900 border border-zinc-700/80 rounded-xl p-3 text-sm text-white focus:border-rose-500 focus:outline-none cursor-pointer">
            <option value="120" selected={initialVoltage === 120}>120V Single Phase</option>
            <option value="240" selected={initialVoltage === 240}>240V Single Phase</option>
            <option value="208" selected={initialVoltage === 208}>208V Three Phase</option>
            <option value="480" selected={initialVoltage === 480}>480V Three Phase</option>
          </select>
        </div>

        <div>
          <label class="flex items-center gap-1.5 font-bold uppercase text-zinc-400 mb-2">
            <svg class="w-4 h-4 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" />
            </svg>
            <span>One-Way Wire Distance (Feet)</span>
          </label>
          <input id="dist-input" type="number" value={initialDistanceFeet} min="10" max="1000" class="w-full bg-zinc-900 border border-zinc-700/80 rounded-xl p-3 text-sm text-white focus:border-rose-500 focus:outline-none" />
        </div>
      </div>

      <!-- Result Metrics & Code Compliance -->
      <div class="lg:col-span-2 space-y-5">
        <div class="bg-zinc-950/80 p-5 sm:p-6 rounded-2xl border border-zinc-800/80 grid grid-cols-1 sm:grid-cols-2 gap-4 text-center font-mono shadow-inner">
          <div class="bg-zinc-900/90 p-5 rounded-xl border border-zinc-800 space-y-1">
            <div class="text-xs text-zinc-400 uppercase font-bold flex items-center justify-center gap-1.5">
              <svg class="w-4 h-4 text-rose-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span>Recommended Conductor</span>
            </div>
            <div class="text-3xl sm:text-4xl font-extrabold text-rose-400 mt-2 tabular-nums">{initialResult.recommendedGauge}</div>
            <div class="text-[11px] text-zinc-500 mt-1">{initialResult.material} (75°C Insulation)</div>
          </div>

          <div class="bg-zinc-900/90 p-5 rounded-xl border border-zinc-800 space-y-1">
            <div class="text-xs text-zinc-400 uppercase font-bold flex items-center justify-center gap-1.5">
              <svg class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
              </svg>
              <span>Voltage Drop</span>
            </div>
            <div class={`text-3xl sm:text-4xl font-extrabold mt-2 tabular-nums ${initialResult.isVoltageDropAcceptable ? 'text-emerald-400' : 'text-rose-500'}`}>
              {initialResult.voltageDropVolts}V ({initialResult.voltageDropPercent}%)
            </div>
            <div class="text-[11px] text-zinc-500 mt-1">{initialResult.isVoltageDropAcceptable ? 'PASS (<= 3% NEC Standard)' : 'FAIL (> 3% NEC Drop)'}</div>
          </div>
        </div>

        <div class="bg-zinc-950/80 p-5 sm:p-6 rounded-2xl border border-zinc-800/80 space-y-2 font-mono text-xs shadow-inner">
          <div class="text-zinc-400 uppercase font-bold">Conduit &amp; NEC Code References</div>
          <div class="text-emerald-400 font-bold text-sm">{initialResult.conduitFillRecommendation}</div>
          <div class="text-zinc-500 font-sans">{initialResult.necCitation}</div>
        </div>
      </div>
    </div>
  </div>
</div>
