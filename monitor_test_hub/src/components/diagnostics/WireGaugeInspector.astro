---
import { WireGaugeEngine, type ConductorMaterial, type InsulationTemp } from '../../engine/WireGaugeEngine';

interface Props {
  initialAmperage?: number;
  initialVoltage?: number;
  initialDistanceFeet?: number;
  initialMaterial?: ConductorMaterial;
}

const { initialAmperage = 20, initialVoltage = 120, initialDistanceFeet = 50, initialMaterial = 'Copper' } = Astro.props;

const initialResult = WireGaugeEngine.calculateWireSizing(initialAmperage, initialVoltage, initialDistanceFeet, initialMaterial);
---

<div class="w-full max-w-5xl mx-auto p-4 md:p-6 bg-[#121215] border border-white/10 rounded-2xl shadow-2xl text-slate-100 font-sans">
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-6 border-b border-white/10">
    <div>
      <div class="flex items-center gap-2 text-rose-400 text-xs font-mono uppercase tracking-widest mb-1">
        <svg class="w-4 h-4 text-rose-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
        </svg>
        <span>NEC 2026 Trade Sizing Engine</span>
      </div>
      <h2 class="text-2xl md:text-3xl font-black text-white tracking-tight">Wire Gauge &amp; Voltage Drop Calculator</h2>
      <p class="text-sm text-slate-400 mt-1">Conductor ampacity Table 310.16 &amp; branch circuit voltage drop compliance.</p>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mt-6">
    <div class="space-y-4 bg-black/30 p-5 rounded-xl border border-white/5">
      <div>
        <label class="flex items-center gap-1.5 text-xs font-mono uppercase text-slate-400 mb-2">
          <svg class="w-4 h-4 text-rose-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
          <span>Circuit Amperage (Amps)</span>
        </label>
        <input id="amp-input" type="number" value={initialAmperage} min="5" max="400" class="w-full bg-[#18181b] border border-white/10 rounded-lg p-2.5 text-sm text-white focus:border-rose-500 focus:outline-none" />
      </div>

      <div>
        <label class="flex items-center gap-1.5 text-xs font-mono uppercase text-slate-400 mb-2">
          <svg class="w-4 h-4 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span>Voltage (Volts)</span>
        </label>
        <select id="volt-select" class="w-full bg-[#18181b] border border-white/10 rounded-lg p-2.5 text-sm text-white focus:border-rose-500 focus:outline-none cursor-pointer">
          <option value="120" selected={initialVoltage === 120}>120V Single Phase</option>
          <option value="240" selected={initialVoltage === 240}>240V Single Phase</option>
          <option value="208" selected={initialVoltage === 208}>208V Three Phase</option>
          <option value="480" selected={initialVoltage === 480}>480V Three Phase</option>
        </select>
      </div>

      <div>
        <label class="flex items-center gap-1.5 text-xs font-mono uppercase text-slate-400 mb-2">
          <svg class="w-4 h-4 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" />
          </svg>
          <span>One-Way Wire Distance (Feet)</span>
        </label>
        <input id="dist-input" type="number" value={initialDistanceFeet} min="10" max="1000" class="w-full bg-[#18181b] border border-white/10 rounded-lg p-2.5 text-sm text-white focus:border-rose-500 focus:outline-none" />
      </div>
    </div>

    <div class="lg:col-span-2 space-y-6">
      <div class="bg-black/40 p-6 rounded-xl border border-white/5 grid grid-cols-1 sm:grid-cols-2 gap-4 text-center">
        <div class="bg-[#18181b] p-5 rounded-xl border border-white/5">
          <div class="text-xs text-slate-400 font-mono uppercase flex items-center justify-center gap-1.5">
            <svg class="w-4 h-4 text-rose-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span>Recommended Conductor</span>
          </div>
          <div class="text-3xl font-black text-rose-400 mt-2">{initialResult.recommendedGauge}</div>
          <div class="text-xs text-slate-500 mt-1">{initialResult.material} (75°C Insulation)</div>
        </div>

        <div class="bg-[#18181b] p-5 rounded-xl border border-white/5">
          <div class="text-xs text-slate-400 font-mono uppercase flex items-center justify-center gap-1.5">
            <svg class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
            </svg>
            <span>Voltage Drop</span>
          </div>
          <div class={`text-3xl font-black mt-2 ${initialResult.isVoltageDropAcceptable ? 'text-emerald-400' : 'text-rose-500'}`}>
            {initialResult.voltageDropVolts}V ({initialResult.voltageDropPercent}%)
          </div>
          <div class="text-xs text-slate-500 mt-1">{initialResult.isVoltageDropAcceptable ? 'PASS (<= 3% NEC Standard)' : 'FAIL (> 3% NEC Drop)'}</div>
        </div>
      </div>

      <div class="bg-black/30 p-5 rounded-xl border border-white/5 space-y-2">
        <div class="text-xs text-slate-400 font-mono uppercase">Conduit &amp; Code References</div>
        <div class="text-xs text-emerald-400 font-semibold">{initialResult.conduitFillRecommendation}</div>
        <div class="text-xs text-slate-500">{initialResult.necCitation}</div>
      </div>
    </div>
  </div>
</div>
