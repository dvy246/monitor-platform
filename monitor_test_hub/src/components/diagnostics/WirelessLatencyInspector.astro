---
import ErgonomicsNotice from '../disclaimers/ErgonomicsNotice.astro';
import HardwareLimitationNotice from '../disclaimers/HardwareLimitationNotice.astro';
---

<div class="bg-bg-surface border border-border-hairline rounded-2xl p-6 sm:p-8 space-y-8 shadow-2xl font-mono">
  <!-- Header Deck -->
  <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 border-b border-border-hairline pb-5">
    <div>
      <div class="text-xs font-bold text-status-pass uppercase tracking-widest flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-status-pass led-glow-pass animate-pulse"></span>
        <span>SYSTEMIC SIGNAL TIMING &amp; MULTI-LAYER PIPELINE ANALYZER</span>
      </div>
      <h3 class="text-xl font-extrabold text-text-primary mt-1">Wireless Audio &amp; Peripheral Latency Inspector</h3>
    </div>
    <div id="esports-badge" class="px-3 py-1 rounded-full bg-status-pass/10 border border-status-pass/30 text-status-pass text-xs font-bold">
      ESPORTS GRADE (&le;30ms)
    </div>
  </div>

  <!-- Main Grid: Controls + Breakdown Telemetry -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
    <!-- Controls (5 cols) -->
    <div class="lg:col-span-5 bg-bg-canvas p-5 rounded-xl border border-border-hairline space-y-5 text-xs">
      <h4 class="text-sm font-bold text-text-primary border-b border-border-hairline pb-2 flex items-center gap-2">
        <span>⚙️ HARDWARE &amp; PROTOCOL CONFIGURATION</span>
      </h4>

      <!-- Protocol Selection -->
      <div>
        <label for="wl-protocol" class="text-text-secondary font-bold block mb-1.5 uppercase">Transmission Protocol / Codec</label>
        <select id="wl-protocol" class="w-full bg-bg-surface border border-border-hairline rounded-lg p-2.5 text-text-primary font-mono cursor-pointer focus:ring-2 focus:ring-status-pass outline-none">
          <option value="USB_WIRED">USB Wired Connection (0.5ms codec)</option>
          <option value="RF_2_4GHZ_DONGLE" selected>2.4GHz RF USB Dongle (12ms codec)</option>
          <option value="BLUETOOTH_APTX_LL">Bluetooth aptX Low Latency (35ms codec)</option>
          <option value="BLUETOOTH_LC3">Bluetooth LC3 LE Audio (45ms codec)</option>
          <option value="BLUETOOTH_APTX_ADAPTIVE">Bluetooth aptX Adaptive (60ms codec)</option>
          <option value="BLUETOOTH_APTX">Bluetooth aptX Standard (130ms codec)</option>
          <option value="BLUETOOTH_LDAC">Sony LDAC High-Res 990kbps (160ms codec)</option>
          <option value="BLUETOOTH_SBC">Bluetooth SBC Standard (170ms codec)</option>
          <option value="BLUETOOTH_AAC">Bluetooth AAC Apple iOS/macOS (200ms codec)</option>
        </select>
      </div>

      <!-- OS Audio Stack -->
      <div>
        <label for="wl-audio-stack" class="text-text-secondary font-bold block mb-1.5 uppercase">OS Audio Subsystem</label>
        <select id="wl-audio-stack" class="w-full bg-bg-surface border border-border-hairline rounded-lg p-2.5 text-text-primary font-mono cursor-pointer focus:ring-2 focus:ring-status-pass outline-none">
          <option value="WINDOWS_WASAPI_EXCLUSIVE" selected>Windows WASAPI Exclusive Mode (3ms stack)</option>
          <option value="MACOS_COREAUDIO">macOS CoreAudio Subsystem (5ms stack)</option>
          <option value="LINUX_PIPEWIRE">Linux PipeWire Low-Latency (7ms stack)</option>
          <option value="ANDROID_AAUDIO">Android AAudio HAL Stream (15ms stack)</option>
          <option value="WINDOWS_WASAPI_SHARED">Windows WASAPI Shared / DirectSound (20ms stack)</option>
        </select>
      </div>

      <!-- Buffer Size & Sample Rate -->
      <div class="grid grid-cols-2 gap-3">
        <div>
          <label for="wl-buffer-size" class="text-text-secondary font-bold block mb-1.5 uppercase">Audio Buffer</label>
          <select id="wl-buffer-size" class="w-full bg-bg-surface border border-border-hairline rounded-lg p-2.5 text-text-primary font-mono cursor-pointer focus:ring-2 focus:ring-status-pass outline-none">
            <option value="128">128 samples (2.67ms @ 48k)</option>
            <option value="256" selected>256 samples (5.33ms @ 48k)</option>
            <option value="512">512 samples (10.67ms @ 48k)</option>
            <option value="1024">1024 samples (21.33ms @ 48k)</option>
          </select>
        </div>
        <div>
          <label for="wl-sample-rate" class="text-text-secondary font-bold block mb-1.5 uppercase">Sample Rate</label>
          <select id="wl-sample-rate" class="w-full bg-bg-surface border border-border-hairline rounded-lg p-2.5 text-text-primary font-mono cursor-pointer focus:ring-2 focus:ring-status-pass outline-none">
            <option value="44100">44.1 kHz</option>
            <option value="48000" selected>48.0 kHz (Pro Audio)</option>
            <option value="96000">96.0 kHz (Hi-Res)</option>
          </select>
        </div>
      </div>

      <!-- Display FPS & RF Interference -->
      <div class="grid grid-cols-2 gap-3">
        <div>
          <label for="wl-display-fps" class="text-text-secondary font-bold block mb-1.5 uppercase">Display FPS</label>
          <select id="wl-display-fps" class="w-full bg-bg-surface border border-border-hairline rounded-lg p-2.5 text-text-primary font-mono cursor-pointer focus:ring-2 focus:ring-status-pass outline-none">
            <option value="60">60 Hz (16.67ms frame)</option>
            <option value="120">120 Hz (8.33ms frame)</option>
            <option value="144" selected>144 Hz (6.94ms frame)</option>
            <option value="240">240 Hz (4.17ms frame)</option>
            <option value="360">360 Hz (2.78ms frame)</option>
            <option value="540">540 Hz (1.85ms frame)</option>
          </select>
        </div>
        <div>
          <label for="wl-rf-interference" class="text-text-secondary font-bold block mb-1.5 uppercase">RF Noise Level</label>
          <select id="wl-rf-interference" class="w-full bg-bg-surface border border-border-hairline rounded-lg p-2.5 text-text-primary font-mono cursor-pointer focus:ring-2 focus:ring-status-pass outline-none">
            <option value="LOW" selected>Low (Clear 2.4GHz Spectrum)</option>
            <option value="MEDIUM">Medium (Crowded Wi-Fi)</option>
            <option value="HIGH">High (Heavy 2.4GHz Congestion)</option>
          </select>
        </div>
      </div>

      <!-- ANC Toggle -->
      <div class="flex items-center justify-between p-3 bg-bg-surface border border-border-hairline rounded-lg">
        <span class="font-bold text-text-secondary uppercase">Active Noise Cancellation (ANC DSP)</span>
        <label class="relative inline-flex items-center cursor-pointer">
          <input type="checkbox" id="wl-anc-toggle" class="sr-only peer">
          <div class="w-9 h-5 bg-bg-elevated peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-status-pass"></div>
        </label>
      </div>

      <!-- Interactive Emitter Button -->
      <div class="space-y-2 pt-2 border-t border-border-hairline">
        <button id="trigger-audio-btn" class="w-full py-3.5 rounded-xl bg-status-pass text-bg-canvas font-extrabold text-sm hover:opacity-90 transition-all shadow-lg cursor-pointer flex items-center justify-center gap-2">
          <span>🔊 EMIT HARDWARE AUDIO PULSE</span>
        </button>
        <p class="text-[11px] text-text-muted text-center">
          Triggers a sub-millisecond Web Audio sine wave pulse synced with the visual flash box.
        </p>
      </div>
    </div>

    <!-- Telemetry Output (7 cols) -->
    <div class="lg:col-span-7 bg-bg-canvas p-5 rounded-xl border border-border-hairline space-y-6">
      <h4 class="text-sm font-bold text-text-primary border-b border-border-hairline pb-2 flex items-center justify-between">
        <span>📊 SYSTEMIC LATENCY TELEMETRY</span>
        <span id="overall-severity" class="text-xs font-mono font-bold text-status-pass">EXCELLENT</span>
      </h4>

      <!-- Key Stat Callouts -->
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-4">
        <div class="bg-bg-surface p-4 rounded-xl border border-border-hairline space-y-1">
          <div class="text-[11px] text-text-muted font-bold uppercase">Total Systemic Delay</div>
          <div id="stat-total-latency" class="text-2xl sm:text-3xl font-black text-status-pass">31.27 ms</div>
          <div class="text-[10px] text-text-secondary font-sans">End-to-end pipeline</div>
        </div>

        <div class="bg-bg-surface p-4 rounded-xl border border-border-hairline space-y-1">
          <div class="text-[11px] text-text-muted font-bold uppercase">Lip-Sync Offset</div>
          <div id="stat-frame-offset" class="text-2xl sm:text-3xl font-black text-amber-400">5 Frames</div>
          <div id="stat-fps-label" class="text-[10px] text-text-secondary font-sans">@ 144Hz Refresh</div>
        </div>

        <div class="bg-bg-surface p-4 rounded-xl border border-border-hairline space-y-1 col-span-2 sm:col-span-1">
          <div class="text-[11px] text-text-muted font-bold uppercase">RF Protocol Jitter</div>
          <div id="stat-jitter-var" class="text-2xl sm:text-3xl font-black text-cyan-400">&plusmn;1.50 ms</div>
          <div class="text-[10px] text-text-secondary font-sans">Variance spread</div>
        </div>
      </div>

      <!-- Multi-Layer Pipeline Breakdown -->
      <div class="space-y-3 bg-bg-surface p-4 rounded-xl border border-border-hairline">
        <div class="text-xs font-bold text-text-primary uppercase tracking-wider">Multi-Layer Pipeline Breakdown (ms)</div>
        
        <div class="space-y-2 text-xs">
          <!-- Codec -->
          <div>
            <div class="flex justify-between text-text-secondary mb-1">
              <span>Wireless Protocol / Codec Transmission:</span>
              <span id="bar-val-codec" class="text-text-primary font-bold">12.00 ms</span>
            </div>
            <div class="bg-bg-elevated rounded-full h-2 overflow-hidden">
              <div id="bar-fill-codec" class="h-2 bg-emerald-400 rounded-full transition-all duration-300" style="width: 30%"></div>
            </div>
          </div>

          <!-- OS Stack -->
          <div>
            <div class="flex justify-between text-text-secondary mb-1">
              <span>OS Audio Subsystem Queue:</span>
              <span id="bar-val-stack" class="text-text-primary font-bold">3.00 ms</span>
            </div>
            <div class="bg-bg-elevated rounded-full h-2 overflow-hidden">
              <div id="bar-fill-stack" class="h-2 bg-cyan-400 rounded-full transition-all duration-300" style="width: 10%"></div>
            </div>
          </div>

          <!-- Buffer Queue -->
          <div>
            <div class="flex justify-between text-text-secondary mb-1">
              <span>Hardware Audio Buffer Queue:</span>
              <span id="bar-val-buffer" class="text-text-primary font-bold">5.33 ms</span>
            </div>
            <div class="bg-bg-elevated rounded-full h-2 overflow-hidden">
              <div id="bar-fill-buffer" class="h-2 bg-blue-400 rounded-full transition-all duration-300" style="width: 15%"></div>
            </div>
          </div>

          <!-- DAC / ANC -->
          <div>
            <div class="flex justify-between text-text-secondary mb-1">
              <span>DAC / Hardware ANC DSP Processing:</span>
              <span id="bar-val-dac" class="text-text-primary font-bold">3.00 ms</span>
            </div>
            <div class="bg-bg-elevated rounded-full h-2 overflow-hidden">
              <div id="bar-fill-dac" class="h-2 bg-purple-400 rounded-full transition-all duration-300" style="width: 10%"></div>
            </div>
          </div>

          <!-- Display Frame Period -->
          <div>
            <div class="flex justify-between text-text-secondary mb-1">
              <span>Display Frame Refresh Period:</span>
              <span id="bar-val-display" class="text-text-primary font-bold">6.94 ms</span>
            </div>
            <div class="bg-bg-elevated rounded-full h-2 overflow-hidden">
              <div id="bar-fill-display" class="h-2 bg-amber-400 rounded-full transition-all duration-300" style="width: 25%"></div>
            </div>
          </div>
        </div>
      </div>

      <!-- Primary Bottleneck Callout & Recommendations -->
      <div class="bg-bg-surface p-4 rounded-xl border border-border-hairline space-y-3">
        <div class="flex items-center gap-2 text-xs font-bold text-amber-400 uppercase tracking-wider">
          <span>⚠️ Primary System Bottleneck:</span>
          <span id="bottleneck-name" class="text-text-primary font-bold underline">Wireless Protocol / Codec Transmission</span>
        </div>
        <div class="space-y-1 text-xs text-text-secondary">
          <div class="font-bold text-text-primary">Optimization Recommendations:</div>
          <ul id="recommendations-list" class="list-disc list-inside space-y-1 text-[11px] text-text-secondary">
            <li>Switch to a 2.4GHz RF USB dongle to eliminate Bluetooth codec latency.</li>
          </ul>
        </div>
      </div>

      <!-- Visual Flash Box -->
      <div id="flash-indicator" class="w-full h-16 rounded-xl border border-border-hairline bg-bg-surface flex items-center justify-center text-text-muted font-bold text-xs transition-all shadow-inner">
        VISUAL SYNC FLASH INDICATOR
      </div>
    </div>
  </div>

  <HardwareLimitationNotice />
  <ErgonomicsNotice />
</div>

<script>
  import { calculateWirelessLatency, type WirelessProtocol, type OsAudioStack, type DisplayRefreshRate } from '../../engine/WirelessLatencyEngine';

  function initWirelessInspector() {
    const protocolSelect = document.getElementById('wl-protocol') as HTMLSelectElement;
    const audioStackSelect = document.getElementById('wl-audio-stack') as HTMLSelectElement;
    const bufferSizeSelect = document.getElementById('wl-buffer-size') as HTMLSelectElement;
    const sampleRateSelect = document.getElementById('wl-sample-rate') as HTMLSelectElement;
    const displayFpsSelect = document.getElementById('wl-display-fps') as HTMLSelectElement;
    const rfInterferenceSelect = document.getElementById('wl-rf-interference') as HTMLSelectElement;
    const ancToggle = document.getElementById('wl-anc-toggle') as HTMLInputElement;

    const triggerBtn = document.getElementById('trigger-audio-btn');
    const esportsBadge = document.getElementById('esports-badge');
    const overallSeverity = document.getElementById('overall-severity');

    const statTotalLatency = document.getElementById('stat-total-latency');
    const statFrameOffset = document.getElementById('stat-frame-offset');
    const statFpsLabel = document.getElementById('stat-fps-label');
    const statJitterVar = document.getElementById('stat-jitter-var');

    const barValCodec = document.getElementById('bar-val-codec');
    const barValStack = document.getElementById('bar-val-stack');
    const barValBuffer = document.getElementById('bar-val-buffer');
    const barValDac = document.getElementById('bar-val-dac');
    const barValDisplay = document.getElementById('bar-val-display');

    const barFillCodec = document.getElementById('bar-fill-codec');
    const barFillStack = document.getElementById('bar-fill-stack');
    const barFillBuffer = document.getElementById('bar-fill-buffer');
    const barFillDac = document.getElementById('bar-fill-dac');
    const barFillDisplay = document.getElementById('bar-fill-display');

    const bottleneckName = document.getElementById('bottleneck-name');
    const recommendationsList = document.getElementById('recommendations-list');
    const flashBox = document.getElementById('flash-indicator');

    if (!protocolSelect || !audioStackSelect || !bufferSizeSelect || !sampleRateSelect || !displayFpsSelect || !rfInterferenceSelect) {
      return;
    }

    function update() {
      if (!protocolSelect) return;

      const input = {
        protocol: protocolSelect.value as WirelessProtocol,
        audioStack: audioStackSelect.value as OsAudioStack,
        bufferSizeSamples: parseInt(bufferSizeSelect.value, 10),
        sampleRateHz: parseInt(sampleRateSelect.value, 10),
        ancEnabled: ancToggle ? ancToggle.checked : false,
        displayFps: parseInt(displayFpsSelect.value, 10) as DisplayRefreshRate,
        rfInterferenceLevel: rfInterferenceSelect.value as 'LOW' | 'MEDIUM' | 'HIGH',
      };

      const result = calculateWirelessLatency(input);
      const b = result.breakdown;

      if (statTotalLatency) statTotalLatency.textContent = `${b.totalSystemicLatencyMs.toFixed(2)} ms`;
      if (statFrameOffset) statFrameOffset.textContent = `${result.lipSync.frameOffsetCount} ${result.lipSync.frameOffsetCount === 1 ? 'Frame' : 'Frames'}`;
      if (statFpsLabel) statFpsLabel.textContent = `@ ${input.displayFps}Hz Refresh`;
      if (statJitterVar) statJitterVar.textContent = `\u00B1${b.jitterVarianceMs.toFixed(2)} ms`;

      if (overallSeverity) {
        overallSeverity.textContent = result.lipSync.severityRating;
        if (result.lipSync.severityRating === 'EXCELLENT') {
          overallSeverity.className = 'text-xs font-mono font-bold text-status-pass';
        } else if (result.lipSync.severityRating === 'GOOD') {
          overallSeverity.className = 'text-xs font-mono font-bold text-cyan-400';
        } else if (result.lipSync.severityRating === 'NOTICEABLE') {
          overallSeverity.className = 'text-xs font-mono font-bold text-amber-400';
        } else {
          overallSeverity.className = 'text-xs font-mono font-bold text-rose-400';
        }
      }

      if (esportsBadge) {
        if (result.lipSync.isEsportsGrade) {
          esportsBadge.textContent = 'ESPORTS GRADE (\u226430ms)';
          esportsBadge.className = 'px-3 py-1 rounded-full bg-status-pass/10 border border-status-pass/30 text-status-pass text-xs font-bold';
        } else {
          esportsBadge.textContent = 'NON-ESPORTS GRADE (>30ms)';
          esportsBadge.className = 'px-3 py-1 rounded-full bg-amber-400/10 border border-amber-400/30 text-amber-400 text-xs font-bold';
        }
      }

      if (barValCodec) barValCodec.textContent = `${b.codecLatencyMs.toFixed(2)} ms`;
      if (barValStack) barValStack.textContent = `${b.stackLatencyMs.toFixed(2)} ms`;
      if (barValBuffer) barValBuffer.textContent = `${b.bufferLatencyMs.toFixed(2)} ms`;
      if (barValDac) barValDac.textContent = `${b.dacLatencyMs.toFixed(2)} ms`;
      if (barValDisplay) barValDisplay.textContent = `${b.displayFramePeriodMs.toFixed(2)} ms`;

      const maxVal = Math.max(b.codecLatencyMs, b.stackLatencyMs, b.bufferLatencyMs, b.dacLatencyMs, b.displayFramePeriodMs, 1);
      if (barFillCodec) barFillCodec.style.width = `${Math.min(100, (b.codecLatencyMs / maxVal) * 100)}%`;
      if (barFillStack) barFillStack.style.width = `${Math.min(100, (b.stackLatencyMs / maxVal) * 100)}%`;
      if (barFillBuffer) barFillBuffer.style.width = `${Math.min(100, (b.bufferLatencyMs / maxVal) * 100)}%`;
      if (barFillDac) barFillDac.style.width = `${Math.min(100, (b.dacLatencyMs / maxVal) * 100)}%`;
      if (barFillDisplay) barFillDisplay.style.width = `${Math.min(100, (b.displayFramePeriodMs / maxVal) * 100)}%`;

      if (bottleneckName) bottleneckName.textContent = result.primaryBottleneck;

      if (recommendationsList) {
        recommendationsList.innerHTML = '';
        result.recommendations.forEach((rec) => {
          const li = document.createElement('li');
          li.textContent = rec;
          recommendationsList.appendChild(li);
        });
      }
    }

    [protocolSelect, audioStackSelect, bufferSizeSelect, sampleRateSelect, displayFpsSelect, rfInterferenceSelect, ancToggle].forEach((el) => {
      el?.addEventListener('change', update);
    });

    triggerBtn?.addEventListener('click', () => {
      const AudioCtx = window.AudioContext || (window as any).webkitAudioContext;
      if (AudioCtx) {
        try {
          const ctx = new AudioCtx();
          const osc = ctx.createOscillator();
          const gain = ctx.createGain();

          osc.type = 'sine';
          osc.frequency.setValueAtTime(880, ctx.currentTime);
          gain.gain.setValueAtTime(0.3, ctx.currentTime);
          gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.08);

          osc.connect(gain);
          gain.connect(ctx.destination);

          osc.start();
          osc.stop(ctx.currentTime + 0.08);
        } catch {
          // Web Audio blocked or unsupported
        }
      }

      if (flashBox) {
        flashBox.style.backgroundColor = '#059669';
        flashBox.style.color = '#ffffff';
        flashBox.textContent = 'FLASH PULSE DISPATCHED!';
        setTimeout(() => {
          flashBox.style.backgroundColor = '';
          flashBox.style.color = '';
          flashBox.textContent = 'VISUAL SYNC FLASH INDICATOR';
        }, 150);
      }
    });

    update();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initWirelessInspector);
  } else {
    initWirelessInspector();
  }
</script>
