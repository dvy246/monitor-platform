---
import SchemaGraph from './SchemaGraph.astro';

export interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  ogImage?: string;
  ogType?: string;
  noindex?: boolean;
  faqs?: Array<{ question: string; answer: string }>;
  schemaItems?: any[];
}

const {
  title,
  description,
  canonicalUrl: customCanonical,
  ogImage = 'https://displaytestonline.com/og-image.png',
  ogType = 'website',
  noindex = false,
  faqs = [],
  schemaItems = [],
} = Astro.props;

// Hreflang: compute alternate URLs for all supported locales
const siteOrigin = 'https://displaytestonline.com';
const supportedLocales = ['en', 'es', 'de', 'fr'] as const;
const pathSegments = Astro.url.pathname.split('/').filter(Boolean);
const currentLocale = supportedLocales.includes(pathSegments[0] as typeof supportedLocales[number]) ? pathSegments[0] : 'en';
const localeSuffix = currentLocale === 'es' ? ' [ES]' : currentLocale === 'de' ? ' [DE]' : currentLocale === 'fr' ? ' [FR]' : '';
const baseTitle = title.includes('Display Test Online') ? title : `${title} | Display Test Online`;
const fullTitle = `${baseTitle}${localeSuffix}`;
const isLocalePrefix = currentLocale !== 'en';
const rawPathSegments = isLocalePrefix ? pathSegments.slice(1) : pathSegments;
const cleanPath = rawPathSegments.length > 0 ? `/${rawPathSegments.join('/')}/` : '/';

// Normalize canonical URL to strictly enforce https://displaytestonline.com + cleanPath
const normalizedCanonical = isLocalePrefix ? `${siteOrigin}/${currentLocale}${cleanPath}` : `${siteOrigin}${cleanPath}`;
const canonicalUrl = customCanonical || normalizedCanonical;

const hreflangs = supportedLocales.map((locale) => ({
  lang: locale,
  href: locale === 'en'
    ? `${siteOrigin}${cleanPath}`
    : `${siteOrigin}/${locale}${cleanPath}`,
}));
---
<meta charset="utf-8" />
<link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="shortcut icon" href="/favicon.ico" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<meta name="apple-mobile-web-app-title" content="displaytest" />
<link rel="manifest" href="/site.webmanifest" />
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
<meta name="theme-color" content="#07080f" />
<meta name="generator" content={Astro.generator} />

{noindex ? (
  <meta name="robots" content="noindex, nofollow" />
) : (
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
)}

<!-- Primary Meta Tags -->
<title>{fullTitle}</title>
<meta name="title" content={fullTitle} />
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl} />

<!-- Hreflang Alternate Links (i18n SEO) -->
{hreflangs.map(({ lang, href }) => (
  <link rel="alternate" hreflang={lang} href={href} />
))}
<link rel="alternate" hreflang="x-default" href={`${siteOrigin}${cleanPath}`} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content="Display Test Online" />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={`${title} - Visual & Mobile Screen Test Diagnostics`} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:site" content="@displaytestonline" />
<meta property="twitter:url" content={canonicalUrl} />
<meta property="twitter:title" content={fullTitle} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={ogImage} />

<!-- Schema Graph -->
<SchemaGraph title={title} description={description} canonicalUrl={canonicalUrl} faqs={faqs} items={schemaItems} />

<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-9VKL34KZJQ"></script>
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', 'G-9VKL34KZJQ');
</script>

