---
import SchemaGraph from './SchemaGraph.astro';

export interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  ogImage?: string;
  ogType?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  canonicalUrl = Astro.url.href,
  ogImage = 'https://monitortesthub.com/og-image.png',
  ogType = 'website',
  noindex = false,
} = Astro.props;

// Hreflang: compute alternate URLs for all supported locales
const siteOrigin = 'https://monitortesthub.com';
const supportedLocales = ['en', 'es', 'de', 'fr'] as const;
const pathSegments = Astro.url.pathname.split('/').filter(Boolean);
// Strip any existing locale prefix from the path
const isLocalePrefix = supportedLocales.includes(pathSegments[0] as typeof supportedLocales[number]);
const basePath = isLocalePrefix ? '/' + pathSegments.slice(1).join('/') : Astro.url.pathname;
const cleanBasePath = basePath === '/' ? '' : basePath;

const hreflangs = supportedLocales.map((locale) => ({
  lang: locale,
  href: locale === 'en'
    ? `${siteOrigin}${cleanBasePath || '/'}`
    : `${siteOrigin}/${locale}${cleanBasePath || '/'}`,
}));
---
<meta charset="utf-8" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" />
<link rel="manifest" href="/manifest.webmanifest" />
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
<meta name="theme-color" content="#08080a" />
<meta name="generator" content={Astro.generator} />

{noindex ? (
  <meta name="robots" content="noindex, nofollow" />
) : (
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
)}

<!-- Primary Meta Tags -->
<title>{title} | Monitor Test Hub</title>
<meta name="title" content={`${title} | Monitor Test Hub`} />
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl} />

<!-- Hreflang Alternate Links (i18n SEO) -->
{hreflangs.map(({ lang, href }) => (
  <link rel="alternate" hreflang={lang} href={href} />
))}
<link rel="alternate" hreflang="x-default" href={`${siteOrigin}${cleanBasePath || '/'}`} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content="Monitor Test Hub" />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={`${title} | Monitor Test Hub`} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={`${title} - Visual & Mobile Screen Test Diagnostics`} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:site" content="@monitortesthub" />
<meta property="twitter:url" content={canonicalUrl} />
<meta property="twitter:title" content={`${title} | Monitor Test Hub`} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={ogImage} />

<!-- Schema Graph -->
<SchemaGraph title={title} description={description} canonicalUrl={canonicalUrl} />

