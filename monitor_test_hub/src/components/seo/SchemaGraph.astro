---
export interface Props {
  title: string;
  description: string;
  canonicalUrl: string;
}
const { title, description, canonicalUrl } = Astro.props;

// Dynamically generate BreadcrumbList items from canonical URL path
const urlObj = new URL(canonicalUrl);
const pathSegments = urlObj.pathname.split('/').filter(Boolean);
const breadcrumbItems = [
  {
    "@type": "ListItem",
    "position": 1,
    "name": "Home",
    "item": "https://monitortesthub.com"
  }
];

let currentPath = "https://monitortesthub.com";
pathSegments.forEach((segment, index) => {
  currentPath += `/${segment}`;
  const formattedName = segment
    .split('-')
    .map(word => word.charAt(0).toUpperCase() + word.slice(1))
    .join(' ');
  breadcrumbItems.push({
    "@type": "ListItem",
    "position": index + 2,
    "name": formattedName,
    "item": currentPath
  });
});

const schemaGraph = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://monitortesthub.com/#organization",
      "name": "Monitor Test Hub",
      "url": "https://monitortesthub.com",
      "logo": "https://monitortesthub.com/favicon.svg",
      "sameAs": [
        "https://github.com/monitortesthub",
        "https://twitter.com/monitortesthub"
      ]
    },
    {
      "@type": "WebSite",
      "@id": "https://monitortesthub.com/#website",
      "url": "https://monitortesthub.com",
      "name": "Monitor Test Hub",
      "description": "Unified Web-Native Display Calibration, OLED Burn-In, 540Hz VRR, and Mobile Touch Matrix Diagnostic Suite",
      "publisher": {
        "@id": "https://monitortesthub.com/#organization"
      },
      "potentialAction": {
        "@type": "SearchAction",
        "target": {
          "@type": "EntryPoint",
          "urlTemplate": "https://monitortesthub.com/display-tests/?q={search_term_string}"
        },
        "query-input": "required name=search_term_string"
      }
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${canonicalUrl}#breadcrumb`,
      "itemListElement": breadcrumbItems
    },
    {
      "@type": "WebApplication",
      "@id": `${canonicalUrl}#webapp`,
      "name": title,
      "url": canonicalUrl,
      "applicationCategory": "DeveloperApplication",
      "operatingSystem": "All (Android, iOS, Windows, macOS, Linux)",
      "browserRequirements": "Requires HTML5 WebGL 2.0, PointerEvents, and Canvas support",
      "about": {
        "@type": "Thing",
        "name": "Display Calibration, Mobile Touch Digitizer, and Hardware Testing",
        "sameAs": [
          "https://en.wikipedia.org/wiki/Display_calibration",
          "https://www.wikidata.org/wiki/Q1156824"
        ]
      }
    },
    {
      "@type": "TechArticle",
      "@id": `${canonicalUrl}#article`,
      "headline": title,
      "description": description,
      "inLanguage": "en-US",
      "author": {
        "@type": "Organization",
        "name": "Monitor Test Hub Engineering Team",
        "url": "https://monitortesthub.com/about"
      },
      "publisher": {
        "@id": "https://monitortesthub.com/#organization"
      },
      "datePublished": "2026-07-22T00:00:00Z",
      "dateModified": "2026-07-22T00:00:00Z",
      "about": [
        { "@type": "Thing", "name": "Touchscreen", "sameAs": "https://en.wikipedia.org/wiki/Touchscreen" },
        { "@type": "Thing", "name": "OLED", "sameAs": "https://en.wikipedia.org/wiki/OLED" }
      ],
      "medicalAudience": {
        "@type": "MedicalAudience",
        "audienceType": "None - Non-Medical Hardware Diagnostic Tool"
      }
    }
  ]
};
---
<script type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

