---
export interface FAQItem {
  question: string;
  answer: string;
}

export interface Props {
  title: string;
  description: string;
  canonicalUrl: string;
  faqs?: FAQItem[];
  authorName?: string;
  authorUrl?: string;
  applicationCategory?: string;
  items?: any[];
}

const {
  title,
  description,
  canonicalUrl,
  faqs = [],
  authorName = "Monitor Test Hub Engineering Team",
  authorUrl = "https://displaytestonline.com/about",
  applicationCategory = "DeveloperApplication",
  items = []
} = Astro.props;

// Dynamically generate BreadcrumbList items from canonical URL path
const baseUrl = "https://displaytestonline.com";
const urlObj = new URL(canonicalUrl || "/", baseUrl);
const fullCanonicalUrl = urlObj.href;
const pathSegments = urlObj.pathname.split('/').filter(Boolean);
const breadcrumbItems = [
  {
    "@type": "ListItem",
    "position": 1,
    "name": "Home",
    "item": "https://displaytestonline.com"
  }
];

let currentPath = "";
pathSegments.forEach((segment, index) => {
  currentPath += `/${segment}`;
  let cleanLabel = segment.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase());
  if (segment === 'es') cleanLabel = 'Español';
  else if (segment === 'de') cleanLabel = 'Deutsch';
  else if (segment === 'fr') cleanLabel = 'Français';
  breadcrumbItems.push({
    "@type": "ListItem",
    "position": index + 2,
    "name": cleanLabel,
    "item": `https://displaytestonline.com${currentPath}`
  });
});

const graphNodes: any[] = [
  {
    "@type": "Organization",
    "@id": "https://displaytestonline.com/#organization",
    "name": "Monitor Test Hub",
    "url": "https://displaytestonline.com",
    "logo": {
      "@type": "ImageObject",
      "url": "https://displaytestonline.com/favicon.svg",
      "width": 512,
      "height": 512
    },
    "sameAs": [
      "https://github.com/dvy246/monitor-platform",
      "https://twitter.com/monitortesthub"
    ]
  },
  {
    "@type": "Person",
    "@id": `${authorUrl}#author`,
    "name": authorName,
    "url": authorUrl,
    "worksFor": {
      "@id": "https://displaytestonline.com/#organization"
    }
  },
  {
    "@type": "WebSite",
    "@id": "https://displaytestonline.com/#website",
    "url": "https://displaytestonline.com",
    "name": "Monitor Test Hub",
    "description": "Unified Web-Native Display Calibration, OLED Burn-In, 540Hz VRR, and Mobile Touch Matrix Diagnostic Suite",
    "publisher": {
      "@id": "https://displaytestonline.com/#organization"
    },
    "potentialAction": {
      "@type": "SearchAction",
      "target": {
        "@type": "EntryPoint",
        "urlTemplate": "https://displaytestonline.com/display-tests/?q={search_term_string}"
      },
      "query-input": "required name=search_term_string"
    }
  },
  {
    "@type": "BreadcrumbList",
    "@id": `${fullCanonicalUrl}#breadcrumb`,
    "itemListElement": breadcrumbItems
  }
];

const isNonToolPage = canonicalUrl.includes('/privacy') || canonicalUrl.includes('/terms') || canonicalUrl.includes('/contact') || canonicalUrl.includes('/about') || canonicalUrl.includes('/404');

if (!isNonToolPage) {
  graphNodes.push({
    "@type": ["WebApplication", "SoftwareApplication"],
    "@id": `${fullCanonicalUrl}#webapp`,
    "name": title,
    "url": fullCanonicalUrl,
    "applicationCategory": applicationCategory,
    "operatingSystem": "All (Android, iOS, Windows, macOS, Linux, ChromeOS)",
    "browserRequirements": "Requires HTML5 WebGL 2.0, PointerEvents, and Canvas support",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    },
    "author": {
      "@id": `${authorUrl}#author`
    },
    "publisher": {
      "@id": "https://displaytestonline.com/#organization"
    },
    "about": {
      "@type": "Thing",
      "name": "Display Calibration, Mobile Touch Digitizer, and Hardware Testing",
      "sameAs": [
        "https://en.wikipedia.org/wiki/Display_calibration",
        "https://www.wikidata.org/wiki/Q1156824"
      ]
    }
  });
}

graphNodes.push({
  "@type": "TechArticle",
  "@id": `${fullCanonicalUrl}#article`,
  "headline": title,
  "description": description,
  "inLanguage": "en-US",
  "author": {
    "@id": `${authorUrl}#author`
  },
  "publisher": {
    "@id": "https://displaytestonline.com/#organization"
  },
  "datePublished": "2026-07-22T00:00:00Z",
  "dateModified": "2026-07-22T00:00:00Z",
  "about": [
    { "@type": "Thing", "name": "Touchscreen", "sameAs": "https://en.wikipedia.org/wiki/Touchscreen" },
    { "@type": "Thing", "name": "OLED", "sameAs": "https://en.wikipedia.org/wiki/OLED" },
    { "@type": "Thing", "name": "Display Calibration", "sameAs": "https://en.wikipedia.org/wiki/Display_calibration" }
  ]
});

if (items && items.length > 0) {
  graphNodes.push(...items);
}

if (faqs && faqs.length > 0) {
  graphNodes.push({
    "@type": "FAQPage",
    "@id": `${fullCanonicalUrl}#faq`,
    "mainEntity": faqs.map(faq => ({
      "@type": "Question",
      "name": faq.question,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": faq.answer
      }
    }))
  });
}

const schemaGraph = {
  "@context": "https://schema.org",
  "@graph": graphNodes
};
---
<script type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

