---
export interface BreadcrumbItem {
  label: string;
  href?: string;
}

export interface Props {
  items: BreadcrumbItem[];
  class?: string;
}

const { items, class: className = '' } = Astro.props;
---

<nav aria-label="Breadcrumb navigation" class:list={["font-mono text-xs text-text-secondary py-2", className]}>
  <ol class="flex items-center gap-2 flex-wrap">
    <li>
      <a href="/" class="hover:text-text-primary transition-colors flex items-center gap-1">
        <span>HUB</span>
      </a>
    </li>
    {items.map((item, index) => (
      <li class="flex items-center gap-2">
        <span class="text-text-muted font-bold">/</span>
        {item.href && index < items.length - 1 ? (
          <a href={item.href} class="hover:text-text-primary transition-colors">
            {item.label}
          </a>
        ) : (
          <span class="text-text-primary font-semibold" aria-current="page">
            {item.label}
          </span>
        )}
      </li>
    ))}
  </ol>
</nav>
