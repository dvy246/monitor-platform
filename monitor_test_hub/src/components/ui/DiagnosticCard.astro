---
export interface Props {
  title: string;
  description: string;
  href: string;
  badge?: string;
  category?: string;
  icon?: string;
}

const { title, description, href, badge, category = "DIAGNOSTIC", icon } = Astro.props;
---

<div class="rounded-xl border border-border-hairline bg-bg-surface p-6 flex flex-col justify-between space-y-6 shadow-specular-top hover:border-border-interactive transition-all duration-200 group">
  <div class="space-y-4">
    <div class="font-mono text-xs text-text-muted uppercase tracking-wider flex items-center justify-between">
      <span>[ {category} ]</span>
      {badge && (
        <span class="px-2 py-0.5 rounded-sm text-[10px] font-mono font-bold bg-bg-elevated border border-border-hairline text-status-pass">
          {badge}
        </span>
      )}
    </div>
    
    <div class="flex items-start gap-3">
      {icon && (
        <div class="w-8 h-8 rounded-lg bg-bg-elevated border border-border-subtle flex items-center justify-center shrink-0 text-status-pass">
          <Fragment set:html={icon} />
        </div>
      )}
      <div class="space-y-1">
        <h3 class="text-base font-bold text-text-primary group-hover:text-status-pass transition-colors font-sans">
          {title}
        </h3>
        <p class="text-xs text-text-secondary leading-relaxed font-sans">
          {description}
        </p>
      </div>
    </div>
  </div>

  <a href={href} class="pt-4 border-t border-border-hairline font-mono text-xs text-text-primary font-bold flex items-center justify-between hover:text-status-pass transition-colors">
    <span>LAUNCH TEST</span>
    <span class="group-hover:translate-x-1 transition-transform duration-200">&rarr;</span>
  </a>
</div>
