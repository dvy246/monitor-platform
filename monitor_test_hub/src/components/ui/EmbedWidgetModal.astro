---
export interface Props {
  widgetTitle?: string;
  embedUrl?: string;
}

const { 
  widgetTitle = 'VRR Stutter & Tear Test',
  embedUrl = 'https://monitortester.com/embed/vrr-stutter'
} = Astro.props;

const iframeSnippet = `<iframe src="${embedUrl}" width="100%" height="450" frameborder="0" loading="lazy" style="border-radius: 12px; border: 1px solid rgba(255,255,255,0.1);" title="${widgetTitle} Widget"></iframe>\n<p style="font-size: 11px; text-align: right;"><a href="https://monitortester.com" target="_blank" rel="noopener">Powered by Monitor Test Hub</a></p>`;
---

<!-- Embed Widget Modal -->
<div 
  id="embed-widget-modal" 
  role="dialog" 
  aria-modal="true" 
  aria-label="Embed Diagnostic Widget"
  class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 sm:p-6"
  style="background: rgba(0,0,0,0.85); backdrop-filter: blur(8px);"
>
  <div class="w-full max-w-xl bg-bg-surface border border-border-hairline rounded-2xl shadow-2xl font-mono overflow-hidden flex flex-col">
    <!-- Header -->
    <div class="flex items-center justify-between px-6 py-4 border-b border-border-hairline bg-bg-elevated">
      <div class="flex items-center gap-2.5">
        <span class="w-2.5 h-2.5 rounded-full bg-status-pass led-glow-pass"></span>
        <div>
          <h3 class="text-sm font-bold text-text-primary uppercase tracking-wider">EMBED DIAGNOSTIC WIDGET</h3>
          <p class="text-[10px] text-text-muted">EMBED LIVE TEST ON YOUR BLOG OR REVIEW SITE</p>
        </div>
      </div>
      <button 
        id="embed-modal-close" 
        class="px-2.5 py-1 text-xs rounded border border-border-hairline text-text-muted hover:text-text-primary hover:bg-bg-canvas transition-colors cursor-pointer"
      >
        ESC
      </button>
    </div>

    <!-- Body -->
    <div class="p-6 space-y-5 text-xs">
      <p class="text-text-secondary font-sans leading-relaxed text-xs">
        Paste this lightweight, responsive HTML iframe snippet into your website, tech blog, or review post. It runs the 540Hz+ hardware diagnostic live inside your article with automatic attribution.
      </p>

      <div class="space-y-2">
        <label for="embed-code-textarea" class="text-[10px] font-bold text-text-muted uppercase tracking-wider block">
          HTML IFRAME EMBED CODE
        </label>
        <textarea 
          id="embed-code-textarea" 
          readonly 
          rows="5"
          class="w-full bg-bg-canvas border border-border-hairline rounded-xl p-3 text-[11px] font-mono text-status-pass outline-none select-all"
        >{iframeSnippet}</textarea>
      </div>

      <div class="bg-bg-canvas p-3 rounded-lg border border-border-hairline flex items-center justify-between text-[11px]">
        <span class="text-text-muted">Preview Dimensions:</span>
        <span class="font-bold text-text-primary">Responsive 100% Width &times; 450px</span>
      </div>
    </div>

    <!-- Footer -->
    <div class="px-6 py-4 border-t border-border-hairline bg-bg-elevated flex items-center justify-between">
      <span class="text-[10px] text-text-muted">Includes Backlink Attribution</span>
      <button 
        id="btn-copy-embed-code" 
        class="px-5 py-2 rounded-lg bg-status-pass text-bg-canvas font-bold text-xs hover:opacity-90 transition-opacity cursor-pointer flex items-center gap-1.5"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
        <span id="copy-btn-text">COPY EMBED CODE</span>
      </button>
    </div>
  </div>
</div>

<script>
  function initEmbedModal() {
    const modal = document.getElementById('embed-widget-modal');
    const closeBtn = document.getElementById('embed-modal-close');
    const copyBtn = document.getElementById('btn-copy-embed-code');
    const copyBtnText = document.getElementById('copy-btn-text');
    const textarea = document.getElementById('embed-code-textarea') as HTMLTextAreaElement | null;

    closeBtn?.addEventListener('click', () => {
      modal?.classList.add('hidden');
    });

    copyBtn?.addEventListener('click', () => {
      if (textarea) {
        textarea.select();
        navigator.clipboard.writeText(textarea.value).then(() => {
          if (copyBtnText) copyBtnText.textContent = 'COPIED TO CLIPBOARD!';
          setTimeout(() => {
            if (copyBtnText) copyBtnText.textContent = 'COPY EMBED CODE';
          }, 2500);
        }).catch(() => {});
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
        modal.classList.add('hidden');
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initEmbedModal);
  } else {
    initEmbedModal();
  }
</script>
