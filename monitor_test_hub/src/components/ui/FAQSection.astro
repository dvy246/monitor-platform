---
export interface FAQItem {
  question?: string;
  answer?: string;
  q?: string;
  a?: string;
}

export interface Props {
  faqs: FAQItem[];
  title?: string;
  subtitle?: string;
}

const { 
  faqs = [], 
  title = "Frequently Asked Questions", 
  subtitle = "Everything you need to know about this diagnostic instrument, calibration procedures, and display technical standards." 
} = Astro.props;

const normalizedFaqs = faqs.map(item => ({
  question: item.question || item.q || '',
  answer: item.answer || item.a || ''
})).filter(item => item.question && item.answer);
---

{normalizedFaqs.length > 0 && (
  <section aria-labelledby="faq-section-title" class="space-y-6 pt-6" style="border-top: 1px solid rgba(77,159,255,0.10)">
    <div class="space-y-2">
      <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-full bg-[rgba(77,159,255,0.06)] border border-[rgba(77,159,255,0.20)] text-status-info text-[11px] font-mono font-bold uppercase tracking-wider">
        <svg class="w-3.5 h-3.5 text-status-info shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span>Technical FAQs &amp; Helpful Content</span>
      </div>
      <h2 id="faq-section-title" class="text-2xl sm:text-3xl font-extrabold text-text-primary tracking-tight heading-brand">
        {title}
      </h2>
      <p class="text-sm text-text-secondary max-w-3xl font-sans">
        {subtitle}
      </p>
    </div>

    <div class="grid grid-cols-1 gap-3 font-sans">
      {normalizedFaqs.map(({ question, answer }, index) => (
        <details class="group bg-bg-surface rounded-2xl overflow-hidden transition-all duration-200 hover:border-[rgba(77,159,255,0.25)] shadow-specular-top" style={`border: 1px solid rgba(77,159,255,${index === 0 ? '0.16' : '0.08'})`} open={index === 0}>
          <summary class="flex items-center justify-between p-5 cursor-pointer font-mono text-sm font-bold text-text-primary hover:text-status-pass select-none transition-colors min-w-0">
            <span class="flex items-center gap-3 min-w-0">
              <span class="text-xs font-mono text-status-pass/60 font-bold shrink-0 tabular-nums">{String(index + 1).padStart(2, '0')}.</span>
              <span class="break-words min-w-0 font-sans text-[13px] font-semibold">{question}</span>
            </span>
            <span class="ml-4 shrink-0 text-text-muted group-hover:text-status-pass group-open:rotate-180 transition-transform duration-200">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </span>
          </summary>
          <div class="px-5 pb-5 pt-1 text-xs sm:text-sm text-text-secondary leading-relaxed font-sans" style="border-top: 1px solid rgba(77,159,255,0.08)">
            {answer}
          </div>
        </details>
      ))}
    </div>

    <!-- Master Guide Banner -->
    <div class="rounded-2xl p-4 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 text-xs font-mono" style="background: rgba(0,229,160,0.03); border: 1px solid rgba(0,229,160,0.15)">
      <div class="flex items-center gap-2 text-text-secondary">
        <span class="w-1.5 h-1.5 rounded-full bg-status-pass led-glow-pass"></span>
        <span>Not sure which test to run next? Need troubleshooting advice?</span>
      </div>
      <a href="/display-testing-guide" class="text-status-pass font-bold hover:underline shrink-0 hover:text-[#00ffa8] transition-colors">
        Read Complete Diagnostic Guide &rarr;
      </a>
    </div>
  </section>
)}
