---
export interface Props {
  testId: string;
  testTitle: string;
  steps: string[];
  fullscreenButtonId?: string;
  fullscreenContainerId?: string;
}

const {
  testId,
  testTitle,
  steps = [],
  fullscreenButtonId = 'btn-launch-fullscreen',
  fullscreenContainerId = '',
} = Astro.props;
---

<!-- Reusable Diagnostic Quick Guide & Fullscreen Launcher Modal -->
<div 
  id={`guide-modal-${testId}`}
  class="fixed inset-0 z-50 hidden flex items-center justify-center p-4 bg-black/80 backdrop-blur-md select-none font-mono text-xs"
  role="dialog"
  aria-modal="true"
  aria-labelledby={`guide-modal-title-${testId}`}
>
  <div class="bg-bg-surface border border-border-hairline rounded-2xl max-w-lg w-full p-6 space-y-6 shadow-2xl relative overflow-hidden">
    <!-- Header -->
    <div class="flex items-start justify-between border-b border-border-hairline pb-4">
      <div>
        <div class="text-[10px] font-bold text-status-pass uppercase tracking-widest flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-status-pass led-glow-pass animate-pulse"></span>
          <span>QUICK START TEST GUIDE</span>
        </div>
        <h2 id={`guide-modal-title-${testId}`} class="text-lg font-extrabold text-text-primary mt-1">
          {testTitle}
        </h2>
      </div>
      <button 
        type="button" 
        class="btn-close-guide text-text-muted hover:text-text-primary transition-colors text-lg p-1"
        aria-label="Close Quick Guide"
      >
        ✕
      </button>
    </div>

    <!-- Step-by-Step Instructions List -->
    <div class="space-y-3 font-sans text-xs text-text-secondary">
      <div class="font-mono text-[11px] font-bold text-text-primary uppercase tracking-wider">
        How to perform this test:
      </div>
      <ol class="space-y-2 text-text-secondary leading-relaxed list-decimal list-inside bg-bg-canvas p-3.5 rounded-xl border border-border-hairline">
        {steps.map((step) => (
          <li class="pl-1"><span class="text-text-primary font-medium">{step}</span></li>
        ))}
      </ol>
      <p class="text-[10px] text-text-muted italic pt-1">
        * Note: Fullscreen mode will only activate when you explicitly click "Start Fullscreen Test". You can press ESC at any time to exit.
      </p>
    </div>

    <!-- Actions & Skip Checkbox -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-3 border-t border-border-hairline pt-4 font-mono">
      <label class="flex items-center gap-2 text-[11px] text-text-muted cursor-pointer hover:text-text-secondary transition-colors">
        <input type="checkbox" id={`chk-dont-show-${testId}`} class="rounded bg-bg-canvas border-border-hairline text-status-pass focus:ring-status-pass cursor-pointer">
        <span>Don't show guide automatically</span>
      </label>

      <div class="flex gap-2 w-full sm:w-auto">
        <button 
          type="button" 
          class="btn-skip-guide px-3.5 py-2 rounded-lg bg-bg-canvas border border-border-hairline text-text-secondary hover:text-text-primary hover:border-border-interactive transition-all cursor-pointer font-bold text-[11px] flex-1 sm:flex-initial"
        >
          Skip &amp; Continue
        </button>

        <button 
          type="button" 
          id={`btn-guide-start-fullscreen-${testId}`}
          class="px-4 py-2 rounded-lg bg-status-pass text-bg-canvas font-bold text-[11px] hover:opacity-90 transition-opacity cursor-pointer shadow-specular-top flex items-center justify-center gap-1.5 flex-1 sm:flex-initial"
        >
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"/></svg>
          START FULLSCREEN TEST
        </button>
      </div>
    </div>
  </div>
</div>

<script define:vars={{ testId, fullscreenButtonId, fullscreenContainerId }}>
  function setupGuideModal() {
    const modal = document.getElementById(`guide-modal-${testId}`);
    const chkDontShow = document.getElementById(`chk-dont-show-${testId}`);
    const btnCloseList = modal?.querySelectorAll('.btn-close-guide');
    const btnSkipList = modal?.querySelectorAll('.btn-skip-guide');
    const btnStartFullscreen = document.getElementById(`btn-guide-start-fullscreen-${testId}`);
    const storageKey = `mth_guide_skip_${testId}`;

    let activeEl: HTMLElement | null = null;

    function showModal() {
      activeEl = document.activeElement as HTMLElement;
      if (modal) {
        modal.classList.remove('hidden');
        document.body.classList.add('overflow-hidden');
        btnStartFullscreen?.focus();
      }
    }

    function hideModal() {
      if (chkDontShow && chkDontShow.checked) {
        localStorage.setItem(storageKey, 'true');
      }
      if (modal) {
        modal.classList.add('hidden');
        document.body.classList.remove('overflow-hidden');
        if (activeEl) activeEl.focus();
      }
    }

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
        hideModal();
      }
    });

    // Auto-show guide on page load if user hasn't opted to skip it
    if (!localStorage.getItem(storageKey)) {
      showModal();
    }

    btnCloseList?.forEach(btn => btn.addEventListener('click', hideModal));
    btnSkipList?.forEach(btn => btn.addEventListener('click', hideModal));

    // Explicit Fullscreen Button trigger
    btnStartFullscreen?.addEventListener('click', () => {
      hideModal();

      // Trigger target element or target button's fullscreen handler explicitly
      if (fullscreenContainerId) {
        const container = document.getElementById(fullscreenContainerId);
        if (container && container.requestFullscreen) {
          container.requestFullscreen().catch(() => {});
        }
      } else if (fullscreenButtonId) {
        const targetBtn = document.getElementById(fullscreenButtonId);
        if (targetBtn) {
          targetBtn.click();
        }
      }
    });

    // Make guide accessible to external launcher buttons (e.g. "How to Test" buttons)
    window[`openGuide_${testId}`] = showModal;
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupGuideModal);
  } else {
    setupGuideModal();
  }
</script>
