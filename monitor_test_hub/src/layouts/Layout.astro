                <li><a href={localizeLink("/arcade", lang)} class="hover:text-text-primary transition-colors">{t.arcadeSuite}</a></li>
              </ul>
            </div>
            <div class="space-y-2">
              <h3 class="text-text-primary font-bold uppercase tracking-wider text-[10px]">Resources</h3>
              <ul class="space-y-1.5">
                <li><a href={localizeLink("/screen-test-meaning", lang)} class="hover:text-text-primary transition-colors">Semantic Glossary</a></li>
                <li><a href={localizeLink("/about", lang)} class="hover:text-text-primary transition-colors">About Us</a></li>
                <li><a href={localizeLink("/contact", lang)} class="hover:text-text-primary transition-colors">Contact Us</a></li>
