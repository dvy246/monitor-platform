    <!-- Interactive Navigation Scripts -->
    <script>

      // Interactive Theme Slider Switch Logic
      const darkBtn = document.getElementById('theme-slider-dark');
      const lightBtn = document.getElementById('theme-slider-light');
      const pill = document.getElementById('theme-slider-pill');

      function updateThemeUI(isLight: boolean) {
        if (isLight) {
          document.documentElement.classList.add('light');
          localStorage.setItem('theme', 'light');
          if (pill) pill.style.transform = 'translateX(100%)';
          if (darkBtn) {
            darkBtn.className = 'relative z-10 px-2 py-1 rounded-full flex items-center gap-1 cursor-pointer transition-colors text-text-muted hover:text-text-primary';
            darkBtn.setAttribute('aria-pressed', 'false');
          }
          if (lightBtn) {
            lightBtn.className = 'relative z-10 px-2 py-1 rounded-full flex items-center gap-1 cursor-pointer transition-colors text-text-primary font-bold';
            lightBtn.setAttribute('aria-pressed', 'true');
          }
        } else {
          document.documentElement.classList.remove('light');
          localStorage.setItem('theme', 'dark');
          if (pill) pill.style.transform = 'translateX(0%)';
          if (darkBtn) {
            darkBtn.className = 'relative z-10 px-2 py-1 rounded-full flex items-center gap-1 cursor-pointer transition-colors text-text-primary font-bold';
            darkBtn.setAttribute('aria-pressed', 'true');
          }
          if (lightBtn) {
            lightBtn.className = 'relative z-10 px-2 py-1 rounded-full flex items-center gap-1 cursor-pointer transition-colors text-text-muted hover:text-text-primary';
            lightBtn.setAttribute('aria-pressed', 'false');
          }
        }
        window.dispatchEvent(new CustomEvent('themechange', { detail: { theme: isLight ? 'light' : 'dark' } }));
      }

      const initialIsLight = document.documentElement.classList.contains('light');
      updateThemeUI(initialIsLight);

      if (darkBtn) darkBtn.addEventListener('click', () => updateThemeUI(false));
      if (lightBtn) lightBtn.addEventListener('click', () => updateThemeUI(true));
      const mobDarkBtn = document.getElementById('mobile-theme-dark');
      const mobLightBtn = document.getElementById('mobile-theme-light');
      if (mobDarkBtn) mobDarkBtn.addEventListener('click', () => updateThemeUI(false));
      if (mobLightBtn) mobLightBtn.addEventListener('click', () => updateThemeUI(true));

      function handleLangChange(selectedLang: string) {
        const currentPath = window.location.pathname;
        const segments = currentPath.split('/').filter(Boolean);
        const currentPrefix = segments[0];
        const supportedLocales = ['es', 'de', 'fr'];
        if (supportedLocales.includes(currentPrefix)) {
          segments.shift();
        }
        let newPath = '/' + segments.join('/');
        if (selectedLang !== 'en') {
          newPath = '/' + selectedLang + newPath;
        }
        newPath = newPath.replace(/\/+/g, '/');
        if (!newPath.startsWith('/')) newPath = '/' + newPath;
        window.location.pathname = newPath;
      }

      const langSelector = document.getElementById('lang-selector') as HTMLSelectElement;
      if (langSelector) {
        langSelector.addEventListener('change', () => handleLangChange(langSelector.value));
      }
      const mobLangSelector = document.getElementById('mobile-lang-selector') as HTMLSelectElement;
      if (mobLangSelector) {
        mobLangSelector.addEventListener('change', () => handleLangChange(mobLangSelector.value));
      }

      // Command Palette Search Modal Logic
      const searchTrigger = document.getElementById('search-trigger');
      const searchModal = document.getElementById('search-modal');
      const searchInput = document.getElementById('search-input') as HTMLInputElement | null;
      const searchCloseBtn = document.getElementById('search-close-btn');
      const searchItems = Array.from(document.querySelectorAll('.search-item')) as HTMLAnchorElement[];
      const searchNoResults = document.getElementById('search-no-results');
      const searchMatchCount = document.getElementById('search-match-count');
      let selectedSearchIndex = -1;

      function updateSearchSelection() {
        const visibleItems = searchItems.filter(item => item.style.display !== 'none');
        visibleItems.forEach((item, idx) => {
          if (idx === selectedSearchIndex) {
            item.classList.add('bg-bg-elevated', 'text-text-primary');
            item.scrollIntoView({ block: 'nearest' });
          } else {
            item.classList.remove('bg-bg-elevated', 'text-text-primary');
          }
        });
      }

      function openSearch() {
        searchModal?.classList.remove('hidden');
        searchInput?.focus();
        selectedSearchIndex = -1;
        searchItems.forEach(item => { item.style.display = ''; item.classList.remove('bg-bg-elevated'); });
        if (searchNoResults) searchNoResults.classList.add('hidden');
        if (searchMatchCount) searchMatchCount.textContent = `${searchItems.length} Instruments`;
      }

      function closeSearch() {
        searchModal?.classList.add('hidden');
        if (searchInput) searchInput.value = '';
        selectedSearchIndex = -1;
        searchItems.forEach(item => { item.style.display = ''; item.classList.remove('bg-bg-elevated'); });
        if (searchNoResults) searchNoResults.classList.add('hidden');
      }

      searchTrigger?.addEventListener('click', openSearch);
      searchCloseBtn?.addEventListener('click', closeSearch);

      searchModal?.addEventListener('click', (e) => {
        if (e.target === searchModal) closeSearch();
      });

      searchInput?.addEventListener('input', () => {
        const query = searchInput.value.toLowerCase().trim();
        let matchCount = 0;
        selectedSearchIndex = -1;

        searchItems.forEach(item => {
          const text = item.textContent?.toLowerCase() || '';
          const keywords = item.getAttribute('data-keywords')?.toLowerCase() || '';
          const href = item.getAttribute('href')?.toLowerCase() || '';
          const isMatch = query === '' || text.includes(query) || keywords.includes(query) || href.includes(query);
          
          item.style.display = isMatch ? '' : 'none';
          item.classList.remove('bg-bg-elevated');
          if (isMatch) matchCount++;
        });

        if (searchNoResults) {
          if (matchCount === 0) {
            searchNoResults.classList.remove('hidden');
          } else {
            searchNoResults.classList.add('hidden');
          }
        }

        if (searchMatchCount) {
          searchMatchCount.textContent = query === '' ? `${searchItems.length} Instruments` : `${matchCount} / ${searchItems.length} Matches`;
        }
      });

      searchInput?.addEventListener('keydown', (e: KeyboardEvent) => {
        const visibleItems = searchItems.filter(item => item.style.display !== 'none');
        if (visibleItems.length === 0) return;

        if (e.key === 'ArrowDown') {
          e.preventDefault();
          selectedSearchIndex = (selectedSearchIndex + 1) % visibleItems.length;
          updateSearchSelection();
        } else if (e.key === 'ArrowUp') {
          e.preventDefault();
          selectedSearchIndex = (selectedSearchIndex - 1 + visibleItems.length) % visibleItems.length;
          updateSearchSelection();
        } else if (e.key === 'Enter') {
          e.preventDefault();
          const targetItem = selectedSearchIndex >= 0 && selectedSearchIndex < visibleItems.length ? visibleItems[selectedSearchIndex] : visibleItems[0];
          if (targetItem) {
            window.location.href = targetItem.href;
            closeSearch();
          }
        }
      });

      // Global Fullscreen API Handler
      (window as any).toggleGlobalFullscreen = function() {
        if (!document.fullscreenElement) {
          if (document.documentElement.requestFullscreen) {
            document.documentElement.requestFullscreen().catch(() => {});
          } else if ((document.documentElement as any).webkitRequestFullscreen) {
            (document.documentElement as any).webkitRequestFullscreen();
          }
        } else {
          if (document.exitFullscreen) {
            document.exitFullscreen().catch(() => {});
          } else if ((document as any).webkitExitFullscreen) {
            (document as any).webkitExitFullscreen();
          }
        }
      };

      // Mobile Drawer Toggle Handler
      const mobileMenuToggle = document.getElementById('mobile-menu-toggle');
      const mobileMenu = document.getElementById('mobile-menu');

      function openMobileMenu() {
        if (mobileMenu && mobileMenuToggle) {
          mobileMenu.classList.remove('hidden');
          mobileMenuToggle.setAttribute('aria-expanded', 'true');
          document.body.style.overflow = 'hidden';
        }
      }

      function closeMobileMenu() {
        if (mobileMenu && mobileMenuToggle) {
          mobileMenu.classList.add('hidden');
          mobileMenuToggle.setAttribute('aria-expanded', 'false');
          document.body.style.overflow = '';
        }
      }

      function toggleMobileMenu() {
        if (mobileMenu && mobileMenuToggle) {
          const expanded = mobileMenuToggle.getAttribute('aria-expanded') === 'true';
          if (expanded) {
            closeMobileMenu();
          } else {
            openMobileMenu();
          }
        }
      }

      mobileMenuToggle?.addEventListener('click', toggleMobileMenu);

      mobileMenu?.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', closeMobileMenu);
      });

      document.addEventListener('astro:before-swap', () => {
        closeMobileMenu();
        document.body.style.overflow = '';
        document.body.classList.remove('overflow-hidden');
      });

      window.addEventListener('pageshow', () => {
        document.body.style.overflow = '';
        document.body.classList.remove('overflow-hidden');
      });

      document.addEventListener('keydown', (e: KeyboardEvent) => {
        if (e.key === 'Escape') {
          closeSearch();
          closeMobileMenu();
          document.body.style.overflow = '';
          document.body.classList.remove('overflow-hidden');
        }
        if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
          e.preventDefault();
          searchModal?.classList.contains('hidden') ? openSearch() : closeSearch();
        }
        
        const activeEl = document.activeElement;
        const isInput = activeEl && (activeEl.tagName === 'INPUT' || activeEl.tagName === 'TEXTAREA' || activeEl.tagName === 'SELECT' || (activeEl as HTMLElement).isContentEditable);
        if (!isInput && (e.key === 'f' || e.key === 'F')) {
          e.preventDefault();
          (window as any).toggleGlobalFullscreen();
        }
      });
    </script>
  </body>
