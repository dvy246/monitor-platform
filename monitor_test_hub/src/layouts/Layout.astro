---
import SEOHead from '../components/seo/SEOHead.astro';
import MedicalBounceBanner from '../components/seo/MedicalBounceBanner.astro';
import HardwarePassportModal from '../components/diagnostics/HardwarePassportModal.astro';
import { useTranslations, localizeLink } from '../utils/i18n';
import '../styles/global.css';

export interface Props {
  title: string;
  description: string;
  showBounceBanner?: boolean;
  faqs?: Array<{ question: string; answer: string }>;
}

const { title, description, showBounceBanner = true, faqs = [] } = Astro.props;
const { t, lang } = useTranslations(Astro.url.pathname);
---


<!DOCTYPE html>
<html lang={lang} class="scroll-smooth">
  <head>
    <SEOHead title={title} description={description} faqs={faqs} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;500;600;700&family=Geist:wght@300;400;500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    
    <!-- Dark/Light Theme Initialization Script -->
    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        return window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
      })();
      if (theme === 'light') {
        document.documentElement.classList.add('light');
      } else {
        document.documentElement.classList.remove('light');
      }
    </script>
  </head>
  <body class="bg-bg-canvas bg-precision-grid text-text-primary min-h-dvh flex flex-col antialiased selection:bg-status-pass selection:text-text-on-accent">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:bg-status-pass focus:text-text-on-accent focus:px-4 focus:py-2 focus:rounded-md focus:font-bold focus:z-50">
      Skip to main content
    </a>

    <!-- Medical Bounce Neutralizer Top Notice Bar -->
    {showBounceBanner && <MedicalBounceBanner />}

    <!-- Header Navigation Shell -->
    <header class="border-b border-border-hairline/80 bg-bg-canvas/90 backdrop-blur-xl sticky top-0 z-40 font-mono transform-gpu shadow-xl">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-14 flex items-center justify-between gap-4">
        
        <!-- Left Group: Logo Emblem -->
        <div class="flex items-center gap-3 shrink-0">
          <a href={localizeLink("/", lang)} class="flex items-center gap-2.5 group cursor-pointer">
            <div aria-hidden="true" class="w-7 h-7 rounded-lg border border-status-pass/50 bg-bg-surface flex items-center justify-center font-bold text-xs text-text-primary group-hover:border-status-pass group-hover:shadow-[0_0_16px_rgba(5,150,105,0.6)] transition-all duration-200">
              M
            </div>
            <span class="text-xs font-bold tracking-widest text-text-primary uppercase group-hover:text-status-pass transition-colors">
              MONITOR<span class="text-status-pass">/</span>HUB
            </span>
          </a>
        </div>

        <!-- Center Group: Minimalist 3-Tab Mega Menu -->
        <nav class="hidden md:flex items-center gap-1 text-xs font-sans font-medium" aria-label="Main Navigation">
          
          <!-- Unified Diagnostics Suite Mega-Menu Dropdown -->
          <div class="relative group">
            <button 
              class:list={[
                "flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg transition-all duration-150 border cursor-pointer",
                (Astro.url.pathname.includes('/display-tests') || Astro.url.pathname.includes('/touch-tests') || Astro.url.pathname.includes('/input-tests') || Astro.url.pathname.includes('/audio-tests'))
                  ? 'bg-bg-surface border-status-pass/40 text-status-pass font-semibold shadow-[0_0_12px_rgba(5,150,105,0.2)]' 
                  : 'border-transparent text-text-secondary hover:text-text-primary hover:bg-bg-elevated hover:border-border-hairline'
              ]}
            >
              <span class="w-1.5 h-1.5 rounded-full bg-status-pass"></span>
              <span>All Diagnostics</span>
              <svg class="w-3 h-3 text-text-muted group-hover:text-status-pass group-hover:rotate-180 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </button>

            <!-- Comprehensive Mega Menu Overlay -->
            <div class="absolute left-1/2 -translate-x-1/2 top-full pt-2 opacity-0 translate-y-1 pointer-events-none group-hover:opacity-100 group-hover:translate-y-0 group-hover:pointer-events-auto transition-all duration-200 z-50">
              <div class="w-[620px] bg-bg-surface/98 backdrop-blur-2xl border border-border-hairline rounded-2xl p-4 shadow-2xl shadow-black/80 font-mono space-y-3">
                <div class="flex items-center justify-between pb-2 border-b border-border-hairline/60">
                  <div class="flex items-center gap-2">
                    <span class="w-2 h-2 rounded-full bg-status-pass shadow-[0_0_8px_rgba(5,150,105,0.8)]"></span>
                    <span class="text-xs font-bold text-text-primary uppercase tracking-wider">HARDWARE DIAGNOSTIC SUITE (34 INSTRUMENTS)</span>
                  </div>
                  <span class="text-[10px] text-text-muted">100% Client-Side Pure WebGL / TS</span>
                </div>

                <div class="grid grid-cols-2 gap-4">
                  <!-- Category 1: Display Diagnostics -->
                  <div class="space-y-1.5">
                    <div class="text-[10px] font-bold text-status-pass uppercase tracking-wider px-1">Display &amp; Panel (22)</div>
                    <div class="space-y-0.5 max-h-48 overflow-y-auto pr-1">
                      <a href={localizeLink("/display-tests/dead-pixel", lang)} class="flex items-center justify-between p-1.5 rounded-md hover:bg-bg-elevated text-xs text-text-secondary hover:text-text-primary transition-colors">
                        <span>Dead Pixel Test</span>
                        <span class="text-[9px] text-status-pass font-bold">ISO</span>
                      </a>
                      <a href={localizeLink("/display-tests/uniformity", lang)} class="flex items-center justify-between p-1.5 rounded-md hover:bg-bg-elevated text-xs text-text-secondary hover:text-text-primary transition-colors">
                        <span>OLED Uniformity</span>
                        <span class="text-[9px] text-status-pass font-bold">OLED</span>
                      </a>
                      <a href={localizeLink("/display-tests/vrr", lang)} class="flex items-center justify-between p-1.5 rounded-md hover:bg-bg-elevated text-xs text-text-secondary hover:text-text-primary transition-colors">
                        <span>VRR Stutter Sweep</span>
                        <span class="text-[9px] text-status-pass font-bold">540Hz</span>
                      </a>
                      <a href={localizeLink("/display-tests/oled-burn-in", lang)} class="flex items-center justify-between p-1.5 rounded-md hover:bg-bg-elevated text-xs text-text-secondary hover:text-text-primary transition-colors">
                        <span>OLED Burn-In Risk</span>
                        <span class="text-[9px] text-text-muted">Model</span>
                      </a>
                      <a href={localizeLink("/display-tests/hdr-test", lang)} class="flex items-center justify-between p-1.5 rounded-md hover:bg-bg-elevated text-xs text-text-secondary hover:text-text-primary transition-colors">
                        <span>HDR Tone Mapping</span>
                        <span class="text-[9px] text-text-muted">EOTF</span>
                      </a>
                      <a href={localizeLink("/display-tests/color-gamut", lang)} class="flex items-center justify-between p-1.5 rounded-md hover:bg-bg-elevated text-xs text-text-secondary hover:text-text-primary transition-colors">
                        <span>Color Gamut &amp; ICC</span>
                        <span class="text-[9px] text-status-pass font-bold">ICC</span>
                      </a>
                      <a href={localizeLink("/display-tests/backlight-bleed", lang)} class="flex items-center justify-between p-1.5 rounded-md hover:bg-bg-elevated text-xs text-text-secondary hover:text-text-primary transition-colors">
                        <span>Backlight Bleed</span>
                        <span class="text-[9px] text-text-muted">Leak</span>
                      </a>
                      <a href={localizeLink("/display-tests/motion-blur", lang)} class="flex items-center justify-between p-1.5 rounded-md hover:bg-bg-elevated text-xs text-text-secondary hover:text-text-primary transition-colors">
                        <span>Motion Blur Ghosting</span>
                        <span class="text-[9px] text-text-muted">MPRT</span>
                      </a>
                      <a href={localizeLink("/display-tests/stuck-pixel", lang)} class="flex items-center justify-between p-1.5 rounded-md hover:bg-bg-elevated text-xs text-text-secondary hover:text-text-primary transition-colors">
                        <span>Stuck Pixel Healer</span>
                        <span class="text-[9px] text-status-pass font-bold">Fixer</span>
                      </a>
                    </div>
                  </div>

                  <!-- Category 2: Touch, Input & Audio -->
                  <div class="space-y-3">
                    <!-- Touch & Stylus -->
                    <div class="space-y-1">
                      <div class="text-[10px] font-bold text-status-pass uppercase tracking-wider px-1">Touch &amp; Stylus Digitizer (6)</div>
                      <a href={localizeLink("/touch-matrix", lang)} class="flex items-center justify-between p-1.5 rounded-md hover:bg-bg-elevated text-xs text-text-secondary hover:text-text-primary transition-colors">
                        <span>Dead-Zone Grid Matrix</span>
                        <span class="text-[9px] text-status-pass font-bold">100dvh</span>
                      </a>
                      <a href={localizeLink("/touch-tests/stylus-pressure", lang)} class="flex items-center justify-between p-1.5 rounded-md hover:bg-bg-elevated text-xs text-text-secondary hover:text-text-primary transition-colors">
                        <span>Stylus Pen Pressure &amp; Tilt</span>
                        <span class="text-[9px] text-status-pass font-bold">W3C</span>
                      </a>
                    </div>

                    <!-- Peripherals -->
                    <div class="space-y-1">
                      <div class="text-[10px] font-bold text-status-pass uppercase tracking-wider px-1">Gaming Inputs &amp; Audio (6)</div>
                      <a href={localizeLink("/input-tests/mouse-polling", lang)} class="flex items-center justify-between p-1.5 rounded-md hover:bg-bg-elevated text-xs text-text-secondary hover:text-text-primary transition-colors">
                        <span>Mouse Polling Rate (Hz)</span>
                        <span class="text-[9px] text-status-pass font-bold">8000Hz</span>
                      </a>
                      <a href={localizeLink("/input-tests/gamepad-drift", lang)} class="flex items-center justify-between p-1.5 rounded-md hover:bg-bg-elevated text-xs text-text-secondary hover:text-text-primary transition-colors">
                        <span>Gamepad Stick Drift</span>
                        <span class="text-[9px] text-text-muted">API</span>
                      </a>
                      <a href={localizeLink("/audio-tests/mic-noise-floor", lang)} class="flex items-center justify-between p-1.5 rounded-md hover:bg-bg-elevated text-xs text-text-secondary hover:text-text-primary transition-colors">
                        <span>Microphone Noise Floor</span>
                        <span class="text-[9px] text-text-muted">dBFS</span>
                      </a>
                      <a href={localizeLink("/audio-tests/speaker-frequency", lang)} class="flex items-center justify-between p-1.5 rounded-md hover:bg-bg-elevated text-xs text-text-secondary hover:text-text-primary transition-colors">
                        <span>Speaker Frequency Sweep</span>
                        <span class="text-[9px] text-text-muted">20Hz</span>
                      </a>
                    </div>
                  </div>
                </div>

                <div class="pt-2 border-t border-border-hairline/60 flex items-center justify-between text-[11px]">
                  <a href={localizeLink("/display-tests", lang)} class="text-status-pass font-bold hover:underline">View All 34 Diagnostic Tools &rarr;</a>
                  <a href={localizeLink("/benchmarks", lang)} class="text-text-muted hover:text-text-primary">Telemetry Ledger</a>
                </div>
              </div>
            </div>
          </div>

          <!-- Arcade Suite -->
          <a 
            href={localizeLink("/arcade", lang)} 
            class:list={[
              "px-3.5 py-1.5 rounded-lg transition-all duration-150 border",
              Astro.url.pathname.includes('/arcade') 
                ? 'bg-bg-surface border-status-pass/40 text-status-pass font-semibold shadow-[0_0_12px_rgba(5,150,105,0.2)]' 
                : 'border-transparent text-text-secondary hover:text-text-primary hover:bg-bg-elevated hover:border-border-hairline'
            ]}
          >
            <span>{t.arcadeSuite}</span>
          </a>

          <!-- Guides & Glossary -->
          <a 
            href={localizeLink("/screen-test-meaning", lang)} 
            class:list={[
              "px-3.5 py-1.5 rounded-lg transition-all duration-150 border",
              Astro.url.pathname.includes('/screen-test-meaning') 
                ? 'bg-bg-surface border-status-pass/40 text-status-pass font-semibold shadow-[0_0_12px_rgba(5,150,105,0.2)]' 
                : 'border-transparent text-text-secondary hover:text-text-primary hover:bg-bg-elevated hover:border-border-hairline'
            ]}
          >
            <span>{t.glossary}</span>
          </a>
        </nav>

        <!-- Right Control Deck: Streamlined Command Bar & Settings Popover -->
        <div class="flex items-center gap-2">
          
          <!-- Command Palette Trigger Button (⌘K) -->
          <button id="search-trigger" aria-label="Open command palette" class="flex items-center gap-2 px-3 py-1.5 rounded-lg bg-bg-surface border border-border-hairline text-text-muted hover:text-text-primary text-xs font-mono cursor-pointer transition-all shadow-sm">
            <svg class="w-3.5 h-3.5 text-status-pass" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
            <span class="hidden sm:inline font-sans text-xs text-text-secondary">Search tools...</span>
            <kbd class="px-1.5 py-0.5 text-[9px] font-mono rounded bg-bg-canvas border border-border-subtle text-text-muted">⌘K</kbd>
          </button>

          <!-- Fullscreen Action Button -->
          <button 
            id="fullscreen-trigger" 
            onclick="window.toggleGlobalFullscreen && window.toggleGlobalFullscreen()" 
            aria-label="Toggle Fullscreen Mode" 
            title="Toggle Fullscreen (Hotkey: F)"
            class="flex items-center justify-center w-8 h-8 rounded-lg bg-status-pass/10 border border-status-pass/30 text-status-pass hover:bg-status-pass/20 cursor-pointer transition-all shadow-[0_0_10px_rgba(5,150,105,0.2)]"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4 8V4m0 0h4M4 4l5 5m11-5V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5v-4m0 0h-4m4 0l-5-5"/></svg>
          </button>

          <!-- Settings & Hardware Passport Popover Menu -->
          <div class="relative group">
            <button aria-label="System Settings & Hardware Passport" class="flex items-center justify-center w-8 h-8 rounded-lg bg-bg-surface border border-border-hairline text-text-secondary hover:text-text-primary hover:border-border-subtle cursor-pointer transition-all shadow-sm">
              <svg class="w-4 h-4 text-text-muted group-hover:text-status-pass transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            </button>

            <!-- Dropdown Popover Content -->
            <div class="absolute right-0 top-full pt-2 opacity-0 translate-y-1 pointer-events-none group-hover:opacity-100 group-hover:translate-y-0 group-hover:pointer-events-auto transition-all duration-200 z-50">
              <div class="w-64 bg-bg-surface/98 backdrop-blur-2xl border border-border-hairline rounded-xl p-3 shadow-2xl shadow-black/80 font-mono space-y-3">
                <button 
                  onclick="window.openHardwarePassport && window.openHardwarePassport()" 
                  class="w-full flex items-center justify-between p-2 rounded-lg bg-status-pass/10 border border-status-pass/30 text-status-pass text-xs font-bold hover:bg-status-pass/20 cursor-pointer transition-colors"
                >
                  <div class="flex items-center gap-2">
                    <span class="w-2 h-2 rounded-full bg-status-pass led-glow-pass animate-pulse"></span>
                    <span>HARDWARE PASSPORT</span>
                  </div>
                  <span class="text-[9px]">SHA-256</span>
                </button>

                <div class="h-px bg-border-hairline"></div>

                <!-- Language Selector -->
                <div class="space-y-1">
                  <span class="text-[10px] text-text-muted uppercase">Display Language</span>
                  <select id="lang-selector" aria-label="Select Language" class="w-full bg-bg-canvas border border-border-subtle text-text-primary text-xs font-mono rounded-lg p-1.5 focus:border-status-pass cursor-pointer">
                    <option value="en" selected={lang === 'en'}>English (EN)</option>
                    <option value="es" selected={lang === 'es'}>Español (ES)</option>
                    <option value="de" selected={lang === 'de'}>Deutsch (DE)</option>
                    <option value="fr" selected={lang === 'fr'}>Français (FR)</option>
                  </select>
                </div>

                <!-- Theme Toggle -->
                <div class="space-y-1">
                  <span class="text-[10px] text-text-muted uppercase">Color Theme</span>
                  <div class="flex items-center justify-between p-1 bg-bg-canvas border border-border-subtle rounded-lg text-xs">
                    <button id="theme-slider-dark" type="button" class="flex-1 py-1 text-center font-bold text-status-pass rounded bg-bg-surface">DARK</button>
                    <button id="theme-slider-light" type="button" class="flex-1 py-1 text-center text-text-muted hover:text-text-primary">LIGHT</button>
                  </div>
                </div>
              </div>
            </div>
          </div>


          <!-- Search Modal Overlay -->
          <div id="search-modal" role="dialog" aria-modal="true" aria-label="Site search" class="hidden fixed inset-0 z-50 flex items-start justify-center pt-24 px-4" style="background:rgba(0,0,0,0.7);backdrop-filter:blur(4px)">
            <div class="w-full max-w-xl bg-bg-surface border border-border-hairline rounded-2xl shadow-2xl font-mono overflow-hidden shadow-specular-top">
              <div class="flex items-center gap-3 px-4 py-3 border-b border-border-hairline">
                <svg class="w-4 h-4 text-text-secondary shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                <input id="search-input" type="search" placeholder="Search tests, tools, pages..." autocomplete="off" class="flex-1 bg-transparent text-text-primary text-sm focus:outline-none placeholder:text-text-muted" />
                <span class="px-2 py-0.5 text-[10px] rounded border border-border-hairline text-text-muted cursor-pointer hover:text-text-primary">ESC</span>
              </div>
              <div id="search-results" class="max-h-72 overflow-y-auto py-2">
                <div class="px-4 py-2 text-[10px] text-text-muted uppercase tracking-wider">QUICK LINKS</div>
                <a href="/display-tests" class="search-item flex items-center gap-3 px-4 py-2.5 hover:bg-bg-elevated text-sm text-text-secondary hover:text-text-primary transition-colors">
                  <span class="w-2 h-2 rounded-full bg-status-pass shrink-0"></span>
                  Display Test Suite — Sub-Pixel, Uniformity, VRR
                </a>
                <a href="/touch-tests" class="search-item flex items-center gap-3 px-4 py-2.5 hover:bg-bg-elevated text-sm text-text-secondary hover:text-text-primary transition-colors">
                  <span class="w-2 h-2 rounded-full bg-status-pass shrink-0"></span>
                  Touch Test Suite — Dead Zone, Multi-Touch, Swipe
                </a>
                <a href="/arcade" class="search-item flex items-center gap-3 px-4 py-2.5 hover:bg-bg-elevated text-sm text-text-secondary hover:text-text-primary transition-colors">
                  <span class="w-2 h-2 rounded-full bg-status-pass shrink-0"></span>
                  Arcade — Ghosting Invaders, Color Match, Reflex Sniper
                </a>
                <a href="/display-tests/sub-pixel" class="search-item flex items-center gap-3 px-4 py-2.5 hover:bg-bg-elevated text-sm text-text-secondary hover:text-text-primary transition-colors">
                  <span class="w-2 h-2 rounded-full bg-text-muted shrink-0"></span>Sub-Pixel Analyzer
                </a>
                <a href="/display-tests/uniformity" class="search-item flex items-center gap-3 px-4 py-2.5 hover:bg-bg-elevated text-sm text-text-secondary hover:text-text-primary transition-colors">
                  <span class="w-2 h-2 rounded-full bg-text-muted shrink-0"></span>OLED Uniformity Inspector
                </a>
                <a href="/display-tests/vrr" class="search-item flex items-center gap-3 px-4 py-2.5 hover:bg-bg-elevated text-sm text-text-secondary hover:text-text-primary transition-colors">
                  <span class="w-2 h-2 rounded-full bg-text-muted shrink-0"></span>VRR Sync Engine
                </a>
                <a href="/display-tests/oled-burn-in" class="search-item flex items-center gap-3 px-4 py-2.5 hover:bg-bg-elevated text-sm text-text-secondary hover:text-text-primary transition-colors">
                  <span class="w-2 h-2 rounded-full bg-text-muted shrink-0"></span>OLED Burn-In Risk Analyzer
                </a>
                <a href="/touch-matrix" class="search-item flex items-center gap-3 px-4 py-2.5 hover:bg-bg-elevated text-sm text-text-secondary hover:text-text-primary transition-colors">
                  <span class="w-2 h-2 rounded-full bg-status-pass shrink-0"></span>
                  Touch Matrix Suite — Digitizer Dead-Zone & Multi-Touch Precision Matrix
                </a>
                <a href="/touch-tests/dead-zone" class="search-item flex items-center gap-3 px-4 py-2.5 hover:bg-bg-elevated text-sm text-text-secondary hover:text-text-primary transition-colors">
                  <span class="w-2 h-2 rounded-full bg-text-muted shrink-0"></span>Dead Zone Matrix
                </a>
                <a href="/screen-test-meaning" class="search-item flex items-center gap-3 px-4 py-2.5 hover:bg-bg-elevated text-sm text-text-secondary hover:text-text-primary transition-colors">
                  <span class="w-2 h-2 rounded-full bg-text-muted shrink-0"></span>What Does a Screen Test Detect?
                </a>
              </div>
              <div class="px-4 py-2.5 border-t border-border-hairline flex items-center gap-4 text-[10px] text-text-muted">
                <span><kbd class="px-1 py-0.5 rounded border border-border-hairline">↑↓</kbd> Navigate</span>
                <span><kbd class="px-1 py-0.5 rounded border border-border-hairline">↵</kbd> Open</span>
                <span><kbd class="px-1 py-0.5 rounded border border-border-hairline">ESC</kbd> Close</span>
              </div>
            </div>
          </div>


          <span class="hidden md:block w-px h-4 bg-border-hairline"></span>

          <!-- Language Selector Dropdown -->
          <div class="relative inline-block text-left">
            <select id="lang-selector" aria-label="Select Language" class="bg-bg-surface text-text-secondary border border-border-hairline rounded-md px-2.5 py-1 text-xs font-mono font-medium focus:outline-none focus:border-status-pass cursor-pointer shadow-specular-top">
              <option value="en" selected={lang === 'en'}>EN</option>
              <option value="es" selected={lang === 'es'}>ES</option>
              <option value="de" selected={lang === 'de'}>DE</option>
              <option value="fr" selected={lang === 'fr'}>FR</option>
            </select>
          </div>

          <!-- Interactive Precision Theme Slider Switch -->
          <div class="relative inline-flex items-center bg-bg-surface border border-border-hairline rounded-full p-0.5 font-mono text-[10px] select-none shadow-specular-top">
            <button id="theme-slider-dark" type="button" aria-label="Dark Mode" aria-pressed="true" class="relative z-10 px-2 py-1 rounded-full flex items-center gap-1 cursor-pointer transition-colors text-text-primary font-bold">
              <svg class="w-3 h-3 text-status-pass" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/></svg>
              <span class="hidden sm:inline">DARK</span>
            </button>
            <button id="theme-slider-light" type="button" aria-label="White Light Mode" aria-pressed="false" class="relative z-10 px-2 py-1 rounded-full flex items-center gap-1 cursor-pointer transition-colors text-text-muted hover:text-text-primary">
              <svg class="w-3 h-3 text-status-warn" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707m0-12.728l.707.707m12.728 12.728l.707-.707M12 8a4 4 0 100 8 4 4 0 000-8z"/></svg>
              <span class="hidden sm:inline">LIGHT</span>
            </button>
            <!-- Sliding Pill Indicator -->
            <div id="theme-slider-pill" class="absolute top-0.5 bottom-0.5 left-0.5 w-[calc(50%-2px)] rounded-full bg-bg-elevated border border-border-subtle transition-transform duration-200 ease-out shadow-sm"></div>
          </div>

          <!-- Mobile Toggle Menu Button -->
          <button id="mobile-menu-toggle" aria-expanded="false" aria-controls="mobile-menu" aria-label="Toggle Navigation Menu" class="md:hidden p-2 min-h-[44px] min-w-[44px] rounded-md bg-bg-surface text-text-secondary border border-border-hairline flex items-center justify-center">
            <svg class="h-4 w-4 block" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </button>
        </div>
      </div>

      <!-- Mobile menu -->
      <nav id="mobile-menu" aria-label="Mobile Navigation" class="hidden md:hidden border-b border-border-hairline bg-bg-surface px-4 py-3 space-y-2 text-xs font-mono text-text-secondary">
