---
import SEOHead from '../components/seo/SEOHead.astro';
import HardwarePassportModal from '../components/diagnostics/HardwarePassportModal.astro';
import FloatingActionMenu from '../components/ui/FloatingActionMenu.astro';
import { useTranslations, localizeLink } from '../utils/i18n';
import '../styles/global.css';

export interface Props {
  title: string;
  description: string;
  showBounceBanner?: boolean;
  faqs?: Array<{ question: string; answer: string }>;
  canonicalUrl?: string;
  ogImage?: string;
  ogType?: string;
  noindex?: boolean;
  schemaItems?: any[];
}

const { title, description, showBounceBanner = false, faqs = [], canonicalUrl, ogImage, ogType, noindex, schemaItems = [] } = Astro.props;
const { t, lang } = useTranslations(Astro.url.pathname);
---


<!DOCTYPE html>
<html lang={lang} class="scroll-smooth w-full max-w-full">
  <head>
    <SEOHead title={title} description={description} faqs={faqs} canonicalUrl={canonicalUrl} ogImage={ogImage} ogType={ogType} noindex={noindex} schemaItems={schemaItems} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;500;600;700&family=Geist:wght@300;400;500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    
    <!-- Dark/Light Theme Initialization Script -->
    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        return window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
      })();
      if (theme === 'light') {
        document.documentElement.classList.add('light');
      } else {
        document.documentElement.classList.remove('light');
      }
    </script>
  </head>
  <body class="bg-bg-canvas bg-precision-grid text-text-primary min-h-dvh flex flex-col antialiased selection:bg-status-pass selection:text-text-on-accent w-full max-w-full">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:bg-status-pass focus:text-text-on-accent focus:px-4 focus:py-2 focus:rounded-md focus:font-bold focus:z-50">
      Skip to main content
    </a>

    <!-- Header Navigation Shell -->
    <header class="w-full max-w-full box-border border-b border-border-hairline/80 bg-bg-canvas/90 backdrop-blur-xl sticky top-0 z-40 font-mono transform-gpu shadow-xl pt-[env(safe-area-inset-top,0px)]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-12 sm:h-14 flex items-center justify-between gap-2 sm:gap-4">
        
        <!-- Left Group: Logo Emblem -->
        <div class="flex items-center gap-3 shrink-0">
          <a href={localizeLink("/", lang)} class="flex items-center gap-2.5 group cursor-pointer">
            <div aria-hidden="true" class="w-7 h-7 rounded-lg border border-status-pass/50 bg-bg-surface flex items-center justify-center font-bold text-xs text-text-primary group-hover:border-status-pass group-hover:shadow-[0_0_16px_rgba(5,150,105,0.6)] transition-all duration-200">
              D
            </div>
            <span class="text-xs font-bold tracking-widest text-text-primary uppercase group-hover:text-status-pass transition-colors">
              DISPLAY TEST<span class="text-status-pass">/</span>ONLINE
            </span>
          </a>
        </div>

        <!-- Center Group: Streamlined Dedicated Navigation Deck (5 Plain English Pillars) -->
        <!-- Center Group: Streamlined Dedicated Navigation Deck -->
        <nav class="hidden xl:flex items-center gap-1 xl:gap-2 text-xs font-sans font-medium" aria-label="Main Navigation">
          
          <!-- Standalone Pillar 0: Water Ejector (Emergency Hardware Utility) -->
          <a 
            href={localizeLink("/sound-test/water-eject", lang)}
            class:list={[
              "flex items-center gap-1.5 px-3 py-2 rounded-lg transition-all cursor-pointer font-sans text-xs font-bold shrink-0",
              Astro.url.pathname.includes('/water-eject')
                ? 'bg-status-pass/20 text-status-pass border border-status-pass/40 shadow-[0_0_12px_rgba(5,150,105,0.3)]' 
                : 'text-emerald-400 bg-emerald-500/10 border border-emerald-500/30 hover:bg-emerald-500/20 hover:text-emerald-300'
            ]}
          >
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            <span>Water Ejector</span>
          </a>

          <!-- Pillar 1: Display Tests -->
          <div class="relative group">
            <button 
              class:list={[
                "flex items-center gap-1.5 px-3 py-2 rounded-lg transition-all cursor-pointer font-sans text-xs",
                (Astro.url.pathname.includes('/display-tests') || Astro.url.pathname.includes('/refresh-rate-test') || Astro.url.pathname.includes('/white-screen') || Astro.url.pathname.includes('/vrr-stutter-test'))
                  ? 'bg-bg-elevated text-status-pass font-semibold border border-status-pass/30' 
                  : 'text-text-secondary hover:text-text-primary hover:bg-bg-elevated/60 border border-transparent'
              ]}
            >
              <span>Display Tests</span>
              <svg class="w-3 h-3 text-text-muted group-hover:text-text-primary group-hover:rotate-180 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </button>

            <!-- Display Tests Dropdown Overlay -->
            <div class="absolute left-0 top-full pt-2 opacity-0 translate-y-1 pointer-events-none group-hover:opacity-100 group-hover:translate-y-0 group-hover:pointer-events-auto transition-all duration-200 z-50">
              <div class="w-[500px] max-w-[calc(100vw-2rem)] bg-bg-surface/98 backdrop-blur-2xl border border-border-hairline rounded-2xl p-4 shadow-2xl shadow-black/90 space-y-3">
                <div class="flex items-center justify-between pb-2 border-b border-border-hairline/60">
                  <span class="text-xs font-bold text-text-primary uppercase tracking-wider font-sans">Screen &amp; Display Testing</span>
                  <span class="text-[10px] text-status-pass font-mono font-bold px-2 py-0.5 rounded bg-status-pass/10 border border-status-pass/30">Instant Browser Test</span>
                </div>

                <div class="grid grid-cols-2 gap-3">
                  <!-- Screen & Speed -->
                  <div class="space-y-1">
                    <div class="text-[10px] font-bold text-status-pass uppercase tracking-wider px-1 mb-1">Screen &amp; Speed</div>
                    <a href={localizeLink("/screen-test", lang)} class="flex items-center justify-between gap-2 p-2 rounded-lg hover:bg-bg-elevated text-xs font-bold text-text-primary bg-status-pass/10 border border-status-pass/30 transition-colors group/item">
                      <span class="truncate flex-1 min-w-0 font-sans">Screen Test (Fullscreen)</span>
                      <span class="shrink-0 text-[9px] font-mono font-bold text-status-pass bg-status-pass/20 px-1.5 py-0.5 rounded border border-status-pass/40 whitespace-nowrap">Popular</span>
                    </a>
                    <a href={localizeLink("/refresh-rate-test", lang)} class="flex items-center justify-between gap-2 p-2 rounded-lg hover:bg-bg-elevated text-xs font-medium text-text-secondary hover:text-text-primary transition-colors group/item">
                      <span class="truncate flex-1 min-w-0 font-sans group-hover/item:text-text-primary">Refresh Rate Test (Hz)</span>
                      <span class="shrink-0 text-[9px] font-mono font-bold text-cyan-400 bg-cyan-400/10 px-1.5 py-0.5 rounded border border-cyan-400/30 whitespace-nowrap">60–540Hz</span>
                    </a>
                    <a href={localizeLink("/display-tests/dead-pixel", lang)} class="flex items-center justify-between gap-2 p-2 rounded-lg hover:bg-bg-elevated text-xs font-medium text-text-secondary hover:text-text-primary transition-colors group/item">
                      <span class="truncate flex-1 min-w-0 font-sans group-hover/item:text-text-primary">Dead Pixel Test</span>
                      <span class="shrink-0 text-[9px] font-mono font-bold text-status-pass bg-status-pass/10 px-1.5 py-0.5 rounded border border-status-pass/30 whitespace-nowrap">Colors</span>
                    </a>
                    <a href={localizeLink("/vrr-stutter-test", lang)} class="flex items-center justify-between gap-2 p-2 rounded-lg hover:bg-bg-elevated text-xs font-medium text-text-secondary hover:text-text-primary transition-colors group/item">
                      <span class="truncate flex-1 min-w-0 font-sans group-hover/item:text-text-primary">Frame Stutter &amp; Tear</span>
                      <span class="shrink-0 text-[9px] font-mono font-bold text-status-pass bg-status-pass/10 px-1.5 py-0.5 rounded border border-status-pass/30 whitespace-nowrap">G-Sync</span>
                    </a>
                    <a href={localizeLink("/display-tests/oled-burn-in", lang)} class="flex items-center justify-between gap-2 p-2 rounded-lg hover:bg-bg-elevated text-xs font-medium text-text-secondary hover:text-text-primary transition-colors group/item">
                      <span class="truncate flex-1 min-w-0 font-sans group-hover/item:text-text-primary">OLED Burn-In Test</span>
                      <span class="shrink-0 text-[9px] font-mono font-bold text-purple-400 bg-purple-400/10 px-1.5 py-0.5 rounded border border-purple-400/30 whitespace-nowrap">OLED</span>
                    </a>
                    <a href={localizeLink("/display-tests/hdr-test", lang)} class="flex items-center justify-between gap-2 p-2 rounded-lg hover:bg-bg-elevated text-xs font-medium text-text-secondary hover:text-text-primary transition-colors group/item">
                      <span class="truncate flex-1 min-w-0 font-sans group-hover/item:text-text-primary">HDR Brightness Test</span>
                      <span class="shrink-0 text-[9px] font-mono font-bold text-status-pass bg-status-pass/10 px-1.5 py-0.5 rounded border border-status-pass/30 whitespace-nowrap">10-Bit</span>
                    </a>
                  </div>

                  <!-- Color & Quality -->
                  <div class="space-y-1">
                    <div class="text-[10px] font-bold text-status-pass uppercase tracking-wider px-1 mb-1">Color &amp; Quality</div>
                    <a href={localizeLink("/monitor-color-calibration", lang)} class="flex items-center justify-between gap-2 p-2 rounded-lg hover:bg-bg-elevated text-xs font-medium text-text-secondary hover:text-text-primary transition-colors group/item">
                      <span class="truncate flex-1 min-w-0 font-sans group-hover/item:text-text-primary">Color Calibration</span>
                      <span class="shrink-0 text-[9px] font-mono font-bold text-emerald-400 bg-emerald-400/10 px-1.5 py-0.5 rounded border border-emerald-400/30 whitespace-nowrap">Gamma</span>
                    </a>
                    <a href={localizeLink("/display-tests/sub-pixel", lang)} class="flex items-center justify-between gap-2 p-2 rounded-lg hover:bg-bg-elevated text-xs font-medium text-text-secondary hover:text-text-primary transition-colors group/item">
                      <span class="truncate flex-1 min-w-0 font-sans group-hover/item:text-text-primary">Text Sharpness Test</span>
                      <span class="shrink-0 text-[9px] font-mono font-bold text-cyan-400 bg-cyan-400/10 px-1.5 py-0.5 rounded border border-cyan-400/30 whitespace-nowrap">Subpixel</span>
                    </a>
                    <a href={localizeLink("/display-tests/uniformity", lang)} class="flex items-center justify-between gap-2 p-2 rounded-lg hover:bg-bg-elevated text-xs font-medium text-text-secondary hover:text-text-primary transition-colors group/item">
                      <span class="truncate flex-1 min-w-0 font-sans group-hover/item:text-text-primary">Screen Uniformity Test</span>
                      <span class="shrink-0 text-[9px] font-mono font-bold text-text-muted bg-bg-elevated px-1.5 py-0.5 rounded border border-border-hairline whitespace-nowrap">5% Gray</span>
                    </a>
                    <a href={localizeLink("/display-tests/blooming-test", lang)} class="flex items-center justify-between gap-2 p-2 rounded-lg hover:bg-bg-elevated text-xs font-medium text-text-secondary hover:text-text-primary transition-colors group/item">
                      <span class="truncate flex-1 min-w-0 font-sans group-hover/item:text-text-primary">Blooming &amp; Halo Test</span>
                      <span class="shrink-0 text-[9px] font-mono font-bold text-status-pass bg-status-pass/10 px-1.5 py-0.5 rounded border border-status-pass/30 whitespace-nowrap">Mini-LED</span>
                    </a>
                    <a href={localizeLink("/display-tests/flicker-test", lang)} class="flex items-center justify-between gap-2 p-2 rounded-lg hover:bg-bg-elevated text-xs font-medium text-text-secondary hover:text-text-primary transition-colors group/item">
                      <span class="truncate flex-1 min-w-0 font-sans group-hover/item:text-text-primary">Screen Flicker Test</span>
                      <span class="shrink-0 text-[9px] font-mono font-bold text-cyan-400 bg-cyan-400/10 px-1.5 py-0.5 rounded border border-cyan-400/30 whitespace-nowrap">PWM</span>
                    </a>
                    <a href={localizeLink("/white-screen", lang)} class="flex items-center justify-between gap-2 p-2 rounded-lg hover:bg-bg-elevated text-xs font-medium text-text-secondary hover:text-text-primary transition-colors group/item">
                      <span class="truncate flex-1 min-w-0 font-sans group-hover/item:text-text-primary">White Screen Light</span>
                      <span class="shrink-0 text-[9px] font-mono font-bold text-text-muted bg-bg-elevated px-1.5 py-0.5 rounded border border-border-hairline whitespace-nowrap">Clean</span>
                    </a>
                  </div>
                </div>

                <div class="pt-2 border-t border-border-hairline/60 flex items-center justify-between text-[11px] font-sans">
                  <a href={localizeLink("/display-tests", lang)} class="text-status-pass font-bold hover:underline">View All Display Tests &rarr;</a>
                  <a href={localizeLink("/refresh-rate-test", lang)} class="text-cyan-400 font-bold hover:underline">Refresh Rate Test &rarr;</a>
                </div>
              </div>
            </div>
          </div>

          <!-- Pillar 2: Keyboard & Mouse -->
          <div class="relative group">
            <button 
              class:list={[
                "flex items-center gap-1.5 px-3 py-2 rounded-lg transition-all cursor-pointer font-sans text-xs",
                (Astro.url.pathname.includes('/keyboard-tester') || Astro.url.pathname.includes('/mouse-test'))
                  ? 'bg-bg-elevated text-amber-400 font-semibold border border-amber-500/30' 
                  : 'text-text-secondary hover:text-text-primary hover:bg-bg-elevated/60 border border-transparent'
              ]}
            >
              <span>Keyboard &amp; Mouse</span>
              <svg class="w-3 h-3 text-text-muted group-hover:text-text-primary group-hover:rotate-180 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </button>

            <!-- Keyboard & Mouse Dropdown Overlay (Centered Positioned) -->
            <div class="absolute left-0 xl:left-1/2 xl:-translate-x-1/2 top-full pt-2 opacity-0 translate-y-1 pointer-events-none group-hover:opacity-100 group-hover:translate-y-0 group-hover:pointer-events-auto transition-all duration-200 z-50">
              <div class="w-[500px] max-w-[calc(100vw-2rem)] bg-bg-surface/98 backdrop-blur-2xl border border-border-hairline rounded-2xl p-4 shadow-2xl shadow-black/90 space-y-3">
                <div class="flex items-center justify-between pb-2 border-b border-border-hairline/60">
                  <span class="text-xs font-bold text-text-primary uppercase tracking-wider font-sans">Keyboard &amp; Mouse Diagnostics</span>
                  <span class="text-[10px] text-amber-400 font-mono font-bold px-2 py-0.5 rounded bg-amber-400/10 border border-amber-400/30">Hardware Check</span>
                </div>

                <div class="grid grid-cols-2 gap-3">
                  <!-- Keyboard Tests -->
                  <div class="space-y-1">
                    <div class="text-[10px] font-bold text-amber-400 uppercase tracking-wider px-1 mb-1">Keyboard Tests</div>
                    <a href={localizeLink("/keyboard-tester", lang)} class="flex items-center justify-between gap-2 p-2 rounded-lg hover:bg-bg-elevated text-xs font-bold text-text-primary bg-amber-400/10 border border-amber-400/30 transition-colors group/item">
                      <span class="truncate flex-1 min-w-0 font-sans">Full Keyboard Test</span>
                      <span class="shrink-0 text-[9px] font-mono font-bold text-amber-400 bg-amber-400/20 px-1.5 py-0.5 rounded border border-amber-400/40 whitespace-nowrap">All Keys</span>
                    </a>
                    <a href={localizeLink("/keyboard-tester/key-chatter-test", lang)} class="flex items-center justify-between gap-2 p-2 rounded-lg hover:bg-bg-elevated text-xs font-medium text-text-secondary hover:text-text-primary transition-colors group/item">
                      <span class="truncate flex-1 min-w-0 font-sans group-hover/item:text-text-primary">Double Typing Test</span>
                      <span class="shrink-0 text-[9px] font-mono font-bold text-rose-400 bg-rose-400/10 px-1.5 py-0.5 rounded border border-rose-400/30 whitespace-nowrap">Chatter</span>
                    </a>
                    <a href={localizeLink("/keyboard-tester/spacebar-counter", lang)} class="flex items-center justify-between gap-2 p-2 rounded-lg hover:bg-bg-elevated text-xs font-medium text-text-secondary hover:text-text-primary transition-colors group/item">
                      <span class="truncate flex-1 min-w-0 font-sans group-hover/item:text-text-primary">Spacebar Speed Test</span>
                      <span class="shrink-0 text-[9px] font-mono font-bold text-amber-400 bg-amber-400/10 px-1.5 py-0.5 rounded border border-amber-400/30 whitespace-nowrap">CPS</span>
                    </a>
                    <a href={localizeLink("/keyboard-tester/switches", lang)} class="flex items-center justify-between gap-2 p-2 rounded-lg hover:bg-bg-elevated text-xs font-medium text-text-secondary hover:text-text-primary transition-colors group/item">
                      <span class="truncate flex-1 min-w-0 font-sans group-hover/item:text-text-primary">Key Switch Directory</span>
                      <span class="shrink-0 text-[9px] font-mono font-bold text-amber-400 bg-amber-400/10 px-1.5 py-0.5 rounded border border-amber-400/30 whitespace-nowrap">120+</span>
                    </a>
                    <a href={localizeLink("/keyboard-tester/nkro-rollover-test", lang)} class="flex items-center justify-between gap-2 p-2 rounded-lg hover:bg-bg-elevated text-xs font-medium text-text-secondary hover:text-text-primary transition-colors group/item">
                      <span class="truncate flex-1 min-w-0 font-sans group-hover/item:text-text-primary">Multi-Key Rollover</span>
                      <span class="shrink-0 text-[9px] font-mono font-bold text-amber-400 bg-amber-400/10 px-1.5 py-0.5 rounded border border-amber-400/30 whitespace-nowrap">NKRO</span>
                    </a>
                    <a href={localizeLink("/keyboard-tester/mac-keyboard-test", lang)} class="flex items-center justify-between gap-2 p-2 rounded-lg hover:bg-bg-elevated text-xs font-medium text-text-secondary hover:text-text-primary transition-colors group/item">
                      <span class="truncate flex-1 min-w-0 font-sans group-hover/item:text-text-primary">Mac Keyboard Test</span>
                      <span class="shrink-0 text-[9px] font-mono font-bold text-text-muted bg-bg-elevated px-1.5 py-0.5 rounded border border-border-hairline whitespace-nowrap">macOS</span>
                    </a>
                  </div>

                  <!-- Mouse Tests -->
                  <div class="space-y-1">
                    <div class="text-[10px] font-bold text-amber-400 uppercase tracking-wider px-1 mb-1">Mouse Tests</div>
                    <a href={localizeLink("/mouse-test", lang)} class="flex items-center justify-between gap-2 p-2 rounded-lg hover:bg-bg-elevated text-xs font-bold text-text-primary bg-status-pass/10 border border-status-pass/30 transition-colors group/item">
                      <span class="truncate flex-1 min-w-0 font-sans">Mouse Test (5-Button)</span>
                      <span class="shrink-0 text-[9px] font-mono font-bold text-status-pass bg-status-pass/20 px-1.5 py-0.5 rounded border border-status-pass/40 whitespace-nowrap">Clicks</span>
                    </a>
                    <a href={localizeLink("/mouse-test/polling-rate", lang)} class="flex items-center justify-between gap-2 p-2 rounded-lg hover:bg-bg-elevated text-xs font-medium text-text-secondary hover:text-text-primary transition-colors group/item">
                      <span class="truncate flex-1 min-w-0 font-sans group-hover/item:text-text-primary">Mouse Polling Rate</span>
                      <span class="shrink-0 text-[9px] font-mono font-bold text-status-pass bg-status-pass/10 px-1.5 py-0.5 rounded border border-status-pass/30 whitespace-nowrap">8000Hz</span>
                    </a>
                    <a href={localizeLink("/mouse-test/double-click", lang)} class="flex items-center justify-between gap-2 p-2 rounded-lg hover:bg-bg-elevated text-xs font-medium text-text-secondary hover:text-text-primary transition-colors group/item">
                      <span class="truncate flex-1 min-w-0 font-sans group-hover/item:text-text-primary">Mouse Double Click</span>
                      <span class="shrink-0 text-[9px] font-mono font-bold text-rose-400 bg-rose-400/10 px-1.5 py-0.5 rounded border border-rose-400/30 whitespace-nowrap">Chatter</span>
                    </a>
                    <a href={localizeLink("/mouse-test/dpi-calculator", lang)} class="flex items-center justify-between gap-2 p-2 rounded-lg hover:bg-bg-elevated text-xs font-medium text-text-secondary hover:text-text-primary transition-colors group/item">
                      <span class="truncate flex-1 min-w-0 font-sans group-hover/item:text-text-primary">Mouse DPI Calculator</span>
                      <span class="shrink-0 text-[9px] font-mono font-bold text-status-pass bg-status-pass/10 px-1.5 py-0.5 rounded border border-status-pass/30 whitespace-nowrap">DPI</span>
                    </a>
                    <a href={localizeLink("/mouse-test/sensitivity-converter", lang)} class="flex items-center justify-between gap-2 p-2 rounded-lg hover:bg-bg-elevated text-xs font-medium text-text-secondary hover:text-text-primary transition-colors group/item">
                      <span class="truncate flex-1 min-w-0 font-sans group-hover/item:text-text-primary">Game Sensitivity</span>
                      <span class="shrink-0 text-[9px] font-mono font-bold text-cyan-400 bg-cyan-400/10 px-1.5 py-0.5 rounded border border-cyan-400/30 whitespace-nowrap">Aim</span>
                    </a>
                    <a href={localizeLink("/mouse-test/edpi-calculator", lang)} class="flex items-center justify-between gap-2 p-2 rounded-lg hover:bg-bg-elevated text-xs font-medium text-text-secondary hover:text-text-primary transition-colors group/item">
                      <span class="truncate flex-1 min-w-0 font-sans group-hover/item:text-text-primary">eDPI &amp; Pro Player</span>
                      <span class="shrink-0 text-[9px] font-mono font-bold text-cyan-400 bg-cyan-400/10 px-1.5 py-0.5 rounded border border-cyan-400/30 whitespace-nowrap">eDPI</span>
                    </a>
                  </div>
                </div>

                <div class="pt-2 border-t border-border-hairline/60 flex items-center justify-between text-[11px] font-sans">
                  <a href={localizeLink("/keyboard-tester", lang)} class="text-amber-400 font-bold hover:underline">Open Keyboard Suite &rarr;</a>
                  <a href={localizeLink("/mouse-test", lang)} class="text-status-pass font-bold hover:underline">Open Mouse Suite &rarr;</a>
                </div>
              </div>
            </div>
          </div>

          <!-- Pillar 3: Controller & Touch -->
          <div class="relative group">
            <button 
              class:list={[
                "flex items-center gap-1.5 px-3 py-2 rounded-lg transition-all cursor-pointer font-sans text-xs",
                (Astro.url.pathname.includes('/controller-test') || Astro.url.pathname.includes('/touch-tests') || Astro.url.pathname.includes('/touch-matrix'))
                  ? 'bg-bg-elevated text-emerald-400 font-semibold border border-emerald-500/30' 
                  : 'text-text-secondary hover:text-text-primary hover:bg-bg-elevated/60 border border-transparent'
              ]}
            >
              <span>Gamepad &amp; Touch</span>
              <svg class="w-3 h-3 text-text-muted group-hover:text-text-primary group-hover:rotate-180 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </button>

            <!-- Controller & Touch Dropdown Overlay (Centered Positioned) -->
