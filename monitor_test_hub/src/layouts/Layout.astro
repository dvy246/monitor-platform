        <a href={localizeLink("/touch-tests", lang)} class="block py-1.5 hover:text-status-pass font-bold transition-colors">{t.touchTests} (6 Tools)</a>
        <a href={localizeLink("/input-tests/mouse-polling", lang)} class="block py-1.5 hover:text-status-pass font-bold transition-colors">{t.inputTests} (4 Tools)</a>
        <a href={localizeLink("/audio-tests/mic-noise-floor", lang)} class="block py-1.5 hover:text-status-pass font-bold transition-colors">{t.audioTests} (2 Tools)</a>
        <a href={localizeLink("/arcade", lang)} class="block py-1.5 hover:text-status-pass font-bold transition-colors">{t.arcadeSuite} (Micro-Games)</a>
