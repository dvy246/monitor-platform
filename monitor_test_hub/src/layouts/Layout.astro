---
import SEOHead from '../components/seo/SEOHead.astro';
import MedicalBounceBanner from '../components/seo/MedicalBounceBanner.astro';
import HardwarePassportModal from '../components/diagnostics/HardwarePassportModal.astro';
import FloatingActionMenu from '../components/ui/FloatingActionMenu.astro';
import { useTranslations, localizeLink } from '../utils/i18n';
import '../styles/global.css';

export interface Props {
  title: string;
  description: string;
  showBounceBanner?: boolean;
  faqs?: Array<{ question: string; answer: string }>;
  canonicalUrl?: string;
  ogImage?: string;
  ogType?: string;
  noindex?: boolean;
  schemaItems?: any[];
}

const { title, description, showBounceBanner = true, faqs = [], canonicalUrl, ogImage, ogType, noindex, schemaItems = [] } = Astro.props;
const { t, lang } = useTranslations(Astro.url.pathname);
---


<!DOCTYPE html>
<html lang={lang} class="scroll-smooth overflow-x-hidden w-full max-w-full">
  <head>
    <SEOHead title={title} description={description} faqs={faqs} canonicalUrl={canonicalUrl} ogImage={ogImage} ogType={ogType} noindex={noindex} schemaItems={schemaItems} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;500;600;700&family=Geist:wght@300;400;500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    
    <!-- Dark/Light Theme Initialization Script -->
    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        return window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
      })();
      if (theme === 'light') {
        document.documentElement.classList.add('light');
      } else {
        document.documentElement.classList.remove('light');
      }
    </script>
  </head>
  <body class="bg-bg-canvas bg-precision-grid text-text-primary min-h-dvh flex flex-col antialiased selection:bg-status-pass selection:text-text-on-accent overflow-x-hidden w-full max-w-full">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:bg-status-pass focus:text-text-on-accent focus:px-4 focus:py-2 focus:rounded-md focus:font-bold focus:z-50">
      Skip to main content
    </a>

    <!-- Medical Bounce Neutralizer Top Notice Bar -->
    {showBounceBanner && <MedicalBounceBanner />}

    <!-- Header Navigation Shell -->
    <header class="border-b border-border-hairline/80 bg-bg-canvas/90 backdrop-blur-xl sticky top-0 z-40 font-mono transform-gpu shadow-xl">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-12 sm:h-14 flex items-center justify-between gap-2 sm:gap-4">
        
        <!-- Left Group: Logo Emblem -->
        <div class="flex items-center gap-3 shrink-0">
          <a href={localizeLink("/", lang)} class="flex items-center gap-2.5 group cursor-pointer">
            <div aria-hidden="true" class="w-7 h-7 rounded-lg border border-status-pass/50 bg-bg-surface flex items-center justify-center font-bold text-xs text-text-primary group-hover:border-status-pass group-hover:shadow-[0_0_16px_rgba(5,150,105,0.6)] transition-all duration-200">
              M
            </div>
            <span class="text-xs font-bold tracking-widest text-text-primary uppercase group-hover:text-status-pass transition-colors">
              MONITOR<span class="text-status-pass">/</span>HUB
            </span>
          </a>
        </div>

        <!-- Center Group: Streamlined 4-Pillar Navigation Deck -->
        <nav class="hidden md:flex items-center gap-1.5 text-xs font-sans font-medium" aria-label="Main Navigation">
          
          <!-- Pillar 1: Display Tests Mega-Menu -->
          <div class="relative group">
            <button 
              class:list={[
                "flex items-center gap-1.5 px-3 py-1.5 rounded-lg transition-colors cursor-pointer",
                (Astro.url.pathname.includes('/display-tests') || Astro.url.pathname.includes('/refresh-rate-test') || Astro.url.pathname.includes('/white-screen') || Astro.url.pathname.includes('/vrr-stutter-test'))
                  ? 'bg-bg-elevated text-status-pass font-semibold border border-status-pass/30' 
                  : 'text-text-secondary hover:text-text-primary hover:bg-bg-elevated/60 border border-transparent'
              ]}
            >
              <span>Display Tests</span>
              <svg class="w-3 h-3 text-text-muted group-hover:text-text-primary group-hover:rotate-180 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </button>

            <!-- Display Tests Dropdown Overlay -->
            <div class="absolute left-0 top-full pt-2 opacity-0 translate-y-1 pointer-events-none group-hover:opacity-100 group-hover:translate-y-0 group-hover:pointer-events-auto transition-all duration-200 z-50">
              <div class="w-[580px] bg-bg-surface/98 backdrop-blur-2xl border border-border-hairline rounded-2xl p-4 shadow-2xl shadow-black/80 font-mono space-y-3">
                <div class="flex items-center justify-between pb-2 border-b border-border-hairline/60">
                  <span class="text-xs font-bold text-text-primary uppercase tracking-wider font-sans">Screen &amp; Display Testing Suite</span>
                  <span class="text-[10px] text-status-pass font-bold">100% WebGL Client-Side</span>
                </div>

                <div class="grid grid-cols-2 gap-4">
                  <!-- Refresh Rate & Panel Tests -->
                  <div class="space-y-1">
                    <div class="text-[10px] font-bold text-status-pass uppercase tracking-wider px-1">Speed &amp; Defect Tests</div>
                    <a href={localizeLink("/refresh-rate-test", lang)} class="flex items-center justify-between p-1.5 rounded-md hover:bg-bg-elevated text-xs text-text-secondary hover:text-text-primary transition-colors">
                      <span>Screen Refresh Rate &amp; Hz Test</span>
                      <span class="text-[9px] text-cyan-400 font-bold">Hz / FPS</span>
                    </a>
                    <a href={localizeLink("/display-tests/dead-pixel", lang)} class="flex items-center justify-between p-1.5 rounded-md hover:bg-bg-elevated text-xs text-text-secondary hover:text-text-primary transition-colors">
                      <span>Dead Pixel Inspector</span>
                      <span class="text-[9px] text-status-pass font-bold">ISO 9241</span>
                    </a>
                    <a href={localizeLink("/display-tests/dead-pixel-test", lang)} class="flex items-center justify-between p-1.5 rounded-md hover:bg-bg-elevated text-xs text-text-secondary hover:text-text-primary transition-colors">
                      <span>Device Dead Pixel Directory</span>
                      <span class="text-[9px] text-cyan-400 font-bold">Directory</span>
                    </a>
                    <a href={localizeLink("/display-tests/sub-pixel", lang)} class="flex items-center justify-between p-1.5 rounded-md hover:bg-bg-elevated text-xs text-text-secondary hover:text-text-primary transition-colors">
                      <span>OLED Sub-Pixel Text Fringing</span>
                      <span class="text-[9px] text-status-pass font-bold">Reticle</span>
                    </a>
                    <a href={localizeLink("/display-tests/hdr-test", lang)} class="flex items-center justify-between p-1.5 rounded-md hover:bg-bg-elevated text-xs text-text-secondary hover:text-text-primary transition-colors">
                      <span>HDR ST 2084 PQ &amp; ABL</span>
                      <span class="text-[9px] text-status-pass font-bold">1000 Nits</span>
                    </a>
                    <a href={localizeLink("/display-tests/uniformity", lang)} class="flex items-center justify-between p-1.5 rounded-md hover:bg-bg-elevated text-xs text-text-secondary hover:text-text-primary transition-colors">
                      <span>OLED 5% Gray Uniformity</span>
                      <span class="text-[9px] text-text-muted">Banding</span>
                    </a>
                    <a href={localizeLink("/display-tests/vrr", lang)} class="flex items-center justify-between p-1.5 rounded-md hover:bg-bg-elevated text-xs text-text-secondary hover:text-text-primary transition-colors">
                      <span>540Hz+ VRR Stutter Sweep</span>
                      <span class="text-[9px] text-status-pass font-bold">540Hz</span>
                    </a>
                  </div>

                  <!-- Color, Contrast & Lighting -->
                  <div class="space-y-1">
                    <div class="text-[10px] font-bold text-status-pass uppercase tracking-wider px-1">Color &amp; Lighting</div>
                    <a href={localizeLink("/monitor-color-calibration", lang)} class="flex items-center justify-between p-1.5 rounded-md hover:bg-bg-elevated text-xs text-text-secondary hover:text-text-primary transition-colors">
                      <span>Monitor Color Calibration Suite</span>
                      <span class="text-[9px] text-emerald-400 font-bold">ICC v4.3</span>
                    </a>
                    <a href={localizeLink("/display-tests/contrast-accessibility", lang)} class="flex items-center justify-between p-1.5 rounded-md hover:bg-bg-elevated text-xs text-text-secondary hover:text-text-primary transition-colors">
                      <span>APCA Contrast &amp; Accessibility</span>
                      <span class="text-[9px] text-cyan-400 font-bold">WCAG 3.0</span>
                    </a>
                    <a href={localizeLink("/display-tests/delta-e-calculator", lang)} class="flex items-center justify-between p-1.5 rounded-md hover:bg-bg-elevated text-xs text-text-secondary hover:text-text-primary transition-colors">
                      <span>Delta-E Color Accuracy</span>
                      <span class="text-[9px] text-emerald-400 font-bold">ΔE00</span>
                    </a>
                    <a href={localizeLink("/display-tests/color-gamut", lang)} class="flex items-center justify-between p-1.5 rounded-md hover:bg-bg-elevated text-xs text-text-secondary hover:text-text-primary transition-colors">
                      <span>Color Gamut &amp; ICC Profile</span>
                      <span class="text-[9px] text-status-pass font-bold">ICC v4.3</span>
                    </a>
                    <a href={localizeLink("/white-screen", lang)} class="flex items-center justify-between p-1.5 rounded-md hover:bg-bg-elevated text-xs text-text-secondary hover:text-text-primary transition-colors">
                      <span>White Screen &amp; Fill Lighting</span>
                      <span class="text-[9px] text-text-muted">Kelvin</span>
                    </a>
                    <a href={localizeLink("/display-tests/ppi-calculator", lang)} class="flex items-center justify-between p-1.5 rounded-md hover:bg-bg-elevated text-xs text-text-secondary hover:text-text-primary transition-colors">
                      <span>PPI &amp; Arcminute Acuity</span>
                      <span class="text-[9px] text-text-muted">Optics</span>
                    </a>
                  </div>
                </div>

                <div class="pt-2 border-t border-border-hairline/60 flex items-center justify-between text-[11px] font-sans">
                  <a href={localizeLink("/display-tests", lang)} class="text-status-pass font-bold hover:underline">View All Display Tests Hub &rarr;</a>
                  <a href={localizeLink("/refresh-rate-test", lang)} class="text-cyan-400 font-bold hover:underline">Refresh Rate Test &rarr;</a>
                </div>
              </div>
            </div>
          </div>

          <!-- Pillar 2: Touch Tests Mega-Menu -->
          <div class="relative group">
            <button 
              class:list={[
                "flex items-center gap-1.5 px-3 py-1.5 rounded-lg transition-colors cursor-pointer",
                (Astro.url.pathname.includes('/touch-tests') || Astro.url.pathname.includes('/touch-matrix'))
                  ? 'bg-bg-elevated text-emerald-400 font-semibold border border-emerald-500/30' 
                  : 'text-text-secondary hover:text-text-primary hover:bg-bg-elevated/60 border border-transparent'
              ]}
            >
              <span>Touch Tests</span>
              <svg class="w-3 h-3 text-text-muted group-hover:text-text-primary group-hover:rotate-180 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </button>

            <!-- Touch & Mobile Dropdown Overlay -->
            <div class="absolute left-0 top-full pt-2 opacity-0 translate-y-1 pointer-events-none group-hover:opacity-100 group-hover:translate-y-0 group-hover:pointer-events-auto transition-all duration-200 z-50">
              <div class="w-[560px] bg-bg-surface/98 backdrop-blur-2xl border border-border-hairline rounded-2xl p-4 shadow-2xl shadow-black/80 font-mono space-y-3">
                <div class="flex items-center justify-between pb-2 border-b border-border-hairline/60">
                  <span class="text-xs font-bold text-text-primary uppercase tracking-wider font-sans">Touch &amp; Mobile Diagnostics</span>
                  <span class="text-[10px] text-emerald-400 font-bold">Touch Matrix</span>
                </div>

                <div class="grid grid-cols-2 gap-4">
                  <!-- Touch Matrix & Hardware Noise -->
                  <div class="space-y-1">
                    <div class="text-[10px] font-bold text-emerald-400 uppercase tracking-wider px-1">Hardware &amp; Matrix</div>
                    <a href={localizeLink("/touch-matrix", lang)} class="flex items-center justify-between p-1.5 rounded-md hover:bg-bg-elevated text-xs text-text-secondary hover:text-text-primary transition-colors">
                      <span>Touch Charger EMI Inspector</span>
                      <span class="text-[9px] text-emerald-400 font-bold">RMS SNR</span>
                    </a>
                    <a href={localizeLink("/touch-tests/dead-zone", lang)} class="flex items-center justify-between p-1.5 rounded-md hover:bg-bg-elevated text-xs text-text-secondary hover:text-text-primary transition-colors">
                      <span>Touch Matrix Dead-Zone</span>
                      <span class="text-[9px] text-text-muted">Matrix</span>
                    </a>
                    <a href={localizeLink("/touch-tests/multi-touch", lang)} class="flex items-center justify-between p-1.5 rounded-md hover:bg-bg-elevated text-xs text-text-secondary hover:text-text-primary transition-colors">
                      <span>Multi-Touch Point Counter</span>
                      <span class="text-[9px] text-text-muted">10-Point</span>
                    </a>
                    <a href={localizeLink("/touch-tests/touch-sampling-rate", lang)} class="flex items-center justify-between p-1.5 rounded-md hover:bg-bg-elevated text-xs text-text-secondary hover:text-text-primary transition-colors">
                      <span>Touch Sampling Rate &amp; Latency</span>
                      <span class="text-[9px] text-emerald-400 font-bold">240Hz+</span>
                    </a>
                  </div>

                  <!-- Kinematics & Precision -->
                  <div class="space-y-1">
                    <div class="text-[10px] font-bold text-emerald-400 uppercase tracking-wider px-1">Precision &amp; Latency</div>
                    <a href={localizeLink("/touch-tests/vector-precision", lang)} class="flex items-center justify-between p-1.5 rounded-md hover:bg-bg-elevated text-xs text-text-secondary hover:text-text-primary transition-colors">
                      <span>Vector Line Precision</span>
                      <span class="text-[9px] text-text-muted">RMS Noise</span>
                    </a>
                    <a href={localizeLink("/touch-tests/swipe-velocity", lang)} class="flex items-center justify-between p-1.5 rounded-md hover:bg-bg-elevated text-xs text-text-secondary hover:text-text-primary transition-colors">
                      <span>Gesture Kinematics &amp; Velocity</span>
                      <span class="text-[9px] text-text-muted">px/ms</span>
                    </a>
                    <a href={localizeLink("/touch-tests/input-lag", lang)} class="flex items-center justify-between p-1.5 rounded-md hover:bg-bg-elevated text-xs text-text-secondary hover:text-text-primary transition-colors">
                      <span>Click-to-Photon Touch Lag</span>
                      <span class="text-[9px] text-emerald-400 font-bold">Latency</span>
                    </a>
                    <a href={localizeLink("/touch-matrix", lang)} class="flex items-center justify-between p-1.5 rounded-md hover:bg-bg-elevated text-xs text-text-secondary hover:text-text-primary transition-colors">
                      <span>Touch Matrix Grid Inspector</span>
                      <span class="text-[9px] text-text-muted">Grid</span>
                    </a>
                  </div>
                </div>

                <div class="pt-2 border-t border-border-hairline/60 flex items-center justify-between text-[11px] font-sans">
                  <a href={localizeLink("/touch-tests", lang)} class="text-emerald-400 font-bold hover:underline">View All Touch Tests &rarr;</a>
                  <a href={localizeLink("/touch-matrix", lang)} class="text-text-muted hover:text-text-primary font-mono">Touch Matrix Grid &rarr;</a>
                </div>
              </div>
            </div>
          </div>

          <!-- Pillar 3: Calculators & Tools Mega-Menu -->
          <div class="relative group">
            <button 
              class:list={[
                "flex items-center gap-1.5 px-3 py-1.5 rounded-lg transition-colors cursor-pointer",
                (Astro.url.pathname.includes('/keyboard-tester') || Astro.url.pathname.includes('/benchmarks') || Astro.url.pathname.includes('/electricity-cost') || Astro.url.pathname.includes('/tv-viewing-distance') || Astro.url.pathname.includes('/wire-gauge-calculator') || Astro.url.pathname.includes('/3d-print-cost'))
                  ? 'bg-bg-elevated text-cyan-400 font-semibold border border-cyan-500/30' 
                  : 'text-text-secondary hover:text-text-primary hover:bg-bg-elevated/60 border border-transparent'
              ]}
            >
              <span>Calculators &amp; Tools</span>
              <svg class="w-3 h-3 text-text-muted group-hover:text-text-primary group-hover:rotate-180 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </button>

            <!-- Calculators & Tools Dropdown Overlay -->
            <div class="absolute left-0 top-full pt-2 opacity-0 translate-y-1 pointer-events-none group-hover:opacity-100 group-hover:translate-y-0 group-hover:pointer-events-auto transition-all duration-200 z-50">
              <div class="w-[580px] bg-bg-surface/98 backdrop-blur-2xl border border-border-hairline rounded-2xl p-4 shadow-2xl shadow-black/80 font-mono space-y-3">
                <div class="flex items-center justify-between pb-2 border-b border-border-hairline/60">
                  <span class="text-xs font-bold text-text-primary uppercase tracking-wider font-sans">Hardware Calculators &amp; Input Diagnostics</span>
                  <span class="text-[10px] text-cyan-400 font-bold">Calculators</span>
                </div>

                <div class="grid grid-cols-2 gap-4">
                  <!-- Keyboards & Peripherals -->
                  <div class="space-y-1">
                    <div class="text-[10px] font-bold text-cyan-400 uppercase tracking-wider px-1">Keyboard &amp; Input</div>
                    <a href={localizeLink("/keyboard-tester", lang)} class="flex items-center justify-between p-1.5 rounded-md hover:bg-bg-elevated text-xs text-text-secondary hover:text-text-primary transition-colors">
                      <span>Keyboard Diagnostic Suite</span>
                      <span class="text-[9px] text-cyan-400 font-bold">NKRO Hub</span>
                    </a>
                    <a href={localizeLink("/keyboard-tester/key-chatter-test", lang)} class="flex items-center justify-between p-1.5 rounded-md hover:bg-bg-elevated text-xs text-text-secondary hover:text-text-primary transition-colors">
                      <span>Switch Chatter Analysis</span>
                      <span class="text-[9px] text-rose-400 font-bold">Bounce</span>
                    </a>
                    <a href={localizeLink("/keyboard-tester/switches", lang)} class="flex items-center justify-between p-1.5 rounded-md hover:bg-bg-elevated text-xs text-text-secondary hover:text-text-primary transition-colors">
                      <span>120+ Switch Bounce Hub</span>
                      <span class="text-[9px] text-cyan-400 font-bold">120+</span>
                    </a>
                    <a href={localizeLink("/input-tests/mouse-polling", lang)} class="flex items-center justify-between p-1.5 rounded-md hover:bg-bg-elevated text-xs text-text-secondary hover:text-text-primary transition-colors">
                      <span>8000Hz Mouse Polling &amp; Pacing</span>
                      <span class="text-[9px] text-status-pass font-bold">8000Hz</span>
                    </a>
                    <a href={localizeLink("/benchmarks/gamepad-drift", lang)} class="flex items-center justify-between p-1.5 rounded-md hover:bg-bg-elevated text-xs text-text-secondary hover:text-text-primary transition-colors">
                      <span>Gamepad Drift Inspector</span>
                      <span class="text-[9px] text-emerald-400 font-bold">HTML5</span>
                    </a>
                    <a href={localizeLink("/benchmarks/wireless-latency", lang)} class="flex items-center justify-between p-1.5 rounded-md hover:bg-bg-elevated text-xs text-text-secondary hover:text-text-primary transition-colors">
                      <span>Wireless Audio &amp; Input Latency</span>
                      <span class="text-[9px] text-amber-400 font-bold">WebAudio</span>
                    </a>
                  </div>

                  <!-- Technical Calculators -->
                  <div class="space-y-1">
                    <div class="text-[10px] font-bold text-amber-400 uppercase tracking-wider px-1">Hardware Calculators</div>
                    <a href={localizeLink("/benchmarks/pc-bottleneck", lang)} class="flex items-center justify-between p-1.5 rounded-md hover:bg-bg-elevated text-xs text-text-secondary hover:text-text-primary transition-colors">
                      <span>PC Bottleneck &amp; FPS Estimator</span>
                      <span class="text-[9px] text-amber-400 font-bold">CPU/GPU</span>
                    </a>
                    <a href={localizeLink("/display-tests/electricity-cost", lang)} class="flex items-center justify-between p-1.5 rounded-md hover:bg-bg-elevated text-xs text-text-secondary hover:text-text-primary transition-colors">
                      <span>Appliance Energy Cost</span>
                      <span class="text-[9px] text-amber-400 font-bold">50 States</span>
                    </a>
                    <a href={localizeLink("/display-tests/tv-viewing-distance", lang)} class="flex items-center justify-between p-1.5 rounded-md hover:bg-bg-elevated text-xs text-text-secondary hover:text-text-primary transition-colors">
                      <span>TV &amp; Projector Distance</span>
                      <span class="text-[9px] text-amber-400 font-bold">THX/SMPTE</span>
                    </a>
                    <a href={localizeLink("/benchmarks/wire-gauge-calculator", lang)} class="flex items-center justify-between p-1.5 rounded-md hover:bg-bg-elevated text-xs text-text-secondary hover:text-text-primary transition-colors">
                      <span>NEC 2026 Wire Gauge</span>
                      <span class="text-[9px] text-amber-400 font-bold">NEC '26</span>
                    </a>
                    <a href={localizeLink("/benchmarks/3d-print-cost", lang)} class="flex items-center justify-between p-1.5 rounded-md hover:bg-bg-elevated text-xs text-text-secondary hover:text-text-primary transition-colors">
                      <span>3D Print Cost Estimator</span>
                      <span class="text-[9px] text-amber-400 font-bold">Etsy</span>
                    </a>
                    <a href={localizeLink("/benchmarks/room-mode-calculator", lang)} class="flex items-center justify-between p-1.5 rounded-md hover:bg-bg-elevated text-xs text-text-secondary hover:text-text-primary transition-colors">
                      <span>Acoustic Room Mode</span>
                      <span class="text-[9px] text-purple-400 font-bold">Schroeder</span>
                    </a>
                  </div>
                </div>

                <div class="pt-2 border-t border-border-hairline/60 flex items-center justify-between text-[11px] font-sans">
                  <a href={localizeLink("/keyboard-tester", lang)} class="text-cyan-400 font-bold hover:underline">Keyboard Diagnostic Suite &rarr;</a>
                  <a href={localizeLink("/benchmarks/pc-bottleneck", lang)} class="text-text-muted hover:text-text-primary">PC Bottleneck Directory &rarr;</a>
                </div>
              </div>
            </div>
          </div>

          <!-- Pillar 4: Device Database Mega-Menu -->
          <div class="relative group">
            <button 
              class:list={[
                "flex items-center gap-1.5 px-3 py-1.5 rounded-lg transition-colors cursor-pointer",
                (Astro.url.pathname.includes('/models') || Astro.url.pathname.includes('/compare') || Astro.url.pathname.includes('/passport') || Astro.url.pathname.includes('/arcade') || Astro.url.pathname.includes('/screen-test-meaning'))
                  ? 'bg-bg-elevated text-purple-400 font-semibold border border-purple-500/30' 
                  : 'text-text-secondary hover:text-text-primary hover:bg-bg-elevated/60 border border-transparent'
              ]}
            >
              <span>Device Database</span>
              <svg class="w-3 h-3 text-text-muted group-hover:text-text-primary group-hover:rotate-180 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </button>

            <!-- Device Database Dropdown Overlay -->
