---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="404 - Coordinates Lost" 
  description="The requested page could not be resolved inside our diagnostic screen matrix."
  showBounceBanner={false}
>
  <div class="flex-grow flex flex-col items-center justify-center p-8 text-center font-mono">
    <div class="max-w-lg space-y-8">
      <!-- Error Code Badge -->
      <div class="w-24 h-24 mx-auto rounded-full bg-diagnostic-deadRed/10 border-2 border-diagnostic-deadRed flex items-center justify-center text-diagnostic-deadRed text-3xl font-bold heading-brand shadow-[0_0_24px_rgba(255,51,102,0.3)] animate-pulse">
        404
      </div>
      
      <!-- Error Message -->
      <div class="space-y-3">
        <h1 class="heading-brand text-2xl md:text-3xl font-extrabold text-text-primary uppercase tracking-wider">
          Coordinates Lost
        </h1>
        <p class="text-text-secondary text-sm leading-relaxed max-w-sm mx-auto font-sans">
          The requested URL path could not be resolved inside our diagnostic testing matrix. The page may have been repositioned, renamed, or removed from the grid.
        </p>
      </div>

      <!-- Primary CTA -->
      <a href="/" class="inline-flex items-center gap-2 bg-status-pass hover:bg-status-pass/80 text-text-on-accent font-extrabold text-xs px-6 py-3 rounded-xl transition-all shadow-[0_0_15px_rgba(0,255,136,0.25)] hover:shadow-[0_0_22px_rgba(0,255,136,0.4)]">
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
        Re-lock Coordinates — Back to Home
      </a>

      <!-- Suggested Diagnostic Links -->
      <div class="border-t border-border-hairline pt-6 space-y-3">
        <p class="text-text-muted text-[10px] uppercase tracking-widest">Or navigate to a test suite:</p>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 text-xs">
          <a href="/display-tests" class="flex flex-col items-center gap-1.5 px-4 py-3 rounded-xl bg-bg-surface border border-border-hairline hover:border-status-pass hover:text-status-pass text-text-secondary transition-all shadow-specular-top group">
            <svg class="w-5 h-5 text-text-muted group-hover:text-status-pass transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>
            <span class="font-bold uppercase tracking-wider text-[10px]">Display Tests</span>
            <span class="text-text-muted text-[9px] font-sans">Sub-Pixel, Uniformity, VRR</span>
          </a>
          <a href="/touch-tests" class="flex flex-col items-center gap-1.5 px-4 py-3 rounded-xl bg-bg-surface border border-border-hairline hover:border-status-pass hover:text-status-pass text-text-secondary transition-all shadow-specular-top group">
            <svg class="w-5 h-5 text-text-muted group-hover:text-status-pass transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M7 11.5V14m0-2.5v-6a1.5 1.5 0 113 0m-3 6a1.5 1.5 0 00-3 0v2a7.5 7.5 0 0015 0v-5a1.5 1.5 0 00-3 0m-6-3V11m0-5.5v-1a1.5 1.5 0 013 0v1m0 0V11m0-5.5a1.5 1.5 0 013 0v3m0 0V11"/></svg>
            <span class="font-bold uppercase tracking-wider text-[10px]">Touch Tests</span>
            <span class="text-text-muted text-[9px] font-sans">Dead Zone, Multi-Touch</span>
          </a>
          <a href="/arcade" class="flex flex-col items-center gap-1.5 px-4 py-3 rounded-xl bg-bg-surface border border-border-hairline hover:border-status-pass hover:text-status-pass text-text-secondary transition-all shadow-specular-top group">
            <svg class="w-5 h-5 text-text-muted group-hover:text-status-pass transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/><path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            <span class="font-bold uppercase tracking-wider text-[10px]">Arcade Suite</span>
            <span class="text-text-muted text-[9px] font-sans">Ghosting, Reflex, Color</span>
          </a>
        </div>
      </div>

      <!-- Error Code Footer -->
      <p class="text-text-muted text-[9px] font-mono tracking-widest">
        ERROR_CODE: PATH_UNRESOLVED · MATRIX: DIAGNOSTIC_v2 · STATUS: 404
      </p>
    </div>
  </div>
</Layout>
