---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="500 - Diagnostic Engine Failure" 
  description="An internal error occurred in the page compilation pipeline. Our diagnostic systems have been notified."
  showBounceBanner={false}
>
  <div class="flex-grow flex flex-col items-center justify-center p-8 text-center font-mono">
    <div class="max-w-lg space-y-8">
      <!-- Error Code Badge -->
      <div class="w-24 h-24 mx-auto rounded-full bg-diagnostic-deadRed/10 border-2 border-diagnostic-deadRed flex items-center justify-center text-diagnostic-deadRed text-3xl font-bold heading-brand shadow-[0_0_24px_rgba(255,51,102,0.3)]">
        500
      </div>
      
      <!-- Error Message -->
      <div class="space-y-3">
        <h1 class="heading-brand text-2xl md:text-3xl font-extrabold text-text-primary uppercase tracking-wider">
          Engine Interrupted
        </h1>
        <p class="text-text-secondary text-sm leading-relaxed max-w-sm mx-auto font-sans">
          Something went wrong in the page compilation pipeline. This is usually a transient issue — retry in a moment or return to the home grid.
        </p>
      </div>

      <!-- Status Indicator -->
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-bg-surface border border-diagnostic-deadRed/30 text-[11px] text-diagnostic-deadRed font-mono mx-auto">
        <span class="w-1.5 h-1.5 rounded-full bg-diagnostic-deadRed animate-pulse"></span>
        INTERNAL_SERVER_ERROR · PIPELINE_FAULT
      </div>

      <!-- Action Buttons -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
        <button 
          onclick="window.location.reload()" 
          class="inline-flex items-center gap-2 bg-bg-surface hover:bg-bg-elevated border border-border-subtle hover:border-status-pass text-text-primary font-bold text-xs px-6 py-3 rounded-xl transition-all shadow-specular-top cursor-pointer"
        >
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
          Retry Request
        </button>
        <a 
          href="/" 
          class="inline-flex items-center gap-2 bg-status-pass hover:bg-status-pass/80 text-text-on-accent font-extrabold text-xs px-6 py-3 rounded-xl transition-all shadow-[0_0_15px_rgba(0,255,136,0.25)] hover:shadow-[0_0_22px_rgba(0,255,136,0.4)]"
        >
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
          Return to Home Grid
        </a>
      </div>

      <!-- Alternative Nav Links -->
      <div class="border-t border-border-hairline pt-6 flex flex-wrap items-center justify-center gap-4 text-[11px]">
        <a href="/display-tests" class="text-text-muted hover:text-status-pass transition-colors">Display Tests</a>
        <span class="text-border-hairline">·</span>
        <a href="/touch-tests" class="text-text-muted hover:text-status-pass transition-colors">Touch Tests</a>
        <span class="text-border-hairline">·</span>
        <a href="/arcade" class="text-text-muted hover:text-status-pass transition-colors">Arcade Suite</a>
        <span class="text-border-hairline">·</span>
        <a href="/screen-test-meaning" class="text-text-muted hover:text-status-pass transition-colors">Glossary</a>
      </div>

      <!-- Error Code Footer -->
      <p class="text-text-muted text-[9px] font-mono tracking-widest">
        ERROR_CODE: INTERNAL_SERVER_ERROR · MATRIX: DIAGNOSTIC_v2 · STATUS: 500
      </p>
    </div>
  </div>
</Layout>
