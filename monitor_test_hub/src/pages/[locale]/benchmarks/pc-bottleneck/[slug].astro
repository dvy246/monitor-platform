---
import Layout from '../../../../layouts/Layout.astro';
import PcBottleneckInspector from '../../../../components/diagnostics/PcBottleneckInspector.astro';
import SEOHead from '../../../../components/seo/SEOHead.astro';
import SchemaGraph from '../../../../components/seo/SchemaGraph.astro';
import { PcBottleneckEngine } from '../../../../engine/PcBottleneckEngine';

export function getStaticPaths() {
  const locales = ['es', 'de', 'fr'];
  const cpus = PcBottleneckEngine.CPUS;
  const gpus = PcBottleneckEngine.GPUS;

  const paths = [];

  for (const locale of locales) {
    for (const cpu of cpus) {
      for (const gpu of gpus) {
        const slug = `${cpu.id}-with-${gpu.id}`;
        paths.push({
          params: { locale, slug },
          props: { cpu, gpu }
        });
      }
    }
  }

  return paths;
}

const { locale } = Astro.params;
const { cpu, gpu } = Astro.props;

const seoTitle = `${cpu.name} with ${gpu.name} Bottleneck & FPS Calculator (${locale.toUpperCase()})`;
const seoDescription = `Detailed bottleneck analysis and game FPS benchmarks for ${cpu.name} paired with ${gpu.name}.`;
---

<Layout title={seoTitle} description={seoDescription} canonicalUrl={`https://monitortester.com/${locale}`}>

  <div class="min-h-screen bg-[#08080a] text-slate-100 py-12 px-4">
    <div class="max-w-5xl mx-auto space-y-12">
      <section class="text-center space-y-4">
        <h1 class="text-3xl sm:text-4xl font-black text-white tracking-tight">
          {cpu.name} + <span class="text-emerald-400">{gpu.name}</span> ({locale.toUpperCase()})
        </h1>
      </section>

      <PcBottleneckInspector initialCpuId={cpu.id} initialGpuId={gpu.id} />
    </div>
  </div>
</Layout>
