---
import Layout from '../../../../layouts/Layout.astro';
import TvViewingDistanceInspector from '../../../../components/diagnostics/TvViewingDistanceInspector.astro';
import SEOHead from '../../../../components/seo/SEOHead.astro';
import SchemaGraph from '../../../../components/seo/SchemaGraph.astro';

export function getStaticPaths() {
  const locales = ['es', 'de', 'fr'];
  const sizes = [50, 55, 65, 75, 85, 98, 120];

  const paths = [];

  for (const locale of locales) {
    for (const size of sizes) {
      const slug = `${size}-inch-tv`;
      paths.push({
        params: { locale, slug },
        props: { size }
      });
    }
  }

  return paths;
}

const { locale } = Astro.params;
const { size } = Astro.props;

const seoTitle = `${size} Inch TV Viewing Distance Calculator (${locale.toUpperCase()})`;
const seoDescription = `Calculate optimal viewing distance and dimensions for a ${size} inch TV.`;
---

<Layout title={seoTitle} description={seoDescription}>

  <div class="min-h-screen bg-[#08080a] text-slate-100 py-12 px-4">
    <div class="max-w-5xl mx-auto space-y-12">
      <section class="text-center space-y-4">
        <h1 class="text-3xl sm:text-4xl font-black text-white tracking-tight">
          {size} Inch TV Viewing Distance ({locale.toUpperCase()})
        </h1>
      </section>

      <TvViewingDistanceInspector initialDiagonal={size} />
    </div>
  </div>
</Layout>
