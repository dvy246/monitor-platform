---
export function getStaticPaths() {
  const locales = ['es', 'de', 'fr'];
  const hashes = ['a4f8b92c103e57f1', 'f7e1039a482b611c', 'c9b4e18d720a3541', 'd382f1056c9a721e', 'e5190b432a18f77d'];
  const paths = [];

  for (const locale of locales) {
    for (const hash of hashes) {
      paths.push({
        params: { locale, hash }
      });
    }
  }

  return paths;
}
import BasePage from '../../passport/[hash].astro';
---
<BasePage />
