---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import HardwareLimitationNotice from '../../components/disclaimers/HardwareLimitationNotice.astro';
import StepWorkflowSection from '../../components/ui/StepWorkflowSection.astro';
import PanelTypeBreakdownSection from '../../components/ui/PanelTypeBreakdownSection.astro';
import FAQSection from '../../components/ui/FAQSection.astro';

const faqs = [
  {
    question: "What is the Monitor & Touch Arcade Suite?",
    answer: "The Arcade Suite is a set of gamified hardware diagnostic micro-games that evaluate display GtG motion blur, CIEDE2000 color discrimination, click-to-photon latency, and mobile touch digitizer multi-touch precision."
  },
  {
    question: "How do arcade games test display hardware performance?",
    answer: "By replacing abstract test patterns with active visual and interactive targets, the Arcade Suite benchmarks human visual perception combined with microsecond browser timer telemetry."
  },
  {
    question: "Are these arcade tests completely free to play?",
    answer: "Yes, all diagnostic micro-games run client-side in your web browser with 0 ads and zero external software downloads."
  },
  {
    question: "Can I use these tests on mobile smartphones and tablets?",
    answer: "Yes, games like Touch Matrix Defusal and Lag Reflex Sniper are optimized for mobile touchscreens and high-refresh-rate smartphone displays."
  },
  {
    question: "How does Ghosting Invaders measure pixel overdrive?",
    answer: "Ghosting Invaders simulates pursuit tracking camera reticles over dark/light backgrounds to reveal pixel trailing and bright inverse ghosting coronas."
  },
  {
    question: "What is CIEDE2000 (ΔE00) color matching in Color Match Alchemist?",
    answer: "Color Match Alchemist dynamically reduces ΔE color differences to test how accurately your screen renders subtle shades and color gradients."
  },
  {
    question: "How accurately does Lag Reflex Sniper measure input latency?",
    answer: "It uses high-resolution DOM performance.now() timers to calculate millisecond click dispatch latencies and USB mouse polling rates."
  },
  {
    question: "What hardware recommendations apply to gaming monitors?",
    answer: "Fast IPS or OLED panels with high refresh rates (144Hz - 540Hz) and well-tuned pixel overdrive yield optimal arcade scores."
  },
  {
    question: "Can I export my arcade diagnostic scores to a hardware certificate?",
    answer: "Yes, each game generates an exportable SHA-256 signed hardware passport receipt summarizing your test scores."
  },
  {
    question: "Which game should I run first to test my new monitor?",
    answer: "Start with Ghosting Invaders to tune pixel overdrive, followed by Color Match Alchemist for color accuracy and Lag Reflex Sniper for click latency."
  }
];

const seoTitle = "Monitor & Touch Arcade Suite — Gamified Hardware Diagnostics";
const seoDescription = "Examine monitor motion blur, color differences, click latency, and touch accuracy using interactive gamified hardware tests.";
---

<Layout 
  title={seoTitle} 
  description={seoDescription}
  faqs={faqs}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-12 font-sans">
    <div class="text-center max-w-3xl mx-auto">
      <h1 class="heading-brand text-3xl md:text-5xl font-black tracking-tight text-text-primary mb-3 font-mono">
        MONITOR &amp; TOUCH ARCADE SUITE
      </h1>
      <p class="text-text-secondary text-sm md:text-base leading-relaxed font-sans">
        Test your display and pointer inputs in a series of custom interactive micro-games. If your hardware passes, it is certified safe and fully calibrated!
      </p>
    </div>

    <!-- Game Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <!-- Ghosting Invaders -->
      <a href="/arcade/ghosting-invaders" class="bg-[#121215]/90 hover:bg-[#18181b] border border-white/10 hover:border-status-pass/40 rounded-3xl p-6 flex flex-col justify-between transition-all group backdrop-blur-xl shadow-2xl font-mono">
        <div class="space-y-4">
          <div class="w-10 h-10 rounded-lg bg-status-pass/10 flex items-center justify-center text-status-pass border border-status-pass/20">
            <span class="font-extrabold text-sm heading-brand">G1</span>
          </div>
          <h3 class="heading-brand text-lg font-bold text-text-primary group-hover:text-status-pass transition-colors font-mono">Ghosting Invaders</h3>
          <p class="text-text-secondary text-xs md:text-sm leading-relaxed font-sans">
            Pursuit tracking camera simulator. Hold spacebar to match eye velocity and analyze G-to-G trailing ghost blur and overshoot overdrive coronas.
          </p>
        </div>
        <span class="text-status-pass text-xs font-bold flex items-center gap-1 mt-6">
          Insert Coin &amp; Play &rarr;
        </span>
      </a>

      <!-- Color Match Alchemist -->
      <a href="/arcade/color-match-alchemist" class="bg-[#121215]/90 hover:bg-[#18181b] border border-white/10 hover:border-status-pass/40 rounded-3xl p-6 flex flex-col justify-between transition-all group backdrop-blur-xl shadow-2xl font-mono">
        <div class="space-y-4">
          <div class="w-10 h-10 rounded-lg bg-status-info/10 flex items-center justify-center text-status-info border border-status-info/20">
            <span class="font-extrabold text-sm heading-brand">G2</span>
          </div>
          <h3 class="heading-brand text-lg font-bold text-text-primary group-hover:text-status-pass transition-colors font-mono">Color Match Alchemist</h3>
          <p class="text-text-secondary text-xs md:text-sm leading-relaxed font-sans">
            Perceptual color-matching puzzle. Select matching candidates as the Delta-E threshold ($\Delta E_{00}$) dynamically decreases, testing color depth calibration.
          </p>
        </div>
        <span class="text-status-pass text-xs font-bold flex items-center gap-1 mt-6">
          Insert Coin &amp; Play &rarr;
        </span>
      </a>

      <!-- Lag Reflex Sniper -->
      <a href="/arcade/lag-reflex-sniper" class="bg-[#121215]/90 hover:bg-[#18181b] border border-white/10 hover:border-status-pass/40 rounded-3xl p-6 flex flex-col justify-between transition-all group backdrop-blur-xl shadow-2xl font-mono">
        <div class="space-y-4">
          <div class="w-10 h-10 rounded-lg bg-purple-500/10 flex items-center justify-center text-purple-400 border border-purple-500/20">
            <span class="font-extrabold text-sm heading-brand">G3</span>
          </div>
          <h3 class="heading-brand text-lg font-bold text-text-primary group-hover:text-status-pass transition-colors font-mono">Lag Reflex Sniper</h3>
          <p class="text-text-secondary text-xs md:text-sm leading-relaxed font-sans">
            Target shooting latency test. Uses high-resolution performance timers to measure click latency and calculate USB HID polling rates.
          </p>
        </div>
        <span class="text-status-pass text-xs font-bold flex items-center gap-1 mt-6">
          Insert Coin &amp; Play &rarr;
        </span>
      </a>

      <!-- Touch Matrix Defusal -->
      <a href="/arcade/touch-matrix-defusal" class="bg-[#121215]/90 hover:bg-[#18181b] border border-white/10 hover:border-status-pass/40 rounded-3xl p-6 flex flex-col justify-between transition-all group backdrop-blur-xl shadow-2xl font-mono">
        <div class="space-y-4">
          <div class="w-10 h-10 rounded-lg bg-status-fail/10 flex items-center justify-center text-status-fail border border-status-fail/20">
            <span class="font-extrabold text-sm heading-brand">G4</span>
          </div>
          <h3 class="heading-brand text-lg font-bold text-text-primary group-hover:text-status-pass transition-colors font-mono">Touch Matrix Defusal</h3>
          <p class="text-text-secondary text-xs md:text-sm leading-relaxed font-sans">
            Hold and drag energy orbs in screen quadrants to map multi-touch stability and evaluate digitizer continuity.
          </p>
        </div>
        <span class="text-status-pass text-xs font-bold flex items-center gap-1 mt-6">
          Insert Coin &amp; Play &rarr;
        </span>
      </a>
    </div>

    <StepWorkflowSection />
    <PanelTypeBreakdownSection />

    <FAQSection faqs={faqs} title="Monitor & Touch Arcade Suite FAQs" />
  </div>
</Layout>

