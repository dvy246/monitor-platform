---
import Layout from '../../layouts/Layout.astro';
import SpeakerFrequency from '../../components/diagnostics/SpeakerFrequency.astro';

const faqs = [
  {
    question: "How do I test left and right stereo speaker orientation?",
    answer: "The test plays isolated audio tones through the left channel only, then the right channel only. If sound comes from the wrong side, your headphone or speaker cables are reversed."
  },
  {
    question: "What is a frequency response sweep test?",
    answer: "A frequency sweep plays an audio tone smoothly transitioning from 20 Hz (deep bass) up to 20,000 Hz (high treble) to verify that your drivers reproduce all audible sound frequencies without rattling or distortion."
  },
  {
    question: "What is speaker phase inversion?",
    answer: "If one speaker driver's wires are reversed (+ and - swapped), the speaker moves backward while the other moves forward. This out-of-phase condition cancels out bass frequencies and destroys stereo imaging."
  },
  {
    question: "Why can't I hear frequencies above 15,000 Hz during the test?",
    answer: "Human high-frequency hearing naturally declines with age. Furthermore, budget laptop speakers physically cannot reproduce extreme high or low frequencies."
  }
];
---

<Layout 
  title="Speaker & Headphone Test | Stereo Channel & Frequency Sweeper"
  description="Test your speakers and headphones online. Verify left/right stereo channel balance, test 20Hz-20kHz frequency response, and check speaker phase under AES17 standards."
>
  <div class="py-10 px-4 sm:px-6 lg:px-8 space-y-12">
    <section class="max-w-4xl mx-auto text-center space-y-4">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-status-pass/10 border border-status-pass/30 text-xs font-mono text-status-pass font-bold">
        <span>AES17 DIGITAL AUDIO SPECIFICATIONS</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold font-mono tracking-tight text-text-primary">
        Speaker Frequency Response &amp; Stereo Balance Sweeper
      </h1>
      <p class="text-sm sm:text-base text-text-muted leading-relaxed max-w-2xl mx-auto">
        Test your speakers or headphones for stereo channel orientation, left/right volume balance, 20Hz-20kHz frequency response sweeps, and phase inversion.
      </p>
    </section>

    <SpeakerFrequency />

    <article class="max-w-4xl mx-auto space-y-8 bg-bg-surface/80 border border-border-hairline rounded-2xl p-6 sm:p-8 backdrop-blur-xl text-sm text-text-secondary leading-relaxed">
      <h2 class="text-xl font-bold font-mono text-text-primary">Understanding Frequency Response &amp; Stereo Imaging</h2>
      <p>
        Audio transducers (speakers and headphones) convert electronic signals into mechanical air vibrations across the human hearing range (20 Hz to 20,000 Hz). Proper channel balance ensures centered stereo imaging.
      </p>

      <h2 class="text-xl font-bold font-mono text-text-primary">Frequently Asked Questions</h2>
      <div class="space-y-4">
        {faqs.map(faq => (
          <div class="border-b border-border-hairline pb-4 space-y-1">
            <h3 class="font-bold text-text-primary font-mono">{faq.question}</h3>
            <p class="text-xs text-text-muted">{faq.answer}</p>
          </div>
        ))}
      </div>
    </article>
  </div>
</Layout>
