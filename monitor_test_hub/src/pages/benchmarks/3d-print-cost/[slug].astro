---
import Layout from '../../../layouts/Layout.astro';
import FilamentCostInspector from '../../../components/diagnostics/FilamentCostInspector.astro';
import SEOHead from '../../../components/seo/SEOHead.astro';
import SchemaGraph from '../../../components/seo/SchemaGraph.astro';
import { FilamentCostEngine } from '../../../engine/FilamentCostEngine';

export function getStaticPaths() {
  const materials = FilamentCostEngine.MATERIALS;

  return materials.map(mat => {
    return {
      params: { slug: mat.id },
      props: { material: mat }
    };
  });
}

const { material } = Astro.props;

const seoTitle = `${material.name} 3D Print Cost Calculator & Density Specs`;
const seoDescription = `Calculate print costs for ${material.name} (density ${material.densityGcm3} g/cm³). Estimate filament weight, electricity usage, and Etsy retail selling prices.`;
---

<Layout title={seoTitle} description={seoDescription} canonicalUrl={`https://displaytestonline.com/benchmarks/3d-print-cost/${material.id}`}>

  <div class="min-h-screen bg-[#08080a] text-slate-100 py-12 px-4">
    <div class="max-w-5xl mx-auto space-y-12">
      <section class="text-center space-y-4">
        <div class="inline-block px-3 py-1 bg-purple-500/10 border border-purple-500/20 text-purple-400 rounded-full text-xs font-mono uppercase">
          Material Specification
        </div>
        <h1 class="text-3xl sm:text-4xl font-black text-white tracking-tight">
          {material.name} Printing Cost Calculator
        </h1>
      </section>

      <FilamentCostInspector initialMaterialId={material.id} />
    </div>
  </div>
</Layout>
