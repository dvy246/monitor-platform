---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import WirelessLatencyInspector from '../../components/diagnostics/WirelessLatencyInspector.astro';
import SEOHead from '../../components/seo/SEOHead.astro';
import SchemaGraph from '../../components/seo/SchemaGraph.astro';
import StepWorkflowSection from '../../components/ui/StepWorkflowSection.astro';
import PanelTypeBreakdownSection from '../../components/ui/PanelTypeBreakdownSection.astro';
import FAQSection from '../../components/ui/FAQSection.astro';

const breadcrumbItems = [
  { label: 'Benchmarks', href: '/benchmarks' },
  { label: 'Wireless Audio & Latency' }
];

const seoTitle = "Wireless Audio & Peripheral Latency Tool (Bluetooth vs 2.4GHz RF)";
const seoDescription = "Profile wireless Bluetooth audio codecs (AAC, SBC, aptX LL, LDAC, LC3) and 2.4GHz RF dongle input latency with multi-layer systemic breakdown, lip-sync offsets, and Web Audio API hardware timers.";
const canonicalUrl = "https://displaytestonline.com/benchmarks/wireless-latency";

const faqs = [
  {
    question: "Why do Bluetooth headphones have audio delay in games?",
    answer: "Standard Bluetooth audio codecs (SBC and AAC) buffer audio packets to prevent dropouts, creating 120ms to 200ms of audio delay. 2.4GHz proprietary RF USB dongles and aptX Low Latency codecs reduce audio delay to 12ms-35ms."
  },
  {
    question: "How do I test my wireless earbud latency online?",
    answer: "Use our Web Audio hardware pulse generator. Click EMIT HARDWARE AUDIO PULSE and observe the visual flash indicator to gauge lip-sync delay between what you see on screen and what you hear in your headphones."
  },
  {
    question: "Is 2.4GHz RF better than Bluetooth for gaming?",
    answer: "Yes. 2.4GHz RF dongles utilize uncompressed audio transmission streams with fixed buffer sizes, yielding systemic latency under 20ms—over 6x faster than standard Bluetooth AAC/SBC."
  },
  {
    question: "What is aptX Low Latency (aptX LL) and LC3 codec?",
    answer: "aptX LL achieves ~32ms latency; LE Audio LC3 codec reduces latency down to 20-30ms while maintaining lower bitrate energy consumption."
  },
  {
    question: "How does monitor refresh rate affect audio-visual lip-sync delay?",
    answer: "Higher display refresh rates (e.g. 240Hz vs 60Hz) render visual flash frames 12.5ms faster, reducing perceived click-to-audio synchronization deltas."
  },
  {
    question: "What causes wireless 2.4GHz audio stutter and packet drops?",
    answer: "Wi-Fi routers operating on 2.4GHz channels (1, 6, 11), USB 3.0 port RF interference, or physical obstacles block line-of-sight signal transmission."
  },
  {
    question: "What is LDAC audio codec latency?",
    answer: "Sony LDAC prioritizes high bitrate audio quality (990 kbps) for Hi-Res audio, but incurs 150ms-200ms latency, making it unsuitable for competitive gaming."
  },
  {
    question: "Does Windows OS WASAPI audio buffer add latency?",
    answer: "Windows Shared Audio engine buffers add 10ms-25ms system overhead unless Exclusive WASAPI or ASIO low-latency drivers are engaged."
  },
  {
    question: "Can I use wired 3.5mm headphones for 0ms audio latency?",
    answer: "Analog 3.5mm wired connections eliminate wireless encoding, buffering, and RF packet transmission delays, delivering true 0ms wireless latency."
  },
  {
    question: "How do I export my wireless audio latency test report?",
    answer: "Click 'Export Passport' to save your verified wireless audio latency telemetry in a JSON report."
  }
];
---

<Layout title={seoTitle} description={seoDescription} faqs={faqs} canonicalUrl={canonicalUrl}>

  <div class="max-w-7xl mx-auto px-4 py-8 space-y-8 font-sans">
    <Breadcrumbs items={breadcrumbItems} />

    <header class="space-y-3 border-b border-border-hairline pb-6">
      <div class="flex items-center gap-2 text-status-pass text-xs font-mono font-bold uppercase tracking-wider">
        <span class="w-2 h-2 rounded-full bg-status-pass led-glow-pass"></span>
        PERIPHERAL LATENCY BENCHMARK — HARDWARE TIMING ENGINE
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-text-primary tracking-tight">Wireless Audio &amp; Peripheral Latency Tool</h1>
      <p class="text-sm text-text-secondary max-w-3xl">
        Calculate multi-layer systemic audio-visual latency across Bluetooth codecs (SBC, AAC, aptX LL, LDAC, LC3), 2.4GHz RF dongles, OS audio buffer stacks, and display refresh frame periods (60Hz–540Hz).
      </p>
    </header>

    <WirelessLatencyInspector />

    <StepWorkflowSection />
    <PanelTypeBreakdownSection />

    <FAQSection faqs={faqs} title="Wireless Audio & Latency FAQs" />
  </div>
</Layout>
