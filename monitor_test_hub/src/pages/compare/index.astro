---
import FAQSection from '../../components/ui/FAQSection.astro';
import Layout from '../../layouts/Layout.astro';
import { useTranslations, localizeLink } from '../../utils/i18n';
import { DeviceDatabase } from '../../engine/DeviceDatabase';
import StepWorkflowSection from '../../components/ui/StepWorkflowSection.astro';
import PanelTypeBreakdownSection from '../../components/ui/PanelTypeBreakdownSection.astro';

// Right Sidebar Components
import StatusCard from '../../components/ui/sidebar/StatusCard.astro';
import ConfigurationCard from '../../components/ui/sidebar/ConfigurationCard.astro';
import PassportCard from '../../components/ui/sidebar/PassportCard.astro';
import InfoCard from '../../components/ui/sidebar/InfoCard.astro';

const devices = DeviceDatabase.getAllDevices();

const { lang } = useTranslations(Astro.url.pathname);

export const comparisonPairs = [
  { slug: 'alienware-aw3423dwf-vs-samsung-odyssey-oled-g9', modelA: 'alienware-aw3423dwf', modelB: 'samsung-odyssey-oled-g9', title: 'Alienware AW3423DWF vs Samsung Odyssey OLED G9' },
  { slug: 'asus-rog-pg248qp-vs-benq-zowie-xl2566k', modelA: 'asus-rog-pg248qp', modelB: 'benq-zowie-xl2566k', title: 'ASUS ROG Swift PG248QP 540Hz vs BenQ Zowie XL2566K 360Hz' },
  { slug: 'lg-27gr95qe-vs-asus-rog-pg32ucdm', modelA: 'lg-27gr95qe', modelB: 'asus-rog-pg32ucdm', title: 'LG 27GR95QE-B vs ASUS ROG Swift PG32UCDM 4K OLED' },
  { slug: 'macbook-pro-m3-vs-ipad-pro-m4', modelA: 'macbook-pro-m3', modelB: 'ipad-pro-m4', title: 'MacBook Pro M3 Max Liquid Retina XDR vs iPad Pro M4 Tandem OLED' },
  { slug: 'steam-deck-oled-vs-nintendo-switch-oled', modelA: 'steam-deck-oled', modelB: 'nintendo-switch-oled', title: 'Steam Deck OLED vs Nintendo Switch OLED' }
];

const faqs = [
  {
    question: 'How does Monitor Test Hub compare monitor models?',
    answer: 'Monitor Test Hub compares monitors using client-side verified telemetry logs, ISO 9241-307 defect incidence rates, VSync frame pacing stability (P95 jitter ms), and panel technology parameters (QD-OLED vs WOLED vs Fast-IPS).'
  },
  {
    question: 'Which display panel technology has lower burn-in risk?',
    answer: 'Gen-3 QD-OLED and WOLED META panels feature hardware pixel-refresher mitigation and compensation algorithms that reduce sub-pixel luminance decay compared to Gen-1 OLED panels.'
  },
  {
    question: 'What is the difference between QD-OLED and WOLED subpixel layouts?',
    answer: 'QD-OLED uses a triangular RGB subpixel layout, whereas WOLED uses a four-subpixel RWBG (Red-White-Blue-Green) rectangular stripe layout.'
  },
  {
    question: 'How does 540Hz E-TN compare to 240Hz 4K OLED for competitive gaming?',
    answer: '540Hz E-TN delivers a lower frame interval (1.85ms) for extreme motion resolution, while 240Hz OLED provides 0.1ms GtG response times and superior contrast.'
  },
  {
    question: 'What is ISO 9241-307 Class I vs Class II warranty criteria?',
    answer: 'ISO 9241-307 Class I allows zero full bright/dead pixel defects, while Class II allows up to 2 full bright or 5 full dark defects per million pixels.'
  },
  {
    question: 'How is display frame pacing jitter measured?',
    answer: 'Frame pacing jitter is measured by tracking microsecond deltas between consecutive RequestAnimationFrame (rAF) callbacks relative to target VSync timing.'
  },
  {
    question: 'Can I compare mobile screens and handheld consoles on Monitor Test Hub?',
    answer: 'Yes, Monitor Test Hub supports handheld devices like Steam Deck OLED, Nintendo Switch OLED, iPad Pro M4 Tandem OLED, and flagship smartphones.'
  },
  {
    question: 'What is Tandem OLED technology on modern tablets?',
    answer: 'Tandem OLED stacks two self-emissive organic light layers in series to double peak luminance (up to 1600 nits) while improving panel power efficiency and lifespan.'
  },
  {
    question: 'How do I submit my monitor telemetry to the comparison database?',
    answer: 'Run any visual diagnostic test on Monitor Test Hub and click "Hardware Passport" to generate a cryptographically signed SHA-256 receipt for submission.'
  },
  {
    question: 'Are Monitor Test Hub comparisons updated dynamically?',
    answer: 'Yes, crowdsourced telemetry and defect incidence rates are updated continuously as verified community receipts are recorded.'
  }
];

const seoTitle = "Display & Hardware Comparison Matrix | Monitor Test Hub";
const seoDescription = "Compare gaming monitors, OLED displays, and high-refresh screens using crowdsourced SHA-256 telemetry, VSync frame pacing stability, and ISO 9241-307 defect stats.";
---

<Layout title={seoTitle} description={seoDescription} faqs={faqs}>
  <div class="max-w-7xl mx-auto px-4 py-6 sm:py-8 space-y-8 font-sans">
    <!-- Breadcrumbs -->
    <div class="flex items-center space-x-2 text-xs text-text-muted font-mono">
      <a href={localizeLink("/", lang)} class="hover:text-text-primary">Home</a>
      <span>/</span>
      <span class="text-emerald-400 font-bold">Compare Displays</span>
    </div>

    <!-- 2-Column Responsive Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <!-- Left Primary Content & Comparison Matrix -->
      <div class="lg:col-span-8 space-y-8">
        <!-- Direct Answer Block for AEO -->
        <div itemScope itemType="https://schema.org/Answer" class="bg-bg-surface/80 border border-emerald-500/30 rounded-3xl p-6 backdrop-blur-xl space-y-3">
          <h1 class="text-2xl sm:text-3xl font-extrabold text-text-primary font-sans">Display &amp; Hardware Comparison Matrix</h1>
          <p itemProp="text" class="text-sm text-text-secondary leading-relaxed font-sans">
            Compare flagship gaming monitors, OLED panels, and high-refresh displays side-by-side using crowdsourced SHA-256 telemetry receipts. Evaluate real-world VSync refresh accuracy, P95 frame pacing jitter (1/FPS), ISO 9241-307 defect incidence rates, and subpixel geometry (QD-OLED vs WOLED).
          </p>
        </div>

        <!-- Comparison Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 font-mono">
          {comparisonPairs.map(pair => (
            <a href={localizeLink(`/compare/${pair.slug}`, lang)} class="block p-6 bg-bg-surface border border-border-hairline hover:border-emerald-500/50 rounded-3xl transition-colors duration-200 cursor-pointer group">
              <div class="flex justify-between items-center mb-3">
                <span class="text-xs font-bold text-emerald-400 uppercase tracking-wider">Side-by-Side Benchmark</span>
                <span class="text-xs font-bold px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-300 border border-emerald-500/30">VS</span>
              </div>
              <h2 class="text-lg font-bold text-text-primary group-hover:text-emerald-400 transition-colors font-sans">{pair.title}</h2>
              <p class="text-xs text-text-muted mt-2 font-sans">Telemetry audit: Refresh rate accuracy, P95 jitter, ISO 9241-307 defect rate, and subpixel geometry.</p>
            </a>
          ))}
        </div>
      </div>

      <!-- Right Modular Control & Telemetry Sidebar -->
      <div class="lg:col-span-4 sticky top-24 space-y-6">
        <StatusCard
          status="pass"
          label="Telemetry Comparison Score"
          subtitle="Monitor Test Hub Advantage"
          score="99.2%"
          maxScore="Accuracy"
          details={[
            { label: "Verified Displays", value: "100+ Models" },
            { label: "SHA-256 Ledger", value: "Active" }
          ]}
        />

        <ConfigurationCard
          title="Compare Setup"
          subtitle="Select Displays to Compare"
          badgeText="Displays"
          controls={[
            {
              id: "comp-a",
              label: "Display A",
              type: "select",
              value: "alienware-aw3423dwf",
              options: [
                { value: "alienware-aw3423dwf", label: "Alienware AW3423DWF" },
                { value: "asus-rog-pg248qp", label: "ASUS ROG PG248QP 540Hz" },
                { value: "lg-27gr95qe", label: "LG 27GR95QE-B" }
              ]
            },
            {
              id: "comp-b",
              label: "Display B",
              type: "select",
              value: "samsung-odyssey-oled-g9",
              options: [
                { value: "samsung-odyssey-oled-g9", label: "Samsung Odyssey OLED G9" },
                { value: "benq-zowie-xl2566k", label: "BenQ Zowie XL2566K" },
                { value: "asus-rog-pg32ucdm", label: "ASUS ROG PG32UCDM 4K" }
              ]
            }
          ]}
        />

        <PassportCard
          title="Hardware Telemetry Proof"
          deviceModel="Verified Side-by-Side Audit"
          healthIndex={99}
          rmaStatus="ELIGIBLE"
          rmaDetails="Verified against crowdsourced SHA-256 hardware passports."
        />

        <InfoCard
          title="Hardware Benchmark Standards"
          subtitle="Empirical Telemetry Auditing"
          badgeText="Hardware Specs"
          accentColor="emerald"
          educationalNotes={[
            "All monitor comparison metrics are computed directly from raw microsecond VSync frame pacing deltas and verified ISO defect reports."
          ]}
        />
      </div>
    </div>

    <!-- Standard 4-Part Sections -->
    <StepWorkflowSection />
    <PanelTypeBreakdownSection />
    <FAQSection faqs={faqs} />
  </div>
</Layout>
