---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/ui/Breadcrumbs.astro';

const title = 'Contact Us | Display Test Online';
const description = 'Contact the Display Test Online team for support, feedback, or partnership inquiries.';
---

<Layout title={title} description={description}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-8">
    <Breadcrumbs items={[{ label: 'Contact Us' }]} />

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">

      <!-- Contact Info Sidebar -->
      <div class="space-y-4">
        <div class="bg-bg-surface border border-border-hairline rounded-2xl shadow-specular-top p-6 space-y-5">
          <h2 class="font-mono text-xs font-bold text-text-primary uppercase tracking-widest">Get in Touch</h2>

          <div class="space-y-1">
            <p class="font-mono text-[10px] text-text-muted uppercase tracking-widest">Email</p>
            <a href="mailto:support@displaytestonline.com" class="font-mono text-xs text-status-pass hover:underline break-all">
              support@displaytestonline.com
            </a>
          </div>

          <div class="space-y-1">
            <p class="font-mono text-[10px] text-text-muted uppercase tracking-widest">Response Time</p>
            <p class="font-sans text-xs text-text-secondary">Typically within 48 business hours.</p>
          </div>

          <div class="h-px bg-border-hairline" />

          <div class="space-y-1">
            <p class="font-mono text-[10px] text-text-muted uppercase tracking-widest">Open Source</p>
            <a
              href="https://github.com"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 font-mono text-xs text-text-secondary hover:text-text-primary transition-colors"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
              </svg>
              GitHub Repository
            </a>
          </div>
        </div>

        <div class="bg-bg-canvas border border-border-hairline rounded-xl p-4">
          <p class="font-mono text-[10px] text-text-muted uppercase tracking-widest mb-2">Topics We Cover</p>
          <ul class="space-y-1 font-sans text-xs text-text-secondary">
            <li>→ Bug reports &amp; display test issues</li>
            <li>→ Feature suggestions</li>
            <li>→ Partnership inquiries</li>
            <li>→ General feedback</li>
          </ul>
        </div>
      </div>

      <!-- Contact Form -->
      <div class="md:col-span-2 bg-bg-surface border border-border-hairline rounded-2xl shadow-specular-top p-8">
        <h1 class="font-mono text-2xl font-extrabold text-text-primary uppercase tracking-tight mb-1">
          Contact Us
        </h1>
        <p class="font-sans text-xs text-text-secondary mb-6">
          Fill out the form below and we'll get back to you within 48 business hours.
        </p>

        <!-- Success Message (hidden by default) -->
        <div
          id="contact-success"
          class="hidden mb-6 bg-bg-elevated border border-status-pass rounded-xl px-5 py-4 font-sans text-sm text-status-pass font-semibold"
          role="alert"
          aria-live="polite"
        >
          <div class="flex items-center gap-2">
            <svg class="w-5 h-5 text-status-pass shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"></path>
            </svg>
            <span>Thank you! We will get back to you within 48 hours.</span>
          </div>
        </div>

        <form id="contact-form" class="space-y-5" novalidate>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div>
              <label for="contact-name" class="block font-mono text-[10px] text-text-muted uppercase tracking-widest mb-1.5">
                Name <span class="text-status-pass">*</span>
              </label>
              <input
                id="contact-name"
                name="name"
                type="text"
                required
                autocomplete="name"
                placeholder="Your name"
                class="w-full bg-bg-canvas border border-border-hairline rounded-lg px-4 py-2.5 text-sm font-sans text-text-primary placeholder:text-text-muted focus:outline-none focus:ring-1 focus:ring-border-hairline transition-colors"
              />
            </div>
            <div>
              <label for="contact-email" class="block font-mono text-[10px] text-text-muted uppercase tracking-widest mb-1.5">
                Email <span class="text-status-pass">*</span>
              </label>
              <input
                id="contact-email"
                name="email"
                type="email"
                required
                autocomplete="email"
                placeholder="name@domain.com"
                class="w-full bg-bg-canvas border border-border-hairline rounded-lg px-4 py-2.5 text-sm font-sans text-text-primary placeholder:text-text-muted focus:outline-none focus:ring-1 focus:ring-border-hairline transition-colors"
              />
            </div>
          </div>

          <div>
            <label for="contact-subject" class="block font-mono text-[10px] text-text-muted uppercase tracking-widest mb-1.5">
              Subject <span class="text-status-pass">*</span>
            </label>
            <select
              id="contact-subject"
              name="subject"
              required
              class="w-full bg-bg-canvas border border-border-hairline rounded-lg px-4 py-2.5 text-sm font-sans text-text-primary focus:outline-none focus:ring-1 focus:ring-border-hairline transition-colors appearance-none"
            >
              <option value="" disabled selected>Select a topic…</option>
              <option value="general">General</option>
              <option value="bug">Bug Report</option>
              <option value="feature">Feature Request</option>
              <option value="partnership">Partnership</option>
            </select>
          </div>

          <div>
            <label for="contact-message" class="block font-mono text-[10px] text-text-muted uppercase tracking-widest mb-1.5">
              Message <span class="text-status-pass">*</span>
            </label>
            <textarea
              id="contact-message"
              name="message"
              rows="6"
              required
              placeholder="Describe your question, issue, or idea…"
              class="w-full bg-bg-canvas border border-border-hairline rounded-lg px-4 py-2.5 text-sm font-sans text-text-primary placeholder:text-text-muted focus:outline-none focus:ring-1 focus:ring-border-hairline transition-colors resize-y"
            ></textarea>
          </div>

          <button
            type="submit"
            id="contact-submit"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-bg-elevated border border-border-hairline text-text-primary font-mono text-xs font-bold uppercase tracking-widest px-8 py-3 rounded-lg hover:bg-bg-surface transition-colors shadow-specular-top"
          >
            Send Message
          </button>
        </form>
      </div>
    </div>
  </div>

  <script>
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const successBox = document.getElementById('contact-success');

    if (form && successBox) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        form.classList.add('hidden');
        successBox.classList.remove('hidden');
        successBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
      });
    }
  </script>
</Layout>
