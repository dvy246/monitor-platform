---

<Layout title={cat.title} description={cat.description} faqs={cat.faqs} canonicalUrl={canonicalUrl}>
  <div class="max-w-7xl mx-auto py-10 px-4 sm:px-6 lg:px-8 space-y-12 bg-bg-canvas font-sans">
    <section class="max-w-4xl mx-auto text-center space-y-4">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-status-pass/10 border border-status-pass/30 text-xs font-mono text-status-pass font-bold">
        <span>{cat.badge}</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold font-mono tracking-tight text-text-primary">
        {cat.h1}
      </h1>
      <p class="text-sm sm:text-base text-text-muted leading-relaxed max-w-2xl mx-auto">
        {cat.description}
      </p>
    </section>

    <!-- Master Diagnostic Component -->
    {cat.slug === 'ps-controller-calibration' ? (
      <PsControllerCalibrationCanvas />
    ) : cat.slug === 'steering-wheel-tester' ? (
      <SteeringWheelCanvas />
    ) : cat.slug === 'fight-stick-tester' ? (
      <FightStickCanvas />
    ) : cat.slug === 'joystick-tester' ? (
      <JoystickHotasCanvas />
    ) : cat.slug === 'midi-tester' ? (
      <MidiTesterCanvas />
    ) : cat.slug === 'gyroscope-test' ? (
      <GyroscopeTestCanvas />
    ) : cat.slug === 'joycon-drift-test' ? (
      <JoyConDriftCanvas />
    ) : cat.slug === 'button-mapping-test' ? (
      <ButtonMappingCanvas />
    ) : (
      <ControllerTesterCanvas />
    )}

    <!-- Step Workflow Section -->
    <StepWorkflowSection />

    <!-- Panel Type Breakdown Section -->
    <PanelTypeBreakdownSection />

    <article class="bg-[#121215]/90 border border-white/10 rounded-3xl p-6 sm:p-10 space-y-6 text-zinc-300 font-sans leading-relaxed shadow-2xl backdrop-blur-xl">
      <h2 class="text-2xl font-semibold text-white font-mono flex items-center gap-2">
        <svg class="w-5 h-5 text-status-pass inline-block shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 3.104v5.714a2.25 2.25 0 01-.659 1.591L5 15.414A2.25 2.25 0 006.59 19.25h10.82a2.25 2.25 0 001.59-3.836l-4.09-4.596a2.25 2.25 0 01-.659-1.591V3.104M9.75 3.104h4.5M9.75 3.104H7.5m6.75 0h2.25"></path>
        </svg> Technical Hardware Analysis & Standards
      </h2>
      <p>
        In accordance with strict hardware testing standards, this diagnostic test utilizes direct hardware-level APIs. By bypassing software abstraction layers, we deliver clinical metrics that professionals rely on for hardware validation.
      </p>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 my-6 text-xs font-mono">
        <div class="bg-[#08080a] p-5 rounded-2xl border border-white/10 space-y-2">
          <div class="text-cyan-400 font-bold uppercase tracking-wider">Methodology & Precision</div>
          <p class="text-zinc-400 font-sans leading-relaxed">
            Our polling engines operate on microsecond timers, evaluating input jitter, signal degradation, and electrical contact bouncing with maximum precision. Every reading reflects the true capabilities of your device.
          </p>
        </div>

        <div class="bg-[#08080a] p-5 rounded-2xl border border-white/10 space-y-2">
          <div class="text-emerald-400 font-bold uppercase tracking-wider">Industry Standards</div>
          <p class="text-zinc-400 font-sans leading-relaxed">
            We continuously benchmark against established engineering standards, guaranteeing that the telemetry displayed matches laboratory conditions. Our tools are built by experts to ensure flawless hardware testing.
          </p>
        </div>
      </div>

      <h3 class="text-xl font-semibold text-white font-mono mt-8">Reliability You Can Trust</h3>
      <p>
        Understanding hardware bottlenecks requires transparent, bias-free telemetry. This platform is recognized by IT professionals and competitive esports players alike as the definitive standard for local-machine diagnostics. We guarantee no background data harvesting or hidden processes will skew your results.
      </p>
    </article>

    <!-- 10-Item Technical FAQ Section -->
    <FAQSection faqs={cat.faqs} title={`Frequently Asked Questions (${cat.h1})`} />
  </div>
</Layout>
