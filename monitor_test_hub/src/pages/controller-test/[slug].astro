  return controllerCategories.map(cat => ({
    params: { slug: cat.slug },
    props: { cat }
  }));
}

const cat = Astro.props.cat || {
  slug: 'stick-drift',
  title: 'Analog Stick Drift Test | Circularity Error % & Centering Calculator',
  h1: 'Analog Stick Drift & Circularity Error Diagnostic Tool',
  description: 'Test your controller analog sticks for drift and circularity error percentage. Calculate outer bound radial deviation and centering offset for PS5, Xbox, and Switch controllers.',
  badge: 'CIRCULARITY ERROR % SPEC',
  faqs: [
    { question: "What is analog stick drift?", answer: "Stick drift is uncommanded cursor or in-game camera movement caused by worn potentiometer resistive tracks, dust, or weakened centering springs." },
    { question: "What is analog stick circularity error %?", answer: "Circularity error % calculates average percentage deviation of sampled outer bound points from an ideal unit circle (r = 1.0)." },
    { question: "What is acceptable circularity error % for gaming controllers?", answer: "Factory calibrated controllers achieve under 5-8% circularity error; uncalibrated or worn sticks exceed 15-25% error." },
    { question: "How does the online stick drift test work?", answer: "Samples X/Y coordinates from W3C Gamepad API in real time, calculating centering drift offset when sticks are released." },
