---
import FAQSection from '../../components/ui/FAQSection.astro';
import Layout from '../../layouts/Layout.astro';
import FfbClippingCanvas from '../../components/diagnostics/FfbClippingCanvas.astro';
import { useTranslations } from '../../utils/i18n';

import StatusCard from '../../components/ui/sidebar/StatusCard.astro';
import MetricCard from '../../components/ui/sidebar/MetricCard.astro';
import TelemetryCard from '../../components/ui/sidebar/TelemetryCard.astro';

const { lang } = useTranslations(Astro.url.pathname);
const canonicalUrl = lang === 'en'
  ? "https://displaytestonline.com/controller-test/ffb-clipping-test"
  : `https://displaytestonline.com/${lang}/controller-test/ffb-clipping-test`;

const faqs = [
  { question: "What is Force Feedback (FFB) Clipping?", answer: "FFB clipping occurs when the game requests a torque output that exceeds the maximum physical torque limit of your sim racing wheel base, causing a loss of detail and flat-lining torque output." },
  { question: "How does this FFB clipping analyzer work?", answer: "It captures DirectInput and USB HID telemetry streams from your racing wheel at 1000Hz, plotting requested torque against actual output torque to visualize clipping zones." },
  { question: "What is a FFB deadzone?", answer: "A deadzone is a small range in the center of the wheel's rotation where no force feedback is felt, common in gear-driven bases like the Logitech G29." },
  { question: "How do I fix FFB clipping?", answer: "Lower the master FFB gain in your game settings or wheel software until the torque peaks no longer hit the 100% threshold during high-load corners." },
  { question: "Is this compatible with Direct Drive (DD) wheels?", answer: "Yes, this tool tests all USB HID compliant devices, including Fanatec, Moza, Simagic, and Logitech Direct Drive wheel bases." },
  { question: "What is the optimal FFB gain setting?", answer: "The optimal setting leaves enough headroom for momentary torque spikes (like hitting a curb) without exceeding 100% of the wheelbase's maximum torque." },
  { question: "Does this require any driver installation?", answer: "No, it utilizes the native WebHID API and HTML5 Gamepad API, functioning entirely within your browser without third-party drivers." },
  { question: "Why does my wheel feel light in the center?", answer: "This is usually caused by an innate hardware deadzone or a software 'center spring' effect which dampens granular FFB details near 0 degrees of rotation." },
  { question: "Can I use this for aviation HOTAS setups?", answer: "Yes, the telemetry engine can visualize force feedback and deadzones on any compatible USB HID flight stick or yoke." },
  { question: "Is the data recorded securely?", answer: "All telemetry is processed locally in your browser. We do not transmit or store any of your hardware data on our servers." }
];

const seoTitle = "Sim Racing FFB Clipping & Deadzone Analyzer Online";
const seoDescription = "Test your Direct Drive or gear-driven racing wheel for Force Feedback (FFB) clipping and deadzones. Free browser-based USB HID analyzer for sim racers.";
---

<Layout title={seoTitle} description={seoDescription} faqs={faqs} canonicalUrl={canonicalUrl}>
  <div class="max-w-7xl mx-auto px-4 py-6 sm:py-8 min-w-0 w-full overflow-hidden font-sans space-y-10">
    <section class="max-w-4xl mx-auto text-center space-y-4">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-xs font-mono text-emerald-400 font-bold">
        <span>WEB HID TELEMETRY COMPLIANT</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold font-mono tracking-tight text-white">
        Sim Racing FFB Clipping Analyzer
      </h1>
      <p class="text-sm sm:text-base text-zinc-400 leading-relaxed max-w-2xl mx-auto">
        Visualize your wheelbase torque output in real-time. Detect FFB clipping limits and center deadzones on Fanatec, Moza, Simagic, and Logitech racing wheels.
      </p>
    </section>

    <!-- Master Interactive Instrument -->
    <FfbClippingCanvas />

    <article class="max-w-7xl mx-auto space-y-6 bg-[#121215] border border-white/10 rounded-3xl p-6 sm:p-8 backdrop-blur-xl text-sm text-zinc-300 leading-relaxed shadow-2xl">
      <div class="border-b border-white/10 pb-4">
        <h2 class="text-xl font-bold font-mono text-white">Understanding Force Feedback Dynamics</h2>
        <p class="mt-2 text-zinc-400">
          Optimal force feedback is crucial for feeling tire slip angle and track bumps. This analyzer reads raw USB HID packets at 1000Hz to map your wheel's torque response curve, helping you calibrate the perfect gain setting to avoid dynamic range compression (clipping).
        </p>
      </div>
    </article>

    <FAQSection faqs={faqs} />
  </div>
</Layout>
