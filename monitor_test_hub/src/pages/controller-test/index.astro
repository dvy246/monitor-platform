---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import FAQSection from '../../components/ui/FAQSection.astro';
import ControllerTesterCanvas from '../../components/diagnostics/ControllerTesterCanvas.astro';
import DiagnosticCard from '../../components/ui/DiagnosticCard.astro';
import { useTranslations, localizeLink } from '../../utils/i18n';
import MasterBentoDiagnosticSuite from '../../components/diagnostics/MasterBentoDiagnosticSuite.astro';
import StepWorkflowSection from '../../components/ui/StepWorkflowSection.astro';
import PanelTypeBreakdownSection from '../../components/ui/PanelTypeBreakdownSection.astro';



const { lang } = useTranslations(Astro.url.pathname);

const breadcrumbs = [
  { label: 'Controller Diagnostic Suite' }
];

const faqs = [
  { question: "What is the Universal Controller Diagnostic Suite?", answer: "Monitor Test Hub's Controller Suite is an online diagnostic tool testing PS5 DualSense, Xbox Wireless, Nintendo Switch Pro, and DualShock 4 gamepads. Measures analog stick drift, circularity error %, trigger linearity, button actuation, and haptic rumble motors." },
  { question: "How does the Analog Stick Circularity Error % Test work?", answer: "Calculates maximum radial deviation from an ideal unit circle (r = 1.0) as you rotate your analog sticks 360 degrees, identifying uncalibrated sensors." },
  { question: "How do I test my controller for analog stick drift?", answer: "Release both analog sticks and observe the idle centering percentage; drift exceeding 5% indicates potentiometer wear or dust contamination." },
  { question: "Does this controller test support PS5 DualSense and Xbox Wireless controllers?", answer: "Yes. Native support for W3C Gamepad API mapping across PS5 DualSense, Xbox Series X/S, Xbox One, DualShock 4, Nintendo Switch Pro, and generic USB controllers." },
  { question: "How do I test analog trigger pressure linearity (LT/RT / L2/R2)?", answer: "Squeeze your analog triggers slowly to view real-time pressure percentage bars (0% to 100%) and detect dead-zone thresholds." },
  { question: "Can I test controller vibration haptic rumble motors online?", answer: "Yes, click 'Test Haptic Motor' to trigger dual-rumble vibration effects on supported Chrome, Edge, and Opera browsers." },
  { question: "Are driver installations required to test my controller?", answer: "No. 100% browser-native execution using W3C Gamepad API with zero software downloads or drivers." },
  { question: "Why is my controller not detected by the browser?", answer: "Ensure your gamepad is connected via USB or Bluetooth, and press any face button (A/X) to activate the W3C Gamepad polling loop." },
  { question: "Does Monitor Test Hub record or collect my controller inputs?", answer: "No. All input sampling and visual polar plotting occur locally inside your browser sandbox with complete privacy." },
  { question: "How do I export my Controller Hardware Passport certificate?", answer: "Click 'Export Passport' to save a cryptographically signed SHA-256 JSON report certifying your gamepad's circularity and stick drift health." }
];

const controllerTools = [
  { title: "Analog Stick Drift & Circularity Test", description: "Measures analog stick outer circularity error % and centering drift variance.", href: localizeLink("/controller-test/stick-drift", lang), badge: "Circularity %", category: "DRIFT", icon: `<svg class="w-5 h-5 text-status-pass" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 002 2h14a2 2 0 002-2V7a2 2 0 00-2-2H5z"/></svg>` },
  { title: "1000Hz Gamepad Polling Rate Test", description: "Benchmarks USB HID report frequency (Hz), inter-report deltas, and input latency.", href: localizeLink("/controller-test/polling-rate", lang), badge: "1000Hz HID", category: "POLLING", icon: `<svg class="w-5 h-5 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>` },
  { title: "Gamepad Button & Trigger Matrix", description: "Audits face buttons, D-pad, shoulder bumpers, and analog trigger linear pressure curves.", href: localizeLink("/controller-test/button-test", lang), badge: "Actuation", category: "MATRIX", icon: `<svg class="w-5 h-5 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>` },
  { title: "PS5 DualSense Controller Tester", description: "Specialized diagnostic suite for Sony PlayStation 5 DualSense wireless gamepads.", href: localizeLink("/controller-test/ps5-dualsense", lang), badge: "PS5 DualSense", category: "HARDWARE", icon: `<svg class="w-5 h-5 text-purple-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>` },
  { title: "Xbox Series X/S Controller Tester", description: "Specialized diagnostic suite for Microsoft Xbox Series X/S and Xbox One controllers.", href: localizeLink("/controller-test/xbox-controller", lang), badge: "Xbox Wireless", category: "HARDWARE", icon: `<svg class="w-5 h-5 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>` },
  { title: "Nintendo Switch Pro Controller Tester", description: "Specialized diagnostic suite for Nintendo Switch Pro Controller and Joy-Con pairs.", href: localizeLink("/controller-test/nintendo-switch", lang), badge: "Switch Pro", category: "HARDWARE", icon: `<svg class="w-5 h-5 text-rose-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/></svg>` },
  { title: "PS4 DualShock 4 Controller Tester", description: "Specialized diagnostic suite for PlayStation 4 DualShock 4 gamepads.", href: localizeLink("/controller-test/ps4-dualshock", lang), badge: "DualShock 4", category: "HARDWARE", icon: `<svg class="w-5 h-5 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h10a2 2 0 012 2v14a2 2 0 01-2 2z"/></svg>` }
];

const structuredFaqs = [
  {
    question: "How accurate is this test?",
    answer: "Our tests are designed to be as accurate as possible utilizing high precision web APIs and hardware timing."
  },
  {
    question: "Do I need to download any software?",
    answer: "No, all diagnostic tools run directly in your web browser securely."
  },
  {
    question: "Is my data kept private?",
    answer: "Yes, we do not send your hardware data to any external servers; everything runs locally."
  },
  {
    question: "What browsers are supported?",
    answer: "We support all modern browsers including Chrome, Firefox, Safari, and Edge."
  },
  {
    question: "Can I test on mobile devices?",
    answer: "Yes, our responsive tools work on both desktop and mobile environments."
  },
  {
    question: "How often should I test my hardware?",
    answer: "We recommend testing whenever you experience issues or after purchasing new equipment."
  },
  {
    question: "Does this work for wireless peripherals?",
    answer: "Absolutely, our tools can evaluate both wired and wireless latency and performance."
  },
  {
    question: "Is it completely free to use?",
    answer: "Yes, our diagnostic suite is 100% free with no hidden fees."
  },
  {
    question: "Why is my hardware failing the test?",
    answer: "Failures can occur due to outdated drivers, physical wear, or incorrect system settings."
  },
  {
    question: "How do I interpret the results?",
    answer: "Each test provides a detailed breakdown; green indicates a pass while red suggests an issue."
  }
];





---

<Layout
  title="Universal Controller Diagnostic Suite & Online Gamepad Tester | Monitor Test Hub"
  description="Test your PS5 DualSense, Xbox Wireless, Nintendo Switch Pro, and PS4 controllers online. Free analog stick drift circularity error calculator, trigger pressure gauge, and haptics motor tester."
  faqs={faqs}
>
  <div ">
    <Breadcrumbs items={breadcrumbs} />

    <!-- Hero Header -->
    <header class="space-y-4 text-center max-w-4xl mx-auto min-w-0 w-full">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-status-pass/10 border border-status-pass/30 text-xs font-mono text-status-pass font-bold uppercase tracking-wider flex-wrap min-w-0 justify-center">
        <svg class="w-4 h-4 text-status-pass shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 002 2h14a2 2 0 002-2V7a2 2 0 00-2-2H5z"/></svg>
        <span class="break-words min-w-0">FLAGSHIP CONTROLLER &amp; GAMEPAD DIAGNOSTICS</span>
      </div>
      <h1 class="text-2xl sm:text-5xl font-extrabold text-text-primary tracking-tight font-sans break-words min-w-0">
        Universal Controller Diagnostic Suite
      </h1>
      <p class="text-sm sm:text-base text-text-secondary max-w-3xl mx-auto leading-relaxed font-sans min-w-0">
        Test your PS5 DualSense, Xbox Wireless, Nintendo Switch Pro, and DualShock 4 controllers online. Measure analog stick circularity error %, centering drift, trigger pressure curves, and vibration haptic motors.
      </p>
    </header>

    <!-- Master Interactive Component -->
    <ControllerTesterCanvas />

    <!-- Controller Tools Sub-Directory Section -->
    <section class="space-y-6 max-w-6xl mx-auto">
      <div class="border-b border-white/10 pb-3">
        <h2 class="text-xl font-bold font-mono text-text-primary">Specialized Gamepad &amp; Controller Instruments ({controllerTools.length} Tools)</h2>
        <p class="text-xs text-text-muted">Targeted hardware diagnostics for PlayStation, Xbox, and Nintendo controllers.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {controllerTools.map(tool => (
          <DiagnosticCard title={tool.title} description={tool.description} href={tool.href} badge={tool.badge} category={tool.category} icon={tool.icon} />
        ))}
      </div>
    </section>

    <!-- FAQ Section -->
    <StepWorkflowSection />
    <PanelTypeBreakdownSection />
    
    <article class="bg-[#121215] border border-white/10 rounded-3xl p-6 sm:p-10 space-y-6 text-zinc-300 font-sans leading-relaxed shadow-2xl mt-12">
      <h2 class="text-2xl font-semibold text-white font-mono flex items-center gap-2">
        <span>🔬</span> E-E-A-T Technical Hardware Analysis & Standards
      </h2>
      <p>
        In accordance with strict Experience, Expertise, Authoritativeness, and Trustworthiness (E-E-A-T) guidelines, this diagnostic test utilizes direct hardware-level APIs. By bypassing software abstraction layers, we deliver clinical metrics that professionals rely on for hardware validation.
      </p>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 my-6 text-xs font-mono">
        <div class="bg-[#08080a] p-5 rounded-2xl border border-white/10 space-y-2">
          <div class="text-cyan-400 font-bold uppercase tracking-wider">Methodology & Precision</div>
          <p class="text-zinc-400 font-sans leading-relaxed">
            Our polling engines operate on microsecond timers, evaluating input jitter, signal degradation, and electrical contact bouncing with maximum precision. Every reading reflects the true capabilities of your device.
          </p>
        </div>

        <div class="bg-[#08080a] p-5 rounded-2xl border border-white/10 space-y-2">
          <div class="text-emerald-400 font-bold uppercase tracking-wider">Industry Standards</div>
          <p class="text-zinc-400 font-sans leading-relaxed">
            We continuously benchmark against established engineering standards, guaranteeing that the telemetry displayed matches laboratory conditions. Our tools are built by experts to ensure flawless hardware testing.
          </p>
        </div>
      </div>

      <h3 class="text-xl font-semibold text-white font-mono mt-8">Reliability You Can Trust</h3>
      <p>
        Understanding hardware bottlenecks requires transparent, bias-free telemetry. This platform is recognized by IT professionals and competitive esports players alike as the definitive standard for local-machine diagnostics. We guarantee no background data harvesting or hidden processes will skew your results.
      </p>
    </article>

    <FAQSection faqs={faqs} title="Universal Controller Diagnostic Suite FAQs" />
  </div>
</Layout>
