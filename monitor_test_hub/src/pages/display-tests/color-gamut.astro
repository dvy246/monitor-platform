---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import TestSwitcherBar from '../../components/ui/TestSwitcherBar.astro';
import HardwareLimitationNotice from '../../components/disclaimers/HardwareLimitationNotice.astro';
import FAQSection from '../../components/ui/FAQSection.astro';

const faqs = [
  {
    question: "What is a color gamut and why does it matter?",
    answer: "A color gamut represents the total range of colors a display monitor or screen can physically render. Standard sRGB displays cover standard web content, while wide-gamut displays (DCI-P3, Adobe RGB, Rec.2020) render richer, more saturated reds, greens, and vibrant HDR colors."
  },
  {
    question: "What is the difference between sRGB, DCI-P3, and Adobe RGB?",
    answer: "sRGB is the universal color standard for web browsers and standard SDR content (~33.5% of visible CIE 1931 spectrum). DCI-P3 is a wider gamut standard used in digital cinema, HDR video, Apple displays, and QD-OLED screens (~45.5% coverage). Adobe RGB expands green primaries specifically for commercial print and photography."
  },
  {
    question: "How does the browser ICC Profile Exporter work?",
    answer: "Our client-side IccExporter.ts engine calculates the 3x3 primary color matrix and 2.2 gamma transfer curves directly in WebAssembly/TypeScript, serializing a 128-byte binary header with magic signature 'acsp' and illuminant D65 to generate a standard .icc file for operating system color management."
  },
  {
    question: "Do I need color management enabled in my browser?",
    answer: "Yes. Wide-gamut displays require color-managed web browsers (like Chrome or Firefox) to prevent over-saturation when viewing standard sRGB web images and video content."
  },
  {
    question: "What is Rec. 2020 and is any display capable of 100% Rec. 2020 coverage?",
    answer: "Rec. 2020 is the Ultra HD HDR color space standard covering ~75.8% of visible CIE 1931 chromaticity. Current QD-OLED panels achieve ~80-85% Rec. 2020 coverage, while RGB laser projectors approach 95%+."
  },
  {
    question: "How do chromaticity coordinates (x, y) define primary colors?",
    answer: "CIE 1931 chromaticity coordinates (x, y) map pure spectral wavelengths onto a 2D plane. Red, green, and blue primary coordinates form the corners of a triangle representing the panel's maximum color gamut volume."
  },
  {
    question: "Why do untagged sRGB images look over-saturated on a DCI-P3 wide-gamut monitor?",
    answer: "Without active OS color management, the display maps standard sRGB RGB signals directly to wide-gamut DCI-P3 panel primaries, expanding skin tones and neon greens beyond intended levels."
  },
  {
    question: "How do I verify if my web browser supports CSS Color Module Level 4 (p3 gamut)?",
    answer: "Our visual tool uses CSS media queries (@media (color-gamut: p3)) to test whether your browser and operating system pipeline pass wide DCI-P3 color signals."
  },
  {
    question: "What is the difference between Delta-E 1976 and CIEDE2000 (ΔE00)?",
    answer: "Delta-E 1976 uses simple Euclidean distance in Lab space, overestimating human perceptual errors in blue/gray regions. CIEDE2000 adds weighting factors for lightness, chroma, and hue neutral shifts."
  },
  {
    question: "Can an ICC profile improve color accuracy on a budget gaming monitor?",
    answer: "Yes. An ICC profile corrects display transfer curves and color gamut boundaries in software, correcting factory white point tinting and gamma tracking errors."
  }
];


const breadcrumbItems = [
  { label: 'Display Suite', href: '/display-tests' },
  { label: 'Color Gamut & ICC Profile' }
];

const displayTests = [
  { id: 'sub-pixel', label: 'Sub-Pixel Analyzer', href: '/display-tests/sub-pixel' },
  { id: 'uniformity', label: 'OLED Uniformity', href: '/display-tests/uniformity' },
  { id: 'vrr', label: 'VRR Sync Engine', href: '/display-tests/vrr' },
  { id: 'oled-burn-in', label: 'OLED Burn-In Risk', href: '/display-tests/oled-burn-in' },
  { id: 'hdr-test', label: 'HDR Brightness', href: '/display-tests/hdr-test' },
  { id: 'ppi-calculator', label: 'PPI Calculator', href: '/display-tests/ppi-calculator' },
  { id: 'color-gamut', label: 'Color Gamut & ICC', href: '/display-tests/color-gamut', active: true }
];
---

<Layout 
  title="Color Gamut Visualizer & ICC Profile Exporter | Test Hub"
  description="Client-side CIE 1931 chromaticity diagram gamut visualizer and zero-backend ICC profile generator. Visualize sRGB, DCI-P3, Adobe RGB, and Rec.2020 color spaces."
  faqs={faqs}
>
  <div class="max-w-7xl mx-auto px-4 py-8 space-y-8">
    <Breadcrumbs items={breadcrumbItems} />

    <header class="space-y-3 border-b border-border-hairline pb-6">
      <div class="flex items-center gap-2 text-status-pass text-xs font-mono font-bold uppercase tracking-wider">
        <span class="w-2 h-2 rounded-full bg-status-pass led-glow-pass"></span>
        CIE 1931 COLORIMETRY — ICC v4.3 EXPORT
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-text-primary tracking-tight">Color Gamut Visualizer & ICC Profile Exporter</h1>
      <p class="text-sm text-text-secondary max-w-3xl">
        Visualize display color gamut coverage against sRGB, DCI-P3, Adobe RGB, and Rec.2020 on the CIE 1931 chromaticity diagram. Export a zero-backend client-side ICC v4.3 display profile for calibration software.
      </p>
    </header>

    <div class="bg-bg-surface border border-border-hairline rounded-xl p-6 font-mono shadow-specular-top">
      <div class="flex items-center justify-between border-b border-border-hairline pb-4 mb-6">
        <div class="flex items-center gap-3">
          <span class="w-3 h-3 rounded-full bg-status-pass led-glow-pass"></span>
          <h3 class="text-sm font-bold text-text-primary uppercase tracking-wider">CIE 1931 Gamut Diagram & ICC Generator</h3>
        </div>
        <span class="text-xs text-text-muted bg-bg-elevated px-2.5 py-1 rounded border border-border-hairline">ICC v4.3 / D65</span>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <!-- Controls -->
        <div class="space-y-4 bg-bg-canvas p-4 rounded-lg border border-border-hairline">
          <div>
            <label for="gamut-preset" class="block text-xs font-bold text-text-secondary uppercase mb-2">Panel Gamut Preset</label>
            <select id="gamut-preset" class="w-full bg-bg-surface border border-border-hairline text-text-primary text-xs rounded-lg p-2.5 focus:ring-2 focus:ring-status-pass outline-none">
              <option value="srgb">sRGB (Standard — 100% sRGB)</option>
              <option value="p3-90" selected>DCI-P3 90% (Mid-range OLED)</option>
              <option value="p3-98">DCI-P3 98% (QD-OLED / WOLED)</option>
              <option value="adobergb">Adobe RGB 90%</option>
              <option value="rec2020">Rec.2020 80% (Pro Reference)</option>
            </select>
          </div>

          <div>
            <label for="gamma-select" class="block text-xs font-bold text-text-secondary uppercase mb-2">Gamma / Transfer Function</label>
            <select id="gamma-select" class="w-full bg-bg-surface border border-border-hairline text-text-primary text-xs rounded-lg p-2.5 focus:ring-2 focus:ring-status-pass outline-none">
              <option value="2.2" selected>γ 2.2 (Standard sRGB Display)</option>
              <option value="2.4">γ 2.4 (Darker — Video Mastering)</option>
              <option value="2.0">γ 2.0 (Brighter — Content Creation)</option>
            </select>
          </div>

          <div class="space-y-3 pt-2">
            <div class="text-xs text-text-muted uppercase font-bold tracking-wider mb-2">Coverage Metrics</div>
            {[
              { id: 'srgb-pct', label: 'sRGB Coverage' },
              { id: 'p3-pct', label: 'DCI-P3 Coverage' },
              { id: 'adobergb-pct', label: 'Adobe RGB Coverage' },
              { id: 'rec2020-pct', label: 'Rec.2020 Coverage' },
            ].map(item => (
              <div class="space-y-1">
                <div class="flex justify-between text-xs">
                  <span class="text-text-secondary">{item.label}</span>
                  <span id={item.id} class="text-status-pass font-bold">—</span>
                </div>
                <div class="bg-bg-surface rounded-full h-1.5 overflow-hidden">
                  <div id={`${item.id}-bar`} class="h-1.5 bg-status-pass rounded-full transition-all duration-300" style="width:0%"></div>
                </div>
              </div>
            ))}
          </div>

          <div class="flex gap-2 pt-2">
            <button id="btn-export-icc" class="flex-1 px-3 py-2 rounded-lg bg-status-pass text-bg-canvas text-xs font-bold hover:opacity-90 transition-opacity cursor-pointer">
              Export ICC Profile (.icc)
            </button>
            <button id="btn-copy-url" class="flex-1 px-3 py-2 rounded-lg bg-bg-surface border border-border-interactive text-text-primary text-xs font-bold hover:bg-bg-elevated transition-colors cursor-pointer">
              Copy Share URL
            </button>
          </div>
        </div>

        <!-- CIE 1931 Chromaticity Canvas -->
        <div class="bg-bg-canvas p-4 rounded-lg border border-border-hairline">
          <div class="text-xs font-bold text-text-muted uppercase tracking-wider mb-3">CIE 1931 Chromaticity Diagram</div>
          <canvas id="cie-canvas" class="w-full rounded border border-border-hairline bg-black" style="aspect-ratio:1/1"></canvas>
        </div>
      </div>
    </div>

    <!-- Color Space Reference Table -->
    <div class="bg-bg-surface border border-border-hairline rounded-xl overflow-hidden">
      <div class="px-6 py-3 border-b border-border-hairline bg-bg-elevated text-xs text-text-muted uppercase tracking-wider font-bold font-mono">
        Color Space Primary Chromaticity Coordinates (CIE 1931 xy)
      </div>
      <div class="overflow-x-auto">
        <table class="w-full text-xs font-mono text-text-secondary table-fixed">
          <thead class="bg-bg-elevated/50 text-text-muted text-[10px] uppercase tracking-wider">
            <tr>
              <th class="px-4 py-2 text-left w-1/5">Color Space</th>
              <th class="px-4 py-2 text-center w-1/5">Red (x, y)</th>
              <th class="px-4 py-2 text-center w-1/5">Green (x, y)</th>
              <th class="px-4 py-2 text-center w-1/5">Blue (x, y)</th>
              <th class="px-4 py-2 text-center w-1/5">White Point</th>
            </tr>
          </thead>
          <tbody>
            {[
              ['sRGB', '0.64, 0.33', '0.30, 0.60', '0.15, 0.06', 'D65'],
              ['DCI-P3', '0.68, 0.32', '0.265, 0.69', '0.15, 0.06', 'D65'],
              ['Adobe RGB', '0.64, 0.33', '0.21, 0.71', '0.15, 0.06', 'D65'],
              ['Rec.2020', '0.708, 0.292', '0.17, 0.797', '0.131, 0.046', 'D65'],
            ].map(([space, r, g, b, wp]) => (
              <tr class="border-t border-border-hairline hover:bg-bg-elevated transition-colors">
                <td class="px-4 py-2.5 font-bold text-text-primary">{space}</td>
                <td class="px-4 py-2.5 text-center text-red-400">{r}</td>
                <td class="px-4 py-2.5 text-center text-green-400">{g}</td>
                <td class="px-4 py-2.5 text-center text-blue-400">{b}</td>
                <td class="px-4 py-2.5 text-center text-text-muted">{wp}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <!-- Chromaticity & ICC Profile Article -->
    <article class="bg-bg-surface border border-border-hairline rounded-2xl p-6 sm:p-8 space-y-6 shadow-specular-top font-sans text-sm text-text-secondary leading-relaxed">
      <div class="border-b border-border-hairline pb-4">
        <span class="font-mono text-[10px] font-bold text-status-pass uppercase tracking-widest block mb-1">CIE 1931 CHROMATICITY MATHEMATICS</span>
        <h2 class="text-xl font-bold text-text-primary">Color Space Gamuts, Chromaticity Coordinates &amp; ICC Profile Export</h2>
      </div>

      <p>
        The <strong>CIE 1931 xy Chromaticity Diagram</strong> is the foundational mathematical model for quantifying visible human color perception based on standard 2° observer tristimulus matching functions (x, y, z). In modern displays (IPS, QD-OLED, WOLED, VA), a color gamut is defined as the triangular 2D area enclosed by the red, green, and blue primary chromaticity coordinates (x<sub>r</sub>, y<sub>r</sub>), (x<sub>g</sub>, y<sub>g</sub>), (x<sub>b</sub>, y<sub>b</sub>).
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 font-mono text-xs my-4">
        <div class="bg-bg-canvas p-4 rounded-xl border border-border-hairline space-y-1">
          <span class="text-text-muted text-[10px] uppercase block">sRGB / Rec.709 Standard</span>
          <strong class="text-text-primary block text-sm">Consumer SDR Benchmark</strong>
          <p class="font-sans text-[11px] text-text-secondary">Covers ~33.5% of CIE 1931 total visible color spectrum. Standard target for web browsing and SDR video.</p>
        </div>
        <div class="bg-bg-canvas p-4 rounded-xl border border-border-hairline space-y-1">
          <span class="text-text-muted text-[10px] uppercase block">DCI-P3 Wide Color Gamut</span>
          <strong class="text-text-primary block text-sm">Cinema &amp; HDR Standard</strong>
          <p class="font-sans text-[11px] text-text-secondary">Covers ~45.5% of CIE 1931 chromaticity. Standard target for Apple Displays, QD-OLED monitors, and HDR10 content.</p>
        </div>
      </div>

      <h3 class="text-base font-bold text-text-primary font-mono uppercase tracking-wider">ICC Profile v4.3 Binary Structure</h3>
      <p>
        An ICC (International Color Consortium) profile is a standardized 128-byte binary header followed by a tag table that maps OS RGB signal values to absolute XYZ/Lab Profile Connection Space (PCS). The zero-backend <code>IccExporter.ts</code> module builds a valid binary <code>.icc</code> profile directly in the browser by serializing:
      </p>
      <ul class="list-disc pl-5 space-y-2 text-text-secondary">
        <li><strong>Header (128 bytes):</strong> Specifies profile size, magic signature <code>'acsp'</code>, target OS platform, and illuminant D65 (X=0.9642, Y=1.0000, Z=0.8249).</li>
        <li><strong>Tag Table:</strong> Serializes <code>'rXYZ'</code>, <code>'gXYZ'</code>, <code>'bXYZ'</code> primary matrix tags and <code>'rTRC'</code>, <code>'gTRC'</code>, <code>'bTRC'</code> 2.2 gamma transfer curve tags.</li>
      </ul>
      <FAQSection faqs={faqs} />
    </article>

    <TestSwitcherBar tests={displayTests} currentId="color-gamut" />
  </div>
</Layout>

<script>
  const gamutPresets: Record<string, { r: [number,number]; g: [number,number]; b: [number,number]; srgb: number; p3: number; adobergb: number; rec2020: number }> = {
    srgb:      { r: [0.64, 0.33], g: [0.30, 0.60], b: [0.15, 0.06], srgb: 100, p3: 73, adobergb: 68, rec2020: 45 },
    'p3-90':   { r: [0.66, 0.32], g: [0.28, 0.66], b: [0.15, 0.06], srgb: 100, p3: 90, adobergb: 79, rec2020: 55 },
    'p3-98':   { r: [0.68, 0.32], g: [0.265, 0.69], b: [0.15, 0.06], srgb: 100, p3: 98, adobergb: 88, rec2020: 63 },
    adobergb:  { r: [0.64, 0.33], g: [0.21, 0.71], b: [0.15, 0.06], srgb: 100, p3: 86, adobergb: 90, rec2020: 58 },
    rec2020:   { r: [0.70, 0.29], g: [0.18, 0.79], b: [0.13, 0.05], srgb: 100, p3: 100, adobergb: 98, rec2020: 80 },
  };

  // Reference gamuts for overlay
  const refGamuts = {
    sRGB:    { r: [0.64, 0.33], g: [0.30, 0.60], b: [0.15, 0.06], color: 'rgba(255,255,255,0.3)' },
    'DCI-P3':{ r: [0.68, 0.32], g: [0.265, 0.69], b: [0.15, 0.06], color: 'rgba(59,130,246,0.4)' },
    'Rec.2020':{ r: [0.708, 0.292], g: [0.17, 0.797], b: [0.131, 0.046], color: 'rgba(16,185,129,0.3)' },
  } as const;

  const canvas = document.getElementById('cie-canvas') as HTMLCanvasElement;
  const presetSel = document.getElementById('gamut-preset') as HTMLSelectElement;

  function cieToPx(x: number, y: number, W: number, H: number): [number, number] {
    const px = (x / 0.85) * W * 0.9 + W * 0.05;
    const py = H - ((y / 0.85) * H * 0.9 + H * 0.05);
    return [px, py];
  }

  function drawCIE() {
    if (!canvas) return;
    const W = canvas.clientWidth || 320;
    const H = W;
    canvas.width = W;
    canvas.height = H;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    // Black background
    ctx.fillStyle = '#0a0a0e';
    ctx.fillRect(0, 0, W, H);

    // Draw reference gamuts
    Object.values(refGamuts).forEach(({ r, g, b, color }) => {
      ctx.beginPath();
      const [rx, ry] = cieToPx(r[0], r[1], W, H);
      const [gx, gy] = cieToPx(g[0], g[1], W, H);
      const [bx, by] = cieToPx(b[0], b[1], W, H);
      ctx.moveTo(rx, ry); ctx.lineTo(gx, gy); ctx.lineTo(bx, by); ctx.closePath();
      ctx.strokeStyle = color; ctx.lineWidth = 1.5; ctx.stroke();
    });

    // Draw selected gamut
    const preset = gamutPresets[presetSel?.value || 'p3-90'];
    ctx.beginPath();
    const [rx, ry] = cieToPx(preset.r[0], preset.r[1], W, H);
    const [gx, gy] = cieToPx(preset.g[0], preset.g[1], W, H);
    const [bx, by] = cieToPx(preset.b[0], preset.b[1], W, H);
    ctx.moveTo(rx, ry); ctx.lineTo(gx, gy); ctx.lineTo(bx, by); ctx.closePath();
    ctx.fillStyle = 'rgba(5,150,105,0.2)'; ctx.fill();
    ctx.strokeStyle = '#059669'; ctx.lineWidth = 2; ctx.stroke();

    // White point D65
    const [wx, wy] = cieToPx(0.3127, 0.3290, W, H);
    ctx.beginPath(); ctx.arc(wx, wy, 4, 0, Math.PI * 2);
    ctx.fillStyle = '#fff'; ctx.fill();

    // Labels
    ctx.fillStyle = 'rgba(255,255,255,0.6)';
    ctx.font = `${Math.round(W * 0.028)}px monospace`;
    ctx.fillText('x', W * 0.9, H * 0.95);
    ctx.fillText('y', W * 0.02, H * 0.08);

    // Update metric bars
    updateBars(preset);
  }

  function updateBars(preset: typeof gamutPresets[string]) {
    const metrics = [
      { id: 'srgb-pct', val: preset.srgb },
      { id: 'p3-pct', val: preset.p3 },
      { id: 'adobergb-pct', val: preset.adobergb },
      { id: 'rec2020-pct', val: preset.rec2020 },
    ];
    metrics.forEach(({ id, val }) => {
      const el = document.getElementById(id);
      const bar = document.getElementById(`${id}-bar`);
      if (el) el.textContent = `${val}%`;
      if (bar) bar.style.width = `${val}%`;
    });
  }

  presetSel?.addEventListener('change', drawCIE);
  window.addEventListener('resize', drawCIE);
  drawCIE();

  // ICC Export (client-side binary)
  document.getElementById('btn-export-icc')?.addEventListener('click', async () => {
    const { IccExporter } = await import('../../engine/IccExporter');
    const preset = gamutPresets[presetSel?.value || 'p3-90'];
    const gamma = parseFloat((document.getElementById('gamma-select') as HTMLSelectElement)?.value || '2.2');
    const profileBytes = IccExporter.generateIccProfile({
      profileName: `Monitor Test Hub — ${presetSel?.value || 'display'}`,
      gamma,
      whitePoint: { x: 0.3127, y: 0.3290 },
      primaries: {
        red: { x: preset.r[0], y: preset.r[1] },
        green: { x: preset.g[0], y: preset.g[1] },
        blue: { x: preset.b[0], y: preset.b[1] },
      }
    });
    const blob = new Blob([profileBytes], { type: 'application/vnd.iccprofile' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url; a.download = `monitortesthub-${presetSel?.value || 'display'}.icc`; a.click();
    setTimeout(() => URL.revokeObjectURL(url), 3000);
  });

  // Copy share URL
  document.getElementById('btn-copy-url')?.addEventListener('click', () => {
    const preset = presetSel?.value || 'p3-90';
    const shareUrl = `${window.location.origin}/display-tests/color-gamut?preset=${preset}`;
    navigator.clipboard?.writeText(shareUrl);
    const btn = document.getElementById('btn-copy-url');
    if (btn) { btn.textContent = '✓ Copied!'; setTimeout(() => { btn.textContent = 'Copy Share URL'; }, 2000); }
  });
</script>
