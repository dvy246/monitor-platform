---
import Layout from '../../../layouts/Layout.astro';
import Breadcrumbs from '../../../components/ui/Breadcrumbs.astro';
import SEOHead from '../../../components/seo/SEOHead.astro';
import SchemaGraph from '../../../components/seo/SchemaGraph.astro';
import { DeviceDatabase, type DeviceSpec } from '../../../engine/DeviceDatabase';
import { useTranslations, localizeLink } from '../../../utils/i18n';

const { lang } = useTranslations(Astro.url.pathname);
const devices: DeviceSpec[] = DeviceDatabase.getAllDevices();

// Group devices by category for structured browsing
const categories = [
  { id: 'monitor', label: 'High-Refresh & OLED Monitors', icon: 'MONITOR' },
  { id: 'laptop', label: 'Laptops & Mobile Workstations', icon: 'LAPTOP' },
  { id: 'handheld', label: 'Gaming Handhelds & Consoles', icon: 'HANDHELD' },
  { id: 'smartphone', label: 'Smartphones & Tablets', icon: 'SMARTPHONE' },
  { id: 'tv', label: 'OLED & Quantum Dot TVs', icon: 'TV' }
];

const breadcrumbItems = [
  { label: 'Display Suite', href: '/display-tests' },
  { label: 'Dead Pixel Test Directory' }
];

const pageTitle = "Device Dead Pixel Test Directory (2026) — ISO 9241-307 RMA Inspector";
const pageDescription = "Browse device-tailored dead pixel, stuck pixel, and screen defect inspectors for 100+ laptops, handhelds, smartphones, and OLED/IPS monitors with ISO 9241-307 RMA audit standards.";
const canonicalUrl = lang === 'en' 
  ? "https://displaytestonline.com/display-tests/dead-pixel-test"
  : `https://displaytestonline.com/${lang}/display-tests/dead-pixel-test`;

const schemaGraph = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": `${canonicalUrl}#collection`,
      "name": pageTitle,
      "url": canonicalUrl,
      "description": pageDescription,
      "mainEntity": {
        "@type": "ItemList",
        "itemListElement": devices.map((d, index) => ({
          "@type": "ListItem",
          "position": index + 1,
          "name": `${d.name} Dead Pixel Test`,
          "url": lang === 'en' 
            ? `https://displaytestonline.com/display-tests/dead-pixel-test/${d.slug}` 
            : `https://displaytestonline.com/${lang}/display-tests/dead-pixel-test/${d.slug}`
        }))
      }
    }
  ]
};

---

<Layout title={pageTitle} description={pageDescription} canonicalUrl={canonicalUrl}>
  <script type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

  <div class="max-w-7xl mx-auto px-4 py-8 space-y-8 font-sans">
    <Breadcrumbs items={breadcrumbItems} />

    <header class="space-y-4 border-b border-border-hairline pb-6 font-mono">
      <div class="flex items-center gap-2 text-status-pass text-xs font-bold uppercase tracking-wider">
        <span class="w-2 h-2 rounded-full bg-status-pass led-glow-pass"></span>
        PROGRAMMATIC pSEO DEVICE WARRANTY AUDIT HUB
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-text-primary tracking-tight font-sans">
        Device Dead Pixel Test Directory
      </h1>
      <p class="text-sm text-text-secondary max-w-3xl font-sans leading-relaxed">
        Select your specific laptop, monitor, TV, or mobile device to launch a pre-configured dead pixel and stuck pixel inspector. Formatted for exact resolution, aspect ratio, sub-pixel geometry, and ISO 9241-307 Class I-IV RMA warranty standards.
      </p>
    </header>

    <!-- Quick Stats Overview Bar -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 font-mono">
      <div class="bg-bg-surface/80 border border-border-hairline rounded-xl p-4">
        <div class="text-xs text-text-muted">Total Devices</div>
        <div class="text-2xl font-bold text-status-pass">{devices.length} Models</div>
      </div>
      <div class="bg-bg-surface/80 border border-border-hairline rounded-xl p-4">
        <div class="text-xs text-text-muted">RMA Standard</div>
        <div class="text-2xl font-bold text-cyan-400">ISO 9241-307</div>
      </div>
      <div class="bg-bg-surface/80 border border-border-hairline rounded-xl p-4">
        <div class="text-xs text-text-muted">Verification</div>
        <div class="text-2xl font-bold text-amber-400">SHA-256 Ledger</div>
      </div>
      <div class="bg-bg-surface/80 border border-border-hairline rounded-xl p-4">
        <div class="text-xs text-text-muted">Matrix Support</div>
        <div class="text-2xl font-bold text-purple-400">OLED / IPS / VA</div>
      </div>
    </div>

    <!-- Categorized Devices Grid -->
    <div class="space-y-12">
      {categories.map(cat => {
        const catDevices = devices.filter(d => d.category === cat.id);
        if (catDevices.length === 0) return null;

        return (
          <section class="space-y-4">
            <div class="flex items-center gap-3 border-b border-border-hairline/60 pb-3">
              <span class="text-xs font-mono px-2 py-0.5 rounded bg-bg-surface border border-border-hairline text-cyan-400 font-bold">{cat.icon}</span>
              <h2 class="text-xl font-bold text-text-primary font-mono">{cat.label}</h2>
              <span class="text-xs font-mono text-text-muted px-2 py-0.5 rounded bg-bg-surface border border-border-hairline">
                {catDevices.length} Models
              </span>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
              {catDevices.map(device => (
                <a
                  href={localizeLink(`/display-tests/dead-pixel-test/${device.slug}`, lang)}
                  class="group flex flex-col justify-between p-4 rounded-xl bg-bg-surface/80 border border-border-hairline hover:border-status-pass/50 hover:bg-bg-elevated/80 transition-all shadow-sm font-sans"
                >
                  <div class="space-y-2">
                    <div class="flex items-start justify-between gap-2">
                      <span class="text-xs font-mono text-status-pass font-bold">{device.brand}</span>
                      <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-bg-canvas border border-border-hairline text-text-muted">
                        {device.displayTech}
                      </span>
                    </div>
                    <h3 class="text-sm font-bold text-text-primary group-hover:text-status-pass transition-colors line-clamp-2">
                      {device.name}
                    </h3>
                    <p class="text-xs text-text-muted line-clamp-2 leading-relaxed">
                      {device.description}
                    </p>
                  </div>

                  <div class="mt-4 pt-3 border-t border-border-hairline/60 flex items-center justify-between text-xs font-mono text-text-secondary">
                    <span>{device.resolutionWidth}×{device.resolutionHeight} ({device.ppi} PPI)</span>
                    <span class="text-status-pass font-bold group-hover:translate-x-1 transition-transform">Audit &rarr;</span>
                  </div>
                </a>
              ))}
            </div>
          </section>
        );
      })}
    </div>
  </div>
</Layout>
