---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import TestSwitcherBar from '../../components/ui/TestSwitcherBar.astro';
import TestGuideModal from '../../components/ui/TestGuideModal.astro';
import FAQSection from '../../components/ui/FAQSection.astro';

import PaletteCard from '../../components/ui/sidebar/PaletteCard.astro';
import InspectorCard from '../../components/ui/sidebar/InspectorCard.astro';
import PassportCard from '../../components/ui/sidebar/PassportCard.astro';
import ShortcutCard from '../../components/ui/sidebar/ShortcutCard.astro';
import InfoCard from '../../components/ui/sidebar/InfoCard.astro';

const faqs = [
  {
    question: "What is the difference between a dead pixel and a stuck pixel?",
    answer: "A dead pixel is a completely unpowered transistor state that remains permanently black across all background colors. A stuck pixel is a locked sub-pixel (Red, Green, or Blue) that remains permanently illuminated regardless of what image is rendered on screen."
  },
  {
    question: "How do I test my monitor or TV for dead pixels online?",
    answer: "Launch our free online Dead Pixel Test in fullscreen mode. Cycle through solid primary colors (Red, Green, Blue, White, Black, Gray). Inspect your display closely: dead pixels appear as fixed black dots, while stuck sub-pixels display a fixed color on contrasting backgrounds."
  },
  {
    question: "Can dead pixels be fixed without replacing the screen?",
    answer: "Stuck sub-pixels can sometimes be recovered using rapid sub-pixel color flashing tools or gentle physical pressure using a soft micro-fiber cloth over the affected coordinate. However, true dead black pixels (failed thin-film transistors) require panel replacement."
  },
  {
    question: "How many dead pixels warrant a monitor RMA under ISO 9241-307?",
    answer: "Under ISO 9241-307 Class I display standards (zero defect policy), even 1 dead pixel qualifies for replacement. Under Class II (standard consumer monitors), manufacturers allow up to 2 permanently bright pixels or 5 permanently dark sub-pixels per million pixels before approving an RMA."
  },
  {
    question: "Why do dead pixels occur on LCD and OLED screens?",
    answer: "Dead pixels occur during semiconductor fabrication or physical impact due to microscopic thin-film transistor (TFT) gate failure or broken indium tin oxide (ITO) trace contacts."
  },
  {
    question: "How do I test for dead pixels on an OLED TV or smartphone?",
    answer: "Open this webpage on your Smart TV browser, iPhone, or Android device. Tap or click fullscreen test mode. Observe pure black (OLED off) and solid white/red/green/blue slides to inspect for dark or stuck sub-pixels."
  },
  {
    question: "What is a hot pixel vs a stuck pixel?",
    answer: "A hot pixel is a sub-pixel permanently stuck at 100% white luminance. A stuck pixel is locked to a single primary color (Red, Green, or Blue)."
  },
  {
    question: "Does manufacturer warranty cover 1 single dead pixel on a new monitor?",
    answer: "Most manufacturers enforce ISO 9241-307 Class II guidelines requiring 3–5 dead pixels for an RMA unless the monitor is explicitly sold under a 'Zero Bright Pixel' guarantee (e.g. ASUS ROG, Dell UltraSharp)."
  },
  {
    question: "Should I run a dead pixel test immediately after unboxing a new screen?",
    answer: "Yes. Testing your display within the 14-day or 30-day retailer return window allows instant exchange without dealing with manufacturer RMA warranty limits."
  },
  {
    question: "How does the Shift+Click defect pin marker tool work?",
    answer: "While running the fullscreen test, press Shift + Click directly over any detected defect coordinate. Our engine drops a pulsing pin marker and logs exact pixel coordinates so you can photograph the issue for RMA documentation."
  }
];

const guideSteps = [
  "Click 'START FULLSCREEN TEST' or select a target color from the palette.",
  "Look closely at your screen at native resolution across solid Red, Green, Blue, Black, and White backgrounds.",
  "Dead pixels appear as permanently dark black dots. Stuck sub-pixels stay illuminated with a single color.",
  "Shift + Click any defect location to mark its coordinates. Press ESC at any time to exit."
];

const breadcrumbItems = [
  { label: 'Display Suite', href: '/display-tests' },
  { label: 'Dead Pixel & Color Test' }
];

const displayTests = [
  { id: 'dead-pixel', label: 'Dead Pixel Test', href: '/display-tests/dead-pixel', active: true },
  { id: 'sub-pixel', label: 'Sub-Pixel Analyzer', href: '/display-tests/sub-pixel' },
  { id: 'uniformity', label: 'OLED Uniformity', href: '/display-tests/uniformity' },
  { id: 'vrr', label: 'VRR Sync Engine', href: '/display-tests/vrr' },
  { id: 'oled-burn-in', label: 'OLED Burn-In Risk', href: '/display-tests/oled-burn-in' },
  { id: 'hdr-test', label: 'HDR Brightness', href: '/display-tests/hdr-test' },
  { id: 'ppi-calculator', label: 'PPI Calculator', href: '/display-tests/ppi-calculator' },
  { id: 'color-gamut', label: 'Color Gamut & ICC', href: '/display-tests/color-gamut' }
];

const colors = [
  { id: 'white', name: 'Solid White (255,255,255)', hex: '#ffffff', textColor: 'text-zinc-900', key: '1' },
  { id: 'black', name: 'Solid Black (0,0,0 — OLED Off)', hex: '#000000', textColor: 'text-zinc-100', key: '2' },
  { id: 'red', name: 'Pure Red (255,0,0)', hex: '#ff0000', textColor: 'text-white', key: '3' },
  { id: 'green', name: 'Pure Green (0,255,0)', hex: '#00ff00', textColor: 'text-zinc-900', key: '4' },
  { id: 'blue', name: 'Pure Blue (0,0,255)', hex: '#0000ff', textColor: 'text-white', key: '5' },
  { id: 'gray50', name: '50% Neutral Gray (128,128,128)', hex: '#808080', textColor: 'text-white', key: '6' },
  { id: 'gray05', name: '5% OLED Near-Black Uniformity', hex: '#0d0d11', textColor: 'text-zinc-400', key: '7' },
  { id: 'gray10', name: '10% OLED Near-Black Uniformity', hex: '#1a1a22', textColor: 'text-zinc-300', key: '8' },
  { id: 'cyan', name: 'Cyan (0,255,255)', hex: '#00ffff', textColor: 'text-zinc-900', key: '9' },
  { id: 'magenta', name: 'Magenta (255,0,255)', hex: '#ff00ff', textColor: 'text-white', key: '0' },
  { id: 'yellow', name: 'Yellow (255,255,0)', hex: '#ffff00', textColor: 'text-zinc-900', key: 'Y' }
];
---

<Layout 
  title="Dead Pixel & Screen Color Test Online | Monitor Test Hub"
  description="Test your screen for dead pixels, stuck sub-pixels, and backlight bleed. Instant fullscreen RGBW color cycling for monitors, TVs, and phones. Start free test!"
  faqs={faqs}
>
  <div class="max-w-7xl mx-auto px-4 py-8 space-y-8 min-w-0 w-full overflow-hidden font-sans">
    <Breadcrumbs items={breadcrumbItems} />

    <TestGuideModal 
      testId="dead-pixel"
      testTitle="Dead Pixel & Screen Color Test Guide"
      steps={guideSteps}
      fullscreenButtonId="btn-launch-deadpixel"
    />

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
      
      <!-- Left Canvas (lg:col-span-8) -->
      <div class="lg:col-span-8 space-y-8 min-w-0">
        <header class="space-y-3 border-b border-border-hairline pb-6">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2 text-status-pass text-xs font-mono font-bold uppercase tracking-wider">
              <span class="w-2 h-2 rounded-full bg-status-pass led-glow-pass"></span>
              ISO 9241-307 PIXEL DEFECT BENCHMARK
            </div>
            <button
              type="button"
              onclick="window.openGuide_dead_pixel ? window.openGuide_dead_pixel() : null"
              class="px-3.5 py-1.5 rounded-full bg-bg-surface border border-border-hairline text-slate-300 hover:text-white text-xs font-bold font-mono transition-colors duration-200 cursor-pointer hover:border-status-pass/40 flex items-center gap-2 min-h-[44px]"
            >
              <svg class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
              </svg>
              <span>How To Test</span>
            </button>
          </div>
          <h1 class="text-3xl sm:text-4xl font-extrabold text-text-primary tracking-tight font-mono">
            Dead Pixel &amp; Screen Color Test
          </h1>
          <p class="text-sm text-text-secondary max-w-3xl font-sans leading-relaxed">
            Check your display for stuck pixels, dead pixels, backlight bleed, and OLED uniformity artifacts across 11 precision test colors. Click or press <kbd class="px-1.5 py-0.5 rounded border border-border-hairline font-mono text-xs">Space</kbd> to cycle colors in full-screen mode.
          </p>
        </header>

        <!-- Interactive Test Deck Container -->
        <div class="bg-bg-surface border border-border-hairline rounded-xl p-6 font-mono shadow-specular-top">
          <div class="flex items-center justify-between border-b border-border-hairline pb-4 mb-6">
            <div class="flex items-center gap-3">
              <span class="w-3 h-3 rounded-full bg-status-pass led-glow-pass"></span>
              <h2 class="text-sm font-bold text-text-primary uppercase tracking-wider">Precision Color Palette &amp; Launcher</h2>
            </div>
            <span class="text-xs text-text-muted bg-bg-elevated px-2.5 py-1 rounded border border-border-hairline">FULLSCREEN 100dvh</span>
          </div>

          <!-- Color Grid Picker -->
          <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-3 mb-6">
            {colors.map((c, i) => (
              <button
                type="button"
                data-color-hex={c.hex}
                data-color-id={c.id}
                data-color-name={c.name}
                class="color-card p-3 rounded-lg border border-border-hairline flex flex-col justify-between h-24 text-left transition-colors duration-200 cursor-pointer shadow-specular-top group"
                style={`background-color: ${c.hex}`}
              >
                <div class="flex items-center justify-between">
                  <span class={`text-[10px] font-bold uppercase tracking-wider px-1.5 py-0.5 rounded bg-black/40 ${c.textColor}`}>
                    [ {c.key} ]
                  </span>
                  <span class="text-[9px] opacity-60 font-bold group-hover:opacity-100 transition-opacity text-white bg-black/50 px-1 rounded">
                    SELECT
                  </span>
                </div>
                <span class={`text-xs font-bold font-mono tracking-tight drop-shadow-sm ${c.textColor}`}>
                  {c.name.split(' ')[0]} {c.name.split(' ')[1]}
                </span>
              </button>
            ))}
          </div>

          <!-- Primary Action Controls -->
          <div class="flex flex-wrap items-center justify-between gap-4 p-4 bg-bg-canvas rounded-lg border border-border-hairline">
            <div class="space-y-1">
              <span class="text-xs font-bold text-text-primary uppercase tracking-wider block">LAUNCH FULLSCREEN TEST</span>
              <p class="text-[11px] text-text-muted font-sans">
                Hotkeys: <kbd class="px-1 bg-bg-surface border border-border-hairline rounded">Space</kbd> Next Color | <kbd class="px-1 bg-bg-surface border border-border-hairline rounded">1-9</kbd> Jump Color | <kbd class="px-1 bg-bg-surface border border-border-hairline rounded">F</kbd> Fullscreen | <kbd class="px-1 bg-bg-surface border border-border-hairline rounded">Esc</kbd> Exit
              </p>
            </div>

            <div class="flex gap-3">
              <button
                id="btn-launch-deadpixel"
                class="min-h-[44px] px-5 py-2.5 rounded-lg bg-status-pass text-bg-canvas font-bold text-xs hover:opacity-90 transition-opacity cursor-pointer shadow-specular-top flex items-center gap-2"
              >
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"/></svg>
                START FULLSCREEN TEST
              </button>
            </div>
          </div>

          <!-- 30-Day Keep-Or-Return Panel Inspection Banner -->
          <div class="mt-6 p-5 bg-bg-canvas rounded-xl border border-status-pass/30 flex flex-col sm:flex-row items-center justify-between gap-4 relative overflow-hidden">
            <div class="space-y-1 text-center sm:text-left">
              <div class="flex items-center gap-2 justify-center sm:justify-start text-[10px] font-bold text-status-pass uppercase tracking-widest">
                <span class="w-2 h-2 rounded-full bg-status-pass led-glow-pass"></span>
                30-DAY RETAILER RETURN WINDOW INSPECTOR
              </div>
              <h3 class="text-sm font-bold text-text-primary">Need Proof of Panel Condition for Return or Resale?</h3>
              <p class="text-xs text-text-secondary font-sans max-w-xl">
                Evaluate your display against ISO 9241-307 Class I–IV defect standards and generate a cryptographically signed SHA-256 Hardware Passport badge to attach to retailer returns or eBay/Reddit marketplace listings.
              </p>
            </div>

            <button 
              id="btn-launch-passport-from-deadpixel"
              onclick="window.openHardwarePassport ? window.openHardwarePassport() : null"
              class="min-h-[44px] px-4 py-2.5 rounded-lg bg-bg-surface text-status-pass font-bold text-xs border border-status-pass/40 hover:bg-status-pass/10 transition-colors duration-200 whitespace-nowrap cursor-pointer flex items-center gap-1.5"
            >
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
              GENERATE HARDWARE PASSPORT
            </button>
          </div>
        </div>

        <!-- Engineering Methodology & Standards Article -->
        <article class="bg-bg-surface border border-border-hairline rounded-2xl p-6 sm:p-8 space-y-6 shadow-specular-top font-sans text-sm text-text-secondary leading-relaxed">
          <div class="border-b border-border-hairline pb-4">
            <span class="font-mono text-[10px] font-bold text-status-pass uppercase tracking-widest block mb-1">ISO 9241-307 ENGINEERING METHODOLOGY</span>
            <h2 class="text-xl font-bold text-text-primary">Display Defect Classification &amp; ISO Ergonomic Standards</h2>
          </div>

          <p>
            The ISO 9241-307 standard establishes formal benchmarks for ergonomic requirements and visual display unit defect tolerances across commercial LCD, OLED, and QD-OLED panels. A <strong>dead pixel</strong> occurs when a liquid crystal sub-pixel or organic light-emitting transistor remains permanently unpowered (Class 0 to Class 3 failure), resulting in a persistent black dot on white background fills.
          </p>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-4 font-mono text-xs my-4">
            <div class="bg-bg-canvas p-4 rounded-xl border border-border-hairline space-y-1">
              <span class="text-text-muted text-[10px] block uppercase">TYPE 1 DEFECT</span>
              <strong class="text-text-primary block text-sm">Hot Pixel (Always White)</strong>
              <p class="font-sans text-[11px] text-text-secondary">Sub-pixel transistor locked in full luminance state across RGB channels.</p>
            </div>
            <div class="bg-bg-canvas p-4 rounded-xl border border-border-hairline space-y-1">
              <span class="text-text-muted text-[10px] block uppercase">TYPE 2 DEFECT</span>
              <strong class="text-text-primary block text-sm">Dead Pixel (Always Black)</strong>
              <p class="font-sans text-[11px] text-text-secondary">Transistor unpowered; remains dark regardless of underlying signal color.</p>
            </div>
            <div class="bg-bg-canvas p-4 rounded-xl border border-border-hairline space-y-1">
              <span class="text-text-muted text-[10px] block uppercase">TYPE 3 DEFECT</span>
              <strong class="text-text-primary block text-sm">Stuck Pixel (RGB Channel)</strong>
              <p class="font-sans text-[11px] text-text-secondary">Individual Red, Green, or Blue sub-pixel channel frozen on or off.</p>
            </div>
          </div>

          <h3 class="text-base font-bold text-text-primary font-mono uppercase tracking-wider">ISO 9241-307 Panel Defect Classes (Per Million Pixels)</h3>
          <div class="overflow-x-auto font-mono text-xs">
            <table class="w-full text-left border-collapse border border-border-hairline">
              <thead>
                <tr class="bg-bg-elevated border-b border-border-hairline text-text-primary">
                  <th class="p-2.5 border-r border-border-hairline">ISO Class</th>
                  <th class="p-2.5 border-r border-border-hairline">Type 1 (Hot)</th>
                  <th class="p-2.5 border-r border-border-hairline">Type 2 (Dead)</th>
                  <th class="p-2.5 border-r border-border-hairline">Type 3 (Stuck)</th>
                  <th class="p-2.5">Cluster Limit (5x5px)</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-border-hairline text-text-secondary">
                <tr>
                  <td class="p-2.5 border-r border-border-hairline font-bold text-status-pass">Class 0</td>
                  <td class="p-2.5 border-r border-border-hairline">0</td>
                  <td class="p-2.5 border-r border-border-hairline">0</td>
                  <td class="p-2.5 border-r border-border-hairline">0</td>
                  <td class="p-2.5">Zero tolerance (Medical Grade)</td>
                </tr>
                <tr>
                  <td class="p-2.5 border-r border-border-hairline font-bold text-text-primary">Class I</td>
                  <td class="p-2.5 border-r border-border-hairline">1</td>
                  <td class="p-2.5 border-r border-border-hairline">1</td>
                  <td class="p-2.5 border-r border-border-hairline">5</td>
                  <td class="p-2.5">Max 0 clusters</td>
                </tr>
                <tr>
                  <td class="p-2.5 border-r border-border-hairline font-bold text-text-secondary">Class II</td>
                  <td class="p-2.5 border-r border-border-hairline">2</td>
                  <td class="p-2.5 border-r border-border-hairline">2</td>
                  <td class="p-2.5 border-r border-border-hairline">10</td>
                  <td class="p-2.5">Max 2 clusters</td>
                </tr>
              </tbody>
            </table>
          </div>
        </article>

        <FAQSection faqs={faqs} />
        <TestSwitcherBar tests={displayTests} currentId="dead-pixel" />
      </div>

      <!-- Right Modular Sidebar (lg:col-span-4) -->
      <div class="lg:col-span-4 space-y-6 sticky top-24 self-start min-w-0">
        <PaletteCard
          title="Test Color Swatches"
          subtitle="RGB & Uniformity Fills"
          activeHex="#ffffff"
          swatches={[
            { id: 'white', hex: '#ffffff', label: 'WHITE' },
            { id: 'black', hex: '#000000', label: 'BLACK' },
            { id: 'red', hex: '#ff0000', label: 'RED' },
            { id: 'green', hex: '#00ff00', label: 'GREEN' },
            { id: 'blue', hex: '#0000ff', label: 'BLUE' },
            { id: 'gray50', hex: '#808080', label: 'GRAY50' },
            { id: 'gray05', hex: '#0d0d11', label: 'GRAY05' },
            { id: 'gray10', hex: '#1a1a22', label: 'GRAY10' }
          ]}
        />

        <InspectorCard
          title="Defect Inspector"
          subtitle="Coordinates & Pin Marker"
          rows={[
            { key: 'Active Color', value: '#FFFFFF (White)' },
            { key: 'Pinned Defects', value: 0, highlight: true },
            { key: 'ISO 9241 Target', value: 'Class I (Zero Defect)' }
          ]}
        />

        <PassportCard
          deviceModel="Generic Display Unit"
          healthIndex={100}
          rmaStatus="ELIGIBLE"
          rmaDetails="Panel defects within Class I specs. Return window active."
          submitTelemetryEnabled={true}
        />

        <ShortcutCard
          shortcuts={[
            { keys: ['Space', '→'], label: 'Cycle Next Color' },
            { keys: ['1', '9'], label: 'Direct Color Jump' },
            { keys: ['Shift', 'Click'], label: 'Drop Defect Pin Marker' },
            { keys: ['F'], label: 'Toggle Fullscreen' },
            { keys: ['Esc'], label: 'Exit Overlay' }
          ]}
        />

        <InfoCard
          title="ISO 9241-307 Class I-IV"
          subtitle="Defect Class Limits"
          badgeText="ISO Standard"
          citations={[
            {
              standard: "ISO 9241-307 Class I",
              clause: "Table 1.1",
              description: "Allows zero bright pixels (Type 1), max 1 dark pixel (Type 2), and max 2 subpixel faults per million."
            }
          ]}
          osdTips={[
            "Set monitor OSD Brightness to 100% and Contrast to 50% for pinhole defect inspection.",
            "Disable local dimming / zone backlight control during dead pixel inspection."
          ]}
        />
      </div>

    </div>
  </div>

  <!-- Fullscreen Diagnostic Overlay Modal -->
  <div
    id="deadpixel-overlay"
    class="fixed inset-0 z-50 hidden select-none cursor-crosshair font-mono"
    tabindex="0"
    aria-label="Fullscreen Dead Pixel Test Overlay"
  >
    <!-- Auto-Hiding Top Control Bar -->
    <div
      id="overlay-hud"
      class="absolute top-4 left-1/2 -translate-x-1/2 bg-black/80 backdrop-blur-md border border-white/20 text-white px-4 py-2 rounded-full flex items-center gap-4 text-xs shadow-2xl transition-opacity duration-300 pointer-events-auto"
    >
      <div class="flex items-center gap-2">
        <span id="hud-color-swatch" class="w-3 h-3 rounded-full border border-white/40"></span>
        <span id="hud-color-name" class="font-bold tracking-wide">Solid White</span>
      </div>

      <span class="w-px h-3 bg-white/20"></span>

      <div class="flex items-center gap-2 text-[11px] text-zinc-300">
        <span>Defects Pinned: <strong id="defect-count" class="text-status-pass font-mono">0</strong></span>
      </div>

      <span class="w-px h-3 bg-white/20"></span>

      <div class="flex items-center gap-2 text-[10px]">
        <span class="text-zinc-400">Click / Space = Next</span>
        <button id="btn-exit-overlay" class="min-h-[44px] px-3 py-1 rounded bg-red-500/80 hover:bg-red-500 text-white font-bold cursor-pointer transition-colors duration-200">
          EXIT (Esc)
        </button>
      </div>
    </div>

    <!-- Container for Pin Markers -->
    <div id="pin-container" class="absolute inset-0 pointer-events-none"></div>
  </div>
</Layout>

<script>
  const colors = [
    { hex: '#ffffff', name: 'Solid White (255,255,255)' },
    { hex: '#000000', name: 'Solid Black (OLED Off)' },
    { hex: '#ff0000', name: 'Pure Red' },
    { hex: '#00ff00', name: 'Pure Green' },
    { hex: '#0000ff', name: 'Pure Blue' },
    { hex: '#808080', name: '50% Neutral Gray' },
    { hex: '#0d0d11', name: '5% OLED Near-Black' },
    { hex: '#1a1a22', name: '10% OLED Near-Black' },
    { hex: '#00ffff', name: 'Cyan' },
    { hex: '#ff00ff', name: 'Magenta' },
    { hex: '#ffff00', name: 'Yellow' }
  ];

  let currentIndex = 0;
  let defectPins: Array<{ x: number; y: number }> = [];
  let hudTimeout: ReturnType<typeof setTimeout> | null = null;

  const overlay = document.getElementById('deadpixel-overlay');
  const hud = document.getElementById('overlay-hud');
  const hudColorName = document.getElementById('hud-color-name');
  const hudColorSwatch = document.getElementById('hud-color-swatch');
  const defectCount = document.getElementById('defect-count');
  const pinContainer = document.getElementById('pin-container');
  const btnLaunch = document.getElementById('btn-launch-deadpixel');
  const btnExit = document.getElementById('btn-exit-overlay');
  const cards = document.querySelectorAll('.color-card');

  function setColor(index: number) {
    currentIndex = (index + colors.length) % colors.length;
    const c = colors[currentIndex];
    if (overlay) overlay.style.backgroundColor = c.hex;
    if (hudColorName) hudColorName.textContent = c.name;
    if (hudColorSwatch) hudColorSwatch.style.backgroundColor = c.hex;
    showHudTemporarily();
  }

  function showHudTemporarily() {
    if (!hud) return;
    hud.style.opacity = '1';
    if (hudTimeout) clearTimeout(hudTimeout);
    hudTimeout = setTimeout(() => {
      hud.style.opacity = '0';
    }, 2500);
  }

  function openTest(startIndex = 0) {
    if (!overlay) return;
    setColor(startIndex);
    overlay.classList.remove('hidden');
    overlay.focus();
    if (overlay.requestFullscreen) {
      overlay.requestFullscreen().catch(() => {});
    }
  }

  function closeTest() {
    if (!overlay) return;
    overlay.classList.add('hidden');
    document.body.style.overflow = '';
    document.body.classList.remove('overflow-hidden');
    if (document.fullscreenElement) {
      document.exitFullscreen().catch(() => {});
    }
  }

  function addPin(x: number, y: number) {
    defectPins.push({ x, y });
    if (defectCount) defectCount.textContent = String(defectPins.length);

    if (pinContainer) {
      const pin = document.createElement('div');
      pin.className = 'absolute w-6 h-6 -ml-3 -mt-3 rounded-full border-2 border-red-500 bg-red-500/30 animate-ping pointer-events-none';
      pin.style.left = `${x}px`;
      pin.style.top = `${y}px`;

      const dot = document.createElement('div');
      dot.className = 'absolute w-2 h-2 -ml-1 -mt-1 rounded-full bg-red-500 border border-white pointer-events-none';
      dot.style.left = `${x}px`;
      dot.style.top = `${y}px`;

      pinContainer.appendChild(pin);
      pinContainer.appendChild(dot);
    }
  }

  cards.forEach((card, idx) => {
    card.addEventListener('click', () => openTest(idx));
  });

  btnLaunch?.addEventListener('click', () => openTest(0));
  btnExit?.addEventListener('click', (e) => {
    e.stopPropagation();
    e.preventDefault();
    closeTest();
  });

  overlay?.addEventListener('mousemove', showHudTemporarily);

  overlay?.addEventListener('click', (e) => {
    if (e.shiftKey) {
      addPin(e.clientX, e.clientY);
      return;
    }
    setColor(currentIndex + 1);
  });

  overlay?.addEventListener('keydown', (e: KeyboardEvent) => {
    if (e.key === 'Escape') {
      closeTest();
    } else if (e.key === ' ' || e.key === 'ArrowRight' || e.key === 'ArrowDown') {
      e.preventDefault();
      setColor(currentIndex + 1);
    } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
      e.preventDefault();
      setColor(currentIndex - 1);
    } else if (e.key >= '1' && e.key <= '9') {
      setColor(parseInt(e.key, 10) - 1);
    } else if (e.key === '0') {
      setColor(9);
    } else if (e.key.toLowerCase() === 'y') {
      setColor(10);
    } else if (e.key.toLowerCase() === 'f') {
      if (!document.fullscreenElement && overlay.requestFullscreen) {
        overlay.requestFullscreen().catch(() => {});
      } else if (document.exitFullscreen) {
        document.exitFullscreen().catch(() => {});
      }
    } else if (e.key.toLowerCase() === 'h') {
      showHudTemporarily();
    }
  });
</script>
