---
import Layout from '../../layouts/Layout.astro';
import GammaCalibration from '../../components/diagnostics/GammaCalibration.astro';

const faqs = [
  {
    question: "Why is Gamma 2.2 considered the standard for desktop monitors?",
    answer: "Gamma 2.2 closely mirrors human visual perception of dark and light shades, ensuring balanced shadow detail and highlight contrast across web browsing, digital photography, and video playback."
  },
  {
    question: "How do I know if my monitor gamma is incorrect?",
    answer: "If gamma is too low (e.g. 1.8), images appear washed out with weak blacks. If gamma is too high (e.g. 2.6), shadow details are crushed into flat black areas."
  },
  {
    question: "Can browser display scaling affect gamma test accuracy?",
    answer: "Yes, browser zooming or OS display scaling (125%, 150%) blurs 1-pixel dither patterns. Ensure browser zoom is set to 100% (Ctrl+0) for true pixel mapping."
  },
  {
    question: "What is the difference between sRGB gamma and BT.1886 gamma?",
    answer: "sRGB gamma utilizes a linear toe near zero black followed by a 2.4 exponent (averaging ~2.2), designed for bright offices. BT.1886 is a pure 2.4 gamma curve designed for dark-room video mastering."
  }
];
---

<Layout 
  title="Monitor Gamma Test | 2.2 EOTF Calibration & Curve Checker"
  description="Evaluate your display gamma calibration online. High-precision dither pattern tool to test 1.8, 2.2, and 2.4 gamma curve accuracy under ITU-R BT.709 standards."
>
  <main id="main-content" class="py-10 px-4 sm:px-6 lg:px-8 space-y-12">
    <section class="max-w-4xl mx-auto text-center space-y-4">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-status-pass/10 border border-status-pass/30 text-xs font-mono text-status-pass font-bold">
        <span>ITU-R BT.709 &amp; IEC 61966-2-1 STANDARDS</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold font-mono tracking-tight text-text-primary">
        Monitor Gamma 2.2 EOTF Calibration Evaluator
      </h1>
      <p class="text-sm sm:text-base text-text-muted leading-relaxed max-w-2xl mx-auto">
        Test your display's gamma curve response using high-frequency visual dither patterns to ensure accurate midtone luminance rendering.
      </p>
    </section>

    <GammaCalibration />

    <article class="max-w-4xl mx-auto space-y-8 bg-bg-surface/80 border border-border-hairline rounded-2xl p-6 sm:p-8 backdrop-blur-xl text-sm text-text-secondary leading-relaxed">
      <h2 class="text-xl font-bold font-mono text-text-primary">Understanding Display Gamma Transfer Functions</h2>
      <p>
        Gamma defines the mathematical relationship between input signal voltage and output screen luminance. Because human eyes are more sensitive to small changes in dark tones than light tones, gamma encoding compresses shadow details efficiently.
      </p>

      <h2 class="text-xl font-bold font-mono text-text-primary">Frequently Asked Questions</h2>
      <div class="space-y-4">
        {faqs.map(faq => (
          <div class="border-b border-border-hairline pb-4 space-y-1">
            <h3 class="font-bold text-text-primary font-mono">{faq.question}</h3>
            <p class="text-xs text-text-muted">{faq.answer}</p>
          </div>
        ))}
      </div>
    </article>
  </main>
</Layout>
