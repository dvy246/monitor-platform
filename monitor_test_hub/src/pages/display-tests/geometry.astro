---
import Layout from '../../layouts/Layout.astro';
import GeometryDistortion from '../../components/diagnostics/GeometryDistortion.astro';

const faqs = [
  {
    question: "Why is my display stretching images or distorting circles into ovals?",
    answer: "Distortion occurs when your operating system resolution does not match your display's native aspect ratio (e.g. running a 16:9 resolution on a 21:9 ultrawide monitor without letterboxing)."
  },
  {
    question: "How do I fix screen scaling in NVIDIA or AMD GPU control panels?",
    answer: "Set GPU scaling mode to 'Perform scaling on GPU' and select 'Aspect Ratio' to preserve proper geometric proportions without stretching."
  },
  {
    question: "What are standard display aspect ratios?",
    answer: "Common standards include 16:9 (Widescreen 1080p/1440p/4K), 16:10 (Productivity laptops/monitors), 21:9 (Ultrawide), and 32:9 (Super Ultrawide)."
  },
  {
    question: "How does this test verify square pixels?",
    answer: "The test renders mathematical concentric circles. If your display or GPU scales pixels non-uniformly, the rendered circles will measure unequal horizontal and vertical pixel lengths."
  }
];
---

<Layout 
  title="Aspect Ratio & Geometry Test | Screen Scaling Validator"
  description="Validate your monitor's aspect ratio and screen geometry. Check for non-square pixel stretching and scaling distortion with precision grid patterns under EBU Tech 3325 standards."
>
  <main id="main-content" class="py-10 px-4 sm:px-6 lg:px-8 space-y-12">
    <section class="max-w-4xl mx-auto text-center space-y-4">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-status-pass/10 border border-status-pass/30 text-xs font-mono text-status-pass font-bold">
        <span>EBU TECH 3325 GEOMETRY STANDARDS</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold font-mono tracking-tight text-text-primary">
        Aspect Ratio &amp; Geometry Distortion Validator
      </h1>
      <p class="text-sm sm:text-base text-text-muted leading-relaxed max-w-2xl mx-auto">
        Inspect your display for non-square pixel stretching, aspect ratio scaling errors, and geometric image distortion.
      </p>
    </section>

    <GeometryDistortion />

    <article class="max-w-4xl mx-auto space-y-8 bg-bg-surface/80 border border-border-hairline rounded-2xl p-6 sm:p-8 backdrop-blur-xl text-sm text-text-secondary leading-relaxed">
      <h2 class="text-xl font-bold font-mono text-text-primary">Understanding Display Aspect Ratio &amp; Geometric Scaling</h2>
      <p>
        Computer displays use square pixels (1:1 pixel aspect ratio). When non-native resolutions are scaled incorrectly by OS or GPU drivers, visual elements stretch, turning circles into distorted ovals.
      </p>

      <h2 class="text-xl font-bold font-mono text-text-primary">Frequently Asked Questions</h2>
      <div class="space-y-4">
        {faqs.map(faq => (
          <div class="border-b border-border-hairline pb-4 space-y-1">
            <h3 class="font-bold text-text-primary font-mono">{faq.question}</h3>
            <p class="text-xs text-text-muted">{faq.answer}</p>
          </div>
        ))}
      </div>
    </article>
  </main>
</Layout>
