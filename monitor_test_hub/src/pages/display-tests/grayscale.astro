---
import Layout from '../../layouts/Layout.astro';
import GrayscaleStep from '../../components/diagnostics/GrayscaleStep.astro';

const faqs = [
  {
    question: "What is black crush on a display?",
    answer: "Black crush occurs when a monitor fails to distinguish between pure black and dark gray shades, merging subtle shadow details into a flat, featureless black void."
  },
  {
    question: "What is white clipping?",
    answer: "White clipping happens when bright highlight shades (e.g. RGB 250 to 255) are blown out to pure white, losing texture in clouds, snow, or bright UI elements."
  },
  {
    question: "How do I fix black crush on my monitor?",
    answer: "Adjust your monitor's 'Black Equalizer' or 'Shadow Boost' setting in OSD menu, ensure GPU output range is set to 'Full (0-255)', and calibrate gamma to 2.2."
  },
  {
    question: "What is HDMI RGB Limited vs Full Range?",
    answer: "Full RGB range displays luminance values from 0 to 255 (standard for PC monitors). Limited RGB uses values 16 to 235 (standard for TVs). Mismatched settings cause severe black crush or washed-out grays."
  }
];
---

<Layout 
  title="Grayscale & Contrast Step Test | Black Crush Inspector"
  description="Test your monitor for black crush and highlight clipping. Evaluate shadow detail and white level preservation with calibrated 16-step grayscale ramps under DICOM GSDF standards."
>
  <main id="main-content" class="py-10 px-4 sm:px-6 lg:px-8 space-y-12">
    <section class="max-w-4xl mx-auto text-center space-y-4">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-status-pass/10 border border-status-pass/30 text-xs font-mono text-status-pass font-bold">
        <span>DICOM PART 14 GSDF STANDARDS</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold font-mono tracking-tight text-text-primary">
        Grayscale &amp; Contrast Step Ramp Inspector
      </h1>
      <p class="text-sm sm:text-base text-text-muted leading-relaxed max-w-2xl mx-auto">
        Test your display for black crush (shadow detail loss) and white highlight clipping using a calibrated 16-step grayscale luminance ramp.
      </p>
    </section>

    <GrayscaleStep />

    <article class="max-w-4xl mx-auto space-y-8 bg-bg-surface/80 border border-border-hairline rounded-2xl p-6 sm:p-8 backdrop-blur-xl text-sm text-text-secondary leading-relaxed">
      <h2 class="text-xl font-bold font-mono text-text-primary">Understanding Grayscale Step Linearity &amp; Dynamic Range</h2>
      <p>
        Calibrated grayscale rendering ensures equal perceptual separation between luminance steps from pure black (RGB 0) to pure white (RGB 255).
      </p>

      <h2 class="text-xl font-bold font-mono text-text-primary">Frequently Asked Questions</h2>
      <div class="space-y-4">
        {faqs.map(faq => (
          <div class="border-b border-border-hairline pb-4 space-y-1">
            <h3 class="font-bold text-text-primary font-mono">{faq.question}</h3>
            <p class="text-xs text-text-muted">{faq.answer}</p>
          </div>
        ))}
      </div>
    </article>
  </main>
</Layout>
