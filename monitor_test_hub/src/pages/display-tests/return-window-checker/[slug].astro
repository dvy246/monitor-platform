---
import FAQSection from '../../../components/ui/FAQSection.astro';
import Layout from '../../../layouts/Layout.astro';
import Breadcrumbs from '../../../components/ui/Breadcrumbs.astro';
import { DeviceDatabase, type DeviceSpec } from '../../../engine/DeviceDatabase';
import HardwarePassportModal from '../../../components/diagnostics/HardwarePassportModal.astro';
import AdSenseSlot from '../../../components/seo/AdSenseSlot.astro';

import StatusCard from '../../../components/ui/sidebar/StatusCard.astro';
import MetricCard from '../../../components/ui/sidebar/MetricCard.astro';
import PassportCard from '../../../components/ui/sidebar/PassportCard.astro';
import InfoCard from '../../../components/ui/sidebar/InfoCard.astro';

export function getStaticPaths() {
  const slugs = DeviceDatabase.getAllSlugs();
  return slugs.map(slug => ({
    params: { slug },
    props: { device: DeviceDatabase.getDeviceBySlug(slug)! }
  }));
}

const { slug } = Astro.params;
const device = Astro.props.device || DeviceDatabase.getDeviceBySlug(slug || 'macbook-pro') || DeviceDatabase.getAllDevices()[0];

const breadcrumbItems = [
  { label: 'Display Suite', href: '/display-tests' },
  { label: 'Return Window Checker' },
  { label: device.name }
];

const faqs = [
  {
    question: `What is the return window defect policy for ${device.name}?`,
    answer: `${device.name} features an ISO 9241-307 ${device.isoClass} panel spec (${device.displayTech} tech). ${device.rmaAdvice}`
  },
  {
    question: `How do I know if I should return my ${device.name} to the retailer?`,
    answer: `If your ${device.name} exhibits more than ${device.maxAllowedDeadPixelsRma} dead/stuck pixel(s), severe OLED near-black 5% gray vertical banding, or VSync pacing stutter within your 14-to-30 day retailer return window, return it immediately for a full exchange.`
  },
  {
    question: `How can I generate a verified Hardware Passport for my ${device.name}?`,
    answer: `Use our free, client-side 5-minute panel defect inspector. It tests dead pixels, 5% gray uniformity, and refresh rate pacing, then outputs a cryptographically signed SHA-256 receipt badge to attach to retailer returns or resale listings.`
  }
];
---

<Layout
  title={`30-Day Return Window Defect Checker — ${device.name} | Monitor Test Hub`}
  description={`Verify if your ${device.name} (${device.displayTech}, ${device.resolutionWidth}x${device.resolutionHeight}) has dead pixels or OLED banding before your retailer return window expires. ISO 9241-307 ${device.isoClass} RMA guide.`}
  faqs={faqs}
>
  <div class="max-w-7xl mx-auto px-4 py-8 space-y-8 min-w-0 w-full overflow-hidden font-sans">
    <Breadcrumbs items={breadcrumbItems} />

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
      
      <!-- Left Canvas (lg:col-span-8) -->
      <div class="lg:col-span-8 space-y-8 min-w-0 font-mono">
        <header class="space-y-4 border-b border-border-hairline pb-6">
          <div class="flex items-center gap-2 text-status-pass text-xs font-mono font-bold uppercase tracking-wider">
            <span class="w-2 h-2 rounded-full bg-status-pass led-glow-pass"></span>
            30-DAY RETAILER RETURN WINDOW DIAGNOSTIC
          </div>
          <h1 class="text-2xl sm:text-3xl font-extrabold text-text-primary tracking-tight font-mono">
            {device.name} Return &amp; Defect Inspector
          </h1>
          <p class="text-xs sm:text-sm text-text-secondary max-w-3xl font-sans leading-relaxed">
            {device.description} Use our 5-minute inspection scorecard to determine if your panel qualifies for an immediate store exchange or manufacturer RMA replacement before your 14-to-30 day return window closes.
          </p>
        </header>

        <!-- Spec Scorecard Container -->
        <div class="bg-bg-surface border border-border-hairline rounded-2xl p-6 sm:p-8 space-y-6 shadow-specular-top">
          <div class="flex items-center justify-between border-b border-border-hairline pb-4">
            <div class="flex items-center gap-3">
              <span class="w-3 h-3 rounded-full bg-status-pass led-glow-pass"></span>
              <h2 class="text-sm font-bold text-text-primary uppercase tracking-wider">Panel Specifications &amp; RMA Thresholds</h2>
            </div>
            <span class="text-xs font-bold text-status-pass px-2.5 py-1 rounded bg-status-pass/10 border border-status-pass/20">
              ISO 9241-307 {device.isoClass}
            </span>
          </div>

          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs">
            <div class="bg-bg-canvas p-3.5 rounded-xl border border-border-hairline space-y-1">
              <span class="text-[10px] text-text-muted block uppercase">Display Technology</span>
              <span class="font-bold text-text-primary">{device.displayTech} ({device.subpixelStructure})</span>
            </div>
            <div class="bg-bg-canvas p-3.5 rounded-xl border border-border-hairline space-y-1">
              <span class="text-[10px] text-text-muted block uppercase">Native Resolution</span>
              <span class="font-bold text-text-primary">{device.resolutionWidth} x {device.resolutionHeight}</span>
            </div>
            <div class="bg-bg-canvas p-3.5 rounded-xl border border-border-hairline space-y-1">
              <span class="text-[10px] text-text-muted block uppercase">Pixel Density (PPI)</span>
              <span class="font-bold text-text-primary">{device.ppi} PPI</span>
            </div>
            <div class="bg-bg-canvas p-3.5 rounded-xl border border-border-hairline space-y-1">
              <span class="text-[10px] text-text-muted block uppercase">RMA Dead Pixel Max</span>
              <span class="font-bold text-status-pass">{device.maxAllowedDeadPixelsRma} Sub-Pixel(s)</span>
            </div>
          </div>

          <!-- Official Manufacturer RMA Guidance Box -->
          <div class="p-5 bg-bg-canvas rounded-xl border border-border-hairline space-y-2">
            <span class="text-[10px] font-bold text-text-muted uppercase tracking-widest block">MANUFACTURER RMA &amp; WARRANTY POLICY</span>
            <p class="text-xs text-text-primary font-sans leading-relaxed">
              {device.rmaAdvice}
            </p>
          </div>

          <!-- Action Panel -->
          <div class="flex flex-col sm:flex-row items-center justify-between gap-4 pt-2 border-t border-border-hairline">
            <div class="space-y-1 text-center sm:text-left">
              <span class="text-xs font-bold text-text-primary uppercase">READY TO INSPECT YOUR PANEL?</span>
              <p class="text-[11px] text-text-secondary font-sans">
                Runs 5-minute fullscreen test and generates SHA-256 Hardware Passport receipt.
              </p>
            </div>

            <button
              onclick="window.openHardwarePassport ? window.openHardwarePassport() : null"
              class="min-h-[44px] px-5 py-2.5 rounded-xl bg-status-pass text-bg-canvas font-bold text-xs hover:opacity-90 transition-opacity cursor-pointer flex items-center gap-2"
            >
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
              GENERATE HARDWARE PASSPORT
            </button>
          </div>
        </div>

        <AdSenseSlot slotId="return-window-ad-1" format="horizontal" />

        <article class="bg-bg-surface border border-border-hairline rounded-2xl p-6 sm:p-8 space-y-6 shadow-specular-top font-sans">
          <div class="border-b border-border-hairline pb-4 font-mono">
            <span class="text-[10px] font-bold text-status-pass uppercase tracking-widest block mb-1">FREQUENTLY ASKED QUESTIONS</span>
            <h2 class="text-xl font-bold text-text-primary">Returning or Exchanging {device.name}</h2>
          </div>

          <div class="space-y-4 text-xs">
            {faqs.map(faq => (
              <div class="p-4 bg-bg-canvas rounded-xl border border-border-hairline space-y-1.5">
                <h3 class="font-bold text-text-primary font-mono text-xs">{faq.question}</h3>
                <p class="text-text-secondary leading-relaxed">{faq.answer}</p>
              </div>
            ))}
          </div>
        </article>

        <FAQSection faqs={faqs} />
      </div>

      <!-- Right Modular Sidebar (lg:col-span-4) -->
      <div class="lg:col-span-4 space-y-6 sticky top-24 self-start min-w-0">
        <StatusCard
          status="pass"
          label={`ISO CLASS ${device.isoClass}`}
          subtitle="Manufacturer RMA Spec"
          score="RMA"
          details={[
            { label: 'Max Dead Pixels', value: `${device.maxAllowedDeadPixelsRma}` },
            { label: 'Panel Tech', value: `${device.displayTech}` }
          ]}
        />

        <MetricCard
          title="Device Specs"
          subtitle="Resolution & Density"
          badgeText="Specifications"
          layout="list"
          metrics={[
            { id: 'resVal', label: 'Resolution', value: `${device.resolutionWidth}x${device.resolutionHeight}`, status: 'pass' },
            { id: 'ppiVal', label: 'Pixel Density', value: `${device.ppi}`, unit: 'PPI', status: 'pass' }
          ]}
        />

        <PassportCard
          deviceModel={device.name}
          healthIndex={96}
          rmaStatus="ELIGIBLE"
          rmaDetails="Within ISO 9241-307 Class I warranty limits. 30-day return window active."
          submitTelemetryEnabled={true}
        />

        <InfoCard
          title="RMA Rights & Policy"
          subtitle="Retailer Exchange Tips"
          badgeText="RMA Rights"
          citations={[
            { standard: `ISO 9241-307 ${device.isoClass}`, clause: "Defect Threshold", description: device.rmaAdvice }
          ]}
        />
      </div>

    </div>
  </div>
</Layout>
