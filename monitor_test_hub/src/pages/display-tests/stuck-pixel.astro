---
import Layout from '../../layouts/Layout.astro';
import StuckPixel from '../../components/diagnostics/StuckPixel.astro';
import EpilepsyWarning from '../../components/disclaimers/EpilepsyWarning.astro';

const faqs = [
  {
    question: "How does an online stuck pixel fixer work?",
    answer: "The tool rapidly cycles target pixels through primary RGB colors at high frequency (30Hz–60Hz), stimulating stuck liquid crystals to restore proper electronic polarity state."
  },
  {
    question: "What is the difference between a stuck pixel and a dead pixel?",
    answer: "A stuck pixel remains permanently lit as a bright Red, Green, or Blue dot due to a stuck liquid crystal (often fixable). A dead pixel is permanently black due to a broken transistor (hardware failure, unfixable via software)."
  },
  {
    question: "How long should I run the stuck pixel fixer?",
    answer: "Allow the stimulation box to run over the affected area for 10 to 30 minutes. If the pixel remains stuck after 2 hours, software stimulation will likely not resolve it."
  },
  {
    question: "Is rapid pixel cycling safe for my screen?",
    answer: "Yes, software pixel stimulation is safe for display hardware. However, users with photosensitive epilepsy should avoid looking directly at flashing patterns."
  }
];
---

<Layout 
  title="Stuck Pixel Fixer & Healer | Free Online Screen Repair Tool"
  description="Unstick stuck screen pixels online with high-frequency sub-pixel color stimulation. Free browser tool for LCD, IPS, and OLED display panels under ISO 9241-307 Class I specs."
>
  <div class="py-10 px-4 sm:px-6 lg:px-8 space-y-12">
    <section class="max-w-4xl mx-auto text-center space-y-4">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-status-pass/10 border border-status-pass/30 text-xs font-mono text-status-pass font-bold">
        <span>ISO 9241-307 CLASS I STIMULATION ALGORITHM</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold font-mono tracking-tight text-text-primary">
        Stuck Pixel Stimulator &amp; Healer Engine
      </h1>
      <p class="text-sm sm:text-base text-text-muted leading-relaxed max-w-2xl mx-auto">
        Unstick bright Red, Green, or Blue stuck pixels on your display using high-frequency localized sub-pixel stimulation patterns.
      </p>
    </section>

    <EpilepsyWarning />
    <StuckPixel />

    <article class="max-w-4xl mx-auto space-y-8 bg-bg-surface/80 border border-border-hairline rounded-2xl p-6 sm:p-8 backdrop-blur-xl text-sm text-text-secondary leading-relaxed">
      <h2 class="text-xl font-bold font-mono text-text-primary">Understanding Liquid Crystal Sub-Pixel Fixers</h2>
      <p>
        Stuck pixels are caused by liquid crystals getting trapped in a single electronic state. High-frequency sub-pixel RGB cycling relaxes crystal alignment without damaging screen hardware.
      </p>

      <h2 class="text-xl font-bold font-mono text-text-primary">Frequently Asked Questions</h2>
      <div class="space-y-4">
        {faqs.map(faq => (
          <div class="border-b border-border-hairline pb-4 space-y-1">
            <h3 class="font-bold text-text-primary font-mono">{faq.question}</h3>
            <p class="text-xs text-text-muted">{faq.answer}</p>
          </div>
        ))}
      </div>
    </article>
  </div>
</Layout>
