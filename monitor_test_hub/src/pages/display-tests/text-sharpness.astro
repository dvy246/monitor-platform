---
import Layout from '../../layouts/Layout.astro';
import TextSharpness from '../../components/diagnostics/TextSharpness.astro';

const faqs = [
  {
    question: "Why does text look blurry or have red/blue halos on my new monitor?",
    answer: "Color halos occur when your operating system's font smoothing algorithm (e.g. Windows ClearType) is configured for a standard RGB subpixel layout, but your monitor uses a BGR or Triangular QD-OLED subpixel structure."
  },
  {
    question: "How do I fix blurry text on a BGR or QD-OLED monitor?",
    answer: "Run the Windows ClearType Text Tuner ('cttune.exe') and select the sample blocks that look sharpest, or use MacType/BetterClearType utilities to force BGR subpixel alignment."
  },
  {
    question: "Does macOS support subpixel font rendering?",
    answer: "Apple removed subpixel font antialiasing in macOS Mojave, relying entirely on high-DPI Retina resolution scaling. Consequently, non-4K low-PPI monitors can appear blurry on macOS."
  },
  {
    question: "What PPI is recommended for crisp text without scaling?",
    answer: "A pixel density of 110 PPI (27-inch 1440p) provides good native text clarity, while 160+ PPI (27-inch 4K or 24-inch 4K) delivers razor-sharp typography."
  }
];
---

<Layout 
  title="Text Sharpness & ClearType Test | Font Subpixel Inspector"
  description="Test your monitor for text sharpness, font clarity, and subpixel color fringing. Inspect ClearType RGB/BGR text legibility and DPI scaling under ISO 9241-300 standards."
>
  <div class="py-10 px-4 sm:px-6 lg:px-8 space-y-12">
    <section class="max-w-4xl mx-auto text-center space-y-4">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-status-pass/10 border border-status-pass/30 text-xs font-mono text-status-pass font-bold">
        <span>ISO 9241-300 ERGONOMIC TEXT METRICS</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold font-mono tracking-tight text-text-primary">
        Text Sharpness &amp; ClearType Antialiasing Inspector
      </h1>
      <p class="text-sm sm:text-base text-text-muted leading-relaxed max-w-2xl mx-auto">
        Inspect your display for text sharpness, font legibility across 6pt-24pt font sizes, and subpixel color fringing on RGB, BGR, and QD-OLED layouts.
      </p>
    </section>

    <TextSharpness />

    <article class="max-w-4xl mx-auto space-y-8 bg-bg-surface/80 border border-border-hairline rounded-2xl p-6 sm:p-8 backdrop-blur-xl text-sm text-text-secondary leading-relaxed">
      <h2 class="text-xl font-bold font-mono text-text-primary">Understanding Subpixel Font Rendering &amp; Fringing</h2>
      <p>
        ClearType antialiasing uses individual red, green, and blue subpixels to triple horizontal text resolution. When subpixel geometry (BGR or triangular QD-OLED) mismatches operating system assumptions, text develops distracting color halos.
      </p>

      <h2 class="text-xl font-bold font-mono text-text-primary">Frequently Asked Questions</h2>
      <div class="space-y-4">
        {faqs.map(faq => (
          <div class="border-b border-border-hairline pb-4 space-y-1">
            <h3 class="font-bold text-text-primary font-mono">{faq.question}</h3>
            <p class="text-xs text-text-muted">{faq.answer}</p>
          </div>
        ))}
      </div>
    </article>
  </div>
</Layout>
