---
import { HardwarePassportEngine } from '../../engine/HardwarePassportEngine';

const url = new URL(Astro.request.url);
const hash = url.searchParams.get('hash') || 'a4f8b92c103e57f1';
const score = Number(url.searchParams.get('score') || '98');
const fps = url.searchParams.get('fps') || '240';
const res = url.searchParams.get('res') || '3840x2160';
const theme = url.searchParams.get('theme') || 'dark';

const isDark = theme !== 'light';

const passportData = {
  timestamp: new Date().toISOString(),
  resolution: res,
  devicePixelRatio: 2,
  colorDepth: 30,
  vsyncFps: Number(fps),
  touchSupport: true,
  maxTouchPoints: 10,
  subpixelLayout: 'RGB Stripe',
  oledRiskCategory: 'MINIMAL',
  vrrRange: '48Hz - 240Hz',
  hdrSupport: 'HDR10',
  healthScore: score,
  signatureHash: hash
};

const badgeSvg = HardwarePassportEngine.generateBadgeSvg(passportData, { theme: isDark ? 'dark' : 'light' });
---

<!DOCTYPE html>
<html lang="en" class={isDark ? 'dark bg-[#08080a] text-white' : 'bg-white text-gray-900'}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Verified Display Passport Badge #{hash}</title>
  <style>
    body {
      margin: 0;
      padding: 0;
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
      height: 100vh;
      background: transparent;
    }
    .badge-container {
      width: 100%;
      height: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .badge-container svg {
      width: 100%;
      height: auto;
      max-height: 100%;
    }
  </style>
</head>
<body>
  <a href={`/passport/${hash}`} target="_blank" rel="noopener noreferrer" class="badge-container" title="Click to view full cryptographic hardware receipt">
    <Fragment set:html={badgeSvg} />
  </a>
</body>
</html>
