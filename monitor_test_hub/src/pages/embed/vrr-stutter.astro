---
import VrrStutterEngine from '../../components/diagnostics/VrrStutterEngine.astro';
---

<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>VRR Stutter &amp; Tear Test Widget | Monitor Test Hub</title>
  <meta name="robots" content="index, follow" />
  <link rel="stylesheet" href="/src/styles/global.css" />
  <style>
    body {
      margin: 0;
      padding: 0;
      background: #08080a;
      overflow: hidden;
    }
  </style>
</head>
<body class="bg-bg-canvas text-text-primary font-mono select-none">
  <div class="relative w-full h-screen flex flex-col justify-between p-3 border border-border-hairline rounded-xl bg-bg-surface">
    <!-- Embedded Header Bar -->
    <div class="flex items-center justify-between text-[11px] pb-2 border-b border-border-hairline">
      <div class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-status-pass led-glow-pass animate-pulse"></span>
        <span class="font-bold text-text-primary uppercase tracking-wider">LIVE VRR STUTTER WIDGET</span>
      </div>
      <a 
        href="https://monitortester.com/display-tests/vrr" 
        target="_blank" 
        rel="noopener noreferrer"
        class="text-[10px] text-status-pass hover:underline font-bold tracking-wider uppercase flex items-center gap-1"
      >
        <span>POWERED BY MONITOR TEST HUB</span>
        <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
      </a>
    </div>

    <!-- Embedded Diagnostic Canvas -->
    <div class="flex-1 my-2 overflow-hidden rounded-lg border border-border-hairline">
      <VrrStutterEngine />
    </div>

    <!-- Embedded Footer Attribution -->
    <div class="flex items-center justify-between text-[10px] text-text-muted pt-1">
      <span>540Hz+ Adaptive-Sync Engine</span>
      <a 
        href="https://monitortester.com/display-tests/vrr" 
        target="_blank" 
        rel="noopener noreferrer"
        class="text-text-secondary hover:text-text-primary underline"
      >
        Run Full 540Hz Diagnostic &rarr;
      </a>
    </div>
  </div>
</body>
</html>
