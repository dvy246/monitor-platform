---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import { guidesData, type Guide } from '../../utils/guidesData';

export function getStaticPaths() {
  return guidesData.map((guide) => ({
    params: { slug: guide.slug },
    props: { guide },
  }));
}

export interface Props {
  guide: Guide;
}

const { guide } = Astro.props;
const canonicalUrl = `https://monitortester.com/guides/${guide.slug}`;

const articleSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "TechArticle",
      "@id": `${canonicalUrl}#article`,
      "headline": guide.title,
      "description": guide.description,
      "datePublished": guide.date,
      "author": {
        "@type": "Organization",
        "name": guide.author
      },
      "publisher": {
        "@type": "Organization",
        "name": "Monitor Test Hub",
        "logo": {
          "@type": "ImageObject",
          "url": "https://monitortester.com/favicon.svg"
        }
      },
      "about": [
        { "@type": "Thing", "name": "Display Calibration", "sameAs": "https://en.wikipedia.org/wiki/Display_calibration" },
        { "@type": "Thing", "name": "Touchscreen", "sameAs": "https://en.wikipedia.org/wiki/Touchscreen" }
      ],
      "medicalAudience": {
        "@type": "MedicalAudience",
        "audienceType": "None - Non-Medical Hardware Diagnostic Tool"
      }
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${canonicalUrl}#breadcrumb`,
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://monitortester.com" },
        { "@type": "ListItem", "position": 2, "name": "Guides", "item": "https://monitortester.com/guides" },
        { "@type": "ListItem", "position": 3, "name": guide.title, "item": canonicalUrl }
      ]
    }
  ]
};
---

<Layout title={`${guide.title} | Monitor Test Hub`} description={guide.description}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  </Fragment>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-8">
    <Breadcrumbs items={[{ label: 'Guides', href: '/guides' }, { label: guide.title }]} />

    <!-- Article Header -->
    <header class="bg-bg-surface border border-border-hairline rounded-2xl p-8 sm:p-10 shadow-specular-top space-y-4">
      <div class="flex items-center gap-3 text-xs font-mono">
        <span class="px-2.5 py-1 rounded bg-status-pass/10 border border-status-pass/30 text-status-pass font-bold uppercase">
          {guide.category}
        </span>
        <span class="text-text-muted">•</span>
        <span class="text-text-secondary">{guide.readTime}</span>
        <span class="text-text-muted">•</span>
        <span class="text-text-muted">{guide.date}</span>
      </div>

      <h1 class="text-2xl sm:text-3xl lg:text-4xl font-mono font-extrabold text-text-primary tracking-tight leading-tight">
        {guide.title}
      </h1>

      <p class="text-sm sm:text-base text-text-secondary font-sans leading-relaxed">
        {guide.description}
      </p>

      <div class="pt-4 border-t border-border-hairline flex items-center gap-2 text-xs font-mono text-text-muted">
        <span>By {guide.author}</span>
      </div>
    </header>

    <!-- Article Grid: Table of Contents + Content Body -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
      
      <!-- Sticky Sidebar Navigation -->
      <aside class="lg:col-span-4 space-y-6">
        <div class="bg-bg-surface border border-border-hairline rounded-xl p-5 font-mono text-xs space-y-3 sticky top-20 shadow-specular-top">
          <div class="font-bold text-text-primary uppercase tracking-wider text-[11px] pb-2 border-b border-border-hairline">
            Table of Contents
          </div>
          <nav aria-label="Article Table of Contents" class="space-y-2">
            {guide.sections.map((sec) => (
              <a 
                href={`#${sec.id}`} 
                class="block text-text-secondary hover:text-status-pass transition-colors leading-normal hover:translate-x-1 transition-transform"
              >
                # {sec.title}
              </a>
            ))}
          </nav>
        </div>

        <!-- Tool CTA Card -->
        <div class="bg-bg-canvas border border-status-pass/30 rounded-xl p-5 font-mono text-xs space-y-3 shadow-[0_0_15px_rgba(5,150,105,0.15)]">
          <div class="text-status-pass font-bold uppercase tracking-wider text-[10px]">
            ⚡ RECOMMENDED INSTRUMENT
          </div>
          <h3 class="text-sm font-bold text-text-primary">{guide.toolCta.title}</h3>
          <p class="text-[11px] text-text-secondary font-sans leading-relaxed">{guide.toolCta.description}</p>
          <a 
            href={guide.toolCta.url} 
            class="inline-flex items-center justify-center w-full py-2 px-4 rounded bg-status-pass text-text-on-accent font-bold text-xs hover:opacity-90 transition-opacity shadow-specular-top"
          >
            Launch Diagnostic Tool &rarr;
          </a>
        </div>
      </aside>

      <!-- Content Sections -->
      <div class="lg:col-span-8 space-y-8 font-sans text-sm text-text-secondary leading-relaxed">
        {guide.sections.map((sec, idx) => (
          <section id={sec.id} class="bg-bg-surface border border-border-hairline rounded-xl p-6 sm:p-8 space-y-4 shadow-specular-top">
            <h2 class="text-xl font-mono font-bold text-text-primary tracking-tight flex items-center gap-2">
              <span class="text-status-pass font-mono text-xs">0{idx + 1}.</span>
              <span>{sec.title}</span>
            </h2>
            <div class="prose prose-invert max-w-none text-text-secondary leading-relaxed whitespace-pre-line text-sm sm:text-base">
              {sec.content}
            </div>
          </section>
        ))}

        <!-- Related Tool Footer Banner -->
        <div class="bg-bg-surface border border-border-hairline rounded-xl p-6 flex flex-col sm:flex-row items-center justify-between gap-4 font-mono">
          <div>
            <div class="text-xs font-bold text-text-primary">Ready to test your display?</div>
            <div class="text-[11px] text-text-muted font-sans">Run instant client-side diagnostics in your browser.</div>
          </div>
          <a 
            href={guide.toolCta.url} 
            class="px-5 py-2.5 rounded bg-text-primary text-bg-canvas font-bold text-xs hover:opacity-90 transition-opacity shrink-0"
          >
            Launch Tool
          </a>
        </div>
      </div>

    </div>
  </div>
</Layout>
