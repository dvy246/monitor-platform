---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import FAQSection from '../../components/ui/FAQSection.astro';
import { useTranslations, localizeLink } from '../../utils/i18n';


const { lang } = useTranslations(Astro.url.pathname);

const breadcrumbs = [
  { label: 'Device Guides', href: localizeLink('/guides', lang) },
  { label: 'Smart TV & Home Theater Guide' }
];

const faqs = [
  { question: "How do I test my Smart TV for Mini-LED local dimming halo blooming?", answer: "Open our Blooming & Local Dimming Inspector on your Smart TV browser. Select moving starfield or high-contrast square targets and observe halo light bleed around objects against pure black backgrounds." },
  { question: "What is the optimal THX and SMPTE viewing distance for 55, 65, and 75-inch 4K TVs?", answer: "SMPTE recommends a 30° Field of View for general viewing (65-inch TV = 8.9 ft / 2.7 m), while THX recommends a 40° FOV for cinematic immersion (65-inch TV = 6.5 ft / 2.0 m)." },
  { question: "How do I test motion smoothing (MEMC) and 24fps judder on my TV?", answer: "Run our Refresh Rate Reticle Sweep pattern at 24Hz, 60Hz, and 120Hz. If panning motion stutters unevenly, disable 3:2 pulldown or adjust your TV's Motionflow/TruMotion interpolation strength." },
  { question: "What is the difference between OLED, QD-OLED, and Mini-LED QLED TVs?", answer: "OLED features self-emitting pixels with infinite contrast. QD-OLED adds Quantum Dot color purity for wider color volume. Mini-LED QLED uses thousands of micro-LED backlights for extreme 2000+ nit brightness." },
  { question: "How do I test HDR10+, Dolby Vision, and VESA DisplayHDR compliance?", answer: "Use our HDR ST 2084 PQ EOTF tool to test 1%, 10%, and 100% window brightness steps and evaluate ABL (Auto Brightness Limiter) roll-off." },
  { question: "Why do dark movie scenes look washed out on my IPS or VA LCD TV?", answer: "IPS panels have lower native contrast (~1200:1) causing grayish blacks. VA panels offer higher contrast (~5000:1) but suffer from off-axis viewing angle color washing." },
  { question: "How do I calibrate my TV to sRGB / Rec.709 Gamma 2.2?", answer: "Use our Monitor Color Calibration tool in a dim room. Adjust your TV's Brightness and Contrast controls until 2.2 gamma grayscale steps melt smoothly into the background." },
  { question: "Can I test my Smart TV's HDMI 2.1 4K 120Hz gaming latency?", answer: "Yes. Connect a PC or gaming console, enable Game Mode, and run our Click-to-Photon Input Lag Reflex tool to measure total display input lag." },
  { question: "How do I check if my TV has Dirty Screen Effect (DSE) or grid vignetting?", answer: "Display a 50% solid white or gray canvas across the entire TV screen and pan slowly. Dark vertical streaks or corner vignetting indicate DSE backlight non-uniformity." },
  { question: "Should I keep my TV's Ambient Light Sensor enabled during calibration?", answer: "No. Disable Ambient Light Sensors (Eco Mode) during screen testing and color calibration to maintain static, predictable luminance levels." }
];



---

<Layout
  title="Smart TV & Home Theater Guide: Mini-LED Blooming & Viewing Distance"
  description="Comprehensive Smart TV & Home Theater testing guide. Mini-LED local dimming halo blooming, THX/SMPTE 4K viewing distance optics, 24fps motion judder, and HDR PQ tone mapping."
  faqs={faqs}
>
  <main id="main-content" class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-12 font-sans">
    <Breadcrumbs items={breadcrumbs} />

    <!-- Guide Header -->
    <header class="space-y-4 text-center max-w-3xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-500/10 border border-amber-500/30 text-xs font-mono text-amber-400 font-bold uppercase tracking-wider">
        <svg class="w-4 h-4 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
        <span>SMART TV &amp; HOME THEATER GUIDE</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-text-primary tracking-tight font-mono">
        Smart TV &amp; Home Theater Guide: Mini-LED Blooming &amp; Viewing Optics
      </h1>
      <p class="text-sm sm:text-base text-text-secondary leading-relaxed">
        Optimize your living room TV. Test Mini-LED FALD local dimming haloing, calculate THX 4K viewing distances, eliminate 24fps movie judder, and evaluate HDR tone mapping.
      </p>
    </header>

    <!-- Custom Inline SVG Visual Diagram -->
    <section class="p-6 rounded-2xl bg-bg-surface border border-border-hairline space-y-4 shadow-xl">
      <h2 class="text-lg font-bold font-mono text-text-primary flex items-center gap-2">
        <svg class="w-5 h-5 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
        <span>TV Viewing Distance &amp; THX/SMPTE FOV Cone Optics</span>
      </h2>

      <div class="w-full flex justify-center py-4 bg-bg-canvas rounded-xl border border-border-hairline">
        <svg class="w-full max-w-2xl h-auto" viewBox="0 0 700 300" fill="none" xmlns="http://www.w3.org/2000/svg">
          <!-- TV Screen -->
          <rect x="50" y="70" width="20" height="160" rx="3" fill="#121215" stroke="#f59e0b" stroke-width="3"/>
          <text x="35" y="60" fill="#f59e0b" font-family="monospace" font-size="11" font-weight="bold">65" 4K TV</text>
          <!-- Viewing FOV Cones -->
          <!-- THX 40-deg FOV Cone -->
          <path d="M 70 150 L 450 30 L 450 270 Z" fill="#f59e0b" fill-opacity="0.15" stroke="#f59e0b" stroke-dasharray="3 3"/>
          <text x="260" y="115" fill="#f59e0b" font-family="monospace" font-size="11" font-weight="bold">THX 40° FOV (6.5 ft / 2.0 m)</text>
          <!-- SMPTE 30-deg FOV Cone -->
          <path d="M 70 150 L 620 60 L 620 240 Z" fill="#059669" fill-opacity="0.1" stroke="#059669" stroke-dasharray="2 2"/>
          <text x="380" y="175" fill="#059669" font-family="monospace" font-size="11" font-weight="bold">SMPTE 30° FOV (8.9 ft / 2.7 m)</text>
          <!-- Viewer Icon THX -->
          <circle cx="450" cy="150" r="12" fill="#f59e0b"/>
          <text x="442" y="154" fill="#ffffff" font-family="monospace" font-size="10" font-weight="bold">THX</text>
          <!-- Viewer Icon SMPTE -->
          <circle cx="620" cy="150" r="12" fill="#059669"/>
          <text x="610" y="154" fill="#ffffff" font-family="monospace" font-size="10" font-weight="bold">SMPTE</text>
        </svg>
      </div>
    </section>

    <!-- 8-Step TV Inspection Workflow -->
    <section class="space-y-6">
      <h2 class="text-2xl font-bold font-mono text-text-primary border-b border-border-hairline pb-3">
        8-Step Smart TV Inspection Workflow
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 font-sans text-sm">
        <div class="p-4 rounded-xl bg-bg-surface border border-border-hairline space-y-2">
          <span class="text-xs font-mono font-bold text-amber-400 px-2 py-0.5 rounded bg-amber-500/10 border border-amber-500/30">STEP 1</span>
          <h3 class="font-bold text-text-primary">Mini-LED Blooming &amp; Halo Audit</h3>
          <p class="text-text-muted text-xs leading-relaxed">Launch our <a href={localizeLink("/display-tests/blooming-test", lang)} class="text-amber-400 hover:underline">Blooming Test Inspector</a> to evaluate local dimming halo light bleed with high-contrast moving targets.</p>
        </div>

        <div class="p-4 rounded-xl bg-bg-surface border border-border-hairline space-y-2">
          <span class="text-xs font-mono font-bold text-amber-400 px-2 py-0.5 rounded bg-amber-500/10 border border-amber-500/30">STEP 2</span>
          <h3 class="font-bold text-text-primary">TV &amp; Projector Viewing Distance Optics</h3>
          <p class="text-text-muted text-xs leading-relaxed">Use our <a href={localizeLink("/display-tests/tv-viewing-distance", lang)} class="text-amber-400 hover:underline">TV Viewing Distance Calculator</a> to benchmark 1-arcminute visual acuity thresholds for 4K resolutions.</p>
        </div>

        <div class="p-4 rounded-xl bg-bg-surface border border-border-hairline space-y-2">
          <span class="text-xs font-mono font-bold text-amber-400 px-2 py-0.5 rounded bg-amber-500/10 border border-amber-500/30">STEP 3</span>
          <h3 class="font-bold text-text-primary">24fps Movie Motion Judder Test</h3>
          <p class="text-text-muted text-xs leading-relaxed">Run the <a href={localizeLink("/refresh-rate-test", lang)} class="text-amber-400 hover:underline">Refresh Rate Reticle Sweep</a> at 24Hz to check 3:2 pulldown judder and MEMC motion smoothing.</p>
        </div>

        <div class="p-4 rounded-xl bg-bg-surface border border-border-hairline space-y-2">
          <span class="text-xs font-mono font-bold text-amber-400 px-2 py-0.5 rounded bg-amber-500/10 border border-amber-500/30">STEP 4</span>
          <h3 class="font-bold text-text-primary">HDR ST 2084 PQ Tone Mapping</h3>
          <p class="text-text-muted text-xs leading-relaxed">Open the <a href={localizeLink("/display-tests/hdr-test", lang)} class="text-amber-400 hover:underline">HDR ST 2084 PQ Evaluator</a> to test 1000-nit peak highlights and ABL roll-off across 1% to 100% windows.</p>
        </div>

        <div class="p-4 rounded-xl bg-bg-surface border border-border-hairline space-y-2">
          <span class="text-xs font-mono font-bold text-amber-400 px-2 py-0.5 rounded bg-amber-500/10 border border-amber-500/30">STEP 5</span>
          <h3 class="font-bold text-text-primary">Dirty Screen Effect (DSE) &amp; Uniformity</h3>
          <p class="text-text-muted text-xs leading-relaxed">Display 50% gray patterns via our <a href={localizeLink("/display-tests/uniformity", lang)} class="text-amber-400 hover:underline">OLED Uniformity Inspector</a> to detect backlight grid banding.</p>
        </div>

        <div class="p-4 rounded-xl bg-bg-surface border border-border-hairline space-y-2">
          <span class="text-xs font-mono font-bold text-amber-400 px-2 py-0.5 rounded bg-amber-500/10 border border-amber-500/30">STEP 6</span>
          <h3 class="font-bold text-text-primary">White Screen &amp; Ambient Lighting</h3>
          <p class="text-text-muted text-xs leading-relaxed">Adjust ambient room lighting and use <a href={localizeLink("/white-screen", lang)} class="text-amber-400 hover:underline">White Screen Utility</a> to inspect anti-reflective screen coatings.</p>
        </div>

        <div class="p-4 rounded-xl bg-bg-surface border border-border-hairline space-y-2">
          <span class="text-xs font-mono font-bold text-amber-400 px-2 py-0.5 rounded bg-amber-500/10 border border-amber-500/30">STEP 7</span>
          <h3 class="font-bold text-text-primary">Color Calibration &amp; Gamma 2.2</h3>
          <p class="text-text-muted text-xs leading-relaxed">Use <a href={localizeLink("/monitor-color-calibration", lang)} class="text-amber-400 hover:underline">Monitor Color Calibration</a> to adjust brightness, contrast, and gray balance neutrality.</p>
        </div>

        <div class="p-4 rounded-xl bg-bg-surface border border-border-hairline space-y-2">
          <span class="text-xs font-mono font-bold text-amber-400 px-2 py-0.5 rounded bg-amber-500/10 border border-amber-500/30">STEP 8</span>
          <h3 class="font-bold text-text-primary">Console HDMI 2.1 Input Lag Test</h3>
          <p class="text-text-muted text-xs leading-relaxed">Connect your PS5, Xbox Series X, or PC and use <a href={localizeLink("/arcade/lag-reflex-sniper", lang)} class="text-amber-400 hover:underline">Lag Reflex Sniper</a> to test Game Mode response times.</p>
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <FAQSection faqs={faqs} title="Smart TV & Home Theater FAQs" />
  </main>
</Layout>
