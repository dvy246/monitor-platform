---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import HdrTestInspector from '../../components/diagnostics/HdrTestInspector.astro';
import HardwareLimitationNotice from '../../components/disclaimers/HardwareLimitationNotice.astro';
import StepWorkflowSection from '../../components/ui/StepWorkflowSection.astro';
import PanelTypeBreakdownSection from '../../components/ui/PanelTypeBreakdownSection.astro';
import FAQSection from '../../components/ui/FAQSection.astro';
import MasterBentoDiagnosticSuite from '../../components/diagnostics/MasterBentoDiagnosticSuite.astro';
import EpilepsyWarning from '../../components/disclaimers/EpilepsyWarning.astro';
import HdrClippingTester from '../../components/diagnostics/HdrClippingTester.astro';
import {
  getAllPeakNits,
  getAllToneMappings,
  PEAK_NITS_CONFIG,
  TONE_MAPPING_CONFIG
} from '../../engine/HdrTestEngine';

const peakNitsList = getAllPeakNits();
const toneMappingsList = getAllToneMappings();

const pageTitle = "HDR Peak Brightness & Tone Mapping Clipping Test";
const metaDescription = "Client-side DisplayHDR peak brightness and tone mapping clipping diagnostic with 10-bit ST 2084 PQ step gradients, ABL window curves (1%–100%), and HGiG/static/dynamic knee clipping thresholds.";

const canonicalUrl = `${Astro.url.origin}/hdr-test`;

// Schema.org Structured Data
const schemaGraph = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "@id": `${canonicalUrl}#webapp`,
      "name": pageTitle,
      "url": canonicalUrl,
      "applicationCategory": "DeveloperApplication",
      "operatingSystem": "All (Windows 11 HDR, macOS HDR, Linux Wayland HDR, ChromeOS)",
      "browserRequirements": "Requires HTML5 WebGL 2.0 / Canvas 2D with HDR10/PQ (Perceptual Quantizer) or wide-gamut support",
      "featureList": [
        "10-bit ST 2084 PQ EOTF step gradient generator",
        "HGiG, static, and dynamic tone mapping clipping threshold evaluation",
        "Auto Brightness Limiter (ABL) window size test patterns (1%, 5%, 10%, 25%, 100% APL)",
        "Zebra clipping overlay and 10-bit PQ code inspector"
      ],
      "about": [
        { "@type": "Thing", "name": "High-dynamic-range video", "sameAs": "https://en.wikipedia.org/wiki/High-dynamic-range_video" },
        { "@type": "Thing", "name": "Tone mapping", "sameAs": "https://en.wikipedia.org/wiki/Tone_mapping" },
        { "@type": "Thing", "name": "Perceptual quantizer", "sameAs": "https://en.wikipedia.org/wiki/Perceptual_quantizer" }
      ]
    },
    {
      "@type": "TechArticle",
      "@id": `${canonicalUrl}#article`,
      "headline": pageTitle,
      "description": metaDescription,
      "inLanguage": "en",
      "mainEntityOfPage": canonicalUrl,
      "dependencies": "HTML5 Canvas 2D / WebGL 2.0, HDR Color Space (rec2020 / display-p3)",
      "about": [
        { "@type": "Thing", "name": "DisplayHDR", "sameAs": "https://en.wikipedia.org/wiki/DisplayHDR" },
        { "@type": "Thing", "name": "HDR Gaming Interest Group", "sameAs": "https://en.wikipedia.org/wiki/HDR_Gaming_Interest_Group" }
      ],
      "medicalAudience": {
        "@type": "MedicalAudience",
        "audienceType": "None - Non-Medical Hardware Diagnostic Tool"
      }
    }
  ]
};

const faqs = [
  {
    question: "What is 10-bit SMPTE ST 2084 PQ EOTF tone mapping?",
    answer: "ST 2084 Perceptual Quantizer (PQ) is the absolute luminance EOTF curve used in HDR10, mapping 10-bit digital code values (0 to 1023) directly to target luminance levels up to 10,000 nits."
  },
  {
    question: "What is HGiG (HDR Gaming Interest Group) tone mapping?",
    answer: "HGiG disables monitor internal tone mapping roll-off, handing over tone mapping responsibility entirely to the console or PC game engine to prevent double tone mapping and clipped highlights."
  },
  {
    question: "What is Auto Brightness Limiter (ABL) in OLED and Mini-LED monitors?",
    answer: "ABL protects power supplies and OLED panels from overheating by dimming total screen brightness when large high-luminance windows (e.g. 100% white screen) are displayed."
  },
  {
    question: "How do 1%, 5%, and 10% HDR peak brightness window sizes differ?",
    answer: "OLED displays achieve maximum peak nits (e.g. 1000 nits) on small 1% to 10% APL highlights, but drop to ~200-250 nits on 100% full-field white screens due to ABL throttling."
  },
  {
    question: "What is VESA DisplayHDR True Black 400 vs DisplayHDR 1000?",
    answer: "DisplayHDR True Black (400/500/600) applies to OLED displays with 0.0005 nit black levels; DisplayHDR 1000/1400 applies to high-brightness LCD/Mini-LED panels."
  },
  {
    question: "Why does highlight clipping occur in HDR games?",
    answer: "Highlight clipping occurs when game output brightness exceeds the monitor's physical peak nits and the display clips highlights hard instead of applying a soft roll-off curve."
  },
  {
    question: "Does Windows 11 HDR Auto HDR add input lag?",
    answer: "Windows 11 Auto HDR converts SDR games to HDR via GPU shaders with negligible overhead (<0.5ms delay)."
  },
  {
    question: "How do static tone mapping curves differ from dynamic roll-off curves?",
    answer: "Static curves clip highlights strictly at the monitor's hard nit limit; dynamic curves soft-roll highlight details down to preserve cloud specular textures."
  },
  {
    question: "What is zebra pattern highlight clipping overlay?",
    answer: "Zebra overlays highlight areas on test patterns that exceed maximum nit thresholds, instantly indicating where peak luminance clipping begins."
  },
  {
    question: "How do I export my HDR display peak luminance report?",
    answer: "Click 'Export Passport' to save your verified peak nits, ABL window measurements, and tone mapping curve telemetry in a JSON report."
  }
];
---

<Layout title={pageTitle} description={metaDescription} faqs={faqs}>
  <script type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8 font-sans">
    <Breadcrumbs items={[
      { label: 'Display Suite', href: '/display-tests' },
      { label: 'HDR Diagnostics' }
    ]} />

    <header class="space-y-3 border-b border-border-hairline pb-6">
      <div class="flex items-center gap-2 text-status-pass text-xs font-mono font-bold uppercase tracking-wider">
        <span class="w-2.5 h-2.5 rounded-full bg-status-pass led-glow-pass"></span>
        VESA DISPLAYHDR 1.2 &amp; ST 2084 PQ SUITE
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-text-primary tracking-tight font-mono">
        HDR Peak Brightness &amp; Tone Mapping Test Hub
      </h1>
      <p class="text-sm text-text-secondary max-w-3xl leading-relaxed">
        Comprehensive hardware diagnostic suite for evaluating display peak luminance clipping, 10-bit SMPTE ST 2084 PQ EOTF tone curves, and Auto Brightness Limiter (ABL) thermal throttling across OLED, Mini-LED, and high-refresh gaming monitors.
      </p>
    </header>

    <!-- Interactive Primary Diagnostic Component -->
    <HdrClippingTester initialPeakNits={1000} initialToneMapping="hgig" initialWindowSize="gradient" />

    <!-- pSEO Dynamic Navigation Matrix Grid (24 Presets) -->
    <section class="bg-[#121215]/90 border border-white/10 rounded-3xl p-6 space-y-6 font-mono shadow-2xl backdrop-blur-xl">
      <div class="border-b border-white/10 pb-3 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
        <div>
          <h2 class="text-base font-bold text-text-primary uppercase tracking-wider">
            HDR Preset Diagnostics Matrix (24 Technical Configurations)
          </h2>
          <p class="text-xs text-text-secondary font-sans mt-0.5">
            Select a target peak luminance tier and tone mapping mode to run a dedicated diagnostic profile.
          </p>
        </div>
        <span class="text-xs text-status-pass font-bold bg-status-pass/10 px-2.5 py-1 rounded border border-status-pass/30 shrink-0">
          6 PEAK TIERS &times; 4 CURVE MODES
        </span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {peakNitsList.map((nitsKey) => {
          const nitsCfg = PEAK_NITS_CONFIG[nitsKey];
          return (
            <div class="bg-bg-canvas border border-white/10 rounded-2xl p-4 space-y-3">
              <div class="flex justify-between items-center border-b border-white/10 pb-2">
                <span class="text-sm font-bold text-text-primary">{nitsCfg.label}</span>
                <span class="text-[10px] text-status-pass font-semibold bg-bg-surface px-2 py-0.5 rounded border border-border-hairline">
                  {nitsCfg.displayHdrTier}
                </span>
              </div>
              <p class="text-[11px] text-text-secondary font-sans">
                Target: {nitsCfg.typicalPanel}. Rec ABL Window: {nitsCfg.recommendedAblWindow}.
              </p>
              <div class="grid grid-cols-2 gap-1.5 pt-1">
                {toneMappingsList.map((modeKey) => {
                  const modeCfg = TONE_MAPPING_CONFIG[modeKey];
                  return (
                    <a
                      href={`/hdr-test/${nitsKey}/${modeKey}`}
                      class="text-[11px] font-semibold py-1.5 px-2 rounded-xl bg-bg-surface border border-white/10 text-text-secondary hover:text-text-primary hover:border-status-pass hover:bg-status-pass/10 transition-colors text-center truncate focus:outline-none focus:ring-2 focus:ring-status-pass font-mono"
                    >
                      {modeCfg.shortName}
                    </a>
                  );
                })}
              </div>
            </div>
          );
        })}
      </div>
    </section>

    <StepWorkflowSection />
    <PanelTypeBreakdownSection />

    <!-- Disclaimers -->
    <div class="space-y-4 max-w-4xl mx-auto">
      <EpilepsyWarning />
      <HardwareLimitationNotice />
    </div>

    <FAQSection faqs={faqs} title="HDR Peak Brightness & Tone Mapping FAQs" />
  </div>
</Layout>
