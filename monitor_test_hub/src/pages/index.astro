<!-- Client Telemetry & Hotkey Acquisition Engine -->
<script>
  import { VsyncSyncEngine } from '../engine/VsyncSyncEngine';

  function startTelemetry() {
    const resEl = document.getElementById('tel-res');
    const dprEl = document.getElementById('tel-dpr');
    const fpsEl = document.getElementById('tel-fps');
    const ctaLabel = document.getElementById('cta-label');

    if (resEl) {
      resEl.textContent = `${window.screen.width * window.devicePixelRatio} x ${window.screen.height * window.devicePixelRatio}`;
    }
    if (dprEl) {
      dprEl.textContent = `${window.devicePixelRatio.toFixed(2)}x`;
    }

    let lastUpdate = 0;
    const engine = new VsyncSyncEngine((stats) => {
      const now = performance.now();
      if (now - lastUpdate >= 250) { // 4Hz DOM update throttle
        if (fpsEl) {
          fpsEl.textContent = `${stats.currentFps.toFixed(1)} Hz`;
        }
        if (ctaLabel) {
          ctaLabel.textContent = `RUN DIAGNOSTIC RUN (${stats.currentFps.toFixed(0)}Hz DETECTED)`;
        }
        lastUpdate = now;
      }
    });

    engine.start();

    // Device route optimization
    const smartCta = document.getElementById('smart-hero-cta') as HTMLAnchorElement;
    if (smartCta && ('ontouchstart' in window || navigator.maxTouchPoints > 0) && window.innerWidth < 768) {
      smartCta.href = '/touch-tests';
      if (ctaLabel) ctaLabel.textContent = 'RUN DIGITIZER CALIBRATION';
    }

    // Global Keycap Hotkeys [1-6] for Symptom Cards
    document.addEventListener('keydown', (e: KeyboardEvent) => {
      if (['INPUT', 'TEXTAREA', 'SELECT'].includes((e.target as HTMLElement)?.tagName)) return;
      const keyMap: Record<string, string> = {
        '1': 'symptom-card-1',
        '2': 'symptom-card-2',
        '3': 'symptom-card-3',
        '4': 'symptom-card-4',
        '5': 'symptom-card-5',
        '6': 'symptom-card-6'
      };
      if (keyMap[e.key]) {
        const card = document.getElementById(keyMap[e.key]) as HTMLAnchorElement;
        if (card) card.click();
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', startTelemetry);
  } else {
    startTelemetry();
  }
</script>
