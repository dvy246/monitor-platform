---
import Layout from '../layouts/Layout.astro';
import HeroDiagnosticScope from '../components/diagnostics/HeroDiagnosticScope.astro';
import { useTranslations, localizeLink } from '../utils/i18n';

const { t, lang } = useTranslations(Astro.url.pathname);

const homepageFaqs = [
  {
    q: 'What is a display test?',
    a: 'A display test is a web-native diagnostic check designed to evaluate panel condition, color accuracy, backlight uniformity, pixel integrity, and refresh rate performance (Hz) across computer monitors, laptops, smartphones, and Smart TVs.'
  },
  {
    q: 'How do I run a dead pixel test?',
    a: 'To test for dead pixels, launch our free online Dead Pixel Test. It cycles your display through full-screen solid primary colors (Red, Green, Blue, White, Black). Inspect your panel closely: dead pixels remain dark black dots, while stuck sub-pixels display a fixed color regardless of background.'
  },
  {
    q: 'How do I test my screen refresh rate (Hz)?',
    a: 'Our Refresh Rate Test uses W3C performance.now() microsecond hardware timestamps to measure your display rate (Hz) and inter-frame pacing jitter in real time. It detects 60Hz, 144Hz, 240Hz, and 540Hz+ gaming monitors as well as Apple ProMotion and Android LTPO dynamic scaling.'
  },
  {
    q: 'How do I test a touchscreen digitizer for dead zones?',
    a: 'Open our Touch Screen Test suite on your smartphone, tablet, or touch laptop. Drag across the touch matrix grid to illuminate active contact points, verify 10-finger multi-touch limits, map dead-zones, and evaluate digitizer line noise.'
  },
  {
    q: 'How do I test my microphone and webcam online?',
    a: 'Use our online Microphone Test and Webcam Test suites to verify decibel levels (dBFS), instant 3-second audio loopback playback, camera sensor resolution (1080p/4K), real-time FPS frame rates, and virtual fill lighting.'
  },
  {
    q: 'How do I test keyboard switch chatter and mouse polling rate?',
    a: 'Our Keyboard Tester benchmarks N-Key Rollover (NKRO) and microsecond switch chatter bounce timing, while our Mouse Test profiler measures 8000Hz USB polling rates, click latency, and double-click chatter.'
  },
  {
    q: 'What causes OLED burn-in?',
    a: 'OLED burn-in is static image retention caused by unequal degradation of organic light-emitting sub-pixels when static UI elements (like taskbars or HUDs) remain on screen at high brightness. Our OLED test uses 5% and 10% dark-gray patterns to detect sub-pixel wear.'
  },
  {
    q: 'Is Display Test Online 100% free and private?',
    a: 'Yes. Display Test Online is 100% free with zero paywalls, zero ads, and zero software downloads required. All video decoding, audio DSP, and rendering execute strictly client-side inside your browser.'
  }
];

const homepageFaqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": homepageFaqs.map(({ q, a }) => ({
    "@type": "Question",
    "name": q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": a
    }
  }))
};
---

<Layout 
  title="Online Monitor & Touch Screen Test Suite | Display Test Online" 
  description="Test your monitor for dead pixels, color accuracy, Hz refresh rate, OLED burn-in, and touch response. Run free browser diagnostics now—no downloads needed."
>
  <!-- Hero Experience: Hardware Calibration Control Deck -->
  <section aria-labelledby="hero-title" class="relative border-b border-border-hairline bg-bg-canvas overflow-hidden py-12 md:py-20">
    <!-- Precision Background Grid Layer with Masking (Confined to Background) -->
    <div class="absolute inset-0 bg-precision-grid bg-grid-mask pointer-events-none z-0"></div>
    <div class="pointer-events-none absolute -top-40 left-1/2 -translate-x-1/2 w-[800px] h-[400px] bg-radial from-white/[0.025] to-transparent blur-3xl z-0"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center min-w-0">
        
        <!-- Left Column: Headline & Tactical Action Deck -->
        <div class="lg:col-span-7 flex flex-col gap-6 min-w-0">
          <div class="font-mono text-[11px] uppercase tracking-widest text-text-secondary flex items-center gap-2.5 flex-wrap">
            <span class="px-2.5 py-1 rounded-md bg-bg-surface border border-border-subtle text-status-pass font-bold shadow-specular-top flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-status-pass led-glow-pass animate-pulse"></span>
              Instantly Test Your Display. Find Problems Before They Find You.
            </span>
          </div>

          <h1 id="hero-title" class="text-3xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight leading-[1.1] text-[#ededed] dark:text-[#ededed] heading-brand">
            Free Online Display Test &amp; Hardware Diagnostics
          </h1>

          <p class="text-base sm:text-lg text-[#a1a1aa] dark:text-[#a1a1aa] leading-relaxed font-sans max-w-xl">
            Run a free display test online to check your screen for dead pixels, color accuracy, and refresh rate—plus instant diagnostics for touch, audio, and input devices.
          </p>

          <div class="flex flex-wrap gap-3 items-center pt-2">
            <a id="smart-hero-cta" href={localizeLink("/display-tests", lang)} aria-label="Run Free Display Diagnostics" class="inline-flex items-center gap-2 px-6 py-3 rounded-lg bg-text-primary text-bg-canvas font-bold text-xs md:text-sm shadow-specular-top hover:opacity-90 active:scale-[0.98] transition-all duration-150 ease-[cubic-bezier(0.16,1,0.3,1)] cursor-pointer font-mono">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/></svg>
              <span id="cta-label" class="tabular-nums">START MONITOR TEST</span>
              <kbd class="hidden sm:inline-flex items-center px-1.5 py-0.5 ml-1 text-[10px] font-mono font-medium rounded bg-bg-canvas/20 border border-bg-canvas/30 text-bg-canvas">↵</kbd>
            </a>

            <a href={localizeLink("/touch-tests", lang)} class="inline-flex items-center gap-2 px-6 py-3 rounded-lg bg-bg-surface text-text-primary border border-border-hairline shadow-specular-top hover:border-border-interactive active:scale-[0.98] transition-all duration-150 ease-[cubic-bezier(0.16,1,0.3,1)] cursor-pointer text-xs md:text-sm font-mono group">
              <span>TOUCH SCREEN TEST</span>
              <span class="text-text-muted group-hover:translate-x-0.5 transition-transform duration-150">&rarr;</span>
            </a>
          </div>
        </div>

        <!-- Right Column: Real-Time Scope Canvas -->
        <div class="lg:col-span-5 relative">
          <div class="rounded-xl border border-border-hairline bg-bg-surface p-2 shadow-specular-top">
            <HeroDiagnosticScope />
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Live Telemetry Inspector & System Specs Table -->
  <section aria-labelledby="telemetry-title" class="py-12 border-b border-border-hairline bg-bg-surface">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="border border-border-hairline rounded-xl bg-bg-canvas overflow-hidden font-mono text-xs shadow-specular-top">
        <div class="px-4 py-3 bg-bg-elevated border-b border-border-hairline flex items-center justify-between">
          <div class="flex items-center gap-2 text-text-primary font-bold tracking-wider text-[11px] uppercase">
            <span class="w-2 h-2 rounded-full bg-status-pass led-glow-pass animate-pulse"></span>
            <span id="telemetry-title">TELEMETRY INSPECTOR (REAL-TIME)</span>
          </div>
          <span class="text-[10px] text-text-muted">HARDWARE POLLING @ 1000HZ</span>
        </div>

        <table class="w-full text-left border-collapse table-fixed" aria-label="Real-Time System Hardware Telemetry">
          <caption class="sr-only">Display and GPU hardware telemetry readouts</caption>
          <thead>
            <tr class="border-b border-border-hairline text-[10px] text-text-muted uppercase tracking-wider bg-bg-surface">
              <th scope="col" class="w-2/5 sm:w-1/3 px-4 py-2.5 font-medium">Metric</th>
              <th scope="col" class="w-2/5 sm:w-1/3 px-4 py-2.5 font-medium">Acquired Value</th>
              <th scope="col" class="hidden sm:table-cell sm:w-1/4 px-4 py-2.5 font-medium">Standard Target</th>
              <th scope="col" class="w-1/5 sm:w-1/12 px-4 py-2.5 font-medium text-right">Status</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-border-hairline font-mono-tech text-xs">
            <tr class="hover:bg-bg-subtle transition-colors duration-150">
              <td class="px-4 py-3 text-text-secondary">{t.resLabel}</td>
              <td class="px-4 py-3 font-bold text-text-primary min-w-[120px] tabular-nums" id="tel-res">{t.detecting}</td>
              <td class="px-4 py-3 text-text-muted hidden sm:table-cell">ISO 9241-307</td>
              <td class="px-4 py-3 text-right"><span class="px-2 py-0.5 rounded-sm text-[9px] font-mono font-bold bg-status-pass/10 text-status-pass border border-status-pass/20">OK</span></td>
            </tr>
            <tr class="hover:bg-bg-subtle transition-colors duration-150">
              <td class="px-4 py-3 text-text-secondary">{t.dprLabel}</td>
              <td class="px-4 py-3 font-bold text-text-primary min-w-[80px] tabular-nums" id="tel-dpr">{t.detecting}</td>
              <td class="px-4 py-3 text-text-muted hidden sm:table-cell">HiDPI Retina</td>
              <td class="px-4 py-3 text-right"><span class="px-2 py-0.5 rounded-sm text-[9px] font-mono font-bold bg-status-info/10 text-status-info border border-status-info/20">SCALED</span></td>
            </tr>
            <tr class="hover:bg-bg-subtle transition-colors duration-150">
              <td class="px-4 py-3 text-text-secondary">{t.vsyncLabel}</td>
              <td class="px-4 py-3 font-bold text-status-pass min-w-[100px] tabular-nums" id="tel-fps">{t.measuring}</td>
              <td class="px-4 py-3 text-text-muted hidden sm:table-cell">IEC 62341 Sync</td>
              <td class="px-4 py-3 text-right"><span class="px-2 py-0.5 rounded-sm text-[9px] font-mono font-bold bg-status-pass/10 text-status-pass border border-status-pass/20">ACTIVE</span></td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Comprehensive 900+ Word Content Suite BELOW the Tool -->
  <div class="py-16 border-b border-border-hairline bg-bg-canvas space-y-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16 font-sans text-text-secondary">
      
      <!-- 1. What is Display Test Online? (~150 words) -->
      <section class="space-y-4">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-text-primary font-mono">
          What is Display Test Online?
        </h2>
        <p class="leading-relaxed text-sm sm:text-base">
          <strong>Display Test Online</strong> is a high-precision, web-native diagnostic suite designed to test, calibrate, and benchmark displays, touchscreens, and peripherals across all digital devices. Built for gamers, hardware reviewers, creative professionals, IT specialists, and everyday consumers, Display Test Online eliminates the need for bulky software installations or paid diagnostic tools.
        </p>
        <p class="leading-relaxed text-sm sm:text-base">
          Our platform operates 100% inside your web browser using HTML5 Canvas, WebGL 2.0 shaders, and modern browser APIs. All calculations execute locally on your device, ensuring complete privacy with zero tracking, zero advertising, and zero data uploads to external servers. Whether you are verifying a brand-new monitor return window, auditing a mobile touchscreen after a screen repair, or calibrating color accuracy for photo editing, Display Test Online delivers instant, laboratory-grade diagnostic metrics in seconds.
        </p>
      </section>

      <!-- 2. Everything You Can Test (Cards with Internal Links) -->
      <section class="space-y-6">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-text-primary font-mono">
          Everything You Can Test
        </h2>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
          <!-- Card 1: Dead Pixel Test -->
          <a href="/display-tests/dead-pixel" class="bg-bg-surface p-5 rounded-xl border border-border-hairline hover:border-status-pass transition-all group flex flex-col justify-between space-y-3 shadow-specular-top">
            <div class="space-y-2">
              <div class="text-status-pass text-xs font-mono font-bold uppercase tracking-wider">ISO 9241-307</div>
              <h3 class="text-base font-bold text-text-primary group-hover:text-status-pass transition-colors font-mono">Dead Pixel Detection</h3>
              <p class="text-xs text-text-muted leading-relaxed">
                Scan your screen for dead pixels, stuck sub-pixels, and dark spots across 11 solid RGBW colors.
              </p>
            </div>
            <span class="text-xs text-status-pass font-bold font-mono">Run Dead Pixel Test &rarr;</span>
          </a>

          <!-- Card 2: White Screen Test -->
          <a href="/white-screen" class="bg-bg-surface p-5 rounded-xl border border-border-hairline hover:border-border-interactive transition-all group flex flex-col justify-between space-y-3 shadow-specular-top">
            <div class="space-y-2">
              <div class="text-text-secondary text-xs font-mono font-bold uppercase tracking-wider">Full Lighting</div>
              <h3 class="text-base font-bold text-text-primary group-hover:text-text-primary transition-colors font-mono">White Screen Test</h3>
              <p class="text-xs text-text-muted leading-relaxed">
                Full-screen white lighting canvas with Kelvin color temperature controls and smudge inspection grid.
              </p>
            </div>
            <span class="text-xs text-text-secondary font-bold font-mono">Open White Screen &rarr;</span>
          </a>

          <!-- Card 3: Black Screen Test -->
          <a href="/white-screen/black-screen" class="bg-bg-surface p-5 rounded-xl border border-border-hairline hover:border-border-interactive transition-all group flex flex-col justify-between space-y-3 shadow-specular-top">
            <div class="space-y-2">
              <div class="text-text-muted text-xs font-mono font-bold uppercase tracking-wider">Backlight Bleed</div>
              <h3 class="text-base font-bold text-text-primary group-hover:text-text-primary transition-colors font-mono">Black Screen Test</h3>
              <p class="text-xs text-text-muted leading-relaxed">
                Pure black RGB(0,0,0) fill pattern for dark-room IPS backlight bleed and OLED zero-luminance testing.
              </p>
            </div>
            <span class="text-xs text-text-secondary font-bold font-mono">Open Black Screen &rarr;</span>
          </a>

          <!-- Card 4: Touch Screen Test -->
          <a href="/touch-tests" class="bg-bg-surface p-5 rounded-xl border border-border-hairline hover:border-status-info transition-all group flex flex-col justify-between space-y-3 shadow-specular-top">
            <div class="space-y-2">
              <div class="text-status-info text-xs font-mono font-bold uppercase tracking-wider">Digitizer Matrix</div>
              <h3 class="text-base font-bold text-text-primary group-hover:text-status-info transition-colors font-mono">Touch Screen Testing</h3>
              <p class="text-xs text-text-muted leading-relaxed">
                Multi-touch contact counter, dead-zone matrix isolation, vector drawing precision, and charger EMI check.
              </p>
            </div>
            <span class="text-xs text-status-info font-bold font-mono">Launch Touch Suite &rarr;</span>
          </a>

          <!-- Card 5: Refresh Rate Test -->
          <a href="/refresh-rate-test" class="bg-bg-surface p-5 rounded-xl border border-border-hairline hover:border-status-warn transition-all group flex flex-col justify-between space-y-3 shadow-specular-top">
            <div class="space-y-2">
              <div class="text-status-warn text-xs font-mono font-bold uppercase tracking-wider">540Hz+ VRR</div>
              <h3 class="text-base font-bold text-text-primary group-hover:text-status-warn transition-colors font-mono">Refresh Rate Testing</h3>
              <p class="text-xs text-text-muted leading-relaxed">
                Sub-millisecond real Hz detection, P99 frame pacing jitter, mobile LTPO scaling, and motion reticles.
              </p>
            </div>
            <span class="text-xs text-status-warn font-bold font-mono">Check Refresh Rate &rarr;</span>
          </a>

          <!-- Card 6: OLED Screen Test -->
          <a href="/display-tests/oled-burn-in" class="bg-bg-surface p-5 rounded-xl border border-border-hairline hover:border-status-fail transition-all group flex flex-col justify-between space-y-3 shadow-specular-top">
            <div class="space-y-2">
              <div class="text-status-fail text-xs font-mono font-bold uppercase tracking-wider">Sub-Pixel Decay</div>
              <h3 class="text-base font-bold text-text-primary group-hover:text-status-fail transition-colors font-mono">OLED Screen Testing</h3>
              <p class="text-xs text-text-muted leading-relaxed">
                5% and 10% dark-gray uniformity patterns to identify image retention, static burn-in risk, and banding.
              </p>
            </div>
            <span class="text-xs text-status-fail font-bold font-mono">Run OLED Test &rarr;</span>
          </a>

          <!-- Card 7: Color Calibration -->
          <a href="/monitor-color-calibration" class="bg-bg-surface p-5 rounded-xl border border-border-hairline hover:border-purple-500 transition-all group flex flex-col justify-between space-y-3 shadow-specular-top">
            <div class="space-y-2">
              <div class="text-purple-500 text-xs font-mono font-bold uppercase tracking-wider">ICC Profile</div>
              <h3 class="text-base font-bold text-text-primary group-hover:text-purple-500 transition-colors font-mono">Monitor Color Calibration</h3>
              <p class="text-xs text-text-muted leading-relaxed">
                CIEDE2000 (ΔE00) accuracy check, optical Gamma 2.2 fusion steps, and binary ICC v4.3 profile exporter.
              </p>
            </div>
            <span class="text-xs text-purple-500 font-bold font-mono">Calibrate Colors &rarr;</span>
          </a>

          <!-- Card 8: Resolution Checker -->
          <a href="/display-tests/ppi-calculator" class="bg-bg-surface p-5 rounded-xl border border-border-hairline hover:border-blue-500 transition-all group flex flex-col justify-between space-y-3 shadow-specular-top">
            <div class="space-y-2">
              <div class="text-blue-500 text-xs font-mono font-bold uppercase tracking-wider">Pixel Density</div>
              <h3 class="text-base font-bold text-text-primary group-hover:text-blue-500 transition-colors font-mono">Resolution Checker</h3>
              <p class="text-xs text-text-muted leading-relaxed">
                Calculates exact Pixels Per Inch (PPI), dot pitch, 1-arcminute visual acuity, and pixels-to-inches conversion.
              </p>
            </div>
            <span class="text-xs text-blue-500 font-bold font-mono">Check Resolution &rarr;</span>
          </a>

          <!-- Card 9: Keyboard Tester -->
          <a href="/keyboard-tester" class="bg-bg-surface p-5 rounded-xl border border-border-hairline hover:border-status-pass transition-all group flex flex-col justify-between space-y-3 shadow-specular-top">
            <div class="space-y-2">
              <div class="text-status-pass text-xs font-mono font-bold uppercase tracking-wider">NKRO &amp; Chatter</div>
              <h3 class="text-base font-bold text-text-primary group-hover:text-status-pass transition-colors font-mono">Keyboard Tester</h3>
              <p class="text-xs text-text-muted leading-relaxed">
                Interactive ANSI/ISO key matrix, N-Key Rollover stress test, switch bounce chatter timing, and heatmaps.
              </p>
            </div>
            <span class="text-xs text-status-pass font-bold font-mono">Test Keyboard &rarr;</span>
          </a>
        </div>
      </section>

      <!-- 3. Why Use Display Test Online? -->
      <section class="space-y-4">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-text-primary font-mono">
          Why Use Display Test Online?
        </h2>
        <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3 font-sans text-xs sm:text-sm text-text-secondary">
          <li class="bg-bg-surface p-4 rounded-xl border border-border-hairline flex items-start gap-3 shadow-specular-top">
            <span class="text-status-pass font-bold text-base">✓</span>
            <div>
              <strong class="text-text-primary block font-mono">100% Free &amp; Ad-Free</strong>
              No paywalls, subscriptions, or invasive ads. Always free for everyone.
            </div>
          </li>
          <li class="bg-bg-surface p-4 rounded-xl border border-border-hairline flex items-start gap-3 shadow-specular-top">
            <span class="text-status-pass font-bold text-base">✓</span>
            <div>
              <strong class="text-text-primary block font-mono">Zero Software Downloads</strong>
              Runs natively in your browser using modern WebGL 2.0 and W3C APIs.
            </div>
          </li>
          <li class="bg-bg-surface p-4 rounded-xl border border-border-hairline flex items-start gap-3 shadow-specular-top">
            <span class="text-status-pass font-bold text-base">✓</span>
            <div>
              <strong class="text-text-primary block font-mono">100% Client-Side Privacy</strong>
              Zero data leaves your device. All calculations process locally in memory.
            </div>
          </li>
          <li class="bg-bg-surface p-4 rounded-xl border border-border-hairline flex items-start gap-3 shadow-specular-top">
            <span class="text-status-pass font-bold text-base">✓</span>
            <div>
              <strong class="text-text-primary block font-mono">Cross-Platform Compatibility</strong>
              Seamless execution across Windows, macOS, Linux, ChromeOS, Android, and iOS.
            </div>
          </li>
        </ul>
      </section>

      <!-- 4. Supported Devices -->
      <section class="space-y-4">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-text-primary font-mono">
          Supported Devices &amp; Panel Technologies
        </h2>
        <p class="leading-relaxed text-sm sm:text-base">
          Display Test Online is engineered to benchmark every screen technology across consumer and professional electronics. Our diagnostic engines automatically adjust for different sub-pixel geometries, touch sample rates, and refresh rate capabilities across:
        </p>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3.5 font-sans">
          <!-- 1. OLED Monitors -->
          <div class="bg-bg-surface hover:bg-bg-elevated border border-border-hairline hover:border-purple-500/40 p-4 rounded-xl flex flex-col items-center text-center group transition-all duration-200 shadow-specular-top cursor-default">
            <div class="w-12 h-12 rounded-xl bg-purple-500/10 border border-purple-500/30 flex items-center justify-center text-purple-400 mb-2.5 group-hover:scale-110 transition-transform duration-200">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                <circle cx="12" cy="9" r="1.5" fill="currentColor" opacity="0.8"></circle>
              </svg>
            </div>
            <span class="text-xs font-bold text-text-primary group-hover:text-purple-300 transition-colors">OLED Monitors</span>
            <span class="text-[10px] font-mono text-text-muted mt-0.5">QD-OLED &amp; WOLED</span>
          </div>

          <!-- 2. IPS Monitors -->
          <div class="bg-bg-surface hover:bg-bg-elevated border border-border-hairline hover:border-cyan-500/40 p-4 rounded-xl flex flex-col items-center text-center group transition-all duration-200 shadow-specular-top cursor-default">
            <div class="w-12 h-12 rounded-xl bg-cyan-500/10 border border-cyan-500/30 flex items-center justify-center text-cyan-400 mb-2.5 group-hover:scale-110 transition-transform duration-200">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <rect x="2" y="4" width="20" height="12" rx="2" stroke-linecap="round"></rect>
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 16v4m-4 0h8"></path>
              </svg>
            </div>
            <span class="text-xs font-bold text-text-primary group-hover:text-cyan-300 transition-colors">IPS Monitors</span>
            <span class="text-[10px] font-mono text-text-muted mt-0.5">AH-IPS &amp; Fast IPS</span>
          </div>

          <!-- 3. VA Monitors -->
          <div class="bg-bg-surface hover:bg-bg-elevated border border-border-hairline hover:border-amber-500/40 p-4 rounded-xl flex flex-col items-center text-center group transition-all duration-200 shadow-specular-top cursor-default">
            <div class="w-12 h-12 rounded-xl bg-amber-500/10 border border-amber-500/30 flex items-center justify-center text-amber-400 mb-2.5 group-hover:scale-110 transition-transform duration-200">
