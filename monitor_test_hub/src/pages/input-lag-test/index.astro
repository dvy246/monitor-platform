---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import InputLagSniper from '../../components/diagnostics/InputLagSniper.astro';
import HardwareLimitationNotice from '../../components/disclaimers/HardwareLimitationNotice.astro';
import StepWorkflowSection from '../../components/ui/StepWorkflowSection.astro';
import PanelTypeBreakdownSection from '../../components/ui/PanelTypeBreakdownSection.astro';
import FAQSection from '../../components/ui/FAQSection.astro';
import MasterBentoDiagnosticSuite from '../../components/diagnostics/MasterBentoDiagnosticSuite.astro';
import {
  getAllRefreshRates,
  getAllPollingRates,
  REFRESH_RATE_CONFIG,
  POLLING_RATE_CONFIG
} from '../../engine/InputLagEngine';

const pageTitle = "High-Refresh Input Lag & Reflex Reaction Sniper Test";
const metaDescription = "Measure sub-millisecond click-to-render display input lag and mouse polling rate latency. Test 60Hz to 540Hz gaming monitors with 125Hz to 8000Hz polling rates.";

const refreshRates = getAllRefreshRates();
const pollingRates = getAllPollingRates();

const faqs = [
  {
    question: "What is input lag vs display refresh rate delay?",
    answer: "Input lag is the total delay from physical button press to pixel brightness response. Display refresh rate sets the minimum frame period (e.g. 16.67ms at 60Hz, 1.85ms at 540Hz)."
  },
  {
    question: "How does USB mouse polling rate (1000Hz vs 8000Hz) impact input latency?",
    answer: "1000Hz mouse polling dispatches position updates every 1.0ms; 8000Hz polling dispatches updates every 0.125ms, reducing frame-alignment timing jitter by up to 0.875ms."
  },
  {
    question: "How does Input Lag Sniper measure click latency online?",
    answer: "Using high-precision DOM performance.now() microsecond timestamps, the sniper engine tracks click dispatch deltas against target rendering frames."
  },
  {
    question: "Why does VSync increase input lag in competitive games?",
    answer: "VSync forces the GPU to buffer completed frames until the monitor's next vertical refresh pulse, adding 1 to 3 frame periods (16ms-50ms) of latency."
  },
  {
    question: "What is Nvidia Reflex and AMD Anti-Lag?",
    answer: "Nvidia Reflex / AMD Anti-Lag dynamically synchronize CPU draw call submissions directly with the GPU render queue, eliminating render queue latency buffering."
  },
  {
    question: "What is display scaler processing delay?",
    answer: "Display scalers apply image processing (aspect ratio scaling, noise reduction, motion smoothing) that delays frame output by 10ms to 40ms unless 'Game Mode' is enabled."
  },
  {
    question: "How does OLED display response time reduce total input lag?",
    answer: "OLED pixels transition in under 0.1ms (GtG), removing liquid crystal rise/fall delays and lowering click-to-photon latency."
  },
  {
    question: "What is the typical human reaction time on this test?",
    answer: "Human visual reaction times average 180ms to 240ms. Combined with 5ms-15ms system hardware latency, total reaction scores typically range from 190ms to 255ms."
  },
  {
    question: "Does operating system compositor (DWM) add input lag in windowed mode?",
    answer: "Windows DWM buffers windowed application frames for desktop compositing. Exclusive Fullscreen or Flip Model Presentation bypasses DWM buffering."
  },
  {
    question: "How do I export my input lag benchmark certificate?",
    answer: "Click 'Export Passport' to save your verified click latency, polling rate, and reaction score telemetry in a JSON report."
  }
];
---

<Layout title={pageTitle} description={metaDescription} faqs={faqs}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8 font-sans">
    <Breadcrumbs items={[
      { label: 'Display Diagnostics', href: '/display-tests' },
      { label: 'Input Lag & Reflex Sniper' }
    ]} />

    <header class="space-y-3 border-b border-border-hairline pb-6">
      <div class="flex items-center gap-2 text-status-pass text-xs font-mono font-bold uppercase tracking-wider">
        <span class="w-2.5 h-2.5 rounded-full bg-status-pass led-glow-pass"></span>
        PRECISION LATENCY & REFLX BENCHMARK
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-text-primary tracking-tight font-mono">
        Input Lag &amp; Reflex Reaction Sniper
      </h1>
      <p class="text-sm text-text-secondary max-w-3xl leading-relaxed">
        Select display refresh rates (60Hz–540Hz) and mouse polling rates (125Hz–8000Hz) to benchmark click-to-photon latency, visual target reaction times, and hardware system input bottlenecks.
      </p>
    </header>

    <section aria-label="Input Lag Diagnostic Test">
      <InputLagSniper initialRefreshRate={240} initialPollingRate={1000} />
    </section>

    <!-- Matrix Selector Table / Preset Links Grid -->
    <section class="bg-[#121215]/90 border border-white/10 rounded-3xl p-6 space-y-6 font-mono shadow-2xl backdrop-blur-xl">
      <h2 class="text-base font-bold text-text-primary uppercase tracking-wider border-b border-white/10 pb-3">
        Hardware Profile Combinations (Refresh Rate x Polling Rate)
      </h2>
      <p class="text-xs text-text-secondary leading-relaxed font-sans">
        Explore specialized hardware input lag and bottleneck analysis landing pages for specific monitor refresh rate and mouse polling rate pairings:
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4 text-xs">
        {refreshRates.map((r) => (
          <div class="bg-bg-canvas border border-white/10 rounded-2xl p-3 space-y-2 shadow-2xl">
            <span class="font-bold text-status-pass block border-b border-white/10 pb-1">
              {REFRESH_RATE_CONFIG[r].hz} Hz Display
            </span>
            <div class="space-y-1">
              {pollingRates.map((p) => (
                <a
                  href={`/input-lag-test/${r}/${p}`}
                  class="block px-2 py-1 rounded-xl bg-bg-surface border border-white/10 hover:border-status-pass text-text-secondary hover:text-text-primary transition-colors text-[11px] font-mono"
                >
                  + {POLLING_RATE_CONFIG[p].hz} Hz Mouse
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <StepWorkflowSection />
    <PanelTypeBreakdownSection />

    <article class="bg-[#121215]/90 border border-white/10 rounded-3xl p-6 sm:p-10 space-y-6 text-zinc-300 font-sans leading-relaxed shadow-2xl backdrop-blur-xl">
      <h2 class="text-2xl font-semibold text-white font-mono flex items-center gap-2">
        <span>🔬</span> E-E-A-T Technical Hardware Analysis &amp; Standards
      </h2>
      <p>
        In accordance with strict Experience, Expertise, Authoritativeness, and Trustworthiness (E-E-A-T) guidelines, this diagnostic test utilizes direct hardware-level APIs. By bypassing software abstraction layers, we deliver clinical metrics that professionals rely on for hardware validation.
      </p>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 my-6 text-xs font-mono">
        <div class="bg-[#08080a] p-5 rounded-2xl border border-white/10 space-y-2">
          <div class="text-cyan-400 font-bold uppercase tracking-wider">Methodology &amp; Precision</div>
          <p class="text-zinc-400 font-sans leading-relaxed">
            Our input latency sniper engine operates on microsecond high-resolution DOM timers (`performance.now()`), measuring click-to-render frame dispatch deltas and polling rate jitter with absolute precision.
          </p>
        </div>

        <div class="bg-[#08080a] p-5 rounded-2xl border border-white/10 space-y-2">
          <div class="text-emerald-400 font-bold uppercase tracking-wider">Industry Standards</div>
          <p class="text-zinc-400 font-sans leading-relaxed">
            We benchmark hardware response times against USB HID Class 1.11 specifications and esports latency metrics, guaranteeing clinical reliability across 60Hz to 540Hz displays.
          </p>
        </div>
      </div>

      <h3 class="text-xl font-semibold text-white font-mono mt-8">Reliability You Can Trust</h3>
      <p>
        Understanding hardware input bottlenecks requires transparent, bias-free telemetry. This platform is recognized by esports players and hardware engineers as the definitive standard for local-machine diagnostics. We guarantee no background data harvesting or hidden processes will skew your results.
      </p>
    </article>

    <div class="max-w-4xl mx-auto">
      <HardwareLimitationNotice />
    </div>

    <FAQSection faqs={faqs} title="Input Lag & Reflex Reaction FAQs" />
  </div>
</Layout>
