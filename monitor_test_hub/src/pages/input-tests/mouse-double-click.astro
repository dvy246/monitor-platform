---
import Layout from '../../layouts/Layout.astro';
import MouseDoubleClick from '../../components/diagnostics/MouseDoubleClick.astro';

const faqs = [
  {
    question: "What causes a gaming mouse to start double-clicking?",
    answer: "Mechanical microswitches rely on metallic leaf springs. Over time, physical wear or oxidation causes voltage bounce (chatter), causing the switch to register two clicks when pressed once."
  },
  {
    question: "How does this test distinguish a real double-click from a fast manual click?",
    answer: "Human fingers cannot physically press and release a mechanical mouse switch in under 30 milliseconds. Any click pair registered under 30ms is flagged as a hardware switch bounce defect."
  },
  {
    question: "Do optical mouse switches get double-click defects?",
    answer: "No. Optical switches use an infrared light beam rather than physical metallic contacts to register clicks, making them physically immune to mechanical double-click chatter."
  },
  {
    question: "How can I fix a double-clicking mouse?",
    answer: "You can increase the mouse debounce delay in software (e.g. Logitech G HUB, Razer Synapse), solder new microswitches, or clean switch contacts with electrical contact cleaner."
  }
];
---

<Layout 
  title="Mouse Double Click Test | Switch Bounce & Chatter Detector"
  description="Test your mouse for faulty double-click hardware defects and switch chatter. Measure click debounce interval timings in milliseconds."
>
  <div class="py-10 px-4 sm:px-6 lg:px-8 space-y-12">
    <section class="max-w-4xl mx-auto text-center space-y-4">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-status-pass/10 border border-status-pass/30 text-xs font-mono text-status-pass font-bold">
        <span>30MS MECHANICAL DEBOUNCE BOUNDARY</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold font-mono tracking-tight text-text-primary">
        Mouse Double-Click &amp; Switch Bounce Chatter Tester
      </h1>
      <p class="text-sm sm:text-base text-text-muted leading-relaxed max-w-2xl mx-auto">
        Test your gaming mouse for faulty mechanical switch chatter defects and measure microsecond click debounce intervals.
      </p>
    </section>

    <MouseDoubleClick />

    <article class="max-w-4xl mx-auto space-y-8 bg-bg-surface/80 border border-border-hairline rounded-2xl p-6 sm:p-8 backdrop-blur-xl text-sm text-text-secondary leading-relaxed">
      <h2 class="text-xl font-bold font-mono text-text-primary">Understanding Mouse Switch Bounce Chatter</h2>
      <p>
        Mechanical mouse microswitches degrade over time as internal leaf springs lose tension, causing electrical signals to flicker (chatter) during a single click press.
      </p>

      <h2 class="text-xl font-bold font-mono text-text-primary">Frequently Asked Questions</h2>
      <div class="space-y-4">
        {faqs.map(faq => (
          <div class="border-b border-border-hairline pb-4 space-y-1">
            <h3 class="font-bold text-text-primary font-mono">{faq.question}</h3>
            <p class="text-xs text-text-muted">{faq.answer}</p>
          </div>
        ))}
      </div>
    </article>
  </div>
</Layout>
