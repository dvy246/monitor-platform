      faqs: [
        { question: "What is N-Key Rollover (NKRO)?", answer: "NKRO allows every key on the keyboard to be pressed simultaneously without key blocking, dropping, or ghosting." },
        { question: "What is 6KRO (6-Key Rollover)?", answer: "6KRO restricts USB HID reports to 6 concurrent alphanumeric keys plus modifier keys (Ctrl, Shift, Alt, Cmd)." },
        { question: "What is keyboard ghosting?", answer: "Ghosting occurs on cheap membrane keyboards when pressing 3 adjacent keys causes an unpressed 4th key to falsely trigger." },
        { question: "How do diodes enable NKRO in mechanical keyboards?", answer: "Individual diodes placed on every switch circuit prevent electrical current from backflowing across grid traces." },
        { question: "How do I perform an NKRO rollover test?", answer: "Press both palms down across your keyboard matrix; the counter records total simultaneous registered keys." },
        { question: "Why do some USB keyboards require pressing a shortcut to enable NKRO?", answer: "Some keyboards default to 6KRO for legacy BIOS compatibility; press Fn+N or Fn+F12 to switch to USB NKRO mode." },
        { question: "Does USB protocol natively support NKRO?", answer: "Standard USB HID boot protocol limits reports to 6KRO; NKRO keyboards use custom report descriptors or virtual hub endpoints." },
        { question: "Is NKRO necessary for rhythm games like Osu! or IIDX?", answer: "Yes, rhythm games require simultaneous multi-key chords; 6KRO can cause dropped inputs during dense note patterns." },
        { question: "Can Bluetooth keyboards support full NKRO?", answer: "Most Bluetooth HID profiles cap simultaneous key reports at 6KRO to conserve wireless bandwidth and power." },
        { question: "How do I export my NKRO rollover test score?", answer: "Click 'Download Certificate' to export a cryptographically signed report certifying your keyboard's peak NKRO count." }
      ]
    }
  ];

  return keyboardCategories.map(cat => ({
    params: { slug: cat.slug },
    props: { cat }
  }));
}

const cat = Astro.props.cat || {
  slug: 'online-keyboard-test',
  title: 'Online Keyboard Test | Free Web Keyboard Tester & Key Code Inspector',
  h1: 'Online Keyboard Test & Hardware Key Code Diagnostic Utility',
  description: 'Free online keyboard test utility to verify every key on your physical keyboard. Test key switches, WASD gaming combos, and key event codes in real-time.',
  badge: 'ONLINE KEYBOARD DIAGNOSTIC UTILITY',
  faqs: []
};

const canonicalUrl = `https://monitortester.com/keyboard-tester/${cat.slug}`;
---

<Layout title={cat.title} description={cat.description} faqs={cat.faqs} canonicalUrl={canonicalUrl}>

  <div class="py-10 px-4 sm:px-6 lg:px-8 space-y-12 bg-bg-canvas">
    <section class="max-w-4xl mx-auto text-center space-y-4">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-status-pass/10 border border-status-pass/30 text-xs font-mono text-status-pass font-bold">
        <span>{cat.badge}</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold font-mono tracking-tight text-text-primary">
        {cat.h1}
      </h1>
      <p class="text-sm sm:text-base text-text-muted leading-relaxed max-w-2xl mx-auto">
        {cat.description}
      </p>
    </section>

    <!-- Main Visual Diagnostic Engine Component -->
    <KeyboardTesterCanvas />

    <!-- 10-Item Technical FAQ Section -->
    {cat.faqs && cat.faqs.length > 0 && (
      <section class="max-w-5xl mx-auto space-y-6 bg-bg-surface/80 border border-border-hairline rounded-2xl p-6 sm:p-8 backdrop-blur-xl font-sans">
        <div class="border-b border-border-hairline pb-4">
          <h2 class="text-xl font-bold font-mono text-text-primary">Frequently Asked Questions ({cat.h1})</h2>
          <p class="text-xs text-text-muted mt-1 font-mono">10-Item Technical FAQ &amp; USB HID Diagnostic Troubleshooting</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {cat.faqs.map(faq => (
            <div class="p-4 rounded-xl bg-bg-canvas border border-border-hairline space-y-1.5">
              <h3 class="font-bold text-text-primary font-mono text-xs sm:text-sm">{faq.question}</h3>
              <p class="text-xs text-text-muted leading-relaxed">{faq.answer}</p>
            </div>
          ))}
        </div>
      </section>
    )}
  </div>
</Layout>
