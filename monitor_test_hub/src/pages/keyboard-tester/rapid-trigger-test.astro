---
import FAQSection from '../../components/ui/FAQSection.astro';
import Layout from '../../layouts/Layout.astro';
import RapidTriggerCanvas from '../../components/diagnostics/RapidTriggerCanvas.astro';
import { useTranslations } from '../../utils/i18n';

import StatusCard from '../../components/ui/sidebar/StatusCard.astro';
import MetricCard from '../../components/ui/sidebar/MetricCard.astro';
import TelemetryCard from '../../components/ui/sidebar/TelemetryCard.astro';

const { lang } = useTranslations(Astro.url.pathname);
const canonicalUrl = lang === 'en'
  ? "https://displaytestonline.com/keyboard-tester/rapid-trigger-test"
  : `https://displaytestonline.com/${lang}/keyboard-tester/rapid-trigger-test`;

const faqs = [
  { question: "What is Rapid Trigger?", answer: "Rapid Trigger is a feature found in analog Hall Effect keyboards (like Wooting) that dynamically resets the actuation point as soon as you release the key, rather than waiting for a fixed reset point." },
  { question: "How do I test my Hall Effect keyboard?", answer: "Simply press your WASD keys in the test window. The analyzer will monitor the actuation distance and reset threshold, simulating a continuous trigger response." },
  { question: "What is the benefit for gaming?", answer: "In games like CS2 or Valorant, rapid trigger allows for instant counter-strafing, stopping your character's momentum milliseconds faster than a traditional mechanical switch." },
  { question: "Can I test normal mechanical switches here?", answer: "Yes, but standard mechanical switches will only show a fixed binary ON/OFF actuation rather than a dynamic depth reading." },
  { question: "What is actuation depth?", answer: "The exact distance (measured in millimeters, e.g., 0.1mm to 4.0mm) a key must be pressed before it registers an input." },
  { question: "Does this require a driver?", answer: "No, this tool uses standard browser APIs to detect keypress events, but true analog depth readings may require WebHID support." },
  { question: "Why is the reading fixed at 1.2mm for my keyboard?", answer: "Standard keyboards do not send analog depth telemetry to the browser. Only specific keyboards configured for WebHID or analog output will show varying depths." },
  { question: "Which keyboards support Rapid Trigger?", answer: "Wooting 60HE, SteelSeries Apex Pro, Razer Huntsman V3 Pro, and DrunkDeer keyboards use Hall Effect or optical sensors capable of Rapid Trigger." },
  { question: "Can I adjust the Rapid Trigger sensitivity?", answer: "You must adjust it within your keyboard's proprietary software (e.g., Wootility). This tool only validates the output." },
  { question: "Is this test accurate for competitive gaming?", answer: "It accurately reflects the input data received by your OS, making it a reliable indicator of your keyboard's actual response latency." }
];

const seoTitle = "Hall Effect Rapid Trigger & Actuation Depth Tester";
const seoDescription = "Test your analog Hall Effect keyboard's Rapid Trigger actuation depth and dynamic reset points. Free online test for Wooting, SteelSeries, and Razer.";
---

<Layout title={seoTitle} description={seoDescription} faqs={faqs} canonicalUrl={canonicalUrl}>
  <div class="max-w-7xl mx-auto px-4 py-6 sm:py-8 min-w-0 w-full overflow-hidden font-sans">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mt-6">
      
      <div class="lg:col-span-8 space-y-8 min-w-0">
        <section class="max-w-4xl mx-auto text-center space-y-4">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-rose-500/10 border border-rose-500/30 text-xs font-mono text-rose-400 font-bold">
            <span>HALL EFFECT SENSOR ANALYSIS</span>
          </div>
          <h1 class="text-3xl sm:text-4xl font-extrabold font-mono tracking-tight text-white">
            Rapid Trigger Actuation Tester
          </h1>
          <p class="text-sm sm:text-base text-zinc-400 leading-relaxed max-w-2xl mx-auto">
            Test the dynamic actuation and reset points of magnetic Hall Effect switches. Perfect for calibrating Wooting, Razer, and SteelSeries gaming keyboards.
          </p>
        </section>

        <RapidTriggerCanvas />

        <article class="max-w-5xl mx-auto space-y-6 bg-[#121215] border border-white/10 rounded-3xl p-6 sm:p-8 backdrop-blur-xl text-sm text-zinc-300 leading-relaxed shadow-2xl">
          <div class="border-b border-white/10 pb-4">
            <h2 class="text-xl font-bold font-mono text-white">Continuous Analog Matrix</h2>
            <p class="mt-2 text-zinc-400">
              Unlike traditional binary switches, Hall Effect switches measure the exact magnetic flux of the stem's descent. This allows for 'Rapid Trigger'—a feature that breaks the circuit the instant the key is lifted, completely eliminating mechanical reset deadzones.
            </p>
          </div>
        </article>

        <FAQSection faqs={faqs} />
      </div>

      <div class="lg:col-span-4 space-y-6 sticky top-24 self-start min-w-0">
        <StatusCard
          status="pass"
          label="SYSTEM READY"
          subtitle="Sensor Status"
          score="100"
          maxScore="100"
          details={[
            { label: 'Keys', value: 'Ready' }
          ]}
        />
        <MetricCard
          title="Switch Telemetry"
          subtitle="Analog Depth Matrix"
          badgeText="Real-time"
          metrics={[
            { id: 'actuation', label: 'Actuation Point', value: '0.0', unit: 'mm', status: 'neutral' }
          ]}
        />
      </div>

    </div>
  </div>
</Layout>
