---
import FAQSection from '../../../components/ui/FAQSection.astro';
import Layout from '../../../layouts/Layout.astro';
import KeyboardTesterCanvas from '../../../components/diagnostics/KeyboardTesterCanvas.astro';
import { useTranslations, localizeLink } from '../../../utils/i18n';
import { switchesList } from './index.astro';

export function getStaticPaths() {
  return switchesList.map(item => ({
    params: { slug: item.slug },
    props: { switchData: item }
  }));
}

const { switchData } = Astro.props;
const { lang } = useTranslations(Astro.url.pathname);

const faqs = [
  {
    question: `How do I test my ${switchData.name} switches for chatter?`,
    answer: `Press your ${switchData.name} key repeatedly in our tester. Our high-resolution performance timers track the time delta between consecutive keydown events. Any delta under ${switchData.bounceMs} indicates switch contact bounce (chatter).`
  },
  {
    question: `What is the expected bounce time for ${switchData.name}?`,
    answer: `The official manufacturer spec for ${switchData.name} is a contact debounce threshold of ${switchData.bounceMs}. If keydown events trigger faster than this window, the physical leaf contacts may require cleaning or replacement.`
  },
  {
    question: `What are the technical specs of ${switchData.name}?`,
    answer: `${switchData.name} is a ${switchData.type} switch manufactured by ${switchData.brand} with an actuation force of ${switchData.force} and a key travel distance of ${switchData.travel}.`
  }
];

const seoTitle = `${switchData.name} Key Switch Chatter & Bounce Test`;
const seoDescription = `Test your ${switchData.name} mechanical key switches for double typing, microsecond switch chatter (${switchData.bounceMs} debounce threshold), and NKRO rollover.`;
---

<Layout title={seoTitle} description={seoDescription} faqs={faqs}>
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 font-mono">
    <!-- Breadcrumbs -->
    <div class="flex items-center space-x-2 text-xs text-text-muted mb-6">
      <a href={localizeLink("/", lang)} class="hover:text-text-primary">Home</a>
      <span>/</span>
      <a href={localizeLink("/keyboard-tester", lang)} class="hover:text-text-primary">Keyboard Tester</a>
      <span>/</span>
      <a href={localizeLink("/keyboard-tester/switches", lang)} class="hover:text-text-primary">Switches</a>
      <span>/</span>
      <span class="text-cyan-400 font-bold">{switchData.name}</span>
    </div>

    <!-- Direct Answer Block for AEO -->
    <div itemScope itemType="https://schema.org/Answer" class="bg-bg-surface/80 border border-cyan-500/30 rounded-2xl p-6 mb-8 backdrop-blur-xl">
      <div class="flex justify-between items-start mb-2">
        <span class="text-xs font-bold text-cyan-400 uppercase tracking-wider">{switchData.brand} Hardware Spec</span>
        <span class="text-xs font-bold px-2.5 py-1 rounded bg-cyan-500/10 text-cyan-300 border border-cyan-500/30">{switchData.type}</span>
      </div>
      <h1 class="text-2xl font-bold text-text-primary mb-3 font-sans">{switchData.name} Switch Chatter &amp; Bounce Test</h1>
      <p itemProp="text" class="text-sm text-text-secondary leading-relaxed font-sans">
        The {switchData.name} is a {switchData.type.toLowerCase()} mechanical switch requiring {switchData.force} of actuation force with a {switchData.travel} travel distance. Its nominal contact bounce threshold is {switchData.bounceMs}. Use our interactive tester below to measure your switch's microsecond bounce timing (t-delta) and identify double-typing faults.
      </p>
    </div>

    <!-- Keyboard Diagnostic Canvas -->
    <div class="mb-10">
      <KeyboardTesterCanvas />
    </div>
  </section>
  <FAQSection faqs={faqs} />
</Layout>
