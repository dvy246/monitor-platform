---
import FAQSection from '../../components/ui/FAQSection.astro';
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import { DeviceDatabase } from '../../engine/DeviceDatabase';
import StepWorkflowSection from '../../components/ui/StepWorkflowSection.astro';
import PanelTypeBreakdownSection from '../../components/ui/PanelTypeBreakdownSection.astro';

// Right Sidebar Components
import StatusCard from '../../components/ui/sidebar/StatusCard.astro';
import ConfigurationCard from '../../components/ui/sidebar/ConfigurationCard.astro';
import InfoCard from '../../components/ui/sidebar/InfoCard.astro';

const breadcrumbItems = [
  { label: 'Device Database', href: '/models' },
  { label: 'Verified Model Telemetry Hub' }
];

const devices = DeviceDatabase.getAllDevices();

const faqs = [
  {
    question: "What is the Crowdsourced Per-Model Verified Results Database?",
    answer: "The Per-Model Verified Database aggregates cryptographically signed hardware receipts (SHA-256) from real users performing display, latency, and subpixel diagnostic runs on Monitor Test Hub. It provides prospective buyers with real-world lot-variance data, ISO 9241-307 defect rates, and measured VSync frame pacing statistics."
  },
  {
    question: "How are display receipts cryptographically verified?",
    answer: "Every hardware receipt generated by HardwarePassportEngine is signed on the client via Web Crypto SHA-256 hashing. The signature certifies physical display resolution, refresh rate pacing, subpixel structure, and color depth without storing any personal user data."
  },
  {
    question: "Which device categories are covered in the database?",
    answer: "The database covers 100+ flagship devices across 5 categories: gaming monitors (QD-OLED, WOLED, 540Hz E-TN), professional laptops (MacBook Pro Liquid Retina XDR, Razer Blade Dual-Mode), OLED TVs (LG C3/C4, Samsung S90C/S95D), handheld gaming PCs (Steam Deck OLED, ROG Ally X, Legion Go), and flagship mobile devices (iPhone 16 Pro Max, iPad Pro M4 Tandem OLED)."
  },
  {
    question: "How is the panel defect-free rate calculated?",
    answer: "Defect-free rate is the percentage of submitted hardware passport receipts for a specific device model that record 0 dead sub-pixels, 0 stuck bright pixels, and 0 spatial matrix dead-zones during diagnostic scans."
  },
  {
    question: "What is ISO 9241-307 pixel defect class rating?",
    answer: "ISO 9241-307 defines international quality standards for flat panel display pixel defects. Displays are rated Class 0 (zero defect tolerance), Class I (max 1 bright/dark pixel), Class II (max 2 bright, 2 dark, or 5 sub-pixels per million), or Class III."
  },
  {
    question: "What is rAF VSync frame pacing jitter?",
    answer: "rAF VSync frame pacing jitter measures microsecond-level variance between RequestAnimationFrame render intervals and display refresh cycles. Lower jitter values (<0.2ms) indicate smooth frame presentation without micro-stutter."
  },
  {
    question: "How is OLED burn-in incidence rate tracked?",
    answer: "OLED burn-in incidence represents the percentage of verified community telemetry reports for an OLED or QD-OLED display model that report static image retention or uneven subpixel luminance decay."
  },
  {
    question: "How does subpixel structure affect text clarity?",
    answer: "Standard RGB subpixel layouts render sharp desktop fonts. Non-standard layouts (such as QD-OLED Triangular or WOLED RWBG) can exhibit subtle green or purple color fringing along vertical text edges under Windows ClearType font smoothing."
  },
  {
    question: "Can I contribute my device's hardware passport receipt?",
    answer: "Yes, after completing any visual or input diagnostic test on Monitor Test Hub, click 'Generate Hardware Passport' and opt-in to contribute your anonymous SHA-256 signed receipt to the public model database."
  },
  {
    question: "Is any personal information collected in hardware telemetry?",
    answer: "No personal data, IP addresses, or tracking cookies are collected. Telemetry receipts strictly capture hardware specs (GPU string, resolution, refresh rate, jitter ms, dead pixel counts) encrypted in a client-side SHA-256 signature."
  }
];
---

<Layout
  title="Crowdsourced Display & Device Telemetry Database | Monitor Test Hub"
  description="Explore crowdsourced, cryptographically verified hardware telemetry and defect rates for 100+ top gaming monitors, OLED TVs, laptops, and handheld gaming PCs."
  faqs={faqs}
>
  <div class="max-w-7xl mx-auto px-4 py-6 sm:py-8 space-y-8 font-sans">
    <Breadcrumbs items={breadcrumbItems} />

    <header class="space-y-3 border-b border-border-hairline pb-6">
      <div class="flex items-center gap-2 text-status-pass text-xs font-mono font-bold uppercase tracking-wider">
        <span class="w-2 h-2 rounded-full bg-status-pass led-glow-pass"></span>
        SHA-256 CRYPTOGRAPHIC HARDWARE TELEMETRY LEDGER
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-text-primary tracking-tight font-mono">
        Crowdsourced Device &amp; Monitor Database
      </h1>
      <p class="text-sm text-text-secondary max-w-3xl font-sans">
        Real-world lot-variance telemetry, ISO 9241-307 defect incidence rates, and measured VSync frame pacing consistency aggregated from thousands of cryptographically signed hardware passports.
      </p>
    </header>

    <!-- 2-Column Responsive Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <!-- Left Content & Model Search Grid -->
      <div class="lg:col-span-8 space-y-8">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 font-mono">
          {devices.map((device) => (
            <a 
              href={`/models/${device.slug}`}
              class="bg-bg-surface border border-border-hairline hover:border-status-pass/40 rounded-3xl p-5 space-y-4 transition-colors duration-200 cursor-pointer group flex flex-col justify-between"
            >
              <div class="space-y-2">
                <div class="flex items-center justify-between text-[10px]">
                  <span class="px-2 py-0.5 rounded uppercase font-bold bg-bg-canvas text-text-muted border border-border-hairline">
                    {device.brand} • {device.category}
                  </span>
                  <span class="px-2 py-0.5 rounded font-bold uppercase bg-status-pass/10 text-status-pass border border-status-pass/20">
                    {device.displayTech}
                  </span>
                </div>

                <h2 class="text-base font-bold text-text-primary group-hover:text-status-pass transition-colors font-sans line-clamp-2">
                  {device.name}
                </h2>

                <p class="text-xs text-text-secondary line-clamp-2 font-sans">
                  {device.description}
                </p>
              </div>

              <div class="space-y-3 pt-3 border-t border-border-hairline text-xs">
                <div class="grid grid-cols-2 gap-2 text-[11px]">
                  <div>
                    <span class="text-text-muted block text-[9px] uppercase">RESOLUTION</span>
                    <strong class="text-text-primary">{device.resolutionWidth}x{device.resolutionHeight}</strong>
                  </div>
                  <div>
                    <span class="text-text-muted block text-[9px] uppercase">VERIFIED PASS</span>
                    <strong class="text-status-pass">{device.defectFreeRate}%</strong>
                  </div>
                </div>

                <div class="flex items-center justify-between text-[11px] pt-1 border-t border-border-hairline/60">
                  <span class="text-text-muted">{device.verifiedReportsCount.toLocaleString()} Signed Passports</span>
                  <span class="text-status-pass font-bold group-hover:underline flex items-center gap-1">
                    View Telemetry &rarr;
                  </span>
                </div>
              </div>
            </a>
          ))}
        </div>

        <!-- Technical Guide & Methodology Footer -->
        <section class="bg-bg-surface border border-border-hairline rounded-3xl p-6 md:p-8 space-y-4 font-mono">
          <h2 class="text-xl font-bold text-text-primary font-sans">Crowdsourced Telemetry Methodology</h2>
          <p class="text-xs text-text-secondary leading-relaxed font-sans max-w-4xl">
            Every record in the Monitor Test Hub model database is certified via client-side Web Crypto SHA-256 signatures generated during hardware diagnostic runs. Telemetry logs physical display resolution, measured VSync frame pacing delta (1/FPS), ISO 9241-307 pixel defect counts, and OLED sub-pixel degradation heuristics without transmitting any personal identifiable information (PII).
          </p>
        </section>
      </div>

      <!-- Right Modular Control & Telemetry Sidebar -->
      <div class="lg:col-span-4 sticky top-24 space-y-6">
        <ConfigurationCard
          title="Database Filters"
          subtitle="Filter Flagship Displays"
          badgeText="Filters"
          controls={[
            {
              id: "tech-filter",
              label: "Display Technology",
              type: "select",
              value: "all",
              options: [
                { value: "all", label: "All Technologies" },
                { value: "qd-oled", label: "QD-OLED" },
                { value: "woled", label: "WOLED" },
                { value: "fast-ips", label: "Fast-IPS" },
                { value: "tn-540hz", label: "540Hz E-TN" }
              ]
            },
            {
              id: "refresh-filter",
              label: "Min Refresh Rate",
              type: "presets",
              value: "240",
              options: [
                { value: "144", label: "144Hz+" },
                { value: "240", label: "240Hz+" },
                { value: "360", label: "360Hz+" },
                { value: "540", label: "540Hz" }
              ]
            }
          ]}
        />

        <StatusCard
          status="pass"
          label="Community Lot-Variance Index"
          subtitle="Cryptographic Telemetry Ledger"
          score="96.4%"
          maxScore="Pass Rate"
          details={[
            { label: "Signed Receipts", value: "14,820" },
            { label: "ISO Class I Pass", value: "98.2%" }
          ]}
        />

        <InfoCard
          title="ISO 9241-307 RMA Standard"
          subtitle="Quality Class Thresholds"
          badgeText="ISO Specs"
          accentColor="emerald"
          citations={[
            {
              standard: "ISO 9241-307 Class I",
              clause: "Zero Defect Limit",
              description: "Mandates zero bright full pixels and max 1 dark pixel allowed per million pixels for Class I compliance."
            }
          ]}
        />
      </div>
    </div>

    <!-- Standard 4-Part Sections -->
    <StepWorkflowSection />
    <PanelTypeBreakdownSection />
    <FAQSection faqs={faqs} />
  </div>
</Layout>
