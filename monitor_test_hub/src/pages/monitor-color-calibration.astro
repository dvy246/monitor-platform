---
import Layout from '../layouts/Layout.astro';
import GammaCalibration from '../components/diagnostics/GammaCalibration.astro';
import GrayscaleStep from '../components/diagnostics/GrayscaleStep.astro';
import DeltaECalculatorInspector from '../components/diagnostics/DeltaECalculatorInspector.astro';
import ApcaContrastInspector from '../components/diagnostics/ApcaContrastInspector.astro';
import TestGuideModal from '../components/ui/TestGuideModal.astro';
import FAQSection from '../components/ui/FAQSection.astro';

import PaletteCard from '../components/ui/sidebar/PaletteCard.astro';
import MetricCard from '../components/ui/sidebar/MetricCard.astro';
import PassportCard from '../components/ui/sidebar/PassportCard.astro';
import InfoCard from '../components/ui/sidebar/InfoCard.astro';

const colorGuideSteps = [
  "Inspect the Optical Gamma 2.2 dither box — step back until dithered lines blend into solid gray.",
  "Check the 16-step grayscale ramp for black crush (RGB 1-5) and white clipping (RGB 250-255).",
  "Select a 24-patch Macbeth ColorChecker reference color or enter custom hex to evaluate CIEDE2000 (ΔE00).",
  "Adjust your monitor's OSD Red, Green, and Blue gain sliders until ΔE00 < 1.0.",
  "Click 'Export ICC v4.3 Profile (.icc)' to download a calibrated OS profile for Windows or macOS."
];

const faqs = [
  {
    question: "How do I calibrate my monitor's color temperature to D65 (6500K)?",
    answer: "To target D65 (6500K daylight white point), use our visual white balance reference block. Adjust your monitor's OSD Red, Green, and Blue gain sliders individually until the white box matches neutral D65 without warm yellow or cool blue color tinting."
  },
  {
    question: "What is optical Gamma 2.2 calibration and how do I test it without a colorimeter?",
    answer: "Gamma 2.2 defines the mathematical luminance curve from pure black to pure white. Our tool uses alternating 50% black-and-white dither lines. Step back from your display: when the dithered pattern blends seamlessly into the surrounding solid gray block, your monitor is outputting true 2.2 gamma."
  },
  {
    question: "How do I eliminate unwanted color casts (red, green, or blue tint) in neutral grays?",
    answer: "Color casts indicate uncalibrated gray balance. Inspect our 256-level gray step scale. If dark grays shift toward red or blue, lower the corresponding Red or Blue channel in your display's On-Screen Display (OSD) custom color settings."
  },
  {
    question: "How do I install an exported ICC v4.3 profile in Windows 11 or macOS?",
    answer: "On Windows: Open 'Color Management' -> Add downloaded .icc file -> Set as Default Profile -> Check 'Use my settings for this device'. On macOS: Copy the .icc file to ~/Library/ColorSync/Profiles/ and select it in System Settings -> Displays -> Color Profile."
  },
  {
    question: "What is the difference between visual software calibration and hardware colorimeter calibration?",
    answer: "Visual web calibration optimizes monitor OSD hardware controls (Brightness, Contrast, RGB Gain, Gamma presets) for human perception without spending money. Hardware colorimeter probes (like SpyderX or Calibrite Display Pro) measure absolute luminance nit values for print studio proofing."
  },
  {
    question: "How do I calibrate shadow detail (near-black RGB 1-10) and highlight retention (near-white RGB 245-255)?",
    answer: "Inspect our contrast step patches. Adjust monitor Brightness so RGB level 1 is barely distinguishable from pure black RGB 0. Adjust Contrast so RGB level 254 remains visible against pure white RGB 255 without highlight clipping."
  },
  {
    question: "What is CIEDE2000 (ΔE00) and what Delta-E score is considered imperceptible to human eyes?",
    answer: "CIEDE2000 (ΔE00) is the international standard formula for computing human color perception differences. A ΔE00 < 1.0 is considered completely imperceptible to human eyes. ΔE00 < 2.0 is the standard threshold for professional creative work."
  },
  {
    question: "How does 8-bit + FRC differ from true 10-bit color depth during visual calibration?",
    answer: "Native 10-bit panels render 1,024 shades per RGB channel (1.07 billion colors) smoothly. 8-bit + FRC panels use rapid frame rate control temporal flickering to simulate 10-bit color. Run our gradient banding test to detect temporal dithering noise."
  },
  {
    question: "Should I calibrate my monitor in sRGB, DCI-P3, or Adobe RGB mode?",
    answer: "Calibrate to 100% sRGB for general web browsing, YouTube, gaming, and standard office work. Select DCI-P3 for HDR movie editing, macOS apps, and QD-OLED cinema viewings. Select Adobe RGB if preparing photos for commercial physical printing."
  },
  {
    question: "How often should I re-calibrate my display for optimal color accuracy?",
    answer: "Monitors shift color temperature over time as backlights and organic sub-pixels age. We recommend re-checking your gamma and white point alignment every 1 to 3 months, or immediately after OS display driver updates."
  }
];
---

<Layout 
  title="Monitor Color Calibration - Free Online Gamma 2.2 & Color Test"
  description="Free online monitor color calibration. Calibrate display gamma 2.2 steps, test ΔE00 color accuracy, and export custom ICC color profiles."
  faqs={faqs}
>
  <div class="max-w-7xl mx-auto px-4 py-6 sm:py-8 min-w-0 w-full overflow-hidden font-sans space-y-10">
    <TestGuideModal
      testId="color-calibration"
      testTitle="Monitor Color Calibration Guide"
      steps={colorGuideSteps}
    />

    <!-- Hero Diagnostic Header Deck -->
    <div class="relative w-full rounded-3xl border border-zinc-800/90 bg-[#0c0d12]/95 backdrop-blur-2xl p-6 sm:p-8 md:p-10 shadow-[0_25px_60px_rgba(0,0,0,0.8)] text-center space-y-4 overflow-hidden group select-none">
      <div class="absolute -top-24 -left-24 w-72 h-72 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none group-hover:bg-emerald-500/15 transition-all duration-500"></div>
      <div class="absolute -bottom-24 -right-24 w-72 h-72 bg-purple-500/10 rounded-full blur-3xl pointer-events-none group-hover:bg-purple-500/15 transition-all duration-500"></div>

      <div class="relative z-10 space-y-4 max-w-3xl mx-auto min-w-0 w-full">
        <div class="inline-flex items-center justify-center gap-3 flex-wrap min-w-0">
          <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-zinc-950 border border-zinc-800 text-emerald-400 text-xs font-mono font-bold tracking-wide flex-wrap justify-center shadow-inner">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse shrink-0"></span>
            <span class="break-words min-w-0">STATE-OF-THE-ART COLOR CALIBRATION SUITE</span>
          </span>

          <button
            type="button"
            onclick="window.openGuide_color_calibration ? window.openGuide_color_calibration() : null"
            class="px-3.5 py-1.5 rounded-full bg-zinc-950 border border-zinc-800 text-zinc-300 hover:text-white text-xs font-bold font-mono transition-colors duration-200 cursor-pointer hover:border-emerald-400/40 min-h-[44px] px-4 flex items-center justify-center gap-2 shrink-0 shadow-inner"
          >
            <svg class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
            </svg>
            <span>How To Test</span>
          </button>
        </div>

        <h1 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight font-sans break-words min-w-0">
          Monitor Color Calibration Online
        </h1>
        <p class="text-sm sm:text-lg text-zinc-400 font-sans leading-relaxed min-w-0">
          Calibrate white balance (D65 6500K), optical Gamma 2.2, grayscale dynamic range, CIEDE2000 color accuracy (&Delta;E<sub>00</sub>), and export binary ICC v4.3 color profiles.
        </p>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
      <!-- Main Diagnostic Workstation Column -->
      <div class="lg:col-span-8 space-y-10 min-w-0">
        
        <!-- SECTION 1: Gamma 2.2 & Dynamic Range Alignment -->
        <section class="space-y-6">
          <div class="flex items-center gap-3 border-b border-zinc-800/80 pb-3">
            <span class="w-8 h-8 rounded-xl bg-purple-500/10 border border-purple-500/30 flex items-center justify-center text-purple-400 font-mono font-extrabold text-sm shadow">01</span>
            <div>
              <h2 class="text-lg sm:text-xl font-extrabold font-mono text-white tracking-wide">Optical Gamma 2.2 &amp; Grayscale Dynamic Range</h2>
              <p class="text-xs text-zinc-400 font-sans mt-0.5">Evaluate optical midtone transfer curve and 16-step black crush / white clipping thresholds.</p>
            </div>
          </div>

          <div class="space-y-6">
            <GammaCalibration />
            <GrayscaleStep />
          </div>
        </section>

        <!-- SECTION 2: CIEDE2000 & APCA Lightness Contrast -->
        <section class="space-y-6">
          <div class="flex items-center gap-3 border-b border-zinc-800/80 pb-3">
            <span class="w-8 h-8 rounded-xl bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center text-emerald-400 font-mono font-extrabold text-sm shadow">02</span>
            <div>
              <h2 class="text-lg sm:text-xl font-extrabold font-mono text-white tracking-wide">CIEDE2000 Color Accuracy &amp; Perceptual Contrast</h2>
              <p class="text-xs text-zinc-400 font-sans mt-0.5">ISO 9241-307 certified ΔE00 color perception error and W3C APCA ambient contrast analyzer.</p>
            </div>
          </div>

          <div class="space-y-6">
            <DeltaECalculatorInspector />
            <ApcaContrastInspector />
          </div>
        </section>

        <!-- SECTION 3: ICC Profile Exporter -->
        <section class="space-y-6">
          <div class="flex items-center gap-3 border-b border-zinc-800/80 pb-3">
            <span class="w-8 h-8 rounded-xl bg-cyan-500/10 border border-cyan-500/30 flex items-center justify-center text-cyan-400 font-mono font-extrabold text-sm shadow">03</span>
            <div>
              <h2 class="text-lg sm:text-xl font-extrabold font-mono text-white tracking-wide">Binary ICC v4.3 Profile Exporter</h2>
              <p class="text-xs text-zinc-400 font-sans mt-0.5">Download a binary OS color profile for Windows Color Management or macOS ColorSync.</p>
            </div>
          </div>

          <div class="relative bg-[#0c0d12]/95 border border-zinc-800/90 rounded-3xl p-6 sm:p-8 backdrop-blur-2xl shadow-[0_25px_60px_rgba(0,0,0,0.8)] space-y-6 font-mono text-zinc-100 min-w-0 overflow-hidden">
            <div class="absolute -top-24 -right-24 w-96 h-96 bg-cyan-500/10 rounded-full blur-3xl pointer-events-none"></div>

            <div class="relative z-10 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 border-b border-zinc-800/70 pb-4">
              <div>
                <div class="text-xs font-bold text-cyan-400 uppercase tracking-widest flex items-center gap-2">
                  <span class="w-2.5 h-2.5 rounded-full bg-cyan-400 animate-pulse shadow-[0_0_8px_rgba(34,211,238,0.9)]"></span>
                  <span>ICC v4.3 COLOR PROFILE GENERATOR</span>
                </div>
                <h3 class="text-xl sm:text-2xl font-extrabold font-mono text-white mt-1">Binary ICC Profile Exporter (.icc)</h3>
              </div>
              <button 
                id="btn-export-icc" 
                type="button" 
                class="px-5 py-3 rounded-2xl bg-cyan-500/20 border border-cyan-400/40 text-cyan-300 font-bold hover:bg-cyan-500/30 transition-all duration-200 cursor-pointer shadow-lg flex items-center gap-2 min-h-[44px]"
              >
                <svg class="w-4 h-4 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                </svg>
                <span>Export ICC v4.3 Profile (.icc)</span>
              </button>
            </div>

            <p class="relative z-10 text-xs sm:text-sm text-zinc-300 font-sans leading-relaxed">
              Generate a binary ICC v4.3 color profile for Windows Color Management or macOS ColorSync based on your panel's calibrated sRGB / DCI-P3 color gamut specs.
            </p>
          </div>
        </section>

        <!-- FAQ Section -->
        <FAQSection faqs={faqs} />
      </div>

      <!-- Right Modular Control & Telemetry Sidebar (lg:col-span-4) -->
      <div class="lg:col-span-4 space-y-6 sticky top-24 self-start min-w-0">
        <PaletteCard
          title="Macbeth 24 Swatches"
          subtitle="CIEDE2000 Target Reference"
          activeHex="#735244"
          swatches={[
            { id: 'skin', hex: '#735244', label: 'Dark Skin' },
            { id: 'light-skin', hex: '#C29682', label: 'Light Skin' },
            { id: 'blue-sky', hex: '#627A9D', label: 'Blue Sky' },
            { id: 'foliage', hex: '#576C43', label: 'Foliage' },
            { id: 'blue-flower', hex: '#8580B1', label: 'Blue Flower' },
            { id: 'bluish-green', hex: '#67BDAF', label: 'Blue Green' },
            { id: 'orange', hex: '#D67E2C', label: 'Orange' },
            { id: 'purplish-blue', hex: '#505BA6', label: 'Purple Blue' }
          ]}
        />

        <MetricCard
          title="Color Accuracy Readout"
          subtitle="CIEDE2000 ΔE00 Formula"
          badgeText="Macbeth 24"
          layout="grid"
          metrics={[
            { id: 'avgDelta', label: 'Average ΔE00', value: '0.84', unit: 'ΔE', status: 'pass' },
            { id: 'maxDelta', label: 'Max Delta-E (Blue)', value: '1.92', unit: 'ΔE', status: 'warn' }
          ]}
        />

        <PassportCard
          deviceModel="Standard Calibrated Monitor"
          healthIndex={98}
          exportIccEnabled={true}
          submitTelemetryEnabled={false}
        />

        <InfoCard
          title="Color Standards"
          subtitle="ISO 9241-307 & CIE 1931"
          badgeText="OSD Tips"
          osdTips={[
            "Target D65 (6500K) by adjusting R/G/B Gain controls in OSD.",
            "Ensure Gamma preset is set to 2.2 in your monitor settings.",
            "Verify dark gray step 1 is visible against true black to prevent crush."
          ]}
        />
      </div>

    </div>
  </div>
</Layout>

<script>
  import { IccExporter } from '../engine/IccExporter';

  function initIccExporterBtn() {
    const btn = document.getElementById('btn-export-icc');
    btn?.addEventListener('click', () => {
      try {
        const bytes = IccExporter.generateSrgbProfileBinary();
        const blob = new Blob([bytes], { type: 'application/vnd.iccprofile' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = 'DisplayTestOnline_sRGB_v43.icc';
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
      } catch (err) {
        console.error('ICC Export failed', err);
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initIccExporterBtn);
  } else {
    initIccExporterBtn();
  }
</script>
