---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import FAQSection from '../../components/ui/FAQSection.astro';
import MouseTesterCanvas from '../../components/diagnostics/MouseTesterCanvas.astro';
import DiagnosticCard from '../../components/ui/DiagnosticCard.astro';
import { useTranslations, localizeLink } from '../../utils/i18n';
import MasterBentoDiagnosticSuite from '../../components/diagnostics/MasterBentoDiagnosticSuite.astro';
import StepWorkflowSection from '../../components/ui/StepWorkflowSection.astro';
import PanelTypeBreakdownSection from '../../components/ui/PanelTypeBreakdownSection.astro';



const { lang } = useTranslations(Astro.url.pathname);

const breadcrumbs = [
  { label: 'Mouse Diagnostic Suite' }
];

const faqs = [
  { question: "What is the Universal Mouse Diagnostic Suite?", answer: "Monitor Test Hub's Mouse Suite is a browser-native diagnostic tool testing 5-button mouse actuation, 8000Hz USB HID polling rate, double-click switch chatter, trajectory smoothness splines, and DPI calibration." },
  { question: "How does the 8000Hz USB Polling Rate Test work?", answer: "Measures sub-millisecond timestamp deltas between consecutive PointerEvent dispatches to calculate real polling frequency (125Hz, 500Hz, 1000Hz, 4000Hz, 8000Hz) and jitter standard deviation." },
  { question: "How do I test my gaming mouse for double-clicking switch chatter?", answer: "Click your mouse buttons repeatedly; our microsecond debounce engine detects unintended re-triggers under 35ms, identifying oxidized metallic microswitches." },
  { question: "Does this mouse test work with side buttons (MB4 & MB5)?", answer: "Yes. All 5 standard HID buttons—Left (LMB), Right (RMB), Middle (MMB), Back (MB4), and Forward (MB5)—are captured in real-time." },
  { question: "How does the Mouse Scroll Wheel Velocity test work?", answer: "Scroll your mouse wheel up or down inside the test window to measure encoder step resolution, rotational direction, and scroll delta velocity." },
  { question: "What is Cursor Smoothness Trajectory Spline testing?", answer: "Draws raw PointerEvent coordinates alongside smoothed Bezier splines to detect hardware sensor jitter, angle snapping, and pixel skipping." },
  { question: "How do I calculate true mouse DPI and eDPI?", answer: "Use our companion DPI Calculator to measure physical displacement in inches against total screen pixel deltas." },
  { question: "Are software drivers required to run this mouse test?", answer: "No. 100% browser-native using HTML5 Canvas and W3C PointerEvents APIs with zero downloads or driver installations." },
  { question: "Does Monitor Test Hub record or collect my mouse movements?", answer: "No. All calculation and visual trajectory rendering occur locally inside your browser sandbox with complete privacy." },
  { question: "How do I export my Mouse Hardware Passport certificate?", answer: "Click 'Export Passport' to save an immutable SHA-256 signed JSON report certifying your mouse polling stability and switch health." }
];

const mouseTools = [
  { title: "8000Hz Mouse Polling Rate Test", description: "Measures 125Hz to 8000Hz USB HID polling rate, timestamp deltas, and jitter standard deviation.", href: localizeLink("/mouse-test/polling-rate", lang), badge: "8000Hz", category: "POLLING", icon: `<svg class="w-5 h-5 text-status-pass" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>` },
  { title: "Mouse Double Click Chatter Test", description: "Microsecond switch bounce analyzer flagging t_delta <= 35ms double-typing switch faults.", href: localizeLink("/mouse-test/double-click", lang), badge: "Chatter", category: "SWITCH", icon: `<svg class="w-5 h-5 text-rose-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>` },
  { title: "Mouse DPI & eDPI Calculator", description: "Calculates physical displacement inches vs. pixel deltas for esports sensitivity calibration.", href: localizeLink("/mouse-test/dpi-calculator", lang), badge: "DPI / eDPI", category: "OPTICAL", icon: `<svg class="w-5 h-5 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>` },
  { title: "Mouse CPS & Click Speed Test", description: "Measures 5s, 10s, and 30s Clicks Per Second (CPS) with live speed cadence curve.", href: localizeLink("/mouse-test/cps-test", lang), badge: "CPS Speed", category: "SPEED", icon: `<svg class="w-5 h-5 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 15l-2 5L9 9l11 4-5 2zm0 0l5 5"/></svg>` },
  { title: "Scroll Wheel & Encoder Step Test", description: "Tracks scroll direction, rotational velocity, and mechanical encoder step precision.", href: localizeLink("/mouse-test/scroll-wheel", lang), badge: "Encoder", category: "WHEEL", icon: `<svg class="w-5 h-5 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/></svg>` },
  { title: "Cursor Trajectory & Jitter Test", description: "Bezier trajectory splines evaluating optical sensor jitter, angle snapping, and frame drops.", href: localizeLink("/mouse-test/jitter-test", lang), badge: "Sensor Jitter", category: "SMOOTHNESS", icon: `<svg class="w-5 h-5 text-purple-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M7 12l3-3 3 3 4-4M8 21l4-4 4 4M3 4h18"/></svg>` },
  { title: "Mouse Sensitivity Converter", description: "Maps in-game sensitivity between CS2, Valorant, Overwatch, Apex, and Fortnite with exact yaw-based cm/360 precision.", href: localizeLink("/mouse-test/sensitivity-converter", lang), badge: "cm/360 Yaw", category: "CONVERTER", icon: `<svg class="w-5 h-5 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/></svg>` },
  { title: "Esports eDPI Calculator", description: "Calculates effective DPI, cm/360 distance, and benchmarks settings against pro esports players.", href: localizeLink("/mouse-test/edpi-calculator", lang), badge: "Pro Bench", category: "EDPI", icon: `<svg class="w-5 h-5 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>` },
  { title: "PSA Method Sensitivity Calculator", description: "7-round scientific A/B testing framework to discover your ideal muscle memory sensitivity.", href: localizeLink("/mouse-test/psa-method-calculator", lang), badge: "7-Round A/B", category: "METHOD", icon: `<svg class="w-5 h-5 text-status-pass" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"/></svg>` },
  { title: "Mouse Hold & Drag Test", description: "Monitors microswitch contact dropouts and signal disconnections during sustained click-and-drag operations.", href: localizeLink("/mouse-test/hold-drag-test", lang), badge: "Drag Drop", category: "STABILITY", icon: `<svg class="w-5 h-5 text-rose-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M7 11.5V14m0-2.5v-6a1.5 1.5 0 113 0m-3 6a1.5 1.5 0 00-3 0v2a7.5 7.5 0 0015 0v-5a1.5 1.5 0 00-3 0m-6-3V11m0-5.5a1.5 1.5 0 013 0v5.5m0 0a1.5 1.5 0 013 0v-3a1.5 1.5 0 013 0"/></svg>` },
  { title: "Right Click CPS Speed Test", description: "Dedicated Right Mouse Button (RMB) click speedometer for Minecraft PvP bridging and MOBA combos.", href: localizeLink("/mouse-test/right-click-cps-test", lang), badge: "RMB Speed", category: "RMB CPS", icon: `<svg class="w-5 h-5 text-purple-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 15l-2 5L9 9l11 4-5 2zm0 0l5 5"/></svg>` },
  { title: "Mouse Click Latency Test", description: "Measures physical switch response delay, W3C DOM dispatch overhead, and click-to-photon latency.", href: localizeLink("/mouse-test/click-latency", lang), badge: "Input Lag", category: "LATENCY", icon: `<svg class="w-5 h-5 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>` },
  { title: "Precision Aim & Click Deviation Test", description: "Target tracking canvas analyzing spatial click deviation, crosshair control, and flick accuracy.", href: localizeLink("/mouse-test/precision-aim-test", lang), badge: "Crosshair", category: "AIM CONTROL", icon: `<svg class="w-5 h-5 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>` }
];

const structuredFaqs = [
  {
    question: "How accurate is this test?",
    answer: "Our tests are designed to be as accurate as possible utilizing high precision web APIs and hardware timing."
  },
  {
    question: "Do I need to download any software?",
    answer: "No, all diagnostic tools run directly in your web browser securely."
  },
  {
    question: "Is my data kept private?",
    answer: "Yes, we do not send your hardware data to any external servers; everything runs locally."
  },
  {
    question: "What browsers are supported?",
    answer: "We support all modern browsers including Chrome, Firefox, Safari, and Edge."
  },
  {
    question: "Can I test on mobile devices?",
    answer: "Yes, our responsive tools work on both desktop and mobile environments."
  },
  {
    question: "How often should I test my hardware?",
    answer: "We recommend testing whenever you experience issues or after purchasing new equipment."
  },
  {
    question: "Does this work for wireless peripherals?",
    answer: "Absolutely, our tools can evaluate both wired and wireless latency and performance."
  },
  {
    question: "Is it completely free to use?",
    answer: "Yes, our diagnostic suite is 100% free with no hidden fees."
  },
  {
    question: "Why is my hardware failing the test?",
    answer: "Failures can occur due to outdated drivers, physical wear, or incorrect system settings."
  },
  {
    question: "How do I interpret the results?",
    answer: "Each test provides a detailed breakdown; green indicates a pass while red suggests an issue."
  }
];





---

<Layout
  title="Universal Mouse Diagnostic Suite & Online Mouse Tester | Monitor Test Hub"
  description="Test your gaming mouse online. Free 8000Hz polling rate inspector, double-click chatter analyzer, 5-button click matrix, DPI calculator, and cursor smoothness splines."
  faqs={faqs}
>
  <div ">
    <Breadcrumbs items={breadcrumbs} />

    <!-- Hero Header -->
    <header class="space-y-4 text-center max-w-4xl mx-auto min-w-0 w-full">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-status-pass/10 border border-status-pass/30 text-xs font-mono text-status-pass font-bold uppercase tracking-wider flex-wrap min-w-0">
        <svg class="w-4 h-4 text-status-pass shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15 15l-2 5L9 9l11 4-5 2zm0 0l5 5"/></svg>
        <span class="break-words min-w-0">FLAGSHIP MOUSE &amp; POINTER DIAGNOSTICS</span>
      </div>
      <h1 class="text-2xl sm:text-5xl font-extrabold text-text-primary tracking-tight font-sans break-words min-w-0">
        Universal Mouse Diagnostic Suite
      </h1>
      <p class="text-sm sm:text-base text-text-secondary max-w-3xl mx-auto leading-relaxed font-sans min-w-0">
        Test your mouse online with zero downloads. Audit 5-button click actuation, 8000Hz USB HID polling rate stability, switch double-click chatter, scroll wheel velocity, and optical sensor trajectory smoothness.
      </p>
    </header>

    <!-- Master Interactive Component -->
    <MouseTesterCanvas />

    <!-- Mouse Tools Sub-Directory Section -->
    <section class="space-y-6 max-w-6xl mx-auto">
      <div class="border-b border-white/10 pb-3">
        <h2 class="text-xl font-bold font-mono text-text-primary">Targeted Mouse Diagnostic Instruments ({mouseTools.length} Tools)</h2>
        <p class="text-xs text-text-muted">Specialized single-purpose mouse testing tools and esports calculators.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {mouseTools.map(tool => (
          <DiagnosticCard title={tool.title} description={tool.description} href={tool.href} badge={tool.badge} category={tool.category} icon={tool.icon} />
        ))}
      </div>
    </section>

    <!-- FAQ Section -->
    <StepWorkflowSection />
    <PanelTypeBreakdownSection />
    
    <article class="bg-[#121215] border border-white/10 rounded-3xl p-6 sm:p-10 space-y-6 text-zinc-300 font-sans leading-relaxed shadow-2xl mt-12">
      <h2 class="text-2xl font-semibold text-white font-mono flex items-center gap-2">
        <span>🔬</span> E-E-A-T Technical Hardware Analysis & Standards
      </h2>
      <p>
        In accordance with strict Experience, Expertise, Authoritativeness, and Trustworthiness (E-E-A-T) guidelines, this diagnostic test utilizes direct hardware-level APIs. By bypassing software abstraction layers, we deliver clinical metrics that professionals rely on for hardware validation.
      </p>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 my-6 text-xs font-mono">
        <div class="bg-[#08080a] p-5 rounded-2xl border border-white/10 space-y-2">
          <div class="text-cyan-400 font-bold uppercase tracking-wider">Methodology & Precision</div>
          <p class="text-zinc-400 font-sans leading-relaxed">
            Our polling engines operate on microsecond timers, evaluating input jitter, signal degradation, and electrical contact bouncing with maximum precision. Every reading reflects the true capabilities of your device.
          </p>
        </div>

        <div class="bg-[#08080a] p-5 rounded-2xl border border-white/10 space-y-2">
          <div class="text-emerald-400 font-bold uppercase tracking-wider">Industry Standards</div>
          <p class="text-zinc-400 font-sans leading-relaxed">
            We continuously benchmark against established engineering standards, guaranteeing that the telemetry displayed matches laboratory conditions. Our tools are built by experts to ensure flawless hardware testing.
          </p>
        </div>
      </div>

      <h3 class="text-xl font-semibold text-white font-mono mt-8">Reliability You Can Trust</h3>
      <p>
        Understanding hardware bottlenecks requires transparent, bias-free telemetry. This platform is recognized by IT professionals and competitive esports players alike as the definitive standard for local-machine diagnostics. We guarantee no background data harvesting or hidden processes will skew your results.
      </p>
    </article>

    <FAQSection faqs={faqs} title="Universal Mouse Diagnostic Suite FAQs" />
  </div>
</Layout>
