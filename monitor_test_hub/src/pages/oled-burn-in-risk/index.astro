---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import OledBurnInAnalyzer from '../../components/diagnostics/OledBurnInAnalyzer.astro';
import TestSwitcherBar from '../../components/ui/TestSwitcherBar.astro';

const breadcrumbItems = [
  { label: 'Display Suite', href: '/display-tests' },
  { label: 'OLED Burn-In Risk Analyzer' }
];

const displayTests = [
  { id: 'sub-pixel', label: 'Sub-Pixel Analyzer', href: '/display-tests/sub-pixel' },
  { id: 'uniformity', label: 'OLED Uniformity', href: '/display-tests/uniformity' },
  { id: 'vrr', label: 'VRR Sync Engine', href: '/display-tests/vrr' },
  { id: 'oled-burn-in', label: 'OLED Burn-In Risk', href: '/oled-burn-in-risk', active: true }
];

const presetProfiles = [
  { panel: 'qd-oled-v2', tier: 'moderate', title: 'QD-OLED Gen 2/3 (Moderate)', desc: 'Standard desktop office & gaming 3,500 hours risk evaluation.' },
  { panel: 'qd-oled', tier: 'heavy', title: 'QD-OLED Gen 1 (Heavy)', desc: 'First-gen QD-OLED panel with 7,500 hours of static element exposure.' },
  { panel: 'woled-meta', tier: 'light', title: 'WOLED META / MLA (Light)', desc: 'Micro Lens Array WOLED at 1,000 hours with minimal static elements.' },
  { panel: 'woled-meta', tier: 'heavy', title: 'WOLED META / MLA (Heavy)', desc: 'MLA WOLED operating under 7,500 hours of mixed media and static UI.' },
  { panel: 'amoled', tier: 'extreme', title: 'AMOLED Mobile (Extreme)', desc: 'Mobile/laptop AMOLED panel at 15,000 hours with high brightness static HUD.' },
  { panel: 'qd-oled-v2', tier: 'extreme', title: 'QD-OLED Gen 2/3 (Extreme)', desc: 'Heavy productivity & trading dashboard workload at 15,000 hours.' }
];
---

<Layout
  title="OLED Burn-In & Image Retention Risk Analyzer | Monitor Test Hub"
  description="Client-side OLED burn-in risk calculator and 5% near-black uniformity inspector for QD-OLED, WOLED, and AMOLED displays under ISO 9241-307 standards."
>
  <div class="max-w-7xl mx-auto px-4 py-8 space-y-10">
    <Breadcrumbs items={breadcrumbItems} />

    <header class="space-y-4 border-b border-border-hairline pb-6">
      <div class="flex items-center gap-2 text-status-pass text-xs font-mono font-bold uppercase tracking-wider">
        <span class="w-2.5 h-2.5 rounded-full bg-status-pass led-glow-pass"></span>
        HARDWARE LIFESPAN & UNIFORMITY DIAGNOSTIC
      </div>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-text-primary tracking-tight">
        Dynamic OLED Burn-In Risk Analyzer
      </h1>
      <p class="text-sm sm:text-base text-text-secondary max-w-3xl leading-relaxed">
        Inspect 5% near-black uniformity grid, simulate static UI overlays (Taskbar, HUD, News Ticker), and compute expected organic sub-pixel luminance degradation across QD-OLED Gen 1/2/3, WOLED META, and AMOLED architectures under ISO 9241-307 standards.
      </p>
    </header>

    <!-- Main Diagnostic Engine Component -->
    <OledBurnInAnalyzer />

    <!-- Specific Panel Tech & Usage Profiles Grid -->
    <section class="space-y-4 pt-4">
      <div class="flex items-center justify-between">
        <h2 class="text-lg font-bold text-text-primary font-mono uppercase tracking-wider">
          Standard Hardware Burn-In Risk Profiles
        </h2>
        <span class="text-xs text-text-muted font-mono">Dynamic Dynamic Route Matrices</span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {presetProfiles.map((p) => (
          <a
            href={`/oled-burn-in-risk/${p.panel}/${p.tier}`}
            class="group block bg-bg-surface border border-border-hairline hover:border-status-pass rounded-xl p-5 transition-all duration-200 shadow-specular-top focus:outline-none focus:ring-2 focus:ring-status-pass"
          >
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-mono font-bold text-status-pass uppercase">{p.panel}</span>
              <span class="text-[10px] font-mono text-text-muted bg-bg-canvas px-2 py-0.5 rounded border border-border-hairline uppercase">{p.tier}</span>
            </div>
            <h3 class="text-sm font-bold text-text-primary group-hover:text-status-pass transition-colors mb-1 font-mono">
              {p.title}
            </h3>
            <p class="text-xs text-text-secondary leading-relaxed">
              {p.desc}
            </p>
          </a>
        ))}
      </div>
    </section>

    <!-- Detailed ISO / Hardware Guidance Section -->
    <section class="bg-bg-surface border border-border-hairline rounded-xl p-6 space-y-6 font-mono">
      <h2 class="text-base font-bold text-text-primary uppercase tracking-wider border-b border-border-hairline pb-3">
        Understanding OLED Image Retention & Burn-In Degradation
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-xs text-text-secondary">
        <div class="space-y-2">
          <h3 class="font-bold text-text-primary uppercase text-xs">1. Differential Sub-Pixel Aging</h3>
          <p class="leading-relaxed">
            Organic Light Emitting Diodes decay exponentially based on drive current (nits) and operating time. When static UI elements like Windows taskbars or gaming HUDs remain fixed, red, green, and blue sub-pixels degrade unevenly, causing permanent ghost images.
          </p>
        </div>
        <div class="space-y-2">
          <h3 class="font-bold text-text-primary uppercase text-xs">2. Panel Generation Architecture</h3>
          <p class="leading-relaxed">
            Samsung QD-OLED Gen 2/3 and LG Display WOLED META (MLA) incorporate deuterium-stabilized organic compounds and heat sinks, reducing thermal decay by 30-45% compared to legacy Gen 1 QD-OLED or early WOLED panels.
          </p>
        </div>
        <div class="space-y-2">
          <h3 class="font-bold text-text-primary uppercase text-xs">3. Automated Refresh Routines</h3>
          <p class="leading-relaxed">
            Display controllers automatically execute short pixel refresh routines after 4 to 8 hours of cumulative operation when entering standby mode. Never disconnect wall power from your monitor during standby.
          </p>
        </div>
      </div>
    </section>

    <TestSwitcherBar tests={displayTests} currentId="oled-burn-in" />
  </div>
</Layout>
