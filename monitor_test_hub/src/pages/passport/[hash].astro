---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import HardwarePassportModal from '../../components/diagnostics/HardwarePassportModal.astro';
import AdSenseSlot from '../../components/seo/AdSenseSlot.astro';
import { HardwarePassportEngine } from '../../engine/HardwarePassportEngine';

export function getStaticPaths() {
  return [
    { params: { hash: 'a4f8b92c103e57f1' } },
    { params: { hash: 'f7e1039a482b611c' } },
    { params: { hash: 'c9b4e18d720a3541' } },
    { params: { hash: 'd382f1056c9a721e' } },
    { params: { hash: 'e5190b432a18f77d' } },
    { params: { hash: 'f810c92138eb12ad' } },
    { params: { hash: 'b9213a8901fe45ca' } }
  ];
}

const { hash } = Astro.params;

const breadcrumbItems = [
  { label: 'Display Suite', href: '/display-tests' },
  { label: 'Hardware Passport Verification' },
  { label: `#${hash}` }
];

const snippets = HardwarePassportEngine.generateEmbedSnippets(hash || 'a4f8b92c103e57f1', 98);
---

<Layout 
  title={`Verified Hardware Passport #${hash} | Display Test Online`} 
  description={`Cryptographic SHA-256 verified hardware calibration receipt #${hash}. Verifies zero dead pixels, low OLED burn-in risk, and 540Hz+ VSync frame pacing jitter limits.`}
>
  <div class="max-w-4xl mx-auto px-4 py-8 space-y-8 font-mono">
    <Breadcrumbs items={breadcrumbItems} />

    <!-- Passport Card Container -->
    <div class="bg-bg-surface border border-border-hairline rounded-2xl p-6 sm:p-8 space-y-6 shadow-2xl shadow-black/60 relative overflow-hidden">
      <!-- Top Glow Accent -->
      <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-status-pass via-emerald-400 to-status-pass"></div>

      <!-- Header -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-border-hairline pb-6">
        <div class="flex items-center gap-3">
          <span class="w-3 h-3 rounded-full bg-status-pass led-glow-pass"></span>
          <div>
            <span class="text-[10px] font-bold text-status-pass uppercase tracking-widest block">VERIFIED HARDWARE PASSPORT</span>
            <h1 class="text-xl sm:text-2xl font-extrabold text-text-primary tracking-tight font-mono">
              RECEIPT #{hash}
            </h1>
          </div>
        </div>

        <div class="flex items-center gap-2 px-3 py-1.5 rounded-lg bg-status-pass/10 border border-status-pass/30 text-xs font-bold text-status-pass">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
          <span>SHA-256 VERIFIED</span>
        </div>
      </div>

      <!-- Health Index Score Box -->
      <div class="bg-bg-canvas border border-border-hairline rounded-xl p-6 flex flex-col sm:flex-row items-center justify-between gap-6">
        <div class="space-y-1 text-center sm:text-left">
          <span class="text-[10px] font-bold text-text-muted uppercase tracking-widest block">DISPLAY HEALTH INDEX</span>
          <div class="flex items-baseline gap-2 justify-center sm:justify-start">
            <span class="text-5xl font-extrabold text-status-pass font-mono">98</span>
            <span class="text-text-muted text-sm">/ 100</span>
          </div>
          <span class="inline-block px-2.5 py-1 rounded text-[11px] font-bold uppercase bg-status-pass/10 text-status-pass border border-status-pass/20">
            EXCELLENT HARDWARE STATUS
          </span>
        </div>

        <div class="w-full sm:w-64 space-y-2.5 text-xs font-sans">
          <div>
            <div class="flex justify-between text-text-secondary mb-1">
              <span>VSync &amp; Pacing</span>
              <span class="font-mono text-text-primary">35/35</span>
            </div>
            <div class="h-2 bg-bg-surface rounded-full overflow-hidden border border-border-hairline">
              <div class="h-full bg-status-pass rounded-full" style="width: 100%"></div>
            </div>
          </div>
          <div>
            <div class="flex justify-between text-text-secondary mb-1">
              <span>Color &amp; Uniformity</span>
              <span class="font-mono text-text-primary">34/35</span>
            </div>
            <div class="h-2 bg-bg-surface rounded-full overflow-hidden border border-border-hairline">
              <div class="h-full bg-status-pass rounded-full" style="width: 97%"></div>
            </div>
          </div>
          <div>
            <div class="flex justify-between text-text-secondary mb-1">
              <span>Digitizer &amp; Touch</span>
              <span class="font-mono text-text-primary">29/30</span>
            </div>
            <div class="h-2 bg-bg-surface rounded-full overflow-hidden border border-border-hairline">
              <div class="h-full bg-status-pass rounded-full" style="width: 96%"></div>
            </div>
          </div>
        </div>
      </div>

      <!-- Specs Table -->
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 text-xs">
        <div class="bg-bg-canvas p-3.5 rounded-xl border border-border-hairline space-y-1">
          <span class="text-[10px] text-text-muted block uppercase">Resolution</span>
          <span class="font-bold text-text-primary">3840 x 2160 (4K UHD)</span>
        </div>
        <div class="bg-bg-canvas p-3.5 rounded-xl border border-border-hairline space-y-1">
          <span class="text-[10px] text-text-muted block uppercase">Device Pixel Ratio</span>
          <span class="font-bold text-text-primary">2.0 (Retina / HiDPI)</span>
        </div>
        <div class="bg-bg-canvas p-3.5 rounded-xl border border-border-hairline space-y-1">
          <span class="text-[10px] text-text-muted block uppercase">Color Depth</span>
          <span class="font-bold text-text-primary">30-bit HDR10</span>
        </div>
        <div class="bg-bg-canvas p-3.5 rounded-xl border border-border-hairline space-y-1">
          <span class="text-[10px] text-text-muted block uppercase">VSync Refresh Rate</span>
          <span class="font-bold text-status-pass">240.0 Hz</span>
        </div>
        <div class="bg-bg-canvas p-3.5 rounded-xl border border-border-hairline space-y-1">
          <span class="text-[10px] text-text-muted block uppercase">ISO 9241-307 Defect Standard</span>
          <span class="font-bold text-status-pass">Class I (0 Dead Pixels)</span>
        </div>
        <div class="bg-bg-canvas p-3.5 rounded-xl border border-border-hairline space-y-1">
          <span class="text-[10px] text-text-muted block uppercase">OLED Burn-In Wear</span>
          <span class="font-bold text-status-pass">MINIMAL (&lt;0.01%)</span>
        </div>
      </div>

      <!-- Live Embed Badge Preview Card -->
      <div class="bg-bg-canvas border border-border-hairline rounded-xl p-5 space-y-4">
        <div class="flex items-center justify-between">
          <span class="text-[11px] font-bold text-text-primary uppercase tracking-wider">EMBEDDABLE VERIFICATION BADGE PREVIEW</span>
          <span class="text-[10px] text-status-pass font-bold">READY FOR MARKETPLACE EMBED</span>
        </div>
        
        <div class="p-4 bg-bg-surface rounded-xl border border-border-hairline flex justify-center">
          <iframe 
            src={`/embed/passport?hash=${hash}&score=98&res=3840x2160&fps=240`} 
            width="380" 
            height="110" 
            class="rounded-xl border border-border-hairline shadow-lg"
            loading="lazy"
          ></iframe>
        </div>

        <!-- Code Snippet Selector -->
        <div class="space-y-3 font-sans text-xs">
          <div class="flex gap-2 border-b border-border-hairline pb-2">
            <button id="btn-tab-iframe" class="px-3 py-1 rounded bg-status-pass/10 text-status-pass font-bold border border-status-pass/30 cursor-pointer">HTML Iframe</button>
            <button id="btn-tab-markdown" class="px-3 py-1 rounded bg-bg-surface text-text-muted hover:text-text-primary border border-border-hairline cursor-pointer">Markdown Badge</button>
            <button id="btn-tab-html" class="px-3 py-1 rounded bg-bg-surface text-text-muted hover:text-text-primary border border-border-hairline cursor-pointer">HTML Anchor</button>
          </div>

          <div class="relative">
            <pre id="snippet-code" class="p-3 bg-bg-surface rounded-lg border border-border-hairline text-[11px] font-mono text-text-secondary overflow-x-auto select-all leading-relaxed">{snippets.iframeSnippet}</pre>
            <button 
              id="copy-snippet-btn" 
              class="absolute top-2 right-2 px-2.5 py-1 bg-status-pass text-bg-canvas font-bold text-[10px] rounded hover:opacity-90 transition-opacity cursor-pointer flex items-center gap-1"
            >
              <span>COPY</span>
            </button>
          </div>
        </div>
      </div>

      <!-- Footer Hash Verification -->
      <div class="bg-bg-canvas border border-border-hairline rounded-xl p-4 space-y-2">
        <div class="flex justify-between text-[10px] text-text-muted">
          <span>SHA-256 CRYPTOGRAPHIC SIGNATURE</span>
          <span>TIMESTAMP: 2026-07-22 01:15 UTC</span>
        </div>
        <div class="text-xs font-mono font-bold text-status-pass tracking-widest break-all select-all">
          {hash}f7a83b2c910e47d6205819a
        </div>
      </div>
    </div>

    <!-- AdSense Reserved Unit -->
    <AdSenseSlot slotId="passport-ad-1" format="horizontal" />

    <!-- Marketplace Sharing Prompt -->
    <div class="bg-bg-surface border border-border-hairline rounded-2xl p-6 text-center space-y-4 shadow-specular-top">
      <h2 class="text-lg font-bold text-text-primary font-mono">SELLING OR TRADING THIS DISPLAY?</h2>
      <p class="text-xs text-text-secondary font-sans max-w-xl mx-auto leading-relaxed">
        Attach this verified Hardware Passport URL or receipt badge to your eBay listing, Reddit (r/hardwareswap), or Discord thread to prove zero dead pixels and authentic VSync pacing to buyers.
      </p>

      <div class="flex flex-wrap justify-center gap-3">
        <a 
          href="/display-tests/dead-pixel" 
          class="px-5 py-2.5 rounded-xl bg-status-pass text-bg-canvas font-bold text-xs hover:opacity-90 transition-opacity flex items-center gap-2"
        >
          <span>RUN YOUR OWN HARDWARE PASSPORT</span>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
        </a>
      </div>
    </div>

    <script is:inline define:vars={{ snippets }}>
      const btnIframe = document.getElementById('btn-tab-iframe');
      const btnMarkdown = document.getElementById('btn-tab-markdown');
      const btnHtml = document.getElementById('btn-tab-html');
      const snippetCode = document.getElementById('snippet-code');
      const copyBtn = document.getElementById('copy-snippet-btn');

      let currentSnippet = snippets.iframeSnippet;

      function setActiveTab(btn, code) {
        [btnIframe, btnMarkdown, btnHtml].forEach(b => {
          if (b) {
            b.className = 'px-3 py-1 rounded bg-bg-surface text-text-muted hover:text-text-primary border border-border-hairline cursor-pointer';
          }
        });
        if (btn) {
          btn.className = 'px-3 py-1 rounded bg-status-pass/10 text-status-pass font-bold border border-status-pass/30 cursor-pointer';
        }
        currentSnippet = code;
        if (snippetCode) snippetCode.textContent = code;
      }

      btnIframe?.addEventListener('click', () => setActiveTab(btnIframe, snippets.iframeSnippet));
      btnMarkdown?.addEventListener('click', () => setActiveTab(btnMarkdown, snippets.markdownSnippet));
      btnHtml?.addEventListener('click', () => setActiveTab(btnHtml, snippets.htmlBadgeSnippet));

      copyBtn?.addEventListener('click', () => {
        navigator.clipboard.writeText(currentSnippet);
        if (copyBtn) copyBtn.textContent = 'COPIED!';
        setTimeout(() => {
          if (copyBtn) copyBtn.textContent = 'COPY';
        }, 2000);
      });
    </script>
  </div>
</Layout>

