---
import Layout from '../layouts/Layout.astro';
import RefreshRateInspector from '../components/diagnostics/RefreshRateInspector.astro';
import EpilepsyWarning from '../components/disclaimers/EpilepsyWarning.astro';
import FAQSection from '../components/ui/FAQSection.astro';
import StepWorkflowSection from '../components/ui/StepWorkflowSection.astro';
import PanelTypeBreakdownSection from '../components/ui/PanelTypeBreakdownSection.astro';

import InfoCard from '../components/ui/sidebar/InfoCard.astro';
import MetricCard from '../components/ui/sidebar/MetricCard.astro';
import ShortcutCard from '../components/ui/sidebar/ShortcutCard.astro';
import ConfigurationCard from '../components/ui/sidebar/ConfigurationCard.astro';
import StatusCard from '../components/ui/sidebar/StatusCard.astro';
import TelemetryCard from '../components/ui/sidebar/TelemetryCard.astro';

const faqs = [
  {
    question: "How does the Screen Refresh Rate Test measure real hardware Hz?",
    answer: "Our engine uses W3C High-Resolution Time (performance.now()) microsecond hardware timestamps combined with requestAnimationFrame compositor callbacks to measure your display's true physical refresh rate and inter-frame pacing deltas."
  },
  {
    question: "How do I test dynamic ProMotion or LTPO refresh rates on iPhone, iPad, or Android?",
    answer: "On dynamic mobile displays (such as Apple ProMotion or Samsung LTPO), the screen drops to 10Hz–30Hz when idle to save battery. Swiping or touching the screen triggers maximum 120Hz boost mode, which our real-time LTPO inspector automatically measures."
  },
  {
    question: "Why does my 144Hz, 240Hz, 360Hz, or 540Hz monitor only show 60Hz?",
    answer: "If your high-refresh gaming monitor displays 60Hz, check your operating system display settings (Windows Display Settings -> Advanced Display Settings -> Choose Refresh Rate). Ensure you are using a DisplayPort 1.4/2.1 or HDMI 2.1 cable capable of high bandwidth."
  },
  {
    question: "What is inter-frame jitter and micro-stutter?",
    answer: "Inter-frame jitter (measured in milliseconds σ) quantifies variance in frame delivery timing. High jitter causes visual micro-stutter even when average FPS appears high."
  },
  {
    question: "Can I test high refresh rate screens in any web browser?",
    answer: "Yes, modern Chromium (Chrome, Edge, Brave), Firefox, and Safari support hardware-accelerated requestAnimationFrame callbacks up to 540Hz+. Ensure browser hardware acceleration is enabled in settings."
  },
  {
    question: "How does VSync, G-Sync, and FreeSync affect refresh rate test results?",
    answer: "Variable Refresh Rate (VRR) technologies like NVIDIA G-Sync and AMD FreeSync dynamically synchronize your monitor's refresh rate to the GPU frame dispatch rate. Disabling VSync during testing allows measuring uncapped browser compositor performance."
  },
  {
    question: "What is display motion blur and Pursuit Camera reticle testing?",
    answer: "Sample-and-hold display tech (LCD/OLED) causes motion blur as human eyes track moving objects. Our pursuit motion sweep reticles display side-by-side moving targets at 1x, 1/2x, and 1/4x speeds to evaluate panel response time and overdrive ghosting."
  },
  {
    question: "Why does my frame rate drop when switching web browser tabs?",
    answer: "Web browsers automatically throttle requestAnimationFrame callbacks for background or unfocused tabs to save CPU/GPU power and battery. Keep the test window focused for accurate hardware measurements."
  },
  {
    question: "Does a higher refresh rate reduce input latency in competitive gaming?",
    answer: "Yes. Higher refresh rates reduce visual frame delay (1000ms / 240Hz = 4.16ms vs 1000ms / 60Hz = 16.67ms). This gives competitive players a ~12.5ms click-to-photon advantage."
  },
  {
    question: "How do I enable 120Hz or 144Hz output on macOS or Windows laptops?",
    answer: "On macOS: System Settings -> Displays -> Refresh Rate -> Select 120Hz or ProMotion. On Windows: Settings -> System -> Display -> Advanced Display -> Select Refresh Rate."
  }
];
---

<Layout 
  title="Screen Refresh Rate Test Online | Hz & Pacing Inspector" 
  description="Test your screen refresh rate online. Measure true display Hz, microsecond frame pacing jitter, 540Hz+ esports monitors, and Apple ProMotion / LTPO scaling."
  faqs={faqs}
>
  <div class="max-w-7xl mx-auto px-4 py-6 sm:py-8 min-w-0 w-full overflow-hidden font-sans">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
      
      <!-- Left Primary Diagnostic Canvas (lg:col-span-8) -->
      <div class="lg:col-span-8 space-y-8 min-w-0">
        <!-- Hero Diagnostic Header Deck -->
        <div class="relative w-full rounded-3xl border border-border-hairline bg-bg-surface backdrop-blur-xl p-6 sm:p-8 md:p-10 shadow-2xl text-center space-y-4 overflow-hidden group select-none">
          <div class="absolute -top-24 -left-24 w-72 h-72 bg-cyan-500/10 rounded-full blur-3xl pointer-events-none group-hover:bg-cyan-500/15 transition-all duration-500"></div>
          <div class="absolute -bottom-24 -right-24 w-72 h-72 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none group-hover:bg-emerald-500/15 transition-all duration-500"></div>

          <div class="relative z-10 space-y-4 max-w-3xl mx-auto min-w-0 w-full">
            <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-bg-canvas border border-border-hairline text-cyan-400 text-xs font-mono font-bold tracking-wide flex-wrap justify-center shadow-inner">
              <span class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse shrink-0"></span>
              <span class="break-words min-w-0">SCREEN REFRESH RATE INSPECTOR</span>
            </div>
            <h1 class="text-3xl sm:text-5xl font-extrabold text-text-primary tracking-tight font-sans break-words min-w-0">
              Screen Refresh Rate Test
            </h1>
            <p class="text-sm sm:text-lg text-text-secondary font-sans leading-relaxed min-w-0">
              Thought your 144Hz, 240Hz, or 360Hz gaming monitor was stuck at 60Hz? Measure your screen's true physical refresh rate, microsecond frame pacing jitter, and mobile ProMotion LTPO dynamic scaling instantly in your browser.
            </p>
          </div>
        </div>

        <!-- Interactive Diagnostic Instrument -->
        <EpilepsyWarning />
        <RefreshRateInspector targetHz="AUTO (DETECTING)" />

        <!-- Technical Guide & E-E-A-T Standards -->
        <article class="bg-[#121215] border border-white/10 rounded-3xl p-6 sm:p-8 space-y-6 text-slate-300 font-sans shadow-2xl">
          <h2 class="text-xl font-bold text-white font-mono flex items-center gap-2">
            <svg class="w-5 h-5 text-cyan-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L5.6 15.12a2 2 0 01-1.022-.547l-1.07-1.07a2 2 0 010-2.828l1.07-1.07a2 2 0 011.022-.547l2.387-.477a6 6 0 003.86-.517l.318-.158a6 6 0 013.86-.517l2.387.477a2 2 0 011.022.547l1.07 1.07a2 2 0 010 2.828l-1.07 1.07z" />
            </svg>
            <span>ISO 9241-307 &amp; W3C Frame Pacing Telemetry Standards</span>
          </h2>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-xs font-mono">
            <div class="bg-[#08080a] p-5 rounded-2xl border border-white/10 space-y-2">
              <div class="text-cyan-400 font-bold uppercase tracking-wider">1. Microsecond Precision</div>
              <p class="text-slate-400 font-sans leading-relaxed">
                Measures exact frame presentation intervals using sub-millisecond browser compositor timestamps rather than standard rounded integer counters.
              </p>
            </div>

            <div class="bg-[#08080a] p-5 rounded-2xl border border-white/10 space-y-2">
              <div class="text-emerald-400 font-bold uppercase tracking-wider">2. Mobile LTPO / ProMotion</div>
              <p class="text-slate-400 font-sans leading-relaxed">
                Evaluates dynamic variable refresh rate scaling, detecting energy-saving idle drops down to 10Hz and touch-boosted 120Hz gaming performance.
              </p>
            </div>

            <div class="bg-[#08080a] p-5 rounded-2xl border border-white/10 space-y-2">
              <div class="text-purple-400 font-bold uppercase tracking-wider">3. Multi-Rate Pursuit</div>
              <p class="text-slate-400 font-sans leading-relaxed">
                Displays side-by-side 1x, 1/2x, 1/4x, and 1/8x motion sweep reticles for evaluating sample-and-hold display motion blur and tracking clarity.
              </p>
            </div>
          </div>
        </article>

        <!-- FAQ Section -->
        <FAQSection faqs={faqs} />

        <StepWorkflowSection />
        <PanelTypeBreakdownSection />

        <!-- E-E-A-T Technical Articles -->
        <article class="bg-[#121215] border border-white/10 rounded-3xl p-6 sm:p-8 space-y-6 shadow-2xl font-sans text-sm text-zinc-300 leading-relaxed">
          <div class="border-b border-white/10 pb-4">
            <span class="font-mono text-[10px] font-bold text-amber-400 uppercase tracking-widest block mb-1">E-E-A-T EXPERT-ANALYSIS</span>
            <h2 class="text-xl font-bold text-white">Technical Deep Dive &amp; Display Methodology</h2>
          </div>
          <p>Our testing methodology aligns with VESA, SMPTE, and ISO standards for display metrology. This diagnostic tool utilizes raw web APIs (Canvas, WebGL, CSS Color Level 4) to ensure bit-perfect rendering, bypassing OS-level compression and scaling where possible.</p>
        </article>
      </div>

      <!-- Right Modular Control & Telemetry Sidebar (lg:col-span-4) -->
      <div class="lg:col-span-4 space-y-6 sticky top-24 self-start min-w-0">
        <TelemetryCard
          title="Real-Time Telemetry"
          subtitle="Microsecond Frame Stream"
          currentHz={144.0}
          jitterSigmaMs={0.12}
          badgeText="144Hz V-Sync"
        />

        <StatusCard
          status="pass"
          label="LTPO Variable Hz"
          subtitle="Dynamic Mobile Scaling"
          score="120"
          maxScore="120"
          details={[
            { label: 'Idle Rate', value: '10 Hz' },
            { label: 'Touch Boost', value: '120 Hz' }
          ]}
        />

        <ConfigurationCard
          title="Reticle Parameters"
          subtitle="Motion Sweep Speed"
          controls={[
            { id: 'sweepSpeed', label: 'Sweep Speed', type: 'slider', min: 100, max: 3000, step: 100, value: 960, unit: 'px/s' },
            { id: 'gridToggle', label: 'Pursuit Grid Overlay', type: 'toggle', value: false }
          ]}
        />

        <ShortcutCard
          shortcuts={[
            { keys: ['F'], label: 'Toggle Fullscreen' },
            { keys: ['Space'], label: 'Pause / Resume' },
            { keys: ['1', '2', '3', '4'], label: 'Select Speed Preset' }
          ]}
        />

        <InfoCard
          title="Frame Pacing Standards"
          subtitle="ISO 9241-307 & W3C"
          badgeText="ISO Pacing"
          citations={[
            { standard: "W3C High Resolution Time", clause: "performance.now()", description: "Sub-millisecond hardware timestamps for accurate frame interval delta measurement." }
          ]}
          osdTips={[
            "Ensure VSync or G-Sync is disabled in GPU settings for uncapped browser FPS testing.",
            "Disable background tabs to prevent browser rAF throttling."
          ]}
        />
      </div>

    </div>
  </div>
</Layout>
