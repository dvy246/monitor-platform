---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/ui/Breadcrumbs.astro';
import SEOHead from '../components/seo/SEOHead.astro';
import AudioTesterCanvas from '../components/diagnostics/AudioTesterCanvas.astro';
import StepWorkflowSection from '../components/ui/StepWorkflowSection.astro';
import PanelTypeBreakdownSection from '../components/ui/PanelTypeBreakdownSection.astro';
import FAQSection from '../components/ui/FAQSection.astro';

const title = "Sound & Speaker Test - Free Online Audio Diagnostic Suite";
const description = "Free online Sound & Speaker Test. Test left/right speaker balance, 20Hz-20kHz frequency sweeps, microphone noise floor, and speaker water eject pulses.";

const faqs = [
  {
    question: "How do I test if my left and right speakers are working properly?",
    answer: "Click the 'Test Left Speaker' and 'Test Right Speaker' buttons in our Audio Diagnostic Suite. You should hear a clear 1kHz sine wave sound coming exclusively from the left ear/channel, then exclusively from the right ear/channel. If sound comes from both or the wrong side, your audio channels are reversed or set to mono playback."
  },
  {
    question: "How do I eject water from my phone speaker?",
    answer: "If your smartphone speaker sounds muffled after being exposed to liquid, launch our Water Eject Sound tool under specialized tools. It emits a 165Hz low-frequency kinetic pressure wave that creates physical air vibrations to dislodge water droplets from phone speaker grills."
  },
  {
    question: "What is speaker frequency response and why sweep from 20Hz to 20kHz?",
    answer: "Human hearing ranges from roughly 20Hz (deep sub-bass) to 20,000Hz (high treble). Running a logarithmic 20Hz–20kHz frequency sweep tests if your speakers or headphones can accurately reproduce all audible frequencies without cabinet rattle, distortion, or dead frequency ranges."
  },
  {
    question: "How do I test my microphone for background static noise?",
    answer: "Use our Microphone Verification Engine or Decibel Meter tool. Speak into your microphone to record ambient room noise level in quiet conditions, then test active speech levels. High background noise indicates a low signal-to-noise ratio (SNR) or gain staging issues."
  },
  {
    question: "What causes speaker crackling or distortion?",
    answer: "Speaker crackling is usually caused by physical voice coil damage (blown speaker cone), dust build-up, loose audio cables, or digital audio buffer underruns. Use our Speaker Crackling Test to pinpoint mechanical distortion vs software buffer issues."
  },
  {
    question: "Can I test surround sound (5.1 / 7.1) using this online sound test?",
    answer: "Yes! Our Surround Sound Test routes distinct channel audio signals across multi-channel audio interfaces to test spatial positioning in 5.1 and 7.1 speaker systems."
  }
];

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Sound Test', href: '/sound-test' }
];
---

<Layout title={title} description={description} faqs={faqs}>
  <SEOHead slot="head" title={title} description={description} />
  
  <div class="max-w-7xl mx-auto px-4 py-6 sm:py-8 min-w-0 w-full overflow-hidden font-sans space-y-12">
    <Breadcrumbs items={breadcrumbs} />

    <!-- Hero Diagnostic Header Deck -->
    <header class="relative w-full rounded-3xl border border-white/10 bg-[#121215] backdrop-blur-xl p-6 sm:p-8 md:p-10 shadow-2xl text-center space-y-4 overflow-hidden group select-none">
      <div class="absolute -top-24 -left-24 w-96 h-96 bg-cyan-500/10 rounded-full blur-3xl pointer-events-none group-hover:bg-cyan-500/20 transition-all duration-700"></div>
      <div class="absolute -bottom-24 -right-24 w-96 h-96 bg-indigo-500/10 rounded-full blur-3xl pointer-events-none group-hover:bg-indigo-500/20 transition-all duration-700"></div>

      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/30 text-xs font-mono text-cyan-400 font-bold uppercase tracking-wider flex-wrap min-w-0 justify-center">
        <span class="w-2 h-2 rounded-full bg-cyan-400 shadow-[0_0_8px_rgba(34,211,238,0.9)] animate-pulse"></span>
        <span class="break-words min-w-0">WEB AUDIO 64-BIT DSP SYNTHESIZER</span>
      </div>

      <h1 class="text-2xl sm:text-5xl font-extrabold text-white tracking-tight font-sans break-words min-w-0">
        Sound &amp; Speaker Test
      </h1>
      <p class="text-sm sm:text-base text-zinc-400 max-w-3xl mx-auto leading-relaxed font-sans min-w-0">
        Professional web-native audio diagnostic suite for testing left/right speaker balance, frequency sweeps (20Hz–20kHz), microphone noise levels, and speaker water eject pulses.
      </p>
    </header>

    <!-- Master Interactive Component (Full Width 12 Columns) -->
    <AudioTesterCanvas />

    <!-- Specialized Sound & Audio Diagnostic Instruments Section -->
    <section class="space-y-6 pt-4">
      <div class="border-b border-white/10 pb-4 flex items-center justify-between">
        <div>
          <h2 class="text-xl sm:text-2xl font-bold font-mono text-white">Specialized Sound &amp; Audio Instruments (14 Tools)</h2>
          <p class="text-xs text-zinc-400 mt-1">Direct-access single-purpose Web Audio API diagnostic suites for headphones, speakers, and microphones.</p>
        </div>
        <span class="text-xs font-mono text-cyan-400 font-bold bg-cyan-500/10 border border-cyan-500/30 px-3 py-1 rounded-full">Web Audio API</span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        <a href="/sound-test/tone-generator" class="p-5 rounded-2xl border border-white/10 bg-[#121215]/90 hover:border-cyan-500/40 hover:bg-cyan-500/5 transition-all group space-y-2">
          <div class="flex items-center justify-between">
            <span class="px-2.5 py-0.5 rounded bg-cyan-500/20 text-cyan-400 text-[10px] font-mono font-bold border border-cyan-500/30">64-BIT SYNTH</span>
            <span class="text-xs text-zinc-400 group-hover:text-white font-mono">Open Tool &rarr;</span>
          </div>
          <h3 class="text-lg font-bold text-white group-hover:text-cyan-400 transition-colors">Tone Generator</h3>
          <p class="text-xs text-zinc-400 leading-relaxed">Web Audio 64-bit pure frequency sound maker (1Hz to 20kHz) with oscilloscope.</p>
        </a>

        <a href="/sound-test/water-eject" class="p-5 rounded-2xl border border-cyan-500/30 bg-[#121215]/90 hover:border-cyan-400 hover:bg-cyan-500/10 transition-all group space-y-2">
          <div class="flex items-center justify-between">
            <span class="px-2.5 py-0.5 rounded bg-cyan-500/20 text-cyan-400 text-[10px] font-mono font-bold border border-cyan-500/30">165Hz PRESSURE PULSE</span>
            <span class="text-xs text-cyan-400 group-hover:text-white font-mono font-bold">Open Tool &rarr;</span>
          </div>
          <h3 class="text-lg font-bold text-white group-hover:text-cyan-400 transition-colors">Water Eject Sound Tool</h3>
          <p class="text-xs text-zinc-400 leading-relaxed">Fix muffled speaker sound on iPhone &amp; Android phones using 165Hz kinetic water ejection pulses.</p>
        </a>

        <a href="/sound-test/earpiece-cleaner" class="p-5 rounded-2xl border border-emerald-500/30 bg-[#121215]/90 hover:border-emerald-400 hover:bg-emerald-500/10 transition-all group space-y-2">
          <div class="flex items-center justify-between">
            <span class="px-2.5 py-0.5 rounded bg-emerald-500/20 text-emerald-400 text-[10px] font-mono font-bold border border-emerald-500/30">250Hz - 600Hz SWEEP</span>
            <span class="text-xs text-emerald-400 group-hover:text-white font-mono font-bold">Open Tool &rarr;</span>
          </div>
          <h3 class="text-lg font-bold text-white group-hover:text-emerald-400 transition-colors">Phone Earpiece Cleaner</h3>
          <p class="text-xs text-zinc-400 leading-relaxed">Specialized high-pass frequency sweep for delicate top call receivers and earpieces.</p>
        </a>

        <a href="/sound-test/mic-verification" class="p-5 rounded-2xl border border-purple-500/30 bg-[#121215]/90 hover:border-purple-400 hover:bg-purple-500/10 transition-all group space-y-2">
          <div class="flex items-center justify-between">
            <span class="px-2.5 py-0.5 rounded bg-purple-500/20 text-purple-400 text-[10px] font-mono font-bold border border-purple-500/30">3-STEP DECIBEL GAIN</span>
            <span class="text-xs text-purple-400 group-hover:text-white font-mono font-bold">Open Tool &rarr;</span>
          </div>
          <h3 class="text-lg font-bold text-white group-hover:text-purple-400 transition-colors">Microphone Verification Engine</h3>
          <p class="text-xs text-zinc-400 leading-relaxed">Evaluate real-time dB gain boost and static floor levels across 3 quiet &amp; speech phases.</p>
        </a>

        <a href="/sound-test/speaker-test" class="p-5 rounded-2xl border border-white/10 bg-[#121215]/90 hover:border-cyan-500/40 hover:bg-cyan-500/5 transition-all group space-y-2">
          <div class="flex items-center justify-between">
            <span class="px-2.5 py-0.5 rounded bg-cyan-500/20 text-cyan-400 text-[10px] font-mono border border-cyan-500/30">STEREO L/R</span>
            <span class="text-xs text-zinc-400 group-hover:text-white font-mono">Open Tool &rarr;</span>
          </div>
          <h3 class="text-lg font-bold text-white group-hover:text-cyan-400 transition-colors">Speaker Test Online</h3>
          <p class="text-xs text-zinc-400 leading-relaxed">Audit Left and Right speaker channel separation, balance, and volume levels.</p>
        </a>

        <a href="/sound-test/headphone-test" class="p-5 rounded-2xl border border-white/10 bg-[#121215]/90 hover:border-indigo-500/40 hover:bg-indigo-500/5 transition-all group space-y-2">
          <div class="flex items-center justify-between">
            <span class="px-2.5 py-0.5 rounded bg-indigo-500/20 text-indigo-400 text-[10px] font-mono font-bold border border-indigo-500/30">BINAURAL 3D</span>
            <span class="text-xs text-zinc-400 group-hover:text-white font-mono">Open Tool &rarr;</span>
          </div>
          <h3 class="text-lg font-bold text-white group-hover:text-indigo-400 transition-colors">Headphone Test Suite</h3>
          <p class="text-xs text-zinc-400 leading-relaxed">Check stereo imaging, driver matching, bass extension, and high-frequency limits.</p>
        </a>

        <a href="/sound-test/speaker-crackle-test" class="p-5 rounded-2xl border border-amber-500/30 bg-[#121215]/90 hover:border-amber-500 hover:bg-amber-500/10 transition-all group space-y-2">
          <div class="flex items-center justify-between">
            <span class="px-2.5 py-0.5 rounded bg-amber-500/20 text-amber-400 text-[10px] font-mono font-bold border border-amber-500/30">DISTORTION CHECK</span>
            <span class="text-xs text-amber-400 group-hover:text-white font-mono font-bold">Open Tool &rarr;</span>
          </div>
          <h3 class="text-lg font-bold text-white group-hover:text-amber-400 transition-colors">Speaker Crackling Test</h3>
          <p class="text-xs text-zinc-400 leading-relaxed">Diagnose mechanical buzzing, physical distortion, and blown speaker cones using triangle sweeps.</p>
        </a>

        <a href="/sound-test/speaker-test-music" class="p-5 rounded-2xl border border-indigo-500/30 bg-[#121215]/90 hover:border-indigo-500 hover:bg-indigo-500/10 transition-all group space-y-2">
          <div class="flex items-center justify-between">
            <span class="px-2.5 py-0.5 rounded bg-indigo-500/20 text-indigo-400 text-[10px] font-mono font-bold border border-indigo-500/30">HIGH-RES SAMPLES</span>
            <span class="text-xs text-indigo-400 group-hover:text-white font-mono font-bold">Open Tool &rarr;</span>
          </div>
          <h3 class="text-lg font-bold text-white group-hover:text-indigo-400 transition-colors">Test Music Samples</h3>
          <p class="text-xs text-zinc-400 leading-relaxed">High-resolution audio samples to evaluate dynamic range, sub-bass, and soundstage.</p>
        </a>

        <a href="/sound-test/decibel-meter" class="p-5 rounded-2xl border border-white/10 bg-[#121215]/90 hover:border-emerald-500/40 hover:bg-emerald-500/5 transition-all group space-y-2">
          <div class="flex items-center justify-between">
            <span class="px-2.5 py-0.5 rounded bg-emerald-500/20 text-emerald-400 text-[10px] font-mono font-bold border border-emerald-500/30">REAL-TIME dB</span>
            <span class="text-xs text-zinc-400 group-hover:text-white font-mono">Open Tool &rarr;</span>
          </div>
          <h3 class="text-lg font-bold text-white group-hover:text-emerald-400 transition-colors">Decibel Meter</h3>
          <p class="text-xs text-zinc-400 leading-relaxed">Measure ambient room noise and microphone sound levels in real-time dBA SPL with peak hold.</p>
        </a>

        <a href="/sound-test/audio-latency" class="p-5 rounded-2xl border border-white/10 bg-[#121215]/90 hover:border-rose-500/40 hover:bg-rose-500/5 transition-all group space-y-2">
          <div class="flex items-center justify-between">
            <span class="px-2.5 py-0.5 rounded bg-rose-500/20 text-rose-400 text-[10px] font-mono font-bold border border-rose-500/30">ms-ACCURATE</span>
            <span class="text-xs text-zinc-400 group-hover:text-white font-mono">Open Tool &rarr;</span>
          </div>
          <h3 class="text-lg font-bold text-white group-hover:text-rose-400 transition-colors">Audio Latency Test</h3>
          <p class="text-xs text-zinc-400 leading-relaxed">Measure Bluetooth and wireless headphone delay in milliseconds using reaction or tap-on-beat.</p>
        </a>

        <a href="/sound-test/bass-test" class="p-5 rounded-2xl border border-white/10 bg-[#121215]/90 hover:border-amber-500/40 hover:bg-amber-500/5 transition-all group space-y-2">
          <div class="flex items-center justify-between">
            <span class="px-2.5 py-0.5 rounded bg-amber-500/20 text-amber-400 text-[10px] font-mono font-bold border border-amber-500/30">20Hz - 150Hz</span>
            <span class="text-xs text-zinc-400 group-hover:text-white font-mono">Open Tool &rarr;</span>
          </div>
          <h3 class="text-lg font-bold text-white group-hover:text-amber-400 transition-colors">Subwoofer Bass Test</h3>
          <p class="text-xs text-zinc-400 leading-relaxed">Hit deep low frequencies from 20Hz to 150Hz to check subwoofer extension and cabinet rattle.</p>
        </a>

        <a href="/sound-test/surround-sound" class="p-5 rounded-2xl border border-white/10 bg-[#121215]/90 hover:border-purple-500/40 hover:bg-purple-500/5 transition-all group space-y-2">
          <div class="flex items-center justify-between">
            <span class="px-2.5 py-0.5 rounded bg-purple-500/20 text-purple-400 text-[10px] font-mono font-bold border border-purple-500/30">3D SPATIAL AUDIO</span>
            <span class="text-xs text-zinc-400 group-hover:text-white font-mono">Open Tool &rarr;</span>
          </div>
          <h3 class="text-lg font-bold text-white group-hover:text-purple-400 transition-colors">Surround Sound Test</h3>
          <p class="text-xs text-zinc-400 leading-relaxed">Hear virtual 3D positioning to validate spatial audio, HRTF, and 5.1 / 7.1 surround speaker setups.</p>
        </a>

        <a href="/sound-test/spectrum-analyzer" class="p-5 rounded-2xl border border-white/10 bg-[#121215]/90 hover:border-cyan-500/40 hover:bg-cyan-500/5 transition-all group space-y-2">
          <div class="flex items-center justify-between">
            <span class="px-2.5 py-0.5 rounded bg-cyan-500/20 text-cyan-400 text-[10px] font-mono font-bold border border-cyan-500/30">FFT 2048</span>
            <span class="text-xs text-zinc-400 group-hover:text-white font-mono">Open Tool &rarr;</span>
          </div>
          <h3 class="text-lg font-bold text-white group-hover:text-cyan-400 transition-colors">Spectrum Analyzer</h3>
          <p class="text-xs text-zinc-400 leading-relaxed">Real-time FFT frequency visualizer with 128-band bars, oscilloscope waveform, and spectrogram modes.</p>
        </a>

        <a href="/sound-test/microphone-test" class="p-5 rounded-2xl border border-white/10 bg-[#121215]/90 hover:border-emerald-500/40 hover:bg-emerald-500/5 transition-all group space-y-2">
          <div class="flex items-center justify-between">
            <span class="px-2.5 py-0.5 rounded bg-emerald-500/20 text-emerald-400 text-[10px] font-mono font-bold border border-emerald-500/30">PLAYBACK LOOP</span>
            <span class="text-xs text-zinc-400 group-hover:text-white font-mono">Open Tool &rarr;</span>
          </div>
          <h3 class="text-lg font-bold text-white group-hover:text-emerald-400 transition-colors">Microphone Test Online</h3>
          <p class="text-xs text-zinc-400 leading-relaxed">Live decibel meter (dBFS), waveform analyzer, and 3-second instant voice loopback playback.</p>
        </a>
      </div>
    </section>

    <!-- Technical Hardware Standards Article -->
    <article class="bg-[#121215] border border-white/10 rounded-3xl p-6 sm:p-10 space-y-6 text-zinc-300 font-sans leading-relaxed shadow-2xl">
      <h2 class="text-2xl font-semibold text-white font-mono flex items-center gap-2">
        <svg class="w-6 h-6 text-cyan-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z" />
        </svg>
        <span>Technical Audio Analysis &amp; Engineering Standards</span>
      </h2>
      <p>
        Ensuring high-fidelity audio reproduction requires more than just listening to your favorite track. It demands clinical, uncompressed test signals generated by precision mathematical algorithms. Our suite leverages the modern Web Audio API to bypass typical browser compression, delivering pure sine waves, white noise, and exact channel routing directly to your DAC.
      </p>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 my-6 text-xs font-mono">
        <div class="bg-[#08080a] p-5 rounded-2xl border border-white/10 space-y-2">
          <div class="text-cyan-400 font-bold uppercase tracking-wider">L/R Channel &amp; Phase Alignment</div>
          <p class="text-zinc-400 font-sans leading-relaxed">
            Accurate stereo imaging is the foundation of high-quality audio. Our L/R separation tests ensure that no crosstalk bleeds between your channels, vital for competitive gaming audio cues and spatial mixing.
          </p>
        </div>

        <div class="bg-[#08080a] p-5 rounded-2xl border border-white/10 space-y-2">
          <div class="text-emerald-400 font-bold uppercase tracking-wider">AES17 &amp; 20Hz-20kHz Sweeps</div>
          <p class="text-zinc-400 font-sans leading-relaxed">
            Continuous logarithmic sweeps from 20Hz (human sub-bass limit) to 20kHz allow mapping frequency response curves for headphones and studio monitors.
          </p>
        </div>
      </div>
    </article>

    <!-- FAQ Section -->
    <StepWorkflowSection />
    <PanelTypeBreakdownSection />
    <FAQSection faqs={faqs} title="Sound &amp; Speaker Test FAQs" />
  </div>
</Layout>
