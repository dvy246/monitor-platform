---
import Layout from '../../layouts/Layout.astro';
import AudioTesterCanvas from '../../components/diagnostics/AudioTesterCanvas.astro';
import FAQSection from '../../components/ui/FAQSection.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import StepWorkflowSection from '../../components/ui/StepWorkflowSection.astro';
import PanelTypeBreakdownSection from '../../components/ui/PanelTypeBreakdownSection.astro';

import StatusCard from '../../components/ui/sidebar/StatusCard.astro';
import MetricCard from '../../components/ui/sidebar/MetricCard.astro';
import ConfigurationCard from '../../components/ui/sidebar/ConfigurationCard.astro';
import InspectorCard from '../../components/ui/sidebar/InspectorCard.astro';
import ShortcutCard from '../../components/ui/sidebar/ShortcutCard.astro';

const title = "Microphone Test & Level Inspector";
const description = "Test microphone audio input quality online. Measure voice input levels, peak clipping distortion, ambient noise floor, and speech clarity.";

const faqs = [
  {
    question: "How does the online Microphone Test analyze audio input?",
    answer: "Our tool requests temporary microphone access via HTML5 navigator.mediaDevices.getUserMedia() and processes incoming PCM audio samples using Web Audio API AudioWorklet nodes."
  },
  {
    question: "Is my microphone audio recorded or transmitted to external servers?",
    answer: "No. All audio signal analysis executes 100% locally in your web browser RAM. Zero audio files or voice recordings are uploaded."
  },
  {
    question: "What is an ideal microphone gain level for clear voice calls?",
    answer: "Peak speech levels should hover between -18dBFS and -6dBFS. If levels hit 0dBFS, digital clipping distortion occurs."
  },
  {
    question: "What causes background static hiss or hum in microphone recordings?",
    answer: "Static hum is caused by ungrounded USB ports, cheap motherboard audio preamps, unshielded cables, or excessive digital gain boost (+30dB)."
  },
  {
    question: "What is the difference between condenser and dynamic microphones?",
    answer: "Condenser microphones use an ultra-thin charged diaphragm, capturing high vocal detail and wide frequency response. Dynamic microphones use a rugged moving coil, making them ideal for noisy environments."
  },
  {
    question: "How does microphone polar pattern (Cardioid vs Omnidirectional) affect noise?",
    answer: "Cardioid microphones pick up sound exclusively from the front while rejecting rear room noise. Omnidirectional microphones capture sound equally from all 360° angles."
  },
  {
    question: "Why is my microphone volume quiet even at 100% OS gain?",
    answer: "Quiet audio can be caused by low preamp gain on high-impedance dynamic mics (such as the Shure SM7B), requiring an inline pre-preamp like a Cloudlifter or audio interface upgrade."
  },
  {
    question: "How do pop filters prevent plosive 'P' and 'B' distortion?",
    answer: "Pop filters diffuse high-velocity bursts of air emitted by human lips during spoken plosives before the air hits the sensitive microphone diaphragm."
  },
  {
    question: "Can Bluetooth headset microphones achieve high-fidelity 48kHz recording?",
    answer: "Standard Bluetooth Hands-Free Profile (HFP) compresses microphone audio to 8kHz or 16kHz mono. USB wired or 2.4GHz wireless mics are required for full 48kHz uncompressed audio."
  },
  {
    question: "How do I fix microphone echo during video conference calls?",
    answer: "Echo happens when speaker audio bleeds back into an open mic. Wear headphones or enable OS Acoustic Echo Cancellation (AEC)."
  }
];

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Sound Test', href: '/sound-test' },
  { label: title, href: '#' }
];
---

<Layout title={title} description={description} faqs={faqs}>
  <div class="max-w-7xl mx-auto px-4 py-6 sm:py-8 min-w-0 w-full overflow-hidden font-sans">
    <Breadcrumbs items={breadcrumbs} />

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mt-6">
      
      <!-- Left Primary Diagnostic Canvas (lg:col-span-8) -->
      <div class="lg:col-span-8 space-y-8 min-w-0">
        <!-- Hero Header Deck -->
        <header class="relative w-full rounded-3xl border border-white/10 bg-[#121215]/90 backdrop-blur-xl p-6 sm:p-8 md:p-10 shadow-2xl space-y-4 overflow-hidden group select-none">
          <div class="absolute -top-24 -left-24 w-72 h-72 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none group-hover:bg-emerald-500/15 transition-all duration-500"></div>
          <div class="absolute -bottom-24 -right-24 w-72 h-72 bg-cyan-500/10 rounded-full blur-3xl pointer-events-none group-hover:bg-cyan-500/15 transition-all duration-500"></div>

          <div class="relative z-10 space-y-3 max-w-3xl min-w-0 w-full">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/5 border border-white/10 text-emerald-400 text-xs font-mono font-bold tracking-wide flex-wrap shadow-inner">
              <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse shrink-0"></span>
              <span>IEC 61672-1 MICROPHONE INPUT METRICS</span>
            </div>
            <h1 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight font-sans break-words min-w-0">
              {title}
            </h1>
            <p class="text-sm sm:text-base text-zinc-300 font-sans leading-relaxed min-w-0">
              Inspect microphone audio input levels, voice clarity, digital clipping distortion, and background noise floor in real time using client-side Web Audio API.
            </p>
          </div>
        </header>

        <!-- Main Diagnostic Instrument -->
        <div class="rounded-3xl border border-white/10 bg-[#121215]/90 backdrop-blur-xl p-4 sm:p-6 shadow-2xl">
          <AudioTesterCanvas />
        </div>

        <!-- 3-Step Workflow Protocol -->
        <StepWorkflowSection />

        <!-- Panel Technology Breakdown -->
        <PanelTypeBreakdownSection />

        <!-- Article Section -->
        <article class="bg-[#121215] border border-white/10 rounded-3xl p-6 sm:p-8 space-y-6 shadow-2xl font-sans text-sm text-zinc-300 leading-relaxed">
          <div class="border-b border-white/10 pb-4 font-mono">
            <span class="text-xs font-bold text-emerald-400 uppercase tracking-widest block mb-1">ELECTROACOUSTIC METRICS</span>
            <h2 class="text-2xl font-bold text-white">Microphone Gain Staging, Polar Patterns &amp; Noise Floor</h2>
          </div>

          <p>
            Optimizing microphone input performance requires establishing proper gain staging and maximizing Signal-to-Noise Ratio (SNR). Our real-time visualizer reads peak dBFS amplitude to prevent digital clipping while measuring ambient background room noise.
          </p>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-4 font-mono text-xs my-4">
            <div class="bg-[#08080a] p-5 rounded-2xl border border-white/10 space-y-2">
              <span class="text-cyan-400 text-[10px] uppercase font-bold block">Gain Staging</span>
              <strong class="text-white block text-sm">-18 dBFS to -6 dBFS</strong>
              <p class="font-sans text-[11px] text-zinc-400 leading-relaxed">Optimal voice signal headroom preventing digital clipping or distortion.</p>
            </div>
            <div class="bg-[#08080a] p-5 rounded-2xl border border-white/10 space-y-2">
              <span class="text-emerald-400 text-[10px] uppercase font-bold block">Cardioid Rejection</span>
              <strong class="text-white block text-sm">Polar Pattern</strong>
              <p class="font-sans text-[11px] text-zinc-400 leading-relaxed">Focuses on front speech pickup while dampening background room reverberation.</p>
            </div>
            <div class="bg-[#08080a] p-5 rounded-2xl border border-white/10 space-y-2">
              <span class="text-amber-400 text-[10px] uppercase font-bold block">Noise Floor (dBFS)</span>
              <strong class="text-white block text-sm">Preamplifier Hiss</strong>
              <p class="font-sans text-[11px] text-zinc-400 leading-relaxed">Quantifies background electrical noise when operating in a silent room environment.</p>
            </div>
          </div>
        </article>

        <!-- 10 Structured FAQs Component -->
        <FAQSection faqs={faqs} title="Microphone Testing FAQs" />
      </div>

      <!-- Right Modular Control & Telemetry Sidebar (lg:col-span-4) -->
      <div class="lg:col-span-4 space-y-6 sticky top-24 self-start min-w-0">
        <StatusCard
          status="pass"
          label="MIC INPUT READY"
          subtitle="W3C getUserMedia Stream"
          score="-12.4"
          maxScore="dBFS"
          details={[
            { label: 'Voice Level', value: '-12.4 dBFS (Good)' },
            { label: 'Clipping Guard', value: 'Clean (0 Clips)' }
          ]}
        />

        <MetricCard
          title="Microphone Readout"
          subtitle="PCM Audio Worklet Telemetry"
          badgeText="IEC 61672-1"
          metrics={[
            { id: 'peakLevelDb', label: 'Peak Voice Level', value: '-12.4', unit: 'dBFS', status: 'pass' },
            { id: 'noiseFloorDb', label: 'Ambient Noise Floor', value: '-62.1', unit: 'dBFS', status: 'pass' },
            { id: 'clippingCount', label: 'Digital Clip Overflows', value: '0', unit: 'clips', status: 'pass' }
          ]}
        />

        <ConfigurationCard
          title="Microphone Controls"
          subtitle="Device & Processing Settings"
          controls={[
            {
              id: 'micInputDevice',
              label: 'Input Microphone Stream',
              type: 'select',
              value: 'default',
              options: [
                { value: 'default', label: 'Default System Microphone' },
                { value: 'usb-mic', label: 'USB Condenser Mic' },
                { value: 'headset-mic', label: 'Headset Microphone' }
              ]
            },
            {
              id: 'echoCancellation',
              label: 'OS Acoustic Echo Cancellation',
              type: 'presets',
              value: 'enabled',
              options: [
                { value: 'enabled', label: 'Enabled (AEC On)' },
                { value: 'disabled', label: 'Disabled (Raw PCM)' }
              ]
            }
          ]}
        />

        <InspectorCard
          title="Microphone Stream Info"
          subtitle="MediaTrackSettings Attributes"
          rows={[
            { key: 'Sample Rate', value: '48,000 Hz', highlight: true },
            { key: 'Channel Count', value: '1 (Mono Cardioid)' },
            { key: 'Noise Suppression', value: 'Active (WebRTC)' },
            { key: 'Latency Buffer', value: '10.0 ms' }
          ]}
        />

        <ShortcutCard
          shortcuts={[
            { keys: ['M'], label: 'Mute / Unmute Mic Stream' },
            { keys: ['R'], label: 'Reset Peak Level Meter' }
          ]}
        />
      </div>

    </div>
  </div>
</Layout>
