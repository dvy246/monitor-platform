---
import Layout from '../../layouts/Layout.astro';
import AudioTesterCanvas from '../../components/diagnostics/AudioTesterCanvas.astro';
import FAQSection from '../../components/ui/FAQSection.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import MasterBentoDiagnosticSuite from '../../components/diagnostics/MasterBentoDiagnosticSuite.astro';
import StepWorkflowSection from '../../components/ui/StepWorkflowSection.astro';
import PanelTypeBreakdownSection from '../../components/ui/PanelTypeBreakdownSection.astro';


const title = "Online Audio Tone Generator & Frequency Synthesizer";
const description = "Generate pure sine, square, triangle, and sawtooth audio frequencies (1Hz to 20kHz) online using uncompressed Web Audio API synthesis.";

const faqs = [
  {
    question: "How does the Online Audio Tone Generator synthesize pure frequencies?",
    answer: "Our tool utilizes Web Audio API OscillatorNode algorithms to compute 64-bit mathematical waveforms (sine, square, triangle, sawtooth) in real time directly inside browser RAM."
  },
  {
    question: "What is the difference between Sine, Square, Triangle, and Sawtooth waveforms?",
    answer: "Sine waves contain a single fundamental frequency without harmonics. Square waves contain odd harmonics (hollow, buzzy tone). Sawtooth waves contain all integer harmonics (bright, brassy tone). Triangle waves contain soft odd harmonics."
  },
  {
    question: "Why is a web-based tone generator better than downloadable MP3 audio files?",
    answer: "MP3 audio files use lossy compression that truncates sub-bass frequencies and introduces harmonic aliasing. Web Audio API generates mathematically pure, uncompressed, continuous floating-point audio."
  },
  {
    question: "How do I use a 440 Hz tone to tune musical instruments?",
    answer: "440 Hz is the international pitch standard for Note A above middle C (A440). Select 440 Hz Sine wave to calibrate guitar, violin, or piano pitch."
  },
  {
    question: "Can I generate binaural beats using dual tone generators?",
    answer: "Yes. By generating a 200 Hz tone in the left channel and a 210 Hz tone in the right channel, your brain perceives a 10 Hz Alpha binaural beat."
  },
  {
    question: "What is frequency aliasing and how is it prevented during tone generation?",
    answer: "Aliasing occurs when synthesized frequencies exceed the Nyquist limit (half of sample rate, e.g. 22.05kHz for 44.1kHz audio). Web Audio API applies anti-aliasing bandlimited synthesis to prevent ghost harmonics."
  },
  {
    question: "How do I test speaker resonance and room standing waves using fixed tones?",
    answer: "Sweep slowly through low frequencies (30Hz to 100Hz). When you hit a frequency that causes intense room vibration or volume spikes, you have identified a room acoustic standing wave mode."
  },
  {
    question: "What is a 1kHz reference tone used for in audio engineering?",
    answer: "A 1kHz sine wave at 0 dBFS or -18 dBFS is the industry standard reference signal used to calibrate audio interface gain levels, broadcast meters, and tape recorder alignment."
  },
  {
    question: "Is playing high-pitch 15kHz+ sine waves safe for my speakers and ears?",
    answer: "Yes, provided volume levels are kept moderate. Avoid high-volume continuous playback of ultrasonic frequencies to prevent tweeter voice coil overheating."
  },
  {
    question: "Can I generate sub-audible infrasound tones (1Hz to 15Hz)?",
    answer: "Yes. Web Audio API supports synthesis down to 1Hz, though hearing or feeling these frequencies requires specialized high-excursion subwoofers."
  }
];

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Sound Test', href: '/sound-test' },
  { label: title, href: '#' }
];
---

<Layout title={title} description={description} faqs={faqs}>
  <div  font-sans">
    <Breadcrumbs items={breadcrumbs} />

    <!-- Hero Header Deck -->
    <header class="relative w-full rounded-3xl border border-white/10 bg-[#121215]/90 backdrop-blur-xl p-6 sm:p-8 md:p-10 shadow-2xl space-y-4 overflow-hidden group select-none">
      <div class="absolute -top-24 -left-24 w-72 h-72 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none group-hover:bg-emerald-500/15 transition-all duration-500"></div>
      <div class="absolute -bottom-24 -right-24 w-72 h-72 bg-cyan-500/10 rounded-full blur-3xl pointer-events-none group-hover:bg-cyan-500/15 transition-all duration-500"></div>

      <div class="relative z-10 space-y-3 max-w-3xl min-w-0 w-full">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/5 border border-white/10 text-emerald-400 text-xs font-mono font-bold tracking-wide flex-wrap shadow-inner">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse shrink-0"></span>
          <span>UNCOMPRESSED WEBAUDIO OSCILLATOR SYNTHESIS</span>
        </div>
        <h1 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight font-sans break-words min-w-0">
          {title}
        </h1>
        <p class="text-sm sm:text-base text-zinc-300 font-sans leading-relaxed min-w-0">
          Synthesize pure sine, square, triangle, and sawtooth audio waveforms from 1Hz to 20,000Hz. Calibrate speakers, tune instruments, and test room acoustics with 64-bit precision.
        </p>
      </div>
    </header>

    <!-- Main Diagnostic Instrument -->
    <div class="rounded-3xl border border-white/10 bg-[#121215]/90 backdrop-blur-xl p-4 sm:p-6 shadow-2xl">
      <AudioTesterCanvas initialFreq={440} />
    </div>

    <!-- 3-Step Workflow Protocol -->
    <StepWorkflowSection />

    <!-- Panel Technology Breakdown -->
    <PanelTypeBreakdownSection />

    <!-- Article Section -->
    <article class="bg-[#121215] border border-white/10 rounded-3xl p-6 sm:p-8 space-y-6 shadow-2xl font-sans text-sm text-zinc-300 leading-relaxed">
      <div class="border-b border-white/10 pb-4 font-mono">
        <span class="text-xs font-bold text-emerald-400 uppercase tracking-widest block mb-1">SIGNAL SYNTHESIS MATHEMATICS</span>
        <h2 class="text-2xl font-bold text-white">Waveform Harmonics, Nyquist Sampling &amp; Pure Oscillators</h2>
      </div>

      <p>
        Audio tone generation requires pure mathematical waveform synthesis without phase distortion or compression artifacts. Using Web Audio API OscillatorNode interfaces, our generator synthesizes customizable frequencies directly in browser memory.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-4 gap-4 font-mono text-xs my-4">
        <div class="bg-[#08080a] p-4 rounded-2xl border border-white/10 space-y-1">
          <span class="text-cyan-400 text-[10px] uppercase font-bold block">Sine Wave</span>
          <strong class="text-white block text-sm">Fundamental Only</strong>
          <p class="font-sans text-[11px] text-zinc-400 leading-relaxed">Pure harmonic-free tone ideal for audio testing and calibration.</p>
        </div>
        <div class="bg-[#08080a] p-4 rounded-2xl border border-white/10 space-y-1">
          <span class="text-emerald-400 text-[10px] uppercase font-bold block">Square Wave</span>
          <strong class="text-white block text-sm">Odd Harmonics</strong>
          <p class="font-sans text-[11px] text-zinc-400 leading-relaxed">Hollow, punchy timbre used for testing digital amplifier slew rates.</p>
        </div>
        <div class="bg-[#08080a] p-4 rounded-2xl border border-white/10 space-y-1">
          <span class="text-amber-400 text-[10px] uppercase font-bold block">Sawtooth Wave</span>
          <strong class="text-white block text-sm">All Harmonics</strong>
          <p class="font-sans text-[11px] text-zinc-400 leading-relaxed">Rich brassy tone containing integer harmonics (1/n amplitude decay).</p>
        </div>
        <div class="bg-[#08080a] p-4 rounded-2xl border border-white/10 space-y-1">
          <span class="text-purple-400 text-[10px] uppercase font-bold block">Triangle Wave</span>
          <strong class="text-white block text-sm">Soft Harmonics</strong>
          <p class="font-sans text-[11px] text-zinc-400 leading-relaxed">Mellow flute-like tone with rapid odd harmonic roll-off (1/n² decay).</p>
        </div>
      </div>
    </article>

    <!-- 10 Structured FAQs Component -->
    <FAQSection faqs={faqs} title="Tone Generator & Frequency FAQs" />

  </div>
</Layout>
