---
import Layout from '../../layouts/Layout.astro';
import WaterEjectorCanvas from '../../components/diagnostics/WaterEjectorCanvas.astro';
import FAQSection from '../../components/ui/FAQSection.astro';
import { useTranslations } from '../../utils/i18n';

const { t, lang } = useTranslations(Astro.url.pathname);

const waterEjectFaqs = [
  {
    q: 'How do I fix my speaker after dropping my phone in water?',
    a: 'To fix my speaker when water is trapped, immediately turn off your device, remove the protective case, and play our 165Hz water eject sound at full volume. The acoustic pressure creates gentle vibrations that force water droplets out of the speaker mesh within 30 to 60 seconds.'
  },
  {
    q: 'How does the water remover from phone tool work?',
    a: 'Our browser-based water remover from phone tool generates precise low-frequency sound waves (165Hz–500Hz). These audio frequencies mirror the Apple Watch water eject function, pushing trapped moisture out through the speaker grille using kinetic air displacement.'
  },
  {
    q: 'Is the water eject sound safe for iPhone and Android speakers?',
    a: 'Yes, the water eject sound is completely safe for all smartphones including iPhone, Samsung Galaxy, Google Pixel, and tablets. It uses standard Web Audio API signals that vibrate the speaker membrane within manufacturer-rated hardware limits.'
  },
  {
    q: 'Can this speaker dust cleaning sound water tool also remove dirt?',
    a: 'Yes! In addition to emergency water removal, our speaker dust cleaning sound water mode uses a high-frequency sweep (up to 500Hz) that breaks up dried dust, lint, and salt residue trapped inside speaker grilles.'
  },
  {
    q: 'Will rice fix water-damaged phone speakers?',
    a: 'No. Placing a phone in raw rice is ineffective and can introduce harmful starch particles and dust into your charging port and speaker mesh. Using a dedicated water remover speaker utility combined with open-air drying is far more effective.'
  },
  {
    q: 'How long does emergency water removal and drying take?',
    a: 'For light surface splashes, running the water eject sound for 60 seconds will clear muffled audio almost instantly. For deeper submersion, run the emergency water removal tone 2 to 3 times, then allow your device to air dry in a well-ventilated space for 2 to 4 hours.'
  },
  {
    q: 'Can I charge my phone while removing water from speaker?',
    a: 'No! Never plug in a charging cable while moisture is detected or while your speaker is wet. Charging a wet device can cause a fatal short circuit. Wait until all water removal procedures are complete and the phone is fully dry.'
  },
  {
    q: 'Does water eject iPhone mode work on all Apple devices?',
    a: 'Yes, water eject iPhone mode is optimized for all Apple models, including iPhone 16, 15, 14, 13, 12, 11 series, iPad Pro, and Apple Watch. It works directly in Safari without requiring Siri Shortcuts or app installations.'
  },
  {
    q: 'What frequency is best for a water remover speaker test?',
    a: '165Hz is ideal for standard smartphone main speakers, 300Hz works best for tablets and laptops with larger driver diaphragms, and 500Hz targets small call speakers (earpiece).'
  },
  {
    q: 'What should I do if the water eject sound does not fix my speaker?',
    a: 'If your speaker remains muffled after multiple water eject cycles, let your device sit in a dry, ventilated room for 24 to 48 hours. If distorted sound or moisture warnings persist, seek professional hardware repair.'
  }
];
---

<Layout
  title="Fix My Speaker: Water Eject Sound & Water Remover From Phone | Display Test Online"
  description="Fix my speaker instantly! Run our free water eject sound tool to remove water from phone speakers, iPhones, Androids, and laptops using 165Hz emergency water removal tones."
  faqs={waterEjectFaqs.map(item => ({ question: item.q, answer: item.a }))}
>
  <main id="main-content" class="py-10 space-y-12">
    <!-- Page Header & SEO Hero -->
    <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-4">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-status-pass/10 border border-status-pass/30 font-mono text-xs text-status-pass font-bold tracking-wider uppercase">
        <span class="w-2 h-2 rounded-full bg-status-pass animate-pulse"></span>
        Fix My Speaker & Emergency Water Removal
      </div>

      <h1 class="text-3xl sm:text-5xl font-extrabold text-text-primary tracking-tight font-mono">
        Fix My Speaker: Water Eject Sound & Phone Cleaner
      </h1>

      <p class="text-sm sm:text-base text-text-secondary max-w-2xl mx-auto leading-relaxed">
        Need to <strong class="text-text-primary">fix my speaker</strong> or <strong class="text-text-primary">remove water from phone</strong>? Select your device type below to play acoustic <strong class="text-text-primary">water eject sound</strong> frequencies (165Hz–500Hz) and clean muffled phone speakers instantly.
      </p>
    </section>

    <!-- Interactive Diagnostic Canvas Component -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <WaterEjectorCanvas />
    </section>

    <!-- Problem Selection CTA -->
    <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-4">
      <h2 class="text-xl font-bold font-mono text-text-primary">What problem are you having?</h2>
      <p class="text-sm text-text-muted">Select your issue to get specific help</p>
      
      <div class="flex flex-wrap items-center justify-center gap-3" id="problem-selector">
        <button data-issue="muffled" class="issue-btn px-4 py-2 rounded-lg bg-bg-surface border border-border-hairline text-sm font-bold text-text-primary shadow-specular-top hover:bg-bg-elevated transition-colors">Muffled Sound</button>
        <button data-issue="low" class="issue-btn px-4 py-2 rounded-lg bg-bg-surface border border-border-hairline text-sm font-bold text-text-primary shadow-specular-top hover:bg-bg-elevated transition-colors">Low Volume</button>
        <button data-issue="none" class="issue-btn px-4 py-2 rounded-lg bg-bg-surface border border-border-hairline text-sm font-bold text-text-primary shadow-specular-top hover:bg-bg-elevated transition-colors">No Sound</button>
        <button data-issue="call" class="issue-btn px-4 py-2 rounded-lg bg-status-pass/10 border border-status-pass/30 text-sm font-bold text-status-pass shadow-specular-top ring-1 ring-status-pass/50 hover:bg-status-pass/20 transition-colors">Call Speaker Issue</button>
      </div>

      <div class="mt-4 p-4 rounded-xl bg-status-info/10 border border-status-info/30 text-left max-w-2xl mx-auto flex items-start gap-3 transition-opacity duration-300" id="solution-container">
        <svg class="w-6 h-6 text-status-info shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
        <div>
          <h4 class="font-bold text-status-info text-sm mb-1">Recommended Solution</h4>
          <p class="text-xs text-text-secondary leading-relaxed" id="solution-text">Call speakers (earpiece) are delicate. Place your device face-down on a soft cloth. Let gravity help water drain. Avoid inserting anything into the speaker opening. Use the <strong class="text-text-primary">Call Speaker Eject</strong> preset above.</p>
        </div>
      </div>
    </section>

    <script>
      const solutions = {
        'muffled': 'Water is trapped against the speaker membrane. Use the <strong class="text-text-primary">165Hz Water Eject Sound</strong> preset above for 30 seconds at maximum volume to expel droplets.',
        'low': 'Water or dirt is blocking the speaker mesh. Run the water eject tool first. If the device is completely dry but still quiet, switch to our <strong class="text-text-primary">Speaker Cleaner Tool</strong> to dislodge dust.',
        'none': 'If you hear absolutely nothing even at max volume, the speaker circuitry may have shorted. Power off the device immediately and let it air dry for 24-48 hours before testing again. Do not charge it.',
        'call': 'Call speakers (earpiece) are delicate. Place your device face-down on a soft cloth. Let gravity help water drain. Avoid inserting anything into the speaker opening. Use the <strong class="text-text-primary">Call Speaker Eject</strong> preset above.'
      };

      const buttons = document.querySelectorAll('.issue-btn');
      const solutionText = document.getElementById('solution-text');
      const solutionContainer = document.getElementById('solution-container');

      buttons.forEach(btn => {
        btn.addEventListener('click', (e) => {
          const target = e.currentTarget as HTMLButtonElement;
          const issue = target.getAttribute('data-issue');
          
          // Reset all buttons to inactive styling
          buttons.forEach(b => {
            b.className = 'issue-btn px-4 py-2 rounded-lg bg-bg-surface border border-border-hairline text-sm font-bold text-text-primary shadow-specular-top hover:bg-bg-elevated transition-colors';
          });

          // Set active styling on clicked button
          target.className = 'issue-btn px-4 py-2 rounded-lg bg-status-pass/10 border border-status-pass/30 text-sm font-bold text-status-pass shadow-specular-top ring-1 ring-status-pass/50 hover:bg-status-pass/20 transition-colors';

          // Update text with fade effect
          if (solutionContainer && solutionText && issue && solutions[issue]) {
            solutionContainer.style.opacity = '0';
            setTimeout(() => {
              solutionText.innerHTML = solutions[issue];
              solutionContainer.style.opacity = '1';
            }, 150);
          }
        });
      });
    </script>

    <!-- Deep Technical Information & SEO Suite -->
    <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12 text-text-secondary text-sm leading-relaxed">
      
      <!-- What is Water Removal Sound -->
      <div class="space-y-4">
        <h2 class="text-2xl font-bold font-mono text-text-primary">What is Water Removal Sound?</h2>
        <p>
          Water removal sound is a scientifically-proven technique that uses specific audio frequencies to eject water trapped inside your device speakers. When water enters your phone, tablet, or laptop speaker, it blocks the speaker membrane and causes muffled or distorted audio. Our water eject sound technology creates precise vibrations that physically push water droplets out of the speaker grille.
        </p>
        <p>
          This method works similarly to how the Apple Watch ejects water after swimming, by playing low-frequency tones that cause rapid vibrations in the speaker membrane. These vibrations create enough force to expel water without damaging your device. It is the safest and most effective way to remove water from speakers compared to outdated methods like rice or heat.
        </p>
      </div>

      <!-- Quick Checklist (YMYL) -->
      <div class="p-6 sm:p-8 rounded-2xl bg-status-fail/5 border border-status-fail/20 shadow-specular-top space-y-4">
        <h2 class="text-xl font-bold font-mono text-status-fail flex items-center gap-2">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
          Quick Emergency Checklist
        </h2>
        <ul class="space-y-2 text-sm text-text-secondary list-none font-mono">
          <li class="flex items-start gap-2"><span class="text-status-fail mt-0.5">▪</span> Power off device immediately or enable airplane mode</li>
          <li class="flex items-start gap-2"><span class="text-status-fail mt-0.5">▪</span> Remove SIM card tray to check moisture indicator</li>
          <li class="flex items-start gap-2"><span class="text-status-fail mt-0.5">▪</span> Shake phone gently with speaker facing downward</li>
          <li class="flex items-start gap-2"><span class="text-status-fail mt-0.5">▪</span> Play water eject tone at full volume for 60 seconds</li>
          <li class="flex items-start gap-2"><span class="text-status-fail mt-0.5">▪</span> Use manufacturer app if available (Samsung has built-in feature)</li>
          <li class="flex items-start gap-2"><span class="text-status-fail mt-0.5">▪</span> Dry in well-ventilated area for minimum 4 hours</li>
          <li class="flex items-start gap-2"><span class="text-status-fail mt-0.5">▪</span> Check for moisture warning before charging</li>
        </ul>
      </div>

      <!-- Step by Step -->
      <div class="p-6 sm:p-8 rounded-2xl bg-bg-surface border border-border-hairline shadow-specular-top space-y-6">
        <h2 class="text-2xl font-bold font-mono text-text-primary border-b border-border-hairline pb-4">How to Remove Water From Speaker: Step-by-Step</h2>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <div class="space-y-2">
            <div class="flex items-center gap-3">
              <span class="w-8 h-8 rounded-full bg-status-pass/10 text-status-pass font-bold flex items-center justify-center font-mono border border-status-pass/30">1</span>
              <h3 class="font-bold text-text-primary text-base">Turn Off Your Device</h3>
            </div>
            <p class="text-xs text-text-muted pl-11">Immediately power off your phone, tablet, or laptop to prevent short circuits. Do not press any buttons excessively as this may push water deeper into the device.</p>
          </div>

          <div class="space-y-2">
            <div class="flex items-center gap-3">
              <span class="w-8 h-8 rounded-full bg-status-pass/10 text-status-pass font-bold flex items-center justify-center font-mono border border-status-pass/30">2</span>
              <h3 class="font-bold text-text-primary text-base">Remove Cases and Accessories</h3>
            </div>
            <p class="text-xs text-text-muted pl-11">Take off any protective cases, screen protectors, or accessories. These can trap water against your device and slow down the drying process.</p>
          </div>

          <div class="space-y-2">
            <div class="flex items-center gap-3">
              <span class="w-8 h-8 rounded-full bg-status-pass/10 text-status-pass font-bold flex items-center justify-center font-mono border border-status-pass/30">3</span>
              <h3 class="font-bold text-text-primary text-base">Shake Out Excess Water</h3>
            </div>
            <p class="text-xs text-text-muted pl-11">Gently shake your device with the speaker facing downward to remove loose water droplets. Avoid vigorous shaking which may spread water to other components.</p>
          </div>

          <div class="space-y-2">
            <div class="flex items-center gap-3">
              <span class="w-8 h-8 rounded-full bg-status-pass/10 text-status-pass font-bold flex items-center justify-center font-mono border border-status-pass/30">4</span>
              <h3 class="font-bold text-text-primary text-base">Set Volume to Maximum</h3>
            </div>
            <p class="text-xs text-text-muted pl-11">Turn your device back on and set the volume to 100%. The water eject sound needs maximum volume to create sufficient vibrations for water expulsion.</p>
          </div>

          <div class="space-y-2">
            <div class="flex items-center gap-3">
              <span class="w-8 h-8 rounded-full bg-status-pass/10 text-status-pass font-bold flex items-center justify-center font-mono border border-status-pass/30">5</span>
              <h3 class="font-bold text-text-primary text-base">Play Water Eject Sound</h3>
            </div>
            <p class="text-xs text-text-muted pl-11">Use our water removal tool above. Start with 165Hz for light water exposure, or try 300Hz-500Hz for stubborn water. Play for 30-60 seconds.</p>
          </div>

          <div class="space-y-2">
            <div class="flex items-center gap-3">
              <span class="w-8 h-8 rounded-full bg-status-pass/10 text-status-pass font-bold flex items-center justify-center font-mono border border-status-pass/30">6</span>
              <h3 class="font-bold text-text-primary text-base">Repeat if Necessary</h3>
            </div>
            <p class="text-xs text-text-muted pl-11">If sound is still muffled, repeat the process 2-3 times. Allow 5-10 minutes between sessions. Most speakers clear within 2-3 cycles.</p>
          </div>
        </div>
      </div>

      <!-- Things Not to Do -->
      <div class="space-y-6">
        <h2 class="text-2xl font-bold font-mono text-text-primary">Things Not to Do</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="p-4 rounded-xl bg-status-fail/5 border border-status-fail/20 flex gap-3">
            <span class="text-status-fail font-bold mt-0.5">✗</span>
            <div>
              <h4 class="font-bold text-text-primary text-sm mb-1">Do not use rice</h4>
              <p class="text-xs text-text-muted">It is ineffective and can leave starch residue and dust particles inside your device.</p>
            </div>
          </div>
          <div class="p-4 rounded-xl bg-status-fail/5 border border-status-fail/20 flex gap-3">
            <span class="text-status-fail font-bold mt-0.5">✗</span>
            <div>
              <h4 class="font-bold text-text-primary text-sm mb-1">Do not use heat sources</h4>
              <p class="text-xs text-text-muted">Avoid hair dryers, ovens, or microwaves. Heat can melt internal adhesives and warp components.</p>
            </div>
          </div>
          <div class="p-4 rounded-xl bg-status-fail/5 border border-status-fail/20 flex gap-3">
            <span class="text-status-fail font-bold mt-0.5">✗</span>
            <div>
              <h4 class="font-bold text-text-primary text-sm mb-1">Do not insert objects</h4>
              <p class="text-xs text-text-muted">Do not insert cotton swabs or toothpicks into speaker holes. You will push water deeper and puncture the speaker.</p>
            </div>
          </div>
          <div class="p-4 rounded-xl bg-status-fail/5 border border-status-fail/20 flex gap-3">
            <span class="text-status-fail font-bold mt-0.5">✗</span>
            <div>
              <h4 class="font-bold text-text-primary text-sm mb-1">Do not charge the phone</h4>
              <p class="text-xs text-text-muted">Do not charge the phone while the moisture warning is active to avoid short circuits.</p>
            </div>
          </div>
          <div class="p-4 rounded-xl bg-status-fail/5 border border-status-fail/20 flex gap-3 sm:col-span-2 lg:col-span-1">
            <span class="text-status-fail font-bold mt-0.5">✗</span>
            <div>
              <h4 class="font-bold text-text-primary text-sm mb-1">Do not attempt to disassemble</h4>
              <p class="text-xs text-text-muted">Do not attempt to disassemble the phone yourself unless you are a certified technician.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Test With Sample Music -->
      <div class="p-6 rounded-2xl bg-indigo-500/10 border border-indigo-500/30 text-center space-y-4 shadow-specular-top">
        <div class="w-12 h-12 rounded-full bg-indigo-500/20 text-indigo-400 flex items-center justify-center mx-auto mb-2">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3" /></svg>
        </div>
        <h2 class="text-xl font-bold font-mono text-indigo-400">Test With Sample Music</h2>
        <p class="text-sm text-text-secondary max-w-lg mx-auto">Use our high-resolution audio samples to verify your speaker is working properly and sounding crisp after water removal.</p>
        <a href="/sound-test/speaker-test-music" class="inline-flex items-center gap-2 px-6 py-2.5 rounded-lg bg-indigo-500 text-white font-bold hover:bg-indigo-400 transition-colors">
          Open Speaker Test Music &rarr;
        </a>
      </div>

      <!-- Device Compatibility -->
      <div class="space-y-6">
        <h2 class="text-2xl font-bold font-mono text-text-primary">Device Compatibility</h2>
        <p class="text-text-muted">Our water removal sound tool works with all major devices and brands. Here are some of the devices we support:</p>
        
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          <div class="p-4 rounded-xl bg-bg-surface border border-border-hairline">
            <h4 class="font-bold text-text-primary text-sm mb-2 text-cyan-400">iPhones</h4>
            <p class="text-xs text-text-muted">Works on all iPhones including iPhone 17, 16 series, 15 series, 14, 13, 12, 11, SE models, and newer models.</p>
          </div>
          <div class="p-4 rounded-xl bg-bg-surface border border-border-hairline">
            <h4 class="font-bold text-text-primary text-sm mb-2 text-emerald-400">Samsung</h4>
            <p class="text-xs text-text-muted">Supports Galaxy S25 series, S24 series, S23, A55, A54, A35, Z Fold 6, Z Flip 6, and newer models.</p>
          </div>
          <div class="p-4 rounded-xl bg-bg-surface border border-border-hairline">
            <h4 class="font-bold text-text-primary text-sm mb-2 text-rose-400">Google Pixel</h4>
            <p class="text-xs text-text-muted">Works on Pixel 9 Pro XL, 9 Pro, 9, 8 Pro, 8a, 8, 7 Pro, 7a, 6 Pro, 6, and newer models.</p>
          </div>
          <div class="p-4 rounded-xl bg-bg-surface border border-border-hairline">
            <h4 class="font-bold text-text-primary text-sm mb-2 text-emerald-500">Other Android</h4>
            <p class="text-xs text-text-muted">Supports OnePlus, Xiaomi, OPPO, Realme GT, Motorola Edge, Nothing Phone, and more.</p>
          </div>
          <div class="p-4 rounded-xl bg-bg-surface border border-border-hairline">
            <h4 class="font-bold text-text-primary text-sm mb-2 text-purple-400">Tablets</h4>
            <p class="text-xs text-text-muted">Works on iPad M2, iPad Mini, Samsung Tab S10 and S9, Xiaomi Pad 6, and all major Android tablets.</p>
          </div>
          <div class="p-4 rounded-xl bg-bg-surface border border-border-hairline">
            <h4 class="font-bold text-text-primary text-sm mb-2 text-amber-400">Laptops</h4>
            <p class="text-xs text-text-muted">Supports MacBook M3 models, Dell XPS, HP Spectre, ThinkPad, ASUS ROG, Surface, and more.</p>
          </div>
          <div class="p-4 rounded-xl bg-bg-surface border border-border-hairline">
            <h4 class="font-bold text-text-primary text-sm mb-2 text-indigo-400">Earbuds</h4>
            <p class="text-xs text-text-muted">Supports AirPods Pro 2, AirPods 4, Galaxy Buds 3, Pixel Buds Pro, Sony WF-1000XM5, Jabra Elite.</p>
          </div>
          <div class="p-4 rounded-xl bg-bg-surface border border-border-hairline">
            <h4 class="font-bold text-text-primary text-sm mb-2 text-sky-400">Smartwatches</h4>
            <p class="text-xs text-text-muted">Supports Apple Watch Ultra 2 and Series 10, Galaxy Watch 7, Pixel Watch 3, Garmin, Fitbit.</p>
          </div>
        </div>
      </div>

      <!-- Why We Are Different -->
      <div class="p-6 rounded-2xl bg-gradient-to-br from-bg-surface to-bg-canvas border border-border-hairline space-y-6 shadow-specular-top">
        <h2 class="text-2xl font-bold font-mono text-text-primary">Why Display Test Online is Different</h2>
        <p class="text-text-muted">Most Fix My Speaker sites rely on a single basic tone that only works in light moisture situations. Display Test Online provides scientifically optimized diagnostic engines designed to target different droplet sizes and speaker types, giving your device a much better chance of complete water removal.</p>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-4">
          <div class="space-y-1.5">
            <div class="text-lg">🎯</div>
            <h4 class="font-bold text-text-primary text-sm">Customized for Your Device</h4>
            <p class="text-xs text-text-muted">We provide device-specific guides for iPhones, Android phones, tablets, laptops, and call speakers. Each device has unique speaker characteristics, and our tool adapts to maximize effectiveness.</p>
          </div>
          <div class="space-y-1.5">
            <div class="text-lg">🔬</div>
            <h4 class="font-bold text-text-primary text-sm">Hardware-Tuned Frequencies</h4>
            <p class="text-xs text-text-muted">Our tool offers fully dynamic sound frequencies (165Hz, 300Hz, 500Hz, and resonant sweep mode) because different water situations require different approaches. Others only give you one.</p>
          </div>
          <div class="space-y-1.5">
            <div class="text-lg">📱</div>
            <h4 class="font-bold text-text-primary text-sm">Works on All Devices</h4>
            <p class="text-xs text-text-muted">From budget Android phones to premium iPhones, iPads, Samsung tablets, MacBooks, and Windows laptops, our water removal sound works across all devices with speakers.</p>
          </div>
          <div class="space-y-1.5">
            <div class="text-lg">✅</div>
            <h4 class="font-bold text-text-primary text-sm">100% Free &amp; Safe</h4>
            <p class="text-xs text-text-muted">No downloads, no apps, no registration required. Just open our tool and start removing water instantly. The sound frequencies we use are completely safe for all speakers.</p>
          </div>
        </div>
      </div>

      <!-- When to Seek Professional Repair (YMYL) -->
      <div class="p-6 sm:p-8 rounded-2xl bg-amber-500/5 border border-amber-500/20 shadow-specular-top space-y-4">
        <h2 class="text-xl font-bold font-mono text-amber-500 flex items-center gap-2">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
          When to Seek Professional Repair
        </h2>
        <p class="text-sm text-text-secondary">Consider professional help immediately if you observe any of the following:</p>
        <ul class="space-y-2 text-sm text-text-secondary list-none">
          <li class="flex items-start gap-2"><span class="text-amber-500 mt-0.5">⚠️</span> Moisture warning persists after 48 hours of drying.</li>
          <li class="flex items-start gap-2"><span class="text-amber-500 mt-0.5">⚠️</span> Speaker produces absolutely no sound or severely distorted, unidentifiable audio.</li>
          <li class="flex items-start gap-2"><span class="text-amber-500 mt-0.5">⚠️</span> Water damage indicator (LDI) shows red or pink color.</li>
          <li class="flex items-start gap-2"><span class="text-amber-500 mt-0.5">⚠️</span> Phone shows other severe symptoms like screen flickering, boot looping, or battery swelling.</li>
          <li class="flex items-start gap-2"><span class="text-amber-500 mt-0.5">⚠️</span> Warranty is still active and covers water damage (always check your policy first before voiding it).</li>
        </ul>
      </div>

      <!-- FAQ Section Accordion UI -->
      <div class="pt-8">
        <FAQSection faqs={waterEjectFaqs.map(item => ({ question: item.q, answer: item.a }))} />
      </div>
    </section>
  </main>
</Layout>
