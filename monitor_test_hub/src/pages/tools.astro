---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/ui/Breadcrumbs.astro';
import FAQSection from '../components/ui/FAQSection.astro';
import DiagnosticCard from '../components/ui/DiagnosticCard.astro';
import { useTranslations, localizeLink } from '../utils/i18n';


const { lang } = useTranslations(Astro.url.pathname);

const breadcrumbs = [
  { label: 'All Diagnostic Tools' }
];

const faqs = [
  { question: "What online diagnostic tools are available on Display Test Online?", answer: "Display Test Online provides over 40 free, browser-native diagnostic instruments covering screen display testing, mechanical keyboard switch chatter analysis, mobile touch digitizer matrices, hardware latency benchmarks, and US micro-utility calculators." },
  { question: "Are any software downloads or drivers required to use these tools?", answer: "No. 100% of our diagnostic tools run natively inside your browser using client-side WebGL, Canvas 2D, and Web Audio APIs. Zero downloads or plugin installations required." },
  { question: "How do I test my screen for dead pixels and backlight bleed?", answer: "Navigate to our Dead Pixel Inspector or OLED Uniformity tool, press F or tap Fullscreen, and cycle through solid RGB, pure black, and pure white color canvases in a dark room." },
  { question: "How does the Mechanical Keyboard Switch Chatter analyzer work?", answer: "Our keyboard diagnostic suite logs microsecond timestamp deltas between key release and immediate re-press. Timestamp deltas below 35ms trigger switch chatter double-typing warnings." },
  { question: "Can I generate a cryptographic Hardware Passport certificate?", answer: "Yes. Running our visual and peripheral tests compiles GPU renderer string, refresh rate stability, and input latency telemetry into an immutable, SHA-256 signed Hardware Passport receipt." },
  { question: "What is the 540Hz+ VRR Stutter & Tearing Sweep Engine?", answer: "Our VRR engine measures microsecond requestAnimationFrame (rAF) frame interval deltas to detect VSync, G-Sync, and FreeSync frame pacing stutter on high-refresh-rate gaming monitors up to 540Hz+." },
  { question: "How do the US Micro-Utility Calculators work?", answer: "Calculators like PC Bottleneck, EIA Appliance Energy, TV Distance, Wire Gauge, and 3D Print Cost use transparent engineering formulas and official government/industry datasets to provide instant sizing and cost benchmarks." },
  { question: "Are the touch screen diagnostic tools compatible with iPad, iPhone, and Android?", answer: "Yes. Our multi-touch and touch matrix tools track up to 10+ simultaneous finger touches, contact pressure, pointer IDs, and digitizer Root-Mean-Square (RMS) vector line noise." },
  { question: "Does Display Test Online collect or store my personal keystrokes or data?", answer: "No. All test execution, keystroke processing, and visual rendering happen locally within your browser sandbox. We collect zero personal input data." },
  { question: "How do I embed a live Hardware Passport badge on my tech blog or forum?", answer: "Use our embeddable iframe widget endpoint (/embed/passport) to display live, responsive hardware certification badges directly on your website or forum signature." }
];

const displayTools = [
  { title: "Hz & Refresh Rate Test", description: "Microsecond frame delta tracking, LTPO ProMotion detection, and 540Hz+ reticle sweep.", href: localizeLink("/refresh-rate-test", lang), badge: "60–540Hz", category: "SPEED", icon: `<svg class="w-5 h-5 text-status-pass" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>` },
  { title: "Dead Pixel Test", description: "Fullscreen solid color cycler mapped to ISO 9241-307 Class I-IV display defect limits.", href: localizeLink("/display-tests/dead-pixel", lang), badge: "ISO 9241", category: "DEFECT", icon: `<svg class="w-5 h-5 text-rose-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>` },
  { title: "Blooming & Glow Test", description: "FALD local dimming halo detector with starfield targets, nit controls, and subtitle mode.", href: localizeLink("/display-tests/blooming-test", lang), badge: "Mini-LED", category: "LIGHTING", icon: `<svg class="w-5 h-5 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/></svg>` },
  { title: "Screen Flicker Test", description: "PWM frequency scanner, duty-cycle visualizer, 240fps camera strobe bars, and IEEE 1789 index.", href: localizeLink("/display-tests/flicker-test", lang), badge: "PWM", category: "EYE CARE", icon: `<svg class="w-5 h-5 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>` },
  { title: "Text Sharpness & Subpixel Test", description: "WebGL reticle simulating QD-OLED triangular, WOLED RWBG, and ClearType fringing.", href: localizeLink("/display-tests/sub-pixel", lang), badge: "ClearType", category: "SUBPIXEL", icon: `<svg class="w-5 h-5 text-purple-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16m-7 6h7"/></svg>` },
  { title: "HDR Brightness & Contrast Test", description: "ST 2084 PQ EOTF perceptual curve evaluation & 1%-100% ABL window size evaluator.", href: localizeLink("/display-tests/hdr-test", lang), badge: "1000 Nits", category: "HDR", icon: `<svg class="w-5 h-5 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/></svg>` },
  { title: "Screen Uniformity Test", description: "Precision low-gray luminance patterns for dark-gray banding and vignetting inspection.", href: localizeLink("/display-tests/uniformity", lang), badge: "Dark Gray", category: "OLED", icon: `<svg class="w-5 h-5 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/></svg>` },
  { title: "FPS Stutter & Tear Test", description: "Real-time rAF frame interval delta measuring for G-Sync, FreeSync, and VRR sync loss.", href: localizeLink("/display-tests/vrr", lang), badge: "G-Sync", category: "VRR", icon: `<svg class="w-5 h-5 text-status-pass" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>` },
  { title: "Monitor Color Test & Calibration", description: "Gamma 2.2, ΔE00 color difference formula, and binary ICC v4.3 profile exporter.", href: localizeLink("/monitor-color-calibration", lang), badge: "ICC v4.3", category: "COLOR", icon: `<svg class="w-5 h-5 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"/></svg>` },
  { title: "RGB Primary Channel Test", description: "Pure Red/Green/Blue subpixel isolation, additive color mixing matrix, and D65 white balance.", href: localizeLink("/display-tests/rgb-channel-test", lang), badge: "R/G/B", category: "SUBPIXEL", icon: `<svg class="w-5 h-5 text-rose-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"/></svg>` },
  { title: "Aspect Ratio & Dimension Solver", description: "Interactive 16:9, 21:9, 32:9 visual frames, physical surface area (in²/cm²), and scaling.", href: localizeLink("/display-tests/aspect-ratio-calculator", lang), badge: "21:9 / 32:9", category: "GEOMETRY", icon: `<svg class="w-5 h-5 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"/></svg>` },
  { title: "APCA Contrast & Accessibility", description: "W3C Advanced Perceptual Contrast Algorithm (APCA) contrast scoring engine.", href: localizeLink("/display-tests/contrast-accessibility", lang), badge: "WCAG 3.0", category: "APCA", icon: `<svg class="w-5 h-5 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>` },
  { title: "Delta-E Color Accuracy Calculator", description: "Quantitative CIEDE2000 color reproduction evaluation and Delta-E color distance solver.", href: localizeLink("/display-tests/delta-e-calculator", lang), badge: "ΔE00", category: "COLOR", icon: `<svg class="w-5 h-5 text-purple-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>` },
  { title: "CIE 1931 Color Gamut Map", description: "2D/3D chromaticity coordinates (sRGB, DCI-P3, AdobeRGB, Rec.2020) and profile exporter.", href: localizeLink("/display-tests/color-gamut", lang), badge: "CIE 1931", category: "GAMUT", icon: `<svg class="w-5 h-5 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M11 3.055A9.001 9.001 0 1020.945 13H11V3.055z"/><path stroke-linecap="round" stroke-linejoin="round" d="M20.488 9H15V3.512A9.025 9.025 0 0120.488 9z"/></svg>` },
  { title: "White Screen Utility", description: "Screen Wake Lock API + 2700K to 6500K Planckian locus color temperature sliders.", href: localizeLink("/white-screen", lang), badge: "Kelvin", category: "LIGHTING", icon: `<svg class="w-5 h-5 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/></svg>` },
  { title: "PPI & Resolution Calculator", description: "Calculates PPI, dot pitch (mm), and 1-arcminute visual acuity viewing distance optics.", href: localizeLink("/display-tests/ppi-calculator", lang), badge: "Optics", category: "PPI", icon: `<svg class="w-5 h-5 text-status-pass" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>` }
];

const keyboardTools = [
  { title: "Keyboard Test (All Keys)", description: "Switch chatter & microsecond debounce timing analysis for Cherry MX, Gateron, Kailh switches.", href: localizeLink("/keyboard-tester", lang), badge: "All Keys", category: "KEYBOARD", icon: `<svg class="w-5 h-5 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"/></svg>` },
  { title: "Mac Keyboard Test", description: "Apple Magic Keyboard layout with Command (⌘) and Option (⌥) modifier key registration.", href: localizeLink("/keyboard-tester/mac-keyboard-test", lang), badge: "macOS", category: "KEYBOARD", icon: `<svg class="w-5 h-5 text-purple-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>` },
  { title: "Gaming Keyboard Test", description: "WASD anti-ghosting combo test and 1000Hz NKRO rollover matrix profiling.", href: localizeLink("/keyboard-tester/gaming-keyboard-test", lang), badge: "1000Hz NKRO", category: "KEYBOARD", icon: `<svg class="w-5 h-5 text-status-pass" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>` },
  { title: "Laptop Keyboard Test", description: "Notebook membrane matrix & Fn key function layer combination profiler.", href: localizeLink("/keyboard-tester/laptop-keyboard-test", lang), badge: "Membrane", category: "KEYBOARD", icon: `<svg class="w-5 h-5 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>` },
  { title: "60% Mini Keyboard Test", description: "Compact 60% layout & custom Fn function layer key combination matrix.", href: localizeLink("/keyboard-tester/60-percent-keyboard-test", lang), badge: "60% Mini", category: "KEYBOARD", icon: `<svg class="w-5 h-5 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16m-7 6h7"/></svg>` },
  { title: "Wireless Bluetooth Keyboard Test", description: "Packet loss rate, sleep wake-up latency, and Bluetooth HID polling delay profiler.", href: localizeLink("/keyboard-tester/wireless-bluetooth-keyboard-test", lang), badge: "Bluetooth", category: "KEYBOARD", icon: `<svg class="w-5 h-5 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8.111 16.404a5.5 5.5 0 017.778 0M12 20h.01m-7.08-7.071a10 10 0 0114.142 0M2.05 8.05a15 15 0 0121.213 0"/></svg>` },
  { title: "Double Typing / Chatter Test", description: "Microsecond double-typing switch bounce analyzer (flags t_delta <= 35ms chatter faults).", href: localizeLink("/keyboard-tester/key-chatter-test", lang), badge: "Chatter", category: "KEYBOARD", icon: `<svg class="w-5 h-5 text-rose-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>` },
  { title: "Multi-Key Rollover Test", description: "Simultaneous key press counter testing maximum USB HID key rollover capacity.", href: localizeLink("/keyboard-tester/nkro-rollover-test", lang), badge: "NKRO", category: "KEYBOARD", icon: `<svg class="w-5 h-5 text-purple-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M7 11.5V14m0-2.5v-6a1.5 1.5 0 113 0m-3 6a1.5 1.5 0 00-3 0v2a7.5 7.5 0 0015 0v-5a1.5 1.5 0 00-3 0m-6-3V11m0-5.5a1.5 1.5 0 013 0v5.5m0-5.5a1.5 1.5 0 013 0v3"/></svg>` },
  { title: "Keyboard Speed & APM Test", description: "Actions Per Minute (APM) & Words Per Minute (WPM) typing velocity speedometer.", href: localizeLink("/keyboard-tester/keyboard-test-speed", lang), badge: "WPM / APM", category: "KEYBOARD", icon: `<svg class="w-5 h-5 text-status-pass" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>` },
  { title: "WPM Typing Speedometer", description: "WPM, CPM, and typing accuracy speedometer with coding syntax and punctuation modes.", href: localizeLink("/keyboard-tester/typing-speed-test", lang), badge: "WPM", category: "KEYBOARD", icon: `<svg class="w-5 h-5 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>` },
  { title: "Spacebar Clicker (Idle Game & 3D Keycap)", description: "High-precision 3D Spacebar CPS speedometer with 5s/10s/30s/60s time trials & zero-scroll handling.", href: localizeLink("/keyboard-tester/spacebar-counter", lang), badge: "3D Spacebar", category: "KEYBOARD", icon: `<svg class="w-5 h-5 text-status-pass" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><rect x="2" y="6" width="20" height="12" rx="2"/><path d="M8 15h8"/></svg>` },
  { title: "120+ Key Switch Directory", description: "Interactive switch catalog with Web Audio acoustic sound synthesis (Clicky, Tactile, Linear).", href: localizeLink("/keyboard-tester/switches", lang), badge: "120+ Switches", category: "KEYBOARD", icon: `<svg class="w-5 h-5 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z"/></svg>` }
];

const touchTools = [
  { title: "Touchscreen Dead Zone Test", description: "Dynamic grid tracking active touch contacts and uncalibrated dead-zone matrices.", href: localizeLink("/touch-tests/dead-zone", lang), badge: "Dead Zone", category: "TOUCH", icon: `<svg class="w-5 h-5 text-purple-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/></svg>` },
  { title: "Multi-Touch Screen Test", description: "Tracks up to 10+ simultaneous finger touches with active contact IDs and pressure geometry.", href: localizeLink("/touch-tests/multi-touch", lang), badge: "Multi-Touch", category: "TOUCH", icon: `<svg class="w-5 h-5 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M7 11.5V14m0-2.5v-6a1.5 1.5 0 113 0m-3 6a1.5 1.5 0 00-3 0v2a7.5 7.5 0 0015 0v-5a1.5 1.5 0 00-3 0m-6-3V11m0-5.5a1.5 1.5 0 013 0v5.5m0-5.5a1.5 1.5 0 013 0v3"/></svg>` },
  { title: "Touch Interference & Charger Noise", description: "Measures Root-Mean-Square deviation against ideal geometric vectors for touch digitizer EMI.", href: localizeLink("/touch-matrix/charger-emi-inspector", lang), badge: "Noise", category: "TOUCH", icon: `<svg class="w-5 h-5 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/></svg>` },
  { title: "Swipe Speed & Gesture Test", description: "Evaluates fling gesture velocity (px/ms & mm/s) and instantaneous touch vectors.", href: localizeLink("/touch-tests/swipe-velocity", lang), badge: "Velocity", category: "TOUCH", icon: `<svg class="w-5 h-5 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>` },
  { title: "Touch Input Lag & Latency Test", description: "Click-to-photon reflex input latency, browser dispatch overhead, and hardware polling.", href: localizeLink("/touch-tests/input-lag", lang), badge: "Latency", category: "TOUCH", icon: `<svg class="w-5 h-5 text-rose-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>` },
  { title: "Touch Sampling Rate Test", description: "Microsecond touch event dispatch profiler measuring touch sampling Hz.", href: localizeLink("/touch-tests/touch-sampling-rate", lang), badge: "240Hz+", category: "TOUCH", icon: `<svg class="w-5 h-5 text-status-pass" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>` }
];

