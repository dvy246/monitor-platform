---

<Layout
  title="All Diagnostic Tools - Free Online Hardware Testing Directory"
  description="Free directory of 60+ online hardware testing tools for screen displays, refresh rates, mechanical keyboards, mice, controller drift, audio, and webcams."
  faqs={faqs}
>
  <main id="main-content" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-16 flex-grow min-w-0 w-full">
    <Breadcrumbs items={breadcrumbs} />

    <!-- Hero Header — Premium Instrument Directory -->
    <header class="space-y-6 text-center max-w-4xl mx-auto min-w-0 w-full relative">
      <!-- Ambient glow -->
      <div class="pointer-events-none absolute -top-16 left-1/2 -translate-x-1/2 w-[500px] h-[200px] glow-blob-mint opacity-30"></div>

      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-[rgba(0,229,160,0.06)] border border-[rgba(0,229,160,0.22)] text-xs font-mono text-status-pass font-bold uppercase tracking-wider flex-wrap min-w-0 justify-center">
        <span class="w-1.5 h-1.5 rounded-full bg-status-pass led-glow-pass animate-pulse"></span>
        <span class="break-words min-w-0">Master Hardware &amp; Peripheral Diagnostic Directory</span>
      </div>

      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight heading-brand break-words min-w-0 relative">
        <span class="text-text-primary">All Diagnostic</span><br>
        <span style="background: linear-gradient(135deg, #00e5a0 0%, #4d9fff 60%, #a78bfa 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">Tools &amp; Testing Suite</span>
      </h1>

      <p class="text-sm sm:text-base text-text-secondary max-w-3xl mx-auto leading-relaxed font-sans min-w-0">
        60+ instant browser-native instruments for displays, latency, touch, keyboards, mice, controller testing, audio, and hardware calculators. Zero downloads. Zero tracking.
      </p>

      <!-- Quick stats row -->
      <div class="flex flex-wrap gap-2.5 justify-center font-mono text-[11px] pt-2">
        <span class="px-3 py-1.5 rounded-full bg-bg-surface border border-border-hairline text-text-secondary"><span class="text-status-pass font-bold">60+</span> Instruments</span>
        <span class="px-3 py-1.5 rounded-full bg-bg-surface border border-border-hairline text-text-secondary"><span class="text-status-info font-bold">4</span> Languages</span>
        <span class="px-3 py-1.5 rounded-full bg-bg-surface border border-border-hairline text-text-secondary"><span class="text-status-warn font-bold">2,856</span> Static Pages</span>
        <span class="px-3 py-1.5 rounded-full bg-bg-surface border border-border-hairline text-text-secondary"><span class="text-[#a78bfa] font-bold">100%</span> Client-Side</span>
      </div>
    </header>

    <!-- Category Quick-Filter & Jump Bar -->
    <nav aria-label="Tool Categories" class="flex flex-wrap items-center justify-center gap-2 py-4 border-y border-border-hairline bg-bg-surface/80 rounded-2xl p-4 font-mono text-xs shadow-inner sticky top-14 z-30 backdrop-blur-xl">
      <a href="#category-controller" class="px-3.5 py-2 rounded-xl bg-amber-500/10 hover:bg-amber-500/20 text-amber-400 border border-amber-500/30 font-bold transition-all flex items-center gap-1.5 shadow-sm">
        <span>🎮 Controller Tester</span>
        <span class="px-1.5 py-0.5 text-[10px] bg-amber-500/20 rounded font-mono">{controllerTools.length}</span>
      </a>
      <a href="#category-display" class="px-3.5 py-2 rounded-xl bg-status-pass/10 hover:bg-status-pass/20 text-status-pass border border-status-pass/30 font-bold transition-all flex items-center gap-1.5 shadow-sm">
        <span>🖥️ Display Tests</span>
        <span class="px-1.5 py-0.5 text-[10px] bg-status-pass/20 rounded font-mono">{displayTools.length}</span>
      </a>
      <a href="#category-keyboard" class="px-3.5 py-2 rounded-xl bg-cyan-500/10 hover:bg-cyan-500/20 text-cyan-400 border border-cyan-500/30 font-bold transition-all flex items-center gap-1.5 shadow-sm">
        <span>⌨️ Keyboard Suite</span>
        <span class="px-1.5 py-0.5 text-[10px] bg-cyan-500/20 rounded font-mono">{keyboardTools.length}</span>
      </a>
      <a href="#category-mouse" class="px-3.5 py-2 rounded-xl bg-status-pass/10 hover:bg-status-pass/20 text-status-pass border border-status-pass/30 font-bold transition-all flex items-center gap-1.5 shadow-sm">
        <span>🖱️ Mouse Suite</span>
        <span class="px-1.5 py-0.5 text-[10px] bg-status-pass/20 rounded font-mono">{mouseTools.length}</span>
      </a>
      <a href="#category-touch" class="px-3.5 py-2 rounded-xl bg-purple-500/10 hover:bg-purple-500/20 text-purple-400 border border-purple-500/30 font-bold transition-all flex items-center gap-1.5 shadow-sm">
        <span>📱 Mobile Touch</span>
        <span class="px-1.5 py-0.5 text-[10px] bg-purple-500/20 rounded font-mono">{touchTools.length}</span>
      </a>
      <a href="#category-sound" class="px-3.5 py-2 rounded-xl bg-purple-500/10 hover:bg-purple-500/20 text-purple-400 border border-purple-500/30 font-bold transition-all flex items-center gap-1.5 shadow-sm">
        <span>🔊 Sound &amp; Audio</span>
        <span class="px-1.5 py-0.5 text-[10px] bg-purple-500/20 rounded font-mono">{soundTools.length}</span>
      </a>
      <a href="#category-water" class="px-3.5 py-2 rounded-xl bg-emerald-500/10 hover:bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 font-bold transition-all flex items-center gap-1.5 shadow-sm">
        <span>💧 Water Eject</span>
        <span class="px-1.5 py-0.5 text-[10px] bg-emerald-500/20 rounded font-mono">{waterEjectTools.length}</span>
      </a>
      <a href="#category-mic" class="px-3.5 py-2 rounded-xl bg-emerald-500/10 hover:bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 font-bold transition-all flex items-center gap-1.5 shadow-sm">
        <span>🎙️ Mic Test</span>
        <span class="px-1.5 py-0.5 text-[10px] bg-emerald-500/20 rounded font-mono">{micTools.length}</span>
      </a>
      <a href="#category-camera" class="px-3.5 py-2 rounded-xl bg-rose-500/10 hover:bg-rose-500/20 text-rose-400 border border-rose-500/30 font-bold transition-all flex items-center gap-1.5 shadow-sm">
        <span>📹 Camera Suite</span>
        <span class="px-1.5 py-0.5 text-[10px] bg-rose-500/20 rounded font-mono">{cameraTools.length}</span>
      </a>
      <a href="#category-arcade" class="px-3.5 py-2 rounded-xl bg-rose-500/10 hover:bg-rose-500/20 text-rose-400 border border-rose-500/30 font-bold transition-all flex items-center gap-1.5 shadow-sm">
        <span>🕹️ Arcade Games</span>
        <span class="px-1.5 py-0.5 text-[10px] bg-rose-500/20 rounded font-mono">{arcadeGames.length}</span>
      </a>
      <a href="#category-benchmarks" class="px-3.5 py-2 rounded-xl bg-amber-500/10 hover:bg-amber-500/20 text-amber-400 border border-amber-500/30 font-bold transition-all flex items-center gap-1.5 shadow-sm">
        <span>🧮 Calculators</span>
        <span class="px-1.5 py-0.5 text-[10px] bg-amber-500/20 rounded font-mono">{benchmarkCalculators.length}</span>
      </a>
    </nav>

    <!-- Category 0: Speaker Water & Dust Ejection Suite (Emergency Hardware Utilities) -->
    <section class="space-y-6">
      <div class="flex items-center gap-3 border-b border-status-pass/40 pb-3 bg-status-pass/5 p-4 rounded-xl border">
        <div class="w-8 h-8 rounded-lg bg-status-pass/20 border border-status-pass/40 flex items-center justify-center text-status-pass">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 13.5L12 21m0 0l-7.5-7.5M12 21V3"/></svg>
        </div>
        <div>
          <h2 class="text-xl font-bold font-mono text-text-primary flex items-center gap-2">
            <span>Speaker Water &amp; Dust Ejection Suite ({waterEjectTools.length} Tools)</span>
            <span class="text-[10px] font-mono font-bold px-2 py-0.5 rounded bg-status-pass/20 text-status-pass border border-status-pass/40">Emergency Utility</span>
          </h2>
          <p class="text-xs text-text-muted">Acoustic 165Hz resonant frequency sweeps &amp; sawtooth waves to dislodge water, dust, and lint from mobile speaker grills.</p>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {waterEjectTools.map(tool => (
          <DiagnosticCard title={tool.title} description={tool.description} href={tool.href} badge={tool.badge} category={tool.category} icon={tool.icon} />
        ))}
      </div>
    </section>

    <!-- Category 1: Screen & Display Testing Suite -->
    <section class="space-y-6">
      <div class="flex items-center gap-3 border-b border-border-hairline pb-3">
        <div class="w-8 h-8 rounded-lg bg-status-pass/10 border border-status-pass/30 flex items-center justify-center text-status-pass">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
        </div>
        <div>
          <h2 class="text-xl font-bold font-mono text-text-primary">1. Screen &amp; Display Testing Suite ({displayTools.length} Tools)</h2>
          <p class="text-xs text-text-muted">WebGL &amp; Canvas 2D instruments for refresh rate, dead pixels, blooming, PWM flicker, HDR, and ICC color calibration.</p>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {displayTools.map(tool => (
          <DiagnosticCard title={tool.title} description={tool.description} href={tool.href} badge={tool.badge} category={tool.category} icon={tool.icon} />
        ))}
      </div>
    </section>

    <!-- Category 2: Universal Keyboard Testing Suite -->
    <section class="space-y-6">
      <div class="flex items-center gap-3 border-b border-border-hairline pb-3">
        <div class="w-8 h-8 rounded-lg bg-cyan-500/10 border border-cyan-500/30 flex items-center justify-center text-cyan-400">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><rect x="2" y="6" width="20" height="12" rx="2" stroke-linecap="round" stroke-linejoin="round"/><path stroke-linecap="round" stroke-linejoin="round" d="M6 9h.01M10 9h.01M14 9h.01M18 9h.01M6 12h.01M10 12h.01M14 12h.01M18 12h.01M8 15h8"/></svg>
        </div>
        <div>
          <h2 class="text-xl font-bold font-mono text-text-primary">2. Universal Keyboard Testing Ecosystem ({keyboardTools.length} Tools)</h2>
          <p class="text-xs text-text-muted">Microsecond switch chatter bounce profilers, NKRO combo tests, Mac layouts, and Web Audio acoustics.</p>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {keyboardTools.map(tool => (
          <DiagnosticCard title={tool.title} description={tool.description} href={tool.href} badge={tool.badge} category={tool.category} icon={tool.icon} />
        ))}
      </div>
    </section>

