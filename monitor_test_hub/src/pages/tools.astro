          <p class="text-xs text-text-muted">Touch matrix dead-zones, multi-touch contact counting, RMS line noise EMI, and gesture kinematics.</p>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {touchTools.map(tool => (
          <DiagnosticCard title={tool.title} description={tool.description} href={tool.href} badge={tool.badge} category={tool.category} icon={tool.icon} />
        ))}
      </div>
    </section>

    <!-- Category 4: Interactive Diagnostic Arcade Suite -->
    <section class="space-y-6">
      <div class="flex items-center gap-3 border-b border-border-hairline pb-3">
        <div class="w-8 h-8 rounded-lg bg-rose-500/10 border border-rose-500/30 flex items-center justify-center text-rose-400">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/><path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        </div>
        <div>
          <h2 class="text-xl font-bold font-mono text-text-primary">4. Interactive Diagnostic Arcade Suite ({arcadeGames.length} Games)</h2>
          <p class="text-xs text-text-muted">Gamified hardware tests measuring MPRT ghosting, CIEDE2000 ΔE00 color vision, and click-to-photon reflexes.</p>
        </div>
