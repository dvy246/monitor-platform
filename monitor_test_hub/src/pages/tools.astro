      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {controllerTools.map(tool => (
          <DiagnosticCard title={tool.title} description={tool.description} href={tool.href} badge={tool.badge} category={tool.category} icon={tool.icon} />
        ))}
      </div>
    </section>

    <!-- Category 8: Universal Sound & Audio Diagnostic Suite -->
    <section class="space-y-6">
      <div class="flex items-center gap-3 border-b border-border-hairline pb-3">
        <div class="w-8 h-8 rounded-lg bg-purple-500/10 border border-purple-500/30 flex items-center justify-center text-purple-400">
