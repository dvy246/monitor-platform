  { title: "Picabooth Webcam Photo Booth", description: "Picabooth-style photo experience — 7 filters, 3s/5s countdown selfie, 4-shot burst mode, and vertical photo strip PNG export.", href: localizeLink("/camera-test/photo-booth", lang), badge: "Picabooth", category: "PHOTO", icon: `<svg class="w-5 h-5 text-purple-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"/><circle cx="12" cy="13" r="3"/></svg>` },
  { title: "Webcam & Camera FPS Test", description: "Free online camera inspector measuring real-time FPS frame pacing, 1080p/4K sensor resolution, mirror flip, and fill light studio.", href: localizeLink("/webcam-test", lang), badge: "1080p/4K", category: "WEBCAM", icon: `<svg class="w-5 h-5 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>` },
  { title: "Camera & Mic Combined Suite", description: "Unified video and audio test suite evaluating webcam resolution, camera FPS, mic decibel levels (dBFS), and instant voice playback.", href: localizeLink("/sound-test/camera-mic-test", lang), badge: "Camera+Mic", category: "DUAL", icon: `<svg class="w-5 h-5 text-status-pass" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>` }
