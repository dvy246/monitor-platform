        </div>
        <div>
          <h2 class="text-xl font-bold font-mono text-text-primary">8. Universal Sound &amp; Audio Diagnostic Suite ({soundTools.length} Tools)</h2>
          <p class="text-xs text-text-muted">Pure Web Audio FFT spectrum visualizers, 8D headphone spatializers, binaural brainwave generators, hearing audiograms, and Bluetooth latency checkers.</p>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {soundTools.map(tool => (
          <DiagnosticCard title={tool.title} description={tool.description} href={tool.href} badge={tool.badge} category={tool.category} icon={tool.icon} />
        ))}
      </div>
    </section>

    <!-- Category 9: Microphone & Audio Input Diagnostics -->
    <section class="space-y-6">
      <div class="flex items-center gap-3 border-b border-border-hairline pb-3">
        <div class="w-8 h-8 rounded-lg bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center text-emerald-400">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 100-6 3 3 0 000 6z"/></svg>
        </div>
        <div>
          <h2 class="text-xl font-bold font-mono text-text-primary">9. Microphone &amp; Audio Input Suite ({micTools.length} Tools)</h2>
          <p class="text-xs text-text-muted">Real-time dBFS decibel meters, 3-second instant playback loopbacks, voice SNR evaluators, audio output sweeps, and privacy-safe voice recording.</p>
