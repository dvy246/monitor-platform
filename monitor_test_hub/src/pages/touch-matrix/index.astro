---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import TouchMatrixTester from '../../components/diagnostics/TouchMatrixTester.astro';
import ErgonomicsNotice from '../../components/disclaimers/ErgonomicsNotice.astro';
import { getAllDeviceTypes, getAllGridDensities, getDeviceLabel, getDensityLabel } from '../../engine/TouchMatrixEngine';

const pageTitle = "Touchscreen Digitizer Dead-Zone & Multi-Touch Precision Matrix";
const metaDescription = "Standardized hardware diagnostic tool for testing touch screen digitizer dead zones, multi-touch precision points, timestamp jitter, and vector trajectory drift error.";

const deviceTypes = getAllDeviceTypes();
const gridDensities = getAllGridDensities();
---

<Layout title={pageTitle} description={metaDescription}>
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">
    <Breadcrumbs items={[
      { label: 'Touch Diagnostics', href: '/touch-tests' },
      { label: 'Touch Matrix Suite', href: '/touch-matrix' }
    ]} />

    <!-- Page Header Deck -->
    <header class="space-y-3 border-b border-border-hairline pb-6 font-mono">
      <div class="flex items-center gap-2 text-status-pass text-xs font-bold uppercase tracking-wider">
        <span class="w-2.5 h-2.5 rounded-full bg-status-pass led-glow-pass"></span>
        DIGITIZER ACCURACY AUDIT
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-text-primary tracking-tight">
        Touchscreen Digitizer Dead-Zone & Multi-Touch Precision Matrix
      </h1>
      <p class="text-sm text-text-secondary max-w-3xl leading-relaxed font-sans">
        Hardware-level PointerEvents diagnostic tool designed to evaluate screen touch digitizers. Measures active multi-touch registration points, gesture tracking velocity (px/ms), frame jitter variance, and vector trajectory drift error across customizable grid densities.
      </p>
    </header>

    <!-- Key Diagnostic Metrics Deck -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 font-mono">
      <div class="bg-bg-surface border border-border-hairline rounded-lg p-4 shadow-specular-top">
        <span class="text-[10px] text-text-muted uppercase font-bold tracking-wider block mb-1">EVENT BUS API</span>
        <span class="text-sm font-bold text-text-primary block">PointerEvents</span>
        <span class="text-[10px] text-text-secondary mt-1 block">Hardware Un-buffered</span>
      </div>

      <div class="bg-bg-surface border border-border-hairline rounded-lg p-4 shadow-specular-top">
        <span class="text-[10px] text-text-muted uppercase font-bold tracking-wider block mb-1">GESTURE VELOCITY</span>
        <span class="text-sm font-bold text-status-pass block">px/ms Tracking</span>
        <span class="text-[10px] text-text-secondary mt-1 block">Instantaneous & Peak</span>
      </div>

      <div class="bg-bg-surface border border-border-hairline rounded-lg p-4 shadow-specular-top">
        <span class="text-[10px] text-text-muted uppercase font-bold tracking-wider block mb-1">TIMESTAMP JITTER</span>
        <span class="text-sm font-bold text-text-primary block">StdDev (ms)</span>
        <span class="text-[10px] text-text-secondary mt-1 block">Polling Interval Variance</span>
      </div>

      <div class="bg-bg-surface border border-border-hairline rounded-lg p-4 shadow-specular-top">
        <span class="text-[10px] text-text-muted uppercase font-bold tracking-wider block mb-1">VECTOR DRIFT</span>
        <span class="text-sm font-bold text-text-primary block">RMS Euclidean</span>
        <span class="text-[10px] text-text-secondary mt-1 block">Perpendicular Error %</span>
      </div>
    </div>

    <!-- Main Diagnostic Tester Component -->
    <TouchMatrixTester initialDeviceType="tablet" initialGridDensity="medium" initialMode="dead-zone" />

    <!-- Device & Grid Density Combination Matrix Selector -->
    <section class="bg-bg-surface border border-border-hairline rounded-2xl p-6 space-y-6 font-mono">
      <div class="space-y-1">
        <h2 class="text-base font-bold text-text-primary uppercase tracking-wider">
          Pre-Rendered Device & Grid Density Matrix Routes
        </h2>
        <p class="text-xs text-text-secondary font-sans">
          Select hardware preset profiles to inspect tailored digitizer matrix configurations.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
        {deviceTypes.map((device) => (
          <div class="bg-bg-canvas border border-border-hairline rounded-xl p-4 space-y-3">
            <span class="text-xs font-bold text-status-pass uppercase tracking-wider block border-b border-border-hairline pb-2">
              {getDeviceLabel(device)}
            </span>
            <div class="space-y-1.5 text-xs">
              {gridDensities.map((density) => (
                <a
                  href={`/touch-matrix/${device}/${density}`}
                  class="block px-2.5 py-1.5 rounded border border-border-hairline bg-bg-surface text-text-secondary hover:text-text-primary hover:border-status-pass transition-colors"
                >
                  {getDensityLabel(density)}
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Engineering Assessment & Specifications -->
    <section class="bg-bg-surface border border-border-hairline rounded-2xl p-6 space-y-4 font-mono">
      <h2 class="text-base font-bold text-text-primary uppercase tracking-wider border-b border-border-hairline pb-3">
        Engineering Assessment & Digitizer Calibration Theory
      </h2>
      <div class="space-y-3 text-xs text-text-secondary leading-relaxed font-sans">
        <p>
          Capacitive and resistive touch digitizers map touch input by measuring electrical capacitance variations across a coordinate sensor array grid. Trace line fractures or sensor controller firmware throttling can manifest as <strong class="text-text-primary">unresponsive dead-zones</strong>, pointer position jitter, or non-linear trajectory drift.
        </p>
        <p>
          The <strong class="text-text-primary">Touch Matrix Engine</strong> evaluates digitizer health across three critical vectors:
        </p>
        <ul class="list-disc pl-5 space-y-1 text-text-secondary">
          <li><strong class="text-text-primary">Dead-Zone Matrix Isolation:</strong> Sweeping the digitizer flags active cell coordinates. Unvisited cell coordinates are isolated as dead zone matrix blocks.</li>
          <li><strong class="text-text-primary">Jitter & Velocity Telemetry:</strong> Measures high-frequency touch sample rate consistency and inter-frame time deltas ($dt$). High jitter standard deviation indicates digitizer controller polling instability.</li>
          <li><strong class="text-text-primary">Vector Trajectory Drift:</strong> Calculates RMS Euclidean distance error between recorded touch path and ideal straight vector path to detect non-linear digitizer warp.</li>
        </ul>
      </div>
    </section>

    <ErgonomicsNotice />
  </main>
</Layout>
