---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import TouchMatrixTester from '../../components/diagnostics/TouchMatrixTester.astro';
import ErgonomicsNotice from '../../components/disclaimers/ErgonomicsNotice.astro';
import FAQSection from '../../components/ui/FAQSection.astro';
import { getAllDeviceTypes, getAllGridDensities, getDeviceLabel, getDensityLabel } from '../../engine/TouchMatrixEngine';

import StatusCard from '../../components/ui/sidebar/StatusCard.astro';
import ConfigurationCard from '../../components/ui/sidebar/ConfigurationCard.astro';
import MetricCard from '../../components/ui/sidebar/MetricCard.astro';
import InspectorCard from '../../components/ui/sidebar/InspectorCard.astro';
import ShortcutCard from '../../components/ui/sidebar/ShortcutCard.astro';

const pageTitle = "Touchscreen Digitizer Dead-Zone & Multi-Touch Precision Matrix";
const metaDescription = "Standardized hardware diagnostic tool for testing touch screen digitizer dead zones, multi-touch precision points, timestamp jitter, and vector trajectory drift error.";

const deviceTypes = getAllDeviceTypes();
const gridDensities = getAllGridDensities();

const faqs = [
  {
    question: "What is the Touch Matrix Suite?",
    answer: "The Touch Matrix Suite is a comprehensive hardware diagnostic tool for auditing touch digitizer health, active cell matrix coverage, gesture velocity tracking (px/ms), timestamp jitter, and vector drift error."
  },
  {
    question: "What hardware device presets are available in Touch Matrix?",
    answer: "Touch Matrix provides specialized presets for Smartphones, Tablets, Convertible Laptops, and Interactive Touch Monitors with tailored grid resolutions."
  },
  {
    question: "What is grid density (Coarse, Medium, Fine) in touch matrix testing?",
    answer: "Grid density controls the cell resolution of the test overlay. Coarse (5x5) tests quick gesture coverage, Medium (10x10) provides standard verification, and Fine (20x20) inspects sub-millimeter dead zones."
  },
  {
    question: "How does the W3C PointerEvents API capture touch telemetry?",
    answer: "PointerEvents captures raw hardware events from capacitive digitizers, exposing pointerId, clientX/Y coordinates, pressure, width/height radius, and sub-millisecond timestamps."
  },
  {
    question: "What is timestamp jitter in digitizer sampling?",
    answer: "Timestamp jitter measures the standard deviation (σ) of time deltas between incoming touch events. Low jitter indicates smooth, consistent hardware polling."
  },
  {
    question: "What causes vector trajectory drift on touch screens?",
    answer: "Vector trajectory drift is non-linear deviation between a finger's physical motion and the digitizer's reported coordinates, usually caused by non-uniform ITO sensor impedance or EMI."
  },
  {
    question: "Can I run Touch Matrix diagnostics on drawing tablets?",
    answer: "Yes! Touch Matrix supports both finger touch and active stylus pens (Wacom, Apple Pencil, Surface Pen)."
  },
  {
    question: "How do I switch between Dead-Zone, Multi-Touch, and Vector test modes?",
    answer: "Use the mode buttons inside the Touch Matrix Tester component or use the 'M' hotkey to cycle diagnostic modes."
  },
  {
    question: "What is a good Digitizer Health Index score?",
    answer: "A score of 95–100 indicates perfect capacitive digitizer health with 100% matrix coverage, sub-millisecond jitter, and zero dead zones."
  },
  {
    question: "How do I enter fullscreen mode for touch matrix testing?",
    answer: "Press the 'F' key or tap the 'FULLSCREEN' button to expand the touch matrix canvas across your entire screen."
  }
];
---

<Layout title={pageTitle} description={metaDescription} faqs={faqs}>
  <div class="max-w-7xl mx-auto px-4 py-6 sm:py-8 min-w-0 w-full overflow-hidden font-sans">
    <Breadcrumbs items={[
      { label: 'Touch Diagnostics', href: '/touch-tests' },
      { label: 'Touch Matrix Suite', href: '/touch-matrix' }
    ]} />

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mt-6">
      
      <!-- Left Primary Diagnostic Canvas (lg:col-span-8) -->
      <div class="lg:col-span-8 space-y-8 min-w-0">
        <!-- Page Header Deck -->
        <header class="space-y-3 border-b border-border-hairline pb-6 font-mono">
          <div class="flex items-center gap-2 text-status-pass text-xs font-bold uppercase tracking-wider">
            <span class="w-2.5 h-2.5 rounded-full bg-status-pass led-glow-pass"></span>
            DIGITIZER ACCURACY AUDIT
          </div>
          <h1 class="text-3xl sm:text-4xl font-extrabold text-text-primary tracking-tight">
            Touchscreen Digitizer Dead-Zone &amp; Multi-Touch Precision Matrix
          </h1>
          <p class="text-sm text-text-secondary max-w-3xl leading-relaxed font-sans">
            Hardware-level PointerEvents diagnostic tool designed to evaluate screen touch digitizers. Measures active multi-touch registration points, gesture tracking velocity (px/ms), frame jitter variance, and vector trajectory drift error across customizable grid densities.
          </p>
        </header>

        <!-- Key Diagnostic Metrics Deck -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 font-mono">
          <div class="bg-[#121215] border border-white/10 rounded-2xl p-4 shadow-2xl">
            <span class="text-[10px] text-zinc-400 uppercase font-bold tracking-wider block mb-1">EVENT BUS API</span>
            <span class="text-sm font-bold text-white block">PointerEvents</span>
            <span class="text-[10px] text-zinc-400 mt-1 block">Hardware Un-buffered</span>
          </div>

          <div class="bg-[#121215] border border-white/10 rounded-2xl p-4 shadow-2xl">
            <span class="text-[10px] text-zinc-400 uppercase font-bold tracking-wider block mb-1">GESTURE VELOCITY</span>
            <span class="text-sm font-bold text-emerald-400 block">px/ms Tracking</span>
            <span class="text-[10px] text-zinc-400 mt-1 block">Instantaneous &amp; Peak</span>
          </div>

          <div class="bg-[#121215] border border-white/10 rounded-2xl p-4 shadow-2xl">
            <span class="text-[10px] text-zinc-400 uppercase font-bold tracking-wider block mb-1">TIMESTAMP JITTER</span>
            <span class="text-sm font-bold text-white block">StdDev (ms)</span>
            <span class="text-[10px] text-zinc-400 mt-1 block">Polling Interval Variance</span>
          </div>

          <div class="bg-[#121215] border border-white/10 rounded-2xl p-4 shadow-2xl">
            <span class="text-[10px] text-zinc-400 uppercase font-bold tracking-wider block mb-1">VECTOR DRIFT</span>
            <span class="text-sm font-bold text-white block">RMS Euclidean</span>
            <span class="text-[10px] text-zinc-400 mt-1 block">Perpendicular Error %</span>
          </div>
        </div>

        <!-- Main Diagnostic Tester Component -->
        <TouchMatrixTester initialDeviceType="tablet" initialGridDensity="medium" initialMode="dead-zone" />

        <!-- Device & Grid Density Combination Matrix Selector -->
        <section class="bg-[#121215] border border-white/10 rounded-3xl p-6 space-y-6 font-mono shadow-2xl">
          <div class="space-y-1">
            <h2 class="text-base font-bold text-white uppercase tracking-wider">
              Pre-Rendered Device &amp; Grid Density Matrix Routes
            </h2>
            <p class="text-xs text-zinc-400 font-sans">
              Select hardware preset profiles to inspect tailored digitizer matrix configurations.
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
            {deviceTypes.map((device) => (
              <div class="bg-[#08080a] border border-white/10 rounded-2xl p-4 space-y-3">
                <span class="text-xs font-bold text-emerald-400 uppercase tracking-wider block border-b border-white/10 pb-2">
                  {getDeviceLabel(device)}
                </span>
                <div class="space-y-1.5 text-xs">
                  {gridDensities.map((density) => (
                    <a
                      href={`/touch-matrix/${device}/${density}`}
                      class="block px-2.5 py-1.5 rounded-xl border border-white/10 bg-[#121215] text-zinc-400 hover:text-white hover:border-emerald-500/50 cursor-pointer transition-colors duration-200"
                    >
                      {getDensityLabel(density)}
                    </a>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </section>

        <!-- Engineering Assessment & Specifications -->
        <section class="bg-[#121215] border border-white/10 rounded-3xl p-6 space-y-4 font-mono shadow-2xl">
          <h2 class="text-base font-bold text-white uppercase tracking-wider border-b border-white/10 pb-3">
            Engineering Assessment &amp; Digitizer Calibration Theory
          </h2>
          <div class="space-y-3 text-xs text-zinc-300 leading-relaxed font-sans">
            <p>
              Capacitive and resistive touch digitizers map touch input by measuring electrical capacitance variations across a coordinate sensor array grid. Trace line fractures or sensor controller firmware throttling can manifest as <strong class="text-white">unresponsive dead-zones</strong>, pointer position jitter, or non-linear trajectory drift.
            </p>
            <p>
              The <strong class="text-white">Touch Matrix Engine</strong> evaluates digitizer health across three critical vectors:
            </p>
            <ul class="list-disc pl-5 space-y-1 text-zinc-400">
              <li><strong class="text-white">Dead-Zone Matrix Isolation:</strong> Sweeping the digitizer flags active cell coordinates. Unvisited cell coordinates are isolated as dead zone matrix blocks.</li>
              <li><strong class="text-white">Jitter &amp; Velocity Telemetry:</strong> Measures high-frequency touch sample rate consistency and inter-frame time deltas ($dt$). High jitter standard deviation indicates digitizer controller polling instability.</li>
              <li><strong class="text-white">Vector Trajectory Drift:</strong> Calculates RMS Euclidean distance error between recorded touch path and ideal straight vector path to detect non-linear digitizer warp.</li>
            </ul>
          </div>
        </section>

        <ErgonomicsNotice />
        <FAQSection faqs={faqs} />
      </div>

      <!-- Right Modular Control & Telemetry Sidebar (lg:col-span-4) -->
      <div class="lg:col-span-4 space-y-6 sticky top-24 self-start min-w-0">
        <StatusCard
          status="pass"
          label="DIGITIZER HEALTH: 98%"
          subtitle="Capacitive Touch Index"
          score="98"
          maxScore="100"
          details={[
            { label: 'Active Matrix', value: '100% Covered' },
            { label: 'Dead Cells', value: '0 Isolated' }
          ]}
        />

        <ConfigurationCard
          title="Matrix Setup"
          subtitle="Device & Grid Density"
          controls={[
            {
              id: 'matrixDevice',
              label: 'Device Profile',
              type: 'select',
              value: 'tablet',
              options: [
                { value: 'phone', label: 'Smartphone' },
                { value: 'tablet', label: 'Tablet / iPad' },
                { value: 'laptop', label: '2-in-1 Laptop' },
                { value: 'monitor', label: 'Touch Monitor' }
              ]
            },
            {
              id: 'matrixDensity',
              label: 'Grid Resolution',
              type: 'presets',
              value: 'medium',
              options: [
                { value: 'coarse', label: 'Coarse 5x5' },
                { value: 'medium', label: 'Medium 10x10' },
                { value: 'fine', label: 'Fine 20x20' }
              ]
            }
          ]}
        />

        <MetricCard
          title="Digitizer Telemetry"
          subtitle="API & Jitter Metrics"
          badgeText="PointerEvents"
          metrics={[
            { id: 'pointerApi', label: 'Event Bus API', value: 'W3C Pointer', status: 'pass' },
            { id: 'velocityTracking', label: 'Peak Velocity', value: '2.45', unit: 'px/ms', status: 'pass' },
            { id: 'jitterStdDev', label: 'Timestamp Jitter σ', value: '0.14', unit: 'ms', status: 'pass' }
          ]}
        />

        <InspectorCard
          title="Pointer Inspection"
          subtitle="W3C PointerType Details"
          rows={[
            { key: 'Pointer Type', value: 'touch / pen', highlight: true },
            { key: 'Hardware Co-processor', value: 'Mutual Cap ITO' },
            { key: 'Max Points', value: '10 Contacts' }
          ]}
        />

        <ShortcutCard
          shortcuts={[
            { keys: ['F'], label: 'Toggle Fullscreen' },
            { keys: ['M'], label: 'Cycle Test Modes' }
          ]}
        />
      </div>

    </div>
  </div>
</Layout>
