---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import SwipeTracker from '../../components/diagnostics/SwipeTracker.astro';
import ErgonomicsNotice from '../../components/disclaimers/ErgonomicsNotice.astro';
import TestSwitcherBar from '../../components/ui/TestSwitcherBar.astro';

const breadcrumbItems = [
  { label: 'Touch Suite', href: '/touch-tests' },
  { label: 'Swipe Velocity & Acceleration Benchmark' }
];

const touchTests = [
  { id: 'dead-zone', label: 'Dead Zone Matrix', href: '/touch-tests/dead-zone' },
  { id: 'multi-touch', label: 'Multi-Touch Counter', href: '/touch-tests/multi-touch' },
  { id: 'vector-precision', label: 'Vector Precision', href: '/touch-tests/vector-precision' },
  { id: 'swipe-velocity', label: 'Swipe Velocity', href: '/touch-tests/swipe-velocity', active: true },
  { id: 'input-lag', label: 'Input Lag Test', href: '/touch-tests/input-lag' }
];
---

<Layout 
  title="Swipe Velocity & Acceleration Benchmark | Monitor Test Hub" 
  description="Calculate touch gesture flick velocity (px/s), peak acceleration, and digitizer sampling rate consistency across mobile and tablet screens."
>
  <main class="max-w-7xl mx-auto px-4 py-8 space-y-8">
    <Breadcrumbs items={breadcrumbItems} />

    <header class="space-y-3 border-b border-border-hairline pb-6">
      <div class="flex items-center gap-2 text-status-pass text-xs font-mono font-bold uppercase tracking-wider">
        <span class="w-2 h-2 rounded-full bg-status-pass led-glow-pass"></span>
        HIGH-SPEED TOUCH SAMPLING &amp; FLICK KINEMATICS
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-text-primary tracking-tight">Swipe Velocity &amp; Acceleration Benchmark</h1>
      <p class="text-sm text-text-secondary max-w-3xl">
        Flick your finger or stylus across the canvas to measure instantaneous swipe velocity (pixels per second), peak acceleration, and digitizer timestamp stability.
      </p>
    </header>

    <SwipeTracker />

    <!-- Swipe Velocity Article -->
    <article class="bg-bg-surface border border-border-hairline rounded-2xl p-6 sm:p-8 space-y-6 shadow-specular-top font-sans text-sm text-text-secondary leading-relaxed">
      <div class="border-b border-border-hairline pb-4">
        <span class="font-mono text-[10px] font-bold text-status-pass uppercase tracking-widest block mb-1">GESTURE KINEMATICS &amp; SAMPLING STABILITY</span>
        <h2 class="text-xl font-bold text-text-primary">Touch Flick Kinematics, Velocity Derivation &amp; Timestamp Jitter</h2>
      </div>

      <p>
        Touch gesture tracking performance depends on high-frequency sampling (120Hz to 360Hz digitizer polling) combined with low-variance timestamp intervals (\(\Delta t\)). Velocity (\(v\)) and acceleration (\(a\)) are derived from continuous spatial coordinate deltas:
      </p>

      <div class="bg-bg-canvas p-4 rounded-xl border border-border-hairline font-mono text-xs space-y-2 my-4">
        <span class="text-text-muted text-[10px] uppercase block tracking-wider">KINEMATICS DERIVATION</span>
        <div class="text-status-pass font-bold">
          v(t) = √( (Δx/Δt)² + (Δy/Δt)² )
        </div>
        <div class="text-text-primary">
          a(t) = ( v(t) - v(t-1) ) / Δt
        </div>
      </div>

      <ErgonomicsNotice />
    </article>

    <TestSwitcherBar tests={touchTests} currentId="swipe-velocity" />
  </main>
</Layout>
