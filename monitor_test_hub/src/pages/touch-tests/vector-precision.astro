---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import VectorPrecisionEngine from '../../components/diagnostics/VectorPrecisionEngine.astro';
import ErgonomicsNotice from '../../components/disclaimers/ErgonomicsNotice.astro';
import TestSwitcherBar from '../../components/ui/TestSwitcherBar.astro';

const breadcrumbItems = [
  { label: 'Touch Suite', href: '/touch-tests' },
  { label: 'Vector Precision & Line Jitter' }
];

const touchTests = [
  { id: 'dead-zone', label: 'Dead Zone Matrix', href: '/touch-tests/dead-zone' },
  { id: 'multi-touch', label: 'Multi-Touch Counter', href: '/touch-tests/multi-touch' },
  { id: 'vector-precision', label: 'Vector Precision', href: '/touch-tests/vector-precision', active: true },
  { id: 'swipe-velocity', label: 'Swipe Velocity', href: '/touch-tests/swipe-velocity' },
  { id: 'input-lag', label: 'Input Lag Test', href: '/touch-tests/input-lag' }
];
---

<Layout 
  title="Vector Precision & Line Jitter Test | Monitor Test Hub" 
  description="Draw linear trajectories between target anchors to evaluate digitizer line noise, measure stylus waviness, and calculate Root Mean Square (RMS) deviation."
>
  <div class="max-w-7xl mx-auto px-4 py-8 space-y-8">
    <Breadcrumbs items={breadcrumbItems} />

    <header class="space-y-3 border-b border-border-hairline pb-6">
      <div class="flex items-center gap-2 text-status-pass text-xs font-mono font-bold uppercase tracking-wider">
        <span class="w-2 h-2 rounded-full bg-status-pass led-glow-pass"></span>
        DIGITIZER TRAJECTORY DRIFT — RMS ERROR ANALYSIS
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-text-primary tracking-tight">Vector Precision &amp; Line Jitter Test</h1>
      <p class="text-sm text-text-secondary max-w-3xl">
        Draw straight trajectories across target vector anchors to evaluate touch screen digitizer line noise, measure active stylus diagonal waviness, and compute Root Mean Square (RMS) spatial deviation.
      </p>
    </header>

    <VectorPrecisionEngine />

    <!-- Vector Precision Article -->
    <article class="bg-bg-surface border border-border-hairline rounded-2xl p-6 sm:p-8 space-y-6 shadow-specular-top font-sans text-sm text-text-secondary leading-relaxed">
      <div class="border-b border-border-hairline pb-4">
        <span class="font-mono text-[10px] font-bold text-status-pass uppercase tracking-widest block mb-1">DIGITIZER LINE NOISE MATHEMATICS</span>
        <h2 class="text-xl font-bold text-text-primary">Root Mean Square (RMS) Vector Drift &amp; Stylus Diagonal Waviness</h2>
      </div>

      <p>
        Active digitizer styluses (Wacom EMR, Apple Pencil, Microsoft Pen Protocol) can exhibit subtle <strong>diagonal line jitter</strong> caused by spatial quantization between physical ITO grid channels. Spatial trajectory precision is quantified by measuring the perpendicular distance (\(d_i\)) of sampled touch points from the ideal linear vector:
      </p>

      <div class="bg-bg-canvas p-4 rounded-xl border border-border-hairline font-mono text-xs space-y-2 my-4">
        <span class="text-text-muted text-[10px] uppercase block tracking-wider">RMS ERROR FORMULA</span>
        <div class="text-status-pass font-bold">
          RMS_Error = √( (1/N) × ∑(d_i)² )
        </div>
        <div class="text-text-secondary text-[11px] font-sans">
          Where lower RMS values (below 1.5 pixels) indicate professional drawing tablet accuracy.
        </div>
      </div>

      <ErgonomicsNotice />
    </article>

    <TestSwitcherBar tests={touchTests} currentId="vector-precision" />
  </div>
</Layout>
