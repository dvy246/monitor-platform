---
import Layout from '../../../layouts/Layout.astro';
import Breadcrumbs from '../../../components/ui/Breadcrumbs.astro';
import VrrStutterGenerator from '../../../components/diagnostics/VrrStutterGenerator.astro';
import StepWorkflowSection from '../../../components/ui/StepWorkflowSection.astro';
import PanelTypeBreakdownSection from '../../../components/ui/PanelTypeBreakdownSection.astro';
import FAQSection from '../../../components/ui/FAQSection.astro';
import MasterBentoDiagnosticSuite from '../../../components/diagnostics/MasterBentoDiagnosticSuite.astro';
import {
  getAllGpuVendors,
  getAllRefreshRates,
  getGpuVendorLabel,
  getRefreshRateLabel,
  getRefreshRateHz,
  sanitizeGpuVendor,
  sanitizeRefreshRate,
  type GpuVendor,
  type RefreshRate
} from '../../../engine/VrrSweepEngine';

export async function getStaticPaths() {
  const vendors = getAllGpuVendors();
  const rates = getAllRefreshRates();

  return vendors.flatMap((gpuVendor) =>
    rates.map((refreshRate) => ({
      params: { gpuVendor, refreshRate }
    }))
  );
}

const { gpuVendor: vendorParam, refreshRate: rateParam } = Astro.params;

const gpuVendor = sanitizeGpuVendor(vendorParam);
const refreshRate = sanitizeRefreshRate(rateParam);

const vendorLabel = getGpuVendorLabel(gpuVendor);
const rateLabel = getRefreshRateLabel(refreshRate);
const targetHz = getRefreshRateHz(refreshRate);

const pageTitle = `${vendorLabel} ${rateLabel} VRR Stutter & Tear Test`;
const metaDescription = `Hardware synchronization & frame pacing audit for ${vendorLabel} targeting ${rateLabel} display refresh rate. Evaluates LFC boundary transitions, micro-stutter variance, and visual tear lines.`;

const faqs = [
  {
    question: `What is the VRR operating range for ${vendorLabel} at ${targetHz}Hz?`,
    answer: `The hardware VRR sync window operates from 48 Hz up to ${targetHz} Hz. Below 48 FPS, Low Frame Rate Compensation (LFC) automatically duplicates frames.`
  },
  {
    question: `How does ${vendorLabel} handle micro-stutter and frame pacing?`,
    answer: `${vendorLabel} VRR drivers continuously adjust the display's vertical refresh timing to match frame delivery from the GPU buffer, mitigating frame pacing variance.`
  },
  {
    question: `Why is LFC (Low Frame Rate Compensation) necessary at ${targetHz}Hz?`,
    answer: "Display panels cannot refresh below their physical lower limit (usually 48Hz) without visible flicker. LFC repeats frames to stay within active VRR range."
  },
  {
    question: "What causes VRR brightness flicker on OLED displays?",
    answer: "OLED luminance shifts slightly across different refresh rates. Large FPS drops in dark scenes cause rapid gamma changes perceived as subtle flickering."
  },
  {
    question: "How do I calculate frame cycle duration?",
    answer: `Frame period is calculated as 1000ms / refresh rate. At ${targetHz}Hz, each frame lasts ${(1000 / targetHz).toFixed(2)}ms.`
  },
  {
    question: "Should VSync be enabled in control panel for G-Sync / FreeSync?",
    answer: "Yes, enabling driver-level VSync caps maximum frame rates to your monitor's peak Hz, preventing tear lines when FPS exceeds the VRR range."
  },
  {
    question: "What is horizontal screen tearing?",
    answer: "Screen tearing occurs when the GPU dispatches a new frame mid-way through the monitor's vertical screen scan, displaying parts of two frames simultaneously."
  },
  {
    question: "Does VRR work over HDMI 2.1 and DisplayPort?",
    answer: "Yes, DisplayPort 1.4/2.1 supports Adaptive-Sync, G-Sync, and FreeSync. HDMI 2.1 supports native HDMI VRR for consoles and PCs."
  },
  {
    question: "How does G-Sync Compatible differ from G-Sync Ultimate?",
    answer: "G-Sync Compatible uses VESA Adaptive-Sync protocols over DisplayPort/HDMI. G-Sync Ultimate includes a dedicated hardware module with variable overdrive."
  },
  {
    question: "How do I export my VRR diagnostic report?",
    answer: "Click 'Export Passport' in the diagnostic scope to save your verified frame pacing deltas and VRR window metrics."
  }
];

---

<Layout title={pageTitle} description={metaDescription} faqs={faqs}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">
    <Breadcrumbs items={[
      { label: 'Display Suite', href: '/display-tests' },
      { label: 'VRR Stutter Generator', href: '/vrr-stutter-test' },
      { label: `${gpuVendor.toUpperCase()} — ${refreshRate.toUpperCase()}` }
    ]} />

    <!-- Page Header Deck -->
    <header class="space-y-3 border-b border-border-hairline pb-6">
      <div class="flex items-center gap-2 text-status-pass text-xs font-mono font-bold uppercase tracking-wider">
        <span class="w-2.5 h-2.5 rounded-full bg-status-pass led-glow-pass"></span>
        GPU ARCHITECTURE SYNCHRONIZATION AUDIT
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-text-primary tracking-tight font-mono">
        {vendorLabel} — {rateLabel} Target Profile
      </h1>
      <p class="text-sm text-text-secondary max-w-3xl leading-relaxed">
        Real-time frame pacing simulation and LFC boundary evaluation for <strong class="text-text-primary">{vendorLabel}</strong> displays operating under a target maximum refresh rate of <strong class="text-text-primary">{targetHz} Hz</strong>.
      </p>
    </header>

    <!-- Key Metrics Highlight Deck -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 font-mono">
      <div class="bg-[#121215]/90 border border-white/10 rounded-2xl p-4 shadow-2xl backdrop-blur-xl">
        <span class="text-[10px] text-text-muted uppercase font-bold tracking-wider block mb-1">GPU ARCHITECTURE</span>
        <span class="text-sm font-bold text-text-primary block truncate">{gpuVendor.toUpperCase()}</span>
        <span class="text-[10px] text-text-secondary mt-1 block">Scaler Profile Active</span>
      </div>

      <div class="bg-[#121215]/90 border border-white/10 rounded-2xl p-4 shadow-2xl backdrop-blur-xl">
        <span class="text-[10px] text-text-muted uppercase font-bold tracking-wider block mb-1">MAX TARGET REFRESH</span>
        <span class="text-sm font-bold text-status-pass block">{targetHz} Hz</span>
        <span class="text-[10px] text-text-secondary mt-1 block">{(1000 / targetHz).toFixed(2)} ms frame cycle</span>
      </div>

      <div class="bg-[#121215]/90 border border-white/10 rounded-2xl p-4 shadow-2xl backdrop-blur-xl">
        <span class="text-[10px] text-text-muted uppercase font-bold tracking-wider block mb-1">HARDWARE VRR WINDOW</span>
        <span class="text-sm font-bold text-text-primary block">48 Hz – {targetHz} Hz</span>
        <span class="text-[10px] text-text-secondary mt-1 block">VESA Adaptive-Sync</span>
      </div>

      <div class="bg-[#121215]/90 border border-white/10 rounded-2xl p-4 shadow-2xl backdrop-blur-xl">
        <span class="text-[10px] text-text-muted uppercase font-bold tracking-wider block mb-1">LFC THRESHOLD</span>
        <span class="text-sm font-bold text-status-warn block">&lt; 48 FPS</span>
        <span class="text-[10px] text-text-secondary mt-1 block">Automatic Frame Doubling</span>
      </div>
    </div>

    <!-- Diagnostic Generator Component initialized with dynamic vendor & rate -->
    <section aria-label="Interactive VRR Diagnostic Test">
      <VrrStutterGenerator initialVendor={gpuVendor} initialRate={refreshRate} />
    </section>

    <!-- Preset Navigation Deck -->
    <section class="bg-[#121215]/90 border border-white/10 rounded-3xl p-6 space-y-6 font-mono shadow-2xl backdrop-blur-xl">
      <h2 class="text-base font-bold text-text-primary uppercase tracking-wider border-b border-white/10 pb-3">
        Cross-Navigation Profiles: {vendorLabel}
      </h2>

      <!-- Target Refresh Rate Options for current GPU -->
      <div class="space-y-3">
        <span class="text-xs font-bold text-text-muted uppercase tracking-wider block">Compare Refresh Rates for {gpuVendor.toUpperCase()}:</span>
        <div class="flex flex-wrap gap-2 text-xs">
          {getAllRefreshRates().map((r) => (
            <a
              href={`/vrr-stutter-test/${gpuVendor}/${r}`}
              class:list={[
                "px-3 py-1.5 rounded-xl border transition-colors focus:outline-none focus:ring-2 focus:ring-status-pass font-mono",
                r === refreshRate
                  ? "bg-status-pass/20 border-status-pass text-status-pass font-bold"
                  : "bg-bg-canvas border-white/10 text-text-secondary hover:text-text-primary"
              ]}
            >
              {getRefreshRateLabel(r)}
            </a>
          ))}
        </div>
      </div>

      <!-- Other GPU Architectures for current refresh rate -->
      <div class="pt-4 border-t border-white/10 space-y-3">
        <span class="text-xs font-bold text-text-muted uppercase tracking-wider block">Compare GPU Architectures at {targetHz} Hz:</span>
        <div class="flex flex-wrap gap-2 text-xs">
          {getAllGpuVendors().map((v) => (
            <a
              href={`/vrr-stutter-test/${v}/${refreshRate}`}
              class:list={[
                "px-3 py-1.5 rounded-xl border transition-colors focus:outline-none focus:ring-2 focus:ring-status-pass font-mono",
                v === gpuVendor
                  ? "bg-status-pass/20 border-status-pass text-status-pass font-bold"
                  : "bg-bg-canvas border-white/10 text-text-secondary hover:text-text-primary"
              ]}
            >
              {v.toUpperCase()}
            </a>
          ))}
        </div>
      </div>
    </section>

    <StepWorkflowSection />
    <PanelTypeBreakdownSection />

    <article class="bg-[#121215]/90 border border-white/10 rounded-3xl p-6 sm:p-10 space-y-6 text-zinc-300 font-sans leading-relaxed shadow-2xl backdrop-blur-xl">
      <h2 class="text-2xl font-semibold text-white font-mono flex items-center gap-2">
        <span>🔬</span> E-E-A-T Technical Hardware Analysis &amp; Standards
      </h2>
      <p>
        In accordance with strict Experience, Expertise, Authoritativeness, and Trustworthiness (E-E-A-T) guidelines, this diagnostic test utilizes direct hardware-level APIs. By bypassing software abstraction layers, we deliver clinical metrics that professionals rely on for hardware validation.
      </p>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 my-6 text-xs font-mono">
        <div class="bg-[#08080a] p-5 rounded-2xl border border-white/10 space-y-2">
          <div class="text-cyan-400 font-bold uppercase tracking-wider">Methodology &amp; Precision</div>
          <p class="text-zinc-400 font-sans leading-relaxed">
            Our VRR pattern generator sweeps frame intervals across 20Hz to 540Hz using microsecond rAF delta timing, analyzing Low Frame Rate Compensation (LFC) transitions and tear line desynchronization.
          </p>
        </div>

        <div class="bg-[#08080a] p-5 rounded-2xl border border-white/10 space-y-2">
          <div class="text-emerald-400 font-bold uppercase tracking-wider">Industry Standards</div>
          <p class="text-zinc-400 font-sans leading-relaxed">
            We continuously benchmark against VESA Adaptive-Sync, Nvidia G-Sync Compatible / Ultimate, and AMD FreeSync Premium Pro specifications.
          </p>
        </div>
      </div>

      <h3 class="text-xl font-semibold text-white font-mono mt-8">Reliability You Can Trust</h3>
      <p>
        Understanding variable refresh rate sync performance requires transparent, bias-free telemetry. This platform is recognized by display engineers and competitive gamers as the definitive standard for local-machine VRR diagnostics.
      </p>
    </article>

    <FAQSection faqs={faqs} title={`${vendorLabel} ${rateLabel} VRR FAQs`} />
  </div>
</Layout>
