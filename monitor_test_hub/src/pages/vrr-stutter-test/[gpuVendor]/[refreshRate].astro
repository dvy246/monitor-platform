---
import Layout from '../../../layouts/Layout.astro';
import Breadcrumbs from '../../../components/ui/Breadcrumbs.astro';
import VrrStutterGenerator from '../../../components/diagnostics/VrrStutterGenerator.astro';
import {
  getAllGpuVendors,
  getAllRefreshRates,
  getGpuVendorLabel,
  getRefreshRateLabel,
  getRefreshRateHz,
  sanitizeGpuVendor,
  sanitizeRefreshRate,
  type GpuVendor,
  type RefreshRate
} from '../../../engine/VrrSweepEngine';

export async function getStaticPaths() {
  const vendors = getAllGpuVendors();
  const rates = getAllRefreshRates();

  return vendors.flatMap((gpuVendor) =>
    rates.map((refreshRate) => ({
      params: { gpuVendor, refreshRate }
    }))
  );
}

const { gpuVendor: vendorParam, refreshRate: rateParam } = Astro.params;

const gpuVendor = sanitizeGpuVendor(vendorParam);
const refreshRate = sanitizeRefreshRate(rateParam);

const vendorLabel = getGpuVendorLabel(gpuVendor);
const rateLabel = getRefreshRateLabel(refreshRate);
const targetHz = getRefreshRateHz(refreshRate);

const pageTitle = `${vendorLabel} ${rateLabel} VRR Stutter & Tear Test`;
const metaDescription = `Hardware synchronization & frame pacing audit for ${vendorLabel} targeting ${rateLabel} display refresh rate. Evaluates LFC boundary transitions, micro-stutter variance, and visual tear lines.`;
---

<Layout title={pageTitle} description={metaDescription}>
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">
    <Breadcrumbs items={[
      { label: 'Display Suite', href: '/display-tests' },
      { label: 'VRR Stutter Generator', href: '/vrr-stutter-test' },
      { label: `${gpuVendor.toUpperCase()} — ${refreshRate.toUpperCase()}` }
    ]} />

    <!-- Page Header Deck -->
    <header class="space-y-3 border-b border-border-hairline pb-6">
      <div class="flex items-center gap-2 text-status-pass text-xs font-mono font-bold uppercase tracking-wider">
        <span class="w-2.5 h-2.5 rounded-full bg-status-pass led-glow-pass"></span>
        GPU ARCHITECTURE SYNCHRONIZATION AUDIT
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-text-primary tracking-tight font-mono">
        {vendorLabel} — {rateLabel} Target Profile
      </h1>
      <p class="text-sm text-text-secondary max-w-3xl leading-relaxed">
        Real-time frame pacing simulation and LFC boundary evaluation for <strong class="text-text-primary">{vendorLabel}</strong> displays operating under a target maximum refresh rate of <strong class="text-text-primary">{targetHz} Hz</strong>.
      </p>
    </header>

    <!-- Key Metrics Highlight Deck -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 font-mono">
      <div class="bg-bg-surface border border-border-hairline rounded-lg p-4 shadow-specular-top">
        <span class="text-[10px] text-text-muted uppercase font-bold tracking-wider block mb-1">GPU ARCHITECTURE</span>
        <span class="text-sm font-bold text-text-primary block truncate">{gpuVendor.toUpperCase()}</span>
        <span class="text-[10px] text-text-secondary mt-1 block">Scaler Profile Active</span>
      </div>

      <div class="bg-bg-surface border border-border-hairline rounded-lg p-4 shadow-specular-top">
        <span class="text-[10px] text-text-muted uppercase font-bold tracking-wider block mb-1">MAX TARGET REFRESH</span>
        <span class="text-sm font-bold text-status-pass block">{targetHz} Hz</span>
        <span class="text-[10px] text-text-secondary mt-1 block">{(1000 / targetHz).toFixed(2)} ms frame cycle</span>
      </div>

      <div class="bg-bg-surface border border-border-hairline rounded-lg p-4 shadow-specular-top">
        <span class="text-[10px] text-text-muted uppercase font-bold tracking-wider block mb-1">HARDWARE VRR WINDOW</span>
        <span class="text-sm font-bold text-text-primary block">48 Hz – {targetHz} Hz</span>
        <span class="text-[10px] text-text-secondary mt-1 block">VESA Adaptive-Sync</span>
      </div>

      <div class="bg-bg-surface border border-border-hairline rounded-lg p-4 shadow-specular-top">
        <span class="text-[10px] text-text-muted uppercase font-bold tracking-wider block mb-1">LFC THRESHOLD</span>
        <span class="text-sm font-bold text-status-warn block">&lt; 48 FPS</span>
        <span class="text-[10px] text-text-secondary mt-1 block">Automatic Frame Doubling</span>
      </div>
    </div>

    <!-- Diagnostic Generator Component initialized with dynamic vendor & rate -->
    <section aria-label="Interactive VRR Diagnostic Test">
      <VrrStutterGenerator initialVendor={gpuVendor} initialRate={refreshRate} />
    </section>

    <!-- Preset Navigation Deck -->
    <section class="bg-bg-surface border border-border-hairline rounded-xl p-6 space-y-6 font-mono">
      <h2 class="text-base font-bold text-text-primary uppercase tracking-wider border-b border-border-hairline pb-3">
        Cross-Navigation Profiles: {vendorLabel}
      </h2>

      <!-- Target Refresh Rate Options for current GPU -->
      <div class="space-y-3">
        <span class="text-xs font-bold text-text-muted uppercase tracking-wider block">Compare Refresh Rates for {gpuVendor.toUpperCase()}:</span>
        <div class="flex flex-wrap gap-2 text-xs">
          {getAllRefreshRates().map((r) => (
            <a
              href={`/vrr-stutter-test/${gpuVendor}/${r}`}
              class:list={[
                "px-3 py-1.5 rounded border transition-colors focus:outline-none focus:ring-2 focus:ring-status-pass",
                r === refreshRate
                  ? "bg-status-pass/20 border-status-pass text-status-pass font-bold"
                  : "bg-bg-canvas border-border-hairline text-text-secondary hover:text-text-primary"
              ]}
            >
              {getRefreshRateLabel(r)}
            </a>
          ))}
        </div>
      </div>

      <!-- Other GPU Architectures for current refresh rate -->
      <div class="pt-4 border-t border-border-hairline space-y-3">
        <span class="text-xs font-bold text-text-muted uppercase tracking-wider block">Compare GPU Architectures at {targetHz} Hz:</span>
        <div class="flex flex-wrap gap-2 text-xs">
          {getAllGpuVendors().map((v) => (
            <a
              href={`/vrr-stutter-test/${v}/${refreshRate}`}
              class:list={[
                "px-3 py-1.5 rounded border transition-colors focus:outline-none focus:ring-2 focus:ring-status-pass",
                v === gpuVendor
                  ? "bg-status-pass/20 border-status-pass text-status-pass font-bold"
                  : "bg-bg-canvas border-border-hairline text-text-secondary hover:text-text-primary"
              ]}
            >
              {v.toUpperCase()}
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>
</Layout>
